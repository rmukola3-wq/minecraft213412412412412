    private final AuraReachController reachController =
        new AuraReachController();

    private final List<Entity> targets = new ArrayList<>();

    private Entity lockedTarget;
    private Entity preparedTarget;
    private Vec3d currentAimPoint;

    private int switchTimer;
    private int hitTimer;
    private int shieldBreakCooldown;
    private int grimRotationTicks;

    private boolean combatPrepared;
    private boolean wasPathing;
    private boolean assistClockwise = true;

    public boolean attacking;
    public boolean swapped;

    public static int previousSlot = -1;

    public KillAura() {
        super(
            Categories.Combat,
            "kill-aura",
            "KillAura with critical sync, reach profiles and ShieldBreaker."
        );
    }

    @Override
    public void onActivate() {
        targets.clear();

        lockedTarget = null;
        preparedTarget = null;
        currentAimPoint = null;

        switchTimer = 0;
        hitTimer = 100;
        shieldBreakCooldown = 0;
        grimRotationTicks = 0;

        combatPrepared = false;
        wasPathing = false;
        assistClockwise = true;

        attacking = false;
        swapped = false;
        previousSlot = -1;

        aimPointResolver.reset();
        criticalController.reset(mc.player);
        reachController.reset();
    }

    @Override
    public void onDeactivate() {
        clearCombat();
        reachController.reset();
    }

    @EventHandler(priority = EventPriority.HIGH)
    private void onTickPre(TickEvent.Pre event) {
        if (applyWorkingPreset.get()) {
            applyWorkingPreset.set(false);
            applyWorkingPreset();
        }

        criticalController.tick(mc.player);
        reachController.tick();

        combatPrepared = false;
        preparedTarget = null;
        attacking = false;

        if (switchTimer > 0) switchTimer--;
        if (shieldBreakCooldown > 0) shieldBreakCooldown--;
        if (hitTimer < Integer.MAX_VALUE) hitTimer++;

        if (!basicCheck()) {
            clearCombat();
            return;
        }

        updateTargets();

        if (targets.isEmpty()) {
            clearCombat();
            return;
        }

        Entity primary = targets.getFirst();

        reachController.record(primary, backtrackTicks.get());

        currentAimPoint = resolveAimPoint(primary);

        if (currentAimPoint == null) {
            invalidateTarget(primary);
            return;
        }

        if (
            requiresVisiblePoint()
                && !aimPointResolver.isVisible(
                    mc,
                    mc.player.getEyePos(),
                    currentAimPoint
                )
        ) {
            invalidateTarget(primary);
            return;
        }

        if (!prepareNormalWeapon() || !normalItemInHand()) {
            stopAttacking();
            return;
        }

        pausePathing();

        if (bypassMode.get() == BypassMode.Grim2) {
            if (
                isServerLookingAt(
                    primary,
                    getEffectiveRange() + 0.05
                )
            ) {
                grimRotationTicks++;
            } else {
                grimRotationTicks = 0;
            }
        } else {
            grimRotationTicks = 0;
        }

        boolean cooldownReady =
            isCooldownReady(getCooldownProgress());

        if (
            shouldRotateAlways()
                || (
                rotation.get() == RotationMode.OnHit
                    && cooldownReady
            )
        ) {
            rotate(currentAimPoint);
        }

        preparedTarget = primary;
        combatPrepared = true;
        attacking = true;
    }

    @EventHandler(priority = EventPriority.HIGH)
    private void onTickPost(TickEvent.Post event) {
        if (
            !combatPrepared
                || preparedTarget == null
                || currentAimPoint == null
                || !basicCheck()
        ) {
            return;
        }

        Entity target = preparedTarget;

        if (
            !target.isAlive()
                || !entityCheck(target)
                || !normalItemInHand()
        ) {
            return;
        }

        Vec3d confirmedPoint = resolveAimPoint(target);

        if (confirmedPoint == null) return;

        if (
            requiresVisiblePoint()
                && !aimPointResolver.isVisible(
                    mc,
                    mc.player.getEyePos(),
                    confirmedPoint
                )
        ) {
            return;
        }

        currentAimPoint = confirmedPoint;

        float cooldownProgress = getCooldownProgress();
        boolean cooldownReady =
            isCooldownReady(cooldownProgress);

        boolean shieldActive =
            shieldMode.get() == ShieldMode.Break
                && isTargetBlockingShield(target);

        if (shieldActive) {
            if (
                shieldBreakCooldown > 0
                    || !cooldownReady
                    || !profileAllowsAttack(target)
            ) {
                return;
            }

            performInstantShieldBreak(target);
            return;
        }

        AuraCriticalController.Decision decision =
            criticalController.update(
                mc.player,
                getEffectiveCriticalMode(),
                cooldownReady,
                cooldownProgress,
                autoCriticalJump.get(),
                jumpAtProgress.get(),
                minimumFallDistance.get()
            );

        if (decision == AuraCriticalController.Decision.Wait) {
            return;
        }

        if (!profileAllowsAttack(target)) {
            return;
        }

        criticalController.beforeAttack(mc.player, decision);
        attackNormally(target);
    }

    @EventHandler
    private void onSendPacket(PacketEvent.Send event) {
        if (event.packet instanceof UpdateSelectedSlotC2SPacket) {
            switchTimer = getEffectiveSwitchDelay();
        }
    }

    @EventHandler(priority = EventPriority.LOWEST - 200)
    private void onMove(PlayerMoveEvent event) {
        if (
            movementAssist.get() == MovementAssistMode.None
                || mc.player == null
                || mc.world == null
                || event.type != MovementType.SELF
                || Modules.get().isActive(TargetStrafe.class)
        ) {
            return;
        }

        Entity entity = getTarget();

        if (!(entity instanceof LivingEntity target)) return;

        if (
            mc.player.input.movementForward == 0
                && mc.player.input.movementSideways == 0
        ) {
            return;
        }

        if (movementAssist.get() == MovementAssistMode.Free) {
            return;
        }

        double currentX = event.movement.x;
        double currentZ = event.movement.z;
        double movementSpeed = Math.hypot(currentX, currentZ);

        if (movementSpeed < 0.001) return;

        if (mc.options.leftKey.isPressed()) {
            assistClockwise = false;
        } else if (mc.options.rightKey.isPressed()) {
            assistClockwise = true;
        }

        if (mc.player.horizontalCollision) {
            assistClockwise = !assistClockwise;
        }

        double differenceX =
            mc.player.getX() - target.getX();

        double differenceZ =
            mc.player.getZ() - target.getZ();

        double distance = Math.max(
            0.001,
            Math.hypot(differenceX, differenceZ)
        );

        double radialX = differenceX / distance;
        double radialZ = differenceZ / distance;

        double tangentX = assistClockwise
            ? -radialZ
            : radialZ;

        double tangentZ = assistClockwise
            ? radialX
            : -radialX;

        double distanceError =
            distance - assistDistance.get();

        double inwardAmount = MathHelper.clamp(
            distanceError * 0.45,
            -0.75,
            0.75
        );

        double desiredX;
        double desiredZ;

        if (movementAssist.get() == MovementAssistMode.Focused) {
            desiredX =
                currentX / movementSpeed
                    - radialX * inwardAmount;

            desiredZ =
                currentZ / movementSpeed
                    - radialZ * inwardAmount;
        } else {
            desiredX =
                tangentX - radialX * inwardAmount;

            desiredZ =
                tangentZ - radialZ * inwardAmount;
        }

        double desiredLength = Math.max(
            0.001,
            Math.hypot(desiredX, desiredZ)
        );

        desiredX = desiredX / desiredLength * movementSpeed;
        desiredZ = desiredZ / desiredLength * movementSpeed;

        double resultX = MathHelper.lerp(
            assistStrength.get(),
            currentX,
            desiredX
        );

        double resultZ = MathHelper.lerp(
            assistStrength.get(),
            currentZ,
            desiredZ
        );

        ((IVec3d) event.movement).meteor$setXZ(
            resultX,
            resultZ
        );
    }

    private Vec3d resolveAimPoint(Entity target) {
        if (
            reachMode.get() == AuraReachController.Mode.BackTrack
        ) {
            Vec3d backtrackPoint =
                reachController.resolveBacktrackPoint(
                    mc.player,
                    target,
                    backtrackTicks.get(),
                    getEffectiveRange()
                );

            if (backtrackPoint != null) {
                return backtrackPoint;
            }
        } else {
            reachController.clearSelectedBox();
        }

        return aimPointResolver.resolve(
            mc,
            target,
            getEffectiveRange(),
            getEffectiveWallsRange()
        );
    }

    private boolean basicCheck() {
        if (
            mc.player == null
                || mc.world == null
                || mc.interactionManager == null
        ) {
            return false;
        }

        if (
            !mc.player.isAlive()
                || PlayerUtils.getGameMode() == GameMode.SPECTATOR
        ) {
            return false;
        }

        if (
            pauseOnUse.get()
                && (
                mc.player.isUsingItem()
                    || mc.interactionManager.isBreakingBlock()
            )
        ) {
            return false;
        }

        if (
            onlyOnClick.get()
                && !mc.options.attackKey.isPressed()
        ) {
            return false;
        }

        if (
            pauseOnLag.get()
                && TickRate.INSTANCE.getTimeSinceLastTick() >= 1.0f
        ) {
            return false;
        }

        CrystalAura crystalAura =
            Modules.get().get(CrystalAura.class);

        return !pauseOnCA.get()
            || crystalAura == null
            || !crystalAura.isActive()
            || crystalAura.kaTimer <= 0;
    }

    private void updateTargets() {
        targets.clear();

        if (onlyOnLook.get()) {
            lockedTarget = null;

            if (
                mc.targetedEntity != null
                    && entityCheck(mc.targetedEntity)
            ) {
                targets.add(mc.targetedEntity);
            }

            return;
        }

        if (
            targetLock.get()
                && lockedTarget != null
                && entityCheck(lockedTarget)
        ) {
            targets.add(lockedTarget);
            return;
        }

        lockedTarget = null;
        aimPointResolver.reset();
        reachController.clearSelectedBox();

        TargetUtils.getList(
            targets,
            this::entityCheck,
            priority.get(),
            bypassMode.get() == BypassMode.Standard
                && !targetLock.get()
                ? maxTargets.get()
                : 1
        );

        if (targetLock.get() && !targets.isEmpty()) {
            lockedTarget = targets.getFirst();
        }
    }

    private void invalidateTarget(Entity target) {
        if (lockedTarget == target) {
            lockedTarget = null;
        }

        targets.clear();

        preparedTarget = null;
        currentAimPoint = null;

        combatPrepared = false;
        grimRotationTicks = 0;

        aimPointResolver.reset();
        reachController.clearSelectedBox();
        criticalController.reset(mc.player);

        stopAttacking();
    }

    private void attackNormally(Entity target) {
        if (
            target == null
                || !target.isAlive()
                || !isActive()
                || mc.player == null
                || mc.world == null
                || mc.interactionManager == null
                || !entityCheck(target)
                || !normalItemInHand()
        ) {
            return;
        }

        if (!attackWithReachProfile(target)) {
            return;
        }

        hitTimer = 0;
        criticalController.afterAttack(mc.player);
    }

    private boolean attackWithReachProfile(Entity target) {
        if (
            target == null
                || currentAimPoint == null
                || mc.player == null
                || mc.interactionManager == null
        ) {
            return false;
        }

        boolean resetSprint =
            sprintReset.get()
                && (
                bypassMode.get() != BypassMode.Standard
                    || reachMode.get()
                    != AuraReachController.Mode.Normal
            );

        AuraReachController.SprintSession sprintSession =
            reachController.stopSprint(
                mc.player,
                resetSprint
            );

        AuraReachController.SpoofSession spoofSession = null;

        try {
            if (
                reachMode.get()
                    == AuraReachController.Mode.PositionSpoof
            ) {
                spoofSession =
                    reachController.beginPositionSpoof(
                        mc.player,
                        currentAimPoint,
                        spoofSafeRange.get(),
                        spoofMaxStep.get(),
                        spoofJitter.get()
                    );

                if (spoofSession == null) {
                    return false;
                }
            } else if (
                bypassMode.get() != BypassMode.Standard
                    || reachMode.get()
                    == AuraReachController.Mode.BackTrack
            ) {
                reachController.sendLookPacket(
                    mc.player,
                    currentAimPoint
                );
            }

            mc.interactionManager.attackEntity(
                mc.player,
                target
            );

            mc.player.swingHand(Hand.MAIN_HAND);
            return true;
        } finally {
            reachController.finishPositionSpoof(
                mc.player,
                spoofSession
            );

            reachController.restoreSprint(
                mc.player,
                sprintSession
            );
        }
    }

    private void performInstantShieldBreak(Entity target) {
        if (
            target == null
                || !target.isAlive()
                || mc.player == null
                || mc.interactionManager == null
        ) {
            return;
        }

        FindItemResult axe = InvUtils.findInHotbar(
            stack -> stack.getItem() instanceof AxeItem
        );

        if (!axe.found() || axe.slot() < 0) return;

        int previousSelectedSlot =
            mc.player.getInventory().selectedSlot;

        boolean mustSwitch =
            previousSelectedSlot != axe.slot();

        if (mustSwitch) {
            InvUtils.swap(axe.slot(), false);
        }

        boolean attacked = attackWithReachProfile(target);

        if (mustSwitch) {
            InvUtils.swap(previousSelectedSlot, false);
        }

        if (!attacked) return;

        hitTimer = 0;
        shieldBreakCooldown = shieldBreakDelay.get();

        criticalController.afterAttack(mc.player);
    }

    private boolean profileAllowsAttack(Entity target) {
        if (
            reachMode.get()
                == AuraReachController.Mode.PositionSpoof
        ) {
            return currentAimPoint != null;
        }

        if (
            bypassMode.get() == BypassMode.Grim2
                && grimRotationTicks < 1
        ) {
            return false;
        }

        if (
            bypassMode.get() == BypassMode.Standard
                && !strictRaycast.get()
        ) {
            return true;
        }

        return isServerLookingAt(
            target,
            getEffectiveRange() + 0.05
        );
    }

    private boolean requiresVisiblePoint() {
        if (
            reachMode.get()
                != AuraReachController.Mode.Normal
        ) {
            return true;
        }

        if (bypassMode.get() != BypassMode.Standard) {
            return true;
        }

        return strictRaycast.get();
    }

    private boolean isServerLookingAt(
        Entity target,
        double rayLength
    ) {
        return reachController.isLookingAt(
            mc.player,
            target,
            Rotations.serverYaw,
            Rotations.serverPitch,
            rayLength
        );
    }

    private boolean shouldRotateAlways() {
        return bypassMode.get() != BypassMode.Standard
            || reachMode.get()
            != AuraReachController.Mode.Normal
            || rotation.get() == RotationMode.Always;
    }

    private void rotate(Vec3d point) {
        if (
            point == null
                || mc.player == null
                || (
                bypassMode.get() == BypassMode.Standard
                    && reachMode.get()
                    == AuraReachController.Mode.Normal
                    && rotation.get() == RotationMode.None
            )
        ) {
            return;
        }

        Vec3d eyes = mc.player.getEyePos();

        double differenceX = point.x - eyes.x;
        double differenceY = point.y - eyes.y;
        double differenceZ = point.z - eyes.z;

        double horizontalDistance = Math.sqrt(
            differenceX * differenceX
                + differenceZ * differenceZ
        );

        float targetYaw = (float) (
            Math.toDegrees(
                Math.atan2(differenceZ, differenceX)
            ) - 90
        );

        float targetPitch = MathHelper.clamp(
            (float) -Math.toDegrees(
                Math.atan2(
                    differenceY,
                    horizontalDistance
                )
            ),
            -90,
            90
        );

        float yaw = applyYawProfile(targetYaw);
        float pitch = applyPitchProfile(targetPitch);

        float yawDifference = Math.abs(
            MathHelper.wrapDegrees(
                yaw - Rotations.serverYaw
            )
        );

        float pitchDifference = Math.abs(
            pitch - Rotations.serverPitch
        );

        if (
            yawDifference < 0.001f
                && pitchDifference < 0.001f
        ) {
            return;
        }

        Rotations.rotate(
            yaw,
            pitch,
            ROTATION_PRIORITY
        );
    }

    private float applyYawProfile(float targetYaw) {
        float currentYaw = Rotations.serverYaw;

        float difference = MathHelper.wrapDegrees(
            targetYaw - currentYaw
        );

        float maximumStep = switch (bypassMode.get()) {
            case Grim2 -> 70.0f;
            case Matrix -> 45.0f;
            default -> 180.0f;
        };

        difference = MathHelper.clamp(
            difference,
            -maximumStep,
            maximumStep
        );

        return currentYaw + difference;
    }

    private float applyPitchProfile(float targetPitch) {
        float currentPitch = Rotations.serverPitch;
        float difference = targetPitch - currentPitch;

        float maximumStep = switch (bypassMode.get()) {
            case Grim2 -> 35.0f;
            case Matrix -> 25.0f;
            default -> 180.0f;
        };

        difference = MathHelper.clamp(
            difference,
            -maximumStep,
            maximumStep
        );

        return MathHelper.clamp(
            currentPitch + difference,
            -90,
            90
        );
    }

    private void pausePathing() {
        if (
            pauseBaritone.get()
                && PathManagers.get().isPathing()
                && !wasPathing
        ) {
            PathManagers.get().pause();
            wasPathing = true;
        }
    }

    private boolean prepareNormalWeapon() {
        if (!autoSwitch.get()) return true;
        if (weapon.get() == Weapon.Any) return true;

        FindItemResult result = findWeapon();

        if (!result.found() || result.slot() < 0) {
            return false;
        }

        int selectedSlot =
            mc.player.getInventory().selectedSlot;

        if (!swapped && selectedSlot != result.slot()) {
            previousSlot = selectedSlot;
            swapped = true;
        }

        if (selectedSlot != result.slot()) {
            InvUtils.swap(result.slot(), false);
        }

        return true;
    }

    private FindItemResult findWeapon() {
        return switch (weapon.get()) {
            case Sword -> InvUtils.findInHotbar(
                stack -> stack.getItem() instanceof SwordItem
            );

            case Axe -> InvUtils.findInHotbar(
                stack -> stack.getItem() instanceof AxeItem
            );

            case Mace -> InvUtils.findInHotbar(
                stack -> stack.getItem() instanceof MaceItem
            );

            case Trident -> InvUtils.findInHotbar(
                stack -> stack.getItem() instanceof TridentItem
            );

            case All -> findPreferredWeapon();

            case Any -> InvUtils.findInHotbar(stack -> true);
        };
    }

    private FindItemResult findPreferredWeapon() {
        FindItemResult result = InvUtils.findInHotbar(
            stack -> stack.getItem() instanceof SwordItem
        );

        if (result.found()) return result;

        result = InvUtils.findInHotbar(
            stack -> stack.getItem() instanceof MaceItem
        );

        if (result.found()) return result;

        result = InvUtils.findInHotbar(
            stack -> stack.getItem() instanceof TridentItem
        );

        if (result.found()) return result;

        return InvUtils.findInHotbar(
            stack -> stack.getItem() instanceof AxeItem
        );
    }

    private boolean normalItemInHand() {
        Item item =
            mc.player.getMainHandStack().getItem();

        return switch (weapon.get()) {
            case Sword -> item instanceof SwordItem;
            case Axe -> item instanceof AxeItem;
            case Mace -> item instanceof MaceItem;
            case Trident -> item instanceof TridentItem;

            case All ->
                item instanceof SwordItem
                    || item instanceof AxeItem
                    || item instanceof MaceItem
                    || item instanceof TridentItem;

            case Any -> true;
        };
    }

    private boolean isTargetBlockingShield(Entity entity) {
        if (!(entity instanceof PlayerEntity player)) {
            return false;
        }

        boolean hasShield =
            player.getMainHandStack().isOf(Items.SHIELD)
                || player.getOffHandStack().isOf(Items.SHIELD);

        return hasShield
            && (
            player.isBlocking()
                || player.isUsingItem()
        );
    }

    private float getCooldownProgress() {
        if (
            bypassMode.get() != BypassMode.Standard
                || !customDelay.get()
        ) {
            return mc.player.getAttackCooldownProgress(0.5f);
        }

        float requiredTicks = getRequiredCustomTicks();

        if (requiredTicks <= 0) return 1.0f;

        return MathHelper.clamp(
            hitTimer / requiredTicks,
            0,
            1
        );
    }

    private boolean isCooldownReady(float progress) {
        if (switchTimer > 0) return false;

        if (
            bypassMode.get() == BypassMode.Standard
                && customDelay.get()
        ) {
            return hitTimer >= getRequiredCustomTicks();
        }

        return progress >= getEffectiveCooldownThreshold();
    }

    private double getEffectiveCooldownThreshold() {
        return switch (bypassMode.get()) {
            case Grim1 -> Math.max(
                cooldownThreshold.get(),
                0.90
            );

            case Grim2 -> Math.max(
                cooldownThreshold.get(),
                0.95
            );

            case Matrix -> Math.max(
                cooldownThreshold.get(),
                0.92
            );

            case Standard -> cooldownThreshold.get();
        };
    }

    private int getEffectiveSwitchDelay() {
        return switch (bypassMode.get()) {
            case Grim1 -> Math.max(switchDelay.get(), 1);
            case Grim2 -> Math.max(switchDelay.get(), 2);
            case Matrix -> Math.max(switchDelay.get(), 1);
            case Standard -> switchDelay.get();
        };
    }

    private float getRequiredCustomTicks() {
        float requiredTicks = hitDelay.get();

        if (tpsSync.get()) {
            float tickRate =
                TickRate.INSTANCE.getTickRate();

            float factor = tickRate / 20.0f;

            if (factor > 0) {
                requiredTicks /= factor;
            }
        }

        return Math.max(0, requiredTicks);
    }

    private double getEffectiveRange() {
        return range.get();
    }

    private double getEffectiveWallsRange() {
        if (
            bypassMode.get() != BypassMode.Standard
                || reachMode.get()
                != AuraReachController.Mode.Normal
        ) {
            return 0;
        }

        return Math.min(
            wallsRange.get(),
            getEffectiveRange()
        );
    }

    private AuraCriticalController.Mode
    getEffectiveCriticalMode() {
        AuraCriticalController.Mode mode =
            criticalMode.get();

        if (mode == AuraCriticalController.Mode.Off) {
            return mode;
        }

        if (
            mode == AuraCriticalController.Mode.Smart
                && !hasJumpSpace()
        ) {
            return AuraCriticalController.Mode.Off;
        }

        return mode;
    }

    private boolean hasJumpSpace() {
        if (mc.player == null || mc.world == null) {
            return false;
        }

        BlockPos basePosition =
            mc.player.getBlockPos();

        for (int offset = 2; offset <= 3; offset++) {
            BlockPos position =
                basePosition.up(offset);

            BlockState state =
                mc.world.getBlockState(position);

            if (
                !state.isAir()
                    && !state.getCollisionShape(
                    mc.world,
                    position
                ).isEmpty()
            ) {
                return false;
            }
        }

        return true;
    }

    private boolean entityCheck(Entity entity) {
        if (
            entity == null
                || entity == mc.player
                || entity == mc.cameraEntity
                || !entity.isAlive()
        ) {
            return false;
        }

        if (
            entity instanceof LivingEntity living
                && living.isDead()
        ) {
            return false;
        }

        Box hitbox = entity.getBoundingBox();

        double closestX = MathHelper.clamp(
            mc.player.getX(),
            hitbox.minX,
            hitbox.maxX
        );

        double closestY = MathHelper.clamp(
            mc.player.getEyeY(),
            hitbox.minY,
            hitbox.maxY
        );

        double closestZ = MathHelper.clamp(
            mc.player.getZ(),
            hitbox.minZ,
            hitbox.maxZ
        );

        if (
            !PlayerUtils.isWithin(
                closestX,
                closestY,
                closestZ,
                getEffectiveRange()
            )
        ) {
            return false;
        }

        if (!entities.get().contains(entity.getType())) {
            return false;
        }

        if (ignoreNamed.get() && entity.hasCustomName()) {
            return false;
        }

        if (
            !PlayerUtils.canSeeEntity(entity)
                && !PlayerUtils.isWithin(
                entity,
                getEffectiveWallsRange()
            )
        ) {
            return false;
        }

        if (
            ignoreTamed.get()
                && entity instanceof Tameable tameable
                && tameable.getOwnerUuid() != null
                && tameable.getOwnerUuid().equals(
                mc.player.getUuid()
            )
        ) {
            return false;
        }

        if (ignorePassive.get()) {
            if (
                entity instanceof EndermanEntity enderman
                    && !enderman.isAngry()
            ) {
                return false;
            }

            if (
                entity instanceof ZombifiedPiglinEntity piglin
                    && !piglin.isAttacking()
            ) {
                return false;
            }

            if (
                entity instanceof WolfEntity wolf
                    && !wolf.isAttacking()
            ) {
                return false;
            }
        }

        if (entity instanceof PlayerEntity player) {
            if (player.isCreative()) return false;

            if (!Friends.get().shouldAttack(player)) {
                return false;
            }

            if (
                shieldMode.get() == ShieldMode.Ignore
                    && isTargetBlockingShield(player)
            ) {
                return false;
            }
        }

        return true;
    }

    private void stopAttacking() {
        combatPrepared = false;
        preparedTarget = null;
        attacking = false;

        if (wasPathing) {
            PathManagers.get().resume();
            wasPathing = false;
        }

        if (swapped) {
            if (
                swapBack.get()
                    && previousSlot >= 0
                    && previousSlot <= 8
            ) {
                InvUtils.swap(previousSlot, false);
            }

            swapped = false;
            previousSlot = -1;
        }
    }

    private void clearCombat() {
        targets.clear();

        lockedTarget = null;
        preparedTarget = null;
        currentAimPoint = null;

        combatPrepared = false;
        grimRotationTicks = 0;

        aimPointResolver.reset();
        reachController.clearSelectedBox();
        criticalController.reset(mc.player);

        stopAttacking();
    }

    private void applyWorkingPreset() {
        weapon.set(Weapon.Any);
        rotation.set(RotationMode.Always);

        autoSwitch.set(false);
        onlyOnClick.set(false);
        onlyOnLook.set(false);
        pauseBaritone.set(false);

        shieldMode.set(ShieldMode.None);

        targetLock.set(true);
        maxTargets.set(1);

        pauseOnLag.set(false);
        pauseOnUse.set(false);
        pauseOnCA.set(false);

        customDelay.set(false);
        tpsSync.set(false);
        cooldownThreshold.set(0.90);
        switchDelay.set(0);

        criticalMode.set(
            AuraCriticalController.Mode.Smart
        );

        autoCriticalJump.set(true);
        jumpAtProgress.set(0.35);
        minimumFallDistance.set(0.0);

        bypassMode.set(BypassMode.Standard);
        reachMode.set(AuraReachController.Mode.Normal);
        strictRaycast.set(true);
        sprintReset.set(true);

        movementAssist.set(MovementAssistMode.None);

        hitTimer = 100;
        switchTimer = 0;
        shieldBreakCooldown = 0;
        grimRotationTicks = 0;

        combatPrepared = false;
        preparedTarget = null;

        aimPointResolver.reset();
        reachController.reset();
        criticalController.reset(mc.player);
    }

    public boolean isManagingCriticals() {
        return isActive()
            && mc.player != null
            && getEffectiveCriticalMode()
            != AuraCriticalController.Mode.Off
            && getTarget() != null;
    }

    public boolean shouldTargetStrafeJump() {
        return !isManagingCriticals()
            || !autoCriticalJump.get();
    }

    public boolean shouldSuppressSprint() {
        return isManagingCriticals()
            && criticalController.shouldSuppressSprint(
                getEffectiveCriticalMode()
            );
    }

    public boolean isWaitingForCritical() {
        return criticalController.isWaitingForCritical();
    }

    public AuraCriticalController.State getCriticalState() {
        return criticalController.getState();
    }

    public Entity getTarget() {
        return targets.isEmpty()
            ? null
            : targets.getFirst();
    }

    public Vec3d getCurrentAimPoint() {
        return currentAimPoint;
    }

    public BypassMode getBypassMode() {
        return bypassMode.get();
    }

    public AuraReachController.Mode getReachMode() {
        return reachMode.get();
    }

    @Override
    public String getInfoString() {
        Entity target = getTarget();

        if (target == null) {
            return bypassMode.get().name()
                + " | "
                + reachMode.get().name();
        }

        if (criticalController.isWaitingForCritical()) {
            return bypassMode.get().name()
                + " | "
                + criticalController.getState().name();
        }

        return bypassMode.get().name()
            + " | "
            + reachMode.get().name()
            + " | "
            + EntityUtils.getName(target);
    }

    public enum Weapon {
        Sword,
        Axe,
        Mace,
        Trident,
        All,
        Any
    }

    public enum RotationMode {
        Always,
        OnHit,
        None
    }

    public enum ShieldMode {
        Ignore,
        Break,
        None
    }

    public enum BypassMode {
        Standard,
        Grim1,
        Grim2,
        Matrix
    }

    public enum MovementAssistMode {
        None,
        Free,
        Focused,
        OrbitAssist
    }
}


