    private final Setting<Boolean> fade = sgRender.add(
        new BoolSetting.Builder()
            .name("fade")
            .description("Smooth appearance and disappearance.")
            .defaultValue(true)
            .build()
    );

    private TexturedMesh mesh;

    private Entity lastTarget;
    private Vec3d renderPosition;

    private double time;
    private float alpha;

    public TargetESP() {
        super(
            Categories.Render,
            "target-esp",
            "Renders animated textured ESP around KillAura target."
        );
    }

    @Override
    public void onActivate() {
        lastTarget = null;
        renderPosition = null;
        time = 0;
        alpha = 0;
    }

    @EventHandler
    private void onRender3D(Render3DEvent event) {
        if (mc.world == null || mc.player == null) return;

        if (mesh == null) {
            mesh = new TexturedMesh();
        }

        KillAura aura = Modules.get().get(KillAura.class);
        Entity target = aura != null && aura.isActive() ? aura.getTarget() : null;

        updateAlpha(target, event.frameTime);

        if (target != null) {
            lastTarget = target;
            renderPosition = interpolatedPosition(target, event.tickDelta);
        }

        if (renderPosition == null || lastTarget == null || alpha <= 0.005f) {
            return;
        }

        time += event.frameTime * speed.get();

        mesh.texture = texture.get().identifier;
        mesh.additive = additive.get();
        mesh.depthTest = !throughWalls.get();

        mesh.begin();

        switch (animation.get()) {
            case Ghosts -> renderGhosts(lastTarget);
            case Orbit -> renderOrbit(lastTarget, false);
            case DoubleOrbit -> renderOrbit(lastTarget, true);
            case Helix -> renderHelix(lastTarget);
            case Halo -> renderHalo(lastTarget);
            case AboveHead -> renderAboveHead(lastTarget);
            case BodyMarker -> renderBody(lastTarget);
            case Pulse -> renderPulse(lastTarget);
        }

        mesh.render(event.matrices);

        if (target == null && alpha <= 0.005f) {
            lastTarget = null;
            renderPosition = null;
        }
    }

    private Vec3d interpolatedPosition(Entity entity, float tickDelta) {
        return new Vec3d(
            MathHelper.lerp(tickDelta, entity.lastRenderX, entity.getX()),
            MathHelper.lerp(tickDelta, entity.lastRenderY, entity.getY()),
            MathHelper.lerp(tickDelta, entity.lastRenderZ, entity.getZ())
        );
    }

    private void updateAlpha(Entity target, double delta) {
        float destination = target != null ? 1f : 0f;

        if (!fade.get()) {
            alpha = destination;
            return;
        }

        float factor = (float) Math.min(1, delta * 8);
        alpha = MathHelper.lerp(factor, alpha, destination);

        if (Math.abs(alpha - destination) < 0.005f) {
            alpha = destination;
        }
    }

    private void renderGhosts(Entity entity) {
        int particles = count.get();
        int trailCount = trails.get();

        for (int particle = 0; particle < particles; particle++) {
            double offset = Math.PI * 2 * particle / particles;

            for (int trail = trailCount - 1; trail >= 0; trail--) {
                double delayedTime = time - trail * trailDistance.get();
                double angle = delayedTime + offset;

                double x = renderPosition.x + Math.cos(angle) * radius.get();
                double z = renderPosition.z + Math.sin(angle) * radius.get();

                double wave = Math.sin(delayedTime * 1.7 + offset);
                double y = renderPosition.y
                    + entity.getHeight() * 0.5
                    + wave * height.get();

                float trailAlpha = (float) (1.0 - trail / (double) trailCount);
                trailAlpha *= trailAlpha;

                double scale = size.get() * (0.65 + trailAlpha * 0.35);
                double rotation = Math.toDegrees(-angle) + time * spinSpeed.get();

                addSprite(x, y, z, scale, rotation, trailAlpha);
            }
        }
    }

    private void renderOrbit(Entity entity, boolean doubleOrbit) {
        int particles = count.get();

        for (int i = 0; i < particles; i++) {
            double offset = Math.PI * 2 * i / particles;
            double angle = time + offset;

            addOrbitSprite(entity, angle, 1, i);

            if (doubleOrbit) {
                addOrbitSprite(entity, -angle, -1, i);
            }
        }
    }

    private void addOrbitSprite(Entity entity, double angle, int direction, int index) {
        double x = renderPosition.x + Math.cos(angle) * radius.get();
        double z = renderPosition.z + Math.sin(angle) * radius.get();

        double y = renderPosition.y
            + entity.getHeight() * 0.5
            + Math.sin(angle * 2 + index) * height.get();

        double rotation = time * spinSpeed.get() * direction;

        addSprite(x, y, z, size.get(), rotation, 1);
    }

    private void renderHelix(Entity entity) {
        int particles = Math.max(2, count.get());

        for (int i = 0; i < particles; i++) {
            double progress = i / (double) particles;
            double angle = time + progress * Math.PI * 4;

            double x = renderPosition.x + Math.cos(angle) * radius.get();
            double z = renderPosition.z + Math.sin(angle) * radius.get();

            double normalized = (Math.sin(angle * 0.5) + 1) * 0.5;
            double y = renderPosition.y + normalized * entity.getHeight();

            addSprite(
                x,
                y,
                z,
                size.get(),
                Math.toDegrees(-angle) + time * spinSpeed.get(),
                1
            );
        }
    }

    private void renderHalo(Entity entity) {
        int particles = Math.max(3, count.get());

        for (int i = 0; i < particles; i++) {
            double angle = time + Math.PI * 2 * i / particles;

            double x = renderPosition.x + Math.cos(angle) * radius.get();
            double z = renderPosition.z + Math.sin(angle) * radius.get();
            double y = renderPosition.y + entity.getHeight() + height.get();

            addSprite(
                x,
                y,
                z,
                size.get(),
                Math.toDegrees(-angle) + 90,
                1
            );
        }
    }

    private void renderAboveHead(Entity entity) {
        double pulse = 1 + Math.sin(time * pulseSpeed.get()) * 0.12;

        addSprite(
            renderPosition.x,
            renderPosition.y + entity.getHeight() + height.get(),
            renderPosition.z,
            size.get() * pulse,
            time * spinSpeed.get(),
            1
        );
    }

    private void renderBody(Entity entity) {
        double pulse = 1 + Math.sin(time * pulseSpeed.get()) * 0.05;

        addSprite(
            renderPosition.x,
            renderPosition.y + entity.getHeight() * 0.52,
            renderPosition.z,
            size.get() * 2.5 * pulse,
            time * spinSpeed.get(),
            1
        );
    }

    private void renderPulse(Entity entity) {
        double pulse = 0.72
            + (Math.sin(time * pulseSpeed.get()) + 1) * 0.28;

        addSprite(
            renderPosition.x,
            renderPosition.y + entity.getHeight() * 0.52,
            renderPosition.z,
            size.get() * 2.2 * pulse,
            time * spinSpeed.get(),
            (float) (0.55 + pulse * 0.45)
        );
    }

    private void addSprite(
        double x,
        double y,
        double z,
        double spriteSize,
        double rotation,
        float alphaMultiplier
    ) {
        Color source = color.get();

        int finalAlpha = (int) (
            source.a
                * alpha
                * MathHelper.clamp(alphaMultiplier, 0, 1)
        );

        if (finalAlpha <= 0) return;

        Color spriteColor = new Color(
            source.r,
            source.g,
            source.b,
            finalAlpha
        );

        float yaw = (float) Math.toRadians(
            mc.gameRenderer.getCamera().getYaw()
        );

        float pitch = (float) Math.toRadians(
            mc.gameRenderer.getCamera().getPitch()
        );

        double sinYaw = Math.sin(yaw);
        double cosYaw = Math.cos(yaw);
        double sinPitch = Math.sin(pitch);
        double cosPitch = Math.cos(pitch);

        Vec3d right = new Vec3d(
            cosYaw,
            0,
            sinYaw
        );

        Vec3d up = new Vec3d(
            -sinYaw * sinPitch,
            cosPitch,
            cosYaw * sinPitch
        );

        double radians = Math.toRadians(rotation);
        double cos = Math.cos(radians);
        double sin = Math.sin(radians);

        Vec3d rotatedRight = right.multiply(cos).add(up.multiply(sin));
        Vec3d rotatedUp = up.multiply(cos).subtract(right.multiply(sin));

        Vec3d horizontal = rotatedRight.multiply(spriteSize);
        Vec3d vertical = rotatedUp.multiply(spriteSize);
        Vec3d center = new Vec3d(x, y, z);

        Vec3d topLeft = center.subtract(horizontal).add(vertical);
        Vec3d bottomLeft = center.subtract(horizontal).subtract(vertical);
        Vec3d bottomRight = center.add(horizontal).subtract(vertical);
        Vec3d topRight = center.add(horizontal).add(vertical);

        int i1 = mesh.vec3(topLeft.x, topLeft.y, topLeft.z)
            .vec2(0, 0)
            .color(spriteColor)
            .next();

        int i2 = mesh.vec3(bottomLeft.x, bottomLeft.y, bottomLeft.z)
            .vec2(0, 1)
            .color(spriteColor)
            .next();

        int i3 = mesh.vec3(bottomRight.x, bottomRight.y, bottomRight.z)
            .vec2(1, 1)
            .color(spriteColor)
            .next();

        int i4 = mesh.vec3(topRight.x, topRight.y, topRight.z)
            .vec2(1, 0)
            .color(spriteColor)
            .next();

        mesh.quad(i1, i2, i3, i4);
    }

    private static class TexturedMesh extends ShaderMesh {
        private Identifier texture;
        private boolean additive;

        private TexturedMesh() {
            super(
                Shaders.POS_TEX_COLOR,
                DrawMode.Triangles,
                Mesh.Attrib.Vec3,
                Mesh.Attrib.Vec2,
                Mesh.Attrib.Color
            );
        }

        @Override
        protected void beforeRender() {
            super.beforeRender();

            mc.getTextureManager().bindTexture(texture);

            if (additive) {
                GlStateManager._blendFunc(GL_SRC_ALPHA, GL_ONE);
            } else {
                GlStateManager._blendFunc(
                    GL_SRC_ALPHA,
                    GL_ONE_MINUS_SRC_ALPHA
                );
            }
        }
    }

