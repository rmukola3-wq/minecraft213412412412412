package meteordevelopment.meteorclient.systems.modules.combat.aura;

import meteordevelopment.meteorclient.utils.player.Rotations;
import net.minecraft.client.network.ClientPlayerEntity;
import net.minecraft.entity.Entity;
import net.minecraft.network.packet.c2s.play.ClientCommandC2SPacket;
import net.minecraft.network.packet.c2s.play.PlayerMoveC2SPacket;
import net.minecraft.util.math.Box;
import net.minecraft.util.math.MathHelper;
import net.minecraft.util.math.Vec3d;

import java.util.ArrayDeque;
import java.util.HashMap;
import java.util.Iterator;
import java.util.Map;
import java.util.concurrent.ThreadLocalRandom;

public final class AuraReachController {
    private final Map<Integer, ArrayDeque<Snapshot>> history =
        new HashMap<>();

    private long currentTick;

    private int selectedEntityId = -1;
    private Box selectedBox;

    public void reset() {
        history.clear();

        currentTick = 0;
        selectedEntityId = -1;
        selectedBox = null;
    }

    public void tick() {
        currentTick++;

        Iterator<Map.Entry<Integer, ArrayDeque<Snapshot>>> iterator =
            history.entrySet().iterator();

        while (iterator.hasNext()) {
            Map.Entry<Integer, ArrayDeque<Snapshot>> entry =
                iterator.next();

            ArrayDeque<Snapshot> snapshots = entry.getValue();

            while (
                !snapshots.isEmpty()
                    && currentTick - snapshots.getFirst().tick > 60
            ) {
                snapshots.removeFirst();
            }

            if (snapshots.isEmpty()) {
                iterator.remove();
            }
        }
    }

    public void record(Entity entity, int maximumTicks) {
        if (entity == null || !entity.isAlive()) return;

        int limit = MathHelper.clamp(maximumTicks + 3, 4, 64);

        ArrayDeque<Snapshot> snapshots =
            history.computeIfAbsent(
                entity.getId(),
                ignored -> new ArrayDeque<>()
            );

        snapshots.addLast(
            new Snapshot(
                currentTick,
                entity.getBoundingBox()
            )
        );

        while (snapshots.size() > limit) {
            snapshots.removeFirst();
        }
    }

    public Vec3d resolveBacktrackPoint(
        ClientPlayerEntity player,
        Entity target,
        int maximumTicks,
        double attackRange
    ) {
        clearSelectedBox();

        if (
            player == null
                || target == null
                || attackRange <= 0
        ) {
            return null;
        }

        Vec3d eyes = player.getEyePos();

        Box bestBox = null;
        Vec3d bestPoint = null;
        double bestDistance = Double.MAX_VALUE;

        ArrayDeque<Snapshot> snapshots =
            history.get(target.getId());

        if (snapshots != null) {
            Iterator<Snapshot> iterator =
                snapshots.descendingIterator();

            while (iterator.hasNext()) {
                Snapshot snapshot = iterator.next();

                long age = currentTick - snapshot.tick;

                if (age < 0 || age > maximumTicks) {
                    continue;
                }

                Vec3d point = closestPoint(
                    eyes,
                    snapshot.box
                );

                double distance =
                    eyes.squaredDistanceTo(point);

                if (
                    distance <= attackRange * attackRange
                        && distance < bestDistance
                ) {
                    bestDistance = distance;
                    bestPoint = point;
                    bestBox = snapshot.box;
                }
            }
        }

        Box currentBox = target.getBoundingBox();
        Vec3d currentPoint = closestPoint(eyes, currentBox);
        double currentDistance =
            eyes.squaredDistanceTo(currentPoint);

        if (
            currentDistance <= attackRange * attackRange
                && currentDistance < bestDistance
        ) {
            bestPoint = currentPoint;
            bestBox = currentBox;
        }

        if (bestBox != null) {
            selectedEntityId = target.getId();
            selectedBox = bestBox;
        }

        return bestPoint;
    }

    public Box getCombatBox(Entity target) {
        if (
            target != null
                && target.getId() == selectedEntityId
                && selectedBox != null
        ) {
            return selectedBox;
        }

        return target == null
            ? null
            : target.getBoundingBox();
    }

    public void clearSelectedBox() {
        selectedEntityId = -1;
        selectedBox = null;
    }

    public boolean isLookingAt(
        ClientPlayerEntity player,
        Entity target,
        float yaw,
        float pitch,
        double range
    ) {
        if (
            player == null
                || target == null
                || range <= 0
        ) {
            return false;
        }

        Vec3d eyes = player.getEyePos();
        Vec3d direction = rotationVector(yaw, pitch);
        Vec3d end = eyes.add(direction.multiply(range));

        Box box = getCombatBox(target);

        return box != null
            && (
            box.contains(eyes)
                || box.raycast(eyes, end).isPresent()
        );
    }

    public SpoofSession beginPositionSpoof(
        ClientPlayerEntity player,
        Vec3d targetPoint,
        double safeRange,
        double maximumStep,
        double jitter
    ) {
        if (
            player == null
                || player.networkHandler == null
                || targetPoint == null
                || safeRange <= 0
                || maximumStep < 0
        ) {
            return null;
        }

        Vec3d originalPosition = player.getPos();
        Vec3d originalEyes = player.getEyePos();

        double targetDistance =
            originalEyes.distanceTo(targetPoint);

        if (targetDistance <= safeRange) {
            Rotation rotation = rotationTo(
                originalEyes,
                targetPoint
            );

            sendLookPacket(
                player,
                rotation.yaw,
                rotation.pitch
            );

            return new SpoofSession(
                originalPosition,
                originalPosition,
                rotation.yaw,
                rotation.pitch,
                false
            );
        }

        Vec3d direction =
            targetPoint.subtract(originalEyes);

        if (direction.lengthSquared() < 1.0E-7) {
            return null;
        }

        direction = direction.normalize();

        Vec3d desiredEyes = targetPoint.subtract(
            direction.multiply(safeRange)
        );

        double eyeOffset =
            player.getEyeY() - player.getY();

        Vec3d spoofPosition = desiredEyes.subtract(
            0,
            eyeOffset,
            0
        );

        double requiredStep =
            originalPosition.distanceTo(spoofPosition);

        if (requiredStep > maximumStep) {
            return null;
        }

        double safeJitter = Math.max(0, jitter);

        if (safeJitter > 0) {
            ThreadLocalRandom random =
                ThreadLocalRandom.current();

            spoofPosition = spoofPosition.add(
                random.nextDouble(
                    -safeJitter,
                    safeJitter
                ),
                0,
                random.nextDouble(
                    -safeJitter,
                    safeJitter
                )
            );
        }

        Vec3d spoofEyes = spoofPosition.add(
            0,
            eyeOffset,
            0
        );

        Rotation rotation = rotationTo(
            spoofEyes,
            targetPoint
        );

        player.networkHandler.sendPacket(
            new PlayerMoveC2SPacket.Full(
                spoofPosition.x,
                spoofPosition.y,
                spoofPosition.z,
                rotation.yaw,
                rotation.pitch,
                player.isOnGround(),
                player.horizontalCollision
            )
        );

        return new SpoofSession(
            originalPosition,
            spoofPosition,
            rotation.yaw,
            rotation.pitch,
            true
        );
    }

    public void finishPositionSpoof(
        ClientPlayerEntity player,
        SpoofSession session
    ) {
        if (
            player == null
                || player.networkHandler == null
                || session == null
                || !session.moved
        ) {
            return;
        }

        player.networkHandler.sendPacket(
            new PlayerMoveC2SPacket.Full(
                session.originalPosition.x,
                session.originalPosition.y,
                session.originalPosition.z,
                Rotations.serverYaw,
                Rotations.serverPitch,
                player.isOnGround(),
                player.horizontalCollision
            )
        );
    }

    public SprintSession stopSprint(
        ClientPlayerEntity player,
        boolean enabled
    ) {
        if (
            !enabled
                || player == null
                || player.networkHandler == null
                || !player.isSprinting()
        ) {
            return SprintSession.NONE;
        }

        player.setSprinting(false);

        player.networkHandler.sendPacket(
            new ClientCommandC2SPacket(
                player,
                ClientCommandC2SPacket.Mode.STOP_SPRINTING
            )
        );

        return new SprintSession(true);
    }

    public void restoreSprint(
        ClientPlayerEntity player,
        SprintSession session
    ) {
        if (
            player == null
                || player.networkHandler == null
                || session == null
                || !session.restore
        ) {
            return;
        }

        player.setSprinting(true);

        player.networkHandler.sendPacket(
            new ClientCommandC2SPacket(
                player,
                ClientCommandC2SPacket.Mode.START_SPRINTING
            )
        );
    }

    public void sendLookPacket(
        ClientPlayerEntity player,
        Vec3d point
    ) {
        if (player == null || point == null) return;

        Rotation rotation = rotationTo(
            player.getEyePos(),
            point
        );

        sendLookPacket(
            player,
            rotation.yaw,
            rotation.pitch
        );
    }

    private void sendLookPacket(
        ClientPlayerEntity player,
        float yaw,
        float pitch
    ) {
        if (
            player == null
                || player.networkHandler == null
        ) {
            return;
        }

        player.networkHandler.sendPacket(
            new PlayerMoveC2SPacket.LookAndOnGround(
                yaw,
                pitch,
                player.isOnGround(),
                player.horizontalCollision
            )
        );
    }

    private Vec3d closestPoint(
        Vec3d eyes,
        Box box
    ) {
        double minimumY = box.minY + 0.03;
        double maximumY = box.maxY - 0.03;

        if (maximumY < minimumY) {
            minimumY = box.minY;
            maximumY = box.maxY;
        }

        return new Vec3d(
            MathHelper.clamp(
                eyes.x,
                box.minX,
                box.maxX
            ),
            MathHelper.clamp(
                eyes.y,
                minimumY,
                maximumY
            ),
            MathHelper.clamp(
                eyes.z,
                box.minZ,
                box.maxZ
            )
        );
    }

    private Rotation rotationTo(
        Vec3d origin,
        Vec3d target
    ) {
        double differenceX = target.x - origin.x;
        double differenceY = target.y - origin.y;
        double differenceZ = target.z - origin.z;

        double horizontalDistance = Math.sqrt(
            differenceX * differenceX
                + differenceZ * differenceZ
        );

        float yaw = (float) (
            Math.toDegrees(
                Math.atan2(
                    differenceZ,
                    differenceX
                )
            ) - 90
        );

        float pitch = MathHelper.clamp(
            (float) -Math.toDegrees(
                Math.atan2(
                    differenceY,
                    horizontalDistance
                )
            ),
            -90,
            90
        );

        return new Rotation(yaw, pitch);
    }

    private Vec3d rotationVector(
        float yaw,
        float pitch
    ) {
        float yawRadians =
            -yaw * 0.017453292F;

        float pitchRadians =
            pitch * 0.017453292F;

        float yawCos =
            MathHelper.cos(yawRadians);

        float yawSin =
            MathHelper.sin(yawRadians);

        float pitchCos =
            MathHelper.cos(pitchRadians);

        float pitchSin =
            MathHelper.sin(pitchRadians);

        return new Vec3d(
            yawSin * pitchCos,
            -pitchSin,
            yawCos * pitchCos
        );
    }

    private record Snapshot(
        long tick,
        Box box
    ) {
    }

    private record Rotation(
        float yaw,
        float pitch
    ) {
    }

    public record SpoofSession(
        Vec3d originalPosition,
        Vec3d spoofPosition,
        float yaw,
        float pitch,
        boolean moved
    ) {
    }

    public record SprintSession(
        boolean restore
    ) {
        private static final SprintSession NONE =
            new SprintSession(false);
    }

    public enum Mode {
        Normal,
        BackTrack,
        PositionSpoof
    }
}


