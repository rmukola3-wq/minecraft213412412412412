package meteordevelopment.meteorclient.systems.modules.render;

import meteordevelopment.meteorclient.events.render.Render3DEvent;
import meteordevelopment.meteorclient.settings.*;
import meteordevelopment.meteorclient.systems.modules.Categories;
import meteordevelopment.meteorclient.systems.modules.Module;
import meteordevelopment.meteorclient.systems.modules.Modules;
import meteordevelopment.meteorclient.systems.modules.combat.KillAura;
import meteordevelopment.meteorclient.utils.render.color.Color;
import meteordevelopment.meteorclient.utils.render.color.SettingColor;
import meteordevelopment.orbit.EventHandler;
import net.minecraft.entity.Entity;
import net.minecraft.entity.LivingEntity;
import net.minecraft.util.math.MathHelper;
import net.minecraft.util.math.Vec3d;

public class TargetESP extends Module {
    private final SettingGroup sgGeneral = settings.getDefaultGroup();
    private final SettingGroup sgAppearance = settings.createGroup("Appearance");

    private final Setting<EspMode> mode = sgGeneral.add(
        new EnumSetting.Builder<EspMode>()
            .name("mode")
            .description("Target ESP design.")
            .defaultValue(EspMode.RastyRhomb)
            .build()
    );

    private final Setting<SettingColor> primaryColor = sgAppearance.add(
        new ColorSetting.Builder()
            .name("primary-color")
            .description("Primary ESP color.")
            .defaultValue(new SettingColor(154, 92, 224, 220))
            .build()
    );

    private final Setting<SettingColor> secondaryColor = sgAppearance.add(
        new ColorSetting.Builder()
            .name("secondary-color")
            .description("Secondary gradient color.")
            .defaultValue(new SettingColor(70, 170, 255, 180))
            .build()
    );

    private final Setting<Double> size = sgAppearance.add(
        new DoubleSetting.Builder()
            .name("size")
            .description("ESP size multiplier.")
            .defaultValue(1.0)
            .range(0.2, 3.0)
            .sliderRange(0.2, 2.0)
            .decimalPlaces(2)
            .build()
    );

    private final Setting<Double> animationSpeed = sgAppearance.add(
        new DoubleSetting.Builder()
            .name("animation-speed")
            .description("Animation speed.")
            .defaultValue(1.0)
            .range(0.0, 5.0)
            .sliderRange(0.0, 3.0)
            .decimalPlaces(2)
            .build()
    );

    private final Setting<Integer> segments = sgAppearance.add(
        new IntSetting.Builder()
            .name("segments")
            .description("Circle and trail detail.")
            .defaultValue(48)
            .range(16, 120)
            .sliderRange(16, 80)
            .build()
    );

    private final Setting<Boolean> fade = sgAppearance.add(
        new BoolSetting.Builder()
            .name("fade")
            .description("Smooth target appearance and disappearance.")
            .defaultValue(true)
            .build()
    );

    private final Setting<Boolean> hurtColor = sgAppearance.add(
        new BoolSetting.Builder()
            .name("hurt-color")
            .description("Flashes red when the target takes damage.")
            .defaultValue(true)
            .build()
    );

    private Entity lastTarget;
    private Vec3d smoothPosition;

    private double targetWidth = 0.6;
    private double targetHeight = 1.8;

    private float alpha;
    private float hurtProgress;
    private double animationTime;
    private long lastFrameTime;

    public TargetESP() {
        super(
            Categories.Render,
            "target-esp",
            "Multiple Target ESP designs from popular clients."
        );
    }

    @Override
    public void onActivate() {
        lastTarget = null;
        smoothPosition = null;

        alpha = 0;
        hurtProgress = 0;
        animationTime = 0;
        lastFrameTime = System.nanoTime();
    }

    @Override
    public void onDeactivate() {
        lastTarget = null;
        smoothPosition = null;
    }

    @EventHandler
    private void onRender3D(Render3DEvent event) {
        if (mc.player == null || mc.world == null) return;

        KillAura aura = Modules.get().get(KillAura.class);

        Entity target =
            aura != null && aura.isActive()
                ? aura.getTarget()
                : null;

        double delta = updateTime();

        updateTarget(
            event,
            target,
            delta
        );

        if (
            smoothPosition == null
                || alpha <= 0.01f
        ) {
            return;
        }

        float hurt = hurtColor.get()
            ? hurtProgress
            : 0.0f;

        Color primary = createColor(
            primaryColor.get(),
            alpha,
            hurt
        );

        Color secondary = createColor(
            secondaryColor.get(),
            alpha,
            hurt
        );

        switch (mode.get()) {
            case Expensive ->
                renderExpensive(
                    event,
                    primary,
                    secondary
                );

            case RastyRhomb ->
                renderRastyRhomb(
                    event,
                    primary,
                    secondary
                );

            case RastyChain ->
                renderRastyChain(
                    event,
                    primary,
                    secondary
                );

            case RastyCrystals ->
                renderRastyCrystals(
                    event,
                    primary,
                    secondary
                );

            case RastyCircle ->
                renderRastyCircle(
                    event,
                    primary,
                    secondary
                );

            case RockstarJello ->
                renderRockstarJello(
                    event,
                    primary,
                    secondary
                );

            case RockstarSims ->
                renderRockstarSims(
                    event,
                    primary,
                    secondary
                );

            case Thunder ->
                renderThunder(
                    event,
                    primary,
                    secondary
                );

            case ThunderGhosts ->
                renderThunderGhosts(
                    event,
                    primary,
                    secondary
                );

            case ThunderCelka ->
                renderThunderCelka(
                    event,
                    primary,
                    secondary
                );

            case WildFire ->
                renderWildFire(
                    event,
                    primary,
                    secondary
                );
        }
    }

    private double updateTime() {
        long now = System.nanoTime();

        double delta =
            lastFrameTime == 0
                ? 1.0 / 60.0
                : (now - lastFrameTime)
                    / 1_000_000_000.0;

        lastFrameTime = now;

        delta = MathHelper.clamp(
            delta,
            0.0,
            0.05
        );

        animationTime +=
            delta
                * animationSpeed.get();

        return delta;
    }

    private void updateTarget(
        Render3DEvent event,
        Entity target,
        double delta
    ) {
        float wantedAlpha =
            target == null ? 0.0f : 1.0f;

        if (fade.get()) {
            float factor = Math.min(
                1.0f,
                (float) delta * 9.0f
            );

            alpha +=
                (wantedAlpha - alpha)
                    * factor;
        } else {
            alpha = wantedAlpha;
        }

        if (target != null) {
            Vec3d wantedPosition = new Vec3d(
                MathHelper.lerp(
                    event.tickDelta,
                    target.lastRenderX,
                    target.getX()
                ),
                MathHelper.lerp(
                    event.tickDelta,
                    target.lastRenderY,
                    target.getY()
                ),
                MathHelper.lerp(
                    event.tickDelta,
                    target.lastRenderZ,
                    target.getZ()
                )
            );

            if (
                lastTarget != target
                    || smoothPosition == null
            ) {
                smoothPosition = wantedPosition;
            } else {
                double factor = Math.min(
                    1.0,
                    delta * 14.0
                );

                smoothPosition = new Vec3d(
                    MathHelper.lerp(
                        factor,
                        smoothPosition.x,
                        wantedPosition.x
                    ),
                    MathHelper.lerp(
                        factor,
                        smoothPosition.y,
                        wantedPosition.y
                    ),
                    MathHelper.lerp(
                        factor,
                        smoothPosition.z,
                        wantedPosition.z
                    )
                );
            }

            targetWidth = target.getWidth();
            targetHeight = target.getHeight();
            lastTarget = target;

            if (
                target instanceof LivingEntity living
                    && living.hurtTime > 0
            ) {
                hurtProgress = Math.max(
                    hurtProgress,
                    living.hurtTime / 10.0f
                );
            }
        }

        hurtProgress = Math.max(
            0.0f,
            hurtProgress
                - (float) delta * 3.5f
        );

        if (target == null && alpha <= 0.01f) {
            lastTarget = null;
            smoothPosition = null;
        }
    }

    private void renderExpensive(
        Render3DEvent event,
        Color primary,
        Color secondary
    ) {
        double scale = size.get();
        double y =
            smoothPosition.y
                + targetHeight * 0.5;

        drawDiamond(
            event,
            smoothPosition.x,
            y,
            smoothPosition.z,
            0.45 * scale,
            0.60 * scale,
            animationTime * 2.0,
            primary,
            secondary
        );

        drawRing(
            event,
            smoothPosition.x,
            y,
            smoothPosition.z,
            0.52 * scale,
            animationTime,
            primary
        );
    }

    private void renderRastyRhomb(
        Render3DEvent event,
        Color primary,
        Color secondary
    ) {
        double scale = size.get();
        double pulse =
            1.0
                + Math.sin(animationTime * 3.0)
                * 0.08;

        drawDiamond(
            event,
            smoothPosition.x,
            smoothPosition.y
                + targetHeight * 0.52,
            smoothPosition.z,
            0.52 * scale * pulse,
            0.72 * scale * pulse,
            animationTime * 2.5,
            primary,
            secondary
        );
    }

    private void renderRastyChain(
        Render3DEvent event,
        Color primary,
        Color secondary
    ) {
        int count = segments.get();
        double radius =
            Math.max(
                targetWidth * 0.85,
                0.45
            ) * size.get();

        for (int chain = 0; chain < 2; chain++) {
            double phase =
                animationTime * 2.2
                    + chain * Math.PI;

            for (int i = 0; i < count; i++) {
                double progress1 =
                    i / (double) count;

                double progress2 =
                    (i + 1.0) / count;

                double angle1 =
                    phase
                        + progress1
                        * Math.PI
                        * 4.0;

                double angle2 =
                    phase
                        + progress2
                        * Math.PI
                        * 4.0;

                double x1 =
                    smoothPosition.x
                        + Math.cos(angle1)
                        * radius;

                double z1 =
                    smoothPosition.z
                        + Math.sin(angle1)
                        * radius;

                double x2 =
                    smoothPosition.x
                        + Math.cos(angle2)
                        * radius;

                double z2 =
                    smoothPosition.z
                        + Math.sin(angle2)
                        * radius;

                double y1 =
                    smoothPosition.y
                        + progress1
                        * targetHeight;

                double y2 =
                    smoothPosition.y
                        + progress2
                        * targetHeight;

                Color color = mixColor(
                    primary,
                    secondary,
                    (float) progress1
                );

                event.renderer.line(
                    x1,
                    y1,
                    z1,
                    x2,
                    y2,
                    z2,
                    color
                );

                if (i % 4 == 0) {
                    event.renderer.line(
                        x1,
                        y1 - 0.07,
                        z1,
                        x1,
                        y1 + 0.07,
                        z1,
                        color
                    );
                }
            }
        }
    }

    private void renderRastyCrystals(
        Render3DEvent event,
        Color primary,
        Color secondary
    ) {
        double scale = size.get();
        double radius =
            Math.max(
                targetWidth,
                0.65
            ) * scale;

        for (int i = 0; i < 5; i++) {
            double angle =
                animationTime * 1.8
                    + i
                    * Math.PI
                    * 2.0
                    / 5.0;

            double x =
                smoothPosition.x
                    + Math.cos(angle)
                    * radius;

            double z =
                smoothPosition.z
                    + Math.sin(angle)
                    * radius;

            double y =
                smoothPosition.y
                    + targetHeight * 0.5
                    + Math.sin(
                    animationTime * 2.5 + i
                ) * 0.28;

            drawDiamond(
                event,
                x,
                y,
                z,
                0.14 * scale,
                0.25 * scale,
                -angle,
                primary,
                secondary
            );
        }
    }

    private void renderRastyCircle(
        Render3DEvent event,
        Color primary,
        Color secondary
    ) {
        double progress =
            0.5
                + Math.sin(animationTime * 2.2)
                * 0.5;

        double y =
            smoothPosition.y
                + progress
                * targetHeight;

        double direction =
            Math.cos(animationTime * 2.2);

        double tail =
            direction > 0
                ? -0.32
                : 0.32;

        double radius =
            Math.max(
                targetWidth * 0.8,
                0.38
            ) * size.get();

        drawGradientRing(
            event,
            y,
            y + tail,
            radius,
            animationTime,
            primary,
            secondary
        );
    }

    private void renderRockstarJello(
        Render3DEvent event,
        Color primary,
        Color secondary
    ) {
        double wave =
            0.5
                + Math.sin(animationTime * 1.8)
                * 0.5;

        double y =
            smoothPosition.y
                + targetHeight
                * wave;

        double direction =
            Math.cos(animationTime * 1.8);

        double tail =
            direction > 0
                ? -targetHeight * 0.18
                : targetHeight * 0.18;

        double radius =
            Math.max(
                targetWidth * 0.75,
                0.42
            ) * size.get();

        drawGradientRing(
            event,
            y,
            y + tail,
            radius,
            0,
            primary,
            secondary
        );

        drawRing(
            event,
            smoothPosition.x,
            y,
            smoothPosition.z,
            radius,
            0,
            primary
        );
    }

    private void renderRockstarSims(
        Render3DEvent event,
        Color primary,
        Color secondary
    ) {
        double scale = size.get();
        double bob =
            0.18
                + Math.sin(animationTime * 2.6)
                * 0.10;

        double x = smoothPosition.x;
        double y =
            smoothPosition.y
                + targetHeight
                + 0.35
                + bob;

        double z = smoothPosition.z;

        double radius = 0.22 * scale;
        double halfHeight = 0.38 * scale;

        drawDiamond(
            event,
            x,
            y,
            z,
            radius,
            halfHeight,
            animationTime * 1.2,
            primary,
            secondary
        );

        drawRing(
            event,
            x,
            y,
            z,
            radius * 0.75,
            animationTime,
            secondary
        );
    }

    private void renderThunder(
        Render3DEvent event,
        Color primary,
        Color secondary
    ) {
        double scale = size.get();
        double radius =
            Math.max(
                targetWidth * 0.85,
                0.48
            ) * scale;

        for (int ring = 0; ring < 3; ring++) {
            double y =
                smoothPosition.y
                    + targetHeight
                    * (0.22 + ring * 0.28);

            double phase =
                animationTime
                    * (ring % 2 == 0 ? 1.8 : -1.8)
                    + ring;

            drawRing(
                event,
                smoothPosition.x,
                y,
                smoothPosition.z,
                radius
                    * (1.0 - ring * 0.08),
                phase,
                ring % 2 == 0
                    ? primary
                    : secondary
            );
        }

        int count = 8;

        for (int i = 0; i < count; i++) {
            double angle =
                animationTime * 1.8
                    + i
                    * Math.PI
                    * 2.0
                    / count;

            double x =
                smoothPosition.x
                    + Math.cos(angle)
                    * radius;

            double z =
                smoothPosition.z
                    + Math.sin(angle)
                    * radius;

            event.renderer.line(
                x,
                smoothPosition.y
                    + targetHeight * 0.2,
                z,
                smoothPosition.x
                    + Math.cos(angle + 0.8)
                    * radius * 0.8,
                smoothPosition.y
                    + targetHeight * 0.8,
                smoothPosition.z
                    + Math.sin(angle + 0.8)
                    * radius * 0.8,
                mixColor(
                    primary,
                    secondary,
                    i / (float) count
                )
            );
        }
    }

    private void renderThunderGhosts(
        Render3DEvent event,
        Color primary,
        Color secondary
    ) {
        int trails = 4;
        int length = Math.max(
            10,
            segments.get() / 2
        );

        double radius =
            Math.max(
                targetWidth,
                0.6
            ) * size.get();

        for (int trail = 0; trail < trails; trail++) {
            double basePhase =
                trail
                    * Math.PI
                    * 2.0
                    / trails;

            for (int i = 0; i < length; i++) {
                double progress1 =
                    i / (double) length;

                double progress2 =
                    (i + 1.0) / length;

                double angle1 =
                    animationTime * 2.6
                        + basePhase
                        - progress1 * 1.8;

                double angle2 =
                    animationTime * 2.6
                        + basePhase
                        - progress2 * 1.8;

                double x1 =
                    smoothPosition.x
                        + Math.cos(angle1)
                        * radius;

                double z1 =
                    smoothPosition.z
                        + Math.sin(angle1)
                        * radius;

                double x2 =
                    smoothPosition.x
                        + Math.cos(angle2)
                        * radius;

                double z2 =
                    smoothPosition.z
                        + Math.sin(angle2)
                        * radius;

                double y1 =
                    smoothPosition.y
                        + targetHeight * 0.5
                        + Math.sin(
                        angle1 * 1.5
                    ) * targetHeight * 0.35;

                double y2 =
                    smoothPosition.y
                        + targetHeight * 0.5
                        + Math.sin(
                        angle2 * 1.5
                    ) * targetHeight * 0.35;

                Color trailColor = createFadedColor(
                    mixColor(
                        primary,
                        secondary,
                        trail / (float) trails
                    ),
                    1.0f - (float) progress1
                );

                event.renderer.line(
                    x1,
                    y1,
                    z1,
                    x2,
                    y2,
                    z2,
                    trailColor
                );
            }
        }
    }

    private void renderThunderCelka(
        Render3DEvent event,
        Color primary,
        Color secondary
    ) {
        double scale = size.get();

        double progress =
            0.5
                + Math.sin(animationTime * 2.0)
                * 0.5;

        double y =
            smoothPosition.y
                + targetHeight * progress;

        double radius =
            Math.max(
                targetWidth * 0.9,
                0.45
            ) * scale;

        drawRing(
            event,
            smoothPosition.x,
            y,
            smoothPosition.z,
            radius,
            animationTime * 1.5,
            primary
        );

        drawRing(
            event,
            smoothPosition.x,
            y + 0.04,
            smoothPosition.z,
            radius * 0.88,
            -animationTime * 1.5,
            secondary
        );

        drawGradientRing(
            event,
            y,
            y - 0.22,
            radius,
            animationTime,
            primary,
            secondary
        );
    }

    private void renderWildFire(
        Render3DEvent event,
        Color primary,
        Color secondary
    ) {
        int trailLength = Math.max(
            12,
            segments.get() / 3
        );

        double radius =
            Math.max(
                targetWidth * 0.8,
                0.45
            ) * size.get();

        for (int flame = 0; flame < 3; flame++) {
            double flamePhase =
                flame
                    * Math.PI
                    * 2.0
                    / 3.0;

            for (int i = 0; i < trailLength; i++) {
                double progress1 =
                    i / (double) trailLength;

                double progress2 =
                    (i + 1.0)
                        / trailLength;

                double angle1 =
                    animationTime * 3.5
                        + flamePhase
                        - progress1 * 2.2;

                double angle2 =
                    animationTime * 3.5
                        + flamePhase
                        - progress2 * 2.2;

                double flameRadius1 =
                    radius
                        * (1.0 - progress1 * 0.55);

                double flameRadius2 =
                    radius
                        * (1.0 - progress2 * 0.55);

                double x1 =
                    smoothPosition.x
                        + Math.cos(angle1)
                        * flameRadius1;

                double z1 =
                    smoothPosition.z
                        + Math.sin(angle1)
                        * flameRadius1;

                double x2 =
                    smoothPosition.x
                        + Math.cos(angle2)
                        * flameRadius2;

                double z2 =
                    smoothPosition.z
                        + Math.sin(angle2)
