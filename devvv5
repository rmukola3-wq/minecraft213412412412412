    private void drawDiamond(
        Render3DEvent event,
        double x,
        double y,
        double z,
        double radius,
        double halfHeight,
        double phase,
        Color primary,
        Color secondary
    ) {
        double topY = y + halfHeight;
        double bottomY = y - halfHeight;

        double[] px = new double[4];
        double[] pz = new double[4];

        for (int i = 0; i < 4; i++) {
            double angle =
                phase
                    + i
                    * Math.PI
                    * 0.5;

            px[i] =
                x + Math.cos(angle) * radius;

            pz[i] =
                z + Math.sin(angle) * radius;
        }

        Color sidePrimary =
            createFadedColor(primary, 0.30f);

        Color sideSecondary =
            createFadedColor(secondary, 0.20f);

        for (int i = 0; i < 4; i++) {
            int next = (i + 1) % 4;

            event.renderer.line(
                px[i],
                y,
                pz[i],
                x,
                topY,
                z,
                primary
            );

            event.renderer.line(
                px[i],
                y,
                pz[i],
                x,
                bottomY,
                z,
                secondary
            );

            event.renderer.line(
                px[i],
                y,
                pz[i],
                px[next],
                y,
                pz[next],
                mixColor(
                    primary,
                    secondary,
                    i / 3.0f
                )
            );

            event.renderer.quad(
                px[i],
                y,
                pz[i],
                x,
                topY,
                z,
                px[next],
                y,
                pz[next],
                px[i],
                y,
                pz[i],
                sidePrimary
            );

            event.renderer.quad(
                px[i],
                y,
                pz[i],
                px[next],
                y,
                pz[next],
                x,
                bottomY,
                z,
                px[i],
                y,
                pz[i],
                sideSecondary
            );
        }
    }

    private void drawRing(
        Render3DEvent event,
        double x,
        double y,
        double z,
        double radius,
        double phase,
        Color color
    ) {
        int count = segments.get();

        for (int i = 0; i < count; i++) {
            double angle1 =
                phase
                    + i
                    * Math.PI
                    * 2.0
                    / count;

            double angle2 =
                phase
                    + (i + 1.0)
                    * Math.PI
                    * 2.0
                    / count;

            event.renderer.line(
                x + Math.cos(angle1) * radius,
                y,
                z + Math.sin(angle1) * radius,
                x + Math.cos(angle2) * radius,
                y,
                z + Math.sin(angle2) * radius,
                color
            );
        }
    }

    private void drawGradientRing(
        Render3DEvent event,
        double y1,
        double y2,
        double radius,
        double phase,
        Color solid,
        Color gradient
    ) {
        int count = segments.get();

        Color transparent =
            createFadedColor(
                gradient,
                0.02f
            );

        for (int i = 0; i < count; i++) {
            double angle1 =
                phase
                    + i
                    * Math.PI
                    * 2.0
                    / count;

            double angle2 =
                phase
                    + (i + 1.0)
                    * Math.PI
                    * 2.0
                    / count;

            double x1 =
                smoothPosition.x
                    + Math.cos(angle1)
                    * radius;

            double z1 =
                smoothPosition.z
                    + Math.sin(angle1)
                    * radius;

            double x2 =
                smoothPosition.x
                    + Math.cos(angle2)
                    * radius;

            double z2 =
                smoothPosition.z
                    + Math.sin(angle2)
                    * radius;

            event.renderer.quad(
                x1,
                y1,
                z1,
                x1,
                y2,
                z1,
                x2,
                y2,
                z2,
                x2,
                y1,
                z2,
                solid,
                transparent,
                transparent,
                solid
            );
        }
    }

    private Color createColor(
        SettingColor source,
        float alphaMultiplier,
        float hurt
    ) {
        int red = (int) MathHelper.lerp(
            hurt,
            source.r,
            255
        );

        int green = (int) MathHelper.lerp(
            hurt,
            source.g,
            50
        );

        int blue = (int) MathHelper.lerp(
            hurt,
            source.b,
            50
        );

        int colorAlpha = MathHelper.clamp(
            (int) (
                source.a
                    * alphaMultiplier
            ),
            0,
            255
        );

        return new Color(
            red,
            green,
            blue,
            colorAlpha
        );
    }

    private Color createFadedColor(
        Color color,
        float multiplier
    ) {
        return new Color(
            color.r,
            color.g,
            color.b,
            MathHelper.clamp(
                (int) (
                    color.a * multiplier
                ),
                0,
                255
            )
        );
    }

    private Color mixColor(
        Color first,
        Color second,
        float progress
    ) {
        progress = MathHelper.clamp(
            progress,
            0.0f,
            1.0f
        );

        return new Color(
            (int) MathHelper.lerp(
                progress,
                first.r,
                second.r
            ),
            (int) MathHelper.lerp(
                progress,
                first.g,
                second.g
            ),
            (int) MathHelper.lerp(
                progress,
                first.b,
                second.b
            ),
            (int) MathHelper.lerp(
                progress,
                first.a,
                second.a
            )
        );
    }

