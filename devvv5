public class TargetESP extends Module {
    private final SettingGroup sgGeneral = settings.getDefaultGroup();
    private final SettingGroup sgAnimation = settings.createGroup("Animation");
    private final SettingGroup sgRender = settings.createGroup("Render");

    private final Setting<TargetTexture> texture = sgGeneral.add(
        new EnumSetting.Builder<TargetTexture>()
            .name("texture")
            .description("Target ESP texture.")
            .defaultValue(TargetTexture.ThunderHack1)
            .build()
    );

    private final Setting<Animation> animation = sgGeneral.add(
        new EnumSetting.Builder<Animation>()
            .name("animation")
            .description("Texture movement style.")
            .defaultValue(Animation.Ghosts)
            .build()
    );

    private final Setting<SettingColor> color = sgGeneral.add(
        new ColorSetting.Builder()
            .name("color")
            .description("Texture color. White preserves original colors.")
            .defaultValue(new SettingColor(255, 255, 255, 255))
            .build()
    );

    private final Setting<Double> size = sgGeneral.add(
        new DoubleSetting.Builder()
            .name("size")
            .description("Texture size.")
            .defaultValue(0.38)
            .min(0.05)
            .sliderMax(2.0)
            .build()
    );

    private final Setting<Double> radius = sgAnimation.add(
        new DoubleSetting.Builder()
            .name("radius")
            .description("Orbit radius.")
            .defaultValue(0.72)
            .min(0)
            .sliderMax(3)
            .build()
    );

    private final Setting<Double> height = sgAnimation.add(
        new DoubleSetting.Builder()
            .name("height")
            .description("Vertical animation amplitude.")
            .defaultValue(0.45)
            .min(0)
            .sliderMax(2)
            .build()
    );

    private final Setting<Double> speed = sgAnimation.add(
        new DoubleSetting.Builder()
            .name("speed")
            .description("Animation speed.")
            .defaultValue(2.4)
            .min(-10)
            .sliderMin(-10)
            .sliderMax(10)
            .build()
    );

    private final Setting<Double> spinSpeed = sgAnimation.add(
        new DoubleSetting.Builder()
            .name("spin-speed")
            .description("Texture rotation speed.")
            .defaultValue(90)
            .min(-720)
            .sliderMin(-720)
            .sliderMax(720)
            .build()
    );

    private final Setting<Integer> count = sgAnimation.add(
        new IntSetting.Builder()
            .name("count")
            .description("Amount of particles.")
            .defaultValue(3)
            .min(1)
            .sliderMax(12)
            .build()
    );

    private final Setting<Integer> trails = sgAnimation.add(
        new IntSetting.Builder()
            .name("trails")
            .description("Ghost trail length.")
            .defaultValue(5)
            .min(1)
            .sliderMax(12)
            .visible(() -> animation.get() == Animation.Ghosts)
            .build()
    );

    private final Setting<Double> trailDistance = sgAnimation.add(
        new DoubleSetting.Builder()
            .name("trail-distance")
            .description("Distance between ghost copies.")
            .defaultValue(0.13)
            .min(0.01)
            .sliderMax(0.6)
            .visible(() -> animation.get() == Animation.Ghosts)
            .build()
