    private void addBillboard(
        double x,
        double y,
        double z,
        double spriteSize,
        double rotation,
        float alphaMultiplier
    ) {
        Color spriteColor = getColor(alphaMultiplier);
        if (spriteColor.a <= 0) return;

        float yaw = (float) Math.toRadians(
            mc.gameRenderer.getCamera().getYaw()
        );

        float pitch = (float) Math.toRadians(
            mc.gameRenderer.getCamera().getPitch()
        );

        double sinYaw = Math.sin(yaw);
        double cosYaw = Math.cos(yaw);
        double sinPitch = Math.sin(pitch);
        double cosPitch = Math.cos(pitch);

        Vec3d right = new Vec3d(
            cosYaw,
            0,
            sinYaw
        );

        Vec3d up = new Vec3d(
            -sinYaw * sinPitch,
            cosPitch,
            cosYaw * sinPitch
        );

        double radians = Math.toRadians(rotation);
        double cos = Math.cos(radians);
        double sin = Math.sin(radians);

        Vec3d rotatedRight = right
            .multiply(cos)
            .add(up.multiply(sin));

        Vec3d rotatedUp = up
            .multiply(cos)
            .subtract(right.multiply(sin));

        Vec3d horizontal =
            rotatedRight.multiply(spriteSize);

        Vec3d vertical =
            rotatedUp.multiply(spriteSize);

        Vec3d center = new Vec3d(x, y, z);

        Vec3d topLeft =
            center.subtract(horizontal).add(vertical);

        Vec3d bottomLeft =
            center.subtract(horizontal).subtract(vertical);

        Vec3d bottomRight =
            center.add(horizontal).subtract(vertical);

        Vec3d topRight =
            center.add(horizontal).add(vertical);

        addQuad(
            topLeft,
            bottomLeft,
            bottomRight,
            topRight,
            spriteColor
        );
    }

    private void addHorizontal(
        double x,
        double y,
        double z,
        double spriteSize,
        double rotation,
        float alphaMultiplier
    ) {
        Color spriteColor = getColor(alphaMultiplier);
        if (spriteColor.a <= 0) return;

        double radians = Math.toRadians(rotation);
        double cos = Math.cos(radians);
        double sin = Math.sin(radians);

        Vec3d local1 = rotateHorizontal(
            -spriteSize,
            -spriteSize,
            cos,
            sin
        );

        Vec3d local2 = rotateHorizontal(
            -spriteSize,
            spriteSize,
            cos,
            sin
        );

        Vec3d local3 = rotateHorizontal(
            spriteSize,
            spriteSize,
            cos,
            sin
        );

        Vec3d local4 = rotateHorizontal(
            spriteSize,
            -spriteSize,
            cos,
            sin
        );

        Vec3d center = new Vec3d(x, y, z);

        addQuad(
            center.add(local1),
            center.add(local2),
            center.add(local3),
            center.add(local4),
            spriteColor
        );
    }

    private Vec3d rotateHorizontal(
        double x,
        double z,
        double cos,
        double sin
    ) {
        return new Vec3d(
            x * cos - z * sin,
            0,
            x * sin + z * cos
        );
    }

    private Color getColor(float alphaMultiplier) {
        Color source = color.get();

        int finalAlpha = (int) (
            source.a
                * alpha
                * MathHelper.clamp(alphaMultiplier, 0, 1)
        );

        return new Color(
            source.r,
            source.g,
            source.b,
            MathHelper.clamp(finalAlpha, 0, 255)
        );
    }

    private void addQuad(
        Vec3d topLeft,
        Vec3d bottomLeft,
        Vec3d bottomRight,
        Vec3d topRight,
        Color color
    ) {
        int i1 = mesh
            .vec3(topLeft.x, topLeft.y, topLeft.z)
            .vec2(0, 0)
            .color(color)
            .next();

        int i2 = mesh
            .vec3(bottomLeft.x, bottomLeft.y, bottomLeft.z)
            .vec2(0, 1)
            .color(color)
            .next();

        int i3 = mesh
            .vec3(bottomRight.x, bottomRight.y, bottomRight.z)
            .vec2(1, 1)
            .color(color)
            .next();

        int i4 = mesh
            .vec3(topRight.x, topRight.y, topRight.z)
            .vec2(1, 0)
            .color(color)
            .next();

        mesh.quad(i1, i2, i3, i4);
    }

    private static class TexturedMesh extends ShaderMesh {
        private Identifier texture;
        private boolean additive;

        private TexturedMesh() {
            super(
                Shaders.POS_TEX_COLOR,
                DrawMode.Triangles,
                Mesh.Attrib.Vec3,
                Mesh.Attrib.Vec2,
                Mesh.Attrib.Color
            );
        }

        @Override
        protected void beforeRender() {
            super.beforeRender();

            GL.bindTexture(texture);

            if (additive) {
                GlStateManager._blendFunc(
                    GL_SRC_ALPHA,
                    GL_ONE
                );
            } else {
                GlStateManager._blendFunc(
                    GL_SRC_ALPHA,
                    GL_ONE_MINUS_SRC_ALPHA
                );
            }
        }
    }

