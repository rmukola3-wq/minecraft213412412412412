    @EventHandler
    private void onRender3D(Render3DEvent event) {
        if (mc.world == null || mc.player == null) return;

        if (mesh == null) {
            mesh = new TexturedMesh();
        }

        KillAura aura = Modules.get().get(KillAura.class);
        Entity target = aura != null && aura.isActive()
            ? aura.getTarget()
            : null;

        updateAlpha(target, event.frameTime);

        if (target != null) {
            lastTarget = target;
            renderPosition = getInterpolatedPosition(target, event.tickDelta);
        }

        if (lastTarget == null
            || renderPosition == null
            || alpha <= 0.005f) {
            return;
        }

        time += event.frameTime * speed.get();

        mesh.texture = texture.get().identifier;
        mesh.additive = additive.get();
        mesh.depthTest = !throughWalls.get();

        mesh.begin();

        Effect selectedEffect = effect.get() == Effect.Auto
            ? texture.get().recommendedEffect
            : effect.get();

        switch (selectedEffect) {
            case Auto -> {
            }

            case Ghosts -> renderGhosts(lastTarget);
            case Orbit -> renderOrbit(lastTarget, false);
            case DoubleOrbit -> renderOrbit(lastTarget, true);
            case Helix -> renderHelix(lastTarget);
            case Circle -> renderCircle(lastTarget);
            case DoubleCircle -> renderDoubleCircle(lastTarget);
            case Fire -> renderFire(lastTarget);
            case Fireflies -> renderFireflies(lastTarget);
            case AboveHead -> renderAboveHead(lastTarget);
            case BodyMarker -> renderBodyMarker(lastTarget);
            case Pulse -> renderPulse(lastTarget);
            case Crystal -> renderCrystal(lastTarget);
        }

        mesh.render(event.matrices);

        if (target == null && alpha <= 0.005f) {
            lastTarget = null;
            renderPosition = null;
        }
    }

    private Vec3d getInterpolatedPosition(Entity entity, float tickDelta) {
        return new Vec3d(
            MathHelper.lerp(
                tickDelta,
                entity.lastRenderX,
                entity.getX()
            ),
            MathHelper.lerp(
                tickDelta,
                entity.lastRenderY,
                entity.getY()
            ),
            MathHelper.lerp(
                tickDelta,
                entity.lastRenderZ,
                entity.getZ()
            )
        );
    }

    private void updateAlpha(Entity target, double frameTime) {
        float destination = target != null ? 1f : 0f;

        if (!fade.get()) {
            alpha = destination;
            return;
        }

        float factor = (float) Math.min(1, frameTime * 8);
        alpha = MathHelper.lerp(factor, alpha, destination);

        if (Math.abs(alpha - destination) < 0.005f) {
            alpha = destination;
        }
    }

    private void renderGhosts(Entity entity) {
        int particles = Math.max(1, count.get());
        int trailCount = Math.max(1, trails.get());

        for (int particle = 0; particle < particles; particle++) {
            double offset = Math.PI * 2 * particle / particles;

            for (int trail = trailCount - 1; trail >= 0; trail--) {
                double delayed = time - trail * trailDistance.get();
                double angle = delayed + offset;

                double x = renderPosition.x
                    + Math.cos(angle) * radius.get();

                double z = renderPosition.z
                    + Math.sin(angle) * radius.get();

                double y = renderPosition.y
                    + entity.getHeight() * 0.5
                    + Math.sin(delayed * 1.7 + offset) * height.get()
                    + yOffset.get();

                float trailAlpha =
                    1f - trail / (float) trailCount;

                trailAlpha *= trailAlpha;

                double trailSize = size.get()
                    * (0.55 + trailAlpha * 0.45);

                addBillboard(
                    x,
                    y,
                    z,
                    trailSize,
                    Math.toDegrees(-angle)
                        + time * spinSpeed.get(),
                    trailAlpha
                );
            }
        }
    }

    private void renderOrbit(Entity entity, boolean doubleOrbit) {
        int particles = Math.max(1, count.get());

        for (int i = 0; i < particles; i++) {
            double offset = Math.PI * 2 * i / particles;
            double angle = time + offset;

            addOrbitParticle(entity, angle, 1, i);

            if (doubleOrbit) {
                addOrbitParticle(entity, -angle, -1, i);
            }
        }
    }

    private void addOrbitParticle(
        Entity entity,
        double angle,
        int direction,
        int index
    ) {
        double x = renderPosition.x
            + Math.cos(angle) * radius.get();

        double z = renderPosition.z
            + Math.sin(angle) * radius.get();

        double y = renderPosition.y
            + entity.getHeight() * 0.5
            + Math.sin(angle * 2 + index) * height.get()
            + yOffset.get();

        addBillboard(
            x,
            y,
            z,
            size.get(),
            time * spinSpeed.get() * direction,
            1
        );
    }

    private void renderHelix(Entity entity) {
