package meteordevelopment.meteorclient.systems.modules.combat.aura;

import meteordevelopment.meteorclient.utils.player.ChatUtils;
import net.minecraft.client.network.ClientPlayerEntity;
import net.minecraft.entity.effect.StatusEffects;
import net.minecraft.network.packet.c2s.play.ClientCommandC2SPacket;

public final class AuraCriticalController {
    private static final int SPRINT_RESTORE_TICKS = 2;

    private State state = State.Ground;
    private State lastReportedState;

    private boolean jumpIssued;
    private boolean sprintSuppressed;
    private boolean restoreSprint;

    private int missedCycles;
    private int sprintRestoreTicks;

    public void tick(ClientPlayerEntity player) {
        if (player == null) {
            clearState();
            return;
        }

        if (sprintRestoreTicks > 0) {
            sprintRestoreTicks--;

            if (sprintRestoreTicks == 0) {
                restoreSprint(player);
            }
        }
    }

    public Decision update(
        ClientPlayerEntity player,
        Mode mode,
        boolean cooldownReady,
        float cooldownProgress,
        boolean autoJump,
        double jumpAtProgress,
        double minimumFallDistance
    ) {
        if (player == null) {
            clearState();
            return Decision.Wait;
        }

        if (mode == Mode.Off) {
            restoreSprint(player);
            jumpIssued = false;

            setState(
                State.Ground,
                player,
                cooldownReady,
                cooldownProgress
            );

            return cooldownReady
                ? Decision.NormalAttack
                : Decision.Wait;
        }

        String blockedReason = getBlockedReason(player);

        if (blockedReason != null) {
            restoreSprint(player);
            jumpIssued = false;

            setState(
                State.Blocked,
                player,
                cooldownReady,
                cooldownProgress
            );

            reportBlockedReason(blockedReason);

            return mode == Mode.Smart && cooldownReady
                ? Decision.NormalAttack
                : Decision.Wait;
        }

        if (!player.isOnGround()) {
            if (jumpIssued || mode == Mode.OnlyCriticals) {
                suppressSprint(player);
            }

            if (
                player.fallDistance > minimumFallDistance
                    && cooldownReady
            ) {
                setState(
                    State.CriticalWindow,
                    player,
                    true,
                    cooldownProgress
                );

                return Decision.CriticalAttack;
            }

            setState(
                State.WaitingFall,
                player,
                cooldownReady,
                cooldownProgress
            );

            return Decision.Wait;
        }

        if (jumpIssued) {
            jumpIssued = false;
            missedCycles++;

            restoreSprint(player);

            setState(
                State.MissedWindow,
                player,
                cooldownReady,
                cooldownProgress
            );

            if (
                mode == Mode.Smart
                    && cooldownReady
            ) {
                return Decision.NormalAttack;
            }
        }

        setState(
            State.Ground,
            player,
            cooldownReady,
            cooldownProgress
        );

        if (!autoJump) {
            return mode == Mode.Smart && cooldownReady
                ? Decision.NormalAttack
                : Decision.Wait;
        }

        if (
            cooldownReady
                || cooldownProgress >= jumpAtProgress
        ) {
            startJump(
                player,
                cooldownReady,
                cooldownProgress
            );
        }

        return Decision.Wait;
    }

    public void beforeAttack(
        ClientPlayerEntity player,
        Decision decision
    ) {
        if (player == null) return;

        if (decision == Decision.CriticalAttack) {
            suppressSprint(player);

            ChatUtils.infoPrefix(
                "Aura Debug",
                "ATTACK: critical, fall=%.4f, ground=%s, velocityY=%.4f",
                player.fallDistance,
                player.isOnGround(),
                player.getVelocity().y
            );
        } else {
            ChatUtils.infoPrefix(
                "Aura Debug",
                "ATTACK: normal fallback"
            );
        }
    }

    public void afterAttack(ClientPlayerEntity player) {
        setState(
            State.Recovery,
            player,
            true,
            player == null
                ? 0.0f
                : player.getAttackCooldownProgress(0.5f)
        );

        jumpIssued = false;
        missedCycles = 0;

        if (sprintSuppressed) {
            sprintRestoreTicks = SPRINT_RESTORE_TICKS;
        } else {
            restoreSprint = false;
        }
    }

    public void reset(ClientPlayerEntity player) {
        if (player != null) {
            restoreSprint(player);
        }

