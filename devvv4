    @EventHandler(priority = EventPriority.HIGH)
    private void onTickPre(TickEvent.Pre event) {
        processShieldReturn();

        if (applyWorkingPreset.get()) {
            applyWorkingPreset.set(false);
            applyWorkingPreset();
        }

        criticalController.tick(mc.player);

        combatPrepared = false;
        preparedTarget = null;
        attacking = false;

        if (switchTimer > 0) switchTimer--;
        if (shieldBreakCooldown > 0) shieldBreakCooldown--;
        if (hitTimer < Integer.MAX_VALUE) hitTimer++;

        if (!basicCheck()) {
            clearCombat();
            return;
        }

        updateTargets();

        if (targets.isEmpty()) {
            clearCombat();
            return;
        }

        Entity primary = targets.getFirst();

        currentAimPoint = aimPointResolver.resolve(
            mc,
            primary,
            getEffectiveRange(),
            getEffectiveWallsRange()
        );

        if (currentAimPoint == null) {
            invalidateTarget(primary);
            return;
        }

        if (
            requiresVisiblePoint()
                && !aimPointResolver.isVisible(
                    mc,
                    mc.player.getEyePos(),
                    currentAimPoint
                )
        ) {
            invalidateTarget(primary);
            return;
        }

        if (!prepareWeapon() || !itemInHand()) {
            stopAttacking();
            return;
        }

        pausePathing();

        if (
            bypassMode.get() == BypassMode.Grim2
                && isServerLookingAt(
                    primary,
                    getEffectiveRange() + 0.05
                )
        ) {
            grimRotationTicks++;
        } else if (bypassMode.get() == BypassMode.Grim2) {
            grimRotationTicks = 0;
        } else {
            grimRotationTicks = 0;
        }

        boolean cooldownReady =
            isCooldownReady(getCooldownProgress());

        if (
            shouldRotateAlways()
                || (
                    rotation.get() == RotationMode.OnHit
                        && cooldownReady
                )
        ) {
            rotate(currentAimPoint);
        }

        preparedTarget = primary;
        combatPrepared = true;
        attacking = true;
    }

    @EventHandler(priority = EventPriority.HIGH)
    private void onTickPost(TickEvent.Post event) {
        if (
            !combatPrepared
                || preparedTarget == null
                || currentAimPoint == null
                || !basicCheck()
        ) {
            return;
        }

        Entity target = preparedTarget;

        if (
            !target.isAlive()
                || !entityCheck(target)
                || !itemInHand()
        ) {
            return;
        }

        Vec3d confirmedPoint = aimPointResolver.resolve(
            mc,
            target,
            getEffectiveRange(),
            getEffectiveWallsRange()
        );

        if (confirmedPoint == null) return;

        if (
            requiresVisiblePoint()
                && !aimPointResolver.isVisible(
                    mc,
                    mc.player.getEyePos(),
                    confirmedPoint
                )
        ) {
            return;
        }

        currentAimPoint = confirmedPoint;

        float cooldownProgress = getCooldownProgress();
        boolean cooldownReady =
            isCooldownReady(cooldownProgress);

        AuraCriticalController.Decision decision =
            criticalController.update(
                mc.player,
                getEffectiveCriticalMode(),
                cooldownReady,
                cooldownProgress,
                autoCriticalJump.get(),
                jumpAtProgress.get(),
                minimumFallDistance.get()
            );

        boolean breakingShield = shouldShieldBreak();

        if (breakingShield && cooldownReady) {
            decision = AuraCriticalController.Decision.NormalAttack;
        }

        if (decision == AuraCriticalController.Decision.Wait) {
            return;
        }

        if (!profileAllowsAttack(target)) {
            return;
        }

        criticalController.beforeAttack(mc.player, decision);
        attackTarget(target, breakingShield);
    }

    @EventHandler
