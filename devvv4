    private boolean hasJumpSpace() {
        if (
            mc.player == null
                || mc.world == null
        ) {
            return false;
        }

        BlockPos basePosition =
            mc.player.getBlockPos();

        for (int offset = 2; offset <= 3; offset++) {
            BlockPos position =
                basePosition.up(offset);

            BlockState state =
                mc.world.getBlockState(position);

            if (
                !state.isAir()
                    && !state.getCollisionShape(
                        mc.world,
                        position
                    ).isEmpty()
            ) {
                return false;
            }
        }

        return true;
    }

    private boolean entityCheck(Entity entity) {
        if (
            entity == null
                || entity == mc.player
                || entity == mc.cameraEntity
                || !entity.isAlive()
        ) {
            return false;
        }

        if (
            entity instanceof LivingEntity living
                && living.isDead()
        ) {
            return false;
        }

        Box hitbox = entity.getBoundingBox();

        double closestX = MathHelper.clamp(
            mc.player.getX(),
            hitbox.minX,
            hitbox.maxX
        );

        double closestY = MathHelper.clamp(
            mc.player.getEyeY(),
            hitbox.minY,
            hitbox.maxY
        );

        double closestZ = MathHelper.clamp(
            mc.player.getZ(),
            hitbox.minZ,
            hitbox.maxZ
        );

        if (
            !PlayerUtils.isWithin(
                closestX,
                closestY,
                closestZ,
                getEffectiveRange()
            )
        ) {
            return false;
        }

        if (!entities.get().contains(entity.getType())) {
            return false;
        }

        if (ignoreNamed.get() && entity.hasCustomName()) {
            return false;
        }

        if (
            !PlayerUtils.canSeeEntity(entity)
                && !PlayerUtils.isWithin(
                    entity,
                    getEffectiveWallsRange()
                )
        ) {
            return false;
        }

        if (
            ignoreTamed.get()
                && entity instanceof Tameable tameable
                && tameable.getOwnerUuid() != null
                && tameable.getOwnerUuid().equals(
                    mc.player.getUuid()
                )
        ) {
            return false;
        }

        if (ignorePassive.get()) {
            if (
                entity instanceof EndermanEntity enderman
                    && !enderman.isAngry()
            ) {
                return false;
            }

            if (
                entity instanceof ZombifiedPiglinEntity piglin
                    && !piglin.isAttacking()
            ) {
                return false;
            }

            if (
                entity instanceof WolfEntity wolf
                    && !wolf.isAttacking()
            ) {
                return false;
            }
        }

        if (entity instanceof PlayerEntity player) {
            if (player.isCreative()) {
                return false;
            }

            if (!Friends.get().shouldAttack(player)) {
                return false;
            }

            if (
                shieldMode.get() == ShieldMode.Ignore
                    && isTargetBlockingShield(player)
            ) {
                return false;
            }
        }

        return true;
    }

