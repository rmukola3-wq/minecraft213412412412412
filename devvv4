    private void performInstantShieldBreak(Entity target) {
        if (
            target == null
                || !target.isAlive()
                || mc.player == null
                || mc.interactionManager == null
        ) {
            return;
        }

        FindItemResult axe = InvUtils.findInHotbar(
            stack -> stack.getItem() instanceof AxeItem
        );

        if (!axe.found() || axe.slot() < 0) {
            return;
        }

        int previousSelectedSlot =
            mc.player.getInventory().selectedSlot;

        boolean mustSwitch =
            previousSelectedSlot != axe.slot();

        /*
         * ThunderHack/Rasty packet sequence:
         * axe slot -> attack -> swing -> previous slot.
         * No cooldown is spent holding the axe.
         */
        if (mustSwitch) {
            InvUtils.swap(axe.slot(), false);
        }

        mc.interactionManager.attackEntity(
            mc.player,
            target
        );

        mc.player.swingHand(Hand.MAIN_HAND);

        if (mustSwitch) {
            InvUtils.swap(
                previousSelectedSlot,
                false
            );
        }

        hitTimer = 0;
        shieldBreakCooldown = shieldBreakDelay.get();

        criticalController.afterAttack(mc.player);
    }

