    private boolean isServerLookingAt(
        Entity target,
        double rayLength
    ) {
        if (
            target == null
                || mc.player == null
                || rayLength <= 0
        ) {
            return false;
        }

        Vec3d eyes = mc.player.getEyePos();

        Vec3d direction = rotationVector(
            Rotations.serverYaw,
            Rotations.serverPitch
        );

        Vec3d end = eyes.add(
            direction.multiply(rayLength)
        );

        Box box = target.getBoundingBox();

        return box.contains(eyes)
            || box.raycast(eyes, end).isPresent();
    }

    private Vec3d rotationVector(
        float yaw,
        float pitch
    ) {
        float yawRadians =
            -yaw * 0.017453292F;

        float pitchRadians =
            pitch * 0.017453292F;

        float yawCos =
            MathHelper.cos(yawRadians);

        float yawSin =
            MathHelper.sin(yawRadians);

        float pitchCos =
            MathHelper.cos(pitchRadians);

        float pitchSin =
            MathHelper.sin(pitchRadians);

        return new Vec3d(
            yawSin * pitchCos,
            -pitchSin,
            yawCos * pitchCos
        );
    }

    private boolean shouldRotateAlways() {
        return bypassMode.get() != BypassMode.Standard
            || rotation.get() == RotationMode.Always;
    }

    private void rotate(Vec3d point) {
        if (
            point == null
                || mc.player == null
                || (
                    bypassMode.get() == BypassMode.Standard
                        && rotation.get() == RotationMode.None
                )
        ) {
            return;
        }

        Vec3d eyes = mc.player.getEyePos();

        double differenceX = point.x - eyes.x;
        double differenceY = point.y - eyes.y;
        double differenceZ = point.z - eyes.z;

        double horizontalDistance = Math.sqrt(
            differenceX * differenceX
                + differenceZ * differenceZ
        );

        float targetYaw = (float) (
            Math.toDegrees(
                Math.atan2(
                    differenceZ,
                    differenceX
                )
            ) - 90.0
        );

        float targetPitch = MathHelper.clamp(
            (float) -Math.toDegrees(
                Math.atan2(
                    differenceY,
                    horizontalDistance
                )
            ),
            -90.0f,
            90.0f
        );

        float yaw = applyYawProfile(targetYaw);
        float pitch = applyPitchProfile(targetPitch);

        float yawDifference = Math.abs(
            MathHelper.wrapDegrees(
                yaw - Rotations.serverYaw
            )
        );

        float pitchDifference = Math.abs(
            pitch - Rotations.serverPitch
        );

        if (
            yawDifference < 0.001f
                && pitchDifference < 0.001f
        ) {
            return;
        }

        Rotations.rotate(
            yaw,
            pitch,
            ROTATION_PRIORITY
        );
    }

    private float applyYawProfile(float targetYaw) {
        float currentYaw = Rotations.serverYaw;

        float difference = MathHelper.wrapDegrees(
            targetYaw - currentYaw
        );

        float maximumStep = switch (bypassMode.get()) {
            case Grim2 -> 70.0f;
            case Matrix -> 45.0f;
            default -> 180.0f;
        };

        difference = MathHelper.clamp(
            difference,
            -maximumStep,
            maximumStep
        );

        return currentYaw + difference;
    }

    private float applyPitchProfile(float targetPitch) {
        float currentPitch = Rotations.serverPitch;

        float difference =
            targetPitch - currentPitch;

        float maximumStep = switch (bypassMode.get()) {
            case Grim2 -> 35.0f;
            case Matrix -> 25.0f;
            default -> 180.0f;
        };

        difference = MathHelper.clamp(
            difference,
            -maximumStep,
            maximumStep
        );

        return MathHelper.clamp(
            currentPitch + difference,
            -90.0f,
            90.0f
        );
    }

