package meteordevelopment.meteorclient.systems.modules.combat.aura;

import net.minecraft.client.network.ClientPlayerEntity;
import net.minecraft.entity.attribute.EntityAttributes;
import net.minecraft.entity.effect.StatusEffects;
import net.minecraft.network.packet.c2s.play.ClientCommandC2SPacket;

public final class AuraCriticalController {
    private static final double READY_PROGRESS = 0.90;
    private static final int CRITICAL_WINDOW_TICKS = 7;
    private static final int FAILED_JUMP_GROUND_TICKS = 2;
    private static final int MAX_CYCLE_TICKS = 20;
    private static final int SPRINT_RESTORE_TICKS = 2;

    private State state = State.Ground;

    private boolean jumpIssued;
    private boolean sprintSuppressed;
    private boolean restoreSprint;

    private int groundedAfterJumpTicks;
    private int cycleTicks;
    private int missedCycles;
    private int sprintRestoreTicks;

    public void tick(ClientPlayerEntity player) {
        if (player == null) {
            clearState();
            return;
        }

        if (sprintRestoreTicks > 0) {
            sprintRestoreTicks--;

            if (sprintRestoreTicks == 0) {
                restoreSprint(player);
            }
        }

        if (jumpIssued) {
            cycleTicks++;

            if (cycleTicks > MAX_CYCLE_TICKS) {
                markMissed(player);
            }
        }
    }

    public Decision update(
        ClientPlayerEntity player,
        Mode mode,
        boolean cooldownReady,
        float cooldownProgress,
        boolean autoJump,
        double jumpAtProgress,
        double minimumFallDistance
    ) {
        if (player == null) {
            clearState();
            return Decision.Wait;
        }

        if (mode == Mode.Off) {
            reset(player);

            return cooldownReady
                ? Decision.NormalAttack
                : Decision.Wait;
        }

        if (!canCritical(player)) {
            reset(player);

            return mode == Mode.Smart && cooldownReady
                ? Decision.NormalAttack
                : Decision.Wait;
        }

        if (!player.isOnGround()) {
            groundedAfterJumpTicks = 0;

            if (jumpIssued || mode == Mode.OnlyCriticals) {
                suppressSprint(player);
            }

            if (isCriticalWindow(player, minimumFallDistance)) {
                state = State.CriticalWindow;

                return cooldownReady
                    ? Decision.CriticalAttack
                    : Decision.Wait;
            }

            state = State.WaitingFall;
            return Decision.Wait;
        }

        if (jumpIssued) {
            groundedAfterJumpTicks++;

            if (groundedAfterJumpTicks <= FAILED_JUMP_GROUND_TICKS) {
                state = State.WaitingFall;
                return Decision.Wait;
            }

            markMissed(player);
        }

        if (state == State.MissedWindow) {
            if (mode == Mode.Smart && cooldownReady) {
                return Decision.NormalAttack;
            }

            if (mode == Mode.OnlyCriticals) {
                resetCycle(player);
            } else {
                return Decision.Wait;
            }
        }

        state = State.Ground;

        if (!autoJump) {
            return mode == Mode.Smart && cooldownReady
                ? Decision.NormalAttack
                : Decision.Wait;
        }

        if (shouldStartJump(
            player,
            cooldownReady,
            cooldownProgress,
            jumpAtProgress
        )) {
            startJump(player);
        }

        return Decision.Wait;
    }

    public void beforeAttack(
        ClientPlayerEntity player,
        Decision decision
    ) {
        if (player == null) return;

        if (decision == Decision.CriticalAttack) {
            suppressSprint(player);
        }
    }

    public void afterAttack(ClientPlayerEntity player) {
        state = State.Recovery;

        jumpIssued = false;
        groundedAfterJumpTicks = 0;
        cycleTicks = 0;
        missedCycles = 0;

        if (sprintSuppressed) {
            sprintRestoreTicks = SPRINT_RESTORE_TICKS;
        } else {
            restoreSprint = false;
        }
    }

    public void reset(ClientPlayerEntity player) {
        if (player != null) {
            restoreSprint(player);
        }

        clearState();
    }

    public boolean shouldSuppressSprint(Mode mode) {
        return mode != Mode.Off
            && (
                sprintSuppressed
                    || state == State.WaitingFall
                    || state == State.CriticalWindow
            );
    }

    public boolean isWaitingForCritical() {
        return state == State.WaitingFall
            || state == State.CriticalWindow
            || state == State.MissedWindow;
    }

    public State getState() {
        return state;
    }

    public int getMissedCycles() {
        return missedCycles;
    }

    private void startJump(ClientPlayerEntity player) {
        suppressSprint(player);

        player.jump();

        jumpIssued = true;
        groundedAfterJumpTicks = 0;
        cycleTicks = 0;
        state = State.WaitingFall;
    }

    private void markMissed(ClientPlayerEntity player) {
        missedCycles++;

        jumpIssued = false;
        groundedAfterJumpTicks = 0;
        cycleTicks = 0;
        state = State.MissedWindow;

        restoreSprint(player);
    }

    private void resetCycle(ClientPlayerEntity player) {
        restoreSprint(player);

        jumpIssued = false;
        groundedAfterJumpTicks = 0;
        cycleTicks = 0;
        state = State.Ground;
    }

    private boolean shouldStartJump(
        ClientPlayerEntity player,
        boolean cooldownReady,
        float cooldownProgress,
        double jumpAtProgress
    ) {
        if (!player.isOnGround()) return false;

        if (cooldownReady) {
            return true;
        }

        if (cooldownProgress < jumpAtProgress) {
            return false;
        }

        double attackSpeed = player.getAttributeValue(
            EntityAttributes.ATTACK_SPEED
        );

        if (attackSpeed <= 0.0) {
            return false;
        }

        double cooldownTicks = 20.0 / attackSpeed;

        double remainingProgress = Math.max(
            0.0,
            READY_PROGRESS - cooldownProgress
        );

        int ticksUntilReady = (int) Math.ceil(
            remainingProgress * cooldownTicks
        );

        return ticksUntilReady <= CRITICAL_WINDOW_TICKS;
    }

    private boolean isCriticalWindow(
        ClientPlayerEntity player,
        double minimumFallDistance
    ) {
        return canCritical(player)
            && !player.isOnGround()
            && player.getVelocity().y <= 0.0
            && player.fallDistance > minimumFallDistance;
    }

    private boolean canCritical(ClientPlayerEntity player) {
        return !player.isClimbing()
            && !player.isTouchingWater()
            && !player.isSubmergedInWater()
            && !player.isInLava()
            && !player.hasVehicle()
            && !player.getAbilities().flying
            && !player.isGliding()
            && !player.hasStatusEffect(StatusEffects.BLINDNESS)
            && !player.hasStatusEffect(StatusEffects.LEVITATION)
            && !player.hasStatusEffect(StatusEffects.SLOW_FALLING);
    }

    private void suppressSprint(ClientPlayerEntity player) {
        if (!sprintSuppressed) {
            restoreSprint = player.isSprinting();

            player.setSprinting(false);

            if (player.networkHandler != null) {
                player.networkHandler.sendPacket(
                    new ClientCommandC2SPacket(
                        player,
                        ClientCommandC2SPacket.Mode.STOP_SPRINTING
                    )
                );
            }

            sprintSuppressed = true;
        } else {
            player.setSprinting(false);
        }
    }

    private void restoreSprint(ClientPlayerEntity player) {
        if (!sprintSuppressed) return;

        if (
            restoreSprint
                && player.networkHandler != null
                && !player.isSprinting()
        ) {
            player.setSprinting(true);

            player.networkHandler.sendPacket(
                new ClientCommandC2SPacket(
                    player,
                    ClientCommandC2SPacket.Mode.START_SPRINTING
                )
            );
        }

        sprintSuppressed = false;
        restoreSprint = false;
        sprintRestoreTicks = 0;
    }

    private void clearState() {
        state = State.Ground;

        jumpIssued = false;
        sprintSuppressed = false;
        restoreSprint = false;

        groundedAfterJumpTicks = 0;
        cycleTicks = 0;
        missedCycles = 0;
        sprintRestoreTicks = 0;
    }

    public enum Mode {
        Off,
        Smart,
        OnlyCriticals
    }

    public enum Decision {
        Wait,
        NormalAttack,
        CriticalAttack
    }

    public enum State {
        Ground,
        WaitingFall,
        CriticalWindow,
        MissedWindow,
        Recovery
    }
}


