        restoreSprint = player.isSprinting();
        player.setSprinting(false);

        if (
            restoreSprint
                && player.networkHandler != null
        ) {
            player.networkHandler.sendPacket(
                new ClientCommandC2SPacket(
                    player,
                    ClientCommandC2SPacket.Mode.STOP_SPRINTING
                )
            );
        }

        sprintSuppressed = true;
    }

    private void restoreSprint(
        ClientPlayerEntity player
    ) {
        if (!sprintSuppressed) return;

        if (
            restoreSprint
                && player.networkHandler != null
        ) {
            player.setSprinting(true);

            player.networkHandler.sendPacket(
                new ClientCommandC2SPacket(
                    player,
                    ClientCommandC2SPacket.Mode.START_SPRINTING
                )
            );
        }

        sprintSuppressed = false;
        restoreSprint = false;
        sprintRestoreTicks = 0;
    }

    private void setState(
        State newState,
        ClientPlayerEntity player,
        boolean cooldownReady,
        float cooldownProgress
    ) {
        state = newState;

        if (
            player == null
                || lastReportedState == newState
        ) {
            return;
        }

        lastReportedState = newState;

        ChatUtils.infoPrefix(
            "Aura Debug",
            "state=%s, ground=%s, vanillaFall=%.4f, trackedFall=%.4f, velocityY=%.4f, cooldown=%.3f, ready=%s",
            newState.name(),
            player.isOnGround(),
            player.fallDistance,
            trackedFallDistance,
            player.getVelocity().y,
            cooldownProgress,
            cooldownReady
        );
    }

    private void clearState() {
        state = State.Ground;
        lastReportedState = null;

        jumpIssued = false;
        sprintSuppressed = false;
        restoreSprint = false;
        positionInitialized = false;

        missedCycles = 0;
        sprintRestoreTicks = 0;

        lastY = 0.0;
        trackedFallDistance = 0.0;
    }

    public enum Mode {
        Off,
        Smart,
        OnlyCriticals
    }

    public enum Decision {
        Wait,
        NormalAttack,
        CriticalAttack
    }

    public enum State {
        Ground,
        WaitingFall,
        CriticalWindow,
        MissedWindow,
        Recovery,
        Blocked
    }
}


