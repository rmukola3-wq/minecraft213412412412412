        int sA = start >>> 24 & 255, sR = start >> 16 & 255, sG = start >> 8 & 255, sB = start & 255;
        int eA = end >>> 24 & 255, eR = end >> 16 & 255, eG = end >> 8 & 255, eB = end & 255;

        int a = (int) (eA + (sA - eA) * t);
        int r = (int) (eR + (sR - eR) * t);
        int g = (int) (eG + (sG - eG) * t);
        int b = (int) (eB + (sB - eB) * t);

        return rgba(r, g, b, a);
    }

    public static Color color(int packed) {
        return new Color(packed);
    }
}


