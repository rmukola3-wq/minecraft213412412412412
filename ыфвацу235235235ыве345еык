                                float radius, int fill, int outlineTop, int outlineBottom) {
        roundedVertical(context, x, y, w, h, radius, radius, radius, radius, outlineTop, outlineBottom);
        rounded(context, x + 0.75f, y + 0.75f, Math.max(0, w - 1.5f), Math.max(0, h - 1.5f),
            Math.max(0, radius - 0.75f), fill);
