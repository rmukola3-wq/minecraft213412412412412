                || vanillaTarget instanceof MorzhSingleplayerScreen
                || mc.currentScreen instanceof SelectWorldScreen
                || mc.currentScreen instanceof MorzhSingleplayerScreen) {
                mc.setScreen(new MorzhSingleplayerScreen(menu));
            } else {
                mc.setScreen(menu);
            }
        });
    }
