    public static void text(DrawContext context, String text, float x, float y, int packed, float size, boolean shadow) {
        if (text == null || text.isEmpty() || Fonts.RENDERER == null) return;

        TextRenderer renderer = Fonts.RENDERER;
        renderer.begin(size / FONT_PX);
