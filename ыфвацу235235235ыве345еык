    public static void chevron(DrawContext context, float cx, float cy, float size, boolean up, int packed) {
        Renderer2D r = Renderer2D.COLOR;
        r.begin();
        Color color = unpack(packed);
        float half = size / 2f;
        if (up) {
            r.triangle(cx, cy - half * 0.55f, cx - half, cy + half * 0.35f, cx + half, cy + half * 0.35f, color);
        } else {
            r.triangle(cx, cy + half * 0.55f, cx - half, cy - half * 0.35f, cx + half, cy - half * 0.35f, color);
        }
        r.render(context.getMatrices());
        MorzhScissor.reapply();
    }

    // ---- Fonts: Expensive montserrat sizes mapped through Meteor's 18px scale ----

    public static void text(DrawContext context, String text, float x, float y, int packed, float size) {
