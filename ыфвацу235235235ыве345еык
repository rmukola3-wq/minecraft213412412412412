public final class MorzhMenus {
    private MorzhMenus() {}

    public static boolean skipMultiplayerRedirect;
    public static boolean skipSingleplayerRedirect;

    /** After leaving a world, ignore vanilla MP/title for this tick and open a fresh menu. */
    public static boolean pendingLeaveReset;

    public static boolean custom() {
        Config config = Config.get();
        return config != null && config.customMainMenu.get();
    }

    public static boolean inWorld() {
        MinecraftClient mc = MinecraftClient.getInstance();
        return mc != null && (mc.world != null || mc.player != null);
