package meteordevelopment.meteorclient.utils.sound;

import net.minecraft.client.MinecraftClient;
import net.minecraft.client.sound.PositionedSoundInstance;
import net.minecraft.client.sound.SoundInstance;
import net.minecraft.sound.SoundCategory;
import net.minecraft.util.Identifier;

/** GUI / module sounds. Files live in assets/meteor-client/sounds. */
public final class MorzhSoundManager {
    private static final String NAMESPACE = "meteor-client";

    private static long lastScrollSoundNanos;
    private static long lastClickSoundNanos;

    private MorzhSoundManager() {}

    public static void init() {}

    private static void play(String path, float pitch, float volume) {
        MinecraftClient client = MinecraftClient.getInstance();
        if (client == null || client.getSoundManager() == null) return;
        client.getSoundManager().play(new PositionedSoundInstance(
            Identifier.of(NAMESPACE, path),
            SoundCategory.MASTER,
            volume,
            pitch,
            SoundInstance.createRandom(),
            false,
            0,
            SoundInstance.AttenuationType.NONE,
            0.0,
            0.0,
            0.0,
            true
        ));
    }

    private static void click(String path) {
        long now = System.nanoTime();
        if (now - lastClickSoundNanos < 25_000_000L) return;
        lastClickSoundNanos = now;
        play(path, 1.0f, 1.0f);
    }

    public static void playOpen() { play("gui.open", 1.0f, 1.0f); }
    public static void playClose() { play("gui.close", 1.0f, 1.0f); }
    public static void playBoolean() { click("gui.boolean"); }

    public static void playScroll() {
        long now = System.nanoTime();
        if (now - lastScrollSoundNanos < 40_000_000L) return;
        lastScrollSoundNanos = now;
        play("gui.scroll", 1.0f, 0.9f);
    }

    public static void playKeyPress() { play("gui.keypress", 1.0f, 0.95f); }
    public static void playKeyRelease() { play("gui.keyrelease", 1.0f, 0.75f); }

    public static void playModuleEnable() { play("module.enable", 1.0f, 1.0f); }
    public static void playModuleDisable() { play("module.disable", 1.0f, 1.0f); }

    public static void playModuleState(boolean enabled) {
        if (enabled) playModuleEnable();
        else playModuleDisable();
    }

    public static void playMetallic() { play("combat.metallic", 1.0f, 1.0f); }
    public static void playSkeet() { play("combat.skeet", 1.0f, 1.0f); }
    public static void playCrit() { play("combat.crit", 1.0f, 1.0f); }
    public static void playBonk() { play("combat.bonk", 1.0f, 1.0f); }
}


