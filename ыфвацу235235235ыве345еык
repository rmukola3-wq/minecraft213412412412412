    }

    public static Screen freshMenu() {
        return new MorzhMainMenuScreen();
    }

    /**
     * Called after {@code MinecraftClient.disconnect} finishes.
     * Vanilla leaves MultiplayerScreen(TitleScreen) or TitleScreen, often while HUD/world
     * leftovers are still on the framebuffer. Other clients always construct a new main menu.
     */
    public static void afterDisconnect(MinecraftClient mc, Screen vanillaTarget) {
        if (!custom() || mc == null || vanillaTarget instanceof net.minecraft.client.gui.screen.DisconnectedScreen) return;
        mc.execute(() -> {
            pendingLeaveReset = false;
            skipMultiplayerRedirect = false;
            skipSingleplayerRedirect = false;
