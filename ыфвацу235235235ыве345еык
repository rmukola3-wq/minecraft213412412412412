    public static void textCentered(DrawContext context, String text, float cx, float y, int packed, float size) {
        float w = textWidth(text, size);
        text(context, text, cx - w / 2f, y, packed, size);
    }

    public static float textWidth(String text, float size) {
        if (text == null || text.isEmpty() || Fonts.RENDERER == null) return 0;

        TextRenderer renderer = Fonts.RENDERER;
        renderer.begin(size / FONT_PX, true, false);
        double width = renderer.getWidth(text);
        renderer.end();
        return (float) width;
    }

    public static float textHeight(float size) {
        if (Fonts.RENDERER == null) return size;

        TextRenderer renderer = Fonts.RENDERER;
        renderer.begin(size / FONT_PX, true, false);
        double height = renderer.getHeight();
        renderer.end();
        return (float) height;
    }

    // ---- Scissor in scaled GUI space ----

    public static void pushScissor(float x, float y, float w, float h) {
        MorzhScissor.push(x, y, w, h);
    }

    public static void popScissor() {
        MorzhScissor.pop();
    }

    public static void resetScissor() {
        MorzhScissor.reset();
    }

    public static boolean scissorContains(float x, float y) {
        return MorzhScissor.contains(x, y);
    }

    // ---- Cursors ----

    public static void resetCursor() {
        desiredCursor = GLFW.GLFW_ARROW_CURSOR;
    }

    public static void cursorHand() {
        desiredCursor = GLFW.GLFW_HAND_CURSOR;
    }

    public static void cursorIbeam() {
        desiredCursor = GLFW.GLFW_IBEAM_CURSOR;
    }

    public static void cursorResize() {
        desiredCursor = GLFW.GLFW_RESIZE_EW_CURSOR;
    }

    public static void applyCursor() {
        MinecraftClient client = MinecraftClient.getInstance();
        if (client == null || client.getWindow() == null) return;

        ensureCursors();
        long handle = switch (desiredCursor) {
            case GLFW.GLFW_HAND_CURSOR -> handCursor;
            case GLFW.GLFW_IBEAM_CURSOR -> ibeamCursor;
            case GLFW.GLFW_RESIZE_EW_CURSOR -> resizeCursor;
            default -> arrowCursor;
        };
        GLFW.glfwSetCursor(client.getWindow().getHandle(), handle);
    }

    private static void ensureCursors() {
        if (cursorsReady) return;
        arrowCursor = GLFW.glfwCreateStandardCursor(GLFW.GLFW_ARROW_CURSOR);
        handCursor = GLFW.glfwCreateStandardCursor(GLFW.GLFW_HAND_CURSOR);
        ibeamCursor = GLFW.glfwCreateStandardCursor(GLFW.GLFW_IBEAM_CURSOR);
        resizeCursor = GLFW.glfwCreateStandardCursor(GLFW.GLFW_RESIZE_EW_CURSOR);
        cursorsReady = true;
    }

    public static void arrowCursorNow() {
        MinecraftClient client = MinecraftClient.getInstance();
        if (client == null || client.getWindow() == null) return;
        ensureCursors();
        GLFW.glfwSetCursor(client.getWindow().getHandle(), arrowCursor);
    }

    public static int scaledWidth() {
        Window window = MinecraftClient.getInstance().getWindow();
        return window == null ? 0 : window.getScaledWidth();
    }

    public static int scaledHeight() {
        Window window = MinecraftClient.getInstance().getWindow();
        return window == null ? 0 : window.getScaledHeight();
    }

    // ---- Internals ----

    private static void fillRounded(Renderer2D r, double x, double y, double w, double h,
                                    double tl, double tr, double br, double bl, Color color) {
        double max = Math.min(w, h) / 2.0;
        tl = clampR(tl, max);
        tr = clampR(tr, max);
        br = clampR(br, max);
        bl = clampR(bl, max);

        double top = Math.max(tl, tr);
        double bottom = Math.max(bl, br);

        if (h - top - bottom > 0) {
            r.quad(x, y + top, w, h - top - bottom, color);
        }
        if (top > 0 && w - tl - tr > 0) {
            r.quad(x + tl, y, w - tl - tr, top, color);
        }
        if (bottom > 0 && w - bl - br > 0) {
            r.quad(x + bl, y + h - bottom, w - bl - br, bottom, color);
        }

        // leftover side caps when left/right radii differ from top/bottom max
        if (tl < top && tl > 0) r.quad(x, y + tl, tl, top - tl, color);
        if (tr < top && tr > 0) r.quad(x + w - tr, y + tr, tr, top - tr, color);
        if (bl < bottom && bl > 0) r.quad(x, y + h - bottom, bl, bottom - bl, color);
        if (br < bottom && br > 0) r.quad(x + w - br, y + h - bottom, br, bottom - br, color);

        if (tl >= 0.5) arc(r, x + tl, y + tl, tl, 180, 270, color);
        if (tr >= 0.5) arc(r, x + w - tr, y + tr, tr, 270, 360, color);
        if (br >= 0.5) arc(r, x + w - br, y + h - br, br, 0, 90, color);
        if (bl >= 0.5) arc(r, x + bl, y + h - bl, bl, 90, 180, color);
    }

    private static void fillRoundedGradient(Renderer2D r, double x, double y, double w, double h,
                                            double tl, double tr, double br, double bl, Color topC, Color botC) {
        fillRounded(r, x, y, w, h, tl, tr, br, bl, mix(topC, botC, 0.35f));
        // Vertical fade on the body so the outline reads light on top, dark at the bottom.
        double max = Math.min(w, h) / 2.0;
        tl = clampR(tl, max);
        tr = clampR(tr, max);
        br = clampR(br, max);
        bl = clampR(bl, max);
        double insetL = Math.max(tl, bl);
        double insetR = Math.max(tr, br);
        if (w - insetL - insetR > 0) {
            r.quad(x + insetL, y, w - insetL - insetR, h, topC, topC, botC, botC);
        }
    }

    private static void arc(Renderer2D r, double cx, double cy, double radius, double startDeg, double endDeg, Color color) {
        double startRad = Math.toRadians(startDeg);
        double stepRad = Math.toRadians(endDeg - startDeg) / CORNER_SEGMENTS;

        double prevX = cx + Math.cos(startRad) * radius;
        double prevY = cy + Math.sin(startRad) * radius;

        for (int i = 1; i <= CORNER_SEGMENTS; i++) {
            double angle = startRad + stepRad * i;
            double px = cx + Math.cos(angle) * radius;
            double py = cy + Math.sin(angle) * radius;
            r.triangle(cx, cy, prevX, prevY, px, py, color);
            prevX = px;
            prevY = py;
        }
    }

    private static void feather(Renderer2D r, double x, double y, double w, double h,
                                double tl, double tr, double br, double bl, Color base) {
        Color solid = base.copy();
        Color clear = base.copy();
        clear.a(0);

        double max = Math.min(w, h) / 2.0;
        tl = clampR(tl, max);
        tr = clampR(tr, max);
        br = clampR(br, max);
        bl = clampR(bl, max);

        r.quad(x + tl, y - AA_FEATHER, w - tl - tr, AA_FEATHER, clear, clear, solid, solid);
        r.quad(x + bl, y + h, w - bl - br, AA_FEATHER, solid, solid, clear, clear);
        r.quad(x - AA_FEATHER, y + tl, AA_FEATHER, h - tl - bl, clear, solid, solid, clear);
        r.quad(x + w, y + tr, AA_FEATHER, h - tr - br, solid, clear, clear, solid);

        if (tl >= 0.5) featherCorner(r, x + tl, y + tl, tl, 180, 270, solid);
        if (tr >= 0.5) featherCorner(r, x + w - tr, y + tr, tr, 270, 360, solid);
        if (br >= 0.5) featherCorner(r, x + w - br, y + h - br, br, 0, 90, solid);
        if (bl >= 0.5) featherCorner(r, x + bl, y + h - bl, bl, 90, 180, solid);
    }

    private static void featherCorner(Renderer2D r, double cx, double cy, double radius, double startDeg, double endDeg, Color solid) {
        Mesh mesh = r.triangles;
        Color clear = solid.copy();
        clear.a(0);

        double startRad = Math.toRadians(startDeg);
        double stepRad = Math.toRadians(endDeg - startDeg) / CORNER_SEGMENTS;

        double prevOutX = cx + Math.cos(startRad) * (radius + AA_FEATHER);
        double prevOutY = cy + Math.sin(startRad) * (radius + AA_FEATHER);
        double prevInX = cx + Math.cos(startRad) * radius;
        double prevInY = cy + Math.sin(startRad) * radius;

        for (int i = 1; i <= CORNER_SEGMENTS; i++) {
            double angle = startRad + stepRad * i;
            double outX = cx + Math.cos(angle) * (radius + AA_FEATHER);
            double outY = cy + Math.sin(angle) * (radius + AA_FEATHER);
            double inX = cx + Math.cos(angle) * radius;
            double inY = cy + Math.sin(angle) * radius;

            int i1 = mesh.vec2(prevInX, prevInY).color(solid).next();
            int i2 = mesh.vec2(prevOutX, prevOutY).color(clear).next();
            int i3 = mesh.vec2(outX, outY).color(clear).next();
            int i4 = mesh.vec2(inX, inY).color(solid).next();
            mesh.quad(i1, i2, i3, i4);

            prevOutX = outX;
            prevOutY = outY;
            prevInX = inX;
            prevInY = inY;
        }
    }

    private static double clampR(double radius, double max) {
        return Math.max(0, Math.min(radius, max));
    }

    private static Color mix(Color a, Color b, float t) {
        return new Color(
            (int) (a.r + (b.r - a.r) * t),
            (int) (a.g + (b.g - a.g) * t),
            (int) (a.b + (b.b - a.b) * t),
            (int) (a.a + (b.a - a.a) * t)
        );
    }

    private static Color unpack(int packed) {
        return new Color(packed >> 16 & 255, packed >> 8 & 255, packed & 255, packed >>> 24);
    }
}


