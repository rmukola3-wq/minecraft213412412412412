    public static void shadow(DrawContext context, float x, float y, float w, float h, int radius, int packed) {
        if (w <= 0 || h <= 0 || radius <= 0) return;

        int steps = Math.min(10, Math.max(4, radius / 2));
        for (int i = steps; i >= 1; i--) {
            float grow = i * (radius / (float) steps);
            float alphaScale = (1f - i / (float) (steps + 1)) * 0.35f;
            int a = Math.round(((packed >>> 24) & 255) * alphaScale);
            if (a <= 0) continue;
            rounded(context, x - grow, y - grow, w + grow * 2, h + grow * 2, 6f + grow * 0.25f, DropDownColors.withAlpha(packed, a));
        }
