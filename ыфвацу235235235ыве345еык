    private void updateParticles(float dt, float mx, float my, int width, int height) {
        for (int i = 0; i < PARTICLE_COUNT; i++) {
            float dx = mx - px[i];
            float dy = my - py[i];
            float dist = (float) Math.sqrt(dx * dx + dy * dy);
            if (dist < 70 && dist > 1f) {
                pvx[i] += (dx / dist) * 0.05f * dt * 60f;
                pvy[i] += (dy / dist) * 0.05f * dt * 60f;
            }
            float speed = (float) Math.sqrt(pvx[i] * pvx[i] + pvy[i] * pvy[i]);
            if (speed > 36f) {
                pvx[i] = pvx[i] / speed * 36f;
                pvy[i] = pvy[i] / speed * 36f;
            }
            px[i] += pvx[i] * dt;
            py[i] += pvy[i] * dt;
            if (px[i] < -6) px[i] = width + 6;
            if (px[i] > width + 6) px[i] = -6;
            if (py[i] < -6) py[i] = height + 6;
            if (py[i] > height + 6) py[i] = -6;
        }
    }

    private void particles(DrawContext context, float mx, float my, float alpha) {
        if (alpha < 0.02f) return;
        Renderer2D r = Renderer2D.COLOR;
        r.begin();
        Color line = new Color();
        Color dot = new Color();
        for (int i = 0; i < PARTICLE_COUNT; i++) {
            for (int j = i + 1; j < PARTICLE_COUNT; j++) {
                float dx = px[j] - px[i];
                float dy = py[j] - py[i];
                float dist = (float) Math.sqrt(dx * dx + dy * dy);
                if (dist >= CONNECT || dist < 0.5f) continue;
                float t = 1f - dist / CONNECT;
                unpack(line, DropDownColors.withAlpha(0x00E5FF, (int) (t * t * 90 * alpha)));
                r.quad(px[i], py[i], Math.max(1f, Math.abs(dx)), 1f, line);
            }
        }
        for (int i = 0; i < PARTICLE_COUNT; i++) {
            float md = (float) Math.hypot(mx - px[i], my - py[i]);
            float glow = md < 70 ? 1f - md / 70f : 0f;
            int a = (int) ((0.3f + pbright[i] * 0.45f + glow * 0.4f) * 255 * alpha);
            unpack(dot, DropDownColors.withAlpha(glow > 0.05f ? ACCENT : 0xFF4A5A7A, a));
            r.quad(px[i] - 1, py[i] - 1, 2, 2, dot);
        }
        r.render(context.getMatrices());
    }

    private void unpack(Color out, int packed) {
        out.set(packed >> 16 & 255, packed >> 8 & 255, packed & 255, packed >>> 24);
    }
}


