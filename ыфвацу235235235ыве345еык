        Color l = unpack(left);
        Color ri = unpack(right);
        r.quad(x, y, w, h, l, ri, ri, l);
        r.render(context.getMatrices());
        MorzhScissor.reapply();
    }

    public static void rectV(DrawContext context, float x, float y, float w, float h, int top, int bottom) {
        if (w <= 0 || h <= 0) return;
        Renderer2D r = Renderer2D.COLOR;
        r.begin();
        Color t = unpack(top);
        Color b = unpack(bottom);
        r.quad(x, y, w, h, t, t, b, b);
        r.render(context.getMatrices());
        MorzhScissor.reapply();
