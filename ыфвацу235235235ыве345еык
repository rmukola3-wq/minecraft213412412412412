        r.begin();
        Color fill = unpack(packed);
        fillRounded(r, x, y, w, h, tl, tr, br, bl, fill);
        feather(r, x, y, w, h, tl, tr, br, bl, fill);
        r.render(context.getMatrices());
        MorzhScissor.reapply();
    }

    public static void roundedVertical(DrawContext context, float x, float y, float w, float h,
                                       float tl, float tr, float br, float bl, int top, int bottom) {
        if (w <= 0 || h <= 0) return;

        Renderer2D r = Renderer2D.COLOR;
        r.begin();
        Color cTop = unpack(top);
        Color cBot = unpack(bottom);
        fillRoundedGradient(r, x, y, w, h, tl, tr, br, bl, cTop, cBot);
        feather(r, x, y, w, h, tl, tr, br, bl, cTop);
        r.render(context.getMatrices());
        MorzhScissor.reapply();
