        Identifier old = icons.remove(info.address);
        if (old != null && client != null) client.getTextureManager().destroyTexture(old);
        iconBytes.remove(info.address);
        if (data == null || data.length == 0) return;
        try (ByteArrayInputStream in = new ByteArrayInputStream(data)) {
            NativeImage image = NativeImage.read(in);
            Identifier id = Identifier.of(MeteorClient.MOD_ID, "mp_icon/" + Integer.toUnsignedString(info.address.hashCode(), 16));
            client.getTextureManager().registerTexture(id, new NativeImageBackedTexture(image));
            icons.put(info.address, id);
            iconBytes.put(info.address, data);
        } catch (Exception ignored) {
        }
    }
