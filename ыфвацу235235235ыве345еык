package meteordevelopment.meteorclient.gui.morzh;

import meteordevelopment.meteorclient.renderer.GL;
import net.minecraft.client.MinecraftClient;

import java.util.ArrayDeque;
import java.util.Deque;

import static org.lwjgl.opengl.GL11.glScissor;

/**
 * Clipping for the immediate Renderer2D pipeline.
 *
 * DrawContext#enableScissor is bound to vanilla's buffered draw calls, so it is
 * not a reliable way to clip geometry that Renderer2D uploads straight to the
 * GPU. This drives the raw GL scissor box instead, which survives Renderer2D's
 * GL state save/restore, and keeps a stack so nested regions intersect their
 * parent instead of replacing it.
 *
 * Coordinates are given in scaled GUI space, the same space the screen lays out
 * in, and are converted to framebuffer space here.
 */
public final class MorzhScissor {
    private static final Deque<int[]> STACK = new ArrayDeque<>();

    /** The same regions in scaled GUI space, so hit tests can reuse them. */
    private static final Deque<double[]> SCALED_STACK = new ArrayDeque<>();

    private MorzhScissor() {}

    /**
     * Whether a point in scaled GUI space is inside the region currently being
     * clipped to. Lets hover and tooltips ignore anything that is scrolled out
     * of sight but still being submitted for drawing.
     */
    public static boolean contains(double x, double y) {
        if (SCALED_STACK.isEmpty()) return true;

        double[] region = SCALED_STACK.peek();

        return x >= region[0]
            && x < region[0] + region[2]
            && y >= region[1]
            && y < region[1] + region[3];
    }

    public static void push(double x, double y, double width, double height) {
        MinecraftClient client = MinecraftClient.getInstance();

        if (client == null || client.getWindow() == null) {
            return;
        }

        double scale = client.getWindow().getScaleFactor();
        int scaledHeight = client.getWindow().getScaledHeight();

        pushScaled(x, y, width, height);

        int scissorX = (int) Math.floor(x * scale);
        int scissorWidth = (int) Math.ceil(width * scale);
        int scissorHeight = (int) Math.ceil(height * scale);
        int scissorY = (int) Math.floor((scaledHeight - y - height) * scale);

        if (!STACK.isEmpty()) {
            int[] parent = STACK.peek();

            int left = Math.max(scissorX, parent[0]);
            int bottom = Math.max(scissorY, parent[1]);
            int right = Math.min(scissorX + scissorWidth, parent[0] + parent[2]);
            int top = Math.min(scissorY + scissorHeight, parent[1] + parent[3]);

            scissorX = left;
            scissorY = bottom;
            scissorWidth = right - left;
            scissorHeight = top - bottom;
        }

        scissorWidth = Math.max(0, scissorWidth);
        scissorHeight = Math.max(0, scissorHeight);

        STACK.push(new int[] {scissorX, scissorY, scissorWidth, scissorHeight});

        GL.enableScissorTest();
        glScissor(scissorX, scissorY, scissorWidth, scissorHeight);
    }

    private static void pushScaled(
        double x,
        double y,
        double width,
        double height
    ) {
        double left = x;
        double top = y;
        double right = x + width;
        double bottom = y + height;

        if (!SCALED_STACK.isEmpty()) {
            double[] parent = SCALED_STACK.peek();

            left = Math.max(left, parent[0]);
            top = Math.max(top, parent[1]);
            right = Math.min(right, parent[0] + parent[2]);
            bottom = Math.min(bottom, parent[1] + parent[3]);
        }

        SCALED_STACK.push(
            new double[] {
                left,
                top,
                Math.max(0, right - left),
                Math.max(0, bottom - top)
            }
        );
    }

    public static void pop() {
        if (STACK.isEmpty()) {
            return;
        }

        STACK.pop();
        SCALED_STACK.pop();

        if (STACK.isEmpty()) {
            GL.disableScissorTest();
            return;
        }

        reapply();
    }

    /** Re-applies the active GL scissor after Renderer2D batches touch GL state. */
    public static void reapply() {
        if (STACK.isEmpty()) return;

        int[] box = STACK.peek();
        GL.enableScissorTest();
        glScissor(box[0], box[1], box[2], box[3]);
    }

    /** Drops every region, so a failed frame cannot leave the GUI clipped. */
    public static void reset() {
        STACK.clear();
        SCALED_STACK.clear();
        GL.disableScissorTest();
    }
}


