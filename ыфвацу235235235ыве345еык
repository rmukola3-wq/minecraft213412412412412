    }

    // ---- Expensive MathUtil.fast / round ----

    public static float fast(float current, float target, float speed) {
        float fps = MinecraftClient.getInstance().getCurrentFps();
        float dt = fps > 0 ? 1f / fps : 1f / 60f;
        float factor = Math.max(0f, Math.min(1f, dt * speed));
        return current + (target - current) * factor;
    }

    public static double round(double num, double increment) {
        if (increment <= 0) return num;
        double v = Math.round(num / increment) * increment;
        return BigDecimal.valueOf(v).setScale(4, RoundingMode.HALF_UP).doubleValue();
    }

