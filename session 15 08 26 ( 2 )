private void updateTargets() {
        targets.clear();

        if (onlyOnLook.get()) {
            lockedTarget = null;

            Entity targeted =
                mc.targetedEntity;

            if (
                targeted != null
                    && entityCheck(targeted)
            ) {
                targets.add(targeted);
            }

            return;
        }

        if (
            targetLock.get()
                && lockedTarget != null
        ) {
            if (entityCheck(lockedTarget)) {
                targets.add(lockedTarget);
                return;
            }

            lockedTarget = null;
            aimPointResolver.reset();
        }

        int amount =
            targetLock.get()
                ? 1
                : maxTargets.get();

        TargetUtils.getList(
            targets,
            this::entityCheck,
            priority.get(),
            amount
        );

        if (
            targetLock.get()
                && !targets.isEmpty()
        ) {
            lockedTarget =
                targets.getFirst();
        }
    }

    private boolean prepareWeapon() {
        if (!autoSwitch.get()) {
            return true;
        }

        FindItemResult result =
            findWeapon();

        if (
            !result.found()
                || result.slot() < 0
        ) {
            return false;
        }

        int selectedSlot =
            mc.player
                .getInventory()
                .selectedSlot;

        if (
            !swapped
                && result.slot()
                != selectedSlot
        ) {
            previousSlot = selectedSlot;
            swapped = true;
        }

        if (
            result.slot()
                != selectedSlot
        ) {
            InvUtils.swap(
                result.slot(),
                false
            );
        }

        return true;
    }

    private FindItemResult findWeapon() {
        if (shouldShieldBreak()) {
            return InvUtils.findInHotbar(
                stack ->
                    stack.getItem()
                        instanceof AxeItem
            );
        }

        return switch (weapon.get()) {
            case Sword ->
                InvUtils.findInHotbar(
                    stack ->
                        stack.getItem()
                            instanceof SwordItem
                );

            case Axe ->
                InvUtils.findInHotbar(
                    stack ->
                        stack.getItem()
                            instanceof AxeItem
                );

            case Mace ->
                InvUtils.findInHotbar(
                    stack ->
                        stack.getItem()
                            instanceof MaceItem
                );

            case Trident ->
                InvUtils.findInHotbar(
                    stack ->
                        stack.getItem()
                            instanceof TridentItem
                );

            case All ->
                findPreferredWeapon();

            case Any ->
                InvUtils.findInHotbar(
                    stack -> true
                );
        };
    }

    private FindItemResult findPreferredWeapon() {
        FindItemResult result =
            InvUtils.findInHotbar(
                stack ->
                    stack.getItem()
                        instanceof SwordItem
            );

        if (result.found()) {
            return result;
        }

        result =
            InvUtils.findInHotbar(
                stack ->
                    stack.getItem()
                        instanceof MaceItem
            );

        if (result.found()) {
            return result;
        }

        result =
            InvUtils.findInHotbar(
                stack ->
                    stack.getItem()
                        instanceof TridentItem
            );

        if (result.found()) {
            return result;
        }

        return InvUtils.findInHotbar(
            stack ->
                stack.getItem()
                    instanceof AxeItem
        );
    }

    private void rotate(Vec3d point) {
        Rotation rotation =
            calculateRotation(point);

        Rotations.rotate(
            rotation.yaw,
            rotation.pitch
        );
    }

    private Rotation calculateRotation(
        Vec3d point
    ) {
        Vec3d eyes =
            mc.player.getEyePos();

        double deltaX =
            point.x - eyes.x;

        double deltaY =
            point.y - eyes.y;

        double deltaZ =
            point.z - eyes.z;

        double horizontal =
            Math.sqrt(
                deltaX * deltaX
                    + deltaZ * deltaZ
            );

        float yaw =
            (float) (
                Math.toDegrees(
                    Math.atan2(
                        deltaZ,
                        deltaX
                    )
                ) - 90.0
            );

        float pitch =
            (float) (
                -Math.toDegrees(
                    Math.atan2(
                        deltaY,
                        horizontal
                    )
                )
            );

        return new Rotation(
            yaw,
            MathHelper.clamp(
                pitch,
                -90f,
                90f
            )
        );
    }

    private boolean attack(Entity target) {
        if (
            target == null
                || !target.isAlive()
                || !entityCheck(target)
        ) {
            return false;
        }

        Vec3d attackPoint =
            aimPointResolver.resolve(
                mc,
                target,
                range.get(),
                wallsRange.get()
            );

        if (attackPoint == null) {
            return false;
        }

        boolean breakingShield =
            shouldShieldBreak()
                && mc.player
                    .getMainHandStack()
                    .getItem()
                    instanceof AxeItem;

        Runnable attackAction = () -> {
            if (
                mc.player == null
                    || mc.interactionManager == null
                    || !target.isAlive()
                    || !entityCheck(target)
            ) {
                return;
            }

            mc.interactionManager.attackEntity(
                mc.player,
                target
            );

            mc.player.swingHand(
                Hand.MAIN_HAND
            );

            if (breakingShield) {
                shieldBreakCooldown = 10;
            }

            /*
             * Cooldown resets only after an actual
             * attack packet has been sent.
             */
            hitTimer = 0;
        };

        if (
            rotation.get()
                == RotationMode.OnHit
        ) {
            Rotation attackRotation =
                calculateRotation(attackPoint);

            Rotations.rotate(
                attackRotation.yaw,
                attackRotation.pitch,
                attackAction
            );
        } else {
            attackAction.run();
        }

        return true;
    }

    private float getCooldownProgress() {
        if (!customDelay.get()) {
            return mc.player
                .getAttackCooldownProgress(
                    0.5f
                );
        }

        float required =
            getRequiredCustomTicks();

        if (required <= 0) {
            return 1.0f;
        }

        return MathHelper.clamp(
            hitTimer / required,
            0.0f,
            1.0f
        );
    }

    private boolean isCooldownReady(
        float cooldownProgress
    ) {
        if (switchTimer > 0) {
            return false;
        }

        if (customDelay.get()) {
            return hitTimer
                >= getRequiredCustomTicks();
        }

        return cooldownProgress
            >= cooldownThreshold.get();
    }

    private float getRequiredCustomTicks() {
        float required =
            hitDelay.get();

        if (tpsSync.get()) {
            float tickRate =
                TickRate.INSTANCE
                    .getTickRate();

            float factor =
                tickRate / 20.0f;

            if (factor > 0) {
                required /= factor;
            }
        }

        return Math.max(0, required);
    }

    private AuraCriticalController.Mode
    getEffectiveCriticalMode() {
        AuraCriticalController.Mode mode =
            criticalMode.get();

        if (
            mode
                == AuraCriticalController.Mode.Off
        ) {
            return mode;
        }

        if (hasJumpSpace()) {
            return mode;
        }

        /*
         * Smart uses a normal attack under a low
         * ceiling. OnlyCriticals continues waiting.
         */
        if (
            mode
                == AuraCriticalController.Mode.Smart
        ) {
            return AuraCriticalController.Mode.Off;
        }

        return mode;
    }

    private boolean hasJumpSpace() {
        BlockPos base =
            mc.player.getBlockPos();

        for (int offset = 2;
             offset <= 3;
             offset++) {
            BlockPos position =
                base.up(offset);

            BlockState state =
                mc.world.getBlockState(
                    position
                );

            if (
                !state.isAir()
                    && !state
                    .getCollisionShape(
                        mc.world,
                        position
                    )
                    .isEmpty()
            ) {
                return false;
            }
        }

        return true;
    }

    private void stopAttacking() {
        attacking = false;

        if (wasPathing) {
            PathManagers.get().resume();
            wasPathing = false;
        }

        if (swapped) {
            if (
                swapBack.get()
                    && previousSlot >= 0
                    && previousSlot <= 8
            ) {
                InvUtils.swap(
                    previousSlot,
                    false
                );
            }

            swapped = false;
            previousSlot = -1;
        }
    }

    private void clearCombat() {
        targets.clear();

        lockedTarget = null;
        currentAimPoint = null;

        aimPointResolver.reset();

        if (mc.player != null) {
            criticalController.reset(
                mc.player
            );
        }

        stopAttacking();
