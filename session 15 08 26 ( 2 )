                .sliderRange(12, 120)
                .visible(render::get)
                .build()
        );

    private final Color circleColor =
        new Color(154, 92, 224, 190);

    private int direction = -1;
    private int switchCooldown;
    private boolean wasColliding;

    public TargetStrafe() {
        super(
            Categories.Movement,
            "target-strafe",
            "Moves in a configurable circle around the current Kill Aura target."
        );
    }

    @Override
    public void onActivate() {
        direction = -1;
        switchCooldown = 0;
        wasColliding = false;
    }

    @Override
    public String getInfoString() {
        return direction > 0
            ? "Left"
            : "Right";
    }

    @EventHandler
    private void onTick(TickEvent.Pre event) {
        if (mc.player == null || mc.world == null) {
            return;
        }

        if (switchCooldown > 0) {
            switchCooldown--;
        }

        if (manualDirection.get()) {
            if (mc.options.leftKey.isPressed()) {
                direction = 1;
            } else if (
                mc.options.rightKey.isPressed()
            ) {
                direction = -1;
            }
        }

        boolean colliding =
            mc.player.horizontalCollision;

        if (
            collisionSwitch.get()
                && colliding
                && !wasColliding
        ) {
            switchDirection();
        }

        wasColliding = colliding;

        LivingEntity target = getTarget();

        if (
            target != null
                && canStrafe()
                && autoJump.get()
                && mc.player.isOnGround()
        ) {
            mc.player.jump();
        }
    }

    @EventHandler
    private void onMove(PlayerMoveEvent event) {
        if (
            mc.player == null
                || mc.world == null
                || event.type != MovementType.SELF
        ) {
            return;
        }

        LivingEntity target = getTarget();

        if (target == null || !canStrafe()) {
            return;
        }

        double movementSpeed = speed.get();

        if (
            hurtBoost.get()
                && mc.player.hurtTime > 0
        ) {
            movementSpeed +=
                hurtBoostAmount.get();
        }

        Vec3d movement =
            calculateMovement(
                target,
                movementSpeed,
                direction
            );

        if (
            edgeCheck.get()
                && !hasGround(
                mc.player.getX() + movement.x,
                mc.player.getY(),
                mc.player.getZ() + movement.z
            )
        ) {
            if (switchCooldown <= 0) {
                switchDirection();
            }

            movement =
                calculateMovement(
                    target,
                    movementSpeed,
                    direction
                );
        }

        event.movement = new Vec3d(
            movement.x,
            event.movement.y,
            movement.z
        );
    }

    @EventHandler
    private void onRender(Render3DEvent event) {
        if (
            !render.get()
                || mc.player == null
                || mc.world == null
        ) {
            return;
        }

        LivingEntity target = getTarget();

        if (target == null) {
            return;
        }

        int points = renderPoints.get();

        double radius = distance.get();
        double y =
            target.getY() + 0.05;

        double previousX =
            target.getX() + radius;

        double previousZ =
            target.getZ();

        for (int i = 1; i <= points; i++) {
            double angle =
                Math.PI * 2.0
                    * i / points;

            double x =
                target.getX()
                    + Math.cos(angle) * radius;

            double z =
                target.getZ()
                    + Math.sin(angle) * radius;

            event.renderer.line(
                previousX,
                y,
                previousZ,
                x,
                y,
                z,
                circleColor
            );

            previousX = x;
            previousZ = z;
        }
    }

    private LivingEntity getTarget() {
        KillAura aura =
            Modules.get().get(KillAura.class);

        if (
            aura == null
                || !aura.isActive()
        ) {
            return null;
        }

        Entity entity = aura.getTarget();

        if (
            entity instanceof LivingEntity living
                && living.isAlive()
                && entity != mc.player
        ) {
            return living;
        }

        return null;
    }

    private boolean canStrafe() {
        if (
            pauseSneaking.get()
                && mc.player.isSneaking()
        ) {
            return false;
        }

        if (
            pauseInLiquids.get()
                && (
                mc.player.isSubmergedInWater()
                    || mc.player.isInLava()
            )
        ) {
            return false;
        }

        return !mc.player
            .getAbilities()
            .flying;
    }

    private Vec3d calculateMovement(
        LivingEntity target,
        double movementSpeed,
        int movementDirection
    ) {
        double playerX =
            mc.player.getX();

        double playerZ =
            mc.player.getZ();

        double targetX =
            target.getX();

        double targetZ =
            target.getZ();

        double differenceX =
            playerX - targetX;

        double differenceZ =
            playerZ - targetZ;

        double currentDistance =
            Math.sqrt(
                differenceX * differenceX
                    + differenceZ * differenceZ
            );

        if (currentDistance < 0.001) {
            currentDistance = 0.001;
            differenceX = 1;
            differenceZ = 0;
        }

        double radialX =
            differenceX / currentDistance;

        double radialZ =
            differenceZ / currentDistance;

        double tangentX =
            -radialZ * movementDirection;

        double tangentZ =
            radialX * movementDirection;

        double distanceError =
            currentDistance - distance.get();

        double correction =
            MathHelper.clamp(
                distanceError * 0.45,
                -0.75,
                0.75
            );

        double directionX =
            tangentX - radialX * correction;

        double directionZ =
            tangentZ - radialZ * correction;

        double length =
            Math.sqrt(
                directionX * directionX
                    + directionZ * directionZ
            );

        if (length < 0.001) {
            return Vec3d.ZERO;
        }

        return new Vec3d(
            directionX / length
                * movementSpeed,
            0,
            directionZ / length
                * movementSpeed
        );
    }

    private boolean hasGround(
        double x,
        double y,
        double z
    ) {
        BlockPos.Mutable position =
            new BlockPos.Mutable();

        int startY =
            MathHelper.floor(y - 0.1);

        for (
            int offset = 0;
            offset <= edgeDepth.get();
            offset++
        ) {
            position.set(
                MathHelper.floor(x),
                startY - offset,
                MathHelper.floor(z)
            );

            BlockState state =
                mc.world.getBlockState(position);

            if (!state.isAir()) {
                return true;
            }
        }

        return false;
    }

    private void switchDirection() {
        if (switchCooldown > 0) {
            return;
        }

        direction = -direction;
        switchCooldown = 5;
    }
}


