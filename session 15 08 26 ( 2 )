    private boolean clockwise;
    private boolean wasColliding;

    private int switchTicks;
    private int waterTicks;
    private int noSlowTicks;

    private double oldSpeed;
    private float contextFriction = 0.91f;

    public TargetStrafe() {
        super(
            Categories.Movement,
            "target-strafe",
            "Thunder-style movement around the current Kill Aura target."
        );
    }

    @Override
    public void onActivate() {
        clockwise =
            directionMode.get()
                == DirectionMode.Clockwise;

        if (
            directionMode.get()
                == DirectionMode.CounterClockwise
        ) {
            clockwise = false;
        }

        oldSpeed = 0;
        contextFriction = 0.91f;

        switchTicks = 0;
        waterTicks = 0;
        noSlowTicks = 0;

        wasColliding = false;
    }

    @Override
    public void onDeactivate() {
        oldSpeed = 0;
        noSlowTicks = 0;
    }

    @Override
    public String getInfoString() {
        return clockwise
            ? "Right"
            : "Left";
    }

    @EventHandler
    private void onTick(TickEvent.Pre event) {
        if (
            mc.player == null
                || mc.world == null
        ) {
            return;
        }

        if (switchTicks > 0) {
            switchTicks--;
        }

        if (mc.player.isSubmergedInWater()) {
            waterTicks = 10;
        } else if (waterTicks > 0) {
            waterTicks--;
        }

        double movedX =
            mc.player.getX() - mc.player.prevX;

        double movedZ =
            mc.player.getZ() - mc.player.prevZ;

        oldSpeed =
            Math.hypot(movedX, movedZ)
                * contextFriction;

        if (
            directionMode.get()
                == DirectionMode.Manual
        ) {
            if (mc.options.leftKey.isPressed()) {
                clockwise = false;
            } else if (
                mc.options.rightKey.isPressed()
            ) {
                clockwise = true;
            }
        }

        boolean collision =
            mc.player.horizontalCollision;

        if (
            switchOnCollision.get()
                && collision
                && !wasColliding
        ) {
            switchDirection();
        }

        wasColliding = collision;

        LivingEntity target = getTarget();

        if (
            target != null
                && canStrafe()
                && autoJump.get()
                && mc.player.isOnGround()
        ) {
            mc.player.jump();
        }
    }

    @EventHandler(
        priority = EventPriority.LOWEST - 100
    )
    private void onMove(PlayerMoveEvent event) {
        if (
            mc.player == null
                || mc.world == null
                || event.type != MovementType.SELF
        ) {
            return;
        }

        LivingEntity target = getTarget();

        if (
            target == null
                || !canStrafe()
        ) {
            oldSpeed = 0;
            return;
        }

        double movementSpeed =
            calculateSpeed(event);

        if (
            hurtBoost.get()
                && mc.player.hurtTime > 0
        ) {
            movementSpeed +=
                hurtBoostAmount.get();
        }

        movementSpeed = MathHelper.clamp(
            movementSpeed,
            0.01,
            2.0
        );

        Vec3d predictedTarget =
            getPredictedTargetPosition(target);

        OrbitPoint point =
            calculateOrbitPoint(
                predictedTarget,
                movementSpeed,
                clockwise
            );

        if (
            shouldSwitch(
                point.x,
                point.z
            )
        ) {
            switchDirection();

            point = calculateOrbitPoint(
                predictedTarget,
                movementSpeed,
                clockwise
            );
        }

        double yaw =
            getYawTo(
                point.x,
                point.z
            );

        double motionX =
            movementSpeed
                * -Math.sin(
                Math.toRadians(yaw)
            );

        double motionZ =
            movementSpeed
                * Math.cos(
                Math.toRadians(yaw)
            );

        /*
         * Важно:
         * event.movement нельзя заменять новым Vec3d.
         * Миксин продолжает использовать исходный объект.
         */
        ((IVec3d) event.movement)
            .meteor$setXZ(
                motionX,
                motionZ
            );
    }

    @EventHandler
    private void onPacketReceive(
        PacketEvent.Receive event
    ) {
        if (
            event.packet
                instanceof PlayerPositionLookS2CPacket
        ) {
            oldSpeed = 0;
            noSlowTicks = 0;
        }
    }

    @EventHandler
    private void onRender(
        Render3DEvent event
    ) {
        if (
            !render.get()
                || mc.player == null
                || mc.world == null
        ) {
            return;
        }

        LivingEntity target = getTarget();

        if (target == null) {
            return;
        }

        Vec3d center =
            getPredictedTargetPosition(target);

        double radius = distance.get();
        double y = target.getY() + 0.05;

        int points = renderPoints.get();

        double previousX =
            center.x + radius;

        double previousZ =
            center.z;

        for (int i = 1;
             i <= points;
             i++) {
            double angle =
                Math.PI
                    * 2.0
                    * i
                    / points;

            double x =
                center.x
                    + Math.cos(angle)
                    * radius;

            double z =
                center.z
                    + Math.sin(angle)
                    * radius;

            event.renderer.line(
                previousX,
                y,
                previousZ,
                x,
                y,
                z,
                circleColor
            );

            previousX = x;
            previousZ = z;
        }
    }

    private double calculateSpeed(
        PlayerMoveEvent event
    ) {
        if (
            speedMode.get()
                == SpeedMode.Fixed
        ) {
            contextFriction = 0.91f;
            noSlowTicks = 0;
            return fixedSpeed.get();
        }

        BlockPos groundPosition =
            BlockPos.ofFloored(
                mc.player.getX(),
                mc.player
                    .getBoundingBox()
                    .minY
                    - event.movement.y,
                mc.player.getZ()
            );

        BlockState groundState =
            mc.world.getBlockState(
                groundPosition
            );

        float groundFriction =
            groundState
                .getBlock()
                .getSlipperiness()
                * 0.91f;

        float friction;

        if (mc.player.isOnGround()) {
            friction = groundFriction;
        } else if (
            mc.player.isUsingItem()
                && oldSpeed > 0.32
        ) {
            friction = 0.88f;
        } else {
            friction = 0.91f;
        }

        double acceleration;

        if (mc.player.isOnGround()) {
            double frictionAcceleration =
                0.1631
                    / Math.pow(
                    friction,
                    3.0
                );

            acceleration =
                mc.player.getMovementSpeed()
                    * 1.3
                    * frictionAcceleration;

            if (event.movement.y > 0) {
                acceleration +=
                    groundAcceleration.get();
            }
        } else {
            acceleration =
                airAcceleration.get();
        }

        double result =
            oldSpeed + acceleration;

        if (
            mc.player.isUsingItem()
                && event.movement.y <= 0
        ) {
            double slowed =
                oldSpeed
                    + acceleration * 0.25;

            if (
                event.movement.y != 0
                    && Math.abs(
                    event.movement.y
                ) < 0.08
            ) {
                slowed += 0.055;
            }

            double maximum =
                Math.max(
                    0.043,
                    slowed
                );

            if (result > maximum) {
                noSlowTicks++;
            } else {
                noSlowTicks =
                    Math.max(
                        0,
                        noSlowTicks - 1
                    );
            }

            if (noSlowTicks > 3) {
                result =
                    maximum - 0.019;
            }
        } else {
            noSlowTicks = 0;
        }

        result =
            Math.max(
                minimumSpeed.get(),
                result
            );

        double decay =
            speedDecay.get()
                * (
                mc.player.age % 2 == 0
                    ? 1.0
                    : 1.35
            );

        contextFriction = friction;

        return Math.max(
            minimumSpeed.get(),
            result - decay
        );
    }

    private OrbitPoint calculateOrbitPoint(
        Vec3d target,
        double movementSpeed,
        boolean clockwiseDirection
    ) {
        double differenceX =
            mc.player.getX() - target.x;

        double differenceZ =
            mc.player.getZ() - target.z;

        double horizontalDistance =
            Math.max(
                0.001,
                Math.hypot(
                    differenceX,
                    differenceZ
                )
            );

        double angle =
            Math.atan2(
                differenceZ,
                differenceX
            );

        double angleStep =
            movementSpeed
                / horizontalDistance;

        angle += clockwiseDirection
            ? angleStep
            : -angleStep;

        return new OrbitPoint(
            target.x
                + distance.get()
                * Math.cos(angle),
            target.z
                + distance.get()
                * Math.sin(angle)
        );
    }

    private Vec3d getPredictedTargetPosition(
        LivingEntity target
    ) {
        if (!targetPrediction.get()) {
            return target.getPos();
        }

        double multiplier =
            predictionTicks.get();

        double movementX =
            target.getX() - target.prevX;

        double movementY =
            target.getY() - target.prevY;

        double movementZ =
            target.getZ() - target.prevZ;

        return new Vec3d(
            target.getX()
                + movementX * multiplier,
            target.getY()
                + movementY * multiplier,
            target.getZ()
                + movementZ * multiplier
        );
    }

    private boolean shouldSwitch(
        double projectedX,
        double projectedZ
    ) {
        if (
            switchTicks <= 0
                && switchOnCollision.get()
                && mc.player.horizontalCollision
        ) {
            return true;
        }

        return switchTicks <= 0
            && voidCheck.get()
            && isDangerousPoint(
                projectedX,
                projectedZ
            );
    }

    private boolean isDangerousPoint(
        double x,
        double z
    ) {
        int blockX = MathHelper.floor(x);
        int blockZ = MathHelper.floor(z);

        int startY =
            MathHelper.floor(
                mc.player.getY() + 4
            );

        int bottomY =
            mc.world.getBottomY();

        BlockPos.Mutable position =
            new BlockPos.Mutable();

        for (
            int y = startY;
            y >= bottomY;
            y--
        ) {
            position.set(blockX, y, blockZ);

            BlockState state =
                mc.world.getBlockState(
                    position
                );

            Block block =
                state.getBlock();

            if (
                avoidFire.get()
                    && (
                    block == Blocks.LAVA
                        || block == Blocks.FIRE
                        || block
                        == Blocks.SOUL_FIRE
                )
            ) {
                return true;
            }

            if (!state.isAir()) {
                return false;
            }
        }

        return true;
    }

    private double getYawTo(
        double x,
        double z
    ) {
        double differenceX =
            x - mc.player.getX();

        double differenceZ =
            z - mc.player.getZ();

        return Math.toDegrees(
            Math.atan2(
                differenceZ,
                differenceX
            )
        ) - 90.0;
    }

    private void switchDirection() {
        if (switchTicks > 0) {
            return;
        }

        clockwise = !clockwise;
        switchTicks =
            directionCooldown.get();
    }

    private LivingEntity getTarget() {
        KillAura aura =
            Modules.get().get(
                KillAura.class
            );

        if (
            aura == null
                || !aura.isActive()
        ) {
            return null;
        }

        Entity target =
            aura.getTarget();

        if (
            target
                instanceof LivingEntity living
                && living.isAlive()
                && living != mc.player
        ) {
            return living;
        }

        return null;
    }

    private boolean canStrafe() {
        if (
            pauseSneaking.get()
                && mc.player.isSneaking()
        ) {
            return false;
        }

        if (
            pauseInLiquids.get()
                && (
                mc.player
                    .isSubmergedInWater()
                    || mc.player.isInLava()
                    || waterTicks > 0
            )
        ) {
            return false;
        }

        if (
            mc.player
                .getAbilities()
                .flying
        ) {
            return false;
        }

        if (
            pauseWithSpeed.get()
                && Modules.get()
                .isActive(Speed.class)
        ) {
            return false;
        }

        return !pauseWithScaffold.get()
            || !Modules.get()
            .isActive(Scaffold.class);
    }

    private record OrbitPoint(
        double x,
        double z
    ) {
    }

    public enum SpeedMode {
        Thunder,
        Fixed
    }

    public enum DirectionMode {
        Manual,
        Clockwise,
        CounterClockwise
    }
}


