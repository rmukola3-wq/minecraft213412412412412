    private static final int SLIDER_BACKGROUND = 0xFF28202D;

    private static final int PANEL_WIDTH = 116;
    private static final int HEADER_HEIGHT = 16;
    private static final int MODULE_HEIGHT = 15;
    private static final int SETTING_HEIGHT = 14;
    private static final int PANEL_GAP = 6;

    private static final int SEARCH_WIDTH = 180;
    private static final int SEARCH_HEIGHT = 18;

    private final Map<Category, CategoryPanel> panels = new HashMap<>();
    private final Map<Module, Boolean> expandedModules = new HashMap<>();
    private final List<Hitbox> hitboxes = new ArrayList<>();

    private CategoryPanel draggingPanel;
    private int dragOffsetX;
    private int dragOffsetY;

    private Hitbox draggedSlider;

    private String search = "";
    private boolean searchFocused;

    private int searchX;
    private int searchY;

    private String tooltip;
    private boolean initialized;

    public MorzhThunderScreen() {
        super(Text.literal("Morzh Client"));
    }

    @Override
    protected void init() {
        if (!initialized) {
            int x = 7;
            int y = 31;

            for (Category category : Modules.loopCategories()) {
                panels.put(
                    category,
                    new CategoryPanel(category, x, y)
                );

                x += PANEL_WIDTH + PANEL_GAP;
            }

            initialized = true;
        }

        searchX = Math.max(
            5,
            (width - SEARCH_WIDTH) / 2
        );

        searchY = 6;

        MorzhSoundManager.playOpen();
    }

    @Override
    public boolean shouldPause() {
        return false;
    }

    @Override
    public void render(
        DrawContext context,
        int mouseX,
        int mouseY,
        float delta
    ) {
        context.fill(
            0,
            0,
            width,
            height,
            BACKGROUND
        );

        hitboxes.clear();
        tooltip = null;

        renderSearch(context, mouseX, mouseY);

        for (Category category : Modules.loopCategories()) {
            CategoryPanel panel = panels.get(category);

            if (panel != null) {
                renderPanel(
                    context,
                    panel,
                    mouseX,
                    mouseY
                );
            }
        }

        if (tooltip != null && !tooltip.isBlank()) {
            context.drawTooltip(
                textRenderer,
                Text.literal(tooltip),
                mouseX,
                mouseY
            );
        }

        super.render(
            context,
            mouseX,
            mouseY,
            delta
        );
    }

    private void renderSearch(
        DrawContext context,
        int mouseX,
        int mouseY
    ) {
        searchX = Math.max(
            5,
            (width - SEARCH_WIDTH) / 2
        );

        boolean hovered = inside(
            mouseX,
            mouseY,
            searchX,
            searchY,
            SEARCH_WIDTH,
            SEARCH_HEIGHT
        );

        drawBorder(
            context,
            searchX,
            searchY,
            SEARCH_WIDTH,
            SEARCH_HEIGHT,
            searchFocused ? ACCENT : PANEL_BORDER
        );

        context.fill(
            searchX + 1,
            searchY + 1,
            searchX + SEARCH_WIDTH - 1,
            searchY + SEARCH_HEIGHT - 1,
            searchFocused || hovered
                ? SEARCH_FOCUSED
                : SEARCH_BACKGROUND
        );

        context.fill(
            searchX + 1,
            searchY + SEARCH_HEIGHT - 2,
            searchX + SEARCH_WIDTH - 1,
            searchY + SEARCH_HEIGHT - 1,
            searchFocused ? ACCENT : HEADER
        );

        String displayed;

        if (search.isEmpty()) {
            displayed = searchFocused
                ? "Type module name..."
                : "Search modules";
        } else {
            displayed = search;

            if (
                searchFocused
                    && (System.currentTimeMillis() / 450L) % 2L == 0
            ) {
                displayed += "_";
            }
        }

        drawText(
            context,
            shorten(displayed, 27),
            searchX + 6,
            searchY + 5,
            search.isEmpty()
                ? TEXT_SECONDARY
                : TEXT
        );
    }

    private void renderPanel(
        DrawContext context,
        CategoryPanel panel,
        int mouseX,
        int mouseY
    ) {
        List<Module> modules =
            getDisplayedModules(panel.category);

        int contentHeight = 0;

        if (!panel.collapsed) {
            for (Module module : modules) {
                contentHeight += MODULE_HEIGHT;

                if (expandedModules.getOrDefault(
                    module,
                    false
                )) {
                    contentHeight +=
                        countVisibleSettings(module)
                            * SETTING_HEIGHT;
                }
            }
        }

        int maximumContentHeight = Math.max(
            20,
            height - panel.y - HEADER_HEIGHT - 8
        );

        int visibleContentHeight = Math.min(
            contentHeight,
            maximumContentHeight
        );

        int panelHeight =
            HEADER_HEIGHT
                + visibleContentHeight;

        drawBorder(
            context,
            panel.x,
            panel.y,
            PANEL_WIDTH,
            panelHeight,
            PANEL_BORDER
        );

        context.fill(
            panel.x + 1,
            panel.y + 1,
            panel.x + PANEL_WIDTH - 1,
            panel.y + HEADER_HEIGHT,
            HEADER
        );

        context.fill(
            panel.x + 1,
            panel.y + HEADER_HEIGHT - 2,
            panel.x + PANEL_WIDTH - 1,
            panel.y + HEADER_HEIGHT,
            HEADER_BOTTOM
        );

        drawText(
            context,
            panel.category.name,
            panel.x + 4,
            panel.y + 4,
            TEXT
        );

        drawText(
            context,
            panel.collapsed ? "+" : "-",
            panel.x + PANEL_WIDTH - 10,
            panel.y + 4,
            TEXT
        );

        hitboxes.add(
            new Hitbox(
                HitboxType.PanelHeader,
                panel.x,
                panel.y,
                PANEL_WIDTH,
                HEADER_HEIGHT,
                panel,
                null,
                null
            )
        );

        if (panel.collapsed) {
            return;
        }

        context.fill(
            panel.x + 1,
            panel.y + HEADER_HEIGHT,
            panel.x + PANEL_WIDTH - 1,
            panel.y + panelHeight - 1,
            PANEL
        );

        int contentTop =
            panel.y + HEADER_HEIGHT;

        int contentBottom =
            contentTop + visibleContentHeight;

        float minimumScroll = Math.min(
            0,
            visibleContentHeight - contentHeight
        );

        panel.scroll = MathHelper.clamp(
            panel.scroll,
            minimumScroll,
            0
        );

        context.enableScissor(
            panel.x + 1,
            contentTop,
            panel.x + PANEL_WIDTH - 1,
            contentBottom
        );

        int rowY =
            contentTop + Math.round(panel.scroll);

        for (Module module : modules) {
            boolean hovered = inside(
                mouseX,
                mouseY,
                panel.x + 1,
                rowY,
                PANEL_WIDTH - 2,
                MODULE_HEIGHT
            );

            int moduleColor;

            if (module.isActive()) {
                moduleColor = hovered
                    ? 0xFF744895
                    : ENABLED;
            } else {
                moduleColor = hovered
                    ? MODULE_HOVER
                    : DISABLED;
            }

            context.fill(
                panel.x + 1,
                rowY,
                panel.x + PANEL_WIDTH - 1,
                rowY + MODULE_HEIGHT,
                moduleColor
            );

            context.fill(
                panel.x + 2,
                rowY + MODULE_HEIGHT - 1,
                panel.x + PANEL_WIDTH - 2,
                rowY + MODULE_HEIGHT,
                0xFF101010
            );

            drawText(
                context,
                shorten(module.title, 16),
                panel.x + 4,
                rowY + 4,
                module.isActive()
                    ? TEXT
                    : TEXT_SECONDARY
            );

            boolean expanded =
                expandedModules.getOrDefault(
                    module,
                    false
                );

            if (hasVisibleSettings(module)) {
                drawText(
                    context,
                    expanded ? "-" : "+",
                    panel.x + PANEL_WIDTH - 10,
                    rowY + 4,
                    TEXT_SECONDARY
                );
            }

            if (hovered) {
                tooltip = module.description;
            }

            if (
                rowY + MODULE_HEIGHT >= contentTop
                    && rowY <= contentBottom
            ) {
                hitboxes.add(
                    new Hitbox(
                        HitboxType.Module,
                        panel.x + 1,
                        rowY,
                        PANEL_WIDTH - 2,
                        MODULE_HEIGHT,
                        panel,
                        module,
                        null
                    )
                );
            }

            rowY += MODULE_HEIGHT;

            if (expanded) {
                for (SettingGroup group :
                    module.settings) {
                    for (Setting<?> setting : group) {
                        if (!setting.isVisible()) {
                            continue;
                        }

                        renderSetting(
                            context,
                            panel,
                            module,
                            setting,
                            rowY,
                            mouseX,
                            mouseY,
                            contentTop,
                            contentBottom
                        );

                        rowY += SETTING_HEIGHT;
                    }
                }
            }
        }

        context.disableScissor();
    }

    private void renderSetting(
        DrawContext context,
        CategoryPanel panel,
        Module module,
        Setting<?> setting,
        int y,
        int mouseX,
        int mouseY,
        int contentTop,
        int contentBottom
    ) {
        boolean hovered = inside(
            mouseX,
            mouseY,
            panel.x + 1,
            y,
            PANEL_WIDTH - 2,
            SETTING_HEIGHT
        );

        context.fill(
            panel.x + 1,
            y,
            panel.x + PANEL_WIDTH - 1,
            y + SETTING_HEIGHT,
            hovered
                ? 0xFF201B23
                : SETTING_BACKGROUND
        );

        String name =
            shorten(setting.title, 11);

        drawText(
            context,
            name,
            panel.x + 5,
            y + 3,
            hovered ? TEXT : TEXT_SECONDARY
        );

        if (setting instanceof BoolSetting) {
            boolean value =
                (Boolean) setting.get();

            context.fill(
                panel.x + PANEL_WIDTH - 20,
                y + 3,
                panel.x + PANEL_WIDTH - 5,
                y + 11,
                value ? ACCENT : 0xFF343434
            );

            context.fill(
                value
                    ? panel.x + PANEL_WIDTH - 12
                    : panel.x + PANEL_WIDTH - 19,
                y + 4,
                value
                    ? panel.x + PANEL_WIDTH - 6
                    : panel.x + PANEL_WIDTH - 13,
                y + 10,
                TEXT
            );
        } else if (
            setting instanceof IntSetting
                || setting instanceof DoubleSetting
        ) {
            double progress =
                getSliderProgress(setting);

            int sliderX =
                panel.x + PANEL_WIDTH - 42;

            int sliderWidth = 36;

            context.fill(
                sliderX,
                y + 9,
                sliderX + sliderWidth,
                y + 11,
                SLIDER_BACKGROUND
            );

            context.fill(
                sliderX,
                y + 9,
                sliderX
                    + Math.round(
                    sliderWidth * (float) progress
                ),
                y + 11,
                ACCENT
            );

            String value =
                formatSettingValue(setting);

            drawText(
                context,
                value,
                panel.x + PANEL_WIDTH
                    - 5
                    - textRenderer.getWidth(value),
                y + 2,
                TEXT
            );
        } else {
            String value =
                shorten(
                    formatSettingValue(setting),
                    9
                );

            drawText(
                context,
                value,
                panel.x + PANEL_WIDTH
                    - 5
                    - textRenderer.getWidth(value),
                y + 3,
                TEXT
            );
        }

        if (hovered) {
            tooltip = setting.description;
        }

        if (
            y + SETTING_HEIGHT >= contentTop
                && y <= contentBottom
        ) {
            hitboxes.add(
                new Hitbox(
                    HitboxType.Setting,
                    panel.x + 1,
                    y,
                    PANEL_WIDTH - 2,
                    SETTING_HEIGHT,
                    panel,
                    module,
                    setting
                )
            );
        }
    }

    private List<Module> getDisplayedModules(
        Category category
    ) {
        List<Module> result =
            new ArrayList<>();

        String query =
            search.trim().toLowerCase(Locale.ROOT);

        for (Module module :
            Modules.get().getGroup(category)) {
            if (
                Config.get()
                    .hiddenModules
                    .get()
                    .contains(module)
            ) {
                continue;
            }

            if (!query.isEmpty()) {
                boolean match =
                    contains(module.name, query)
                        || contains(module.title, query)
                        || contains(
                        module.description,
                        query
                    );

                if (!match) {
                    for (String alias :
                        module.aliases) {
                        if (contains(alias, query)) {
                            match = true;
                            break;
                        }
                    }
                }

                if (!match) {
                    continue;
                }
            }

            result.add(module);
        }

        return result;
    }

    private boolean contains(
        String value,
        String query
    ) {
        return value != null
            && value
                .toLowerCase(Locale.ROOT)
                .contains(query);
    }

    private int countVisibleSettings(
        Module module
    ) {
        int count = 0;

        for (SettingGroup group :
            module.settings) {
            for (Setting<?> setting : group) {
                if (setting.isVisible()) {
                    count++;
                }
            }
        }

        return count;
    }

    private boolean hasVisibleSettings(
        Module module
    ) {
        return countVisibleSettings(module) > 0;
    }

    @Override
    public boolean mouseClicked(
        double mouseX,
        double mouseY,
        int button
    ) {
        int mx = (int) mouseX;
        int my = (int) mouseY;

        if (inside(
            mx,
            my,
            searchX,
            searchY,
            SEARCH_WIDTH,
            SEARCH_HEIGHT
        )) {
            searchFocused = true;

            if (
                button
                    == GLFW.GLFW_MOUSE_BUTTON_RIGHT
            ) {
                search = "";
                resetPanelScroll();
            }

            MorzhSoundManager.playKeyPress();
            return true;
        }

        searchFocused = false;

        for (int i = hitboxes.size() - 1;
             i >= 0;
             i--) {
            Hitbox hitbox = hitboxes.get(i);

            if (!hitbox.contains(mx, my)) {
                continue;
            }

            if (
                hitbox.type
                    == HitboxType.PanelHeader
            ) {
                if (
                    button
                        == GLFW.GLFW_MOUSE_BUTTON_RIGHT
                ) {
                    hitbox.panel.collapsed =
                        !hitbox.panel.collapsed;

                    MorzhSoundManager.playBoolean();
                } else if (
                    button
                        == GLFW.GLFW_MOUSE_BUTTON_LEFT
                ) {
                    draggingPanel = hitbox.panel;
                    dragOffsetX =
                        mx - hitbox.panel.x;
                    dragOffsetY =
                        my - hitbox.panel.y;
                }

                return true;
            }

            if (
                hitbox.type
                    == HitboxType.Module
            ) {
                if (
                    button
                        == GLFW.GLFW_MOUSE_BUTTON_LEFT
                ) {
                    hitbox.module.toggle();

                    MorzhSoundManager.playModuleState(
                        hitbox.module.isActive()
                    );
                } else if (
                    button
                        == GLFW.GLFW_MOUSE_BUTTON_RIGHT
                ) {
                    boolean expanded =
                        expandedModules.getOrDefault(
                            hitbox.module,
                            false
                        );

                    expandedModules.put(
                        hitbox.module,
                        !expanded
                    );

                    MorzhSoundManager.playBoolean();
                }

                return true;
            }

            if (
                hitbox.type
                    == HitboxType.Setting
            ) {
                interactWithSetting(
                    hitbox,
                    mx,
                    button
                );

                return true;
            }
        }

        return super.mouseClicked(
            mouseX,
            mouseY,
            button
        );
    }

    private void interactWithSetting(
        Hitbox hitbox,
        int mouseX,
        int button
    ) {
        Setting<?> setting =
            hitbox.setting;

        if (
            button
                == GLFW.GLFW_MOUSE_BUTTON_MIDDLE
        ) {
            setting.reset();
            MorzhSoundManager.playBoolean();
            return;
        }

        if (setting instanceof BoolSetting) {
            BoolSetting bool =
                (BoolSetting) setting;

            bool.set(!bool.get());
            MorzhSoundManager.playBoolean();
            return;
        }

        if (
            setting instanceof IntSetting
                || setting instanceof DoubleSetting
        ) {
            draggedSlider = hitbox;
            updateSlider(hitbox, mouseX);
            MorzhSoundManager.playScroll();
            return;
        }

        if (setting instanceof EnumSetting<?>) {
            cycleEnum(
                (EnumSetting<?>) setting,
                button
                    == GLFW.GLFW_MOUSE_BUTTON_RIGHT
            );

            MorzhSoundManager.playBoolean();
        }
    }

    @SuppressWarnings({
        "rawtypes",
        "unchecked"
    })
    private void cycleEnum(
        EnumSetting<?> setting,
        boolean backwards
    ) {
        Enum current =
            (Enum) setting.get();

        if (current == null) {
            return;
        }

        Object[] values =
            current
                .getDeclaringClass()
                .getEnumConstants();

        int index = current.ordinal();

        index += backwards ? -1 : 1;

        if (index < 0) {
            index = values.length - 1;
        }

        if (index >= values.length) {
            index = 0;
        }

        ((Setting) setting).set(values[index]);
    }

    private void updateSlider(
        Hitbox hitbox,
        int mouseX
    ) {
        double progress =
            MathHelper.clamp(
                (
                    mouseX
                        - (
                        hitbox.x
                            + hitbox.width
                            - 44
                    )
                ) / 39.0,
                0,
                1
            );

        if (hitbox.setting
            instanceof IntSetting setting) {
            int minimum =
                setting.sliderMin;

            int maximum =
                setting.sliderMax;

            int value =
                (int) Math.round(
                    minimum
                        + (
                        maximum - minimum
                    ) * progress
                );

            setting.set(
                MathHelper.clamp(
                    value,
                    setting.min,
                    setting.max
                )
            );
        } else if (
            hitbox.setting
                instanceof DoubleSetting setting
        ) {
            double minimum =
                setting.sliderMin;

            double maximum =
                setting.sliderMax;

            double value =
                minimum
                    + (
                    maximum - minimum
                ) * progress;

            double multiplier =
                Math.pow(
                    10,
                    setting.decimalPlaces
                );

            value =
                Math.round(value * multiplier)
                    / multiplier;

            setting.set(
                MathHelper.clamp(
                    value,
                    setting.min,
                    setting.max
                )
            );
        }
    }

    private double getSliderProgress(
        Setting<?> setting
    ) {
        if (setting instanceof IntSetting value) {
            if (
                value.sliderMax
                    == value.sliderMin
            ) {
                return 0;
            }

            return MathHelper.clamp(
                (
                    value.get()
                        - value.sliderMin
                )
                    / (double) (
                    value.sliderMax
                        - value.sliderMin
                ),
                0,
                1
            );
        }

        if (
            setting
                instanceof DoubleSetting value
        ) {
            if (
                value.sliderMax
                    == value.sliderMin
            ) {
                return 0;
            }

            return MathHelper.clamp(
                (
                    value.get()
                        - value.sliderMin
                )
                    / (
                    value.sliderMax
                        - value.sliderMin
                ),
                0,
                1
            );
        }

        return 0;
    }

    private String formatSettingValue(
        Setting<?> setting
    ) {
        Object value = setting.get();

        if (value instanceof Double number) {
            String format =
                "%."
                    + Math.min(
                    3,
                    ((DoubleSetting) setting)
                        .decimalPlaces
                )
                    + "f";

            return String.format(
                Locale.ROOT,
                format,
                number
            );
        }

        return String.valueOf(value);
    }

    @Override
    public boolean mouseDragged(
        double mouseX,
        double mouseY,
        int button,
        double deltaX,
        double deltaY
    ) {
        if (
            draggingPanel != null
                && button
                == GLFW.GLFW_MOUSE_BUTTON_LEFT
        ) {
            draggingPanel.x =
                (int) mouseX - dragOffsetX;

            draggingPanel.y =
                (int) mouseY - dragOffsetY;

            draggingPanel.x =
                MathHelper.clamp(
                    draggingPanel.x,
                    -PANEL_WIDTH + 20,
                    width - 20
                );

            draggingPanel.y =
                MathHelper.clamp(
                    draggingPanel.y,
                    0,
                    Math.max(
                        0,
                        height - HEADER_HEIGHT
                    )
                );

            return true;
        }

        if (
            draggedSlider != null
                && button
                == GLFW.GLFW_MOUSE_BUTTON_LEFT
        ) {
            updateSlider(
                draggedSlider,
                (int) mouseX
            );

            return true;
        }

        return super.mouseDragged(
            mouseX,
            mouseY,
            button,
            deltaX,
            deltaY
        );
    }

    @Override
    public boolean mouseReleased(
        double mouseX,
        double mouseY,
        int button
    ) {
        draggingPanel = null;
        draggedSlider = null;

        return super.mouseReleased(
            mouseX,
            mouseY,
            button
        );
    }

    @Override
    public boolean mouseScrolled(
        double mouseX,
        double mouseY,
        double horizontalAmount,
        double verticalAmount
    ) {
        for (CategoryPanel panel :
            panels.values()) {
            if (inside(
                mouseX,
                mouseY,
                panel.x,
                panel.y,
                PANEL_WIDTH,
                height - panel.y
            )) {
                panel.scroll +=
                    (float) verticalAmount * 18;

                if (panel.scroll > 0) {
                    panel.scroll = 0;
                }

                MorzhSoundManager.playScroll();
                return true;
            }
        }

        return super.mouseScrolled(
            mouseX,
            mouseY,
            horizontalAmount,
            verticalAmount
        );
    }

    @Override
    public boolean keyPressed(
        int keyCode,
        int scanCode,
        int modifiers
    ) {
        if (searchFocused) {
            if (
                keyCode == GLFW.GLFW_KEY_ENTER
                    || keyCode
                    == GLFW.GLFW_KEY_KP_ENTER
            ) {
                searchFocused = false;
                MorzhSoundManager.playKeyRelease();
                return true;
            }

            if (
                keyCode
                    == GLFW.GLFW_KEY_BACKSPACE
            ) {
                if (!search.isEmpty()) {
                    search = search.substring(
                        0,
                        search.length() - 1
                    );

                    resetPanelScroll();
                }

                MorzhSoundManager.playKeyRelease();
                return true;
            }

            if (
                keyCode
                    == GLFW.GLFW_KEY_DELETE
            ) {
                search = "";
                resetPanelScroll();
                MorzhSoundManager.playKeyRelease();
                return true;
            }

            if (
                keyCode
                    == GLFW.GLFW_KEY_ESCAPE
            ) {
                searchFocused = false;
                MorzhSoundManager.playKeyRelease();
                return true;
            }
        }

        if (
            keyCode
                == GLFW.GLFW_KEY_ESCAPE
        ) {
            MorzhSoundManager.playClose();

            if (client != null) {
                client.setScreen(null);
            }

            return true;
        }

        return super.keyPressed(
            keyCode,
            scanCode,
            modifiers
        );
    }

    @Override
    public boolean charTyped(
        char chr,
        int modifiers
    ) {
        if (
            searchFocused
                && !Character.isISOControl(chr)
                && search.length() < 40
        ) {
            search += chr;
            resetPanelScroll();
            MorzhSoundManager.playKeyPress();
            return true;
        }

        return super.charTyped(
            chr,
            modifiers
        );
    }

    private void resetPanelScroll() {
        for (CategoryPanel panel :
            panels.values()) {
            panel.scroll = 0;
        }
    }

    private void drawText(
        DrawContext context,
        String value,
        int x,
        int y,
        int color
    ) {
        context.drawTextWithShadow(
            textRenderer,
            value,
            x,
            y,
            color
        );
    }

    private void drawBorder(
        DrawContext context,
        int x,
        int y,
        int width,
        int height,
        int color
    ) {
        context.fill(
            x,
            y,
            x + width,
            y + 1,
            color
        );

        context.fill(
            x,
            y + height - 1,
            x + width,
            y + height,
            color
        );

        context.fill(
            x,
            y,
            x + 1,
            y + height,
            color
        );

        context.fill(
            x + width - 1,
            y,
            x + width,
            y + height,
            color
        );
    }

