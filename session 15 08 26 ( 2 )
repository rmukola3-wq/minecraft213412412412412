    private void updateNumberSetting(
        Setting<?> setting,
        double mouseX,
        int x,
        int rowWidth
    ) {
        double progress = MathHelper.clamp(
            (mouseX - x - 5) / Math.max(1, rowWidth - 10),
            0,
            1
        );

        if (setting instanceof IntSetting intSetting) {
            int minimum = intSetting.sliderMin;
            int maximum = intSetting.sliderMax;

            if (maximum <= minimum) {
                minimum = intSetting.min;
                maximum = intSetting.max;
            }

            int value = (int) Math.round(
                minimum + (maximum - minimum) * progress
            );

            intSetting.set(
                MathHelper.clamp(
                    value,
                    intSetting.min,
                    intSetting.max
                )
            );
        } else if (setting instanceof DoubleSetting doubleSetting) {
            double minimum = doubleSetting.sliderMin;
            double maximum = doubleSetting.sliderMax;

            if (!Double.isFinite(minimum)
                || !Double.isFinite(maximum)
                || maximum <= minimum) {
                minimum = doubleSetting.min;
                maximum = doubleSetting.max;
            }

            if (!Double.isFinite(minimum)
                || !Double.isFinite(maximum)
                || maximum <= minimum) {
                return;
            }

            double value =
                minimum + (maximum - minimum) * progress;

            double scale = Math.pow(
                10,
                Math.max(0, doubleSetting.decimalPlaces)
            );

            value = Math.round(value * scale) / scale;

            doubleSetting.set(
                MathHelper.clamp(
                    value,
                    doubleSetting.min,
                    doubleSetting.max
                )
            );
        }
    }

    @SuppressWarnings({
        "rawtypes",
        "unchecked"
    })
    private void cycleEnum(
        Setting<?> setting,
        int direction
    ) {
        Object current = setting.get();

        if (!(current instanceof Enum<?> currentEnum)) {
            return;
        }

        Object[] values =
            currentEnum
                .getDeclaringClass()
                .getEnumConstants();

        if (values == null || values.length == 0) return;

        int index = currentEnum.ordinal();

        index = Math.floorMod(
            index + direction,
            values.length
        );

        ((Setting) setting).set(values[index]);
    }

    private String formatValue(Setting<?> setting) {
        Object value = setting.get();

        if (value == null) return "null";

        String text = value.toString();

        return shorten(text, 10);
    }

    private boolean hasModules(Category category) {
        for (Module module : Modules.get().getGroup(category)) {
            if (!Config.get().hiddenModules.get().contains(module)) {
                return true;
            }
        }

        return false;
    }

    private boolean hasVisibleSettings(Module module) {
        for (SettingGroup group : module.settings) {
            for (Setting<?> setting : group) {
                if (setting.isVisible()) return true;
            }
        }

        return false;
    }

