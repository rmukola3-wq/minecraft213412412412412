package meteordevelopment.meteorclient.gui.screens.morzh;

import meteordevelopment.meteorclient.settings.*;
import meteordevelopment.meteorclient.systems.config.Config;
import meteordevelopment.meteorclient.systems.modules.Category;
import meteordevelopment.meteorclient.systems.modules.Module;
import meteordevelopment.meteorclient.systems.modules.Modules;
import meteordevelopment.meteorclient.utils.sound.MorzhSoundManager;
import net.minecraft.client.gui.DrawContext;
import net.minecraft.client.gui.screen.Screen;
import net.minecraft.text.Text;
import net.minecraft.util.math.MathHelper;
import org.lwjgl.glfw.GLFW;

import java.util.*;

public class MorzhThunderScreen extends Screen {
    private static final int PANEL_WIDTH = 104;
    private static final int HEADER_HEIGHT = 18;
    private static final int MODULE_HEIGHT = 17;
    private static final int SETTING_HEIGHT = 17;
    private static final int PANEL_GAP = 6;

    private static final int BACKGROUND = 0xA8000000;
    private static final int PANEL = 0xF0141414;
    private static final int HEADER_TOP = 0xFF9657D6;
    private static final int HEADER_BOTTOM = 0xFF60358E;
    private static final int MODULE = 0xE81C1C1C;
    private static final int MODULE_HOVER = 0xF02A2A2A;
    private static final int SETTING = 0xF0171717;
    private static final int SETTING_HOVER = 0xF0242424;
    private static final int ACCENT = 0xFF9A5CE0;
    private static final int ACTIVE = 0xFF7EDC98;
    private static final int TEXT = 0xFFF2EDF7;
    private static final int TEXT_SECONDARY = 0xFFAAA1B0;
    private static final int OUTLINE = 0xFF090909;
    private static final int SLIDER_BACKGROUND = 0xFF28232D;

    private final List<PanelState> panels = new ArrayList<>();
    private final List<Hitbox> hitboxes = new ArrayList<>();
    private final Set<Module> expandedModules =
        Collections.newSetFromMap(new IdentityHashMap<>());

    private PanelState draggedPanel;
    private int dragOffsetX;
    private int dragOffsetY;

    private Hitbox draggedSlider;

    private float openAnimation;
    private long lastFrameNanos;

    public MorzhThunderScreen() {
        super(Text.literal("Morzh Rockstar"));
    }

    @Override
    protected void init() {
        panels.clear();
        hitboxes.clear();

        int x = 6;
        int y = 18;

        for (Category category : Modules.loopCategories()) {
            if (!hasModules(category)) continue;

            panels.add(new PanelState(category, x, y));
            x += PANEL_WIDTH + PANEL_GAP;
        }

        openAnimation = 0;
        lastFrameNanos = System.nanoTime();

        MorzhSoundManager.playOpen();
    }

    @Override
    public boolean shouldPause() {
        return false;
    }

    @Override
    public void render(
        DrawContext context,
        int mouseX,
        int mouseY,
        float delta
    ) {
        updateAnimation();

        if (draggedPanel != null) {
            draggedPanel.x = MathHelper.clamp(
                mouseX - dragOffsetX,
                0,
                Math.max(0, width - PANEL_WIDTH)
            );

            draggedPanel.y = MathHelper.clamp(
                mouseY - dragOffsetY,
                0,
                Math.max(0, height - HEADER_HEIGHT)
            );
        }

        if (draggedSlider != null) {
            updateNumberSetting(
                draggedSlider.setting,
                mouseX,
                draggedSlider.x,
                draggedSlider.width
            );
        }

        int dimAlpha = Math.round(168 * openAnimation);

        context.fill(
            0,
            0,
            width,
            height,
            dimAlpha << 24
        );

        hitboxes.clear();

        for (PanelState panel : panels) {
            renderPanel(context, panel, mouseX, mouseY);
        }

        renderTooltip(context, mouseX, mouseY);

        super.render(context, mouseX, mouseY, delta);
    }

    private void renderPanel(
        DrawContext context,
        PanelState panel,
        int mouseX,
        int mouseY
    ) {
        int x = panel.x;
        int y = panel.y;

        boolean headerHovered = inside(
            mouseX,
            mouseY,
            x,
            y,
            PANEL_WIDTH,
            HEADER_HEIGHT
        );

        drawBorder(
            context,
            x,
            y,
            PANEL_WIDTH,
            HEADER_HEIGHT,
            OUTLINE
        );

        drawVerticalGradient(
            context,
            x + 1,
            y + 1,
            PANEL_WIDTH - 2,
            HEADER_HEIGHT - 2,
            headerHovered ? 0xFFAC73E5 : HEADER_TOP,
            headerHovered ? 0xFF7347A2 : HEADER_BOTTOM
        );

        drawText(
            context,
            panel.category.name,
            x + 6,
            y + 5,
            TEXT,
            true
        );

        String marker = panel.open ? "-" : "+";

        drawText(
            context,
            marker,
            x + PANEL_WIDTH - 11,
            y + 5,
            TEXT,
            true
        );

        hitboxes.add(
            new Hitbox(
                HitboxType.Header,
                panel,
                null,
                null,
                x,
                y,
                PANEL_WIDTH,
                HEADER_HEIGHT
            )
        );

        if (!panel.open) return;

        int bodyY = y + HEADER_HEIGHT;
        int bodyHeight = Math.max(
            20,
            Math.min(
                330,
                height - bodyY - 6
            )
        );

        drawBorder(
            context,
            x,
            bodyY,
            PANEL_WIDTH,
            bodyHeight,
            OUTLINE
        );

        context.fill(
            x + 1,
            bodyY,
            x + PANEL_WIDTH - 1,
            bodyY + bodyHeight - 1,
            PANEL
        );

        context.enableScissor(
            x + 1,
            bodyY + 1,
            x + PANEL_WIDTH - 1,
            bodyY + bodyHeight - 1
        );

        int contentY = bodyY + 1 + Math.round(panel.scroll);
        int contentHeight = 0;

        for (Module module : Modules.get().getGroup(panel.category)) {
            if (Config.get().hiddenModules.get().contains(module)) {
                continue;
            }

            int moduleY = contentY + contentHeight;

            renderModule(
                context,
                panel,
                module,
                x + 1,
                moduleY,
                PANEL_WIDTH - 2,
                mouseX,
                mouseY,
                bodyY,
                bodyHeight
            );

            contentHeight += MODULE_HEIGHT;

            if (expandedModules.contains(module)) {
                contentHeight += renderSettings(
                    context,
                    panel,
                    module,
                    x + 1,
                    contentY + contentHeight,
                    PANEL_WIDTH - 2,
                    mouseX,
                    mouseY,
                    bodyY,
                    bodyHeight
                );
            }
        }

        context.disableScissor();

        panel.contentHeight = contentHeight;

        float minimumScroll = Math.min(
            0,
            bodyHeight - contentHeight - 2
        );

        panel.scroll = MathHelper.clamp(
            panel.scroll,
            minimumScroll,
            0
        );

        panel.bodyY = bodyY;
        panel.bodyHeight = bodyHeight;
    }

    private void renderModule(
        DrawContext context,
        PanelState panel,
        Module module,
        int x,
        int y,
        int rowWidth,
        int mouseX,
        int mouseY,
        int bodyY,
        int bodyHeight
    ) {
        boolean visible =
            y + MODULE_HEIGHT >= bodyY
                && y <= bodyY + bodyHeight;

        if (!visible) return;

        boolean hovered = inside(
            mouseX,
            mouseY,
            x,
            y,
            rowWidth,
            MODULE_HEIGHT
        );

        int color = hovered ? MODULE_HOVER : MODULE;

        context.fill(
            x,
            y,
            x + rowWidth,
            y + MODULE_HEIGHT,
            color
        );

        context.fill(
            x,
            y + MODULE_HEIGHT - 1,
            x + rowWidth,
            y + MODULE_HEIGHT,
            OUTLINE
        );

        if (module.isActive()) {
            context.fill(
                x,
                y,
                x + 2,
                y + MODULE_HEIGHT,
                ACTIVE
            );
        }

        int textColor =
            module.isActive() ? ACTIVE : TEXT_SECONDARY;

        drawText(
            context,
            shorten(module.title, 14),
            x + 5,
            y + 5,
            textColor,
            false
        );

        if (hasVisibleSettings(module)) {
            String arrow =
                expandedModules.contains(module) ? "<" : ">";

            drawText(
                context,
                arrow,
                x + rowWidth - 11,
                y + 5,
                TEXT_SECONDARY,
                false
            );
        }

        hitboxes.add(
            new Hitbox(
                HitboxType.Module,
                panel,
                module,
                null,
                x,
                y,
                rowWidth,
                MODULE_HEIGHT
            )
        );
    }

    private int renderSettings(
        DrawContext context,
        PanelState panel,
        Module module,
        int x,
        int startY,
        int rowWidth,
        int mouseX,
        int mouseY,
        int bodyY,
        int bodyHeight
    ) {
        int offset = 0;

        for (SettingGroup group : module.settings) {
            for (Setting<?> setting : group) {
                if (!setting.isVisible()) continue;

                int settingY = startY + offset;

                renderSetting(
                    context,
                    panel,
                    module,
                    setting,
                    x,
                    settingY,
                    rowWidth,
                    mouseX,
                    mouseY,
                    bodyY,
                    bodyHeight
                );

                offset += SETTING_HEIGHT;
            }
        }

        return offset;
    }

    private void renderSetting(
        DrawContext context,
        PanelState panel,
        Module module,
        Setting<?> setting,
        int x,
        int y,
        int rowWidth,
        int mouseX,
        int mouseY,
        int bodyY,
        int bodyHeight
    ) {
        boolean visible =
            y + SETTING_HEIGHT >= bodyY
                && y <= bodyY + bodyHeight;

        if (!visible) return;

        boolean hovered = inside(
            mouseX,
            mouseY,
            x,
            y,
            rowWidth,
            SETTING_HEIGHT
        );

        context.fill(
            x,
            y,
            x + rowWidth,
            y + SETTING_HEIGHT,
            hovered ? SETTING_HOVER : SETTING
        );

        context.fill(
            x + 2,
            y,
            x + 3,
            y + SETTING_HEIGHT,
            0xFF58336E
        );

        drawText(
            context,
            shorten(setting.title, 10),
            x + 6,
            y + 4,
            TEXT_SECONDARY,
            false
        );

        if (setting instanceof BoolSetting boolSetting) {
            boolean enabled = boolSetting.get();

            int switchX = x + rowWidth - 22;
            int switchY = y + 5;

            context.fill(
                switchX,
                switchY,
                switchX + 16,
                switchY + 7,
                enabled ? 0xFF5C9B6E : 0xFF343434
            );

            int handleX =
                enabled ? switchX + 10 : switchX + 2;

            context.fill(
                handleX,
                switchY + 1,
                handleX + 5,
                switchY + 6,
                enabled ? ACTIVE : 0xFF8A8A8A
            );
        } else if (setting instanceof IntSetting intSetting) {
            renderNumberSetting(
                context,
                x,
                y,
                rowWidth,
                intSetting.get(),
                intSetting.sliderMin,
                intSetting.sliderMax
            );
        } else if (setting instanceof DoubleSetting doubleSetting) {
            renderNumberSetting(
                context,
                x,
                y,
                rowWidth,
                doubleSetting.get(),
                doubleSetting.sliderMin,
                doubleSetting.sliderMax
            );
        } else {
            String value = formatValue(setting);

            int valueWidth =
                client.textRenderer.getWidth(value);

            drawText(
                context,
                value,
                x + rowWidth - valueWidth - 6,
                y + 4,
                ACCENT,
                false
            );
        }

        hitboxes.add(
            new Hitbox(
                HitboxType.Setting,
                panel,
                module,
                setting,
                x,
                y,
                rowWidth,
                SETTING_HEIGHT
            )
        );
