        }
    }

    private void drawText(
        DrawContext context,
        String text,
        int x,
        int y,
        int color,
        boolean shadow
    ) {
        if (client == null || text == null) return;

        if (shadow) {
            context.drawTextWithShadow(
                client.textRenderer,
                text,
                x,
                y,
                color
            );
        } else {
            context.drawText(
                client.textRenderer,
                text,
                x,
                y,
                color,
                false
            );
        }
    }

    private void drawBorder(
        DrawContext context,
        int x,
        int y,
        int drawWidth,
        int drawHeight,
        int color
    ) {
        context.fill(
            x,
            y,
            x + drawWidth,
            y + 1,
            color
        );

        context.fill(
            x,
            y + drawHeight - 1,
            x + drawWidth,
            y + drawHeight,
            color
        );

        context.fill(
            x,
            y,
            x + 1,
            y + drawHeight,
            color
        );

        context.fill(
            x + drawWidth - 1,
            y,
            x + drawWidth,
            y + drawHeight,
            color
        );
    }

    private void drawVerticalGradient(
        DrawContext context,
        int x,
        int y,
        int drawWidth,
        int drawHeight,
        int topColor,
        int bottomColor
    ) {
        int half = Math.max(1, drawHeight / 2);

        context.fill(
            x,
            y,
            x + drawWidth,
            y + half,
            topColor
        );

        context.fill(
            x,
            y + half,
            x + drawWidth,
            y + drawHeight,
            bottomColor
        );
    }

    private void updateAnimation() {
        long now = System.nanoTime();

        float delta =
            lastFrameNanos == 0
                ? 1.0f / 60.0f
                : (now - lastFrameNanos)
                / 1_000_000_000.0f;

        lastFrameNanos = now;

        delta = MathHelper.clamp(
            delta,
            0,
            0.05f
        );

        float factor =
            1.0f - (float) Math.exp(-14.0f * delta);

        openAnimation +=
            (1.0f - openAnimation) * factor;

        if (openAnimation > 0.999f) {
            openAnimation = 1.0f;
        }
    }

    private static boolean inside(
        double mouseX,
        double mouseY,
        double x,
        double y,
        double targetWidth,
        double targetHeight
    ) {
        return mouseX >= x
            && mouseX <= x + targetWidth
            && mouseY >= y
            && mouseY <= y + targetHeight;
    }

    private static String shorten(
        String text,
        int maximumLength
    ) {
        if (text == null) return "";

        if (text.length() <= maximumLength) {
            return text;
        }

        if (maximumLength <= 3) {
            return text.substring(0, maximumLength);
        }

        return text.substring(
            0,
            maximumLength - 3
        ) + "...";
    }

    private enum HitboxType {
        Header,
        Module,
        Setting
    }

    private static final class PanelState {
        private final Category category;

        private int x;
        private int y;

        private boolean open = true;

        private float scroll;

        private int bodyY;
        private int bodyHeight;
        private int contentHeight;

        private PanelState(
            Category category,
            int x,
            int y
        ) {
            this.category = category;
            this.x = x;
            this.y = y;
        }
    }

    private static final class Hitbox {
        private final HitboxType type;
        private final PanelState panel;
        private final Module module;
        private final Setting<?> setting;

        private final int x;
        private final int y;
        private final int width;
        private final int height;

        private Hitbox(
            HitboxType type,
            PanelState panel,
            Module module,
            Setting<?> setting,
            int x,
            int y,
            int width,
            int height
        ) {
            this.type = type;
            this.panel = panel;
            this.module = module;
            this.setting = setting;
            this.x = x;
            this.y = y;
            this.width = width;
            this.height = height;
        }

        private boolean contains(
            double mouseX,
            double mouseY
        ) {
            return inside(
                mouseX,
                mouseY,
                x,
                y,
                width,
                height
            );
        }
    }
