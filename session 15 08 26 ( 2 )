    @EventHandler
    private void onRender(Render3DEvent event) {
        if (!render.get() || mc.player == null || mc.world == null) return;

        LivingEntity target = getTarget();
        if (target == null) return;

        Vec3d center = predictTarget(target);
        double radius = getRadius();

        if (getOrbit() == OrbitMode.Cube) {
            Vec3d[] points = cubePoints(center, radius);

            for (int i = 0; i < 4; i++) {
                Vec3d first = points[i];
                Vec3d second = points[(i + 1) % 4];

                event.renderer.line(
                    first.x, target.getY() + 0.05, first.z,
                    second.x, target.getY() + 0.05, second.z,
                    renderColor
                );
            }

            return;
        }

        if (getOrbit() == OrbitMode.Center) return;

        int points = renderPoints.get();
        double y = target.getY() + 0.05;

        double lastX = center.x + radius;
        double lastZ = center.z;

        for (int i = 1; i <= points; i++) {
            double angle = Math.PI * 2.0 * i / points;
            double x = center.x + Math.cos(angle) * radius;
            double z = center.z + Math.sin(angle) * radius;

            event.renderer.line(
                lastX, y, lastZ,
                x, y, z,
                renderColor
            );

            lastX = x;
            lastZ = z;
        }
    }

    private Point calculatePoint(
        Vec3d target,
        double radius,
        double speed,
        OrbitMode orbit
    ) {
        if (orbit == OrbitMode.Center) {
            return new Point(target.x, target.z);
        }

        if (orbit == OrbitMode.Cube) {
            Vec3d[] points = cubePoints(target, radius);
            Vec3d current = points[cubePoint];

            if (mc.player.getPos().squaredDistanceTo(current) <= pointReach.get() * pointReach.get()) {
                cubePoint += clockwise ? 1 : -1;

                if (cubePoint < 0) cubePoint = 3;
                if (cubePoint > 3) cubePoint = 0;

                current = points[cubePoint];
            }

            return new Point(current.x, current.z);
        }

        double differenceX = mc.player.getX() - target.x;
        double differenceZ = mc.player.getZ() - target.z;
        double currentDistance = Math.max(0.001, Math.hypot(differenceX, differenceZ));

        double angle = Math.atan2(differenceZ, differenceX);
        double correction = profile.get() == Profile.Custom ? radialCorrection.get() : 1.0;

        double distanceError = (currentDistance - radius) / Math.max(radius, 0.1);
        double angleStep = speed / currentDistance;

        angle += clockwise ? angleStep : -angleStep;
        angle += (clockwise ? 1 : -1) * MathHelper.clamp(distanceError * 0.08 * correction, -0.12, 0.12);

        return new Point(
            target.x + radius * Math.cos(angle),
            target.z + radius * Math.sin(angle)
        );
    }

    private Vec3d[] cubePoints(Vec3d target, double radius) {
        return new Vec3d[] {
            new Vec3d(target.x - radius, mc.player.getY(), target.z - radius),
            new Vec3d(target.x - radius, mc.player.getY(), target.z + radius),
            new Vec3d(target.x + radius, mc.player.getY(), target.z + radius),
            new Vec3d(target.x + radius, mc.player.getY(), target.z - radius)
        };
    }

    private double getMovementSpeed(PlayerMoveEvent event, Engine engine) {
        if (engine == Engine.Fixed) return getConfiguredSpeed();

        if (engine == Engine.Grim) {
            double current = Math.hypot(event.movement.x, event.movement.z);
            double maximum = getConfiguredSpeed();

            if (current < 0.08) current = 0.08;

            return Math.min(
                maximum,
                current + 0.018
            );
        }

        BlockPos position = BlockPos.ofFloored(
            mc.player.getX(),
            mc.player.getBoundingBox().minY - event.movement.y,
            mc.player.getZ()
        );

        float groundFriction = mc.world
            .getBlockState(position)
            .getBlock()
            .getSlipperiness() * 0.91f;

        float friction = mc.player.isOnGround()
            ? groundFriction
            : mc.player.isUsingItem() && oldSpeed > 0.32
                ? 0.88f
                : 0.91f;

        double acceleration;

        if (mc.player.isOnGround()) {
            acceleration = mc.player.getMovementSpeed()
                * 1.3
                * (0.1631 / Math.pow(friction, 3.0));

            if (event.movement.y > 0) {
                acceleration += getGroundAcceleration();
            }
        } else {
            acceleration = getAirAcceleration();
        }

        contextFriction = friction;

        double result = oldSpeed + acceleration;
        result = Math.max(getConfiguredSpeed(), result);
        result -= mc.player.age % 2 == 0 ? 0.001 : 0.002;

        return Math.max(getConfiguredSpeed(), result);
    }

    private Vec3d predictTarget(LivingEntity target) {
        double prediction = getPrediction();

        return new Vec3d(
            target.getX() + (target.getX() - target.prevX) * prediction,
            target.getY() + (target.getY() - target.prevY) * prediction,
            target.getZ() + (target.getZ() - target.prevZ) * prediction
        );
    }

    private boolean shouldSwitch(double x, double z) {
        if (switchTimer > 0) return false;

        if (collisionSwitch.get() && mc.player.horizontalCollision) {
            return true;
        }

        return voidCheck.get() && dangerousPoint(x, z);
    }

    private boolean dangerousPoint(double x, double z) {
        int startY = MathHelper.floor(mc.player.getY() + 3);
        int minimumY = groundScanDepth.get() == 0
            ? mc.world.getBottomY()
            : Math.max(mc.world.getBottomY(), startY - groundScanDepth.get());

        BlockPos.Mutable position = new BlockPos.Mutable();

        for (int y = startY; y >= minimumY; y--) {
            position.set(
                MathHelper.floor(x),
                y,
                MathHelper.floor(z)
            );

            BlockState state = mc.world.getBlockState(position);
            Block block = state.getBlock();

            if (
                avoidHazards.get()
                    && (
                    block == Blocks.LAVA
                        || block == Blocks.FIRE
                        || block == Blocks.SOUL_FIRE
                )
            ) {
                return true;
            }

            if (!state.isAir()) return false;
        }

        return true;
    }

    private LivingEntity getTarget() {
        KillAura aura = Modules.get().get(KillAura.class);

        if (aura == null || !aura.isActive()) return null;

        Entity target = aura.getTarget();

        if (
            target instanceof LivingEntity living
                && living.isAlive()
                && living != mc.player
        ) {
            return living;
        }

        return null;
    }

    private boolean canStrafe() {
        if (pauseSneaking.get() && mc.player.isSneaking()) return false;

        if (
            pauseLiquids.get()
                && (
                mc.player.isSubmergedInWater()
                    || mc.player.isInLava()
                    || waterTicks > 0
            )
        ) {
            return false;
        }

        if (mc.player.getAbilities().flying) return false;
        if (pauseSpeed.get() && Modules.get().isActive(Speed.class)) return false;

        return !pauseScaffold.get() || !Modules.get().isActive(Scaffold.class);
    }

    private boolean hasRequiredInput() {
        if (!onlyOnInput.get()) return true;

        return mc.options.forwardKey.isPressed()
            || mc.options.backKey.isPressed()
            || mc.options.leftKey.isPressed()
            || mc.options.rightKey.isPressed();
    }

    private void changeDirection() {
        if (switchTimer > 0) return;

        clockwise = !clockwise;
        switchTimer = switchCooldown.get();

        if (getOrbit() == OrbitMode.Cube) {
            cubePoint += clockwise ? 1 : -1;

            if (cubePoint < 0) cubePoint = 3;
            if (cubePoint > 3) cubePoint = 0;
        }
    }

    private double yawTo(double x, double z) {
        return Math.toDegrees(
            Math.atan2(
                z - mc.player.getZ(),
                x - mc.player.getX()
            )
        ) - 90.0;
    }

