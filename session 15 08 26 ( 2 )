    private boolean clockwise;
    private boolean wasColliding;

    private int switchTimer;
    private int waterTicks;
    private int cubePoint;

    private double oldSpeed;
    private float contextFriction = 0.91f;

    public TargetStrafe() {
        super(
            Categories.Movement,
            "target-strafe",
            "Advanced Thunder, Matrix, Grim and Rockstar target strafing."
        );
    }

    @Override
    public void onActivate() {
        clockwise = directionMode.get() != DirectionMode.CounterClockwise;
        cubePoint = 0;
        switchTimer = 0;
        waterTicks = 0;
        oldSpeed = 0;
        contextFriction = 0.91f;
        wasColliding = false;
    }

    @Override
    public void onDeactivate() {
        oldSpeed = 0;
    }

    @Override
    public String getInfoString() {
        return profile.get().name();
    }

    @EventHandler
    private void onTick(TickEvent.Pre event) {
        if (mc.player == null || mc.world == null) return;

        if (switchTimer > 0) switchTimer--;

        if (mc.player.isSubmergedInWater()) waterTicks = 10;
        else if (waterTicks > 0) waterTicks--;

        double movedX = mc.player.getX() - mc.player.prevX;
        double movedZ = mc.player.getZ() - mc.player.prevZ;
        oldSpeed = Math.hypot(movedX, movedZ) * contextFriction;

        if (directionMode.get() == DirectionMode.Manual) {
            if (mc.options.leftKey.isPressed()) clockwise = false;
            else if (mc.options.rightKey.isPressed()) clockwise = true;
        } else if (directionMode.get() == DirectionMode.Clockwise) {
            clockwise = true;
        } else if (directionMode.get() == DirectionMode.CounterClockwise) {
            clockwise = false;
        } else if (directionMode.get() == DirectionMode.Random && mc.player.age % 80 == 0) {
            clockwise = !clockwise;
        }

        boolean collision = mc.player.horizontalCollision;

        if (collisionSwitch.get() && collision && !wasColliding) {
            changeDirection();
        }

        wasColliding = collision;

        LivingEntity target = getTarget();

        if (target == null || !canStrafe() || !hasRequiredInput()) return;

        if (sprint.get()) mc.player.setSprinting(true);

        if (autoJump.get() && mc.player.isOnGround()) {
            mc.player.jump();
        }
    }

    @EventHandler(priority = EventPriority.LOWEST - 100)
    private void onMove(PlayerMoveEvent event) {
        if (mc.player == null || mc.world == null || event.type != MovementType.SELF) return;

        LivingEntity target = getTarget();

        if (target == null || !canStrafe() || !hasRequiredInput()) {
            oldSpeed = 0;
            return;
        }

        Engine engine = getEngine();
        OrbitMode orbit = getOrbit();
        double radius = getRadius();

        Vec3d targetPosition = predictTarget(target);
        double movementSpeed = getMovementSpeed(event, engine);

        if (hurtBoost.get() && mc.player.hurtTime > 0) {
            movementSpeed += hurtBoostAmount.get();
        }

        movementSpeed = MathHelper.clamp(movementSpeed, 0.01, 2.0);

        Point point = calculatePoint(
            targetPosition,
            radius,
            movementSpeed,
            orbit
        );

        if (shouldSwitch(point.x, point.z)) {
            changeDirection();

            point = calculatePoint(
                targetPosition,
                radius,
                movementSpeed,
                orbit
            );
        }

        double yaw = yawTo(point.x, point.z);

        if (engine == Engine.Grim && grimEightDirections.get()) {
            double relative = MathHelper.wrapDegrees(yaw - mc.player.getYaw());
            relative = Math.round(relative / 45.0) * 45.0;
            yaw = mc.player.getYaw() + relative;
        }

        double wantedX = -Math.sin(Math.toRadians(yaw)) * movementSpeed;
        double wantedZ = Math.cos(Math.toRadians(yaw)) * movementSpeed;

        double smoothing = getSmoothing();

        if (smoothing > 0) {
            wantedX = MathHelper.lerp(
                smoothing,
                wantedX,
                event.movement.x
            );

            wantedZ = MathHelper.lerp(
                smoothing,
                wantedZ,
                event.movement.z
            );
        }

        ((IVec3d) event.movement).meteor$setXZ(wantedX, wantedZ);
    }

    @EventHandler
    private void onPacketReceive(PacketEvent.Receive event) {
