package meteordevelopment.meteorclient.systems.modules.combat.aura;

import net.minecraft.client.network.ClientPlayerEntity;
import net.minecraft.entity.effect.StatusEffects;
import net.minecraft.network.packet.c2s.play.ClientCommandC2SPacket;

public final class AuraCriticalController {
    private static final int MAX_CRITICAL_CYCLE_TICKS = 20;

    private State state = State.Ground;

    private int cycleTicks;
    private int restoreSprintTicks;

    private boolean restoreSprint;

    public Decision update(
        ClientPlayerEntity player,
        Mode mode,
        boolean cooldownReady,
        float cooldownProgress,
        boolean autoJump,
        double jumpAtProgress,
        double minimumFallDistance
    ) {
        updateSprintRestore(player);

        if (mode == Mode.Off) {
            resetCycle();

            return cooldownReady
                ? Decision.NormalAttack
                : Decision.Wait;
        }

        if (!canAttemptCritical(player)) {
            resetCycle();

            return mode == Mode.Smart
                && cooldownReady
                ? Decision.NormalAttack
                : Decision.Wait;
        }

        /*
         * Без AutoJump Smart работает как Thunder:
         * если игрок сам не находится в критическом
         * окне, выполняется обычный удар.
         */
        if (!autoJump) {
            if (
                isCriticalWindow(
                    player,
                    minimumFallDistance
                )
                && cooldownReady
            ) {
                state = State.CriticalWindow;
                return Decision.CriticalAttack;
            }

            return mode == Mode.Smart
                && cooldownReady
                ? Decision.NormalAttack
                : Decision.Wait;
        }

        if (state != State.Ground) {
            cycleTicks++;
        }

        /*
         * Основная проверка взята из Thunder:
         * fallDistance уже означает, что игрок начал
         * опускаться. Отдельная проверка velocity.y
         * здесь только сужала рабочее окно.
         */
        if (
            isCriticalWindow(
                player,
                minimumFallDistance
            )
        ) {
            state = State.CriticalWindow;

            if (cooldownReady) {
                return Decision.CriticalAttack;
            }
        }

        if (player.isOnGround()) {
            boolean previousCycleMissed =
                state == State.WaitingFall
                    || state == State.CriticalWindow
                    || state == State.MissedWindow
                    || state == State.Recovery;

            state = State.Ground;
            cycleTicks = 0;

            /*
             * После сорванного окна cooldown обычно
             * уже полностью готов. Новый прыжок
             * запускается сразу после приземления.
             */
            if (
                cooldownProgress
                    >= jumpAtProgress
            ) {
                stopSprinting(player);
                player.jump();

                state = State.WaitingFall;
                cycleTicks = 0;

                return Decision.Wait;
            }

            /*
             * До точки начала прыжка просто ждём.
             * Обычный удар здесь не выполняется,
             * иначе он съест будущий крит.
             */
            if (previousCycleMissed) {
                return Decision.Wait;
            }

            return Decision.Wait;
        }

        /*
         * Если игрок уже слишком долго находится
         * в цикле, окно считается сорванным.
         */
        if (
            cycleTicks
                >= MAX_CRITICAL_CYCLE_TICKS
        ) {
            state = State.MissedWindow;

            /*
             * Smart обязан продолжать атаковать даже
             * при нестандартной физике сервера.
             * OnlyCriticals дождётся приземления и
             * запустит новый прыжок.
             */
            if (
                mode == Mode.Smart
                    && cooldownReady
            ) {
                return Decision.NormalAttack;
            }

            return Decision.Wait;
        }

        /*
         * Игрок падает, но cooldown не успел.
         * Помечаем окно пропущенным и ждём землю.
         */
        if (
            player.fallDistance
                > minimumFallDistance + 1.0
            && !cooldownReady
        ) {
            state = State.MissedWindow;
        }

        return Decision.Wait;
    }

    public void beforeAttack(
        ClientPlayerEntity player,
        Decision decision
    ) {
        /*
         * Сервер не должен видеть sprint=true
         * в момент критического attack-пакета.
         */
        if (
            decision == Decision.CriticalAttack
                || player.isSprinting()
        ) {
            stopSprinting(player);
        }
    }

    public void afterAttack(
        ClientPlayerEntity player
    ) {
        state = State.Recovery;
        cycleTicks = 0;

        if (restoreSprint) {
            /*
             * Восстановление откладывается, чтобы
             * START_SPRINTING не оказался рядом
             * с attack-пакетом в одном тике.
             */
            restoreSprintTicks = 2;
        }
    }

    public void reset(
        ClientPlayerEntity player
    ) {
        resetCycle();

        if (
            player != null
                && restoreSprint
        ) {
            startSprinting(player);
        }

        restoreSprint = false;
        restoreSprintTicks = 0;
    }

    public boolean isControllingJump(
        Mode mode
    ) {
        return mode != Mode.Off;
    }

    public boolean shouldSuppressSprint(
        Mode mode
    ) {
        if (mode == Mode.Off) {
            return false;
        }

        return state == State.WaitingFall
            || state == State.CriticalWindow
            || state == State.MissedWindow;
    }

    public boolean isWaitingForCritical() {
        return state == State.WaitingFall
            || state == State.CriticalWindow
            || state == State.MissedWindow;
    }

    public State getState() {
        return state;
    }

    private boolean isCriticalWindow(
        ClientPlayerEntity player,
        double minimumFallDistance
    ) {
        return !player.isOnGround()
            && player.fallDistance
                > minimumFallDistance
            && !player.isClimbing()
            && !player.isTouchingWater()
            && !player.isSubmergedInWater()
            && !player.isInLava()
            && !player.hasVehicle()
            && !player.getAbilities().flying
            && !player.isGliding()
            && !player.hasStatusEffect(
                StatusEffects.BLINDNESS
            )
            && !player.hasStatusEffect(
                StatusEffects.LEVITATION
            )
            && !player.hasStatusEffect(
                StatusEffects.SLOW_FALLING
            );
    }

    private boolean canAttemptCritical(
        ClientPlayerEntity player
    ) {
        return !player.isClimbing()
            && !player.isTouchingWater()
            && !player.isSubmergedInWater()
            && !player.isInLava()
            && !player.hasVehicle()
            && !player.getAbilities().flying
            && !player.isGliding()
            && !player.hasStatusEffect(
                StatusEffects.BLINDNESS
            )
            && !player.hasStatusEffect(
                StatusEffects.LEVITATION
            )
            && !player.hasStatusEffect(
                StatusEffects.SLOW_FALLING
            );
    }

    private void stopSprinting(
        ClientPlayerEntity player
    ) {
        if (player.isSprinting()) {
            restoreSprint = true;
        }

        player.setSprinting(false);

        if (player.networkHandler != null) {
            player.networkHandler.sendPacket(
                new ClientCommandC2SPacket(
                    player,
                    ClientCommandC2SPacket.Mode
                        .STOP_SPRINTING
                )
            );
        }
    }

    private void updateSprintRestore(
        ClientPlayerEntity player
    ) {
        if (restoreSprintTicks <= 0) {
            return;
        }

        restoreSprintTicks--;

        if (
            restoreSprintTicks == 0
                && restoreSprint
                && !isWaitingForCritical()
        ) {
            startSprinting(player);
            restoreSprint = false;
        }
    }

    private void startSprinting(
        ClientPlayerEntity player
    ) {
        player.setSprinting(true);

        if (player.networkHandler != null) {
            player.networkHandler.sendPacket(
                new ClientCommandC2SPacket(
                    player,
                    ClientCommandC2SPacket.Mode
                        .START_SPRINTING
                )
            );
        }
    }

    private void resetCycle() {
        state = State.Ground;
        cycleTicks = 0;
    }

    public enum Mode {
        Off,
        Smart,
        OnlyCriticals
    }

    public enum Decision {
        Wait,
        NormalAttack,
        CriticalAttack
    }

    public enum State {
        Ground,
        WaitingFall,
        CriticalWindow,
        MissedWindow,
        Recovery
    }
}


