                .build()
        );

    private final Setting<Double> hurtBoostAmount =
        sgGeneral.add(
            new DoubleSetting.Builder()
                .name("hurt-boost-amount")
                .description(
                    "Additional speed while hurt."
                )
                .defaultValue(0.12)
                .range(0.0, 1.0)
                .sliderRange(0.0, 0.5)
                .decimalPlaces(3)
                .visible(hurtBoost::get)
                .build()
        );

    private final Setting<Boolean> collisionSwitch =
        sgSafety.add(
            new BoolSetting.Builder()
                .name("collision-switch")
                .description(
                    "Changes direction after hitting a wall."
                )
                .defaultValue(true)
                .build()
        );

    private final Setting<Boolean> edgeCheck =
        sgSafety.add(
            new BoolSetting.Builder()
                .name("edge-check")
                .description(
                    "Changes direction before moving over a dangerous edge."
                )
                .defaultValue(true)
                .build()
        );

    private final Setting<Integer> edgeDepth =
        sgSafety.add(
            new IntSetting.Builder()
                .name("edge-depth")
                .description(
                    "Maximum number of blocks checked below the projected position."
                )
                .defaultValue(5)
                .range(1, 20)
                .sliderRange(1, 12)
                .visible(edgeCheck::get)
