public final class AuraCriticalController {
    private static final int SMART_TIMEOUT_TICKS = 12;

    private State state = State.Ground;

    private int cycleTicks;
    private int missedCycles;
    private int restoreSprintTicks;

    private boolean restoreSprint;

    public Decision update(
        ClientPlayerEntity player,
        Mode mode,
        boolean cooldownReady,
        float cooldownProgress,
        boolean autoJump,
        double jumpAtProgress,
        double minimumFallDistance
    ) {
        updateSprintRestore(player);

        if (mode == Mode.Off) {
            resetCycle();

            return cooldownReady
                ? Decision.NormalAttack
                : Decision.Wait;
        }

        if (!canAttemptCritical(player)) {
            resetCycle();

            return mode == Mode.Smart && cooldownReady
                ? Decision.NormalAttack
                : Decision.Wait;
        }

        if (isCriticalWindow(player, minimumFallDistance)) {
            state = State.CriticalWindow;

            if (cooldownReady) {
                missedCycles = 0;
                return Decision.CriticalAttack;
            }
        }

        if (!autoJump) {
            if (mode == Mode.Smart && cooldownReady) {
                return Decision.NormalAttack;
            }

            return Decision.Wait;
        }

        if (player.isOnGround()) {
            boolean missed =
                state == State.WaitingFall
                    || state == State.CriticalWindow
                    || state == State.MissedWindow;

            if (missed) {
                missedCycles++;
            }

            state = State.Ground;
            cycleTicks = 0;

            /*
             * Thunder-style Smart fallback:
             * after one failed critical cycle Aura
             * attacks normally instead of never hitting.
             */
            if (
                mode == Mode.Smart
                    && missedCycles > 0
                    && cooldownReady
            ) {
                missedCycles = 0;
                return Decision.NormalAttack;
            }

            if (cooldownProgress >= jumpAtProgress) {
                stopSprinting(player);
                player.jump();

                state = State.WaitingFall;
                cycleTicks = 0;
            }

            return Decision.Wait;
        }

        if (
            state == State.WaitingFall
                || state == State.CriticalWindow
        ) {
            cycleTicks++;
        }

        /*
         * If a modified server never exposes a usable
         * local fallDistance window, Smart still attacks.
         * OnlyCriticals continues waiting for a real crit.
         */
        if (
            mode == Mode.Smart
                && cycleTicks >= SMART_TIMEOUT_TICKS
                && cooldownReady
        ) {
            state = State.MissedWindow;
            missedCycles = 0;
            return Decision.NormalAttack;
        }

        if (
            player.fallDistance
                > minimumFallDistance + 1.0
            && !cooldownReady
        ) {
            state = State.MissedWindow;
        }

        return Decision.Wait;
    }

    public void beforeAttack(
        ClientPlayerEntity player,
        Decision decision
    ) {
        if (
            decision == Decision.CriticalAttack
                || player.isSprinting()
        ) {
            stopSprinting(player);
        }
    }

    public void afterAttack(
        ClientPlayerEntity player
    ) {
        state = State.Recovery;
        cycleTicks = 0;
        missedCycles = 0;

        if (restoreSprint) {
            restoreSprintTicks = 2;
        }
    }

    public void reset(
        ClientPlayerEntity player
    ) {
        resetCycle();
        missedCycles = 0;

        if (player != null && restoreSprint) {
            startSprinting(player);
        }

        restoreSprint = false;
        restoreSprintTicks = 0;
    }

    public boolean shouldSuppressSprint(Mode mode) {
        return mode != Mode.Off
            && (
            state == State.WaitingFall
                || state == State.CriticalWindow
                || state == State.MissedWindow
        );
    }

    public boolean isWaitingForCritical() {
        return state == State.WaitingFall
            || state == State.CriticalWindow
            || state == State.MissedWindow;
    }

    public State getState() {
        return state;
    }

    private boolean isCriticalWindow(
        ClientPlayerEntity player,
        double minimumFallDistance
    ) {
        return !player.isOnGround()
            && player.fallDistance > minimumFallDistance
            && !player.isClimbing()
            && !player.isTouchingWater()
            && !player.isSubmergedInWater()
            && !player.isInLava()
            && !player.hasVehicle()
            && !player.getAbilities().flying
            && !player.isGliding()
            && !player.hasStatusEffect(StatusEffects.BLINDNESS)
            && !player.hasStatusEffect(StatusEffects.LEVITATION)
            && !player.hasStatusEffect(StatusEffects.SLOW_FALLING);
    }

    private boolean canAttemptCritical(
        ClientPlayerEntity player
    ) {
        return !player.isClimbing()
            && !player.isTouchingWater()
            && !player.isSubmergedInWater()
            && !player.isInLava()
            && !player.hasVehicle()
            && !player.getAbilities().flying
            && !player.isGliding()
            && !player.hasStatusEffect(StatusEffects.BLINDNESS)
            && !player.hasStatusEffect(StatusEffects.LEVITATION)
            && !player.hasStatusEffect(StatusEffects.SLOW_FALLING);
    }

    private void stopSprinting(
        ClientPlayerEntity player
    ) {
        if (player.isSprinting()) {
            restoreSprint = true;
        }

        player.setSprinting(false);

        if (player.networkHandler != null) {
            player.networkHandler.sendPacket(
                new ClientCommandC2SPacket(
                    player,
                    ClientCommandC2SPacket.Mode.STOP_SPRINTING
                )
            );
        }
    }

    private void updateSprintRestore(
        ClientPlayerEntity player
    ) {
        if (restoreSprintTicks <= 0) return;

        restoreSprintTicks--;

        if (
            restoreSprintTicks == 0
                && restoreSprint
                && !isWaitingForCritical()
        ) {
            startSprinting(player);
            restoreSprint = false;
        }
    }

    private void startSprinting(
        ClientPlayerEntity player
    ) {
        player.setSprinting(true);

        if (player.networkHandler != null) {
            player.networkHandler.sendPacket(
                new ClientCommandC2SPacket(
                    player,
                    ClientCommandC2SPacket.Mode.START_SPRINTING
                )
            );
        }
    }

    private void resetCycle() {
        state = State.Ground;
        cycleTicks = 0;
    }

    public enum Mode {
        Off,
        Smart,
        OnlyCriticals
    }

    public enum Decision {
        Wait,
        NormalAttack,
        CriticalAttack
    }

    public enum State {
        Ground,
        WaitingFall,
        CriticalWindow,
        MissedWindow,
        Recovery
    }
}


