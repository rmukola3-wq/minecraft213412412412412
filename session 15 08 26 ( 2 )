public final class MorzhModuleSearch {
    private static final int MAX_LENGTH = 40;

    private String query = "";
    private boolean focused;

    public String getQuery() {
        return query;
    }

    public String getNormalizedQuery() {
        return query.trim().toLowerCase(Locale.ROOT);
    }

    public boolean isEmpty() {
        return query.isBlank();
    }

    public boolean isFocused() {
        return focused;
    }

    public void setFocused(boolean focused) {
        this.focused = focused;
    }

    public void clear() {
        query = "";
    }

    public boolean matches(Module module) {
        String search = getNormalizedQuery();

        if (search.isEmpty()) {
            return true;
        }

        if (contains(module.name, search)) {
            return true;
        }

        if (contains(module.title, search)) {
            return true;
        }

        if (contains(module.description, search)) {
            return true;
        }

        for (String alias : module.aliases) {
            if (contains(alias, search)) {
                return true;
            }
        }

        return false;
    }

    public boolean keyPressed(int keyCode) {
        if (!focused) {
            return false;
        }

        if (keyCode == GLFW.GLFW_KEY_ESCAPE
            || keyCode == GLFW.GLFW_KEY_ENTER
            || keyCode == GLFW.GLFW_KEY_KP_ENTER) {
            focused = false;
            return true;
        }

        if (keyCode == GLFW.GLFW_KEY_BACKSPACE) {
            if (!query.isEmpty()) {
                query = query.substring(0, query.length() - 1);
            }

            return true;
        }

        if (keyCode == GLFW.GLFW_KEY_DELETE) {
            clear();
            return true;
        }

        return false;
    }

    public boolean charTyped(char character) {
        if (!focused
            || Character.isISOControl(character)
            || query.length() >= MAX_LENGTH) {
            return false;
        }

        query += character;
        return true;
    }

    public String getRenderedText() {
        if (query.isEmpty()) {
            return focused ? "Type to search..." : "Search modules";
        }

        if (focused
            && (System.currentTimeMillis() / 450L) % 2L == 0L) {
            return query + "_";
        }

        return query;
    }

    private boolean contains(String value, String search) {
        return value != null
            && value.toLowerCase(Locale.ROOT).contains(search);
    }
}


