    @EventHandler(priority = EventPriority.HIGH)
    private void onTick(TickEvent.Pre event) {
        if (switchTimer > 0) {
            switchTimer--;
        }

        if (shieldBreakCooldown > 0) {
            shieldBreakCooldown--;
        }

        if (hitTimer < Integer.MAX_VALUE) {
            hitTimer++;
        }

        if (
            mc.player == null
                || mc.world == null
                || mc.interactionManager == null
        ) {
            clearCombat();
            return;
        }

        if (
            !mc.player.isAlive()
                || PlayerUtils.getGameMode()
                == GameMode.SPECTATOR
        ) {
            clearCombat();
            return;
        }

        if (
            pauseOnUse.get()
                && (
                mc.interactionManager
                    .isBreakingBlock()
                    || mc.player.isUsingItem()
            )
        ) {
            stopAttacking();
            return;
        }

        if (
            onlyOnClick.get()
                && !mc.options.attackKey.isPressed()
        ) {
            stopAttacking();
            return;
        }

        if (
            pauseOnLag.get()
                && TickRate.INSTANCE
                .getTimeSinceLastTick() >= 1.0f
        ) {
            stopAttacking();
            return;
        }

        CrystalAura crystalAura =
            Modules.get().get(CrystalAura.class);

        if (
            pauseOnCA.get()
                && crystalAura != null
                && crystalAura.isActive()
                && crystalAura.kaTimer > 0
        ) {
            stopAttacking();
            return;
        }

        updateTargets();

        if (targets.isEmpty()) {
            currentAimPoint = null;
            stopAttacking();
            criticalController.reset(mc.player);
            return;
        }

        Entity primary = targets.getFirst();

        currentAimPoint =
            aimPointResolver.resolve(
                mc,
                primary,
                range.get(),
                wallsRange.get()
            );

        if (currentAimPoint == null) {
            if (lockedTarget == primary) {
                lockedTarget = null;
            }

            targets.clear();
            stopAttacking();
            criticalController.reset(mc.player);
            return;
        }

        if (!prepareWeapon()) {
            stopAttacking();
            return;
        }

        if (!itemInHand()) {
            stopAttacking();
            return;
        }

        attacking = true;

        if (
            rotation.get()
                == RotationMode.Always
        ) {
            rotate(currentAimPoint);
        }

        if (
            pauseBaritone.get()
                && PathManagers.get().isPathing()
                && !wasPathing
        ) {
            PathManagers.get().pause();
            wasPathing = true;
        }

        float cooldownProgress =
            getCooldownProgress();

        boolean cooldownReady =
            isCooldownReady(cooldownProgress);

        AuraCriticalController.Mode effectiveMode =
            getEffectiveCriticalMode();

        AuraCriticalController.Decision decision =
            criticalController.update(
                mc.player,
                effectiveMode,
                cooldownReady,
                cooldownProgress,
                autoCriticalJump.get(),
                jumpAtProgress.get(),
                minimumFallDistance.get()
            );

        /*
         * Shield breaking is a utility axe hit.
         * It must not wait for a critical jump.
         */
        if (
            shouldShieldBreak()
                && cooldownReady
        ) {
            decision =
                AuraCriticalController.Decision
                    .NormalAttack;
        }

        if (
            decision
                == AuraCriticalController.Decision.Wait
        ) {
            return;
        }

        criticalController.beforeAttack(
            mc.player,
            decision
        );

        /*
         * One cooldown permits exactly one attack.
         * This fixes the old multi-target loop where only
         * the first target had a full cooldown.
         */
        if (attack(primary)) {
            criticalController.afterAttack(mc.player);
        }
    }

