    private void renderNumberSetting(
        DrawContext context,
        int x,
        int y,
        int rowWidth,
        double value,
        double minimum,
        double maximum
    ) {
        if (!Double.isFinite(minimum)
            || !Double.isFinite(maximum)
            || maximum <= minimum) {
            minimum = 0;
            maximum = Math.max(1, value);
        }

        double progress = MathHelper.clamp(
            (value - minimum) / (maximum - minimum),
            0,
            1
        );

        int sliderX = x + 5;
        int sliderWidth = rowWidth - 10;
        int sliderY = y + SETTING_HEIGHT - 3;

        context.fill(
            sliderX,
            sliderY,
            sliderX + sliderWidth,
            sliderY + 2,
            SLIDER_BACKGROUND
        );

        context.fill(
            sliderX,
            sliderY,
            sliderX + Math.max(
                1,
                (int) Math.round(sliderWidth * progress)
            ),
            sliderY + 2,
            ACCENT
        );

        String valueText =
            Math.abs(value - Math.rint(value)) < 0.001
                ? Integer.toString((int) Math.rint(value))
                : String.format(Locale.ROOT, "%.2f", value);

        int valueWidth =
            client.textRenderer.getWidth(valueText);

        drawText(
            context,
            valueText,
            x + rowWidth - valueWidth - 6,
            y + 3,
            ACCENT,
            false
        );
    }

