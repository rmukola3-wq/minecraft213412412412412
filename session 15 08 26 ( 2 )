    public KillAura() {
        super(
            Categories.Combat,
            "kill-aura",
            "Morzh KillAura with PRE rotations, POST attacks and synchronized critical retries."
        );
    }

    @Override
    public void onActivate() {
        targets.clear();

        lockedTarget = null;
        currentAimPoint = null;

        switchTimer = 0;
        hitTimer = 100;
        shieldBreakCooldown = 0;

        combatPrepared = false;
        attackQueued = false;
        wasPathing = false;
        swapped = false;
        previousSlot = -1;

        aimPointResolver.reset();
        criticalController.reset(mc.player);
    }

    @Override
    public void onDeactivate() {
        clearCombat();
        criticalController.reset(mc.player);
    }

    /*
     * PRE:
     * - update target;
     * - select weapon;
     * - calculate and submit rotation;
     * - never attack here.
     */
    @EventHandler(priority = EventPriority.HIGH)
    private void onTickPre(TickEvent.Pre event) {
        combatPrepared = false;

        if (switchTimer > 0) switchTimer--;
        if (shieldBreakCooldown > 0) shieldBreakCooldown--;
        if (hitTimer < Integer.MAX_VALUE) hitTimer++;

        if (!basicCheck()) {
            clearCombat();
            return;
        }

        updateTargets();

        if (targets.isEmpty()) {
            clearCombat();
            return;
        }

        Entity primary = targets.getFirst();

        currentAimPoint = aimPointResolver.resolve(
            mc,
            primary,
            range.get(),
            wallsRange.get()
        );

        if (currentAimPoint == null) {
            if (lockedTarget == primary) lockedTarget = null;

            targets.clear();
            stopAttacking();
            criticalController.reset(mc.player);
            return;
        }

        if (!prepareWeapon() || !itemInHand()) {
            stopAttacking();
            return;
        }

        if (rotation.get() == RotationMode.Always) {
            rotate(currentAimPoint, null);
        }

        if (
            pauseBaritone.get()
                && PathManagers.get().isPathing()
                && !wasPathing
        ) {
            PathManagers.get().pause();
            wasPathing = true;
        }

        combatPrepared = true;
    }

    /*
     * POST:
     * Minecraft has already updated movement,
     * onGround and fallDistance for this tick.
     */
    @EventHandler(priority = EventPriority.LOW)
    private void onTickPost(TickEvent.Post event) {
        if (!combatPrepared || attackQueued || targets.isEmpty()) return;
        if (!basicCheck()) return;

        Entity primary = targets.getFirst();

        if (!entityCheck(primary)) return;

        float progress = getCooldownProgress();
        boolean ready = isCooldownReady(progress);

        AuraCriticalController.Mode mode = getEffectiveCriticalMode();

        AuraCriticalController.Decision decision = criticalController.update(
            mc.player,
            mode,
            ready,
            progress,
            autoCriticalJump.get(),
            jumpAtProgress.get(),
            minimumFallDistance.get()
        );

        if (shouldShieldBreak() && ready) {
            decision = AuraCriticalController.Decision.NormalAttack;
        }

        if (decision == AuraCriticalController.Decision.Wait) return;

        criticalController.beforeAttack(mc.player, decision);
        queueAttack(primary);
    }

    @EventHandler
    private void onSendPacket(PacketEvent.Send event) {
        if (event.packet instanceof UpdateSelectedSlotC2SPacket) {
            switchTimer = switchDelay.get();
        }
    }

    private boolean basicCheck() {
        if (mc.player == null || mc.world == null || mc.interactionManager == null) {
            return false;
        }

        if (!mc.player.isAlive() || PlayerUtils.getGameMode() == GameMode.SPECTATOR) {
            return false;
        }

        if (
            pauseOnUse.get()
                && (
                mc.player.isUsingItem()
                    || mc.interactionManager.isBreakingBlock()
            )
        ) {
            return false;
        }

        if (onlyOnClick.get() && !mc.options.attackKey.isPressed()) {
            return false;
        }

        if (
            pauseOnLag.get()
                && TickRate.INSTANCE.getTimeSinceLastTick() >= 1.0f
        ) {
            return false;
        }

        CrystalAura crystalAura = Modules.get().get(CrystalAura.class);

        return !pauseOnCA.get()
            || crystalAura == null
            || !crystalAura.isActive()
            || crystalAura.kaTimer <= 0;
    }

    private void updateTargets() {
        targets.clear();

        if (onlyOnLook.get()) {
            lockedTarget = null;

            if (mc.targetedEntity != null && entityCheck(mc.targetedEntity)) {
                targets.add(mc.targetedEntity);
            }

            return;
        }

        if (targetLock.get() && lockedTarget != null) {
            if (entityCheck(lockedTarget)) {
                targets.add(lockedTarget);
                return;
            }

            lockedTarget = null;
            aimPointResolver.reset();
        }

        TargetUtils.getList(
            targets,
            this::entityCheck,
            priority.get(),
            targetLock.get() ? 1 : maxTargets.get()
        );

        if (targetLock.get() && !targets.isEmpty()) {
            lockedTarget = targets.getFirst();
        }
    }

    private void queueAttack(Entity target) {
        if (target == null || !target.isAlive()) return;

        Vec3d point = aimPointResolver.resolve(
            mc,
            target,
            range.get(),
            wallsRange.get()
        );

        if (point == null) return;

        attackQueued = true;

        Runnable action = () -> {
            attackQueued = false;

            if (
                mc.player == null
                    || mc.interactionManager == null
                    || !target.isAlive()
                    || !entityCheck(target)
            ) {
                return;
            }

            boolean breakingShield =
                shouldShieldBreak()
                    && mc.player.getMainHandStack().getItem() instanceof AxeItem;

            mc.interactionManager.attackEntity(mc.player, target);
            mc.player.swingHand(Hand.MAIN_HAND);

            hitTimer = 0;

            if (breakingShield) {
                shieldBreakCooldown = 10;
            }

            criticalController.afterAttack(mc.player);
        };

        if (rotation.get() == RotationMode.OnHit) {
            rotate(point, action);
        } else {
            action.run();
        }
    }

    private void rotate(Vec3d point, Runnable callback) {
        Vec3d eyes = mc.player.getEyePos();

        double dx = point.x - eyes.x;
        double dy = point.y - eyes.y;
        double dz = point.z - eyes.z;
        double horizontal = Math.sqrt(dx * dx + dz * dz);

        float yaw = (float) (Math.toDegrees(Math.atan2(dz, dx)) - 90);
        float pitch = MathHelper.clamp(
            (float) -Math.toDegrees(Math.atan2(dy, horizontal)),
            -90,
            90
        );

        if (callback == null) {
            Rotations.rotate(yaw, pitch);
        } else {
            Rotations.rotate(yaw, pitch, callback);
        }
    }

    private boolean prepareWeapon() {
        if (!autoSwitch.get()) return true;

        FindItemResult result = findWeapon();

        if (!result.found() || result.slot() < 0) return false;

        int selected = mc.player.getInventory().selectedSlot;

        if (!swapped && selected != result.slot()) {
            previousSlot = selected;
            swapped = true;
        }

        if (selected != result.slot()) {
            InvUtils.swap(result.slot(), false);
        }

        return true;
    }

    private FindItemResult findWeapon() {
        if (shouldShieldBreak()) {
            return InvUtils.findInHotbar(stack -> stack.getItem() instanceof AxeItem);
        }

        return switch (weapon.get()) {
            case Sword -> InvUtils.findInHotbar(stack -> stack.getItem() instanceof SwordItem);
            case Axe -> InvUtils.findInHotbar(stack -> stack.getItem() instanceof AxeItem);
            case Mace -> InvUtils.findInHotbar(stack -> stack.getItem() instanceof MaceItem);
            case Trident -> InvUtils.findInHotbar(stack -> stack.getItem() instanceof TridentItem);
            case All -> findPreferredWeapon();
            case Any -> InvUtils.findInHotbar(stack -> true);
        };
    }

    private FindItemResult findPreferredWeapon() {
        FindItemResult result =
            InvUtils.findInHotbar(stack -> stack.getItem() instanceof SwordItem);

        if (result.found()) return result;

        result = InvUtils.findInHotbar(stack -> stack.getItem() instanceof MaceItem);
        if (result.found()) return result;

        result = InvUtils.findInHotbar(stack -> stack.getItem() instanceof TridentItem);
        if (result.found()) return result;

        return InvUtils.findInHotbar(stack -> stack.getItem() instanceof AxeItem);
    }

    private boolean itemInHand() {
        Item item = mc.player.getMainHandStack().getItem();

        if (shouldShieldBreak()) return item instanceof AxeItem;

        return switch (weapon.get()) {
            case Sword -> item instanceof SwordItem;
            case Axe -> item instanceof AxeItem;
            case Mace -> item instanceof MaceItem;
            case Trident -> item instanceof TridentItem;
            case All ->
                item instanceof SwordItem
                    || item instanceof AxeItem
                    || item instanceof MaceItem
                    || item instanceof TridentItem;
            case Any -> true;
        };
    }

    private float getCooldownProgress() {
        if (!customDelay.get()) {
            return mc.player.getAttackCooldownProgress(0.5f);
        }

        float required = getRequiredCustomTicks();

        return required <= 0
            ? 1
            : MathHelper.clamp(hitTimer / required, 0, 1);
    }

    private boolean isCooldownReady(float progress) {
        if (switchTimer > 0) return false;

        return customDelay.get()
            ? hitTimer >= getRequiredCustomTicks()
            : progress >= cooldownThreshold.get();
    }

    private float getRequiredCustomTicks() {
        float required = hitDelay.get();

        if (tpsSync.get()) {
            float factor = TickRate.INSTANCE.getTickRate() / 20f;

            if (factor > 0) required /= factor;
        }

        return Math.max(0, required);
    }

    private AuraCriticalController.Mode getEffectiveCriticalMode() {
        AuraCriticalController.Mode mode = criticalMode.get();

        if (mode == AuraCriticalController.Mode.Off || hasJumpSpace()) {
            return mode;
        }

        return mode == AuraCriticalController.Mode.Smart
            ? AuraCriticalController.Mode.Off
            : mode;
    }

    private boolean hasJumpSpace() {
        BlockPos base = mc.player.getBlockPos();

        for (int offset = 2; offset <= 3; offset++) {
            BlockPos position = base.up(offset);
            BlockState state = mc.world.getBlockState(position);

            if (
                !state.isAir()
                    && !state.getCollisionShape(mc.world, position).isEmpty()
            ) {
                return false;
            }
        }

        return true;
    }

    private boolean shouldShieldBreak() {
        if (shieldMode.get() != ShieldMode.Break || shieldBreakCooldown > 0) {
            return false;
        }

        for (Entity target : targets) {
            if (target instanceof PlayerEntity player && player.isBlocking()) {
                return true;
            }
        }

        return false;
    }

    private boolean entityCheck(Entity entity) {
        if (entity == null || entity == mc.player || entity == mc.cameraEntity) return false;
        if (!entity.isAlive()) return false;

        if (entity instanceof LivingEntity living && living.isDead()) return false;

        Box box = entity.getBoundingBox();

        double x = MathHelper.clamp(mc.player.getX(), box.minX, box.maxX);
        double y = MathHelper.clamp(mc.player.getY(), box.minY, box.maxY);
        double z = MathHelper.clamp(mc.player.getZ(), box.minZ, box.maxZ);

        if (!PlayerUtils.isWithin(x, y, z, range.get())) return false;
        if (!entities.get().contains(entity.getType())) return false;
        if (ignoreNamed.get() && entity.hasCustomName()) return false;

        if (
            !PlayerUtils.canSeeEntity(entity)
                && !PlayerUtils.isWithin(entity, wallsRange.get())
        ) {
            return false;
        }

        if (
            ignoreTamed.get()
                && entity instanceof Tameable tameable
                && tameable.getOwnerUuid() != null
                && tameable.getOwnerUuid().equals(mc.player.getUuid())
        ) {
            return false;
        }

        if (ignorePassive.get()) {
            if (entity instanceof EndermanEntity enderman && !enderman.isAngry()) {
                return false;
            }

            if (
                entity instanceof ZombifiedPiglinEntity piglin
                    && !piglin.isAttacking()
            ) {
                return false;
            }

            if (entity instanceof WolfEntity wolf && !wolf.isAttacking()) {
                return false;
            }
        }

        if (entity instanceof PlayerEntity player) {
            if (player.isCreative()) return false;
            if (!Friends.get().shouldAttack(player)) return false;

            if (shieldMode.get() == ShieldMode.Ignore && player.isBlocking()) {
                return false;
            }
        }

        return true;
    }

    private void stopAttacking() {
        combatPrepared = false;

        if (wasPathing) {
            PathManagers.get().resume();
            wasPathing = false;
        }

        if (swapped) {
            if (swapBack.get() && previousSlot >= 0 && previousSlot <= 8) {
                InvUtils.swap(previousSlot, false);
            }

            swapped = false;
            previousSlot = -1;
        }
    }

    private void clearCombat() {
        targets.clear();

        lockedTarget = null;
        currentAimPoint = null;
        attackQueued = false;

        aimPointResolver.reset();

        if (mc.player != null) {
            criticalController.reset(mc.player);
        }

        stopAttacking();
    }

    public boolean isManagingCriticals() {
        return isActive()
            && criticalMode.get() != AuraCriticalController.Mode.Off
            && getTarget() != null;
    }

    public boolean shouldTargetStrafeJump() {
        return !isManagingCriticals() || !autoCriticalJump.get();
    }

    public boolean shouldSuppressSprint() {
        return isManagingCriticals()
            && criticalController.shouldSuppressSprint(criticalMode.get());
    }

    public boolean isWaitingForCritical() {
