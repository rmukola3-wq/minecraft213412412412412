                StatusEffect type = instance.getEffectType().value();
                active.put(type, instance);
                snapshots.put(type, Snapshot.from(instance));
                int duration = instance.getDuration();
                Integer prev = maxDurations.get(type);
                if (prev == null || duration > prev) maxDurations.put(type, duration);
            }
        }

        for (StatusEffect type : active.keySet()) fade.putIfAbsent(type, 0f);

        Iterator<Map.Entry<StatusEffect, Float>> it = fade.entrySet().iterator();
        while (it.hasNext()) {
            Map.Entry<StatusEffect, Float> entry = it.next();
            boolean on = active.containsKey(entry.getKey());
            float next = MathHelper.lerp(0.18f, entry.getValue(), on ? 1f : 0f);
            if (!on && next < 0.02f) {
                it.remove();
                snapshots.remove(entry.getKey());
                maxDurations.remove(entry.getKey());
            } else {
                entry.setValue(next);
            }
        }
    }

    @Override
    public void render(HudRenderer renderer) {
        float s = scale();
        double fs = 0.58 * s;
        List<Row> rows = new ArrayList<>();

        if (fade.isEmpty() && isInEditor()) {
            rows.add(new Row(null, "Strength", "3:12", 1f, 0.72f, 0xFFFFFFFF));
            rows.add(new Row(null, "Fire Resi", "1:20", 1f, 0.45f, 0xFFFFFFFF));
            rows.add(new Row(null, "Speed II", "0:45", 1f, 0.22f, 0xFFFFFFFF));
        } else {
            for (Map.Entry<StatusEffect, Float> entry : fade.entrySet()) {
                Snapshot snap = snapshots.get(entry.getKey());
                if (snap == null || entry.getValue() < 0.02f) continue;
                int max = Math.max(1, maxDurations.getOrDefault(entry.getKey(), snap.duration));
                float progress = snap.infinite ? 1f : MathHelper.clamp(snap.duration / (float) max, 0f, 1f);
                int color = colored.get() ? (0xFF000000 | entry.getKey().getColor()) : 0xFFFFFFFF;
                rows.add(new Row(snap.effect, snap.name, snap.time, entry.getValue(), progress, color));
            }
        }

        if (rows.isEmpty() && !isInEditor()) {
            setSize(0, 0);
            return;
        }

        float cardWidth = 120 * s;
        for (Row row : rows) {
            cardWidth = Math.max(cardWidth, (float) MorzhSmoothRenderer.textWidth(row.name, fs) + 70 * s);
        }
        float header = 22 * s;
        float rowH = 16 * s;
        float height = header + Math.max(1, rows.size()) * rowH + 4 * s;
        setSize(cardWidth, height);

        List<Row> draw = rows;
        renderer.post(() -> {
            DrawContext context = HudRenderer.INSTANCE.drawContext;
            if (context == null) return;

            HudChrome.card(context, x, y, getWidth(), getHeight(), 7 * s);
            HudChrome.header(context, "Potions", x, y, getWidth(), s, fs);

            float rowY = y + header;
            for (Row row : draw) {
                int alpha = MathHelper.clamp((int) (255 * row.fade), 0, 255);
                int nameColor = (row.color & 0x00FFFFFF) | (alpha << 24);

                drawIcon(context, row.effect, x + 8 * s, rowY + 2 * s, 10 * s);
                MorzhSmoothRenderer.text(context, row.name, x + 22 * s, rowY + 2 * s, nameColor, true, fs);

                float ring = 6 * s;
                float pillH = 12 * s;
                float timeW = (float) MorzhSmoothRenderer.textWidth(row.time, fs) + 8 * s;
                float pillX = x + getWidth() - 6 * s - timeW;
                float ringX = pillX - 4 * s - ring;

                MorzhSmoothRenderer.circle(context, ringX + ring / 2f, rowY + 7 * s, ring / 2f, HudChrome.RV_PILL);
                if (row.progress > 0.02f) {
                    MorzhSmoothRenderer.arcRing(
                        context,
                        ringX + ring / 2f,
                        rowY + 7 * s,
                        ring / 2f,
                        1.6f * s,
                        -90,
                        Math.max(8f, 360f * row.progress),
                        HudChrome.RV_ORANGE
                    );
                }

                MorzhSmoothRenderer.roundedRect(context, pillX, rowY + 1 * s, timeW, pillH, 4 * s, HudChrome.RV_PILL);
                MorzhSmoothRenderer.text(context, row.time, pillX + 4 * s, rowY + 2 * s, nameColor, true, fs);
                rowY += rowH;
            }
        });
    }

    private static void drawIcon(DrawContext context, RegistryEntry<StatusEffect> effect, float x, float y, float size) {
        if (effect == null || mc.getStatusEffectSpriteManager() == null) {
            MorzhSmoothRenderer.roundedRect(context, x, y + 1, size - 2, size - 2, 2, HudChrome.RV_ORANGE);
            return;
        }
        Sprite sprite = mc.getStatusEffectSpriteManager().getSprite(effect);
        context.drawSpriteStretched(RenderLayer::getGuiTextured, sprite, Math.round(x), Math.round(y), Math.round(size), Math.round(size));
    }

    private record Row(RegistryEntry<StatusEffect> effect, String name, String time, float fade, float progress, int color) {}

    private record Snapshot(RegistryEntry<StatusEffect> effect, String name, String time, int duration, boolean infinite) {
        static Snapshot from(StatusEffectInstance instance) {
            String name = I18n.translate(instance.getTranslationKey());
            int amp = instance.getAmplifier();
            if (amp > 0) name = name + " " + roman(amp + 1);
            int dur = instance.getDuration();
            boolean inf = instance.isInfinite() || dur > 32000;
            String time = inf ? "Inf" : String.format("%d:%02d", dur / 20 / 60, dur / 20 % 60);
            return new Snapshot(instance.getEffectType(), name, time, dur, inf);
        }
    }

    private static String roman(int n) {
        return switch (n) {
            case 1 -> "I";
            case 2 -> "II";
            case 3 -> "III";
            case 4 -> "IV";
            case 5 -> "V";
            default -> String.valueOf(n);
        };
    }
}



