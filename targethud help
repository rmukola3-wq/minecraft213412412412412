package meteordevelopment.meteorclient.gui.morzh;

import meteordevelopment.meteorclient.renderer.Mesh;
import meteordevelopment.meteorclient.renderer.Renderer2D;
import meteordevelopment.meteorclient.utils.render.color.Color;
import net.minecraft.client.gui.DrawContext;

/**
 * Shared "smooth" drawing helpers for the whole client HUD.
 *
 * Everything here goes through the vector Renderer2D pipeline instead of
 * DrawContext#fill, and every corner is a real curve with a soft
 * anti-aliased edge instead of a hard right angle.
 */
public final class MorzhSmoothRenderer {
    private static final int CORNER_SEGMENTS = 18;
    private static final float AA_FEATHER = 1.25f;

    private MorzhSmoothRenderer() {}

    public static void roundedRect(DrawContext context, float x, float y, float width, float height, float radius, int packedColor) {
        roundedRect(context, x, y, width, height, radius, packedColor, 0, 0f);
    }

    public static void roundedRect(DrawContext context, float x, float y, float width, float height, float radius, int fillColor, int outlineColor, float outlineThickness) {
        if (width <= 0 || height <= 0) return;

        Renderer2D r = Renderer2D.COLOR;
        r.begin();

        Color fill = unpack(fillColor);

        if (outlineThickness > 0 && (outlineColor >>> 24) > 0) {
            Color outline = unpack(outlineColor);

            fill(r, x, y, width, height, radius, outline);
            fill(r, x + outlineThickness, y + outlineThickness,
                width - outlineThickness * 2, height - outlineThickness * 2,
                Math.max(0, radius - outlineThickness), fill);

            feather(r, x, y, width, height, radius, outline);
        }
        else {
            fill(r, x, y, width, height, radius, fill);
            feather(r, x, y, width, height, radius, fill);
        }

        r.render(context.getMatrices());
    }

    public static void roundedRectNoBegin(DrawContext context, float x, float y, float width, float height, float radius, int packedColor) {
        roundedRectNoBegin(context, x, y, width, height, radius, packedColor, 0, 0f);
    }

    public static void roundedRectNoBegin(DrawContext context, float x, float y, float width, float height, float radius, int fillColor, int outlineColor, float outlineThickness) {
        if (width <= 0 || height <= 0) return;

        Renderer2D r = Renderer2D.COLOR;
        Color fill = unpack(fillColor);

        if (outlineThickness > 0 && (outlineColor >>> 24) > 0) {
            Color outline = unpack(outlineColor);

            fill(r, x, y, width, height, radius, outline);
            fill(r, x + outlineThickness, y + outlineThickness,
                width - outlineThickness * 2, height - outlineThickness * 2,
                Math.max(0, radius - outlineThickness), fill);

            feather(r, x, y, width, height, radius, outline);
        }
        else {
            fill(r, x, y, width, height, radius, fill);
            feather(r, x, y, width, height, radius, fill);
        }
    }

    /** Ring segment, degrees clockwise from +X. Used for pearl landing timer. */
    public static void arcRing(DrawContext context, float cx, float cy, float radius, float thickness, float startDeg, float sweepDeg, int packedColor) {
        if (radius <= 0 || thickness <= 0 || sweepDeg <= 0) return;
        Renderer2D r = Renderer2D.COLOR;
        r.begin();
        Color color = unpack(packedColor);
        int segments = Math.max(8, (int) (Math.abs(sweepDeg) / 6));
        double start = Math.toRadians(startDeg);
        double step = Math.toRadians(sweepDeg) / segments;
        double inner = Math.max(0, radius - thickness);
        for (int i = 0; i < segments; i++) {
            double a0 = start + step * i;
            double a1 = start + step * (i + 1);
            double x0i = cx + Math.cos(a0) * inner, y0i = cy + Math.sin(a0) * inner;
            double x1i = cx + Math.cos(a1) * inner, y1i = cy + Math.sin(a1) * inner;
            double x0o = cx + Math.cos(a0) * radius, y0o = cy + Math.sin(a0) * radius;
            double x1o = cx + Math.cos(a1) * radius, y1o = cy + Math.sin(a1) * radius;
            r.triangle(x0i, y0i, x0o, y0o, x1o, y1o, color);
            r.triangle(x0i, y0i, x1o, y1o, x1i, y1i, color);
        }
        r.render(context.getMatrices());
    }

    public static void gradientRect(DrawContext context, float x, float y, float width, float height, int leftColor, int rightColor) {
        if (width <= 0 || height <= 0) return;

        Renderer2D r = Renderer2D.COLOR;
        r.begin();

        Color left = unpack(leftColor);
        Color right = unpack(rightColor);

        r.quad(x, y, width, height, left, right, right, left);
        r.render(context.getMatrices());
    }

    public static void circle(DrawContext context, float cx, float cy, float radius, int packedColor) {
        if (radius <= 0) return;

        Renderer2D r = Renderer2D.COLOR;
        r.begin();

        Color color = unpack(packedColor);
        arc(r, cx, cy, radius, 0, 360, CORNER_SEGMENTS * 4, color);
        featherCorner(r, cx, cy, radius, 0, 360, color);

        r.render(context.getMatrices());
    }

