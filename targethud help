package meteordevelopment.meteorclient.gui.morzh;

import meteordevelopment.meteorclient.gui.rasty.Initialization;
import meteordevelopment.meteorclient.gui.rasty.util.render.Render2D;
import meteordevelopment.meteorclient.gui.rasty.util.render.shader.RenderCore;
import net.minecraft.client.MinecraftClient;
import net.minecraft.client.gui.DrawContext;

/** Shader path for ClickGUI (scaled Screen coords). Do not use from HUD вЂ” HUD is unscaled pixels. */
public final class Visuals {
    private Visuals() {}

    public static float overlayScale() {
        MinecraftClient client = MinecraftClient.getInstance();
        if (client == null || client.getWindow() == null) return 1f;
        return (float) client.getWindow().getScaleFactor() / Render2D.getFixedGuiScale();
    }

    public static void flush(DrawContext context) {
        if (context != null) context.draw();
        RenderCore core = Initialization.getInstance().getManager().getRenderCore();
        core.setupOverlayState();
    }

    public static void rect(DrawContext context, float x, float y, float w, float h,
                            float tl, float tr, float br, float bl, int packed) {
        if (w <= 0 || h <= 0) return;
        flush(context);
        float s = overlayScale();
        Render2D.rect(x * s, y * s, w * s, h * s, packed, tl * s, tr * s, br * s, bl * s);
    }

    public static void rect(DrawContext context, float x, float y, float w, float h, float radius, int packed) {
        rect(context, x, y, w, h, radius, radius, radius, radius, packed);
    }

    public static void gradientH(DrawContext context, float x, float y, float w, float h, int left, int right) {
        if (w <= 0 || h <= 0) return;
        flush(context);
        float s = overlayScale();
        Render2D.gradientRect(x * s, y * s, w * s, h * s, new int[]{left, right, right, left}, 0);
    }

    public static void gradientV(DrawContext context, float x, float y, float w, float h, int top, int bottom) {
        if (w <= 0 || h <= 0) return;
        flush(context);
        float s = overlayScale();
        Render2D.gradientRect(x * s, y * s, w * s, h * s, new int[]{top, top, bottom, bottom}, 0);
    }

    public static void outline(DrawContext context, float x, float y, float w, float h, float radius, float thickness, int packed) {
        if (w <= 0 || h <= 0) return;
        flush(context);
        float s = overlayScale();
        Render2D.outline(x * s, y * s, w * s, h * s, thickness * s, packed, radius * s);
    }

    public static void glow(DrawContext context, float x, float y, float w, float h, float radius, float pad, int packed) {
        if (w <= 0 || h <= 0) return;
        flush(context);
        float s = overlayScale();
        Render2D.glowOutline(x * s, y * s, w * s, h * s, pad * s, packed, radius * s, 1f, 1f);
    }

    public static void shadow(DrawContext context, float x, float y, float w, float h, float radius) {
        glow(context, x, y + 2.5f, w, h, radius, 10f, 0x66000000);
    }

    /**
     * Frosted panel: world blur + readable dark glass + white rim (not a solid navy block).
     */
    public static void glass(DrawContext context, float x, float y, float w, float h, float radius) {
        glass(context, x, y, w, h, radius, 1f);
    }

    public static void glass(DrawContext context, float x, float y, float w, float h, float radius, float alpha) {
        if (w <= 0 || h <= 0 || alpha <= 0.01f) return;
        flush(context);
        float s = overlayScale();
        float sx = x * s, sy = y * s, sw = w * s, sh = h * s, sr = radius * s;
        float a = Math.max(0f, Math.min(1f, alpha));

        Render2D.blur(sx, sy, sw, sh, 14f * s, sr, pack(22, 24, 32, (int) (210 * a)));
        Render2D.rect(sx, sy, sw, sh, pack(16, 18, 26, (int) (150 * a)), sr);
        Render2D.rect(sx, sy, sw, Math.min(22f * s, sh * 0.18f), pack(255, 255, 255, (int) (18 * a)), sr, sr, 0, 0);
        glow(context, x, y, w, h, radius, 8f, pack(133, 156, 255, (int) (40 * a)));
        Render2D.outline(sx, sy, sw, sh, 1.1f * s, pack(230, 235, 255, (int) (90 * a)), sr);
    }

    public static void toast(DrawContext context, float x, float y, float w, float h, float radius, float alpha) {
        if (w <= 0 || h <= 0 || alpha <= 0.01f) return;
        flush(context);
        float s = overlayScale();
        float sx = x * s, sy = y * s, sw = w * s, sh = h * s, sr = radius * s;
        int a = Math.max(0, Math.min(255, Math.round(200 * alpha)));
        Render2D.blur(sx, sy, sw, sh, 8f * s, sr, (a << 24) | 0x10141C);
        Render2D.rect(sx, sy, sw, sh, (Math.round(160 * alpha) << 24) | 0x10141C, sr);
        Render2D.outline(sx, sy, sw, sh, 1f * s, (Math.round(80 * alpha) << 24) | 0xE8EEFF, sr);
    }

    private static int pack(int r, int g, int b, int a) {
        return (a & 255) << 24 | (r & 255) << 16 | (g & 255) << 8 | (b & 255);
    }
}



