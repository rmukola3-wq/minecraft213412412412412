import static meteordevelopment.meteorclient.MeteorClient.mc;

public class StaffBoardHud extends ScaledHudElement {
    public static final HudElementInfo<StaffBoardHud> INFO = new HudElementInfo<>(
        Hud.GROUP, "staff-board", "Online / vanish staff list.", StaffBoardHud::new
    );

    private static final Pattern NAME = Pattern.compile("^\\w{3,16}$");
    private final List<Row> rows = new ArrayList<>();
    private int staffScan;

    public StaffBoardHud() {
        super(INFO);
        setSize(90, 28);
    }

    @Override
    public void tick(HudRenderer renderer) {
        if (++staffScan < 10 && !rows.isEmpty()) return;
        staffScan = 0;
        rows.clear();
        if (mc.player == null || mc.getNetworkHandler() == null || mc.world == null) return;
        if (mc.isInSingleplayer()) return;

        List<String> online = new ArrayList<>();
        for (PlayerListEntry entry : mc.getNetworkHandler().getPlayerList()) {
            String n = entry.getProfile().getName();
            if (NAME.matcher(n).matches()) online.add(n);
        }

        for (PlayerListEntry entry : mc.getNetworkHandler().getPlayerList()) {
            if (entry.getScoreboardTeam() == null) continue;
            String prefix = Formatting.strip(entry.getScoreboardTeam().getPrefix().getString());
            if (!isStaff(prefix, entry.getProfile().getName())) continue;
            String shown = entry.getScoreboardTeam().getPrefix().getString() + entry.getProfile().getName();
            Status status = entry.getGameMode() == GameMode.SPECTATOR ? Status.Gm3 : Status.Active;
            rows.add(new Row(shown, status, entry));
        }

        if (mc.world.getScoreboard() != null) {
            for (Team team : mc.world.getScoreboard().getTeams()) {
                String prefix = team.getPrefix().getString();
                if (prefix.isEmpty()) continue;
                for (String member : team.getPlayerList()) {
                    if (online.contains(member) || member.isEmpty()) continue;
                    if (!isStaff(Formatting.strip(prefix), member)) continue;
                    rows.add(new Row(prefix + member, Status.Vanish, null));
                }
            }
        }

        rows.sort(Comparator.comparing(r -> r.name.toLowerCase(Locale.ROOT)));
    }

    @Override
    public void render(HudRenderer renderer) {
        float s = scale();
        double fs = 0.52 * s;
        float header = 20 * s;
        float rowH = 16 * s;

        List<Row> draw = rows;
        if (draw.isEmpty() && isInEditor()) draw = List.of(new Row("Helper Steve", Status.Active, null));
        if (draw.isEmpty() && !isInEditor()) {
            setSize(80 * s, header);
        }

        float max = 90 * s;
        for (Row row : draw) {
            max = Math.max(max, (float) MorzhSmoothRenderer.textWidth(row.name, fs) + 48 * s);
        }
        float h = header + Math.max(draw.isEmpty() ? 0 : draw.size(), isInEditor() ? 1 : 0) * rowH + 4 * s;
        if (draw.isEmpty()) h = header;
        setSize(max, Math.max(header, h));

        List<Row> finalDraw = draw;
        renderer.post(() -> {
            DrawContext context = HudRenderer.INSTANCE.drawContext;
            if (context == null) return;
            HudChrome.card(context, x, y, getWidth(), getHeight(), 7 * s);
            HudChrome.header(context, "Staff", x, y, getWidth(), s, fs);
            if (finalDraw.isEmpty()) return;

            float yOff = y + header;
            for (Row row : finalDraw) {
                if (row.entry != null) {
                    PlayerSkinDrawer.draw(context, row.entry.getSkinTextures(), Math.round(x + 8 * s), Math.round(yOff + 2 * s), Math.round(10 * s));
                }
                MorzhSmoothRenderer.text(context, row.name, x + 22 * s, yOff + 3 * s, 0xFFFFFFFF, true, fs);
                String mark = switch (row.status) {
                    case Vanish -> "V";
                    case Gm3 -> "GM3";
                    case Active -> "Z";
                };
                int color = switch (row.status) {
                    case Vanish -> DropDownColors.rgb(230, 80, 80);
                    case Gm3 -> DropDownColors.rgb(230, 200, 70);
                    case Active -> DropDownColors.rgb(90, 210, 110);
                };
                float mw = (float) MorzhSmoothRenderer.textWidth(mark, fs) + 8 * s;
                float pillX = x + getWidth() - 6 * s - mw;
                MorzhSmoothRenderer.roundedRect(context, pillX, yOff + 1 * s, mw, 12 * s, 4 * s, HudChrome.RV_PILL);
                MorzhSmoothRenderer.text(context, mark, pillX + 4 * s, yOff + 2 * s, color, true, fs);
                yOff += rowH;
            }
        });
    }

    private static boolean isStaff(String prefix, String name) {
        String p = prefix == null ? "" : prefix.toLowerCase(Locale.ROOT);
        String n = name == null ? "" : name.toLowerCase(Locale.ROOT);
        if (p.contains("yt") || (p.contains("y") && p.contains("t") && p.length() < 8)) return true;
        return p.contains("helper") || p.contains("moder") || p.contains("admin") || p.contains("owner")
            || p.contains("curator") || p.contains("РєСѓСЂР°С‚РѕСЂ") || p.contains("РјРѕРґРµСЂ") || p.contains("Р°РґРјРёРЅ")
            || p.contains("С…РµР»РїРµСЂ") || p.contains("РїРѕРґРґРµСЂР¶РєР°") || p.contains("СЃРѕС‚СЂСѓРґРЅРёРє") || p.contains("СЃС‚Р°Р¶С‘СЂ")
            || p.contains("СЃС‚Р°Р¶РµСЂ") || n.contains("timings") || n.contains("ruthless");
    }

    private enum Status { Active, Gm3, Vanish }

    private record Row(String name, Status status, PlayerListEntry entry) {}
}



