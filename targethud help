/** Target HUD вЂ” Morzh panel, vanilla head draw, armor + consumables. */
public class TargetHud extends HudElement implements HudScalableElement {
    private static final float BASE_W = 152f;
    private static final float BASE_H = 58f;
    private static final float HEAD = 36f;
    private static final float HEAD_PAD = 8f;
    private static final float CONTENT_X = HEAD_PAD + HEAD + 7f;
    private static final int CLIENT = DropDownColors.rgb(129, 135, 255);
    private static final float MIN_SCALE = 0.5f;
    private static final float MAX_SCALE = 3f;

    public static final HudElementInfo<TargetHud> INFO = new HudElementInfo<>(
        Hud.GROUP, "target",
        "Target HUD: portrait, name, armor, HP.",
        TargetHud::new
    );

    private final SettingGroup sg = settings.getDefaultGroup();

    private final Setting<Double> scale = sg.add(new DoubleSetting.Builder()
        .name("scale")
        .description("HUD scale.")
        .defaultValue(1.0)
        .min(MIN_SCALE)
        .sliderMax(MAX_SCALE)
        .onChanged(v -> calculateSize())
        .build()
    );

    private LivingEntity lastTarget;
    private float fade;
    private float hpAnim;
    private float hpTrail;
    private long lastFrameNs;

    public TargetHud() {
        super(INFO);
        calculateSize();
    }

    @Override
    public void adjustScale(double delta) {
        scale.set(MathHelper.clamp(scale.get() + delta, MIN_SCALE, MAX_SCALE));
        calculateSize();
    }

    @Override
    public double getScaleValue() {
        return scale.get();
    }

    private float s() {
        return scale.get().floatValue();
    }

    private void calculateSize() {
        setSize(BASE_W * s(), BASE_H * s());
    }

    @Override
    public void tick(HudRenderer renderer) {
        LivingEntity t = resolveTarget();
        if (t != null) lastTarget = t;
    }

    @Override
    public void render(HudRenderer renderer) {
        long now = System.nanoTime();
        float dt = lastFrameNs == 0 ? 0.016f : MathHelper.clamp((now - lastFrameNs) / 1_000_000_000f, 0f, 0.05f);
        lastFrameNs = now;

        LivingEntity target = isInEditor() ? mc.player : resolveTarget();
        if (target != null) lastTarget = target;

        boolean show = lastTarget != null && (target != null || isInEditor() || mc.currentScreen instanceof ChatScreen);
        fade = anim(fade, show ? 1f : 0f, dt, 12f);
        if (fade < 0.03f || lastTarget == null) return;

        LivingEntity entity = lastTarget;
        float a = fade;
        float sc = s();
        float w = BASE_W * sc;
        float h = BASE_H * sc;

        float maxHp = Math.max(1f, entity.getMaxHealth());
        float hp = ScoreboardHelper.getHealthBelowName(entity);
        float hpPct = MathHelper.clamp(hp / maxHp, 0f, 1f);
        hpAnim = anim(hpAnim, hpPct, dt, 14f);
        if (hpTrail > hpAnim + 0.002f) hpTrail = anim(hpTrail, hpAnim, dt, 6f);
        else hpTrail = hpAnim;

        renderer.post(() -> {
            DrawContext ctx = HudRenderer.INSTANCE.drawContext;
            if (ctx == null) return;
            draw(ctx, entity, x, y, w, h, sc, a, hp, maxHp);
        });
    }

    private void draw(DrawContext ctx, LivingEntity entity, float px, float py, float w, float h,
                      float sc, float alpha, float hp, float maxHp) {
        int a = MathHelper.clamp(Math.round(255f * alpha), 0, 255);
        float radius = 8f * sc;

        HudChrome.card(ctx, px, py, w, h, radius);

        float headX = px + HEAD_PAD * sc;
        float headY = py + (h - HEAD * sc) / 2f;
        float headS = HEAD * sc;
        float headR = 6f * sc;

        MorzhSmoothRenderer.roundedRect(ctx, headX, headY, headS, headS, headR,
            DropDownColors.rgba(14, 14, 18, a));
        drawHead(ctx, entity, headX, headY, headS, a);

        float cx = px + CONTENT_X * sc;
        float rightPad = 8f * sc;
        float rightEdge = px + w - rightPad;
        float barX = cx;
        float barY = py + h - 11f * sc;
        float barW = rightEdge - cx;
        float barH = 3.5f * sc;
        float barR = 1.5f * sc;

        double nameFs = 0.58 * sc;
        double infoFs = 0.48 * sc;

        int hpInt = Math.round(hpAnim * maxHp);
        String hpText = String.valueOf(hpInt);
        float hpTw = (float) MorzhSmoothRenderer.textWidth(hpText, infoFs);
        float hpX = rightEdge - hpTw;
        float textGap = 5f * sc;

        String name = entity.getName().getString();
        String fittedName = MorzhSmoothRenderer.fitText(name, Math.max(0, hpX - cx - textGap), nameFs);
        MorzhSmoothRenderer.text(ctx, fittedName, cx, py + 7f * sc,
            DropDownColors.rgba(255, 255, 255, a), true, nameFs);
        MorzhSmoothRenderer.text(ctx, hpText, hpX, py + 7f * sc,
            DropDownColors.rgba(210, 210, 214, a), true, infoFs);

        drawArmorRow(ctx, entity, cx, py + 20f * sc, rightEdge, sc, a, infoFs);

        MorzhSmoothRenderer.roundedRect(ctx, barX, barY, barW, barH, barR,
            DropDownColors.rgba(25, 25, 30, (int) (220 * alpha)));

        float trailW = barW * hpTrail;
        float fillW = barW * hpAnim;
        if (trailW > fillW + 0.5f) {
            MorzhSmoothRenderer.roundedRect(ctx, barX, barY, trailW, barH, barR,
                DropDownColors.rgba(CLIENT >> 16 & 255, CLIENT >> 8 & 255, CLIENT & 255, (int) (120 * alpha)));
        }

        if (fillW > 0.5f) {
            MorzhSmoothRenderer.gradientRect(ctx, barX, barY, fillW, barH,
                DropDownColors.rgba(CLIENT >> 16 & 255, CLIENT >> 8 & 255, CLIENT & 255, a),
                DropDownColors.rgba((CLIENT >> 16 & 255) / 2, (CLIENT >> 8 & 255) / 2, (CLIENT & 255) / 2, a));
        }

        float abs = entity.getAbsorptionAmount();
        if (abs > 0.5f) {
            float absW = barW * MathHelper.clamp(abs / maxHp, 0f, 1f);
            MorzhSmoothRenderer.gradientRect(ctx, barX, barY, absW, barH,
                DropDownColors.rgba(255, 200, 0, a),
                DropDownColors.rgba(200, 140, 0, a));
        }
    }

    private void drawArmorRow(DrawContext ctx, LivingEntity entity, float x, float y, float rightEdge,
                              float sc, int alpha, double infoFs) {
        float slot = 9f * sc;
        float itemScale = 0.42f * sc;
        float itemSize = 16f * itemScale;
        float xOff = x;

        List<ItemStack> armor = armorStacks(entity);
        for (ItemStack stack : armor) {
            drawItemSlot(ctx, stack, xOff, y, slot, itemScale, itemSize, alpha);
            xOff += slot;
        }

        if (!(entity instanceof PlayerEntity player)) return;

        int totems = countItem(player, Items.TOTEM_OF_UNDYING);
        int egaps = countItem(player, Items.ENCHANTED_GOLDEN_APPLE);
        int gaps = countItem(player, Items.GOLDEN_APPLE);

        float pillH = 10f * sc;
        float pillY = y + (slot - pillH) / 2f;
        float pillX = rightEdge;

        if (gaps > 0) {
            String text = gaps + "g";
            float tw = (float) MorzhSmoothRenderer.textWidth(text, infoFs);
            float pw = tw + 6f * sc;
            pillX -= pw;
            MorzhSmoothRenderer.roundedRect(ctx, pillX, pillY, pw, pillH, 3f * sc,
                DropDownColors.rgba(30, 30, 36, alpha));
            MorzhSmoothRenderer.text(ctx, text, pillX + 3f * sc, pillY + 1f * sc,
                DropDownColors.rgba(255, 210, 80, alpha), true, infoFs);
            pillX -= 2f * sc;
        }

        if (egaps > 0) {
            String text = egaps + "c";
            float tw = (float) MorzhSmoothRenderer.textWidth(text, infoFs);
            float pw = tw + 6f * sc;
            pillX -= pw;
            MorzhSmoothRenderer.roundedRect(ctx, pillX, pillY, pw, pillH, 3f * sc,
                DropDownColors.rgba(30, 30, 36, alpha));
            MorzhSmoothRenderer.text(ctx, text, pillX + 3f * sc, pillY + 1f * sc,
                DropDownColors.rgba(255, 170, 220, alpha), true, infoFs);
            pillX -= 2f * sc;
        }

        if (totems > 0) {
            String text = String.valueOf(totems);
            float tw = (float) MorzhSmoothRenderer.textWidth(text, infoFs);
            float pw = tw + 6f * sc;
            pillX -= pw;
            MorzhSmoothRenderer.roundedRect(ctx, pillX, pillY, pw, pillH, 3f * sc,
                DropDownColors.rgba(30, 30, 36, alpha));
            MorzhSmoothRenderer.text(ctx, text, pillX + 3f * sc, pillY + 1f * sc,
                DropDownColors.rgba(200, 200, 210, alpha), true, infoFs);
            pillX -= 1f * sc;

            float icon = 8f * sc;
            pillX -= icon;
            ItemStack totem = new ItemStack(Items.TOTEM_OF_UNDYING);
            RenderUtils.drawItem(ctx, totem, Math.round(pillX), Math.round(y + (slot - icon) / 2f), icon / 16f, false);
        }
    }

    private void drawItemSlot(DrawContext ctx, ItemStack stack, float x, float y, float slot,
                              float itemScale, float itemSize, int alpha) {
        MorzhSmoothRenderer.roundedRect(ctx, x, y, slot - 1f, slot - 1f, 2f * itemScale,
            DropDownColors.rgba(22, 22, 28, alpha));

        if (!stack.isEmpty()) {
            float ix = x + (slot - itemSize) / 2f;
            float iy = y + (slot - itemSize) / 2f;
            RenderSystem.enableBlend();
            RenderSystem.setShaderColor(1f, 1f, 1f, alpha / 255f);
            RenderUtils.drawItem(ctx, stack, Math.round(ix), Math.round(iy), itemScale, true);
            RenderSystem.setShaderColor(1f, 1f, 1f, 1f);
        }
    }

    private List<ItemStack> armorStacks(LivingEntity entity) {
        if (isInEditor()) {
            return List.of(
                Items.NETHERITE_HELMET.getDefaultStack(),
                Items.NETHERITE_CHESTPLATE.getDefaultStack(),
                Items.NETHERITE_LEGGINGS.getDefaultStack(),
                Items.NETHERITE_BOOTS.getDefaultStack()
            );
        }

        if (!(entity instanceof PlayerEntity player)) {
            return List.of(ItemStack.EMPTY, ItemStack.EMPTY, ItemStack.EMPTY, ItemStack.EMPTY);
        }

        List<ItemStack> armor = new ArrayList<>(4);
        player.getArmorItems().forEach(armor::add);
        Collections.reverse(armor);
        return armor;
    }

    private static int countItem(PlayerEntity player, Item item) {
        int count = 0;
        for (int i = 0; i < player.getInventory().size(); i++) {
            ItemStack stack = player.getInventory().getStack(i);
            if (stack.isOf(item)) count += stack.getCount();
        }
        return count;
    }

    private void drawHead(DrawContext ctx, LivingEntity entity, float x, float y, float size, int alpha) {
        float tick = entity.hurtTime > 0 ? (float) HudRenderer.INSTANCE.delta : 0f;
        float hurt = MathHelper.clamp((entity.hurtTime - tick) / 10f, 0f, 1f);
        float shade = 1f - hurt * 0.55f;

        int ix = Math.round(x);
        int iy = Math.round(y);
        int is = Math.max(1, Math.round(size));

        RenderSystem.enableBlend();
        RenderSystem.setShaderColor(1f, shade, shade, alpha / 255f);

        SkinTextures skin = resolveSkin(entity);
        if (skin != null) {
            PlayerSkinDrawer.draw(ctx, skin, ix, iy, is);
            RenderSystem.setShaderColor(1f, 1f, 1f, 1f);
            return;
        }

        Identifier tex = resolveEntityTexture(entity);
        if (tex != null) {
            ctx.drawTexture(RenderLayer::getGuiTextured, tex, ix, iy, is, is, 8, 8, 8, 8, 64, 64);
            RenderSystem.setShaderColor(1f, 1f, 1f, 1f);
            return;
        }

        RenderSystem.setShaderColor(1f, 1f, 1f, 1f);
        MorzhSmoothRenderer.text(ctx, "?", x + size * 0.35f, y + size * 0.28f,
            DropDownColors.rgba(255, 255, 255, alpha), true, 0.55);
    }

    private static SkinTextures resolveSkin(LivingEntity entity) {
        if (entity instanceof AbstractClientPlayerEntity player) return player.getSkinTextures();
        if (entity instanceof PlayerEntity player && mc.getNetworkHandler() != null) {
            PlayerListEntry entry = mc.getNetworkHandler().getPlayerListEntry(player.getUuid());
            if (entry != null) return entry.getSkinTextures();
        }
        return null;
    }

    private LivingEntity resolveTarget() {
        if (isInEditor()) return mc.player;

        KillAura aura = Modules.get().get(KillAura.class);
        if (aura != null && aura.isActive()) {
            LivingEntity t = aura.getTargetEntity();
            if (t != null && t.isAlive()) return t;
        }

        if (mc.targetedEntity instanceof LivingEntity looked && looked.isAlive() && looked != mc.player) {
            return looked;
        }

        if (mc.currentScreen instanceof ChatScreen) return mc.player;
        return null;
    }

    private static Identifier resolveEntityTexture(LivingEntity entity) {
        EntityRenderer<?, ?> base = mc.getEntityRenderDispatcher().getRenderer(entity);
        if (base instanceof LivingEntityRenderer<?, ?, ?> living) {
            @SuppressWarnings("unchecked")
            LivingEntityRenderer<LivingEntity, LivingEntityRenderState, ?> renderer =
                (LivingEntityRenderer<LivingEntity, LivingEntityRenderState, ?>) living;
            LivingEntityRenderState state = renderer.getAndUpdateRenderState(entity, 1f);
            return renderer.getTexture(state);
        }
        return null;
    }

    private static float anim(float cur, float target, float dt, float speed) {
        if (Math.abs(cur - target) < 0.0005f) return target;
        return cur + (target - cur) * (1f - (float) Math.exp(-speed * dt));
    }
}



