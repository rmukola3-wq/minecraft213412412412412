package meteordevelopment.meteorclient.systems.hud;

import meteordevelopment.meteorclient.gui.morzh.MorzhSmoothRenderer;
import meteordevelopment.meteorclient.gui.morzh.dropdown.DropDownColors;
import net.minecraft.client.gui.DrawContext;

/**
 * Really Visual HUD chrome: dark rounded card, orange accent, duration pills.
 * Watermark still uses FIRST/SECOND split plates.
 */
public final class HudChrome {
    public static final int FIRST = DropDownColors.rgba(22, 22, 26, 220);
    public static final int SECOND = DropDownColors.rgba(14, 14, 17, 200);
    public static final int BG = SECOND;
    public static final int OUTLINE = DropDownColors.rgba(255, 255, 255, 22);
    public static final int TEXT = DropDownColors.rgba(210, 210, 214, 255);
    public static final int MUTED = DropDownColors.rgba(150, 150, 158, 255);
    public static final int ACCENT = DropDownColors.rgba(198, 198, 198, 255);

    public static final int RV_OUTER = -300871403;
    public static final int RV_INNER = -15461351;
    public static final int RV_INNER_SOFT = -15329764;
    public static final int RV_PILL = -14803418;
    public static final int RV_PILL_ALT = -14737626;
    public static final int RV_ORANGE = -38400;
    public static final int RV_BAR_BG = -15658731;
    public static final int RV_HP = -4802881;
    public static final int RV_HP_DOT = -8750459;
    public static final int RV_SLOT = -15198179;

    private HudChrome() {}

    public static void panel(DrawContext context, float x, float y, float w, float h, float radius) {
        card(context, x, y, w, h, Math.max(5f, radius));
    }

    public static void plate(DrawContext context, float x, float y, float w, float h, float radius) {
        card(context, x, y, w, h, Math.max(5f, radius));
    }

    public static void split(DrawContext context, float x, float y, float leftW, float totalW, float h, float radius) {
        float right = Math.max(0, totalW - leftW);
        MorzhSmoothRenderer.roundedRect(context, x, y, leftW, h, radius, FIRST);
        if (right > 0.5f) {
            MorzhSmoothRenderer.roundedRect(context, x + leftW - 1f, y, right + 1f, h, radius, SECOND);
        }
    }

    public static void headerBar(DrawContext context, float x, float y, float w, float h, float radius) {
        MorzhSmoothRenderer.roundedRect(context, x, y, w, h, radius, FIRST);
    }

    public static void row(DrawContext context, float x, float y, float leftW, float totalW, float h, float radius) {
        split(context, x, y, leftW, totalW, h, radius);
    }

    public static void title(DrawContext context, String title, float x, float y, float w, float s, double fs) {
