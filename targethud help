        MorzhFontRenderer.draw(context, text, x, y, packedColor, shadow);
    }

    public static void text(DrawContext context, String text, double x, double y, int packedColor, boolean shadow, double scale) {
        MorzhFontRenderer.draw(context, text, x, y, packedColor, shadow, scale);
    }

    public static double textWidth(String text) {
        return MorzhFontRenderer.width(text);
    }

    public static double textWidth(String text, double scale) {
        return MorzhFontRenderer.width(text, scale);
    }

    public static double textHeight() {
        return MorzhFontRenderer.height();
    }

    public static double textHeight(double scale) {
        return MorzhFontRenderer.height(scale);
    }

    public static String fitText(String text, double maxWidth) {
        return fitText(text, maxWidth, 1.0);
    }

    public static String fitText(String text, double maxWidth, double scale) {
        if (text == null || text.isEmpty()) return "";
        if (maxWidth <= 0) return "";
        if (textWidth(text, scale) <= maxWidth) return text;

        double ellipsisWidth = textWidth("вЂ¦", scale);
        if (ellipsisWidth > maxWidth) return "";

        StringBuilder builder = new StringBuilder();
        double used = 0;

        for (int i = 0; i < text.length(); i++) {
            double charWidth = textWidth(String.valueOf(text.charAt(i)), scale);
            if (used + charWidth + ellipsisWidth > maxWidth) break;
            builder.append(text.charAt(i));
            used += charWidth;
        }

        return builder.append('вЂ¦').toString();
    }

    private static void fill(Renderer2D r, double x, double y, double w, double h, double radius, Color color) {
        if (w <= 0 || h <= 0) return;

        radius = Math.max(0, Math.min(radius, Math.min(w, h) / 2.0));

        if (radius < 0.5) {
            r.quad(x, y, w, h, color);
            return;
        }

        r.quad(x + radius, y, w - radius * 2, h, color);
        r.quad(x, y + radius, radius, h - radius * 2, color);
        r.quad(x + w - radius, y + radius, radius, h - radius * 2, color);

        arc(r, x + radius, y + radius, radius, 180, 270, CORNER_SEGMENTS, color);
        arc(r, x + w - radius, y + radius, radius, 270, 360, CORNER_SEGMENTS, color);
        arc(r, x + w - radius, y + h - radius, radius, 0, 90, CORNER_SEGMENTS, color);
        arc(r, x + radius, y + h - radius, radius, 90, 180, CORNER_SEGMENTS, color);
    }

    private static void arc(Renderer2D r, double cx, double cy, double radius, double startDeg, double endDeg, int segments, Color color) {
        double startRad = Math.toRadians(startDeg);
        double stepRad = Math.toRadians(endDeg - startDeg) / segments;

        double prevX = cx + Math.cos(startRad) * radius;
        double prevY = cy + Math.sin(startRad) * radius;

        for (int i = 1; i <= segments; i++) {
            double angle = startRad + stepRad * i;
            double px = cx + Math.cos(angle) * radius;
            double py = cy + Math.sin(angle) * radius;

            r.triangle(cx, cy, prevX, prevY, px, py, color);

            prevX = px;
            prevY = py;
        }
    }

    private static void feather(Renderer2D r, double x, double y, double w, double h, double radius, Color base) {
        Color solid = base.copy();
        Color clear = base.copy();
        clear.a(0);

        r.quad(x + radius, y - AA_FEATHER, w - radius * 2, AA_FEATHER, clear, clear, solid, solid);
        r.quad(x + radius, y + h, w - radius * 2, AA_FEATHER, solid, solid, clear, clear);
        r.quad(x - AA_FEATHER, y + radius, AA_FEATHER, h - radius * 2, clear, solid, solid, clear);
        r.quad(x + w, y + radius, AA_FEATHER, h - radius * 2, solid, clear, clear, solid);

        featherCorner(r, x + radius, y + radius, radius, 180, 270, solid);
        featherCorner(r, x + w - radius, y + radius, radius, 270, 360, solid);
        featherCorner(r, x + w - radius, y + h - radius, radius, 0, 90, solid);
        featherCorner(r, x + radius, y + h - radius, radius, 90, 180, solid);
    }

    private static void featherCorner(Renderer2D r, double cx, double cy, double radius, double startDeg, double endDeg, Color solid) {
        Mesh mesh = r.triangles;

        Color clear = solid.copy();
        clear.a(0);

        double startRad = Math.toRadians(startDeg);
        double stepRad = Math.toRadians(endDeg - startDeg) / CORNER_SEGMENTS;

        double prevOutX = cx + Math.cos(startRad) * (radius + AA_FEATHER);
        double prevOutY = cy + Math.sin(startRad) * (radius + AA_FEATHER);
        double prevInX = cx + Math.cos(startRad) * radius;
        double prevInY = cy + Math.sin(startRad) * radius;

        for (int i = 1; i <= CORNER_SEGMENTS; i++) {
            double angle = startRad + stepRad * i;

            double outX = cx + Math.cos(angle) * (radius + AA_FEATHER);
            double outY = cy + Math.sin(angle) * (radius + AA_FEATHER);
            double inX = cx + Math.cos(angle) * radius;
            double inY = cy + Math.sin(angle) * radius;

            int i1 = mesh.vec2(prevInX, prevInY).color(solid).next();
            int i2 = mesh.vec2(prevOutX, prevOutY).color(clear).next();
            int i3 = mesh.vec2(outX, outY).color(clear).next();
            int i4 = mesh.vec2(inX, inY).color(solid).next();

            mesh.quad(i1, i2, i3, i4);

            prevOutX = outX; prevOutY = outY;
            prevInX = inX; prevInY = inY;
        }
    }

    private static Color unpack(int packedColor) {
        return new Color(packedColor >> 16 & 255, packedColor >> 8 & 255, packedColor & 255, packedColor >>> 24);
    }
}



