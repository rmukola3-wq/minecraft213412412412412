package meteordevelopment.meteorclient.utils.render;

import meteordevelopment.meteorclient.gui.rasty.util.render.pipeline.GlDraw;
import meteordevelopment.meteorclient.renderer.GL;
import meteordevelopment.meteorclient.renderer.Shader;
import net.minecraft.client.MinecraftClient;
import net.minecraft.client.texture.AbstractTexture;
import net.minecraft.util.Identifier;

/** Rounded head texture draw for HUD (scaled GUI coordinates). */
public final class HeadPipeline {
    private static final float FIXED_GUI_SCALE = 2.0f;
    private Shader shader;

    private void ensureShader() {
        if (shader == null) shader = new Shader("round_head.vert", "round_head.frag");
    }

    public void draw(Identifier textureId, float x, float y, float width, float height,
                     float u0, float v0, float u1, float v1,
                     float radius, float alpha, float hurt) {
        MinecraftClient client = MinecraftClient.getInstance();
        if (client.getFramebuffer() == null || textureId == null) return;

        AbstractTexture texture = client.getTextureManager().getTexture(textureId);
        if (texture == null) return;

        float screenW = client.getWindow().getFramebufferWidth() / FIXED_GUI_SCALE;
        float screenH = client.getWindow().getFramebufferHeight() / FIXED_GUI_SCALE;

        ensureShader();
        GL.bindTexture(texture.getGlId(), 0);
        shader.bind();
        shader.set("Sampler0", 0);
        shader.set("u_Rect", x, y, width, height);
        shader.set("u_Uv", u0, v0, u1, v1);
        shader.set("u_Radii", radius, radius, radius, radius);
        shader.set("u_Rotation", 0, 0, 0, 0);
        shader.set("u_Screen", screenW, screenH, 1f, FIXED_GUI_SCALE);
        shader.set("hurt_time", hurt);
        shader.set("alpha", alpha);
        GlDraw.triangles(6);
    }
}



