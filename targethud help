/** Target HUD вЂ” Morzh panel, vanilla head draw, armor + consumables. */
public class TargetHud extends HudElement implements HudScalableElement {
    private static final float BASE_W = 152f;
    private static final float BASE_H = 58f;
    private static final float HEAD = 36f;
    private static final float HEAD_PAD = 8f;
    private static final float CONTENT_X = HEAD_PAD + HEAD + 7f;
    private static final int CLIENT = DropDownColors.rgb(129, 135, 255);
    private static final float MIN_SCALE = 0.5f;
    private static final float MAX_SCALE = 3f;

    public static final HudElementInfo<TargetHud> INFO = new HudElementInfo<>(
        Hud.GROUP, "target",
        "Target HUD: portrait, name, armor, HP.",
        TargetHud::new
    );

    private final SettingGroup sg = settings.getDefaultGroup();

    private final Setting<Double> scale = sg.add(new DoubleSetting.Builder()
        .name("scale")
        .description("HUD scale.")
        .defaultValue(1.0)
        .min(MIN_SCALE)
        .sliderMax(MAX_SCALE)
        .onChanged(v -> calculateSize())
        .build()
    );

    private LivingEntity lastTarget;
    private float fade;
    private float hpAnim;
    private float hpTrail;
    private long lastFrameNs;

    public TargetHud() {
        super(INFO);
        calculateSize();
    }

    @Override
    public void adjustScale(double delta) {
        scale.set(MathHelper.clamp(scale.get() + delta, MIN_SCALE, MAX_SCALE));
        calculateSize();
    }

    @Override
    public double getScaleValue() {
        return scale.get();
    }

    private float s() {
        return scale.get().floatValue();
    }

    private void calculateSize() {
        setSize(BASE_W * s(), BASE_H * s());
    }

    @Override
    public void tick(HudRenderer renderer) {
        LivingEntity t = resolveTarget();
        if (t != null) lastTarget = t;
    }

    @Override
    public void render(HudRenderer renderer) {
        long now = System.nanoTime();
        float dt = lastFrameNs == 0 ? 0.016f : MathHelper.clamp((now - lastFrameNs) / 1_000_000_000f, 0f, 0.05f);
        lastFrameNs = now;

        LivingEntity target = isInEditor() ? mc.player : resolveTarget();
        if (target != null) lastTarget = target;

        boolean show = lastTarget != null && (target != null || isInEditor() || mc.currentScreen instanceof ChatScreen);
        fade = anim(fade, show ? 1f : 0f, dt, 12f);
        if (fade < 0.03f || lastTarget == null) return;

        LivingEntity entity = lastTarget;
        float a = fade;
        float sc = s();
        float w = BASE_W * sc;
        float h = BASE_H * sc;

        float maxHp = Math.max(1f, entity.getMaxHealth());
        float hp = ScoreboardHelper.getHealthBelowName(entity);
        float hpPct = MathHelper.clamp(hp / maxHp, 0f, 1f);
        hpAnim = anim(hpAnim, hpPct, dt, 14f);
        if (hpTrail > hpAnim + 0.002f) hpTrail = anim(hpTrail, hpAnim, dt, 6f);
        else hpTrail = hpAnim;

        renderer.post(() -> {
            DrawContext ctx = HudRenderer.INSTANCE.drawContext;
            if (ctx == null) return;
            draw(ctx, entity, x, y, w, h, sc, a, hp, maxHp);
        });
    }

    // ... (РїРѕР»РЅС‹Р№ РєРѕРґ СЃРј. РІ СЂРµРїРѕ вЂ” 396 СЃС‚СЂРѕРє, РІРєР»СЋС‡Р°СЏ draw, drawArmorRow, drawHead, resolveTarget)
}

