package meteordevelopment.meteorclient.gui.rasty.util.render.pipeline;

import meteordevelopment.meteorclient.renderer.GL;
import org.lwjgl.opengl.GL32C;

public final class GlDraw {
    private static int vao;

    private GlDraw() {}

    public static void triangles(int vertices) {
        int prevProgram = GL32C.glGetInteger(GL32C.GL_CURRENT_PROGRAM);
        int prevVao = GL32C.glGetInteger(GL32C.GL_VERTEX_ARRAY_BINDING);

        if (vao == 0) vao = GL.genVertexArray();
        GL.disableCull();
        GL.enableBlend();
        GL.disableDepth();
        GL.bindVertexArray(vao);
        GL32C.glDrawArrays(GL32C.GL_TRIANGLES, 0, vertices);

        GL.bindVertexArray(prevVao);
        GL.useProgram(prevProgram);
    }
}



