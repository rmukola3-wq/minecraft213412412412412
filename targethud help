import static meteordevelopment.meteorclient.MeteorClient.mc;

public class ArmorHud extends HudElement implements HudScalableElement {
    public static final HudElementInfo<ArmorHud> INFO = new HudElementInfo<>(Hud.GROUP, "armor", "Displays your armor.", ArmorHud::new);

    private static final float BASE_ITEM = 16f;
    private static final float BASE_GAP = 2f;
    private static final float BASE_PAD = 6f;

    private final SettingGroup sgGeneral = settings.getDefaultGroup();
    private final SettingGroup sgStyle = settings.createGroup("Style");
    private final SettingGroup sgDurability = settings.createGroup("Durability");

    private final Setting<Mode> mode = sgStyle.add(new EnumSetting.Builder<Mode>()
        .name("mode")
        .description("Visual style of the armor display.")
        .defaultValue(Mode.V2)
        .onChanged(m -> calculateSize())
        .build()
    );

    private final Setting<Orientation> orientation = sgGeneral.add(new EnumSetting.Builder<Orientation>()
        .name("orientation")
        .description("How to display armor.")
        .defaultValue(Orientation.Horizontal)
        .onChanged(val -> calculateSize())
        .build()
    );

    private final Setting<Boolean> flipOrder = sgGeneral.add(new BoolSetting.Builder()
        .name("flip-order")
        .description("Flips the order of armor items.")
        .defaultValue(true)
        .build()
    );

    private final Setting<Double> scale = sgGeneral.add(new DoubleSetting.Builder()
        .name("scale")
        .description("The scale.")
        .defaultValue(1)
        .onChanged(aDouble -> calculateSize())
        .min(0.5)
        .sliderRange(0.5, 5)
        .build()
    );

    private final Setting<Integer> roundness = sgStyle.add(new IntSetting.Builder()
        .name("roundness")
        .description("Corner radius of the panel.")
        .defaultValue(6)
        .min(0)
        .sliderMax(16)
        .build()
    );

    private final Setting<SettingColor> backgroundColor = sgStyle.add(new ColorSetting.Builder()
        .name("background-color")
        .description("Panel background color.")
        .defaultValue(new SettingColor(20, 20, 25, 230))
        .build()
    );

    private final Setting<SettingColor> outlineColor = sgStyle.add(new ColorSetting.Builder()
        .name("outline-color")
        .description("Panel outline color.")
        .defaultValue(new SettingColor(48, 53, 60, 255))
        .build()
    );

    private final Setting<Durability> durability = sgDurability.add(new EnumSetting.Builder<Durability>()
        .name("durability")
        .description("How to display armor durability.")
        .defaultValue(Durability.Percentage)
        .onChanged(durability1 -> calculateSize())
        .build()
    );

    private final Setting<SettingColor> durabilityColor = sgDurability.add(new ColorSetting.Builder()
        .name("durability-color")
        .description("Color of the durability text.")
        .visible(() -> durability.get() == Durability.Total || durability.get() == Durability.Percentage)
        .defaultValue(new SettingColor(161, 164, 177))
        .build()
    );

    private final Setting<Boolean> durabilityShadow = sgDurability.add(new BoolSetting.Builder()
        .name("durability-shadow")
        .description("Text shadow.")
        .visible(() -> durability.get() == Durability.Total || durability.get() == Durability.Percentage)
        .defaultValue(false)
        .build()
    );

    public ArmorHud() {
        super(INFO);
        calculateSize();
    }

    @Override
    public void adjustScale(double delta) {
        scale.set(MathHelper.clamp(scale.get() + delta, 0.5, 5.0));
        calculateSize();
    }

    @Override
    public double getScaleValue() {
        return scale.get();
    }

    private void calculateSize() {
        float itemSize = BASE_ITEM * scale.get().floatValue();
        float gap = BASE_GAP * scale.get().floatValue();
        float pad = BASE_PAD * scale.get().floatValue();

        if (orientation.get() == Orientation.Horizontal) {
            setSize(pad * 2 + itemSize * 4 + gap * 3, pad * 2 + itemSize);
        }
        else {
            setSize(pad * 2 + itemSize, pad * 2 + itemSize * 4 + gap * 3);
        }
    }

    @Override
    public void render(HudRenderer renderer) {
        float w = getWidth();
        float h = getHeight();
        float pad = BASE_PAD * scale.get().floatValue();
        float itemSize = BASE_ITEM * scale.get().floatValue();
        float gap = BASE_GAP * scale.get().floatValue();
        float spacing = itemSize + gap;
        float itemScale = scale.get().floatValue();
        float radius = roundness.get();

        MorzhSmoothRenderer.roundedRectNoBegin(renderer.drawContext, x, y, w, h, Math.max(5.5f, radius),
            HudChrome.RV_OUTER);
        MorzhSmoothRenderer.roundedRectNoBegin(renderer.drawContext, x + 1, y + 1, w - 2, h - 2, Math.max(4.5f, radius - 0.5f),
            HudChrome.RV_INNER);

        float startX = x + pad;
        float startY = y + pad;

        renderer.post(() -> renderArmorItems(
            HudRenderer.INSTANCE.drawContext != null ? HudRenderer.INSTANCE.drawContext : renderer.drawContext,
            startX, startY, itemScale, spacing, itemSize
        ));
    }

    private void renderArmorItems(DrawContext context, float startX, float startY, float itemScale, float spacing, float itemSize) {
        int slot = flipOrder.get() ? 3 : 0;

        for (int position = 0; position < 4; position++) {
            ItemStack stack = getItem(slot);
            float drawX = orientation.get() == Orientation.Horizontal ? startX + position * spacing : startX;
            float drawY = orientation.get() == Orientation.Vertical ? startY + position * spacing : startY;
            int ix = Math.round(drawX);
            int iy = Math.round(drawY);
            int pixelSize = Math.max(1, Math.round(itemSize));

            boolean overlayBar = stack.isDamageable() && durability.get() == Durability.Bar;

            if (mode.get() == Mode.V2 && stack.isDamageable() && durability.get() == Durability.Bar) {
                RenderSystem.setShaderColor(0.4f, 0.4f, 0.4f, 0.35f);
                RenderUtils.drawItem(context, stack, ix, iy, itemScale, false);
                RenderSystem.setShaderColor(1f, 1f, 1f, 1f);

                float ratio = 1f - (float) stack.getDamage() / stack.getMaxDamage();
                float headOffset = slot == 3 ? -4f * itemScale : 0f;

                int clipTop = iy + Math.round(headOffset + (itemSize - headOffset) * (1f - ratio));
                int clipBottom = iy + Math.round(headOffset + itemSize);
                context.enableScissor(ix, clipTop, ix + pixelSize, clipBottom);
                RenderUtils.drawItem(context, stack, ix, iy, itemScale, true);
                context.disableScissor();
            }
            else {
                RenderUtils.drawItem(context, stack, ix, iy, itemScale, overlayBar);
            }

            if (stack.isDamageable() && !isInEditor() && durability.get() != Durability.Bar && durability.get() != Durability.None) {
                String message = switch (durability.get()) {
                    case Total -> Integer.toString(stack.getMaxDamage() - stack.getDamage());
                    case Percentage -> Math.round(((stack.getMaxDamage() - stack.getDamage()) * 100f) / (float) stack.getMaxDamage()) + "%";
                    default -> "";
                };

                double messageWidth = MorzhSmoothRenderer.textWidth(message);
                float textX = drawX + itemSize / 2f - (float) messageWidth / 2f;
                float textY = drawY + itemSize - (float) MorzhSmoothRenderer.textHeight() + 1;
                MorzhSmoothRenderer.text(context, message, textX, textY, durabilityColor.get().getPacked(), durabilityShadow.get());
            }

            if (flipOrder.get()) slot--;
            else slot++;
        }
    }

    private ItemStack getItem(int i) {
        if (isInEditor()) {
            return switch (i) {
                case 1 -> Items.NETHERITE_LEGGINGS.getDefaultStack();
                case 2 -> Items.NETHERITE_CHESTPLATE.getDefaultStack();
                case 3 -> Items.NETHERITE_HELMET.getDefaultStack();
                default -> Items.NETHERITE_BOOTS.getDefaultStack();
            };
        }

        return mc.player.getInventory().getArmorStack(i);
    }

    public enum Mode {
        V1,
        V2;

        @Override
        public String toString() {
            return name();
        }
    }

    public enum Durability {
        None,
        Bar,
        Total,
        Percentage
    }

    public enum Orientation {
        Horizontal,
        Vertical
    }
}



