public class TargetHud extends AbstractHudElement {

    private final StopWatch stopWatch    = new StopWatch();
    private final StopWatch hitStopWatch = new StopWatch();

    private LivingEntity lastTarget;
    private int prevHurtTime = 0;

    private float healthAnimation     = 0;
    private float trailAnimation      = 0;
    private float absorptionAnimation = 0;
    private float displayedHealth     = 0;
    private long  lastUpdateTime      = System.currentTimeMillis();
    private long  startTime           = System.currentTimeMillis();

    private float damageFlashFrom     = 0f;
    private float damageFlashTo       = 0f;
    private long  damageFlashStart    = 0L;
    private float prevHealthForDamage = -1f;
    private static final long  DAMAGE_FLASH_MS  = 700L;
    private static final float DAMAGE_MIN_DELTA = 0.005f;

    private float shakeIntensity = 0f;
    private float shakeOffsetX   = 0f;
    private float shakeOffsetY   = 0f;
    private long  lastShakeFlip  = 0;

    private static final float SHAKE_DECAY      = 10f;
    private static final float SHAKE_MAX_OFFSET = 5.5f;
    private static final long  SHAKE_FLIP_MS    = 22;

    private static final int   HUD_WIDTH     = 152;
    private static final int   HUD_HEIGHT    = 52;
    private static final float FACE_SIZE     = 36f;
    private static final float FACE_PAD_X    = 8f;
    private static final float CONTENT_X_OFF = FACE_PAD_X + FACE_SIZE + 7f;

    public TargetHud() {
        super("TargetHud", 10, 80, HUD_WIDTH, HUD_HEIGHT, true);
    }

    @Override
    public boolean visible() { return true; }

    public void setHitTarget(LivingEntity entity) {
        if (entity == null || entity == mc.player) return;
        lastTarget   = entity;
        prevHurtTime = 0;
        hitStopWatch.reset();
        startAnimation();
        triggerShake(1.0f);
    }

    private void triggerShake(float intensity) {
        shakeIntensity = Math.min(2.0f, shakeIntensity + intensity);
    }

    @Override
    public void tick() {
        LivingEntity auraTarget = Aura.target;

        if (auraTarget != null) {
            lastTarget = auraTarget;
            startAnimation();
            stopWatch.reset();
            hitStopWatch.reset();
        } else if (isChat(mc.currentScreen)) {
            lastTarget = mc.player;
            startAnimation();
            stopWatch.reset();
        } else {
            if (!hitStopWatch.finished(3000)) {
                startAnimation();
            } else if (stopWatch.finished(10)) {
                stopAnimation();
            }
        }

        if (auraTarget == null && mc.player != null && mc.world != null) {
            LivingEntity hitCandidate = findRecentlyHitEntity();
            if (hitCandidate != null) {
                lastTarget   = hitCandidate;
                prevHurtTime = hitCandidate.hurtTime;
                hitStopWatch.reset();
                startAnimation();
                triggerShake(1.0f);
            }
        }

        if (lastTarget != null) {
            int cur = lastTarget.hurtTime;
            if (cur > prevHurtTime && cur >= 8) {
                triggerShake(1.0f);
                if (auraTarget == null) {
                    hitStopWatch.reset();
                    startAnimation();
                }
            }
            prevHurtTime = cur;
        } else {
            prevHurtTime = 0;
        }
    }

    private LivingEntity findRecentlyHitEntity() {
        if (mc.player == null || mc.world == null) return null;
        LivingEntity best = null;
        int bestHurt = 0;
        for (var entity : mc.world.getEntities()) {
            if (!(entity instanceof LivingEntity living)) continue;
            if (living == mc.player) continue;
            if (!living.isAlive()) continue;
            if (living.distanceTo(mc.player) > 6.0) continue;
            if (living.hurtTime >= 9) {
                if (living == lastTarget && living.hurtTime == prevHurtTime) continue;
                if (living.hurtTime > bestHurt) {
                    bestHurt = living.hurtTime;
                    best = living;
                }
            }
        }
        return best;
    }

    private float lerp(float current, float target, float deltaTime, float speed) {
        float factor = (float)(1.0 - Math.pow(0.001, deltaTime * speed));
        return current + (target - current) * factor;
    }

    private float snapToStep(float value, float step) {
        return Math.round(value / step) * step;
    }

    private float getHealth(LivingEntity entity) {
        if (entity.isInvisible() && !Network.isSpookyTime() && !Network.isCopyTime())
            return entity.getMaxHealth();
        Hud hud = Hud.getInstance();
        if (hud != null && hud.useScoreboard.isValue()
                && entity instanceof PlayerEntity player && mc.world != null) {
            try {
                ScoreboardObjective obj = mc.world.getScoreboard()
                        .getObjectiveForSlot(ScoreboardDisplaySlot.BELOW_NAME);
                if (obj != null) {
                    ScoreAccess score = mc.world.getScoreboard().getOrCreateScore(player, obj);
                    if (score != null) return (float) score.getScore();
                }
            } catch (Exception ignored) {}
        }
        return entity.getHealth();
    }

    private String getHealthString(float health) {
        if (lastTarget != null && lastTarget.isInvisible()
                && !Network.isSpookyTime() && !Network.isCopyTime()) return "??";
        if (health >= 100) return String.valueOf((int) health);
        else if (health >= 10) return String.format("%.1f", health);
        else return String.format("%.2f", health);
    }

    @Override
    public void drawDraggable(DrawContext context, int alpha) {
        if (alpha <= 0) return;
        if (lastTarget == null) return;

        long  currentTime = System.currentTimeMillis();
        float deltaTime   = (currentTime - lastUpdateTime) / 1000.0f;
        lastUpdateTime    = currentTime;
        deltaTime         = Math.min(deltaTime, 0.1f);

        if (shakeIntensity > 0.005f) {
            shakeIntensity = lerp(shakeIntensity, 0f, deltaTime, SHAKE_DECAY);
            long now = System.currentTimeMillis();
            if (now - lastShakeFlip > SHAKE_FLIP_MS) {
                lastShakeFlip = now;
                double angle = Math.random() * Math.PI * 2;
                float  boost = shakeIntensity > 0.8f ? 1.6f : (shakeIntensity > 0.4f ? 1.2f : 1.0f);
                shakeOffsetX = (float)(Math.cos(angle) * SHAKE_MAX_OFFSET * shakeIntensity * boost);
                shakeOffsetY = (float)(Math.sin(angle) * SHAKE_MAX_OFFSET * shakeIntensity * boost);
            }
        } else {
            shakeIntensity = 0f;
            shakeOffsetX   = 0f;
            shakeOffsetY   = 0f;
        }

        setWidth(HUD_WIDTH);
        setHeight(HUD_HEIGHT);

        float x = getX(), y = getY();
        float scaleAlpha = scaleAnimation.getOutput().floatValue();

        drawBackground(x, y, scaleAlpha);
        drawFace(x, y, scaleAlpha);
        drawContent(x, y, scaleAlpha, deltaTime);
    }

    private void drawBackground(float x, float y, float alpha) {
        int alphaInt = (int)(255 * alpha);
        Render2D.blur(x + 2, y + 2, getWidth() - 4, getHeight() - 4, 15f, 6f, 0x00000000);
        Render2D.gradientRect(x + 2, y + 2, getWidth() - 4, getHeight() - 4,
                new int[]{
                        new Color(15, 15, 15, 90).getRGB(),
                        new Color(8,  8,  8, 110).getRGB(),
                        new Color(15, 15, 15, 90).getRGB(),
                        new Color(8,  8,  8, 110).getRGB()
                }, 6);
        Render2D.outline(x + 2, y + 2, getWidth() - 4, getHeight() - 4, 0.35f,
                new Color(90, 90, 90, alphaInt).getRGB(), 5);
    }

    private void drawFace(float x, float y, float alpha) {
        EntityRenderer<? super LivingEntity, ?> baseRenderer =
                mc.getEntityRenderDispatcher().getRenderer(lastTarget);
        if (!(baseRenderer instanceof LivingEntityRenderer<?, ?, ?>)) return;

        @SuppressWarnings("unchecked")
        LivingEntityRenderer<LivingEntity, LivingEntityRenderState, ?> renderer =
                (LivingEntityRenderer<LivingEntity, LivingEntityRenderState, ?>) baseRenderer;

        LivingEntityRenderState state = renderer.getAndUpdateRenderState(lastTarget, lastTickDelta);
        Identifier tex = renderer.getTexture(state);

        float faceX = x + FACE_PAD_X + shakeOffsetX;
        float faceY = y + (HUD_HEIGHT - FACE_SIZE) / 2f + shakeOffsetY;

        float hurt = lastTarget.hurtTime > 0 ? lastTarget.hurtTime / 10.0f : 0f;
        int color  = new Color(255, (int)(255*(1f-hurt)), (int)(255*(1f-hurt)), (int)(255*alpha)).getRGB();

        Render2D.texture(tex, faceX, faceY, FACE_SIZE, FACE_SIZE,
                8f/64f, 8f/64f, 16f/64f, 16f/64f, color, 0, 5f);
        float hatSize = FACE_SIZE * 1.1f, hatOff = (hatSize - FACE_SIZE) / 2f;
        Render2D.texture(tex, faceX - hatOff, faceY - hatOff, hatSize, hatSize,
                40f/64f, 8f/64f, 48f/64f, 16f/64f, color, 0f, 5f);
    }

    private void drawContent(float x, float y, float alpha, float deltaTime) {
        float hp     = getHealth(lastTarget);
        float maxHp  = lastTarget.getMaxHealth();
        float absorp = lastTarget.getAbsorptionAmount();

        boolean isInvisible = lastTarget.isInvisible()
                && !Network.isSpookyTime() && !Network.isCopyTime();

        float curHpPercent = isInvisible ? 1f : hp / maxHp;
        if (prevHealthForDamage < 0f) {
            prevHealthForDamage = curHpPercent;
        } else {
            float delta = prevHealthForDamage - curHpPercent;
            if (delta > DAMAGE_MIN_DELTA) {
                if (System.currentTimeMillis() - damageFlashStart < DAMAGE_FLASH_MS) {
                    damageFlashFrom = Math.max(damageFlashFrom, prevHealthForDamage);
                } else {
                    damageFlashFrom = prevHealthForDamage;
                }
                damageFlashTo    = curHpPercent;
                damageFlashStart = System.currentTimeMillis();
            } else if (delta < -DAMAGE_MIN_DELTA) {
                if (curHpPercent >= damageFlashFrom) {
                    damageFlashStart = 0L;
                }
            }
            prevHealthForDamage = curHpPercent;
        }

        float targetDisplayHealth = isInvisible ? maxHp : hp + absorp;
        displayedHealth = lerp(displayedHealth, targetDisplayHealth, deltaTime, 5f);
        String hpStr = getHealthString(snapToStep(displayedHealth, 0.25f));

        // в”Ђв”Ђ Р¤РРљРЎ: РµСЃР»Рё С‚Р°СЂРіРµС‚ вЂ” СЃР°Рј РёРіСЂРѕРє Рё NameProtect РІРєР»СЋС‡С‘РЅ вЂ” РїРѕРєР°Р·С‹РІР°РµРј Р·Р°С‰РёС‰С‘РЅРЅРѕРµ РёРјСЏ
        NameProtect np = Instance.get(NameProtect.class);
        String name;
        if (lastTarget == mc.player && np != null && np.isState()) {
            try {
                java.lang.reflect.Field nameSettingField = NameProtect.class.getDeclaredField("nameSetting");
                nameSettingField.setAccessible(true);
                rasty.modules.module.setting.implement.TextSetting nameSetting = (rasty.modules.module.setting.implement.TextSetting) nameSettingField.get(np);
                name = nameSetting.getText();
            } catch (Exception e) {
                name = lastTarget.getName().getString();
            }
        } else {
            name = lastTarget.getName().getString();
        }

        float cx        = x + CONTENT_X_OFF;
        float rightEdge = x + getWidth() - 8f;

        float row1 = y + 9f;
        float row2 = y + 19f;
        float row3 = y + 29f;
        float barY = y + getHeight() - 13f;

        float hpWidth = Fonts.BOLD.getWidth(hpStr, 6.5f);
        Fonts.BOLD.draw(name, cx, row1, 6.5f,
                new Color(255, 255, 255, (int)(255 * alpha)).getRGB());
        Fonts.BOLD.draw(hpStr, rightEdge - hpWidth, row1, 6.5f,
                new Color(215, 215, 215, (int)(255 * alpha)).getRGB());

        float dist = mc.player != null ? (float) mc.player.distanceTo(lastTarget) : 0f;
        Fonts.BOLD.draw(String.format("%.1f blk", dist), cx, row2, 6.0f,
                new Color(140, 140, 148, (int)(190 * alpha)).getRGB());

        float   myHp    = mc.player != null ? mc.player.getHealth() : 0f;
        boolean winning = myHp >= hp;
        Color   statusClr = winning
                ? new Color(100, 205, 100, (int)(210 * alpha))
                : new Color(210, 75,  75,  (int)(210 * alpha));
        Render2D.rect(cx, row3 + 1f, 4f, 4f, statusClr.getRGB(), 2f);
        Fonts.BOLD.draw(winning ? "Winning" : "Losing", cx + 6.5f, row3, 6.0f, statusClr.getRGB());

        float barWidth  = rightEdge - cx;
        float barHeight = 3.5f;
        float barRadius = 1.5f;

        Render2D.rect(cx, barY, barWidth, barHeight,
                new Color(25, 25, 25, (int)(210 * alpha)).getRGB(), barRadius);

        float targetHealth  = isInvisible ? 1.0f : hp / maxHp;
        healthAnimation     = lerp(healthAnimation, targetHealth, deltaTime, 3f);
        if (targetHealth > trailAnimation) trailAnimation = targetHealth;
        trailAnimation      = lerp(trailAnimation, targetHealth, deltaTime, 3.5f);

        float healthPercent = Math.max(0, Math.min(1, healthAnimation));
        float trailPercent  = Math.max(0, Math.min(1, trailAnimation));

        if (trailPercent > healthPercent) {
            Render2D.rect(cx, barY, barWidth * trailPercent, barHeight,
                    new Color(55, 55, 55, (int)(160 * alpha)).getRGB(), barRadius);
        }

        long flashElapsed = System.currentTimeMillis() - damageFlashStart;
        if (damageFlashStart > 0 && flashElapsed < DAMAGE_FLASH_MS
                && damageFlashFrom > damageFlashTo + DAMAGE_MIN_DELTA) {
            float flashProgress = (float) flashElapsed / DAMAGE_FLASH_MS;
            float flashAlpha    = (float) Math.pow(1f - flashProgress, 1.5f);
            float flashLeft     = cx + barWidth * Math.max(0, damageFlashTo);
            float flashRight    = cx + barWidth * Math.min(1, damageFlashFrom);
            float flashW        = flashRight - flashLeft;
            if (flashW > 0.5f) {
                int flashColor = new Color(220, 50, 50, (int)(200 * flashAlpha * alpha)).getRGB();
                int glowColor  = new Color(255, 80, 80, (int)(80 * flashAlpha * alpha)).getRGB();
                Render2D.rect(flashLeft, barY - 0.5f, flashW, barHeight + 1f, glowColor, barRadius);
                Render2D.rect(flashLeft, barY, flashW, barHeight, flashColor, barRadius);
            }
        }

        if (healthPercent > 0.01f) {
            long  elapsed   = System.currentTimeMillis() - startTime;
            float wavePhase = (elapsed % 1500L) / 1500f * (float)(Math.PI * 2);
            int[] colors    = new int[4];
            for (int i = 0; i < 2; i++) {
                int g2 = (int)(155 + 100 * ((Math.sin(wavePhase - i * 1.5f) + 1f) / 2f));
                colors[i*2]   = new Color(g2, g2, g2, (int)(255*alpha)).getRGB();
                colors[i*2+1] = new Color(g2, g2, g2, (int)(255*alpha)).getRGB();
            }
            Render2D.gradientRect(cx, barY, barWidth * healthPercent, barHeight, colors, barRadius);
        }

        float targetAbsorption  = isInvisible ? 0 : absorp / maxHp;
        absorptionAnimation     = lerp(absorptionAnimation, targetAbsorption, deltaTime, 3f);
        float absorptionPercent = Math.max(0, Math.min(1, absorptionAnimation));

        if (absorptionPercent > 0.01f && !Network.isFunTime()) {
            long  elapsed   = System.currentTimeMillis() - startTime;
            float wavePhase = (elapsed % 1200L) / 1200f * (float)(Math.PI * 2);
            int[] gc        = new int[4];
            for (int i = 0; i < 2; i++) {
                float wf  = (float)((Math.sin(wavePhase - i * 1.5f) + 1f) / 2f);
                gc[i*2]   = new Color(255, (int)(165+50*wf), 0, (int)(200*alpha)).getRGB();
                gc[i*2+1] = new Color(255, (int)(165+50*wf), 0, (int)(200*alpha)).getRGB();
            }
            Render2D.gradientRect(cx, barY, barWidth * absorptionPercent, barHeight, gc, barRadius);
        }
    }
}


