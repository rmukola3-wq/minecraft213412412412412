package meteordevelopment.meteorclient.systems.hud;

import meteordevelopment.meteorclient.gui.rasty.Initialization;
import meteordevelopment.meteorclient.gui.rasty.util.render.Render2D;
import net.minecraft.client.gui.DrawContext;
import net.minecraft.util.Identifier;

/** Render2D from HUD elements (fixes coordinate space + GL state). */
public final class HudGlUtil {
    private HudGlUtil() {}

    public static void prepare(DrawContext context) {
        if (context != null) context.draw();
        Initialization.getInstance().getManager().getRenderCore().setupOverlayState();
    }

    private static float px(float hudCoord) {
        return hudCoord / Render2D.getScaleMultiplier();
    }

    public static void roundedTexture(Identifier id, float x, float y, float w, float h,
                                      float u0, float v0, float u1, float v1, int color, float radius) {
        float m = Render2D.getScaleMultiplier();
        Render2D.texture(id, px(x), px(y), px(w), px(h), u0, v0, u1, v1, color, 0f, radius / m);
    }
}



