Полностью замени stopSprint() и добавь восстановление:

java

private void stopSprint() {
    if (mc.player == null) return;

    if (!suppressingSprint) {
        restoreSprintAfterAttack = mc.player.isSprinting();
    }

    suppressingSprint = true;

    if (mc.player.isSprinting() && mc.getNetworkHandler() != null) {
        mc.getNetworkHandler().sendPacket(
            new ClientCommandC2SPacket(
                mc.player,
                ClientCommandC2SPacket.Mode.STOP_SPRINTING
            )
        );
    }

    mc.player.setSprinting(false);
}

private void restoreSprint() {
    boolean shouldRestore =
        suppressingSprint && restoreSprintAfterAttack;

    suppressingSprint = false;
    restoreSprintAfterAttack = false;

    if (
        !shouldRestore
            || mc.player == null
            || mc.getNetworkHandler() == null
    ) {
        return;
    }

    mc.player.setSprinting(true);
    mc.getNetworkHandler().sendPacket(
        new ClientCommandC2SPacket(
            mc.player,
            ClientCommandC2SPacket.Mode.START_SPRINTING
        )
    );
}


