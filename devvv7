    @EventHandler(priority = EventPriority.LOW)
    private void onTickPre(TickEvent.Pre event) {
        if (!canRun()) {
            target = null;
            return;
        }

        if (clockwise.get() != lastClockwiseSetting) {
            lastClockwiseSetting = clockwise.get();
            orbitClockwise = clockwise.get();
        }

        boolean collided = mc.player.horizontalCollision;

        if (
            collisionSwitch.get()
                && collided
                && !wasColliding
        ) {
            orbitClockwise = !orbitClockwise;
        }

        wasColliding = collided;

        LivingEntity auraTarget = getAuraTarget();

        if (auraTarget != null) {
            target = auraTarget;
            return;
        }

        if (
            targetLock.get()
                && isValidTarget(target)
        ) {
            return;
        }

        target = findTarget();
    }

    /*
     * Executes after normal Flight movement and writes velocity
     * for the next movement cycle.
     */
    @EventHandler(priority = EventPriority.LOWEST - 1000)
    private void onTickPost(TickEvent.Post event) {
        applyVelocity();
    }

    /*
     * Overrides the actual movement vector in the current tick.
     * It never changes yaw or pitch, so KillAura owns rotation.
     */
    @EventHandler(priority = EventPriority.LOWEST - 1000)
    private void onMove(PlayerMoveEvent event) {
        if (
            event.type != MovementType.SELF
                || !canControl()
        ) {
            return;
        }

        Vec3d velocity = calculateVelocity();

        if (velocity == null) return;

        ((IVec3d) event.movement).meteor$setXZ(
            velocity.x,
            velocity.z
        );

        ((IVec3d) event.movement).meteor$setY(
            velocity.y
        );

        mc.player.setVelocity(velocity);
        controlling = true;
    }

    private void applyVelocity() {
        if (!canControl()) {
            if (
                controlling
                    && stopWithoutTarget.get()
                    && mc.player != null
            ) {
                mc.player.setVelocity(Vec3d.ZERO);
            }

            controlling = false;
            return;
        }

        Vec3d velocity = calculateVelocity();

        if (velocity == null) {
            controlling = false;
            return;
        }

        mc.player.setVelocity(velocity);
        controlling = true;
    }

    private Vec3d calculateVelocity() {
        if (mc.player == null || target == null) return null;

        Vec3d targetVelocity = target.getVelocity();

        Vec3d predictedTarget = target.getPos()
            .add(targetVelocity.multiply(prediction.get()))
            .add(
                0,
                target.getHeight() * 0.5 + heightOffset.get(),
                0
            );

        Vec3d playerCenter = mc.player.getPos().add(
            0,
            mc.player.getHeight() * 0.5,
            0
        );

        double relativeX =
            playerCenter.x - predictedTarget.x;

        double relativeZ =
            playerCenter.z - predictedTarget.z;

        double horizontalDistance = Math.hypot(
            relativeX,
            relativeZ
        );

        double radialX;
        double radialZ;

        if (horizontalDistance < 1.0E-5) {
            double angle = Math.toRadians(
                mc.player.age * 37.0
            );

            radialX = Math.cos(angle);
            radialZ = Math.sin(angle);
            horizontalDistance = 0.0;
        } else {
            radialX = relativeX / horizontalDistance;
            radialZ = relativeZ / horizontalDistance;
        }

        double velocityX;
        double velocityZ;

        double radius = orbitRadius.get();

        if (
            horizontalDistance
                > radius + chaseThreshold.get()
        ) {
            /*
             * Target is far away: fly directly towards it.
             */
            velocityX =
                -radialX * chaseSpeed.get()
                    + targetVelocity.x;

            velocityZ =
                -radialZ * chaseSpeed.get()
                    + targetVelocity.z;
        } else {
            /*
             * Target is close: use tangential velocity for orbiting
             * and radial correction for maintaining attack distance.
             */
            double tangentX = orbitClockwise
                ? -radialZ
                : radialZ;

            double tangentZ = orbitClockwise
                ? radialX
                : -radialX;

            double correction = MathHelper.clamp(
                (radius - horizontalDistance)
                    * radialStrength.get(),
                -chaseSpeed.get(),
                chaseSpeed.get()
            );

            velocityX =
                tangentX * orbitSpeed.get()
                    + radialX * correction
                    + targetVelocity.x;

            velocityZ =
                tangentZ * orbitSpeed.get()
                    + radialZ * correction
                    + targetVelocity.z;
        }

        double targetHorizontalSpeed = Math.hypot(
            targetVelocity.x,
            targetVelocity.z
        );

        double maximumHorizontal =
            Math.max(
                chaseSpeed.get(),
                orbitSpeed.get()
            ) * 1.15 + targetHorizontalSpeed;

        double horizontalSpeed = Math.hypot(
            velocityX,
            velocityZ
        );

        if (
            horizontalSpeed > maximumHorizontal
                && horizontalSpeed > 1.0E-5
        ) {
            double scale =
                maximumHorizontal / horizontalSpeed;

            velocityX *= scale;
            velocityZ *= scale;
        }

        double verticalDifference =
            predictedTarget.y - playerCenter.y;

        double velocityY =
            verticalDifference
                * verticalStrength.get()
                + targetVelocity.y;

        velocityY = MathHelper.clamp(
            velocityY,
            -verticalSpeed.get(),
            verticalSpeed.get()
        );

        if (
            collisionSwitch.get()
                && mc.player.horizontalCollision
        ) {
            velocityY = Math.max(
                velocityY,
                collisionBoost.get()
            );
        }

        return new Vec3d(
            velocityX,
            velocityY,
            velocityZ
        );
    }

    private LivingEntity getAuraTarget() {
        if (!syncAura.get()) return null;

        KillAura aura = Modules.get().get(KillAura.class);

        if (aura == null || !aura.isActive()) {
            return null;
        }

        Entity auraTarget = aura.getTarget();

        if (
            auraTarget instanceof LivingEntity living
                && isValidTarget(living)
        ) {
            return living;
        }

        return null;
    }

    private LivingEntity findTarget() {
        PlayerEntity best = null;
        double bestDistance = Double.MAX_VALUE;

        for (PlayerEntity player : mc.world.getPlayers()) {
            if (!isValidTarget(player)) continue;

            double distance =
                mc.player.squaredDistanceTo(player);

            if (distance < bestDistance) {
                bestDistance = distance;
                best = player;
            }
        }

        return best;
    }

    private boolean isValidTarget(LivingEntity entity) {
        if (
            mc.player == null
                || mc.world == null
                || !(entity instanceof PlayerEntity player)
                || entity == mc.player
                || !entity.isAlive()
                || entity.isRemoved()
                || entity.getHealth() <= 0
                || player.isCreative()
                || player.isSpectator()
        ) {
            return false;
        }

        if (!Friends.get().shouldAttack(player)) {
            return false;
        }

        double maximumDistance =
            targetRange.get();

        return mc.player.squaredDistanceTo(player)
            <= maximumDistance * maximumDistance;
    }

    private boolean canRun() {
        if (
            mc.player == null
                || mc.world == null
                || !mc.player.isAlive()
        ) {
            return false;
        }

        Flight flight = Modules.get().get(Flight.class);

        return flight != null && flight.isActive();
    }

    private boolean canControl() {
        return canRun() && isValidTarget(target);
    }

    public LivingEntity getTarget() {
        return target;
    }

    @Override
    public String getInfoString() {
        return target == null
            ? "Searching"
            : target.getName().getString();
    }
}


