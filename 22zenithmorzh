            else if (age % 3 == 0 && !mc.world.getBlockState(BlockPos.ofFloored(x, y, z)).isAir()) age -= 8;
            else age--;

            if (age < 0) return true;

            prevX = x;
            prevY = y;
            prevZ = z;
            x += mx;
            y += my;
            z += mz;
            mx *= 0.99f;
            my *= 0.99f;
            mz *= 0.99f;

