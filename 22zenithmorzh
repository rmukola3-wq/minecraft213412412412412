        .name("радиус")
        .description("Максимальный радиус волны в блоках.")
        .defaultValue(8)
        .min(3)
        .sliderMax(12)
        .build()
    );

    private final Setting<Boolean> playersOnly = sg.add(new BoolSetting.Builder()
        .name("только-игроки")
        .description("Волна только при ударе по игрокам.")
        .defaultValue(true)
        .build()
    );

    private final Setting<Shape> shape = sg.add(new EnumSetting.Builder<Shape>()
        .name("форма")
        .description("Линии / заливка / оба.")
        .defaultValue(Shape.Both)
        .build()
    );

    private final Setting<Boolean> themeSync = sg.add(new BoolSetting.Builder()
        .name("цвет-из-темы")
        .description("Брать цвет из модуля VisualTheme.")
        .defaultValue(true)
        .build()
    );

    private final Setting<SettingColor> color = sg.add(new ColorSetting.Builder()
        .name("цвет")
        .defaultValue(new SettingColor(137, 97, 72, 120))
        .visible(() -> !themeSync.get())
        .build()
    );

    private final List<WaveEffect> waves = new ArrayList<>();
    private final Color tmpSide = new Color();
    private final Color tmpLine = new Color();

    public HitBlocks() {
        super(Categories.Render, "hit-blocks", "Волна подсветки блоков вокруг цели при ударе (Rasty port).");
    }

    @Override
    public void onDeactivate() {
        waves.clear();
    }

    private void addWave(BlockPos pos) {
        if (mc.world == null || pos == null) return;
        BlockPos ground = findGround(pos);
        if (ground != null) {
            waves.add(new WaveEffect(ground, System.currentTimeMillis()));
            if (waves.size() > 16) waves.remove(0);
        }
    }

    private BlockPos findGround(BlockPos pos) {
        for (int y = 0; y <= 10; y++) {
            BlockPos down = pos.down(y);
            if (mc.world.isInBuildLimit(down) && !mc.world.getBlockState(down).isAir()) {
                return down;
            }
        }
        return pos;
    }

    @EventHandler
    private void onAttack(AttackEntityEvent event) {
        if (mc.world == null || mc.player == null) return;
        if (playersOnly.get() && !(event.entity instanceof net.minecraft.entity.player.PlayerEntity)) return;
        addWave(event.entity.getBlockPos());
    }

    @EventHandler
    private void onRender(Render3DEvent event) {
        if (waves.isEmpty() || mc.world == null) return;

        Color themeBase = themeSync.get() && VisualTheme.themeActive() ? VisualTheme.getColor(0) : null;
        SettingColor sc = themeBase != null
            ? new SettingColor(themeBase.r, themeBase.g, themeBase.b, themeBase.a)
            : color.get();
        Shape mode = shape.get();
        Renderer3D renderer = event.renderer;

        Iterator<WaveEffect> iterator = waves.iterator();
        while (iterator.hasNext()) {
            WaveEffect wave = iterator.next();
            if (wave.expired()) {
                iterator.remove();
                continue;
            }
            wave.render(renderer, sc, mode);
        }
    }

    private final class WaveEffect {
        private final BlockPos center;
        private final long start;
        private final long dur;
        private final int maxR;
        private Map<Long, Integer> blocks;
        private boolean calculated;

        WaveEffect(BlockPos center, long start) {
            this.center = center;
            this.start = start;
            this.dur = Math.max(50, Math.round(duration.get()));
            this.maxR = Math.max(2, maxRadius.get());
        }

        boolean expired() {
            return System.currentTimeMillis() - start > dur;
        }

        private void calculate() {
            if (calculated) return;
            calculated = true;

            blocks = new HashMap<>();
            Queue<BlockPos> queue = new LinkedList<>();
            Map<Long, Integer> visited = new HashMap<>();

            BlockPos startPos = center;
            if (mc.world.getBlockState(startPos).isAir()) {
                for (int y = 1; y <= 5; y++) {
                    BlockPos down = startPos.down(y);
                    if (!mc.world.getBlockState(down).isAir()) {
                        startPos = down;
                        break;
                    }
                }
            }

            queue.add(startPos);
            visited.put(startPos.asLong(), 0);

            while (!queue.isEmpty()) {
                BlockPos current = queue.poll();
                int dist = visited.get(current.asLong());
                if (dist > maxR) continue;

                BlockState state = mc.world.getBlockState(current);
                if (!state.isAir()) {
                    VoxelShape voxel = state.getOutlineShape(mc.world, current);
                    if (!voxel.isEmpty()) blocks.put(current.asLong(), dist);
                }

                for (Direction dir : Direction.values()) {
                    BlockPos neighbor = current.offset(dir);
                    if (!mc.world.isInBuildLimit(neighbor)) continue;

                    int nd = dist + 1;
                    Integer seen = visited.get(neighbor.asLong());
                    if (seen != null && seen <= nd) continue;
                    if (nd > maxR) continue;

                    if (!mc.world.getBlockState(neighbor).isAir()) {
                        visited.put(neighbor.asLong(), nd);
                        queue.add(neighbor);
                    } else {
                        BlockPos below = neighbor.down();
                        if (mc.world.isInBuildLimit(below) && !mc.world.getBlockState(below).isAir()) {
                            if (!visited.containsKey(below.asLong()) || visited.get(below.asLong()) > nd) {
                                visited.put(below.asLong(), nd);
                                queue.add(below);
                            }
                        }

                        BlockPos above = neighbor.up();
                        if (mc.world.isInBuildLimit(above) && !mc.world.getBlockState(above).isAir()) {
                            if (!visited.containsKey(above.asLong()) || visited.get(above.asLong()) > nd) {
                                visited.put(above.asLong(), nd);
                                queue.add(above);
                            }
                        }
                    }
                }
            }
        }

        void render(Renderer3D renderer, SettingColor sc, Shape mode) {
            calculate();
            if (blocks == null || blocks.isEmpty()) return;

            float progress = MathHelper.clamp((float) (System.currentTimeMillis() - start) / dur, 0.0f, 1.0f);
            float radius = progress * maxR;
            float waveWidth = 2.5f;
            float globalAlpha = (float) Math.pow(1.0f - progress, 0.5);

            ShapeMode shapeMode = switch (mode) {
                case Lines -> ShapeMode.Lines;
                case Sides -> ShapeMode.Sides;
                case Both -> ShapeMode.Both;
            };

            int rendered = 0;
            for (Map.Entry<Long, Integer> entry : blocks.entrySet()) {
                if (rendered >= 500) break;
                int blockDist = entry.getValue();
                if (blockDist < radius - waveWidth || blockDist > radius + 0.5f) continue;

                BlockPos pos = BlockPos.fromLong(entry.getKey());
                BlockState state = mc.world.getBlockState(pos);
                if (state.isAir()) continue;

                VoxelShape voxel = state.getOutlineShape(mc.world, pos);
                if (voxel.isEmpty()) continue;

                rendered++;

                float local = MathHelper.clamp(1.0f - Math.abs(blockDist - radius) / waveWidth, 0.0f, 1.0f) * globalAlpha;
                if (local <= 0.02f) continue;

                Box box = voxel.getBoundingBox().offset(pos);
                int alpha = MathHelper.clamp((int) (sc.a * local * 0.45f), 0, 255);
                tmpSide.set(sc.r, sc.g, sc.b, alpha);
                tmpLine.set(sc.r, sc.g, sc.b, MathHelper.clamp(alpha * 2, 0, 255));

                renderer.box(box, tmpSide, tmpLine, shapeMode, 0);
            }
        }
    }

    public enum Shape {
        Lines,
        Sides,
        Both;

        @Override
        public String toString() {
            return switch (this) {
                case Lines -> "Линии";
                case Sides -> "Заливка";
                case Both -> "Оба";
            };
        }
    }
}

