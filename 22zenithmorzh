        if (mc.player == null) return;
        ItemStack chest = mc.player.getEquippedStack(EquipmentSlot.CHEST);
        if (!chest.isOf(Items.ELYTRA)) return;

        int slot = findBestChestplateSlot();
        if (slot == -1) return;

        performSwap(slot);
        swapped = true;
