public class StaffDetector {

    private static final MinecraftClient mc =
        MinecraftClient.getInstance();

    public static Set<String> excludeNames =
        new HashSet<>();

    public static Set<String> excludeKeywords =
        new HashSet<>();

    public static List<String> keywords =
        new ArrayList<>();

    public static List<GlyphRule> userGlyphRules =
        new ArrayList<>();

    public static boolean showDonate = true;

    public static boolean includeMediaText = true;

    public static boolean includeDonateText = true;

    public static boolean scanDisplayFallback = true;

    public static boolean ignoreSelf = false;

    public static String flatten(Text text) {
        if (text == null) {
            return "";
        }

        return text.getString();
    }

    public static String plain(String s) {
        if (s == null || s.isEmpty()) {
            return "";
        }

        StringBuilder result =
            new StringBuilder();

        boolean formatting = false;

        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);

            if (formatting) {
                formatting = false;
                continue;
            }

            if (c == '§') {
                formatting = true;
                continue;
            }

            result.append(c);
        }

        return result.toString();
    }

    public static String beforeName(
        String display,
        String name
    ) {
        if (
            display == null ||
                display.isEmpty() ||
                name == null ||
                name.isEmpty()
        ) {
            return "";
        }

        int index =
            display.indexOf(name);

        if (index < 0) {
            return "";
        }

        return display
            .substring(0, index)
            .trim();
    }

    public static String codePoints(String s) {
        if (s == null || s.isEmpty()) {
            return "";
        }

        StringBuilder result =
            new StringBuilder();

        for (int cp : s.codePoints().toArray()) {
            if (result.length() > 0) {
                result.append(" ");
            }

            result
                .append("U+")
                .append(
                    Integer.toHexString(cp)
                        .toUpperCase()
                );
        }

        return result.toString();
    }

    private static String badgeToken(
        String prefix
    ) {
        if (
            prefix == null ||
                prefix.isEmpty()
        ) {
            return "";
        }

        int cp =
            prefix.codePointAt(0);

        return new String(
            Character.toChars(cp)
        );
    }

    private static boolean badgeEquals(
        String badge,
        String glyph
    ) {
        if (
            badge == null ||
                glyph == null
        ) {
            return false;
        }

        if (badge.equals(glyph)) {
            return true;
        }

        if (glyph.startsWith("U+")) {
            try {
                int codePoint =
                    Integer.parseInt(
                        glyph.substring(2),
                        16
                    );

                String converted =
                    new String(
                        Character.toChars(codePoint)
                    );

                return badge.equals(converted);

            } catch (Exception ignored) {
                return false;
            }
        }

        return false;
    }

    private static String unicodeFromRule(
        String rule
    ) {
        if (
            rule == null ||
                !rule.startsWith("U+")
        ) {
            return rule;
        }

        try {
            int codePoint =
                Integer.parseInt(
                    rule.substring(2),
                    16
                );

            return new String(
                Character.toChars(codePoint)
            );

        } catch (Exception ignored) {
            return "";
        }
    }

    public static List<String> defaultGlyphRules() {
        return List.of(
            "countrymc|ꬴ|хелпер|staff",
            "countrymc|ꬶ|интерн|staff",
            "countrymc|ꬲ|модер|staff",
            "countrymc|ꬳ|гл.модер|staff",
            "countrymc|ꬷ|медиа|media",
            "countrymc|U+2694|вармастер|staff",
            "countrymc|U+03A8|донат|donate",
            "*|U+2403|staff|staff",
            "*|U+2404|staff|staff"
        );
    }

    public static List<GlyphRule> parseGlyphRules(
        List<String> rules
    ) {
        List<GlyphRule> result =
            new ArrayList<>();

        if (rules == null) {
            return result;
        }

        for (String line : rules) {
            if (
                line == null ||
                    line.isBlank()
            ) {
                continue;
            }

            String[] parts =
                line.split("\\|", -1);

            if (parts.length != 4) {
                continue;
            }

            result.add(
                new GlyphRule(
                    parts[0].trim(),
                    parts[1].trim(),
                    parts[2].trim(),
                    parts[3].trim()
                )
            );
        }

        return result;
    }

    public static List<GlyphRule> filterGlyphs(
        List<GlyphRule> rules,
        String host
    ) {
        if (rules == null) {
            return new ArrayList<>();
        }

        if (host == null) {
            host = "";
        }

        final String currentHost =
            host;

        return rules.stream()
            .filter(
                rule ->
                    rule.host.equals("*") ||
                        rule.host.equalsIgnoreCase(
                            currentHost
                        )
            )
            .collect(Collectors.toList());
    }

    public static RankHit findRank(
        String prefixPlain,
        String host
    ) {
        if (
            prefixPlain == null ||
                prefixPlain.isEmpty()
        ) {
            return null;
        }

        String prefix =
            plain(prefixPlain).trim();

        if (prefix.isEmpty()) {
            return null;
        }

        if (excludeKeywords != null) {
            for (String excluded : excludeKeywords) {
                if (
                    excluded != null &&
                        !excluded.isEmpty() &&
                        prefix.toLowerCase().contains(
                            excluded.toLowerCase()
                        )
                ) {
                    return null;
                }
            }
        }

        List<GlyphRule> allRules =
            new ArrayList<>();

        if (userGlyphRules != null) {
            allRules.addAll(userGlyphRules);
        }

        allRules.addAll(
            parseGlyphRules(
                defaultGlyphRules()
            )
        );

        List<GlyphRule> glyphs =
            filterGlyphs(
                allRules,
                host
            );

        String badge =
            badgeToken(prefix);

        for (GlyphRule rule : glyphs) {

            if (
                rule.kind.equalsIgnoreCase("donate") &&
                    !showDonate
            ) {
                continue;
            }

            if (
                rule.kind.equalsIgnoreCase("media") &&
                    !includeMediaText
            ) {
                continue;
            }

            if (
                rule.kind.equalsIgnoreCase("donate") &&
                    !includeDonateText
            ) {
                continue;
            }

            if (
                badgeEquals(
                    badge,
                    rule.glyph
                )
            ) {
                return new RankHit(
                    rule.label,
                    rule.kind,
                    "glyph"
                );
            }

            if (
                !rule.glyph.startsWith("U+") &&
                    prefix.contains(rule.glyph)
            ) {
                return new RankHit(
                    rule.label,
                    rule.kind,
                    "glyph"
                );
            }

            if (
                rule.glyph.startsWith("U+") &&
                    prefix.contains(
                        unicodeFromRule(
                            rule.glyph
                        )
                    )
            ) {
                return new RankHit(
                    rule.label,
                    rule.kind,
                    "glyph"
                );
            }
        }

        if (keywords != null) {
            for (String keyword : keywords) {
                if (
                    keyword == null ||
                        keyword.isEmpty()
                ) {
                    continue;
                }

                if (
                    prefix.toLowerCase().contains(
                        keyword.toLowerCase()
                    )
                ) {
                    return new RankHit(
                        keyword,
                        "staff",
                        "keyword"
                    );
                }
            }
        }

        return null;
    }

    public static List<String> debugSamples(
        int limit
    ) {
        List<String> result =
            new ArrayList<>();

        if (
            mc.getNetworkHandler() == null
        ) {
            return result;
        }

        Map<String, String> uniqueBadges =
            new LinkedHashMap<>();

        for (
            PlayerListEntry entry :
            mc.getNetworkHandler().getPlayerList()
        ) {
            String name =
                entry.getProfile().getName();

            if (
                name == null ||
                    name.isEmpty()
            ) {
                continue;
            }

            String display = "";

            if (
                entry.getDisplayName() != null
            ) {
                display =
                    plain(
                        flatten(
                            entry.getDisplayName()
                        )
                    );
            }

            String before =
                beforeName(
                    display,
                    name
                );

            Team team =
                entry.getScoreboardTeam();

            String teamPrefix = "";

            if (
                team != null &&
                    team.getPrefix() != null
            ) {
                teamPrefix =
                    plain(
                        flatten(
                            team.getPrefix()
                        )
                    );
            }

            String badge =
                !before.isEmpty()
                    ? before
                    : teamPrefix;

            String badgeKey =
                badge.isEmpty()
                    ? "(empty)"
                    : codePoints(
                    badge.trim()
                );

            uniqueBadges.putIfAbsent(
                badgeKey,
                name
            );
        }

        result.add(
            "Уникальные бейджи (кодовые точки):"
        );

        int n = 0;

        for (
            Map.Entry<String, String> entry :
            uniqueBadges.entrySet()
        ) {
            if (n >= limit) {
                break;
            }

            result.add(
                entry.getKey() +
                    "  ←  " +
                    entry.getValue()
            );

            n++;
        }

        return result;
    }

