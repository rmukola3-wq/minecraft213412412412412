    private void drawRow(DrawContext context, String name, String key, float rowY, float s, double fs) {
        MorzhSmoothRenderer.text(context, name, x + 8 * s, rowY + 3 * s, 0xFFFFFFFF, true, fs);
        float timeW = (float) MorzhSmoothRenderer.textWidth(key, fs) + 8 * s;
        float pillX = x + getWidth() - 6 * s - timeW;
        MorzhSmoothRenderer.roundedRect(context, pillX, rowY + 1 * s, timeW, 12 * s, 4 * s, HudChrome.RV_PILL_ALT);
