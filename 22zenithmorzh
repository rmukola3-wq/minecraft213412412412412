@Mixin(SkyRendering.class)
public class SkyRenderingMixin {
    private static final Matrix4f sProjMat = new Matrix4f();
    private static final Matrix4f sViewMat = new Matrix4f();
    private static final Matrix4f sIdentity = new Matrix4f();

    @Unique private static float skyAnimTime;
    @Unique private static long lastAnimNanos;

    private static boolean ambienceHideSky() {
        Ambience ambience = Ambience.get();
        return ambience != null && ambience.renderActive && ambience.hideSkyActive;
    }

    private static boolean ambienceHideSun() {
        Ambience ambience = Ambience.get();
        return ambience != null && ambience.renderActive && ambience.hideSunActive;
    }

    private static boolean ambienceHideMoon() {
        Ambience ambience = Ambience.get();
        return ambience != null && ambience.renderActive && ambience.hideMoonActive;
    }

    private static boolean ambienceHideStars() {
        Ambience ambience = Ambience.get();
        return ambience != null && ambience.renderActive && ambience.hideStarsActive;
    }

    @Inject(method = "renderSky", at = @At("HEAD"), cancellable = true)
    private void morzhShaderSky(float r, float g, float b, CallbackInfo ci) {
        if (ambienceHideSky()) {
            ci.cancel();
            return;
        }
        if (CustomSky.useShaderSky()) {
            ci.cancel();
            drawFullscreenSky();
        }
    }

    @Inject(method = "renderSkyDark", at = @At("HEAD"), cancellable = true)
    private void morzhShaderSkyDark(MatrixStack matrices, CallbackInfo ci) {
        if (ambienceHideSky()) {
            ci.cancel();
            return;
        }
        if (CustomSky.useShaderSky()) {
            ci.cancel();
            drawFullscreenSky();
        }
    }

    @Inject(method = "renderSun", at = @At("HEAD"), cancellable = true)
    private void morzhHideSun(float alpha, VertexConsumerProvider vertexConsumers, MatrixStack matrices, CallbackInfo ci) {
        if (ambienceHideSun()) ci.cancel();
    }

    @Inject(method = "renderMoon", at = @At("HEAD"), cancellable = true)
    private void morzhHideMoon(int phase, float alpha, VertexConsumerProvider vertexConsumers, MatrixStack matrices, CallbackInfo ci) {
        if (ambienceHideMoon()) ci.cancel();
    }

    @Inject(method = "renderCelestialBodies", at = @At("HEAD"), cancellable = true)
    private void morzhCelestialBodies(MatrixStack matrices, VertexConsumerProvider.Immediate vertexConsumers, float rot, int phase, float alpha, float starBrightness, Fog fog, CallbackInfo ci) {
        if (CustomSky.useShaderSky()) {
            ci.cancel();
            return;
        }
        CustomSky.renderPack(matrices, fog);
    }

    @Inject(method = "renderEndSky", at = @At("TAIL"))
    private void morzhCustomEndSky(CallbackInfo ci) {
        if (!CustomSky.useShaderSky() && !ambienceHideSky()) CustomSky.renderPack(null, null);
    }

    @Inject(method = "renderStars", at = @At("HEAD"), cancellable = true)
    private void morzhHideStars(Fog fog, float color, MatrixStack matrices, CallbackInfo ci) {
        if (ambienceHideStars() || CustomSky.useShaderSky() || CustomSky.hasLayers()) ci.cancel();
    }

    private static void drawFullscreenSky() {
        ShaderProgram prog = SkyShaderHolder.getProgram();
        if (prog == null) return;

        MinecraftClient mc = MinecraftClient.getInstance();
        sProjMat.set(RenderSystem.getProjectionMatrix());
        sViewMat.set(RenderSystem.getModelViewMatrix());
        prog.initializeUniforms(DrawMode.QUADS, sViewMat, sProjMat, mc.getWindow());
        GlUniform uInvProj = prog.getUniform("InvProjMat");
        GlUniform uInvView = prog.getUniform("InvViewMat");
        if (uInvProj != null) {
            uInvProj.set(new Matrix4f(sProjMat).invert());
        }
        if (uInvView != null) {
            uInvView.set(new Matrix4f(sViewMat).invert());
        }

        SkyShaderHolder.uploadConfigUniforms();

        long nowNanos = System.nanoTime();
        if (lastAnimNanos == 0) lastAnimNanos = nowNanos;
        skyAnimTime += Math.min((nowNanos - lastAnimNanos) / 1_000_000_000.0, 0.25);
        lastAnimNanos = nowNanos;
        GlUniform uGameTime = prog.getUniform("GameTime");
        if (uGameTime != null) {
            uGameTime.set(skyAnimTime);
        }
        RenderSystem.depthMask(false);
        RenderSystem.disableDepthTest();
        RenderSystem.disableBlend();
        RenderSystem.disableCull();
        RenderSystem.setShader(prog);
        prog.bind();
        RenderSystem.backupProjectionMatrix();
        RenderSystem.setProjectionMatrix(sIdentity, ProjectionType.PERSPECTIVE);
        Matrix4fStack mvStack = RenderSystem.getModelViewStack();
        mvStack.pushMatrix();
        mvStack.identity();
        BufferBuilder buf = Tessellator.getInstance().begin(DrawMode.QUADS, VertexFormats.POSITION);
        buf.vertex(-1.0F, -1.0F, 1.0F);
        buf.vertex(1.0F, -1.0F, 1.0F);
        buf.vertex(1.0F, 1.0F, 1.0F);
        buf.vertex(-1.0F, 1.0F, 1.0F);
        BufferRenderer.drawWithGlobalProgram(buf.end());
        mvStack.popMatrix();
