public class Spider extends Module {
    private static final float GRIM_PITCH = 75f;
    private static final double GRIM_BOOST = 0.05;

    private final SettingGroup sgGeneral = settings.getDefaultGroup();

    private final Setting<Mode> mode = sgGeneral.add(new EnumSetting.Builder<Mode>()
        .name("mode")
        .description("Grim — ведро у стены. Slime — слайм-блок (Rasty 1:1).")
        .defaultValue(Mode.Grim)
        .build()
    );

    private final Setting<Double> vanillaSpeed = sgGeneral.add(new DoubleSetting.Builder()
        .name("climb-speed")
        .description("Скорость подъёма (Vanilla).")
        .defaultValue(0.2)
        .min(0.0)
        .visible(() -> mode.get() == Mode.Vanilla)
        .build()
    );

    private Angle savedRotation;
    private int slimeCooldown;

    public Spider() {
        super(Categories.Movement, "spider", "Ползание по стенам.");
    }

    @Override
    public void onDeactivate() {
        restoreRotation();
        slimeCooldown = 0;
    }

    @EventHandler
    private void onTick(TickEvent.Pre event) {
        if (mc.player == null || mc.world == null) return;

        if (mode.get() == Mode.Grim) {
            if (!grimActive()) {
                restoreRotation();
                return;
            }
            if (mc.player.isSprinting()) mc.player.setSprinting(false);
            return;
        }

        if (mode.get() == Mode.Slime) handleSlimeBlock();
    }

    @EventHandler
    private void onSendMovementPackets(SendMovementPacketsEvent.Pre event) {
        if (mc.player == null || mc.world == null || mc.interactionManager == null) return;
        if (mode.get() != Mode.Grim || !grimActive()) return;

        Angle spiderRot = spiderRotation();
        stashRotation();
        AngleConnection.INSTANCE.setRotation(spiderRot);
        mc.player.setPitch(GRIM_PITCH);
        PlayerInteractionHelper.interactItem(Hand.MAIN_HAND, spiderRot);
    }

    @EventHandler
    private void onSendMovementPacketsPost(SendMovementPacketsEvent.Post event) {
        if (mode.get() == Mode.Grim) restoreRotation();
    }

    @EventHandler
    private void onTravel(PlayerTravelEvent event) {
        if (!event.pre || mc.player == null || mc.world == null) return;

        if (mode.get() == Mode.Vanilla) {
            if (!mc.player.horizontalCollision) return;
            Vec3d velocity = mc.player.getVelocity();
            if (velocity.y >= 0.2) return;
            mc.player.setVelocity(velocity.x, vanillaSpeed.get(), velocity.z);
            return;
        }

        if (mode.get() != Mode.Grim || !grimActive()) return;

        Vec3d velocity = mc.player.getVelocity();
        mc.player.setVelocity(velocity.x, velocity.y + GRIM_BOOST, velocity.z);
    }

    private void handleSlimeBlock() {
        BlockPos playerPos = mc.player.getBlockPos();
        boolean hasAdjacentSlime = false;
        for (BlockPos pos : new BlockPos[]{
            playerPos.east(), playerPos.west(), playerPos.north(), playerPos.south()
        }) {
            if (mc.world.getBlockState(pos).isOf(Blocks.SLIME_BLOCK)) {
                hasAdjacentSlime = true;
                break;
            }
        }

        if (!hasAdjacentSlime || !mc.player.horizontalCollision || mc.player.getVelocity().y <= -1) return;
        if (!(mc.crosshairTarget instanceof BlockHitResult blockHit)) return;

        BlockPos targetPos = blockHit.getBlockPos();
        if (mc.world.getBlockState(targetPos).isAir()) return;

        FindItemResult slime = InvUtils.findInHotbar(Items.SLIME_BLOCK);
        if (!slime.found()) return;

        if (!slime.isMainHand()) InvUtils.swap(slime.slot(), false);
        mc.player.setPitch(54f);

        mc.interactionManager.interactBlock(mc.player, Hand.MAIN_HAND, blockHit);
        mc.player.swingHand(Hand.MAIN_HAND);

        if (slimeCooldown >= 1) {
            Vec3d v = mc.player.getVelocity();
            mc.player.setVelocity(v.x, 0.63, v.z);
            slimeCooldown = 0;
        } else {
            slimeCooldown++;
        }
    }

    private Angle spiderRotation() {
        return new Angle(MathAngle.cameraAngle().getYaw(), GRIM_PITCH);
    }

    private void stashRotation() {
        if (savedRotation != null) return;
        Angle current = AngleConnection.INSTANCE.getCurrentAngle();
        savedRotation = current != null ? current : MathAngle.cameraAngle();
    }

    private void restoreRotation() {
        if (savedRotation == null) return;
        AngleConnection.INSTANCE.setRotation(savedRotation);
        savedRotation = null;
    }

    private boolean grimActive() {
        return mc.player.horizontalCollision
            && mc.options.jumpKey.isPressed()
            && mc.player.getMainHandStack().getItem() == Items.WATER_BUCKET;
    }

    @Override
    public String getInfoString() {
        return mode.get().toString();
    }

    public enum Mode {
        Vanilla,
        Grim,
        Slime
    }
}

