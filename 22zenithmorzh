    public void render(LivingEntity entity, float tickDelta, float scale, MatrixStack matrices, VertexConsumerProvider consumers, int light, Identifier texture) {
        root.resetTransform();
        body.resetTransform();
        neck.resetTransform();
        head.resetTransform();
        flipperLeft.resetTransform();
        flipperRight.resetTransform();
        hindLeft.resetTransform();
        hindRight.resetTransform();

        float limbPos = entity.limbAnimator.getPos(tickDelta);
        float limbSpeed = Math.min(entity.limbAnimator.getSpeed(tickDelta), 1.0F);
        float paddle = MathHelper.cos(limbPos * 0.7F) * 0.28F * limbSpeed;

        flipperLeft.roll = 0.4F + paddle * 0.35F;
        flipperRight.roll = -0.4F - paddle * 0.35F;
        flipperLeft.yaw = 0.28F + paddle * 0.15F;
        flipperRight.yaw = -0.28F - paddle * 0.15F;
        flipperLeft.pitch = 0.2F;
        flipperRight.pitch = 0.2F;
        hindLeft.yaw = 0.38F + paddle * 0.18F;
        hindRight.yaw = -0.38F - paddle * 0.18F;
        body.pitch = MathHelper.sin(limbPos * 0.4F) * 0.03F * limbSpeed;

        float headYaw = MathHelper.wrapDegrees(entity.getHeadYaw() - entity.bodyYaw);
        if (entity instanceof AbstractClientPlayerEntity player) {
            headYaw = MathHelper.wrapDegrees(player.headYaw - player.bodyYaw);
        }
        neck.yaw = headYaw * ((float) Math.PI / 180F) * 0.25F;
        head.yaw = headYaw * ((float) Math.PI / 180F) * 0.3F;
        head.pitch = entity.getPitch(tickDelta) * ((float) Math.PI / 180F) * 0.22F;

        matrices.push();
        matrices.scale(scale, scale, scale);
        VertexConsumer vertices = consumers.getBuffer(RenderLayer.getEntityCutoutNoCull(texture));
        int overlay = OverlayTexture.getUv(0.0F, entity.hurtTime > 0 || entity.deathTime > 0);
        root.render(matrices, vertices, light, overlay);
        matrices.pop();
    }

    public static void applyEntityTransform(LivingEntity entity, float tickDelta, double x, double y, double z, MatrixStack matrices) {

        matrices.translate(x, y + 1.0, z);
        float bodyYaw = MathHelper.lerpAngleDegrees(tickDelta, entity.prevBodyYaw, entity.bodyYaw);
        matrices.multiply(RotationAxis.POSITIVE_Y.rotationDegrees(180.0F - bodyYaw));

        matrices.scale(-1.0F, 1.0F, 1.0F);
        if (entity.isInSneakingPose()) {
            matrices.translate(0.0F, 0.1F, 0.0F);
        }
    }

    public static void paintTexture(NativeImage image) {
        int fur = 0xFF8B5E48;
        int furMid = 0xFF704A3A;
        int furDark = 0xFF52352A;
        int belly = 0xFFE4C9A8;
        int bellyMid = 0xFFD0B08E;
        int pad = 0xFFD7B592;
        int padShadow = 0xFFB89574;
        int tusk = 0xFFF4EFE4;
        int tuskTip = 0xFFD2C9B6;
        int whisker = 0xFF3A2C24;
        int nose = 0xFF2A1C16;
        int eyeWhite = 0xFFF3EEE6;
        int eye = 0xFF141210;

        image.fillRect(0, 0, TEX, TEX, furMid);

        paintBox(image, 0, 0, 13, 9, 16, fur, furDark, belly);
        paintBox(image, 0, 25, 14, 4, 13, belly, bellyMid, belly);
        paintBox(image, 58, 0, 11, 8, 4, fur, furDark, bellyMid);
        paintBox(image, 58, 12, 7, 7, 6, fur, furDark, padShadow);
        paintBox(image, 0, 42, 8, 8, 7, fur, furDark, furMid);
        paintBox(image, 30, 42, 10, 6, 5, pad, padShadow, pad);
        paintBox(image, 60, 42, 6, 3, 4, padShadow, furDark, pad);
        paintBox(image, 84, 42, 2, 10, 2, tusk, tuskTip, tusk);
        paintBox(image, 92, 42, 5, 1, 1, whisker, whisker, whisker);
        paintBox(image, 0, 57, 3, 4, 8, furMid, furDark, fur);
        paintBox(image, 20, 57, 5, 3, 9, furMid, furDark, fur);

        fill(image, 8, 50, 2, 2, eyeWhite);
        fill(image, 13, 50, 2, 2, eyeWhite);
        image.setColorArgb(8, 51, eye);
        image.setColorArgb(9, 51, eye);
        image.setColorArgb(13, 51, eye);
        image.setColorArgb(14, 51, eye);

        fill(image, 39, 51, 2, 2, nose);

        fill(image, 84, 50, 8, 4, tuskTip);
    }

    private static void paintBox(NativeImage image, int u, int v, int w, int h, int d, int side, int dark, int light) {
        fill(image, u + d, v, w, d, light);
        fill(image, u + d + w, v, w, d, dark);
        fill(image, u, v + d, d, h, dark);
        fill(image, u + d, v + d, w, h, side);
        fill(image, u + d + w, v + d, d, h, dark);
        fill(image, u + 2 * d + w, v + d, w, h, dark);
    }

    private static void fill(NativeImage image, int x, int y, int w, int h, int argb) {
        if (w <= 0 || h <= 0) return;
        int x2 = Math.min(x + w, TEX);
        int y2 = Math.min(y + h, TEX);
        int x0 = Math.max(x, 0);
        int y0 = Math.max(y, 0);
        if (x0 >= x2 || y0 >= y2) return;
        image.fillRect(x0, y0, x2 - x0, y2 - y0, argb);
    }
