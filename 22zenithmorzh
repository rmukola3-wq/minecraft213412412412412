        morzhModuleList.add(theme.horizontalSeparator("Favorites"))
            .expandX();

        List<Module> favorites = new ArrayList<>();

        for (Module module : Modules.get().getAll()) {
            if (module.favorite
                && !Config.get().hiddenModules.get().contains(module)) {
                favorites.add(module);
            }
        }

        favorites.sort((a, b) ->
            String.CASE_INSENSITIVE_ORDER.compare(a.name, b.name)
        );

        for (Module module : favorites) {
            morzhModuleList.add(theme.module(module)).expandX();
        }

        if (favorites.isEmpty()) {
            morzhModuleList.add(theme.label(
                "No favorites. Open module settings to add one."
            ));
        }
