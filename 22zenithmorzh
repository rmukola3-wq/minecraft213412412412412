        .defaultValue(true)
        .build()
    );

    private final Setting<Integer> fireworkDelay = sgRocket.add(new IntSetting.Builder()
        .name("задержка-фейерверка")
        .description("Интервал autoFWSetting в миллисекундах.")
        .defaultValue(400)
        .range(100, 3000)
        .sliderRange(100, 3000)
        .build()
    );

