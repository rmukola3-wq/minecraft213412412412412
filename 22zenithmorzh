    }

    public boolean isChasing() {
        return isActive() && mc.player != null && mc.player.isGliding() && box != null && resolveTarget() != null;
    }

    public float overrideRange(LivingEntity target) {
        return 3.0f;
    }

    public void useFireworkForMotion() {
