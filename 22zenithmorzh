package dev.morzh.client.utils.render.postprocess;

import net.minecraft.client.gl.Framebuffer;
import net.minecraft.client.gl.SimpleFramebuffer;

public final class ShaderFramebuffer {
    private Framebuffer framebuffer;
    private int width;
    private int height;

    public Framebuffer get() {
        return framebuffer;
    }

    public void ensureSize(int screenWidth, int screenHeight, double scale) {
        int newWidth = Math.max(1, (int) Math.round(screenWidth * scale));
        int newHeight = Math.max(1, (int) Math.round(screenHeight * scale));

        if (framebuffer == null) {
            framebuffer = new SimpleFramebuffer(newWidth, newHeight, true);
            framebuffer.setClearColor(0f, 0f, 0f, 0f);
            width = newWidth;
            height = newHeight;
            return;
        }

        if (width != newWidth || height != newHeight) {
            framebuffer.resize(newWidth, newHeight);
            framebuffer.setClearColor(0f, 0f, 0f, 0f);
            width = newWidth;
            height = newHeight;
        }
    }

    public void clear() {
        if (framebuffer != null) framebuffer.clear();
    }

    public int width() {
        return width;
    }

    public int height() {
        return height;
    }

    public void delete() {
        if (framebuffer != null) {
            framebuffer.delete();
            framebuffer = null;
        }

        width = 0;
        height = 0;
    }
}

