    private static float preventOvershoot(float step, float error) {
        if (Math.abs(error) <= 1.0E-4F) return 0.0F;
        if (Math.signum(step) != Math.signum(error)) return 0.0F;
        return Math.copySign(Math.min(Math.abs(step), Math.abs(error)), error);
