    private void useIf(Setting<Keybind> bind, boolean key, int value, int modifiers, Item item, String name) {
        if (!bind.get().matches(key, value, modifiers)) return;
        if (mc.player.getItemCooldownManager().isCoolingDown(item.getDefaultStack())) {
            ChatUtils.errorPrefix("Binds", name + " — задержка");
