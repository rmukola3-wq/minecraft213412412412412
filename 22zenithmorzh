    private static String ellipsize(String text, double maxWidth, double fs) {
        if (text == null) text = "";
        if (maxWidth <= 0) return "";
        if (MorzhSmoothRenderer.textWidth(text, fs) <= maxWidth) return text;
        String dots = "...";
        double dotsW = MorzhSmoothRenderer.textWidth(dots, fs);
        if (maxWidth <= dotsW) return dots;
        while (text.length() > 1 && MorzhSmoothRenderer.textWidth(text, fs) + dotsW > maxWidth) {
            text = text.substring(0, text.length() - 1);
        }
        return text + dots;
    }

