            float yaw = mc.player.getYaw();
            float pitch = mc.player.getPitch();
            if (Input.isKeyPressed(GLFW.GLFW_KEY_LEFT)) yaw -= (float) step;
            if (Input.isKeyPressed(GLFW.GLFW_KEY_RIGHT)) yaw += (float) step;
            if (Input.isKeyPressed(GLFW.GLFW_KEY_UP)) pitch -= (float) step;
            if (Input.isKeyPressed(GLFW.GLFW_KEY_DOWN)) pitch += (float) step;
            mc.player.setYaw(yaw);
            mc.player.setPitch(clampPitch(pitch));
        } else {
            if (Input.isKeyPressed(GLFW.GLFW_KEY_LEFT)) cameraYaw -= (float) step;
            if (Input.isKeyPressed(GLFW.GLFW_KEY_RIGHT)) cameraYaw += (float) step;
            if (Input.isKeyPressed(GLFW.GLFW_KEY_UP)) cameraPitch -= (float) step;
            if (Input.isKeyPressed(GLFW.GLFW_KEY_DOWN)) cameraPitch += (float) step;
