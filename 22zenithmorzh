            float dotCy = y0 + 13 * s;
            MorzhSmoothRenderer.circle(context, dotCx, dotCy, 4 * s, stateColor);
            MorzhSmoothRenderer.circle(context, dotCx, dotCy, 1.6f * s, 0xFF101014);

            MorzhSmoothRenderer.text(context, state, textX, line1Top, stateColor, true, fsState);

            float diffX = (float) (x0 + w - rightPad - MorzhSmoothRenderer.textWidth(diffTxt, fsDiff));
            MorzhSmoothRenderer.text(context, diffTxt, diffX, line1Top + 1 * s, stateColor, true, fsDiff);

