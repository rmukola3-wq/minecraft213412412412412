    }

    private double angleToEntity(LivingEntity entity) {
        Vec3d direction = entity.getBoundingBox().getCenter().subtract(mc.player.getEyePos());
        float wantedYaw = (float) MathHelper.wrapDegrees(Math.toDegrees(Math.atan2(direction.z, direction.x)) - 90.0);
        float wantedPitch = (float) -Math.toDegrees(Math.atan2(direction.y, Math.hypot(direction.x, direction.z)));
        return Math.max(
            Math.abs(MathHelper.wrapDegrees(wantedYaw - mc.player.getYaw())),
            Math.abs(wantedPitch - mc.player.getPitch()) * 0.65F
        );
    }

    private boolean hasVisiblePoint(LivingEntity entity) {
        Box box = entity.getBoundingBox();
        Vec3d eyes = mc.player.getEyePos();
        double max = range.get() * range.get();
        for (double[] candidate : AIM_POINTS) {
            Vec3d point = pointOnBox(box, new Vec3d(candidate[0], candidate[1], candidate[2]));
