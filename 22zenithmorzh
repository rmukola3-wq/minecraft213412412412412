        boolean snapIdle = aura.classicSnap()
            && (!aura.canCritical() || !aura.attackTimerPassed(300));

        if (target == null || snapIdle) {
            float[] next = interp.animate(
                mc.player.getYaw(),
                mc.player.getPitch(),
                220,
                220
            );
            yaw = next[0];
            pitch = next[1];
