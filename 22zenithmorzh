        float pw = tw + 8f;
        float ph = Math.max(11f, height);
        float px = right - pw;
        MorzhSmoothRenderer.roundedRect(context, px, y, pw, ph, 4f, RV_PILL);
        MorzhSmoothRenderer.text(context, text, px + 4f, y + Math.max(1.5f, (ph - (float) MorzhSmoothRenderer.textHeight(fs)) / 2f), 0xFFFFFFFF, true, fs);
