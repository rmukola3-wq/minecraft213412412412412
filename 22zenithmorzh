                net.minecraft.entity.attribute.EntityAttributes.ATTACK_SPEED);
        double ticksPerCooldown = 20.0 / attackSpeed;
        double ticksElapsed = current * ticksPerCooldown;
        double ticksNeeded = (0.9 * ticksPerCooldown) - ticksElapsed;

