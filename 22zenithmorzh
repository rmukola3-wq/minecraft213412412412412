        if (item instanceof SwordItem || item instanceof AxeItem || item instanceof MaceItem) return true;
        String key = item.getTranslationKey().toLowerCase();
        return key.contains("sword")
            || key.contains("mace")
            || key.contains("trident")
            || (key.contains("axe") && !key.contains("pickaxe"));
    }

    private boolean canSee(LivingEntity entity) {
