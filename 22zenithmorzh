    private static void drawGlassText(DrawContext context, String text, double x, double y, double scale) {
        int glow = 0x50FFFFFF;
        int core = 0xFFFFFFFF;
        double o = scale;

        MorzhFontRenderer.draw(context, text, x - o, y, glow, false, scale);
        MorzhFontRenderer.draw(context, text, x + o, y, glow, false, scale);
        MorzhFontRenderer.draw(context, text, x, y - o, glow, false, scale);
        MorzhFontRenderer.draw(context, text, x, y + o, glow, false, scale);

        MorzhFontRenderer.draw(context, text, x, y, core, true, scale);
    }

