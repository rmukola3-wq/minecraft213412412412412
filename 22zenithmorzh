        .name("pulse-idle")
        .description("Сколько тиков ехать по обычной физике для сброса VL.")
        .defaultValue(1)
        .min(1)
        .max(6)
        .sliderRange(1, 6)
        .visible(() -> mode.get() == Mode.GrimPulse)
        .build()
    );

    private int pulseTick;

    public NoWeb() {
        super(Categories.Movement, "no-web", "Обход паутины.");
    }

    @Override
    public void onActivate() {
        pulseTick = 0;
    }

    @Override
    public void onDeactivate() {
        pulseTick = 0;
    }

    @EventHandler
    private void onTick(TickEvent.Pre event) {
        if (mc.player == null || mc.world == null) return;
        if (mc.player.isSpectator() || mc.player.getAbilities().flying) return;
        if (!isInsideCobweb()) {
            pulseTick = 0;
            return;
        }

        switch (mode.get()) {
            case Grim -> handleGrim();
            case Prisma -> handlePrisma();
            case GrimStatic -> applyBpsBoost();
            case GrimPulse -> {
                if (!shouldBoost()) {
                    Vec3d v = mc.player.getVelocity();
                    mc.player.setVelocity(0, v.y, 0);
                    return;
                }
                applyBpsBoost();
            }
        }
    }

    private void handlePrisma() {
        Vec2f movement = mc.player.input.getMovementInput();
        float forward = movement.y;
        float strafe = movement.x;
        if (forward == 0f && strafe == 0f) return;

        Vec3d dir = inputDirection(forward, strafe);
        double inject = prismaStrength.get() * 0.15 / 0.25;

        Vec3d v = mc.player.getVelocity();
        mc.player.setVelocity(v.x + dir.x * inject, v.y, v.z + dir.z * inject);
    }

    private Vec3d inputDirection(float forward, float strafe) {
        float f = MathHelper.clamp(forward, -1f, 1f);
        float s = MathHelper.clamp(strafe, -1f, 1f);
        double rad = Math.toRadians(mc.player.getYaw());
        double sin = Math.sin(rad);
        double cos = Math.cos(rad);
        double x = s * cos - f * sin;
        double z = f * cos + s * sin;
        double len = Math.sqrt(x * x + z * z);
        if (len < 1e-6) return Vec3d.ZERO;
        return new Vec3d(x / len, 0, z / len);
    }

    private boolean isInsideCobweb() {
        Box bb = mc.player.getBoundingBox();
        int minX = MathHelper.floor(bb.minX);
        int maxX = MathHelper.floor(bb.maxX);
        int minY = MathHelper.floor(bb.minY);
        int maxY = MathHelper.floor(bb.maxY);
        int minZ = MathHelper.floor(bb.minZ);
        int maxZ = MathHelper.floor(bb.maxZ);
        BlockPos.Mutable p = new BlockPos.Mutable();

        for (int x = minX; x <= maxX; x++) {
            for (int y = minY; y <= maxY; y++) {
                for (int z = minZ; z <= maxZ; z++) {
                    p.set(x, y, z);
                    if (mc.world.getBlockState(p).isOf(Blocks.COBWEB)) return true;
                }
            }
        }
        return false;
    }

    private void handleGrim() {
        double motionY = mc.options.jumpKey.isPressed() ? 1.3
            : mc.options.sneakKey.isPressed() ? -1.3 : 0;
        float yaw = mc.player.getYaw() * ((float) Math.PI / 180.0F);
        float f = mc.player.forwardSpeed * 0.633F;
        float s = mc.player.sidewaysSpeed * 0.633F;

        if (f != 0 || s != 0) {
            mc.player.setVelocity(
                -MathHelper.sin(yaw) * f + MathHelper.cos(yaw) * s,
                motionY,
                MathHelper.cos(yaw) * f + MathHelper.sin(yaw) * s
            );
        } else {
            mc.player.setVelocity(0, motionY, 0);
        }
    }

    private boolean shouldBoost() {
        int cycle = pulseBoost.get() + pulseIdle.get();
        boolean boost = (pulseTick % cycle) < pulseBoost.get();
        pulseTick++;
        return boost;
    }

    private void applyBpsBoost() {
        double perTickXZ = speed.get() / 20.0;
        double perTickY = verticalSpeed.get() / 20.0;

        double[] dir = MoveUtil.calculateDirection(perTickXZ);
        double vy = mc.options.jumpKey.isPressed() ? perTickY
            : mc.options.sneakKey.isPressed() ? -perTickY : 0;

        mc.player.addVelocity(dir[0], 0, dir[1]);
        mc.player.setVelocity(dir[0], vy, dir[1]);
    }

    @Override
    public String getInfoString() {
        return mode.get().toString();
    }

    public enum Mode {
        Grim,
        Prisma,
        GrimStatic,
        GrimPulse
    }
}

