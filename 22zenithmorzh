        .name("hide-vanilla")
        .defaultValue(true)
        .build()
    );

    private final Setting<Boolean> dynamic = sg.add(new BoolSetting.Builder()
        .name("динамический")
        .description("Прицел смещается за поворотом камеры (как в ThunderHack).")
        .defaultValue(true)
        .visible(() -> mode.get() != Mode.Default)
        .build()
    );

    private final Setting<Double> range = sg.add(new DoubleSetting.Builder()
        .name("разброс")
        .description("Насколько далеко уезжает прицел при повороте.")
        .defaultValue(14.0)
        .min(4.0)
        .sliderMax(40.0)
        .visible(() -> dynamic.get() && mode.get() != Mode.Default)
        .build()
    );

    private final Setting<Boolean> dot = sg.add(new BoolSetting.Builder()
        .name("точка")
        .defaultValue(false)
        .visible(() -> mode.get() == Mode.Default)
        .build()
    );

    private final Setting<Boolean> animated = sg.add(new BoolSetting.Builder()
        .name("анимация")
        .description("Зазор классического прицела дышит от перезарядки удара.")
        .defaultValue(true)
        .visible(() -> mode.get() == Mode.Default)
        .build()
    );

    private float xAnim, yAnim, prevPitch;

    public MorzhCrosshair() {
        super(Categories.Render, "crosshair", "Custom crosshair (ThunderHack-style modes).");
    }

    public boolean hidesVanilla() {
        return isActive() && hideVanilla.get();
    }

    @EventHandler
    private void onRender(Render2DEvent event) {
        if (mc.player == null || !mc.options.getPerspective().isFirstPerson() || mc.options.hudHidden) return;
        float midX = Utils.getWindowWidth() / 2f;
        float midY = Utils.getWindowHeight() / 2f;
        int col = themeSync.get() && VisualTheme.themeActive()
            ? VisualTheme.getColor(0).getPacked()
            : color.get().getPacked();

        float progress = mc.player.getAttackCooldownProgress(0.5f);

        switch (mode.get()) {
            case Circle -> {
                updateDynamic(midX, midY);

                MorzhSmoothRenderer.circle(event.drawContext, xAnim, yAnim, 14, DropDownColors.withAlpha(col, 40));
                float sweep = MathHelper.clamp(progress, 0.02f, 1f) * 360f;
                MorzhSmoothRenderer.arcRing(event.drawContext, xAnim, yAnim, 13, 3, -90, sweep, col);
                MorzhSmoothRenderer.circle(event.drawContext, xAnim, yAnim, 2.2f, col);
            }
            case Dot -> {
                updateDynamic(midX, midY);

                long t = System.currentTimeMillis();
                float pulse = 0.75f + 0.25f * (float) Math.sin(t / 260.0);
                MorzhSmoothRenderer.circle(event.drawContext, xAnim, yAnim, 9 * pulse, DropDownColors.withAlpha(col, 36));
                MorzhSmoothRenderer.circle(event.drawContext, xAnim, yAnim, 5.5f * pulse, DropDownColors.withAlpha(col, 70));
                MorzhSmoothRenderer.circle(event.drawContext, xAnim, yAnim, 3f, col);
            }
            case WiseTree -> {
                updateDynamic(midX, midY);
                DrawContext context = event.drawContext;

                float spinDeg = (System.currentTimeMillis() % 70000L) / 70000f * 360f;
                context.getMatrices().push();
                context.getMatrices().translate(xAnim, yAnim, 0);
                context.getMatrices().multiply(RotationAxis.POSITIVE_Z.rotationDegrees(spinDeg));
                context.getMatrices().translate(-xAnim, -yAnim, 0);
                rect(context, xAnim - 0.75f, yAnim - 5, 1.5f, 10, col);
                rect(context, xAnim - 5, yAnim - 0.75f, 10, 1.5f, col);
                rect(context, xAnim, yAnim - 5, 5, 1.5f, col);
                rect(context, xAnim - 5, yAnim + 4, 5.25f, 1.5f, col);
                rect(context, xAnim - 5f, yAnim - 5, 1.5f, 4.25f, col);
                rect(context, xAnim + 3.5f, yAnim, 1.5f, 5.5f, col);
                context.getMatrices().pop();
            }
            case Default -> {
                xAnim = midX;
                yAnim = midY;
                DrawContext context = event.drawContext;
                int black = DropDownColors.rgba(0, 0, 0, 180);
                float offset = animated.get() ? -3f + progress * 3f : 0;
                float cx = xAnim, cy = yAnim;

                if (true) { 
                    rect(context, cx - 1, cy - 6 + offset, 2, 4, black);
                    rect(context, cx - 0.5f, cy - 5.5f + offset, 1, 3, col);
                }
                rect(context, cx - 1, cy + 2 - offset, 2, 4, black);
                rect(context, cx - 0.5f, cy + 2.5f - offset, 1, 3, col);
                rect(context, cx - 6 + offset, cy - 1, 4, 2, black);
                rect(context, cx - 5.5f + offset, cy - 0.5f, 3, 1, col);
                rect(context, cx + 2 - offset, cy - 1, 4, 2, black);
                rect(context, cx + 2.5f - offset, cy - 0.5f, 3, 1, col);
                if (dot.get()) {
                    rect(context, cx - 1f, cy - 1f, 2, 2, black);
                    rect(context, cx - 0.5f, cy - 0.5f, 1, 1, col);
                }
            }
        }
    }

    private void updateDynamic(float midX, float midY) {

        float yawDelta = mc.player.prevHeadYaw - mc.player.getHeadYaw();
        float pitchDelta = prevPitch - mc.player.getPitch();
        float rangeF = range.get().floatValue();
        float speed = 0.14f, back = 0.22f;

        if (yawDelta > 0) xAnim = fast(xAnim, midX - rangeF, speed);
        else if (yawDelta < 0) xAnim = fast(xAnim, midX + rangeF, speed);
        else xAnim = fast(xAnim, midX, back);

        if (pitchDelta > 0) yAnim = fast(yAnim, midY - rangeF, speed);
        else if (pitchDelta < 0) yAnim = fast(yAnim, midY + rangeF, speed);
        else yAnim = fast(yAnim, midY, back);

        prevPitch = mc.player.getPitch();

        if (!dynamic.get()) {
            xAnim = midX;
            yAnim = midY;
        }
    }

    private static float fast(float value, float target, float speed) {
        return value + (target - value) * MathHelper.clamp(speed, 0f, 1f);
    }

    private static void rect(DrawContext context, float x, float y, float w, float h, int packed) {
        MorzhSmoothRenderer.roundedRectNoBegin(context, x, y, w, h, 0.2f, packed);
    }

    public enum Mode {
        Default("Классика"),
        Circle("Круг"),
        WiseTree("Мешанка"),
        Dot("Точка");

        private final String title;

        Mode(String title) {
            this.title = title;
        }

        @Override
        public String toString() {
            return title;
        }
    }
}

