    private AutoBuyEntry matchOffer(ItemStack stack) {
        if (stack == null || stack.isEmpty()) return null;
        if (stack.contains(DataComponentTypes.CONTAINER) && !stack.get(DataComponentTypes.CONTAINER).stream().allMatch(ItemStack::isEmpty)) {
            return null;
        }
        for (AutoBuyEntry item : AutoBuyEntry.values()) {
            if (!item.l()) continue;
            if (!item.a(stack)) continue;
            int unit = FunTimeAh.unitPrice(stack);
            if (unit <= 0 || unit > item.k()) continue;
            long balance = FunTimeAh.balance();
            long total = (long) unit * Math.max(stack.getCount(), 1);
            if (balance > 0 && total > balance) continue;
            return item;
        }
        return null;
    }

    private boolean confirmLooksSafe(ScreenHandler handler) {
        if (pendingLimit > 0 && pendingUnit > pendingLimit) return false;
        for (int i = 0; i < Math.min(handler.slots.size(), 27); i++) {
            ItemStack stack = handler.getSlot(i).getStack();
            if (stack.isEmpty()) continue;
            if (matchOffer(stack) != null) return true;
            int unit = FunTimeAh.unitPrice(stack);
            if (unit > 0 && pendingLimit > 0 && unit <= pendingLimit) return true;
        }
        return pendingUnit > 0 && pendingLimit > 0 && pendingUnit <= pendingLimit;
    }

