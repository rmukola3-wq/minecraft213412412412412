    private void queuePending(ItemStack stack, int unit, long paid) {
        pendingBuys.addLast(new PendingBuy(stack.copy(), unit, Math.max(paid, 1)));
        while (pendingBuys.size() > 16) pendingBuys.removeFirst();
    }

    private void onBuyChat(String message) {
        if (buyFailed(message)) {
            skipPending();
            needRefresh = false;
            buyLockTicks = 0;
            bounceToAh();
            return;
        }
        if (!boughtSuccessfully(message)) return;

        long chatPaid = parsePrice(message);
        PendingBuy pending = pendingBuys.pollFirst();
        String name;
        int count;
        long paid;
        if (pending != null) {
            name = pending.stack.getName().getString();
            count = Math.max(pending.stack.getCount(), 1);
            paid = chatPaid > 0 ? chatPaid : pending.paid;
            bought.addFirst(pending.stack);
            pendingItem = null;
            pendingUnit = 0;
        } else if (pendingItem != null) {
            name = pendingItem.getName().getString();
            count = Math.max(pendingItem.getCount(), 1);
            paid = chatPaid > 0 ? chatPaid : (long) Math.max(pendingUnit, 1) * count;
            bought.addFirst(pendingItem.copy());
            pendingItem = null;
            pendingUnit = 0;
        } else {
            name = "Лот";
            count = 1;
            paid = chatPaid;
        }

        long now = System.currentTimeMillis();
        if (paid <= 0) return;
        if (paid == lastDealPaid && now - lastDealAt < 250L) return;
        lastDealPaid = paid;
        lastDealAt = now;

        int fee = ahFee.get();
        long sell = fee <= 0 ? paid : (long) Math.ceil(paid / (1.0 - fee / 100.0));
        int unit = (int) Math.max(1, paid / count);
        deals.addFirst(new Deal(name, count, unit, paid, sell));
        while (deals.size() > 64) deals.removeLast();
        ChatUtils.infoPrefix("AutoBuy", "В таблицу: " + Formatting.RED + name + Formatting.GRAY + " за "
            + Formatting.RED + formatMoney(paid) + Formatting.GRAY + " → окуп " + formatMoney(sell));
        ignoreSlot = -1;
        buyLockTicks = 0;
        bounceToAh();
    }

    private static long parsePrice(String message) {
        Matcher matcher = PRICE_IN_CHAT.matcher(message.replace('\u00A0', ' '));
        long best = 0;
        while (matcher.find()) {
            String digits = matcher.group(1).replaceAll("[^0-9]", "");
            if (digits.isEmpty() || digits.length() > 15) continue;
            try {
                long n = Long.parseLong(digits);
                if (n > best) best = n;
            } catch (NumberFormatException ignored) {
            }
        }
        return best;
    }

    private static boolean buyFailed(String message) {
        String t = message.toLowerCase(Locale.ROOT);
        return t.contains("недостаточно") || t.contains("не хватает") || t.contains("нехватает")
            || t.contains("нет денег") || t.contains("не можете купить") || t.contains("нельзя купить")
            || t.contains("лот уже") || t.contains("товар не актуален") || t.contains("уже купили")
            || t.contains("товар уже") || (t.contains("ошибка") && t.contains("купил"))
            || t.contains("нет места") || t.contains("инвентарь заполнен") || t.contains("нет свободн")
            || t.contains("кто-то опередил") || t.contains("предложение истекло");
    }

    private static boolean boughtSuccessfully(String message) {
        String t = message.toLowerCase(Locale.ROOT);
        return t.contains("успешно купили") || t.contains("успешно приобрели") || t.contains("вы купили")
            || t.contains("успешная покупка") || t.contains("вы приобрели");
    }

    private void recordDeal(ItemStack stack, int unit) {
        if (unit <= 0) return;
        int count = Math.max(stack.getCount(), 1);
        long paid = (long) unit * count;
        int fee = ahFee.get();
        long sell = fee <= 0 ? paid : (long) Math.ceil(paid / (1.0 - fee / 100.0));
        deals.addFirst(new Deal(stack.getName().getString(), count, unit, paid, sell));
        while (deals.size() > 64) deals.removeLast();
    }

