            context.draw,
            left,
            top + height,
            WIDTH,
            1f,
            context.fade(MorzhGuiColors.packed(MorzhGuiColors.ACCENT)),
            context.fade(
                MorzhGuiColors.packed(MorzhGuiColors.ACCENT_DARK) & 0x00FFFFFF
            )
        );
