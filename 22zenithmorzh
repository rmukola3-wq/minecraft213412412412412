        add(new Macros());
        add(new Friends());
        add(new Accounts());
        add(new Waypoints());
        add(new Profiles());
        add(new Proxies());
        add(new Hud());

        CombatTargets.INSTANCE.ensureSubscribed();

        MorzhClient.EVENT_BUS.subscribe(Systems.class);
    }

    private static System<?> add(System<?> system) {
        systems.put(system.getClass(), system);
        MorzhClient.EVENT_BUS.subscribe(system);
        system.init();

