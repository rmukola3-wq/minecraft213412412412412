package dev.morzh.client.gui.morzh;

import dev.morzh.client.gui.themes.morzh.MorzhGuiColors;
import dev.morzh.client.systems.modules.Category;
import dev.morzh.client.systems.modules.Modules;
import dev.morzh.client.utils.sound.MorzhSoundManager;
import net.minecraft.client.gui.DrawContext;
import net.minecraft.client.gui.screen.Screen;
import net.minecraft.text.Text;
import org.lwjgl.glfw.GLFW;

import java.util.ArrayList;
import java.util.List;
import java.util.Locale;

public class MorzhThunderScreen extends Screen {
    private static final int SEARCH_WIDTH = 180;
    private static final int SEARCH_HEIGHT = 18;
    private static final int SEARCH_TOP = 6;

    private static final int EDGE_MARGIN = 5;
    private static final float OPEN_RESPONSIVENESS = 16f;

    private static final List<MorzhCategoryPanel> PANELS = new ArrayList<>();

    private String search = "";
    private boolean searchFocused;

    private int searchX;
    private int searchY;

    private float openAnim;
    private boolean closing;
    private boolean opened;

    public MorzhThunderScreen() {
        super(Text.literal("Morzh Client"));
    }

    @Override
    protected void init() {
        boolean firstOpen = PANELS.isEmpty();

        if (firstOpen) createPanels();

        for (MorzhCategoryPanel panel : PANELS) {
            panel.setScreenBounds(width, height);
        }

        if (firstOpen) {
            arrangePanels();
        }
        else {
            for (MorzhCategoryPanel panel : PANELS) panel.clampToScreen();
        }

        searchX = Math.max(EDGE_MARGIN, (width - SEARCH_WIDTH) / 2);
        searchY = SEARCH_TOP;

        if (!opened) {
            opened = true;
            openAnim = 0f;
            closing = false;

            MorzhSoundManager.playOpen();
        }
    }

    private void createPanels() {
        for (Category category : Modules.loopCategories()) {
            PANELS.add(new MorzhCategoryPanel(category, 0, 0));
        }
    }

    private void arrangePanels() {
        if (PANELS.isEmpty()) return;

        int top = searchY + SEARCH_HEIGHT + EDGE_MARGIN;
        int step = MorzhCategoryPanel.WIDTH + MorzhCategoryPanel.GAP;

        int usableWidth = Math.max(1, width - EDGE_MARGIN * 2);

        int columns = Math.max(
            1,
            Math.min(
                PANELS.size(),
                (usableWidth + MorzhCategoryPanel.GAP) / step
            )
        );

        int rows = (PANELS.size() + columns - 1) / columns;

        int usableHeight = Math.max(0, height - top - EDGE_MARGIN);
        int rowStep = Math.max(
            MorzhCategoryPanel.HEADER_HEIGHT + MorzhCategoryPanel.GAP,
            rows > 0 ? usableHeight / rows : usableHeight
        );

        int rowWidth = columns * MorzhCategoryPanel.WIDTH
            + (columns - 1) * MorzhCategoryPanel.GAP;

        int startX = EDGE_MARGIN + Math.max(0, (usableWidth - rowWidth) / 2);

        for (int index = 0; index < PANELS.size(); index++) {
            MorzhCategoryPanel panel = PANELS.get(index);

            panel.setX(startX + index % columns * step);
            panel.setY(top + index / columns * rowStep);
            panel.clampToScreen();
        }
    }

    @Override
    public boolean shouldPause() {
        return false;
    }

    @Override
    public void render(
        DrawContext context,
        int mouseX,
        int mouseY,
        float delta
    ) {
        float frameDelta = MorzhAnimUtil.beginFrame();

        renderBackground(context, mouseX, mouseY, delta);

        context.draw();

        openAnim = MorzhAnimUtil.approach(
            openAnim,
            closing ? 0f : 1f,
            OPEN_RESPONSIVENESS,
            frameDelta
        );

        if (closing && openAnim <= 0.01f) {
            super.close();
            return;
        }

        MorzhGuiContext gui = new MorzhGuiContext(
            context,
            mouseX,
            mouseY,
            frameDelta,
            MorzhAnimUtil.easeOutCubic(openAnim)
        );

        MorzhSmoothRenderer.roundedRect(
            context,
            0,
            0,
            width,
            height,
            0f,
            gui.fade(MorzhGuiColors.packed(MorzhGuiColors.BACKGROUND))
        );

        renderSearch(gui);

        String query = search.toLowerCase(Locale.ROOT);

        for (MorzhCategoryPanel panel : PANELS) {
            panel.setScreenBounds(width, height);
            panel.applySearch(query);
            panel.tick(frameDelta);
        }

        for (MorzhCategoryPanel panel : PANELS) {
            panel.render(gui);
        }

        MorzhScissor.reset();

        renderTooltip(gui);
    }

    private void renderSearch(MorzhGuiContext gui) {
        MorzhSmoothRenderer.roundedRect(
            gui.draw,
            searchX,
            searchY,
            SEARCH_WIDTH,
            SEARCH_HEIGHT,
            MorzhGuiColors.SETTING_RADIUS,
            gui.fade(
                MorzhGuiColors.packed(
                    searchFocused
                        ? MorzhGuiColors.SEARCH_FOCUSED
                        : MorzhGuiColors.SEARCH_BG
                )
            ),
            gui.fade(MorzhGuiColors.packed(MorzhGuiColors.OUTLINE_DARK)),
            1f
        );

        boolean empty = search.isEmpty();
        String text = empty ? "Search..." : search;

        if (searchFocused && !empty) text = text + "_";

        MorzhSmoothRenderer.text(
            gui.draw,
            text,
            searchX + 6,
            searchY + (SEARCH_HEIGHT - MorzhSmoothRenderer.textHeight()) / 2.0,
            gui.fade(
                MorzhGuiColors.packed(
                    empty ? MorzhGuiColors.TEXT_MUTED : MorzhGuiColors.TEXT
                )
            ),
            false
        );
    }

    private void renderTooltip(MorzhGuiContext gui) {
        if (gui.tooltip == null || gui.tooltip.isEmpty()) return;

        double textWidth = MorzhSmoothRenderer.textWidth(gui.tooltip);
        double textHeight = MorzhSmoothRenderer.textHeight();

        float boxWidth = (float) textWidth + 10f;
        float boxHeight = (float) textHeight + 8f;

        float left = Math.min(gui.mouseX + 10f, width - boxWidth - 2f);
        float top = Math.min(gui.mouseY + 12f, height - boxHeight - 2f);

        left = Math.max(2f, left);
        top = Math.max(2f, top);

        MorzhSmoothRenderer.roundedRect(
            gui.draw,
            left,
            top,
            boxWidth,
            boxHeight,
            MorzhGuiColors.SETTING_RADIUS,
            gui.fade(MorzhGuiColors.packed(MorzhGuiColors.PANEL_BODY)),
            gui.fade(MorzhGuiColors.packed(MorzhGuiColors.OUTLINE_DARK)),
            1f
        );

        MorzhSmoothRenderer.text(
            gui.draw,
            gui.tooltip,
            left + 5f,
            top + (boxHeight - textHeight) / 2f,
            gui.fade(MorzhGuiColors.packed(MorzhGuiColors.TEXT)),
            false
        );
    }

    @Override
    public boolean mouseClicked(double mouseX, double mouseY, int button) {
        if (isOverSearch(mouseX, mouseY)) {
            searchFocused = true;
            MorzhSoundManager.playKeyPress();

            return true;
        }

        searchFocused = false;

        for (int i = PANELS.size() - 1; i >= 0; i--) {
            MorzhCategoryPanel panel = PANELS.get(i);

            if (panel.mouseClicked(mouseX, mouseY, button)) {
                PANELS.remove(i);
                PANELS.add(panel);

                return true;
            }
        }

        return super.mouseClicked(mouseX, mouseY, button);
    }

    @Override
    public boolean mouseDragged(
        double mouseX,
        double mouseY,
        int button,
        double deltaX,
        double deltaY
    ) {
        for (int i = PANELS.size() - 1; i >= 0; i--) {
            if (PANELS.get(i).mouseDragged(mouseX, mouseY, button)) {
                return true;
            }
        }

        return super.mouseDragged(mouseX, mouseY, button, deltaX, deltaY);
    }

    @Override
    public boolean mouseReleased(double mouseX, double mouseY, int button) {
        for (MorzhCategoryPanel panel : PANELS) {
            panel.mouseReleased(mouseX, mouseY, button);
        }

        return super.mouseReleased(mouseX, mouseY, button);
    }

    @Override
    public boolean mouseScrolled(
        double mouseX,
        double mouseY,
        double horizontalAmount,
        double verticalAmount
    ) {
        for (int i = PANELS.size() - 1; i >= 0; i--) {
            if (PANELS.get(i).mouseScrolled(mouseX, mouseY, verticalAmount)) {
                return true;
            }
        }

        return super.mouseScrolled(
            mouseX,
            mouseY,
            horizontalAmount,
            verticalAmount
        );
    }

    @Override
    public boolean keyPressed(int keyCode, int scanCode, int modifiers) {
        if (searchFocused) {
            if (keyCode == GLFW.GLFW_KEY_ENTER
                || keyCode == GLFW.GLFW_KEY_KP_ENTER
                || keyCode == GLFW.GLFW_KEY_ESCAPE) {
                searchFocused = false;
