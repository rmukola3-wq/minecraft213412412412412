            context.draw,
            isExpanded() ? "-" : "+",
            left + WIDTH - 9,
            top + (HEADER_HEIGHT - 2 - textHeight) / 2f,
            context.fade(MorzhGuiColors.packed(MorzhGuiColors.TEXT_ENABLED)),
            false
        );
