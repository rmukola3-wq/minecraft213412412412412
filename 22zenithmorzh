package dev.morzh.client.utils.render.perf;

public final class ChunkMeshPerf {

  public static int skyLuminance;

  public static int blockLuminance;

  public static boolean clearLightmap;

  public static boolean extraLightActive;
  public static boolean playerLight;
  public static boolean targetLight;
  public static int playerRange;
  public static int playerPeak;
  public static int targetRange;
  public static int targetPeak;
  public static int playerX;
  public static int playerY;
  public static int playerZ;
  public static int targetX;
  public static int targetY;
  public static int targetZ;

  public static boolean xrayActive;

  private ChunkMeshPerf() {}

  public static int applySkyLight(int sky) {
    int lum = skyLuminance;
    return lum == 0 ? sky : Math.max(lum, sky);
  }

  public static int applyBlockLight(int bl, int x, int y, int z) {
    int lum = blockLuminance;
    int light = lum == 0 ? bl : Math.max(lum, bl);
    if (!extraLightActive) return light;
    int extra = sampleExtra(x, y, z);
    return extra == 0 ? light : Math.max(extra, light);
  }

  public static int sampleExtra(int x, int y, int z) {
    int extra = 0;
    if (playerLight) {
      extra = Math.max(extra, falloff(playerX, playerY, playerZ, x, y, z, playerRange, playerPeak));
    }
    if (targetLight) {
      extra = Math.max(extra, falloff(targetX, targetY, targetZ, x, y, z, targetRange, targetPeak));
    }
    return extra;
  }

  private static int falloff(int fx, int fy, int fz, int x, int y, int z, int range, int peak) {
    double dx = fx + 0.5 - (x + 0.5);
    double dy = fy + 0.5 - (y + 0.5);
    double dz = fz + 0.5 - (z + 0.5);
    double distSq = dx * dx + dy * dy + dz * dz;
    int rangeSq = range * range;
    if (distSq >= rangeSq) return 0;
    float t = 1f - (float) (distSq / rangeSq);
    return Math.max(1, Math.round(peak * t * t));
  }

  public static void reset() {
    skyLuminance = 0;
    blockLuminance = 0;
    clearLightmap = false;
    extraLightActive = false;
    playerLight = false;
    targetLight = false;
    xrayActive = false;
  }
}

