                        .filter(ApplyEffectsConsumeEffect.class::isInstance)
                        .map(ApplyEffectsConsumeEffect.class::cast)
                        .flatMap(apply -> apply.effects().stream())
                        .forEach(effect -> event.appendStart(getStatusText(effect)));
