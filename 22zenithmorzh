        if (shader == ShaderKind.Web) {
            float web = Math.abs((float) Math.sin((x + z) * 8.0F + time * 2.0F));
            int value = 170 + Math.round(web * 85.0F);
            return new Color(value, value, value, Math.round(alpha * 255.0F));
