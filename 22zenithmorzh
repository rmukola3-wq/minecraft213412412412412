package dev.morzh.client.gui.rasty.compat;

import net.minecraft.client.MinecraftClient;
import net.minecraft.client.gui.screen.Screen;

public final class MenuClipboard {
    private MenuClipboard() {}

    public static boolean isPaste(KeyInput input) {
        return ctrl(input, 86);
    }

    public static boolean isCopy(KeyInput input) {
        return ctrl(input, 67);
    }

    public static boolean isCut(KeyInput input) {
        return ctrl(input, 88);
    }

    public static boolean isSelectAll(KeyInput input) {
        return ctrl(input, 65);
    }

    private static boolean ctrl(KeyInput input, int key) {
        return input.key() == key && Screen.hasControlDown() && !Screen.hasShiftDown() && !Screen.hasAltDown();
    }

    public static String read(MinecraftClient client, int maxLen, boolean host) {
        if (client == null || client.keyboard == null) return "";
        String pasted = client.keyboard.getClipboard();
        if (pasted == null || pasted.isEmpty()) return "";
        pasted = pasted.replace("\n", "").replace("\r", "").replace("\t", "").trim();
        StringBuilder sb = new StringBuilder();
        for (char c : pasted.toCharArray()) {
            if (sb.length() >= maxLen) break;
            if (host) {
                if (Character.isLetterOrDigit(c) || c == '.' || c == ':' || c == '-' || c == '_') sb.append(c);
            } else if (c >= 32 && c != 127) {
                sb.append(c);
            }
        }
        return sb.toString();
    }

    public static void write(MinecraftClient client, String text) {
        if (client == null || client.keyboard == null || text == null) return;
        client.keyboard.setClipboard(text);
    }

    public static String apply(KeyInput input, MinecraftClient client, String current, int maxLen, boolean host) {
        if (isCopy(input) || isCut(input)) {
            write(client, current == null ? "" : current);
            return isCut(input) ? "" : current;
        }
        if (isPaste(input)) {
            String pasted = read(client, maxLen, host);
            if (pasted.isEmpty()) return current;
            String base = current == null ? "" : current;
            if (base.length() + pasted.length() > maxLen) {
                pasted = pasted.substring(0, Math.max(0, maxLen - base.length()));
            }
            return base + pasted;
        }
        return current;
    }

    public static boolean handled(KeyInput input) {
        return isCopy(input) || isCut(input) || isPaste(input) || isSelectAll(input);
    }
}

