        if (onlyAttackKey.get() && !mc.options.attackKey.isPressed()) return;
        if (selectedNorm == null) return;

        float dt = (float) event.frameTime;
        if (dt <= 0.0F || dt > 0.1F) dt = 1.0F / 60.0F;

        Vec3d point = pointOnBox(target.getBoundingBox(), selectedNorm);
        if (smoothedPoint == null || smoothedPoint.squaredDistanceTo(point) > 9.0) {
            smoothedPoint = point;
        } else {
            float pointT = MathHelper.clamp(11.0F * dt, 0.0F, 1.0F);
            smoothedPoint = new Vec3d(
                MathHelper.lerp(pointT, smoothedPoint.x, point.x),
                MathHelper.lerp(pointT, smoothedPoint.y, point.y),
                MathHelper.lerp(pointT, smoothedPoint.z, point.z)
            );
        }

        Vec3d delta = smoothedPoint.subtract(mc.player.getEyePos());
        float wantedYaw = (float) MathHelper.wrapDegrees(Math.toDegrees(Math.atan2(delta.z, delta.x)) - 90.0);
        float wantedPitch = MathHelper.clamp(
            (float) -Math.toDegrees(Math.atan2(delta.y, Math.hypot(delta.x, delta.z))),
            -89.9F,
            89.9F
        );

        float yaw = mc.player.getYaw();
        float pitch = mc.player.getPitch();
        float yawError = MathHelper.wrapDegrees(wantedYaw - yaw);
        float pitchError = wantedPitch - pitch;

