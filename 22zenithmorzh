            case VonTime -> handleFunTimeMode();
            case Grim -> {
                if (e.pre && MoveUtil.hasPlayerMovement()) handleGrimCollision();
            }
            case Collision -> {
                if (e.pre) handleCollisionMode();
            }
            case HolyWorld -> {
                if (e.pre && MoveUtil.hasPlayerMovement()) handleHolyWorldMode();
            }
            case GrimSpeed -> {
                if (!e.pre) handleGrimSpeedMotion();
            }
            default -> {}
        }
    }

    private void handleCollisionMode() {
        if (collisionRequireMoving.get() && !MoveUtil.isMoving()) return;
        if (shouldSkipTick(collisionSkipChance.get())) return;

        int collisions = countCollisions(collisionExpand.get(), collisionOnlyPlayers.get(), false);
        collisions = Math.min(collisions, collisionMaxCollisions.get());
        if (collisions <= 0) return;

        Entity nearest = findNearestCollisionTarget();
        Vec3d direction = null;
        if (nearest != null) {
            Vec3d toTarget = nearest.getPos().subtract(mc.player.getPos());
            double len = Math.hypot(toTarget.x, toTarget.z);
            if (len >= 1.0E-4) direction = new Vec3d(toTarget.x / len, 0, toTarget.z / len);
        }
        applyEntityPush(collisionBoost.get() * collisions, direction);
    }

    private void handleGrimCollision() {
        switch (grimProfile.get()) {
            case New -> handleGrimNew();
            case Old -> handleGrimOld();
            case Push -> handleGrimPush();
        }
    }

    private void handleGrimNew() {
        List<Entity> entities = findGrimCollidingEntities(true, grimExpand.get(), grimOnlyPlayers.get());
        if (entities.isEmpty()) return;

        int applied = 0;
        for (Entity entity : entities) {
            if (applied >= grimMaxCollisions.get()) break;
            mc.player.pushAwayFrom(entity);

            double extra = grimBoost.get();
            if (extra > 0) {
                Vec3d away = mc.player.getPos().subtract(entity.getPos());
                double len = Math.hypot(away.x, away.z);
                if (len >= 1.0E-4) {
                    away = new Vec3d(away.x / len, 0, away.z / len);
                    mc.player.addVelocity(away.x * extra, 0, away.z * extra);
                }
            }
            applied++;
        }
    }

    private void handleGrimOld() {
        if (shouldSkipTick(grimSkipChance.get())) return;

        List<Entity> entities = findGrimCollidingEntities(false, grimExpand.get(), grimOnlyPlayers.get());
        if (entities.isEmpty()) return;

        int collisions = Math.min(entities.size(), grimMaxCollisions.get());
        applyEntityPush(grimBoost.get() * collisions, null);
    }

    private void handleGrimPush() {
        List<Entity> entities = findGrimCollidingEntities(true, grimExpand.get(), grimOnlyPlayers.get());
        if (entities.isEmpty()) return;

        int applied = 0;
        for (Entity entity : entities) {
            if (applied >= grimMaxCollisions.get()) break;
            mc.player.pushAwayFrom(entity);
            applied++;
        }
    }

    private Box getGrimSweptBox(double expand) {
        double halfWidth = mc.player.getWidth() / 2.0;
        double height = mc.player.getHeight();
        Box prev = new Box(
            mc.player.prevX - halfWidth, mc.player.prevY, mc.player.prevZ - halfWidth,
            mc.player.prevX + halfWidth, mc.player.prevY + height, mc.player.prevZ + halfWidth
        );
        Box current = mc.player.getBoundingBox().expand(0.003);
        return prev.union(current).expand(expand);
    }

    private List<Entity> findGrimCollidingEntities(boolean swept, double expand, boolean onlyPlayers) {
        List<Entity> result = new ArrayList<>();
        Box box = swept ? getGrimSweptBox(expand) : mc.player.getBoundingBox().expand(expand);

        for (Entity ent : mc.world.getEntities()) {
            if (ent == mc.player || ent instanceof ArmorStandEntity) continue;
            if (onlyPlayers && !(ent instanceof PlayerEntity)) continue;
            if (!(ent instanceof LivingEntity)) continue;
            if (!ent.isPushable()) continue;
            if (box.intersects(ent.getBoundingBox())) result.add(ent);
        }
        return result;
    }

    private boolean shouldSkipTick(double chance) {
        return chance > 0 && ThreadLocalRandom.current().nextDouble() < chance;
    }

    private void applyEntityPush(double boost, Vec3d direction) {
        if (boost <= 0 || mc.player == null) return;

        if (mc.player.isSprinting()) boost *= 0.96;

        double dx;
        double dz;
        if (direction != null) {
            dx = direction.x * boost;
            dz = direction.z * boost;
        } else {
            double[] motion = MoveUtil.forward(1.0);
            double len = Math.hypot(motion[0], motion[1]);
            if (len < 1.0E-4) return;
            dx = motion[0] / len * boost;
            dz = motion[1] / len * boost;
        }
        mc.player.addVelocity(dx, 0, dz);
    }

    private void handleHolyWorldMode() {
        int collisions = countCollisions(0.35, false, true);
        if (collisions <= 0) return;
        double[] motion = MoveUtil.forward(0.0205 * collisions);
        mc.player.addVelocity(motion[0], 0, motion[1]);
    }

    private void handleFunTimeMode() {
        if (!mc.player.isSwimming() && !mc.player.isGliding() && !mc.player.isSneaking()) {
            if (mc.player.getBoundingBox().maxY - mc.player.getBoundingBox().minY < 1.5f) {
                float motion = mc.player.hasStatusEffect(StatusEffects.SPEED) ? 0.32f : 0.28f;
                MoveUtil.setVelocity(motion);
            }
        }
    }

    private void handleGrimSpeedUpdate() {
        if ((mc.player.isTouchingWater() && grimSpeedPauseLiquids.get())
            || (mc.player.isSneaking() && grimSpeedPauseSneak.get())) {
            return;
        }
        updateGrimSpeedTarget();
    }

    private void handleGrimSpeedMotion() {
        if ((mc.player.isTouchingWater() && grimSpeedPauseLiquids.get())
            || (mc.player.isSneaking() && grimSpeedPauseSneak.get())) {
            return;
        }
        if (!MoveUtil.isMoving()) return;

        if (isTargetStatic && targetEntity != null) {
            handleStaticTargetBoost();
        } else {
            handleGrimDistanceMode();
        }
    }

    private void updateGrimSpeedTarget() {
        LivingEntity auraTarget = getAuraTarget();
        if (auraTarget == null) {
            resetGrimSpeedState();
            return;
        }
        targetEntity = auraTarget;

        Vec3d currentPos = targetEntity.getPos();
        long currentTime = System.currentTimeMillis();

        if (prevTargetPos != null) {
            targetMovementSpeed = currentPos.distanceTo(prevTargetPos);
            isTargetStatic = targetMovementSpeed < grimSpeedMoveThreshold.get();
        }
        prevTargetPos = currentPos;

        if (grimSpeedBacktrack.get() && !isTargetStatic) {
            updateBacktrackHistory(currentPos, currentTime);
        }

        if (lastTargetPos == null) {
            predictedPos = lastTargetPos = currentPos;
        } else {
            Vec3d velocity = currentPos.subtract(lastTargetPos);
            if (grimSpeedPredict.get() && !isTargetStatic) {
                predictedPos = currentPos.add(
                    velocity.x * grimSpeedPredictFactor.get(),
                    velocity.y * grimSpeedPredictFactor.get(),
                    velocity.z * grimSpeedPredictFactor.get()
                );
                if (!mc.world.isChunkLoaded((int) predictedPos.x >> 4, (int) predictedPos.z >> 4)) {
                    predictedPos = currentPos;
                }
            } else {
                predictedPos = currentPos;
            }
            lastTargetPos = currentPos;
        }
    }

    private void handleStaticTargetBoost() {
        if (targetEntity == null) return;
        Box checkBox = mc.player.getBoundingBox().expand(grimSpeedStaticRange.get());
        if (!checkBox.intersects(targetEntity.getBoundingBox())) return;

        Vec3d direction = targetEntity.getPos().subtract(mc.player.getPos());
        double len = Math.hypot(direction.x, direction.z);
        if (len < 1.0E-4) return;
        applyEntityPush(grimSpeedStaticForce.get(), new Vec3d(direction.x / len, 0, direction.z / len));
    }

    private void updateBacktrackHistory(Vec3d currentPos, long currentTime) {
        positionHistory.add(currentPos);
        timeHistory.add(currentTime);
        long maxAge = (long) (grimSpeedBacktrackTicks.get() * 50);
        while (!timeHistory.isEmpty() && currentTime - timeHistory.getFirst() > maxAge) {
            positionHistory.removeFirst();
            timeHistory.removeFirst();
        }
        backtrackPos = findBestBacktrackPosition(currentPos);
    }

    private Vec3d findBestBacktrackPosition(Vec3d currentPos) {
        if (positionHistory.isEmpty() || mc.player == null) return currentPos;
        Vec3d playerPos = mc.player.getPos();
        double maxBacktrackDist = grimSpeedBacktrackDist.get();
        Vec3d bestPos = currentPos;
        double bestDistance = playerPos.distanceTo(currentPos);

        for (int i = positionHistory.size() - 1; i >= 0; i--) {
            Vec3d historyPos = positionHistory.get(i);
            double distToPlayer = playerPos.distanceTo(historyPos);
