        if (entity instanceof PlayerEntity player) {
            push("Totem", player.getName().getString() + " popped", Kind.Warn);
        }
    }

    public enum Kind { On, Off, Warn, Info }

    public record Toast(String title, String body, Kind kind, long at) {}
}

