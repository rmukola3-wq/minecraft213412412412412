        }

        cleanDeathWPs(maxDeathPositions.get());
    }

    private void cleanDeathWPs(int max) {
        int oldWpC = 0;

        for (Iterator<Waypoint> it = Waypoints.get().iterator(); it.hasNext();) {
            Waypoint wp = it.next();

            if (wp.name.get().startsWith("Death ") && wp.icon.get().equals("skull")) {
                oldWpC++;

                if (oldWpC > max)
                    it.remove();
            }
        }
    }

