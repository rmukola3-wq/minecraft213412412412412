			if (action != null) action.run();
			return true;
		}

		return false;
	}

    public void set(double value) {
        this.value = MathHelper.clamp(value, min, max);
    }

    public double get() {
        return value;
    }

    protected double valueWidth() {
        double valuePercentage = (value - min) / (max - min);
