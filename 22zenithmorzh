package dev.morzh.client.utils.player;

import net.minecraft.component.DataComponentTypes;
import net.minecraft.component.type.LoreComponent;
import net.minecraft.item.ItemStack;
import net.minecraft.text.Text;
import net.minecraft.util.Formatting;

import java.util.List;
import java.util.Locale;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

public final class AuctionPriceParser {
    private static final Pattern FUN_TIME_DOLLAR = Pattern.compile("\\$\\s*([\\d][\\d\\s,.]*)");
    private static final Pattern PRICE_NUMBER = Pattern.compile("(\\d[\\d\\s,._]*)\\s*([kкmм]?)");

    private AuctionPriceParser() {
    }

    public static long price(ItemStack stack) {
        if (stack == null || stack.isEmpty()) return -1;

        LoreComponent lore = stack.get(DataComponentTypes.LORE);
        if (lore != null) {
            for (Text line : lore.lines()) {
                String raw = Formatting.strip(line.getString());
                if (raw == null) continue;
                long dollar = parseDollar(raw);
                if (dollar > 0) return dollar;
            }
            for (Text line : lore.lines()) {
                String raw = Formatting.strip(line.getString());
                if (raw == null) continue;
                String lower = raw.toLowerCase(Locale.ROOT);
                if (lower.contains("цена") || lower.contains("price") || lower.contains("стоимость")
                    || lower.contains("купить") || lower.contains("монет") || lower.contains("coins")
                    || lower.contains("₽")) {
                    long value = parseLine(raw);
                    if (value > 0) return value;
                }
            }
        }

        Text customName = stack.get(DataComponentTypes.CUSTOM_NAME);
        if (customName != null) {
            long named = parseDollar(customName.getString());
            if (named > 0) return named;
            named = parseLine(customName.getString());
            if (named > 0) return named;
        }

        return -1;
    }

    public static boolean auctionScreen(String title) {
        if (title == null) return false;
        String t = Formatting.strip(title).toLowerCase(Locale.ROOT);
        return t.contains("аукцион") || t.contains("auction") || t.contains("рынок") || t.contains("поиск");
    }

    public static boolean confirmScreen(String title) {
        if (title == null) return false;
        String t = Formatting.strip(title).toLowerCase(Locale.ROOT);
        return t.contains("подтвержд") || t.contains("подозрительн") || t.contains("confirm")
            || t.contains("подозрительная цена");
    }

    private static long parseDollar(String line) {
        Matcher matcher = FUN_TIME_DOLLAR.matcher(line);
        if (!matcher.find()) return -1;
        return parseDigits(matcher.group(1), "");
    }

    private static long parseLine(String line) {
        if (line == null || line.isBlank()) return -1;
        Matcher matcher = PRICE_NUMBER.matcher(line.toLowerCase(Locale.ROOT));
        long best = -1;
        while (matcher.find()) {
            long n = parseDigits(matcher.group(1), matcher.group(2));
            if (n > best) best = n;
        }
        return best;
    }

    private static long parseDigits(String raw, String suffix) {
        String digits = raw.replaceAll("[\\s,._]", "");
        if (digits.isEmpty()) return -1;
        try {
            long n = Long.parseLong(digits);
            if ("k".equals(suffix) || "к".equals(suffix)) n *= 1000L;
            else if ("m".equals(suffix) || "м".equals(suffix)) n *= 1_000_000L;
            return n;
        } catch (NumberFormatException ignored) {
            return -1;
        }
    }
}

