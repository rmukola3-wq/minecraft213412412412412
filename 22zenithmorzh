        if (mc.player == null || mc.world == null) return;

        if (event.packet instanceof VehicleMoveS2CPacket && cancelServerPackets.get()) {
            event.cancel();
            return;
        }

        if (!(event.packet instanceof EntityPassengersSetS2CPacket packet)) return;
        if (profile.get() != Profile.BoatFly || !autoRemount.get()) return;

        Entity vehicle = mc.world.getEntityById(packet.getEntityId());
        if (!(vehicle instanceof AbstractBoatEntity boat)) return;

        boolean weArePassenger = false;
        for (int id : packet.getPassengerIds()) {
            if (id == mc.player.getId()) weArePassenger = true;
        }

        if (weArePassenger) {
            lastBoatId = boat.getId();
            wasInBoat = true;
            remounting = false;
            mountFailTicks = 0;
            if (!mc.player.hasVehicle() && forceClientMount.get()) {
                mc.player.startRiding(boat, true);
