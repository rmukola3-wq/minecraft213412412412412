        return System.currentTimeMillis() - lastSwapAt >= delay;
    }

    private boolean shouldHoldTotem() {
        float hp = mc.player.getHealth() + mc.player.getAbsorptionAmount();
        boolean elytra = mc.player.getEquippedStack(EquipmentSlot.CHEST).getItem() == Items.ELYTRA;
        double required = elytra ? elytraHealth.get() : health.get();
        double release = required + releaseMargin();

        boolean danger = hp <= required || checkCrystal() || checkMinecart() || checkFall() || checkMace() || checkTrident();
        boolean safe = hp >= release && !checkCrystal() && !checkMinecart() && !checkFall() && !checkMace() && !checkTrident();

        if (profile.get() == Profile.Delta || profile.get() == Profile.Legit) {
            if (holdSticky == null) holdSticky = danger;
            else if (danger) holdSticky = true;
            else if (safe) holdSticky = false;
            return holdSticky;
        }

        return danger;
    }

    private double releaseMargin() {
        return switch (profile.get()) {
            case Fast -> 0.5;
            case Legit -> 2.0;
            case Delta -> 0.5;
        };
    }

    private boolean checkCrystal() {
        if (profile.get() == Profile.Legit || !onCrystal.get()) return false;

        double range = crystalRange.get();
        for (Entity entity : mc.world.getEntities()) {
            if (entity instanceof EndCrystalEntity && mc.player.distanceTo(entity) <= range) {
                return true;
            }
