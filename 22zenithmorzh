    @EventHandler(priority = EventPriority.HIGHEST)
    private static void onRender3D(Render3DEvent event) {
        VisualState.sync();
        if (mc.gameRenderer == null) return;

        Vec3d cam = mc.gameRenderer.getCamera().getPos();
        x = cam.x;
        y = cam.y;
        z = cam.z;

        float yaw = (float) Math.toRadians(mc.gameRenderer.getCamera().getYaw());
        float pitch = (float) Math.toRadians(mc.gameRenderer.getCamera().getPitch());
        yawSin = (float) Math.sin(yaw);
        yawCos = (float) Math.cos(yaw);
        pitchSin = (float) Math.sin(pitch);
        pitchCos = (float) Math.cos(pitch);
    }

    public static double squaredDistanceTo(double px, double py, double pz) {
        double dx = px - x;
        double dy = py - y;
        double dz = pz - z;
        return dx * dx + dy * dy + dz * dz;
    }

    public static boolean isWithin(double px, double py, double pz, double maxDistSq) {
        return squaredDistanceTo(px, py, pz) <= maxDistSq;
    }

    public static Vec3d right() {
        return new Vec3d(yawCos, 0, yawSin);
    }

    public static Vec3d up() {
        return new Vec3d(-yawSin * pitchSin, pitchCos, yawCos * pitchSin);
    }
