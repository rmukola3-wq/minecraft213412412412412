package dev.morzh.client.systems.modules.combat.aura;

import net.minecraft.client.network.ClientPlayerEntity;
import net.minecraft.entity.effect.StatusEffects;
import net.minecraft.network.packet.c2s.play.ClientCommandC2SPacket;

public final class AuraCriticalController {
    private static final int SPRINT_RESTORE_TICKS = 2;
    private static final double SAFE_FALL_DISTANCE = 0.10;

    private State state = State.Ground;
    private State lastReportedState;

    private boolean jumpIssued;
    private boolean sprintSuppressed;
    private boolean restoreSprint;
    private boolean positionInitialized;

    private int missedCycles;
    private int sprintRestoreTicks;

    private double lastY;
    private double trackedFallDistance;

    public void tick(ClientPlayerEntity player) {
        if (player == null) {
            clearState();
            return;
        }

        if (sprintRestoreTicks > 0) {
            sprintRestoreTicks--;

            if (sprintRestoreTicks == 0) {
                restoreSprint(player);
            }
        }
    }

    public Decision update(
        ClientPlayerEntity player,
        Mode mode,
        boolean cooldownReady,
        float cooldownProgress,
        boolean autoJump,
        double jumpAtProgress,
        double minimumFallDistance
    ) {
        if (player == null) {
            clearState();
            return Decision.Wait;
        }

        updateTrackedFallDistance(player);

        if (mode == Mode.Off) {
            restoreSprint(player);
            jumpIssued = false;

            setState(
                State.Ground,
                player,
                cooldownReady,
                cooldownProgress
            );

            return cooldownReady
                ? Decision.NormalAttack
                : Decision.Wait;
        }

        String blockedReason = getBlockedReason(player);

        if (blockedReason != null) {
            restoreSprint(player);
            jumpIssued = false;

            setState(
                State.Blocked,
                player,
                cooldownReady,
                cooldownProgress
            );

            return mode == Mode.Smart && cooldownReady
                ? Decision.NormalAttack
                : Decision.Wait;
        }

        if (!player.isOnGround()) {
            if (jumpIssued || mode == Mode.OnlyCriticals) {
                suppressSprint(player);
            }

            double requiredFallDistance = Math.max(
                minimumFallDistance,
                SAFE_FALL_DISTANCE
            );

            boolean realCriticalWindow =
                player.fallDistance > requiredFallDistance;

            boolean trackedCriticalWindow =
                trackedFallDistance > requiredFallDistance;

            if (
                cooldownReady
                    && (
                    realCriticalWindow
                        || trackedCriticalWindow
                )
            ) {
                setState(
                    State.CriticalWindow,
                    player,
                    true,
                    cooldownProgress
                );

                return Decision.CriticalAttack;
            }

            setState(
                State.WaitingFall,
                player,
                cooldownReady,
                cooldownProgress
            );

            return Decision.Wait;
        }

        trackedFallDistance = 0.0;

        if (jumpIssued) {
            jumpIssued = false;
            missedCycles++;

            restoreSprint(player);

            setState(
                State.MissedWindow,
                player,
                cooldownReady,
                cooldownProgress
            );

            if (
                mode == Mode.Smart
                    && cooldownReady
            ) {
                return Decision.NormalAttack;
            }
        }

        setState(
            State.Ground,
            player,
            cooldownReady,
            cooldownProgress
        );

        if (!autoJump) {
            return mode == Mode.Smart && cooldownReady
                ? Decision.NormalAttack
                : Decision.Wait;
        }

        if (
            cooldownReady
                || cooldownProgress >= jumpAtProgress
        ) {
            startJump(
                player,
                cooldownReady,
                cooldownProgress
            );
        }

        return Decision.Wait;
    }

    public void beforeAttack(
        ClientPlayerEntity player,
        Decision decision
    ) {
        if (player == null) return;

        if (decision == Decision.CriticalAttack) {
            suppressSprint(player);
        }
    }

    public void afterAttack(ClientPlayerEntity player) {
        setState(
            State.Recovery,
            player,
            true,
            player == null
                ? 0.0f
                : player.getAttackCooldownProgress(0.5f)
        );

        jumpIssued = false;
        missedCycles = 0;

        if (sprintSuppressed) {
            sprintRestoreTicks = SPRINT_RESTORE_TICKS;
        } else {
            restoreSprint = false;
        }
    }

    public void reset(ClientPlayerEntity player) {
        if (player != null) {
            restoreSprint(player);
        }

        clearState();
    }

    public boolean shouldSuppressSprint(Mode mode) {
        return mode != Mode.Off
            && (
            sprintSuppressed
                || state == State.WaitingFall
                || state == State.CriticalWindow
        );
    }

    public boolean isWaitingForCritical() {
        return state == State.WaitingFall
            || state == State.CriticalWindow
            || state == State.MissedWindow;
    }

    public State getState() {
        return state;
    }

    public int getMissedCycles() {
        return missedCycles;
    }

    private void updateTrackedFallDistance(
        ClientPlayerEntity player
    ) {
        double currentY = player.getY();

        if (!positionInitialized) {
            positionInitialized = true;
            lastY = currentY;
            trackedFallDistance = 0.0;
            return;
        }

        double movementY = currentY - lastY;
        lastY = currentY;

        if (player.isOnGround()) {
            trackedFallDistance = 0.0;
            return;
        }

        if (movementY < 0.0) {
            trackedFallDistance += -movementY;
        } else if (movementY > 0.0) {
            trackedFallDistance = 0.0;
        }
    }

    private void startJump(
        ClientPlayerEntity player,
        boolean cooldownReady,
        float cooldownProgress
    ) {
        trackedFallDistance = 0.0;

        suppressSprint(player);
        player.jump();

        jumpIssued = true;

        setState(
            State.WaitingFall,
            player,
            cooldownReady,
            cooldownProgress
        );
    }

    private String getBlockedReason(
        ClientPlayerEntity player
    ) {
        if (player.isClimbing()) return "climbing";
        if (player.isTouchingWater()) return "touching-water";
        if (player.isSubmergedInWater()) return "submerged";
        if (player.isInLava()) return "lava";
        if (player.hasVehicle()) return "vehicle";
        if (player.getAbilities().flying) return "flying";
        if (player.isGliding()) return "gliding";

        if (player.hasStatusEffect(StatusEffects.BLINDNESS)) {
            return "blindness";
        }

        if (player.hasStatusEffect(StatusEffects.LEVITATION)) {
            return "levitation";
        }

        if (player.hasStatusEffect(StatusEffects.SLOW_FALLING)) {
            return "slow-falling";
        }

        return null;
    }

    private void suppressSprint(
        ClientPlayerEntity player
    ) {
        if (sprintSuppressed) {
            player.setSprinting(false);
            return;
        }

        restoreSprint = player.isSprinting();
        player.setSprinting(false);

        if (
            restoreSprint
                && player.networkHandler != null
        ) {
            player.networkHandler.sendPacket(
                new ClientCommandC2SPacket(
                    player,
                    ClientCommandC2SPacket.Mode.STOP_SPRINTING
                )
            );
        }

        sprintSuppressed = true;
    }

    private void restoreSprint(
        ClientPlayerEntity player
    ) {
        if (!sprintSuppressed) return;

        if (
            restoreSprint
                && player.networkHandler != null
        ) {
            player.setSprinting(true);

            player.networkHandler.sendPacket(
                new ClientCommandC2SPacket(
                    player,
                    ClientCommandC2SPacket.Mode.START_SPRINTING
                )
            );
        }

        sprintSuppressed = false;
        restoreSprint = false;
        sprintRestoreTicks = 0;
    }

    private void setState(
        State newState,
        ClientPlayerEntity player,
        boolean cooldownReady,
        float cooldownProgress
    ) {
        state = newState;

        lastReportedState = newState;
    }

    private void clearState() {
        state = State.Ground;
        lastReportedState = null;

        jumpIssued = false;
        sprintSuppressed = false;
        restoreSprint = false;
        positionInitialized = false;

        missedCycles = 0;
        sprintRestoreTicks = 0;

        lastY = 0.0;
        trackedFallDistance = 0.0;
    }

    public enum Mode {
        Off,
        Smart,
        OnlyCriticals
    }

    public enum Decision {
        Wait,
        NormalAttack,
        CriticalAttack
    }

    public enum State {
        Ground,
        WaitingFall,
        CriticalWindow,
        MissedWindow,
        Recovery,
        Blocked
    }
}

