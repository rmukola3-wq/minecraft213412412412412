            rows.add(new Row(Items.ENDER_PEARL.getDefaultStack(), "Эндер-шар", "0,0s"));
        }
        if (rows.isEmpty() && !isInEditor()) {
            setSize(0, 0);
            return;
        }

        float cardW = 135 * s;
        for (Row row : rows) {
            cardW = Math.max(cardW, (float) MorzhSmoothRenderer.textWidth(row.name, fs) + 70 * s);
        }
        float header = 22 * s;
        float rowH = 18 * s;
        setSize(cardW, header + rows.size() * rowH + 4 * s);

        List<Row> draw = rows;
        renderer.post(() -> {
