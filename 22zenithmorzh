    private final List<ClickSlotC2SPacket> pendingClicks = new ArrayList<>();
    private boolean closeOnMove;
    private boolean flushNextTick;
    private boolean rastyClosing;
    private int rastyWait;
    private int rastyCloseSync = -1;

    private final List<Packet<?>> syntaxDelayed = new CopyOnWriteArrayList<>();
    private boolean syntaxProcessing;
    private boolean syntaxSilent;
    private boolean syntaxMoved;
    private int syntaxPhase = -1;

    private final List<Packet<?>> rockstarPackets = new ArrayList<>();
    private final List<ClickSlotC2SPacket> rockstarPickup = new ArrayList<>();
    private boolean rockstarStay;
    private boolean rockstarSending;
    private int rockstarScreenId;
    private long rockstarStayAt;

    private final List<Packet<?>> grimQueued = new ArrayList<>();
    private boolean grimSilent;
    private boolean grimResumeSprint;
    private int grimPhase = -1;
    private int grimWait;
    private int grimCloseSync = -1;

    public GUIMove() {
        super(Categories.Movement, "gui-move", "Walk in GUI. Grim bypass by default.");
    }

    @Override
    public void onDeactivate() {
        flushClicks();
        syntaxCleanup();
        rockstarCleanup();
        grimCleanup();
        rastyClosing = false;
        set(mc.options.forwardKey, false);
        set(mc.options.backKey, false);
        set(mc.options.leftKey, false);
        set(mc.options.rightKey, false);
        if (jump.get()) set(mc.options.jumpKey, false);
        if (sneak.get()) set(mc.options.sneakKey, false);
        if (sprint.get()) set(mc.options.sprintKey, false);
    }

    public boolean disableSpace() {
        return isActive() && jump.get() && mc.options.jumpKey.isDefault();
    }

    public boolean disableArrows() {
        return isActive() && arrowsRotate.get();
    }

    @EventHandler(priority = EventPriority.HIGH)
    private void onSend(PacketEvent.Send event) {
        if (syntaxSilent || rockstarSending || grimSilent) return;
        if (grim()) {
            onGrimSend(event);
            return;
        }
        if (syntax()) {
            onSyntaxSend(event);
            return;
        }
        if (rockstar()) {
            onRockstarSend(event);
            return;
        }
        if (!queueClicks() || mc.player == null) return;

        if (event.packet instanceof CloseHandledScreenC2SPacket packet) {
            mc.player.currentScreenHandler.setCursorStack(ItemStack.EMPTY);
            if (profile.get() == Profile.Rasty && (isMoving() || !pendingClicks.isEmpty())) {
                event.cancel();
                rastyClosing = true;
                rastyWait = 5;
                rastyCloseSync = ((CloseHandledScreenC2SPacketAccessor) packet).getSyncId();
                set(mc.options.forwardKey, false);
                set(mc.options.backKey, false);
                set(mc.options.leftKey, false);
                set(mc.options.rightKey, false);
                set(mc.options.jumpKey, false);
                return;
            }
            if (!pendingClicks.isEmpty()) {
                flushNextTick = true;
                event.cancel();
            } else if (isMoving() && mc.currentScreen instanceof InventoryScreen) {
                event.cancel();
                mc.setScreen(null);
            }
            closeOnMove = false;
            return;
        }

        if (!(event.packet instanceof ClickSlotC2SPacket packet)) return;
        if (!(mc.currentScreen instanceof InventoryScreen)) return;

        if (!isMoving() && !mc.player.input.playerInput.jump() && pendingClicks.isEmpty()) {
            closeOnMove = true;
            return;
        }

        if (isMovingInInventory()) {
            pendingClicks.add(packet);
            event.cancel();
        }
    }

    @EventHandler(priority = EventPriority.HIGH)
    private void onReceive(PacketEvent.Receive event) {
        if ((rockstar() && rockstarCancelClose.get() || grim()) && event.packet instanceof CloseScreenS2CPacket close) {
            if (grim() && close.getSyncId() != 0) return;
            event.cancel();
            return;
        }
        if (!queueClicks() || mc.player == null) return;
        if (event.packet instanceof CloseScreenS2CPacket packet && packet.getSyncId() == 0) {
            event.cancel();
        }
    }

    @EventHandler
    private void onOpenScreen(OpenScreenEvent event) {
        if (!queueClicks() || mc.player == null) return;
        mc.player.currentScreenHandler.setCursorStack(ItemStack.EMPTY);
        if (event.screen == null && !pendingClicks.isEmpty()) flushNextTick = true;
    }

    @EventHandler
    private void onTick(TickEvent.Pre event) {
        if (mc.player == null) return;

        if (grim()) {
            onGrimTick();
            return;
        }

        if (syntax()) {
            onSyntaxTick();
            return;
        }

        if (rockstar()) {
            onRockstarTick();
            return;
        }

        if (rastyClosing) {
            rastyWait--;
            boolean stopped = Math.abs(mc.player.getVelocity().x) < 0.03 && Math.abs(mc.player.getVelocity().z) < 0.03;
            if (rastyWait <= 0 || stopped) {
                flushClicks();
                int sync = rastyCloseSync >= 0 ? rastyCloseSync : mc.player.currentScreenHandler.syncId;
                mc.player.networkHandler.sendPacket(new CloseHandledScreenC2SPacket(sync));
                if (mc.currentScreen != null) mc.setScreen(null);
                rastyClosing = false;
                rastyCloseSync = -1;
            }
            return;
        }

        if (flushNextTick) {
            flushNextTick = false;
            flushClicks();
            if (mc.player.currentScreenHandler.syncId != 0) {
                mc.player.networkHandler.sendPacket(new CloseHandledScreenC2SPacket(mc.player.currentScreenHandler.syncId));
            }
            if (mc.currentScreen instanceof InventoryScreen) mc.setScreen(null);
        }

        if (expensive() && closeOnMove && mc.currentScreen instanceof InventoryScreen && (isMoving() || mc.player.input.playerInput.jump())) {
            closeOnMove = false;
            mc.setScreen(null);
        }
    }

    @EventHandler
    private void onPlayerMoveEvent(PlayerTickMovementEvent event) {
        if (syntaxProcessing || grimPhase >= 0) {
            lockMovementKeys();
            return;
        }
        if (rockstarStay) {
            lockMovementKeys();
            return;
        }
        if (rastyClosing) return;
        if (skip()) return;
        if (screens.get() == Screens.GUI && !(mc.currentScreen instanceof WidgetScreen)) return;
        if (screens.get() == Screens.Inventory && mc.currentScreen instanceof WidgetScreen) return;
        if (!canWalkInScreen()) return;

        if (queueClicks() && pendingClicks.isEmpty() && !mc.player.currentScreenHandler.getCursorStack().isEmpty()) return;

        set(mc.options.forwardKey, Input.isPressed(mc.options.forwardKey));
        set(mc.options.backKey, Input.isPressed(mc.options.backKey));
        set(mc.options.leftKey, Input.isPressed(mc.options.leftKey));
        set(mc.options.rightKey, Input.isPressed(mc.options.rightKey));

        if (jump.get()) set(mc.options.jumpKey, Input.isPressed(mc.options.jumpKey));
        if (sneak.get()) set(mc.options.sneakKey, Input.isPressed(mc.options.sneakKey));
        if (sprint.get()) set(mc.options.sprintKey, Input.isPressed(mc.options.sprintKey));
    }

    public boolean isStoppingForGrim() {
        return isActive() && grim() && grimPhase >= 0;
    }

    @EventHandler(priority = EventPriority.HIGH)
    private void onPlayerInput(PlayerInputEvent event) {
        if (grimPhase >= 0) {
            event.input = new PlayerInput(false, false, false, false, false, event.input.sneak(), false);
            return;
        }
        if (!rockstar() || !rockstarStay) return;
        event.setDirectional(false, false, false, false);
        event.setJump(false);
    }

    @EventHandler
    private void onRender3D(Render3DEvent event) {
        if (skip()) return;
        if (screens.get() == Screens.GUI && !(mc.currentScreen instanceof WidgetScreen)) return;
        if (screens.get() == Screens.Inventory && mc.currentScreen instanceof WidgetScreen) return;
        if (!canWalkInScreen()) return;

        float rotationDelta = Math.min((float) (rotateSpeed.get() * event.frameTime * 20f), 100);

        if (arrowsRotate.get()) {
            float yaw = mc.player.getYaw();
            float pitch = mc.player.getPitch();

            if (Input.isKeyPressed(GLFW_KEY_LEFT)) yaw -= rotationDelta;
            if (Input.isKeyPressed(GLFW_KEY_RIGHT)) yaw += rotationDelta;
            if (Input.isKeyPressed(GLFW_KEY_UP)) pitch -= rotationDelta;
            if (Input.isKeyPressed(GLFW_KEY_DOWN)) pitch += rotationDelta;

            pitch = MathHelper.clamp(pitch, -90, 90);
            mc.player.setYaw(yaw);
            mc.player.setPitch(pitch);
        }
    }

    private void flushClicks() {
        if (mc.player == null || pendingClicks.isEmpty()) {
            pendingClicks.clear();
            return;
        }
        for (ClickSlotC2SPacket click : pendingClicks) {
            mc.player.networkHandler.sendPacket(click);
        }
        pendingClicks.clear();
        mc.player.currentScreenHandler.setCursorStack(ItemStack.EMPTY);
    }

    public boolean shouldCancelMovingArmorClick(int slotId, SlotActionType actionType) {
        if (!isActive() || mc.player == null) return false;
        if (!expensive() && !grim()) return false;
        if (!(mc.currentScreen instanceof InventoryScreen)) return false;
        if (!isMovingInInventory() && !(grim() && grimBusy())) return false;
        if (slotId != 6) return false;
        return actionType == SlotActionType.SWAP || actionType == SlotActionType.PICKUP;
    }

    public boolean shouldCancelUnsafeInvClick(int button, SlotActionType actionType) {
        if (!isActive() || !grim() || mc.player == null) return false;
        if (!grimBusy() && grimQueued.isEmpty() && grimPhase < 0) return false;
        if (actionType == SlotActionType.PICKUP_ALL) return true;
        return button == 1 && actionType == SlotActionType.PICKUP;
    }

    private boolean expensive() {
        return profile.get() == Profile.Expensive;
    }

    private boolean queueClicks() {
        return profile.get() == Profile.Rasty || profile.get() == Profile.Expensive;
    }

    private boolean grim() {
        return profile.get() == Profile.Grim;
    }

    private void onGrimSend(PacketEvent.Send event) {
        if (mc.player == null || mc.player.networkHandler == null) {
            grimCleanup();
            return;
        }

        boolean busy = grimBusy();

        if (event.packet instanceof ClickSlotC2SPacket click) {
            if (!grimInPlayerInv()) return;
        if (click.getActionType() == SlotActionType.PICKUP_ALL
            || (click.getButton() == 1 && click.getActionType() == SlotActionType.PICKUP)) {
            if (busy || !grimQueued.isEmpty() || grimPhase >= 0) {
                event.cancel();
                return;
            }
        }
            if (busy || !grimQueued.isEmpty() || grimPhase >= 0) {
                grimQueued.add(click);
                event.cancel();
            }
            return;
        }

        if (event.packet instanceof CloseHandledScreenC2SPacket close) {
            int sync = ((CloseHandledScreenC2SPacketAccessor) close).getSyncId();
            if (busy || !grimQueued.isEmpty() || grimPhase >= 0) {
                event.cancel();
                if (grimPhase < 0) startGrimStop(sync);
                else if (grimCloseSync < 0) grimCloseSync = sync;
            }
            return;
        }

        if (grimPhase < 0) return;

        if (event.packet instanceof PlayerInputC2SPacket) {
            event.cancel();
            sendSilent(new PlayerInputC2SPacket(new PlayerInput(false, false, false, false, false, false, false)));
            return;
        }

        if (event.packet instanceof HandSwingC2SPacket
            || event.packet instanceof PlayerInteractEntityC2SPacket
            || event.packet instanceof PlayerInteractItemC2SPacket
            || event.packet instanceof PlayerInteractBlockC2SPacket) {
            event.cancel();
        }
    }

    private void onGrimTick() {
        boolean inMoveGui = mc.currentScreen instanceof InventoryScreen
            || mc.currentScreen instanceof WidgetScreen
            || mc.currentScreen instanceof CreativeInventoryScreen;

        if (grimPhase < 0) {
            if (!inMoveGui && !grimQueued.isEmpty() && mc.player.currentScreenHandler != null) {
                startGrimStop(mc.player.currentScreenHandler.syncId);
            }
            return;
        }

        lockMovementKeys();
        if (mc.player.isSprinting()) {
            mc.player.setSprinting(false);
        }

        switch (grimPhase) {
            case 0 -> {
                sendGrimStopPackets();
                grimPhase = 1;
                grimWait = 0;
            }
            case 1 -> {
                grimWait++;
                if (!mc.player.isSprinting() && grimWait >= 1) grimPhase = 2;
                else if (grimWait >= 3) grimPhase = 2;
            }
            case 2 -> {
                for (Packet<?> packet : grimQueued) {
                    if (!(packet instanceof CloseHandledScreenC2SPacket)) sendSilent(packet);
                }
                grimQueued.removeIf(packet -> !(packet instanceof CloseHandledScreenC2SPacket));
                grimPhase = 3;
            }
            case 3 -> {
                int sync = grimCloseSync >= 0 ? grimCloseSync : mc.player.currentScreenHandler.syncId;
                sendSilent(new CloseHandledScreenC2SPacket(sync));
                grimQueued.clear();
                if (mc.currentScreen != null) mc.setScreen(null);
                unlockMovementKeys();
                restoreGrimSprint();
                grimCleanup();
            }
        }
    }

    private void startGrimStop(int sync) {
        grimPhase = 0;
        grimWait = 0;
        grimCloseSync = sync;
        grimResumeSprint = mc.player.isSprinting()
            || Input.isPressed(mc.options.sprintKey)
            || Input.isPressed(mc.options.forwardKey);
        lockMovementKeys();
        sendGrimStopPackets();
    }

    private void restoreGrimSprint() {
        if (mc.player == null || mc.player.networkHandler == null) return;
        if (!grimResumeSprint && !Input.isPressed(mc.options.sprintKey)) return;
        if (!Input.isPressed(mc.options.forwardKey) && !mc.options.forwardKey.isPressed()) return;
        mc.player.setSprinting(true);
        if (Input.isPressed(mc.options.sprintKey)) set(mc.options.sprintKey, true);
        sendSilent(new ClientCommandC2SPacket(mc.player, ClientCommandC2SPacket.Mode.START_SPRINTING));
    }

    private void sendGrimStopPackets() {
        if (mc.player == null || mc.player.networkHandler == null) return;
        mc.player.setSprinting(false);
        sendSilent(new ClientCommandC2SPacket(mc.player, ClientCommandC2SPacket.Mode.STOP_SPRINTING));
        sendSilent(new PlayerInputC2SPacket(new PlayerInput(false, false, false, false, false, false, false)));
    }

    private boolean grimInPlayerInv() {
        if (mc.currentScreen instanceof InventoryScreen || mc.currentScreen instanceof CreativeInventoryScreen) return true;
        return mc.player != null && mc.player.currentScreenHandler != null && mc.player.currentScreenHandler.slots.size() == 46;
    }

    private boolean grimBusy() {
        if (mc.player == null) return false;
        if (grimKeysDown()) return true;
        if (isMoving()) return true;
        if (mc.player.isSprinting()) return true;
        if (mc.player.input == null) return false;
        var in = mc.player.input.playerInput;
        return in.jump() || in.sprint() || in.forward() || in.backward() || in.left() || in.right();
    }

    private boolean grimKeysDown() {
        if (mc.getWindow() == null || mc.options == null) return false;
        for (KeyBinding binding : new KeyBinding[]{
            mc.options.forwardKey, mc.options.backKey, mc.options.rightKey, mc.options.leftKey, mc.options.jumpKey
        }) {
            InputUtil.Key key = ((KeyBindingAccessor) binding).getKey();
            if (key.getCategory() == InputUtil.Type.KEYSYM
                && InputUtil.isKeyPressed(mc.getWindow().getHandle(), key.getCode())) {
                return true;
            }
        }
        return false;
    }

    private void grimCleanup() {
        grimQueued.clear();
        grimSilent = false;
        grimResumeSprint = false;
        grimPhase = -1;
        grimWait = 0;
        grimCloseSync = -1;
    }

    private boolean syntax() {
        return profile.get() == Profile.Syntax;
    }

    private boolean rockstar() {
        return profile.get() == Profile.Rockstar;
    }

    private boolean isMoving() {
        return mc.player.input.playerInput.forward()
            || mc.player.input.playerInput.backward()
            || mc.player.input.playerInput.left()
            || mc.player.input.playerInput.right();
    }

    private boolean isMovingInInventory() {
        return mc.currentScreen instanceof InventoryScreen
            && (!pendingClicks.isEmpty() || isMoving() || mc.player.input.playerInput.jump());
    }

    private boolean canWalkInScreen() {
        if (mc.currentScreen == null) return false;
        if (profile.get() == Profile.Wild) return true;
        if (syntax() || rockstar() || grim()) {
            return mc.currentScreen instanceof InventoryScreen
                || mc.currentScreen instanceof WidgetScreen
                || mc.currentScreen instanceof CreativeInventoryScreen;
        }
        if (profile.get() == Profile.Rasty) {
            return mc.currentScreen instanceof WidgetScreen
                || mc.currentScreen instanceof InventoryScreen
                || (mc.player != null && mc.player.currentScreenHandler.slots.size() == 46);
        }
        if (mc.currentScreen instanceof GenericContainerScreen
            || mc.currentScreen instanceof ShulkerBoxScreen
            || mc.currentScreen instanceof FurnaceScreen
            || mc.currentScreen instanceof CraftingScreen
            || mc.currentScreen instanceof CreativeInventoryScreen) {
            return false;
        }
        return true;
    }

    private void set(KeyBinding bind, boolean pressed) {
        boolean wasPressed = bind.isPressed();
        bind.setPressed(pressed);

        InputUtil.Key key = ((KeyBindingAccessor) bind).getKey();
        if (wasPressed != pressed && key.getCategory() == InputUtil.Type.KEYSYM) {
            MorzhClient.EVENT_BUS.post(KeyEvent.get(key.getCode(), 0, pressed ? KeyAction.Press : KeyAction.Release));
        }
    }

    private void onSyntaxSend(PacketEvent.Send event) {
        if (mc.player == null || mc.player.networkHandler == null) {
            syntaxCleanup();
            return;
        }

        boolean moving = syntaxMoved || syntaxKeysDown();
        syntaxMoved |= moving && !syntaxDelayed.isEmpty();

        if (event.packet instanceof ClickSlotC2SPacket click
            && mc.currentScreen instanceof InventoryScreen
            && moving
            && mc.player.currentScreenHandler.slots.size() >= 27) {
            syntaxDelayed.add(click);
            event.cancel();
        } else if (event.packet instanceof CloseHandledScreenC2SPacket close
            && ((CloseHandledScreenC2SPacketAccessor) close).getSyncId() == 0
            && moving
            && !syntaxProcessing) {
            if (syntaxDelayed.isEmpty()) {
                event.cancel();
            } else {
                syntaxDelayed.add(close);
                event.cancel();
                syntaxProcessing = true;
                syntaxPhase = 0;
            }
        }

        if (syntaxProcessing && event.packet instanceof PlayerInputC2SPacket) {
            event.cancel();
            sendSilent(new PlayerInputC2SPacket(new PlayerInput(false, false, false, false, false, false, false)));
        }

        if (!syntaxDelayed.isEmpty() && syntaxProcessing) {
            Packet<?> p = event.packet;
            if (p instanceof HandSwingC2SPacket
                || p instanceof PlayerInteractEntityC2SPacket
                || p instanceof PlayerInteractItemC2SPacket
                || p instanceof PlayerInteractBlockC2SPacket) {
                event.cancel();
            }
        }
    }

    private void onSyntaxTick() {
        boolean inMoveGui = mc.currentScreen instanceof InventoryScreen
            || mc.currentScreen instanceof WidgetScreen
            || mc.currentScreen instanceof CreativeInventoryScreen;

        if (!syntaxProcessing && syntaxDelayed.isEmpty() && !inMoveGui) {
            syntaxMoved = false;
        }

        if (inMoveGui) {
            syntaxMoved |= syntaxKeysDown() && !syntaxDelayed.isEmpty();
        }

        if (syntaxPhase < 0) return;

        if (syntaxMode.get() == SyntaxMode.Bypass) {
            switch (syntaxPhase) {
                case 0 -> lockMovementKeys();
                case 1 -> {
                    for (Packet<?> p : syntaxDelayed) sendSilent(p);
                    syntaxDelayed.clear();
                    syntaxProcessing = false;
                    syntaxMoved = false;
                }
                case 2 -> {
                    unlockMovementKeys();
                    syntaxPhase = -1;
                    return;
                }
            }
            syntaxPhase++;
            return;
        }

        switch (syntaxPhase) {
            case 0 -> lockMovementKeys();
            case 1, 2, 4, 6 -> {
            }
            case 3 -> {
                for (Packet<?> p : syntaxDelayed) {
                    if (!(p instanceof CloseHandledScreenC2SPacket)) sendSilent(p);
                }
            }
            case 5 -> {
                for (Packet<?> p : syntaxDelayed) {
                    if (p instanceof CloseHandledScreenC2SPacket) sendSilent(p);
                }
                syntaxDelayed.clear();
            }
            case 7 -> {
                unlockMovementKeys();
                syntaxProcessing = false;
                syntaxMoved = false;
                syntaxPhase = -1;
                return;
            }
        }
        syntaxPhase++;
    }

