        for (int step = 0; step < 220; step++) {
            Vec3d next = position.add(velocity);
            BlockHitResult blockHit = mc.world.raycast(new RaycastContext(position, next, RaycastContext.ShapeType.COLLIDER, RaycastContext.FluidHandling.NONE, mc.player));
            boolean collided = false;
            if (blockHit.getType() != HitResult.Type.MISS) {
                next = blockHit.getPos();
                collided = true;
            }
            EntityHitResult entityHit = findLivingHit(position, next, mc.player);
            if (entityHit != null) {
                next = entityHit.getPos();
                hitEntity = true;
                collided = true;
            }
            path.add(next);
            if (collided) {
                impact = next;
                break;
            }
            if (next.y < mc.world.getBottomY() - 16) break;
            position = next;
            velocity = velocity.multiply(type.drag).subtract(0, type.gravity, 0);
        }

        if (path.size() < 2) return;

        SettingColor start = lineColor.get();
        Color end = new Color(80, 180, 255, 255);
        lines.depthTest = false;
        lines.width = 2f;
        lines.begin();
        for (int i = 0; i < path.size() - 1; i++) {
            float p0 = i / (float) (path.size() - 1);
            float p1 = (i + 1) / (float) (path.size() - 1);
            pulseColor(colA, start, end, p0);
            pulseColor(colB, start, end, p1);
            colA.a = (int) (255 * pulseAlpha(p0));
            colB.a = (int) (255 * pulseAlpha(p1));
            line(path.get(i), path.get(i + 1), colA, colB);
        }
        lines.render(event.matrices);

        if (impact != null) {
            Color ring = hitEntity ? hitRed : colB;
            float pulse = 1f + 0.18f * (float) Math.sin(System.currentTimeMillis() * 0.006);
            drawHorizontalRing(event, impact, 0.35 * pulse, ring);
        }
        glLineWidth(1f);
        GlStateManager._depthMask(true);
    }

    private ItemStack pulseStack() {
        ItemStack main = mc.player.getMainHandStack();
        if (PulseType.from(main) != null) return main;
        ItemStack off = mc.player.getOffHandStack();
        return PulseType.from(off) != null ? off : ItemStack.EMPTY;
    }

    private boolean pulseReady(ItemStack stack, PulseType type) {
        Item item = stack.getItem();
        if (item == Items.BOW || item == Items.TRIDENT) {
            return mc.player.isUsingItem() && mc.player.getItemUseTimeLeft() > 0;
        }
        if (item == Items.CROSSBOW) {
            ChargedProjectilesComponent charged = stack.get(DataComponentTypes.CHARGED_PROJECTILES);
            return charged != null && !charged.isEmpty();
        }
        return type == PulseType.ENDER_PEARL || type == PulseType.POTION;
    }

    private Vec3d pulseInitial(ItemStack stack, PulseType type) {
        double speed = type.baseSpeed;
        Item item = stack.getItem();
        if (item == Items.BOW) {
            int used = stack.getMaxUseTime(mc.player) - mc.player.getItemUseTimeLeft();
            float f = used / 20f;
            float charge = Math.min(1f, Math.max(0.05f, (f * f + f * 2f) / 3f));
            speed = 3.0 * charge;
        } else if (item == Items.TRIDENT) {
            int used = stack.getMaxUseTime(mc.player) - mc.player.getItemUseTimeLeft();
            float charge = Math.min(1f, Math.max(0.1f, used / 10f));
            speed = 2.5 * charge;
        }
        return pulseLook().multiply(speed).add(mc.player.getVelocity().multiply(0.35));
    }

    private Vec3d pulseLook() {
        float yaw = mc.player.getYaw();
        float pitch = mc.player.getPitch();
        float pitchCos = (float) Math.cos(-pitch * (Math.PI / 180.0));
        float pitchSin = (float) Math.sin(-pitch * (Math.PI / 180.0));
        float yawCos = (float) Math.cos(-yaw * (Math.PI / 180.0) - Math.PI);
        float yawSin = (float) Math.sin(-yaw * (Math.PI / 180.0) - Math.PI);
        return new Vec3d(yawSin * pitchCos, pitchSin, yawCos * pitchCos).normalize();
    }

    private void pulseColor(Color out, SettingColor start, Color end, float p) {
        out.set(
            Math.round(start.r + (end.r - start.r) * p),
            Math.round(start.g + (end.g - start.g) * p),
            Math.round(start.b + (end.b - start.b) * p),
            255
        );
    }

    private float pulseAlpha(float progress) {
        if (progress <= 0.65f) return 1f;
        float range = 1f - 0.65f;
        return Math.max(0f, 1f - (progress - 0.65f) / range);
    }

    private void renderDelta(Render3DEvent event, float tickDelta, float dt) {
        Set<Integer> active = new HashSet<>();

        if (firedProjectiles.get()) {
            for (Entity ent : RenderCaches.entities()) {
                if (!deltaTracks(ent) || !deltaMoving(ent)) continue;
                if (ent instanceof ProjectileInGroundAccessor ppe && ppe.invokeIsInGround()) continue;
                List<Vec3d> path = deltaSimEntity(ent);
                if (path.size() < 2) continue;
                active.add(ent.getId());
                DeltaGhost ghost = deltaGhosts.computeIfAbsent(ent.getId(), id -> new DeltaGhost());
                ghost.live = true;
                ghost.path = path;
                ghost.icon = iconOf(ent);
                ghost.land = path.get(path.size() - 1);
                ghost.segs = path.size() - 1;
                ghost.hueBase = (ent.getUuid().getLeastSignificantBits() & 65535) / 65535f;
            }
        }

        float k = 1f - (float) Math.exp(-dt / 0.25);
        Iterator<Map.Entry<Integer, DeltaGhost>> it = deltaGhosts.entrySet().iterator();
        while (it.hasNext()) {
            Map.Entry<Integer, DeltaGhost> e = it.next();
            DeltaGhost g = e.getValue();
            boolean live = active.contains(e.getKey());
            g.alpha += ((live ? 1f : 0f) - g.alpha) * k;
            if (!live && g.alpha <= 0.01f) {
                it.remove();
                continue;
            }
            if (g.path == null || g.path.size() < 2) continue;
            drawDeltaPath(event, g);
            if (g.land != null) {
                lands.add(new LandMark(g.land.x, g.land.y, g.land.z, g.segs, g.segs, g.icon, g.alpha));
            }
            g.live = false;
        }

        deltaInHand(event, tickDelta);
        glLineWidth(1f);
        GlStateManager._depthMask(true);
    }

    private boolean deltaTracks(Entity ent) {
        if (ent instanceof ArrowEntity) return items.get().contains(Items.BOW) || items.get().contains(Items.ARROW) || items.get().contains(Items.CROSSBOW);
        if (ent instanceof TridentEntity) return items.get().contains(Items.TRIDENT);
        if (ent instanceof EnderPearlEntity) return items.get().contains(Items.ENDER_PEARL);
        if (ent instanceof PotionEntity) return items.get().contains(Items.SPLASH_POTION) || items.get().contains(Items.LINGERING_POTION);
        return false;
    }

    private boolean deltaMoving(Entity ent) {
        return ent.getX() != ent.lastRenderX || ent.getY() != ent.lastRenderY || ent.getZ() != ent.lastRenderZ;
    }

    private List<Vec3d> deltaSimEntity(Entity entity) {
        Vec3d vel = entity.getVelocity();
        Vec3d pos = entity.getPos();
        boolean isThrowable = entity instanceof ThrownItemEntity;
        double gravity = entity instanceof PotionEntity ? 0.05 : 0.03;
        List<Vec3d> path = new ArrayList<>();
        path.add(pos);
        for (int i = 0; i < 140 && vel.lengthSquared() >= 1e-6 && pos.getY() >= mc.world.getBottomY() && pos.getY() <= mc.world.getBottomY() + mc.world.getHeight(); i++) {
            double drag = mc.world.getFluidState(BlockPos.ofFloored(pos)).isIn(FluidTags.WATER) ? (isThrowable ? 0.8 : 0.6) : 0.99;
            if (isThrowable) vel = new Vec3d(vel.x * drag, (vel.y - gravity) * drag, vel.z * drag);
            Vec3d next = pos.add(vel);
            BlockHitResult impact = mc.world.raycast(new RaycastContext(pos, next, RaycastContext.ShapeType.COLLIDER, RaycastContext.FluidHandling.NONE, entity));
            if (impact.getType() != HitResult.Type.MISS) {
                path.add(impact.getPos());
                return path;
            }
            pos = next;
            if (!isThrowable) vel = new Vec3d(vel.x * drag, (vel.y * drag) - 0.05, vel.z * drag);
            path.add(pos);
        }
        return path;
    }

    private void drawDeltaPath(Render3DEvent event, DeltaGhost g) {
        int segCount = g.path.size() - 1;
        lines.depthTest = false;
        lines.width = 1.5f;
        lines.begin();
        SettingColor primary = lineColor.get();
        for (int i = 0; i < segCount; i++) {
            float max = Math.max(0f, Math.min(1f, (g.alpha * segCount) - i));
            if (max <= 0f) break;
            Vec3d a = g.path.get(i);
            float hue = (((g.hueBase + (float) (a.x * 0.05 + a.z * 0.05)) % 1f) + 1f) % 1f;
            int rgb = java.awt.Color.HSBtoRGB(hue, 1f, 1f);
            int lineAlpha = (int) (255f * (0.3f + 0.7f * (1f - i / (float) segCount)) * max * g.alpha);
            colA.set((rgb >> 16) & 255, (rgb >> 8) & 255, rgb & 255, lineAlpha);
            colA.r = (int) (colA.r * 0.35f + primary.r * 0.65f);
            colA.g = (int) (colA.g * 0.35f + primary.g * 0.65f);
            colA.b = (int) (colA.b * 0.35f + primary.b * 0.65f);
            line(g.path.get(i), g.path.get(i + 1), colA, colA);
        }
        lines.render(event.matrices);
    }

    private void deltaInHand(Render3DEvent event, float tickDelta) {
        ItemStack mainStack = mc.player.getMainHandStack();
        Item main = mainStack.getItem();
        Item off = mc.player.getOffHandStack().getItem();
        float speed = 0f;
        boolean isThrowable = false;
        boolean potion = main == Items.SPLASH_POTION || main == Items.LINGERING_POTION || off == Items.SPLASH_POTION || off == Items.LINGERING_POTION;
        if (main instanceof BowItem && (items.get().contains(Items.BOW) || items.get().contains(Items.ARROW))) {
            float pull = deltaBowPull();
            if (pull < 0.1f) return;
            speed = pull * 3f;
        } else if (main instanceof CrossbowItem && items.get().contains(Items.CROSSBOW)) {
            ChargedProjectilesComponent charged = mainStack.get(DataComponentTypes.CHARGED_PROJECTILES);
            if (charged == null || charged.isEmpty()) return;
            speed = 3f;
        } else if (main instanceof TridentItem && items.get().contains(Items.TRIDENT)) {
            speed = 2.5f;
        } else if ((main == Items.ENDER_PEARL || off == Items.ENDER_PEARL) && items.get().contains(Items.ENDER_PEARL)) {
            speed = 1.5f;
            isThrowable = true;
        } else if (potion && (items.get().contains(Items.SPLASH_POTION) || items.get().contains(Items.LINGERING_POTION))) {
            speed = 0.5f;
            isThrowable = true;
        }
        if (speed == 0f) return;

        float[] spread = (main instanceof CrossbowItem && Utils.hasEnchantment(mainStack, Enchantments.MULTISHOT))
            ? new float[]{-10f, 0f, 10f} : new float[]{0f};
        Color white = new Color(255, 255, 255, 180);
        for (float yawOff : spread) {
            DeltaHand result = deltaSimHand(speed, isThrowable, potion ? -20f : 0f, potion ? 0.05 : 0.03, yawOff, tickDelta);
            if (result.path.size() < 2) continue;
            if (result.hitEntity != null) {
                Box box = result.hitEntity.getBoundingBox();
                event.renderer.box(box, new Color(255, 100, 100, 40), new Color(255, 100, 100, 180), ShapeMode.Both, 0);
            } else if (result.side != null && !result.path.isEmpty()) {
                drawFaceCircle(event, result.path.get(result.path.size() - 1), 0.33, white, result.side);
            }
        }
    }

    private float deltaBowPull() {
        ItemStack active = mc.player.getActiveItem();
        if (!mc.player.isUsingItem() || !(active.getItem() instanceof BowItem)) return 0f;
        int useTicks = active.getItem().getMaxUseTime(active, mc.player) - mc.player.getItemUseTimeLeft();
        float f = useTicks / 20f;
        return Math.min((f * f + f * 2f) / 3f, 1f);
    }

    private DeltaHand deltaSimHand(float speed, boolean isThrowable, float pitchOffset, double gravity, float viewSpreadDegrees, float tickDelta) {
        double pitchRad = Math.toRadians(mc.player.getPitch(tickDelta));
        double yawRad = Math.toRadians(mc.player.getYaw(tickDelta));
        Vec3d look = new Vec3d(-Math.sin(yawRad) * Math.cos(pitchRad), -Math.sin(Math.toRadians(mc.player.getPitch(tickDelta) + pitchOffset)), Math.cos(yawRad) * Math.cos(pitchRad)).normalize();
        if (viewSpreadDegrees != 0f) {
            Vec3d right = new Vec3d(0, 1, 0).crossProduct(look);
            Vec3d axis = look.crossProduct(right.lengthSquared() < 1e-10 ? new Vec3d(Math.cos(yawRad), 0, Math.sin(yawRad)) : right.normalize()).normalize();
            double rad = Math.toRadians(viewSpreadDegrees);
            double c = Math.cos(rad);
            double s = Math.sin(rad);
            look = look.multiply(c).add(axis.crossProduct(look).multiply(s)).add(axis.multiply(axis.dotProduct(look) * (1.0 - c)));
        }
        Vec3d vel = look.multiply(speed).add(mc.player.getVelocity().x, mc.player.isOnGround() ? 0 : mc.player.getVelocity().y, mc.player.getVelocity().z);
        Vec3d pos = mc.player.getCameraPosVec(tickDelta);
        List<Vec3d> path = new ArrayList<>();
        path.add(pos);
        for (int i = 0; i < 130 && vel.lengthSquared() >= 1e-6 && pos.getY() >= mc.world.getBottomY(); i++) {
            double drag = mc.world.getFluidState(BlockPos.ofFloored(pos)).isIn(FluidTags.WATER) ? (isThrowable ? 0.8 : 0.6) : 0.99;
            if (isThrowable) vel = new Vec3d(vel.x * drag, (vel.y - gravity) * drag, vel.z * drag);
            Vec3d next = pos.add(vel);
            BlockHitResult hitBlock = mc.world.raycast(new RaycastContext(pos, next, RaycastContext.ShapeType.COLLIDER, RaycastContext.FluidHandling.NONE, mc.player));
            Vec3d end = hitBlock.getType() != HitResult.Type.MISS ? hitBlock.getPos() : next;
            Entity hitEntity = findLiving(pos, end, mc.player);
            if (hitEntity != null) {
                path.add(hitEntity.getBoundingBox().expand(0.3).raycast(pos, end).orElse(end));
                return new DeltaHand(path, hitEntity, null);
            }
            if (hitBlock.getType() != HitResult.Type.MISS) {
                path.add(hitBlock.getPos());
                return new DeltaHand(path, null, hitBlock.getSide());
            }
            pos = next;
            if (!isThrowable) vel = new Vec3d(vel.x * drag, (vel.y * drag) - 0.05, vel.z * drag);
            path.add(pos);
        }
        return new DeltaHand(path, null, null);
    }

    private void renderPunch(Render3DEvent event, float tickDelta) {
        ItemStack stack = punchStack();
        if (stack.isEmpty()) return;
        PunchParams params = punchParams(stack);
        if (params == null) return;

        Vec3d startPos = mc.player.getCameraPosVec(tickDelta);
        Vec3d[] directions = punchDirections(stack, tickDelta);
        SettingColor theme = lineColor.get();
        Color line = new Color(theme.r, theme.g, theme.b, 190);
        Color marker = new Color(theme.r, theme.g, theme.b, 230);

        lines.depthTest = true;
        lines.depthMask = false;
        lines.width = 2.2f;
        lines.begin();

        for (Vec3d direction : directions) {
            PunchResult result = punchPredict(params, startPos, direction);
            if (result.points.size() < 2) continue;
            for (int i = 0; i < result.points.size() - 1; i++) {
                line(result.points.get(i), result.points.get(i + 1), line, line);
            }
            if (result.entityHit != null && result.entityHit.isAlive()) {
                drawBoxLines(result.entityHit.getBoundingBox(), hitRed);
            } else if (result.blockHit != null) {
                punchImpact(result.hitPos, result.blockHit.getSide(), marker);
            }
            if (stack.isOf(Items.SPLASH_POTION) && result.hitPos != null) {
                Color glow = new Color(theme.r, theme.g, theme.b, 82);
                drawHorizontalRing(event, result.hitPos, 4.0, glow);
            }
        }

        lines.render(event.matrices);
        lines.depthMask = false;
        glLineWidth(1f);
        GlStateManager._depthMask(true);
    }

    private ItemStack punchStack() {
        ItemStack main = mc.player.getMainHandStack();
        if (!main.isEmpty() && punchParams(main) != null) return main;
        ItemStack off = mc.player.getOffHandStack();
        if (!off.isEmpty() && punchParams(off) != null) return off;
        return ItemStack.EMPTY;
    }

    private PunchParams punchParams(ItemStack stack) {
        Item item = stack.getItem();
        if (item == Items.ENDER_PEARL || item == Items.SNOWBALL || item == Items.EGG) return new PunchParams(1.5, 0.03, 0.99);
        if (item == Items.SPLASH_POTION || item == Items.LINGERING_POTION) return new PunchParams(0.5, 0.05, 0.99);
        if (item instanceof BowItem) {
            float power = 1f;
            if (mc.player.isUsingItem() && mc.player.getActiveItem() == stack) {
                float use = mc.player.getItemUseTime();
                float f = use / 20f;
                f = (f * f + f * 2f) / 3f;
                power = Math.min(f, 1f);
            }
            double velocity = 3.0 * power;
            return velocity <= 0.01 ? null : new PunchParams(velocity, 0.05, 0.99);
        }
        if (item instanceof CrossbowItem) {
            ChargedProjectilesComponent charged = stack.get(DataComponentTypes.CHARGED_PROJECTILES);
            if (charged == null || charged.isEmpty()) return null;
            return new PunchParams(3.15, 0.05, 0.99);
        }
        if (item instanceof TridentItem) return new PunchParams(2.5, 0.05, 0.99);
        return null;
    }

    private Vec3d[] punchDirections(ItemStack stack, float tickDelta) {
        Vec3d baseDir = mc.player.getRotationVec(tickDelta).normalize();
        if (!(stack.getItem() instanceof CrossbowItem) || !Utils.hasEnchantment(stack, Enchantments.MULTISHOT)) {
            return new Vec3d[]{baseDir};
        }
        float baseYaw = (float) (MathHelper.atan2(baseDir.z, baseDir.x) * (180.0 / Math.PI)) - 90f;
        float basePitch = (float) -(MathHelper.atan2(baseDir.y, MathHelper.sqrt((float) (baseDir.x * baseDir.x + baseDir.z * baseDir.z))) * (180.0 / Math.PI));
        return new Vec3d[]{
            punchYawPitch(baseYaw - 10f, basePitch),
            baseDir,
            punchYawPitch(baseYaw + 10f, basePitch)
        };
    }

    private Vec3d punchYawPitch(float yawDeg, float pitchDeg) {
        float yaw = yawDeg * ((float) Math.PI / 180f);
        float pitch = pitchDeg * ((float) Math.PI / 180f);
        float x = MathHelper.sin(-yaw - (float) Math.PI) * -MathHelper.cos(-pitch);
        float y = MathHelper.sin(-pitch);
        float z = MathHelper.cos(-yaw - (float) Math.PI) * -MathHelper.cos(-pitch);
        return new Vec3d(x, y, z).normalize();
    }

    private PunchResult punchPredict(PunchParams params, Vec3d startPos, Vec3d direction) {
        Vec3d pos = startPos;
        Vec3d motion = direction.normalize().multiply(params.velocity);
        List<Vec3d> points = new ArrayList<>();
        points.add(pos);
        Entity entityHit = null;
        Vec3d entityHitPos = null;
        final int max = 440;
        final double step = 0.5;

        for (int i = 0; i < max; i++) {
            Vec3d prev = pos;
            Vec3d next = pos.add(motion.multiply(step));
            if (entityHit == null) {
                EntityHitResult hit = findAnyHit(prev, next, mc.player);
                if (hit != null) {
                    entityHit = hit.getEntity();
                    entityHitPos = hit.getPos();
                }
            }
            BlockHitResult blockHit = mc.world.raycast(new RaycastContext(prev, next, RaycastContext.ShapeType.COLLIDER, RaycastContext.FluidHandling.NONE, mc.player));
            if (blockHit.getType() == HitResult.Type.BLOCK) {
                points.add(blockHit.getPos());
                return new PunchResult(points, blockHit, blockHit.getPos(), entityHit, entityHitPos);
            }
            points.add(next);
            pos = next;
            boolean inWater = mc.world.getBlockState(BlockPos.ofFloored(pos)).isOf(net.minecraft.block.Blocks.WATER);
            double drag = Math.pow(inWater ? 0.8 : params.drag, step);
            motion = motion.multiply(drag).subtract(0, params.gravity * step, 0);
            if (pos.y <= mc.world.getBottomY()) break;
        }
        Vec3d hitPos = entityHitPos != null ? entityHitPos : points.get(points.size() - 1);
        return new PunchResult(points, null, hitPos, entityHit, entityHitPos);
    }

    private void punchImpact(Vec3d pos, Direction side, Color color) {
        Vec3d normal = Vec3d.of(side.getVector()).normalize();
        Vec3d u = side == Direction.UP || side == Direction.DOWN ? new Vec3d(1, 0, 0) : normal.crossProduct(new Vec3d(0, 1, 0)).normalize();
        Vec3d v = normal.crossProduct(u).normalize();
        Vec3d center = pos.add(normal.multiply(0.004));
        double radius = 0.35;
        Vec3d prev = null;
        for (int i = 0; i <= 48; i++) {
            double angle = Math.PI * 2.0 * i / 48;
            Vec3d point = center.add(u.multiply(Math.cos(angle) * radius)).add(v.multiply(Math.sin(angle) * radius));
            if (prev != null) line(prev, point, color, color);
            prev = point;
        }
        line(center.add(u.multiply(-radius)), center.add(u.multiply(radius)), color, color);
        line(center.add(v.multiply(-radius)), center.add(v.multiply(radius)), color, color);
    }

    private void line(Vec3d a, Vec3d b, Color ca, Color cb) {
        lines.line(
            lines.vec3(a.x, a.y, a.z).color(ca).next(),
            lines.vec3(b.x, b.y, b.z).color(cb).next()
        );
    }

    private void stripe(Vec3d from, Vec3d to, Color ca, Color cb, double half) {
        Vec3d dir = to.subtract(from);
        Vec3d side = dir.crossProduct(from.subtract(camPos));
        if (side.lengthSquared() < 1.0e-8) side = new Vec3d(0, 1, 0);
        side = side.normalize().multiply(half);
        int i1 = ribbon.vec3(from.x + side.x, from.y + side.y, from.z + side.z).color(ca).next();
        int i2 = ribbon.vec3(from.x - side.x, from.y - side.y, from.z - side.z).color(ca).next();
        int i3 = ribbon.vec3(to.x - side.x, to.y - side.y, to.z - side.z).color(cb).next();
        int i4 = ribbon.vec3(to.x + side.x, to.y + side.y, to.z + side.z).color(cb).next();
        ribbon.quad(i1, i2, i3, i4);
    }

    private void drawHorizontalRing(Render3DEvent event, Vec3d center, double radius, Color color) {
        boolean useOwn = lines.isBuilding();
        if (!useOwn) {
            lines.depthTest = false;
            lines.width = 2f;
            lines.begin();
        }
        Vec3d prev = null;
        for (int i = 0; i <= 48; i++) {
            double a = Math.PI * 2.0 * i / 48;
            Vec3d p = center.add(Math.cos(a) * radius, 0.01, Math.sin(a) * radius);
            if (prev != null) line(prev, p, color, color);
            prev = p;
        }
        if (!useOwn) lines.render(event.matrices);
    }

    private void drawFaceCircle(Render3DEvent event, Vec3d center, double radius, Color color, Direction face) {
        Direction.Axis axis = face.getAxis();
        Vec3d u = axis == Direction.Axis.Y ? new Vec3d(1, 0, 0) : new Vec3d(0, 1, 0);
        Vec3d v = axis == Direction.Axis.Z ? new Vec3d(1, 0, 0) : new Vec3d(0, 0, 1);
        lines.depthTest = false;
        lines.width = 1.5f;
        lines.begin();
        Vec3d prev = null;
        for (int i = 0; i <= 16; i++) {
            double a = Math.PI * 2.0 * i / 16;
