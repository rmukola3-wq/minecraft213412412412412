            yawStep
        );

        pitchDelta = MathHelper.clamp(
            pitchDelta,
            -pitchStep,
            pitchStep
        );

        float gcd = RockstarMath.gcd();

        if (gcd > 0) {
            yawDelta -= yawDelta % gcd;
            pitchDelta -= pitchDelta % gcd;
        }

        yaw += yawDelta;

        pitch = MathHelper.clamp(
            pitch + pitchDelta,
            -90,
