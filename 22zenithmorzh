        fakePlayer.onDamaged(mc.world.getDamageSources().generic());
        float newHp = fakePlayer.getHealth() + fakePlayer.getAbsorptionAmount() - calcExplosionDamage(explosion.center());
        fakePlayer.setHealth(newHp);
