        ElytraMotion motion = Modules.get().get(ElytraMotion.class);
        boolean motionControlsBoost = motion != null && motion.isActive() && motion.isInZone();
        if (autoFirework.get() && !motionControlsBoost && !mc.player.isUsingItem()
            && System.currentTimeMillis() - fireworkTimer >= fireworkDelay.get()) {
            useFirework();
        }

        Vec3d origin = mc.player.getPos().add(mc.player.getVelocity())
            .add(0.0, mc.player.getEyeHeight(mc.player.getPose()), 0.0);
        lastAimPoint = box.getCenter();
        bindAimRotation(origin);
    }

    @EventHandler
    private void onRender(Render3DEvent event) {
        if (!isActive() || box == null || !renderPredictedBox.get() || predictTicks.get() <= 0) return;
        event.renderer.boxLines(box.minX, box.minY, box.minZ, box.maxX, box.maxY, box.maxZ, Color.GREEN, 0);
    }

    @EventHandler(priority = EventPriority.LOWEST)
    private void onRotationUpdate(RotationUpdateEvent event) {
        if (event.type != RotationUpdateEvent.Type.POST || !isActive()
