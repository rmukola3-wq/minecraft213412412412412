            mc.setScreen(
                new ChatScreen(Config.get().prefix.get())
            );
        }
    }

    @EventHandler
    private void onKey(KeyEvent event) {
        if (event.action == KeyAction.Press
            && KeyBinds.OPEN_GUI.matchesKey(event.key, 0)) {
            toggleGui();
        }
    }

    @EventHandler
    private void onMouseButton(MouseButtonEvent event) {
        if (event.action == KeyAction.Press
            && KeyBinds.OPEN_GUI.matchesMouse(event.button)) {
            toggleGui();
        }
    }

    private void toggleGui() {
        if (mc.currentScreen instanceof DropDownScreen dropDown) {
            dropDown.requestClose();
            return;
        }

        if (Utils.canCloseGui()) {
            mc.currentScreen.close();
            return;
        }

        if (!Utils.canOpenGui()) return;

        if (GuiThemes.get() instanceof MorzhGuiTheme) {
            mc.setScreen(new DropDownScreen());
        } else {
            Tabs.get().getFirst().openScreen(GuiThemes.get());
        }
    }

    private boolean wasWidgetScreen;
    private boolean wasHudHiddenRoot;

    @EventHandler(priority = EventPriority.LOWEST)
    private void onOpenScreen(OpenScreenEvent event) {
        if (event.screen instanceof WidgetScreen) {
            if (!wasWidgetScreen) {
                wasHudHiddenRoot = mc.options.hudHidden;
            }

            if (GuiThemes.get().hideHUD() || wasHudHiddenRoot) {
                mc.options.hudHidden =
                    !(event.screen instanceof HudEditorScreen);
            }
        } else {
            if (wasWidgetScreen) {
                mc.options.hudHidden = wasHudHiddenRoot;
            }

            wasHudHiddenRoot = mc.options.hudHidden;
        }

        wasWidgetScreen = event.screen instanceof WidgetScreen;
    }

    public static Identifier identifier(String path) {
        return Identifier.of(MorzhClient.MOD_ID, path);
    }
