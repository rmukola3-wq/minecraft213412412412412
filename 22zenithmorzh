    @EventHandler(priority = EventPriority.HIGH)
    private void onStartBreakingBlockEvent(StartBreakingBlockEvent event) {
        if (!shouldAttackBlock(event.blockPos)) event.cancel();
    }

    @EventHandler(priority = EventPriority.HIGHEST)
    private void onInteractBlock(InteractBlockEvent event) {
        if (redirecting) return;
        if (mc.player == null || mc.world == null || mc.interactionManager == null) return;

        BlockPos pos = event.result.getBlockPos();
        Block block = mc.world.getBlockState(pos).getBlock();

        if (profile.get() == Profile.Cladding) {
            if (!isGeoInteractable(block, pos)) return;

            event.cancel();
            forceUseAgainst(event.hand, event.result);
            return;
        }

        if (profile.get() == Profile.GEO) {
            if (isGeoInteractable(block, pos)) event.cancel();
            return;
        }

        if (!handMatches(blockInteractHand.get(), event.hand)) return;
        if (!blockListed(block)) return;
        event.cancel();
    }

    private void forceUseAgainst(Hand hand, BlockHitResult hit) {
        ItemStack stack = mc.player.getStackInHand(hand);
        if (stack.isEmpty()) {
            Hand other = hand == Hand.MAIN_HAND ? Hand.OFF_HAND : Hand.MAIN_HAND;
            stack = mc.player.getStackInHand(other);
            if (!stack.isEmpty()) hand = other;
            else return;
        }

        boolean isBlock = stack.getItem() instanceof BlockItem;

        if (isBlock && !cladPlace.get()) return;
        if (!isBlock && !cladUseItem.get()) return;

        redirecting = true;
        try {
            if (isBlock) {
                boolean wasSneaking = mc.player.isSneaking();
                if (!wasSneaking) {
                    mc.player.setSneaking(true);
                    mc.player.networkHandler.sendPacket(new ClientCommandC2SPacket(mc.player, ClientCommandC2SPacket.Mode.PRESS_SHIFT_KEY));
                }

                ActionResult result = mc.interactionManager.interactBlock(mc.player, hand, hit);
                if (result instanceof ActionResult.Success success && success.swingSource() == ActionResult.SwingSource.CLIENT) {
                    mc.player.swingHand(hand);
                }

                if (!wasSneaking) {
                    mc.player.setSneaking(false);
                    mc.player.networkHandler.sendPacket(new ClientCommandC2SPacket(mc.player, ClientCommandC2SPacket.Mode.RELEASE_SHIFT_KEY));
                }
            } else {
                ActionResult result = mc.interactionManager.interactItem(mc.player, hand);
                if (result instanceof ActionResult.Success success && success.swingSource() == ActionResult.SwingSource.CLIENT) {
                    mc.player.swingHand(hand);
                }
            }
        } catch (Throwable ignored) {
        } finally {
            redirecting = false;
        }
    }

    @EventHandler
    private void onRender(Render3DEvent event) {
        if (!isActive() || profile.get() != Profile.Cladding || !cladOutline.get()) return;
        if (!(mc.crosshairTarget instanceof BlockHitResult hit) || hit.getType() != HitResult.Type.BLOCK) return;

        BlockPos pos = hit.getBlockPos();
        Block block = mc.world.getBlockState(pos).getBlock();
        if (!isGeoInteractable(block, pos)) return;

        Box box = new Box(pos);
        var c = cladColor.get();
        event.renderer.box(box, c, c, ShapeMode.Both, 0);
    }

    @EventHandler(priority = EventPriority.HIGH)
    private void onAttackEntity(AttackEntityEvent event) {
        if (!shouldAttackEntity(event.entity)) event.cancel();
    }

    @EventHandler
    private void onInteractEntity(InteractEntityEvent event) {
        if (!shouldInteractEntity(event.entity, event.hand)) event.cancel();
    }

    private boolean handMatches(HandMode mode, Hand hand) {
        return switch (mode) {
            case Both -> true;
            case Mainhand -> hand == Hand.MAIN_HAND;
            case Offhand -> hand == Hand.OFF_HAND;
            case None -> false;
        };
    }

    private boolean blockListed(Block block) {
        if (blockInteractMode.get() == ListMode.BlackList) {
            return blockInteract.get().contains(block);
        }
        return !blockInteract.get().contains(block);
    }

    private boolean shouldAttackBlock(BlockPos blockPos) {
        if (profile.get() != Profile.Classic) return true;

        if (blockMineMode.get() == ListMode.WhiteList &&
            blockMine.get().contains(mc.world.getBlockState(blockPos).getBlock())) {
            return false;
        }

        return blockMineMode.get() != ListMode.BlackList ||
            !blockMine.get().contains(mc.world.getBlockState(blockPos).getBlock());
    }

    public boolean isGeoInteractable(Block block, BlockPos pos) {
        if (block instanceof CraftingTableBlock
            || block instanceof AnvilBlock
            || block instanceof EnchantingTableBlock
            || block instanceof AbstractFurnaceBlock
            || block instanceof BrewingStandBlock
            || block instanceof BeaconBlock
            || block instanceof CartographyTableBlock
            || block instanceof GrindstoneBlock
            || block instanceof LoomBlock
            || block instanceof StonecutterBlock
            || block instanceof SmithingTableBlock
            || block instanceof ChestBlock
            || block instanceof EnderChestBlock
            || block instanceof BarrelBlock
            || block instanceof ShulkerBoxBlock
            || block instanceof HopperBlock
            || block instanceof DispenserBlock
            || block instanceof DropperBlock
            || block instanceof LecternBlock
            || block instanceof BellBlock
            || block instanceof NoteBlock
            || block instanceof JukeboxBlock
            || block instanceof CakeBlock
            || block instanceof BedBlock
            || block instanceof DoorBlock
            || block instanceof TrapdoorBlock
            || block instanceof FenceGateBlock
            || block instanceof ButtonBlock
            || block instanceof LeverBlock
            || block instanceof AbstractPressurePlateBlock
            || block instanceof RepeaterBlock
            || block instanceof ComparatorBlock
            || block instanceof DaylightDetectorBlock
            || block instanceof RespawnAnchorBlock
            || block instanceof DragonEggBlock
            || block instanceof FlowerPotBlock
            || block instanceof DecoratedPotBlock
            || block instanceof ChiseledBookshelfBlock) {
            return true;
        }

        if (block.getDefaultState().isIn(BlockTags.BEDS)
            || block.getDefaultState().isIn(BlockTags.DOORS)
            || block.getDefaultState().isIn(BlockTags.TRAPDOORS)
            || block.getDefaultState().isIn(BlockTags.FENCE_GATES)
            || block.getDefaultState().isIn(BlockTags.BUTTONS)
            || block.getDefaultState().isIn(BlockTags.SHULKER_BOXES)) {
            return true;
        }

        if (pos != null && mc.world != null) {
            BlockEntity be = mc.world.getBlockEntity(pos);
            if (be instanceof LockableContainerBlockEntity) return true;
        }

        return false;
    }

    private boolean shouldAttackEntity(Entity entity) {
        if ((friends.get() == InteractMode.Both || friends.get() == InteractMode.Hit) &&
            entity instanceof PlayerEntity && !Friends.get().shouldAttack((PlayerEntity) entity)) {
            return false;
        }

        if ((babies.get() == InteractMode.Both || babies.get() == InteractMode.Hit) &&
            entity instanceof AnimalEntity && ((AnimalEntity) entity).isBaby()) {
            return false;
        }

        if ((nametagged.get() == InteractMode.Both || nametagged.get() == InteractMode.Hit) && entity.hasCustomName()) return false;

        if (entityHitMode.get() == ListMode.BlackList && entityHit.get().contains(entity.getType())) {
            return false;
        }

        return entityHitMode.get() != ListMode.WhiteList || entityHit.get().contains(entity.getType());
    }

    private boolean shouldInteractEntity(Entity entity, Hand hand) {
        if (!handMatches(entityInteractHand.get(), hand) && entityInteractHand.get() != HandMode.None) {

        }
        if (entityInteractHand.get() == HandMode.Both
            || (entityInteractHand.get() == HandMode.Mainhand && hand == Hand.MAIN_HAND)
            || (entityInteractHand.get() == HandMode.Offhand && hand == Hand.OFF_HAND)) {

            if (entityInteract.get().isEmpty() && entityInteractMode.get() == ListMode.BlackList) {
                return false;
            }
        }

        if ((friends.get() == InteractMode.Both || friends.get() == InteractMode.Interact) &&
            entity instanceof PlayerEntity && !Friends.get().shouldAttack((PlayerEntity) entity)) {
            return false;
        }

        if ((babies.get() == InteractMode.Both || babies.get() == InteractMode.Interact) &&
            entity instanceof AnimalEntity && ((AnimalEntity) entity).isBaby()) {
            return false;
        }

        if ((nametagged.get() == InteractMode.Both || nametagged.get() == InteractMode.Interact) && entity.hasCustomName()) return false;

        if (entityInteractMode.get() == ListMode.BlackList && entityInteract.get().contains(entity.getType())) {
            return false;
        }
        return entityInteractMode.get() != ListMode.WhiteList || entityInteract.get().contains(entity.getType());
    }

    public enum Profile {
        Cladding,
        GEO,
        Classic;

        @Override
        public String toString() {
            return switch (this) {
                case Cladding -> "Обшивка";
                case GEO -> "GEO";
                case Classic -> "Classic";
            };
        }
    }

    public enum HandMode {
        Mainhand,
        Offhand,
        Both,
        None
    }

    public enum ListMode {
        WhiteList,
        BlackList
    }

    public enum InteractMode {
        Hit,
        Interact,
        Both,
        None
    }
}

