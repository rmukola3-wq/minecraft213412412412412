        .defaultValue(new SettingColor(255, 230, 230, 255))
        .build()
    );

    private final Map<UUID, Boolean> alive = new ConcurrentHashMap<>();
    private final Color drawColor = new Color();
    private String overlayText;
    private long overlayUntil;
    private long overlayStart;

    public ScreenKillEffect() {
        super(
            Categories.Render,
            "screen-kill-effect",
            "Кровь на весь экран + звук ножа + текст килла.",
            "screenkill",
            "кровь экран"
        );
    }

    @Override
    public void onDeactivate() {
        alive.clear();
        overlayText = null;
    }

    @EventHandler
    private void onTick(TickEvent.Post event) {
        if (mc.world == null || mc.player == null) return;

        for (Entity entity : mc.world.getPlayers()) {
            if (!(entity instanceof PlayerEntity living) || entity == mc.player) continue;
            boolean nowAlive = living.isAlive() && living.getHealth() > 0;
            Boolean was = alive.put(entity.getUuid(), nowAlive);
            if (was != null && was && !nowAlive) maybeKill(living);
        }
    }

    @EventHandler
    private void onRemoved(EntityRemovedEvent event) {
        if (!(event.entity instanceof PlayerEntity living) || event.entity == mc.player) return;
        Boolean was = alive.remove(event.entity.getUuid());

        if (was != null && was && (living.isDead() || living.getHealth() <= 0)) maybeKill(living);
    }

    private void maybeKill(PlayerEntity victim) {
        long now = System.currentTimeMillis();

        overlayText = switch (textMode.get()) {
            case Minus -> "- " + victim.getName().getString();
            case Killed -> "вы убили " + victim.getName().getString();
            case YouKilled -> "you killed " + victim.getName().getString();
        };
        overlayStart = now;
        overlayUntil = now + (long) (duration.get() * 1000);

        if (sound.get()) MorzhSoundManager.playRandomScreenKillSound();
    }

    @EventHandler
    private void onRender2D(Render2DEvent event) {
        long now = System.currentTimeMillis();
        if (overlayText == null || now > overlayUntil) {
            if (now > overlayUntil) overlayText = null;
            return;
        }

        float life = (float) ((now - overlayStart) / (double) (overlayUntil - overlayStart));
        float fade = life < 0.12f ? life / 0.12f : life > 0.72f ? (1f - life) / 0.28f : 1f;
        fade = MathHelper.clamp(fade, 0f, 1f);

        int w = Utils.getWindowWidth();
        int h = Utils.getWindowHeight();

        if (blood.get()) drawBloodFullscreen(w, h, fade);
        drawKillText(w, h, fade, life);
    }

    private void drawBloodFullscreen(int w, int h, float fade) {
        if (Renderer2D.TEXTURE == null) return;

        SettingColor bc = bloodColor.get();
        drawColor.set(bc.r, bc.g, bc.b, MathHelper.clamp((int) (bc.a * fade), 0, 255));

        GL.bindTexture(BLOOD);
        Renderer2D.TEXTURE.begin();
        Renderer2D.TEXTURE.texQuad(0, 0, w, h, drawColor);
        Renderer2D.TEXTURE.render(null);
    }

    private void drawKillText(int w, int h, float fade, float life) {
        TextRenderer text = TextRenderer.get();
        double guiScale = mc.getWindow().getScaleFactor();
        double scale = guiScale * (2.4 + Math.sin(MathHelper.clamp(life, 0, 1) * Math.PI) * 0.35);
        float pop = life < 0.18f ? life / 0.18f : 1f;
        scale *= 0.86 + 0.14 * pop;

        SettingColor tc = textColor.get();
        drawColor.set(tc.r, tc.g, tc.b, MathHelper.clamp((int) (tc.a * fade), 0, 255));

        text.begin(scale);
        double tw = text.getWidth(overlayText, true);
        double th = text.getHeight(true);
        text.render(overlayText, w / 2.0 - tw / 2.0, h * 0.28 - th / 2.0, drawColor, true);
        text.end();
    }

    public enum TextMode {
        Minus,
        Killed,
        YouKilled;

        @Override
        public String toString() {
            return switch (this) {
                case Minus -> "- ник";
                case Killed -> "вы убили";
                case YouKilled -> "you killed";
            };
        }
    }
}

