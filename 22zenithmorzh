        float diffHearts = (myHp - hisHp) / 2f;

        String state;
        int stateColor;
        if (diffHearts > 0.05f) {
            state = "WIN";
            stateColor = colorWin.get().getPacked();
        } else if (diffHearts < -0.05f) {
            state = "LOSE";
            stateColor = colorLose.get().getPacked();
        } else {
            state = "TIE";
            stateColor = colorTie.get().getPacked();
