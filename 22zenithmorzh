            for(int i=0;i<worlds.size();i++){float cardY=listY+i*(CARD_H+CARD_GAP)-scrollOffset;if(isOver(mx,my,listX,cardY,listW,CARD_H)){MorzhSoundManager.playBoolean();if(selectedWorld==i&&doubled)playWorld(i);else selectedWorld=i;return true;}}
