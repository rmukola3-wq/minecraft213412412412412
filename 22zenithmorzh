    private void onMessage(ReceiveMessageEvent event) {
        String msg = Formatting.strip(event.getMessage().getString()).toLowerCase(Locale.ROOT);
        if (!isTpRequest(msg)) return;
        if (friendsOnly.get() && !mentionsFriend(msg)) return;
        pending = true;
        wait = delayTicks.get();
    }

    @EventHandler
    private void onTick(TickEvent.Pre event) {
        if (!pending || mc.player == null || mc.player.networkHandler == null) return;
        if (wait > 0) {
