            }
        }

        if (event.packet instanceof GameMessageS2CPacket messagePacket) {
            onBuyChat(messagePacket.content().getString());
        }
        if (event.packet instanceof OverlayMessageS2CPacket overlayPacket) {
            onBuyChat(overlayPacket.text().getString());
        }

        if (event.packet instanceof OpenScreenS2CPacket openScreenPacket) {
            if (!(mc.currentScreen instanceof GenericContainerScreen)) tickCounter = 0;
            refreshCooldown = Math.max(refreshCooldown, 4);
            refreshSync = -1;
            lastOpenSync = openScreenPacket.getSyncId();
