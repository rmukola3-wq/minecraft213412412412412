    private void updateAtmosphere() {
        long now = System.currentTimeMillis();
        if (lastMillis == 0) lastMillis = now;
        float dt = MathHelper.clamp((now - lastMillis) / 1000f, 0f, 0.1f);
        lastMillis = now;

        Color target = themeColor();
        float strength = intensity.get().floatValue();

        float phase = now / 1000f;
        float wave = 1f;
        if (customFog.get() && fogStyle.get().animated()) {
            float speed = fogAnimationSpeed.get().floatValue();
            wave = switch (fogStyle.get()) {
                case Pulse -> 0.85f + 0.15f * MathHelper.sin(phase * 1.6f * speed);
                case Wave -> 0.8f + 0.2f * MathHelper.sin(phase * 0.9f * speed);
                default -> 1f;
            };
        }
        if (glowEnabled.get() && glowStyle.get().animated()) {
            float speed = glowSpeed.get().floatValue();
            wave *= switch (glowStyle.get()) {
                case Aura, Underwater -> 0.9f + 0.1f * MathHelper.sin(phase * 1.1f * speed + 1.7f);
                case Sunset -> 0.85f + 0.15f * MathHelper.sin(phase * 0.7f * speed);
                case Void -> 0.8f + 0.2f * MathHelper.sin(phase * 0.5f * speed + 0.4f);
                default -> 1f;
            };
        }

        int r = MathHelper.clamp((int) (target.r * wave), 0, 255);
        int g = MathHelper.clamp((int) (target.g * wave), 0, 255);
        int b = MathHelper.clamp((int) (target.b * wave), 0, 255);

        boolean snap = snapPending;
        snapPending = false;
        float keep = snap ? 0f : MathHelper.clamp(1f - dt * 8f, 0f, 1f);
        smoothColor.set(
            MathHelper.clamp((int) (smoothColor.r * keep + r * (1 - keep)), 0, 255),
            MathHelper.clamp((int) (smoothColor.g * keep + g * (1 - keep)), 0, 255),
            MathHelper.clamp((int) (smoothColor.b * keep + b * (1 - keep)), 0, 255),
            255
        );
        smoothIntensity = MathHelper.clamp(smoothIntensity * keep + strength * (1 - keep), 0f, 1f);
    }

    private void applyTheme() {
        Theme t = theme.get();
        if (t == Theme.Custom || applyingTheme) return;
        applyingTheme = true;
        try {
            int[] rgb = t.rgb;
            customColor.set(new SettingColor(rgb[0], rgb[1], rgb[2], 255));
            themeFromVisuals.set(false); 
            skybox.set(t.skybox);
            fogStyle.set(t.fogStyle);
            glowStyle.set(t.glowStyle);
            customSkyColor.set(true);

            snapPending = true;
            updateAtmosphere();
            syncSkyState();
        } finally {
            applyingTheme = false;
        }

        if (theme.get() != Theme.Custom) theme.set(Theme.Custom);
    }

