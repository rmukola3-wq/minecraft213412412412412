        private static final int UNSET = -1;
        private static final int LEFT = 91;
        private static final int SLOT = 20;
        private static final int TEX = 1;

        private float value = Float.NaN;
        private float start;
        private float target;
        private long startMs;
        private long duration = 160;
        private int slot = UNSET;

        public void tick() {
            if (Float.isNaN(value) || startMs == 0) return;
            long elapsed = System.currentTimeMillis() - startMs;
            if (elapsed >= duration) {
                value = target;
                startMs = 0;
                return;
            }
            value = lerp(start, target, easeOut(elapsed / (double) duration));
        }

        public void update(int selected, int centerX, long ms) {
            duration = Math.max(1, ms);
            float next = centerX - LEFT - TEX + selected * SLOT;
            if (slot == UNSET || Float.isNaN(value)) {
                slot = selected;
                value = start = target = next;
                startMs = 0;
            } else if (selected == slot) {
                target = next;
                if (startMs == 0) value = next;
            } else {
                start = value;
                target = next;
                startMs = System.currentTimeMillis();
                slot = selected;
            }
        }

        public float x() {
            return Float.isNaN(value) ? 0 : value;
        }
    }

    public static final class PerspectiveAnim {
        private float value = 4;
        private float start = 4;
        private float target = 4;
        private long startMs;
        private long duration = 300;
        private boolean third;

        public void tick() {
            if (startMs == 0) return;
            long elapsed = System.currentTimeMillis() - startMs;
            if (elapsed >= duration) {
                value = target;
