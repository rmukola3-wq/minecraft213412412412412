    private void renderCard(DrawContext context, int mouseX, int mouseY) {
        rows.clear();
        HudElement el = focused;
        List<Setting<?>> settings = visibleSettings(el);
        int n = 1 + (el instanceof HudScalableElement ? 1 : 0) + settings.size();
        cardH = 28 + n * ROW_H + 10;
        cardW = CARD_W;
        cardX = el.x + el.getWidth() + 8f;
        cardY = el.y;
        float sw = (float) Utils.getWindowWidth();
        float sh = (float) Utils.getWindowHeight();
        if (cardX + cardW > sw - 8) cardX = el.x - cardW - 8f;
        if (cardX < 8) cardX = 8;
        if (cardY + cardH > sh - barH - 16) cardY = Math.max(8, sh - barH - 16 - cardH);

        MorzhSmoothRenderer.roundedRect(context, cardX, cardY, cardW, cardH, 5, HudChrome.FIRST);
        MorzhSmoothRenderer.roundedRect(context, cardX, cardY, cardW, 22, 5, HudChrome.SECOND);
        MorzhSmoothRenderer.text(context, chipName(el), cardX + 8, cardY + 7, 0xFFFFFFFF, true, 0.78);

        float y = cardY + 26;
        y = boolRow(context, mouseX, mouseY, y, "активен", el.isActive(), () -> {
            el.toggle();
            MorzhHudSounds.playElementToggle();
        });

        if (el instanceof HudScalableElement scalable) {
            y = sliderRow(context, y, "размер", scalable.getScaleValue(), 0.5, 5.0,
                v -> scalable.adjustScale(v - scalable.getScaleValue()));
        }

        for (Setting<?> setting : settings) {
            if (setting instanceof BoolSetting bool) {
                y = boolRow(context, mouseX, mouseY, y, setting.title, bool.get(), () -> {
                    bool.set(!bool.get());
                    MorzhHudSounds.playBoolean();
                });
            } else if (setting instanceof EnumSetting<?> en) {
                y = enumRow(context, mouseX, mouseY, y, setting.title, en);
            } else if (setting instanceof DoubleSetting d) {
                y = sliderRow(context, y, setting.title, d.get(), d.sliderMin, d.sliderMax, d::set);
            } else if (setting instanceof IntSetting in) {
                y = sliderRow(context, y, setting.title, in.get(), in.sliderMin, in.sliderMax,
                    v -> in.set((int) Math.round(v)));
            } else if (setting instanceof ColorSetting col) {
                y = colorRow(context, y, setting.title, col.get());
            }
        }
    }

    private float boolRow(DrawContext context, int mouseX, int mouseY, float y, String label, boolean on, Runnable click) {
        float x = cardX + 8;
        float w = cardW - 16;
        boolean hover = mouseX >= x && mouseX <= x + w && mouseY >= y && mouseY <= y + ROW_H;
        MorzhSmoothRenderer.text(context, label, x, y + 6, hover ? 0xFFFFFFFF : HudChrome.TEXT, false, 0.70);
        float tx = x + w - 28;
        int track = on ? 0xFF818497 : 0xFF1D1D1F;
        MorzhSmoothRenderer.roundedRect(context, tx, y + 5, 26, 12, 6, track);
        float knob = on ? tx + 14 : tx + 2;
        MorzhSmoothRenderer.roundedRect(context, knob, y + 6, 10, 10, 5, 0xFFE8E8EC);
        rows.add(new Row(x, y, w, ROW_H, click, null, 0, 0));
        return y + ROW_H;
    }

    @SuppressWarnings({"unchecked", "rawtypes"})
    private float enumRow(DrawContext context, int mouseX, int mouseY, float y, String label, EnumSetting en) {
        float x = cardX + 8;
        float w = cardW - 16;
        boolean hover = mouseX >= x && mouseX <= x + w && mouseY >= y && mouseY <= y + ROW_H;
        MorzhSmoothRenderer.text(context, label, x, y + 6, HudChrome.MUTED, false, 0.66);
        String value = en.get().toString();
        float vw = (float) MorzhSmoothRenderer.textWidth(value, 0.70);
        MorzhSmoothRenderer.roundedRect(context, x + w - vw - 10, y + 3, vw + 8, 16, 3, hover ? 0xFF3A3A44 : HudChrome.SECOND);
        MorzhSmoothRenderer.text(context, value, x + w - vw - 6, y + 6, 0xFFFFFFFF, false, 0.70);
        rows.add(new Row(x, y, w, ROW_H, () -> {
            Enum<?> current = (Enum<?>) en.get();
            Enum<?>[] vals = current.getDeclaringClass().getEnumConstants();
            int i = 0;
            for (int k = 0; k < vals.length; k++) if (vals[k] == current) i = k;
            en.set(vals[(i + 1) % vals.length]);
            MorzhHudSounds.playBoolean();
        }, null, 0, 0));
        return y + ROW_H;
    }

    private float sliderRow(DrawContext context, float y, String label, double value, double min, double max, DoubleConsumer set) {
        float x = cardX + 8;
        float w = cardW - 16;
        MorzhSmoothRenderer.text(context, label, x, y + 2, HudChrome.MUTED, false, 0.62);
        String txt = Math.abs(max - min) > 5 ? String.format(java.util.Locale.US, "%.1f", value)
