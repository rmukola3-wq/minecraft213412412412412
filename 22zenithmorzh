        LivingEntity auraTarget = aura != null && aura.isActive() ? aura.target() : null;
        if (auraTarget instanceof PlayerEntity player && (!player.isAlive() || player.isRemoved()
            || !Friends.get().shouldAttack(player))) auraTarget = null;
        LivingEntity best = null;
        double bestScore = Double.MAX_VALUE;

        for (PlayerEntity player : mc.world.getPlayers()) {
            if (player == mc.player || !player.isAlive() || player.isRemoved() || !player.isGliding()) continue;
            if (!Friends.get().shouldAttack(player) || !mc.player.canSee(player)) continue;

            double score = mc.player.distanceTo(player) - (player == auraTarget ? 100.0 : 0.0);
            if (score < bestScore) {
                bestScore = score;
                best = player;
            }
        }

        return best != null ? best : auraTarget;
    }

    public LivingEntity getTarget() {
        return resolveTarget();
    }

    public Box getBox() {
        return box;
    }

    public Box getPredictedBox(LivingEntity entity) {
        if (!isActive() || entity == null || notScipBox.get()) return null;
        if (box != null && resolveTarget() == entity) return box;
        return predictBox(entity, predictTicks.get());
    }

    public boolean shouldSkipBox() {
        return notScipBox.get();
    }

    public Vec3d aimPoint() {
