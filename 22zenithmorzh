        cameraYaw += (float) (deltaX * factor);
        cameraPitch += (float) (deltaY * factor);
        cameraPitch = clampPitch(cameraPitch);
    }

    public float clampPitch(float pitch) {
        if (noPitchLimit.get()) return pitch;
        return MathHelper.clamp(pitch, -90f, 90f);
