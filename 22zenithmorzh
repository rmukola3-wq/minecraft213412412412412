        .defaultValue(13.0)
        .min(5.0)
        .max(60.0)
        .sliderRange(5.0, 60.0)
        .visible(() -> mode.get() == Mode.GrimStatic || mode.get() == Mode.GrimPulse)
        .build()
    );

