    @EventHandler
    private void onTick(TickEvent.Pre event) {
        if (!isActive() || mc.player == null || mc.world == null) return;

        switch (mode.get()) {
            case Vanilla -> MoveUtil.setVelocity(vanillaSpeed.get() / 3.0);
            case GrimSpeed -> handleGrimSpeedUpdate();
