    private int getPadding() {
        if (panelStyle.get() != PanelStyle.None) return panelPadding.get();
        return border.get();
    }

    private double renderMorzhSection(DrawContext context, Section s, double textX, double textY) {
        Color c = getSectionColor(s.index);
        int packed = DropDownColors.rgba(c.r, c.g, c.b, c.a);
