        .name("pulse-boost")
        .description("Сколько тиков подряд разгоняться.")
        .defaultValue(2)
        .min(1)
        .max(6)
        .sliderRange(1, 6)
        .visible(() -> mode.get() == Mode.GrimPulse)
        .build()
    );

