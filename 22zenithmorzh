package dev.morzh.client.utils.world;

import dev.morzh.client.mixin.ChunkAccessor;
import net.minecraft.block.entity.BlockEntity;
import net.minecraft.util.math.BlockPos;
import net.minecraft.util.math.ChunkSectionPos;
import net.minecraft.world.chunk.Chunk;

import java.util.Iterator;
import java.util.Map;

import static dev.morzh.client.MorzhClient.mc;

public class BlockEntityIterator implements Iterator<BlockEntity> {
    private final Iterator<Chunk> chunks;
    private Iterator<BlockEntity> blockEntities;
    private final int playerChunkX;
    private final int playerChunkZ;
    private final int viewDist;

    public BlockEntityIterator() {
        chunks = new ChunkIterator(false);
        if (mc.player != null) {
            playerChunkX = ChunkSectionPos.getSectionCoord(mc.player.getBlockPos().getX());
            playerChunkZ = ChunkSectionPos.getSectionCoord(mc.player.getBlockPos().getZ());
            viewDist = mc.options.getViewDistance().getValue() + 1;
        } else {
            playerChunkX = 0;
            playerChunkZ = 0;
            viewDist = Integer.MAX_VALUE;
        }

        nextChunk();
    }

    private boolean isChunkInRange(Chunk chunk) {
        int cx = chunk.getPos().x;
        int cz = chunk.getPos().z;
        return Math.abs(cx - playerChunkX) <= viewDist && Math.abs(cz - playerChunkZ) <= viewDist;
    }

    private void nextChunk() {
        while (true) {
            if (!chunks.hasNext()) break;

            Chunk chunk = chunks.next();
            if (!isChunkInRange(chunk)) continue;

            Map<BlockPos, BlockEntity> blockEntityMap = ((ChunkAccessor) chunk).getBlockEntities();

            if (!blockEntityMap.isEmpty()) {
                blockEntities = blockEntityMap.values().iterator();
                break;
            }
        }
    }

    @Override
    public boolean hasNext() {
        if (blockEntities == null) return false;
        if (blockEntities.hasNext()) return true;

        nextChunk();

        return blockEntities.hasNext();
    }

    @Override
    public BlockEntity next() {
        return blockEntities.next();
    }
}

