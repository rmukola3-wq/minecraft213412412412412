        } else {
            mc.interactionManager.clickSlot(mc.player.currentScreenHandler.syncId, slot, 0, net.minecraft.screen.slot.SlotActionType.SWAP, mc.player);
            mc.interactionManager.clickSlot(mc.player.currentScreenHandler.syncId, 6, 0, net.minecraft.screen.slot.SlotActionType.SWAP, mc.player);
            mc.interactionManager.clickSlot(mc.player.currentScreenHandler.syncId, slot, 0, net.minecraft.screen.slot.SlotActionType.SWAP, mc.player);
        }
        mc.getNetworkHandler().sendPacket(new CloseHandledScreenC2SPacket(0));
