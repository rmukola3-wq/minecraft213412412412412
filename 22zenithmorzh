    private static Vec3d pointOnBox(Box box, Vec3d norm) {
        double mx = Math.min(0.04, box.getLengthX() * 0.10);
        double my = Math.min(0.06, box.getLengthY() * 0.06);
        double mz = Math.min(0.04, box.getLengthZ() * 0.10);
        return new Vec3d(
            MathHelper.lerp(norm.x, box.minX + mx, box.maxX - mx),
            MathHelper.lerp(norm.y, box.minY + my, box.maxY - my),
            MathHelper.lerp(norm.z, box.minZ + mz, box.maxZ - mz)
        );
