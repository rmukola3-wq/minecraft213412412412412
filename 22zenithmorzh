        int rows = preview ? 1 : staff.size();

        setSize(
            width,
            headerHeight +
                rows * rowHeight +
                4
        );

        renderer.post(() -> {
            DrawContext context =
                HudRenderer.INSTANCE.drawContext;

            if (context == null) {
                return;
            }

            HudChrome.card(
                context,
                x,
                y,
                getWidth(),
                getHeight(),
                7
            );

            HudChrome.header(
                context,
                HudIcons.Kind.KEYS,
                "Staff Board",
                x,
                y,
                getWidth(),
                1,
                fs
            );

            float rowY =
                y + headerHeight;

            if (preview) {
                drawRow(
                    context,
                    "ExamplePlayer",
                    "MODER",
                    "staff",
                    Status.ACTIVE,
                    rowY,
                    fs
                );

                return;
            }

            for (StaffEntry entry : staff) {
                drawRow(
                    context,
                    entry.name,
                    entry.label,
                    entry.kind,
                    entry.status,
                    rowY,
                    fs
                );

                rowY += rowHeight;
            }
        });
    }

    private void drawRow(
        DrawContext context,
        String name,
        String rank,
        String kind,
        Status status,
        float rowY,
        double fs
    ) {

        MorzhSmoothRenderer.text(
            context,
            name,
            x + 8,
            rowY + 3,
            0xFFFFFFFF,
            true,
            fs
        );

        int rankColor =
            getColorByKind(kind, status);

        float rankWidth =
            (float) MorzhSmoothRenderer.textWidth(
                rank,
                fs
            ) + 8;

        float pillX =
            x +
                getWidth() -
                6 -
                rankWidth;

        MorzhSmoothRenderer.roundedRect(
            context,
            pillX,
            rowY + 1,
            rankWidth,
            12,
            4,
            HudChrome.RV_PILL_ALT
        );

        MorzhSmoothRenderer.text(
            context,
            rank,
            pillX + 4,
            rowY + 2,
            rankColor,
            true,
            fs
        );
    }

    private static int getColorByKind(String kind, Status status) {
        if (kind == null) {
            return 0xFFFFFFFF;
        }

        if (status == Status.VANISH) return 0xFF777777;
        if (status == Status.GM3) return 0xFF55AAFF;

        return switch (kind.toLowerCase()) {
            case "staff" -> 0xFF55FFFF;
            case "media" -> 0xFFFF55FF;
            case "donate" -> 0xFFFFAA00;
            default -> 0xFFFFFFFF;
        };
    }

    private static boolean containsIgnoreCase(
        Set<String> set,
        String value
    ) {
        if (set == null || value == null) {
            return false;
        }

        for (String s : set) {
            if (
                s != null &&
                    s.equalsIgnoreCase(value)
            ) {
                return true;
            }
        }

        return false;
    }

    private static class StaffEntry {

