import net.minecraft.entity.player.PlayerEntity;
import net.minecraft.item.ItemStack;
import net.minecraft.network.packet.s2c.play.PlayerListS2CPacket;
import net.minecraft.network.packet.s2c.play.PlayerRemoveS2CPacket;

import java.nio.charset.StandardCharsets;
import java.util.HashSet;
import java.util.Set;
import java.util.UUID;

public class AntiBot extends Module {
    private final SettingGroup sg = settings.getDefaultGroup();

    private final Setting<Mode> mode = sg.add(new EnumSetting.Builder<Mode>()
        .name("mode")
        .defaultValue(Mode.Matrix)
        .build()
    );

    private final Setting<Boolean> duplicateTab = sg.add(new BoolSetting.Builder()
        .name("duplicate-tab")
        .description("Flags a second tab entry with the same name.")
        .defaultValue(true)
        .build()
    );

    private final Setting<Boolean> invisibleUuid = sg.add(new BoolSetting.Builder()
        .name("invisible-uuid")
        .description("Invisible players whose UUID is not offline-mode.")
        .defaultValue(true)
        .build()
    );

    private final Set<UUID> bots = new HashSet<>();
    private final Set<UUID> suspects = new HashSet<>();

    public AntiBot() {
        super(Categories.Combat, "anti-bot", "Ignores server NPC / matrix bots.");
    }

    @Override
    public void onActivate() {
        bots.clear();
        suspects.clear();
    }

    @Override
    public void onDeactivate() {
        bots.clear();
        suspects.clear();
    }

    public boolean isBot(PlayerEntity player) {
        if (!isActive() || player == null || player == mc.player) return false;
        if (player instanceof FakePlayerEntity) return false;
        if (bots.contains(player.getUuid())) return true;

        String name = player.getName().getString();
        if (name.startsWith("CIT-") && !name.contains("NPC")) return true;

        if (invisibleUuid.get() && player.isInvisible() && !isOfflineUuid(player) && !name.contains("NPC")) {
            return true;
        }

        return switch (mode.get()) {
            case UUID, ReallyWorld -> !isOfflineUuid(player) && !name.contains("NPC") && !name.startsWith("[ZNPC]");
            default -> false;
        };
    }

    @EventHandler
    private void onPacket(PacketEvent.Receive event) {
        if (event.packet instanceof PlayerListS2CPacket list) {
            for (PlayerListS2CPacket.Entry entry : list.getPlayerAdditionEntries()) {
                if (entry.profile() == null) continue;
                UUID id = entry.profile().getId();
                if (duplicateTab.get() && isDuplicateName(entry.profile().getName(), id)) {
                    bots.add(id);
                } else if (entry.latency() < 2 && (entry.profile().getProperties() == null || entry.profile().getProperties().isEmpty())) {
                    suspects.add(id);
                }
            }
        } else if (event.packet instanceof PlayerRemoveS2CPacket remove) {
            for (UUID id : remove.profileIds()) {
                bots.remove(id);
                suspects.remove(id);
            }
        }
    }

    @EventHandler
    private void onTick(TickEvent.Post event) {
        if (mc.world == null) return;

        if (mode.get() == Mode.Matrix) {
            suspects.removeIf(id -> {
                PlayerEntity p = mc.world.getPlayerByUuid(id);
                if (p == null) return true;
                int armor = 0;
                for (ItemStack stack : p.getArmorItems()) {
                    if (!stack.isEmpty()) armor++;
                }
                boolean nameBot = p.getName().getString().startsWith("CIT-");
                if (armor == 4 || nameBot || !isOfflineUuid(p)) bots.add(id);
                return true;
            });
        }

        if (mode.get() == Mode.ReallyWorld || mode.get() == Mode.UUID) {
            for (PlayerEntity p : mc.world.getPlayers()) {
                if (p != mc.player && isBot(p)) bots.add(p.getUuid());
            }
        }

        if (mc.player.age % 80 == 0) {
            bots.removeIf(id -> mc.world.getPlayerByUuid(id) == null);
        }
    }

    private boolean isDuplicateName(String name, UUID id) {
        if (mc.getNetworkHandler() == null) return false;
        int same = 0;
        for (PlayerListEntry entry : mc.getNetworkHandler().getPlayerList()) {
            if (entry.getProfile().getName().equals(name) && !entry.getProfile().getId().equals(id)) same++;
        }
        return same > 0;
    }

    private static boolean isOfflineUuid(PlayerEntity player) {
        UUID expected = UUID.nameUUIDFromBytes(("OfflinePlayer:" + player.getName().getString()).getBytes(StandardCharsets.UTF_8));
        return player.getUuid().equals(expected);
    }

    @Override
    public String getInfoString() {
        return String.valueOf(bots.size());
    }

    public enum Mode {
        Matrix,
        ReallyWorld,
        UUID
    }
}

