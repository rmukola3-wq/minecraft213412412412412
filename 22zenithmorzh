import java.util.Collections;
import java.util.List;
import java.util.function.BooleanSupplier;

public class ActionScheduler {
    public int currentStepIndex;
    public int currentTickStepIndex;
    public int currentTick;
    public boolean interrupt;
    public final Stopwatch time = new Stopwatch(false);
    public final List<DelayStep> scriptSteps = Lists.newCopyOnWriteArrayList();
    public final List<TickStep> scriptTickSteps = Lists.newCopyOnWriteArrayList();
    public LoopStrategy loopStrategy = new CountLoopStrategy(1);

    public ActionScheduler() {
        cleanup();
    }

    public ActionScheduler addTickStep(int ticks, PerformAction action) {
        return addTickStep(ticks, action, () -> true, 0);
    }

    public ActionScheduler addTickStep(int ticks, PerformAction action, BooleanSupplier condition, int id) {
        scriptTickSteps.add(new TickStep(ticks, action, condition, id));
        Collections.sort(scriptTickSteps);
        return this;
    }

    public ActionScheduler cleanupIfFinished() {
        if (isFinished()) cleanup();
        return this;
    }

    public ActionScheduler cleanup() {
        scriptSteps.clear();
        scriptTickSteps.clear();
        time.reset();
        currentStepIndex = 0;
        currentTickStepIndex = 0;
        currentTick = 0;
        return this;
    }

    public ActionScheduler update() {
        if ((scriptSteps.isEmpty() && scriptTickSteps.isEmpty()) || interrupt) return this;
        if (currentTickStepIndex < scriptTickSteps.size()) {
            TickStep step = scriptTickSteps.get(currentTickStepIndex);
            if (!step.condition().getAsBoolean()) {
                currentTick++;
                return this;
            }
            if (step.ticks() <= currentTick) {
                step.action().perform();
                currentTickStepIndex++;
                if (loopStrategy.shouldLoop(currentTickStepIndex, scriptTickSteps.size())) {
                    currentStepIndex = 0;
                    currentTickStepIndex = 0;
                    currentTick = 0;
                    loopStrategy.onLoop();
                }
            }
        }
        currentTick++;
        currentStepIndex = Math.min(currentStepIndex, scriptSteps.size());
        currentTickStepIndex = Math.min(currentTickStepIndex, scriptTickSteps.size());
        return this;
    }

    public boolean isFinished() {
        return currentStepIndex >= scriptSteps.size() && currentTickStepIndex >= scriptTickSteps.size() && !interrupt && loopStrategy.isFinished();
    }
}

