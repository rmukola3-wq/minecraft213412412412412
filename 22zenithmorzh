    private boolean checkMace() {
        if (profile.get() == Profile.Legit || !onMace.get()) return false;
        for (Entity entity : mc.world.getEntities()) {
            if (!(entity instanceof net.minecraft.entity.player.PlayerEntity player) || player == mc.player) continue;
            if (!(player.getMainHandStack().getItem() instanceof net.minecraft.item.MaceItem)) continue;
            if (player.getY() > mc.player.getY() + 1.0 && mc.player.distanceTo(player) <= 8) return true;
