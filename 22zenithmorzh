package dev.morzh.client.gui.morzh.dropdown;

import dev.morzh.client.gui.morzh.MorzhScissor;
import dev.morzh.client.settings.Setting;
import dev.morzh.client.settings.SettingGroup;
import dev.morzh.client.systems.modules.Module;
import dev.morzh.client.utils.misc.Keybind;
import net.minecraft.client.gui.DrawContext;
import net.minecraft.util.math.MathHelper;
import org.lwjgl.glfw.GLFW;

import java.util.ArrayList;
import java.util.List;

public class DropDownModuleComponent extends DropDownComponent {
    private static final float ROW_HEIGHT = 16f;
    private static final float CORNER = 4f;

    private final Module module;
    public final DropDownAnim animation = new DropDownAnim();
    private final DropDownAnim enableAnim = new DropDownAnim();
    private final List<DropDownComponent> components = new ArrayList<>();

    private boolean open;
    private boolean bind;
    private boolean lastActive;
    private float settingsHeight;
    private float settingsScroll;
    private float animatedSettingsScroll;
    private boolean matchesSearch = true;

    private static final float SETTINGS_SCROLL_STEP = 12f;

    public void applySearch(String query) {
        matchesSearch = module.matchesSearch(query);
    }

    public boolean matchesSearch() {
        return matchesSearch;
    }

    public DropDownModuleComponent(Module module) {
        this.module = module;

        for (SettingGroup group : module.settings) {
            for (Setting<?> setting : group) {
                DropDownComponent component = DropDownSettingFactory.create(setting);
                if (component != null) components.add(component);
            }
        }

        animation.animate(0, 0.3f);
        lastActive = module.isActive();
        enableAnim.snap(lastActive ? 1 : 0);
    }

    public List<DropDownComponent> getComponents() {
        return components;
    }

    public float getSettingsHeight() {
        return settingsHeight;
    }

    public void measure(float width) {
        setWidth(width);
        float total = 0;
        for (DropDownComponent component : components) {
            if (!component.isVisible()) continue;
            component.measure(width);
            total += component.getHeight();
        }
        settingsHeight = total;
    }

    public void layoutChildren() {
        float childY = getY() + ROW_HEIGHT - animatedSettingsScroll;
        for (DropDownComponent component : components) {
            if (!component.isVisible()) continue;
            component.setX(getX());
            component.setY(childY);
            component.setWidth(getWidth());
            childY += component.getHeight();
        }
    }

    public float getMaxVisibleSettingsHeight(float viewportHeight) {
        return Math.min(200f, Math.max(72f, viewportHeight * 0.55f));
    }

    public float getVisibleSettingsHeight(float maxVisible, float expandT) {
        return Math.min(settingsHeight * expandT, maxVisible * expandT);
    }

    public void clampSettingsScroll(float maxVisible) {
        if (!open) {
            settingsScroll = 0;
            animatedSettingsScroll = 0;
            return;
        }
        settingsScroll = MathHelper.clamp(settingsScroll, 0, getSettingsScrollRange(maxVisible));
    }

    public void updateAnimatedSettingsScroll() {
        animatedSettingsScroll = DropDownDraw.fast(animatedSettingsScroll, settingsScroll, 12);
    }

    public float getSettingsScrollRange(float maxVisible) {
        return Math.max(0, settingsHeight - maxVisible);
    }

    public boolean isOpenEnough() {
        return open && animation.getValueF() > 0.05f;
    }

    public boolean isOverSettings(float mouseX, float mouseY) {
        return isHovered(mouseX, mouseY) && mouseY >= getY() + ROW_HEIGHT;
    }

    public boolean mouseScrolled(float mouseX, float mouseY, double verticalAmount, float maxVisible) {
        if (!isOpenEnough() || !isOverSettings(mouseX, mouseY)) return false;

        float range = getSettingsScrollRange(maxVisible);
        if (range <= 0) return false;

        float before = settingsScroll;
        settingsScroll = MathHelper.clamp(
            settingsScroll + (float) (verticalAmount * SETTINGS_SCROLL_STEP),
            0,
            range
        );

        if (settingsScroll != before) return true;

        if (verticalAmount > 0 && before <= 0) return false;
        if (verticalAmount < 0 && before >= range) return false;
        return true;
    }

    public boolean isBinding() {
        if (bind) return true;
        for (DropDownComponent component : components) {
            if (component instanceof DropDownBindTracker tracker && tracker.isBinding()) return true;
        }
        return false;
    }

    @Override
    public void render(DrawContext context, float mouseX, float mouseY) {
        if (module.isActive() != lastActive) {
            lastActive = module.isActive();
            enableAnim.animate(lastActive ? 1 : 0, 0.2f, DropDownAnim.Ease.CIRC_OUT);
        }
        enableAnim.update();

        int color = DropDownColors.interpolate(DropDownColors.ON, DropDownColors.WHITE, enableAnim.getValueF());

        drawOutlinedRect(context, mouseX, mouseY);
        drawText(context, color);
        drawComponents(context, mouseX, mouseY);
    }

    private void drawComponents(DrawContext context, float mouseX, float mouseY) {
        if (animation.getValue() <= 0) return;

        long visible = components.stream().filter(DropDownComponent::isVisible).count();
        if (animation.getValue() > 0.1 && visible >= 1) {
            DropDownDraw.rectV(context, getX() + 5, getY() + ROW_HEIGHT, getWidth() - 10, 0.5f,
                DropDownColors.SETTING_SEP_LEFT, DropDownColors.SETTING_SEP_RIGHT);
        }

        float visibleH = Math.max(0, getHeight() - ROW_HEIGHT);
        MorzhScissor.push(getX() + 0.5f, getY() + ROW_HEIGHT, getWidth() - 1, visibleH);
        for (DropDownComponent component : components) {
            if (component.isVisible()) component.render(context, mouseX, mouseY);
        }
        MorzhScissor.pop();
    }

    @Override
    public void mouseClick(float mouseX, float mouseY, int button) {
        if (isHovered(mouseX, mouseY, ROW_HEIGHT)) {
            if (button == 0) {
                module.toggle();
            }
            if (button == 1) {
                open = !open;
                animation.animate(open ? 1 : 0, 0.2f, DropDownAnim.Ease.CIRC_OUT);
                dev.morzh.client.utils.sound.MorzhSoundManager.playBoolean();
                if (!open) {
                    settingsScroll = 0;
                    animatedSettingsScroll = 0;
                }
            }
            if (button == 2) bind = !bind;
        }

        if (isHovered(mouseX, mouseY) && open) {
            for (DropDownComponent component : components) {
                if (component.isVisible()) component.mouseClick(mouseX, mouseY, button);
            }
        }
    }

    @Override
    public void mouseRelease(float mouseX, float mouseY, int button) {
        for (DropDownComponent component : components) {
            component.mouseRelease(mouseX, mouseY, button);
        }
    }

    @Override
    public void charTyped(char codePoint, int modifiers) {
        for (DropDownComponent component : components) {
            if (component.isVisible()) component.charTyped(codePoint, modifiers);
        }
    }

    @Override
    public void keyPressed(int key, int scanCode, int modifiers) {
        for (DropDownComponent component : components) {
            if (component.isVisible()) component.keyPressed(key, scanCode, modifiers);
        }

        if (bind) {
            if (key == GLFW.GLFW_KEY_DELETE || key == GLFW.GLFW_KEY_ESCAPE) {
                module.keybind.reset();
            } else if (module.keybind.canBindTo(true, key, modifiers)) {
                module.keybind.set(Keybind.fromKeys(key, modifiers));
            }
            bind = false;
        }
    }

    private void drawOutlinedRect(DrawContext context, float mouseX, float mouseY) {
        float on = enableAnim.getValueF();
        boolean hover = DropDownDraw.hovered(mouseX, mouseY, getX(), getY(), getWidth(), ROW_HEIGHT)
            && MorzhScissor.contains(mouseX, mouseY);

        int fill = DropDownColors.withAlpha(DropDownColors.PRIMARY, Math.round(10 * on));
        if (hover) fill = DropDownColors.interpolate(fill, DropDownColors.rgba(255, 255, 255, 6), 1f);
        DropDownDraw.rounded(context, getX(), getY(), getWidth(), getHeight(), CORNER, fill);
        if (on > 0.02f) {
            DropDownDraw.outlined(context, getX(), getY(), getWidth(), getHeight(), CORNER,
                fill, DropDownColors.withAlpha(DropDownColors.GLASS_OUTLINE, Math.round(5 * on)),
                DropDownColors.withAlpha(DropDownColors.GLASS_OUTLINE, Math.round(5 * on)));
        }

        if (hover) DropDownDraw.cursorHand();
    }

    private void drawText(DrawContext context, int color) {
        DropDownDraw.text(context, module.title, getX() + 4, getY() + 4.25f, color, 7.25f);

        long visible = components.stream().filter(DropDownComponent::isVisible).count();
        boolean showChevron = visible >= 1;

        if (bind) {
            String bindText = module.keybind.isSet() ? module.keybind.toString() : "...";
            float bw = DropDownDraw.textWidth(bindText, 6);
            DropDownDraw.text(context, bindText, getX() + getWidth() - 6 - bw, getY() + 6, DropDownColors.TEXT, 6);
        } else if (showChevron) {
            DropDownDraw.chevron(
                context,
                getX() + getWidth() - 10,
                getY() + 8f,
                4.5f,
                open,
                DropDownColors.TEXT_MUTED
            );
        }
    }
}

