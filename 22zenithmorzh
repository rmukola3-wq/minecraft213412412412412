        double xz = horizontal.get() / 2.0;
        double y = vertical.get() / 2.0;
        if (xz <= 0 && y <= 0) return original;

        return new Box(
            original.minX - xz,
            original.minY - y,
            original.minZ - xz,
            original.maxX + xz,
            original.maxY + y,
            original.maxZ + xz
        );
    }

    public Box expandVerticalExtra(Entity entity, Box original) {
        if (!shouldExpand(entity)) return original;

        double y = vertical.get() / 2.0;
        double margin = horizontal.get() / 2.0;
        double extra = y - margin;
