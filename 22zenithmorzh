            if (mc.player.squaredDistanceTo(x, y, z) > 4096) age -= 8;
            else age--;
            if (age < 0) return true;

            prevX = x;
            prevY = y;
            prevZ = z;
            x += mx;
            y += my;
            z += mz;
            mx *= 0.9f;
            if (physics.get() == Physics.Fly) my *= 0.9f;
            mz *= 0.9f;
            my -= 0.001f;
            return false;
        }

        void render(float tickDelta) {
            double ix = MathHelper.lerp(tickDelta, prevX, x);
            double iy = MathHelper.lerp(tickDelta, prevY, y);
            double iz = MathHelper.lerp(tickDelta, prevZ, z);
            Color base = color.get();
            int a = MathHelper.clamp((int) (base.a * (age / (float) maxAge)), 0, 255);
            if (a < 8) return;
