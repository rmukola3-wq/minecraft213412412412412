    private void updateThudParticles(float dt) {
        if (style.get() != Style.Thunder) return;
        if (currentTarget == null || mc.player == null || isInEditor()) {
            thudParticles.clear();
            return;
        }

        if (currentTarget.hurtTime >= 9 && !thudBurstDone) {
            thudBurstDone = true;
            int rgb = accentColor.get().getPacked() & 0x00FFFFFF;
            for (int i = 0; i < 7; i++) {
                ThudParticle p = new ThudParticle();
                p.x = x + (float) (Math.random() * 24 - 6);
                p.y = y + (float) (Math.random() * 22);
                p.vx = (float) (Math.random() * 7 - 3.5);
                p.vy = (float) (Math.random() * 7 - 3.5);
                p.size = 1.2f + (float) Math.random() * 2.2f;
                p.age = 0f;
                p.maxAge = 10f + (float) Math.random() * 12f;
                p.color = rgb;
                thudParticles.add(p);
            }
        }
        if (currentTarget.hurtTime <= 8) thudBurstDone = false;

        for (int i = thudParticles.size() - 1; i >= 0; i--) {
            ThudParticle p = thudParticles.get(i);
            p.age += dt;
            if (p.age >= p.maxAge) {
                thudParticles.remove(i);
                continue;
            }
            p.x += p.vx * 60f * dt;
            p.y += p.vy * 60f * dt;
        }
        if (thudParticles.size() > 60) thudParticles.clear();
    }

    private String thunderPotionsText(LivingEntity entity) {
        StringBuilder sb = new StringBuilder();
        for (StatusEffectInstance inst : entity.getStatusEffects()) {
            if (inst == null) continue;
            StatusEffect type = inst.getEffectType().value();
            if (type != StatusEffects.STRENGTH.value() && type != StatusEffects.SPEED.value()
                && type != StatusEffects.REGENERATION.value() && type != StatusEffects.WEAKNESS.value()) continue;
            if (sb.length() > 0) sb.append(' ');
            String n = type == StatusEffects.STRENGTH.value() ? "Str"
                : type == StatusEffects.SPEED.value() ? "Spd"
                : type == StatusEffects.REGENERATION.value() ? "Reg" : "W";
            sb.append(n);
            if (inst.getAmplifier() >= 1) sb.append(inst.getAmplifier() + 1);
            int secs = Math.max(0, inst.getDuration() / 20);
            sb.append(' ').append(secs / 60).append(':')
                .append(String.format(java.util.Locale.ROOT, "%02d", secs % 60));
        }
        return sb.toString();
    }

    private void renderFaceTexture(DrawContext context, float absX, float absY, float fw, float fh, float faceRadius) {
        LivingEntity entity = currentTarget;
        if (entity == null) return;

        int drawX = Math.round(absX);
        int drawY = Math.round(absY);
        int drawSize = Math.max(1, Math.round(Math.min(fw, fh)));

        if (drawSize >= 2) {
            drawRoundHead(context, absX, absY, drawSize, -1);
            return;
        }

        context.getMatrices().push();
        context.getMatrices().translate(0, 0, 401);

        if (entity instanceof AbstractClientPlayerEntity player) {
            PlayerSkinDrawer.draw(context, player.getSkinTextures(), drawX, drawY, drawSize);
        }
        else {
            Identifier texture = getFaceTexture(entity);
            if (texture != null) {
                float hurt = entity.hurtTime > 0 ? entity.hurtTime / 10f : 0f;
                int tint = 0xFF000000 | ((int) (255 * (1f - hurt)) << 16) | ((int) (255 * (1f - hurt)) << 8) | 255;

                context.drawTexture(RenderLayer::getGuiTextured, texture, drawX, drawY, drawSize, drawSize,
                    8, 8, 8, 8, 64, 64, tint);

                float hatSize = drawSize * 1.1f;
                float hatOff = (hatSize - drawSize) / 2f;
                context.drawTexture(RenderLayer::getGuiTextured, texture,
                    Math.round(absX - hatOff), Math.round(absY - hatOff), Math.round(hatSize), Math.round(hatSize),
                    40, 8, 8, 8, 64, 64, tint);
            }
        }

        context.getMatrices().pop();

        if (hitFlash.get() && hitFlashAmount > 0) {
            Color flash = hitFlashColor.get().copy();
            flash.a(Math.round(flash.a * hitFlashAmount));
            MorzhSmoothRenderer.roundedRect(context, absX, absY, fw, fh, faceRadius, flash.getPacked());
        }
    }

    private void drawRoundHead(DrawContext context, float absX, float absY, int drawSize, int roundPercentOverride) {
        LivingEntity entity = currentTarget;
        if (entity == null) return;

        float percent = roundPercentOverride >= 0
            ? MathHelper.clamp(roundPercentOverride, 0, 100)
            : MathHelper.clamp(faceRoundness.get().floatValue(), 0f, 100f);
        float r = drawSize * (percent / 100f) * 0.5f; 
        float red = hitFlash.get() ? hitFlashAmount : 0f;

        if (red > 0.004f) {
            Color flash = hitFlashColor.get().copy();
            int a = MathHelper.clamp(Math.round(flash.a * red), 0, 255);
            int glowStrong = (flash.getPacked() & 0x00FFFFFF) | (Math.round(a * 0.28f) << 24);
            int glowSoft = (flash.getPacked() & 0x00FFFFFF) | (Math.round(a * 0.12f) << 24);
            float cx = absX + drawSize / 2f;
            float cy = absY + drawSize / 2f;
            double pulse = 1.0 + 0.07 * Math.sin((System.currentTimeMillis() % 380) / 380.0 * Math.PI * 2.0);
            MorzhSmoothRenderer.circle(context, cx, cy, drawSize * 0.53f + 3.0f * (float) pulse, glowSoft);
            MorzhSmoothRenderer.circle(context, cx, cy, drawSize * 0.51f + 1.6f * (float) pulse, glowStrong);
        }

        float alpha = 255f * hudAnimAlpha;
        RoundHeadRenderer.draw(context, entity, absX, absY, drawSize, r, alpha, red);

        if (red > 0.004f) {
            Color flash = hitFlashColor.get().copy();
            int a = MathHelper.clamp(Math.round(flash.a * red), 0, 255);
            int wash = (flash.getPacked() & 0x00FFFFFF) | (Math.round(a * 0.22f) << 24);
            float inset = Math.max(0f, drawSize * 0.12f * red);
            float wr = Math.max(0f, r - inset);
            float innerSize = Math.max(1f, drawSize - inset * 2f);
            MorzhSmoothRenderer.roundedRect(context, absX + inset, absY + inset, innerSize, innerSize, wr, wash);
        }
    }

    private void healthFill(DrawContext context, float x, float y, float w, float h, float radius, int baseColor) {
        if (w <= 0.5f || h <= 0.5f) return;
        float cap = Math.min(Math.max(0f, radius), Math.min(h, w) * 0.5f);
        if (w <= cap * 2f + 0.5f) {
            MorzhSmoothRenderer.roundedRect(context, x, y, w, h, cap, baseColor);
            return;
        }

        int light = lightenPacked(baseColor, 0.30f);
        Renderer2D r = Renderer2D.COLOR;
        r.begin();
        Color base = DropDownColors.color(baseColor);
        Color lit = DropDownColors.color(light);
        r.quad(x, y, w, h, base, lit, lit, base);
        r.render(context.getMatrices());

        if (cap > 0.5f) {
            MorzhSmoothRenderer.roundedRect(context, x, y, cap * 2f, h, cap, baseColor);
            MorzhSmoothRenderer.roundedRect(context, x + w - cap * 2f, y, cap * 2f, h, cap, light);
        }
    }

    private static int lightenPacked(int packed, float t) {
        int a = (packed >>> 24) & 0xFF;
        int rr = (packed >> 16) & 0xFF;
        int g = (packed >> 8) & 0xFF;
        int b = packed & 0xFF;
        int nr = rr + Math.round((255 - rr) * t);
        int ng = g + Math.round((255 - g) * t);
        int nb = b + Math.round((255 - b) * t);
        return (a << 24) | (nr << 16) | (ng << 8) | nb;
    }

