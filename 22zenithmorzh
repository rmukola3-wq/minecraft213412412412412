            if (Friends.get().isFriend(player)) return friends.get();
            return players.get();
        }

        if (entity instanceof EndCrystalEntity) return crystals.get();

        return switch (entity.getType().getSpawnGroup()) {
            case CREATURE, WATER_CREATURE, AXOLOTLS, UNDERGROUND_WATER_CREATURE -> creatures.get();
            case MONSTER -> monsters.get();
            case AMBIENT, WATER_AMBIENT -> ambients.get();
