            return;
        }

        Packet<?> packet = event.packet;

        if (shouldNeverQueue(packet)) return;

        if (attackCooldown > 0 || isSyncing() || shouldFlushNow(packet)) {
            flush();
            return;
        }

        event.cancel();
        queue.add(packet);

        if (packet instanceof PlayerMoveC2SPacket move && move.changesPosition() && serverPos == null) {
            serverPos = new Vec3d(move.getX(0), move.getY(0), move.getZ(0));
