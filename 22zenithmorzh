            if (PROTECTED.contains(meta.getId())) continue;
            if (meta.getId().startsWith("fabric-") && !meta.getId().equals("fabric-api")) continue;
            Path jar = jarPath(mod);
            out.add(new ModInfo(meta.getId(), meta.getName(), meta.getVersion().getFriendlyString(), jar, isDisabled(jar)));
        }
        out.sort(Comparator.comparing(m -> m.id));
        return out;
    }

    public static Result disable(String query) {
        ModContainer mod = findMod(query);
        if (mod == null) return Result.fail("Мод не найден: " + query);
        if (PROTECTED.contains(mod.getMetadata().getId())) return Result.fail("Этот мод нельзя отключить.");
        Path jar = jarPath(mod);
        if (jar == null) return Result.fail("JAR не в папке mods (dev classpath?): " + mod.getMetadata().getId());
        if (isDisabled(jar)) return Result.ok("Уже отключён: " + mod.getMetadata().getId());
        try {
            Files.createDirectories(disabledDir());
            Files.move(jar, disabledDir().resolve(jar.getFileName()));
            return Result.ok("Отключён " + mod.getMetadata().getId() + " — перезапусти игру.");
        } catch (IOException e) {
            return Result.fail("Ошибка: " + e.getMessage());
        }
    }

    public static Result enable(String query) {
        try {
            Files.createDirectories(disabledDir());
            Path match = null;
            String q = query.toLowerCase(Locale.ROOT);
            try (var stream = Files.list(disabledDir())) {
                for (Path p : stream.toList()) {
                    if (!p.getFileName().toString().endsWith(".jar")) continue;
                    if (p.getFileName().toString().toLowerCase(Locale.ROOT).contains(q)) {
                        match = p;
                        break;
                    }
                }
            }
            if (match == null) return Result.fail("В .morzh-disabled нет: " + query);
            Files.move(match, modsDir().resolve(match.getFileName()));
            return Result.ok("Включён " + match.getFileName() + " — перезапусти игру.");
        } catch (IOException e) {
            return Result.fail("Ошибка: " + e.getMessage());
        }
    }

    public static Result disableAllThirdParty() {
        int count = 0;
        for (ModInfo info : listMods()) {
            if (info.disabled || info.jar == null) continue;
            Result r = disable(info.id);
            if (r.ok) count++;
        }
        return Result.ok("Отключено модов: " + count + ". Перезапусти игру.");
    }

    private static ModContainer findMod(String query) {
        String q = query.toLowerCase(Locale.ROOT);
        ModContainer partial = null;
        for (ModContainer mod : FabricLoader.getInstance().getAllMods()) {
            String id = mod.getMetadata().getId();
            if (id.equalsIgnoreCase(query)) return mod;
            if (id.toLowerCase(Locale.ROOT).contains(q)) partial = mod;
        }
        return partial;
    }

    private static Path jarPath(ModContainer mod) {
        Path mods = modsDir().toAbsolutePath().normalize();
        for (Path root : mod.getRootPaths()) {
            Path p = root.toAbsolutePath().normalize();
            if (!p.toString().endsWith(".jar")) continue;
            if (p.getParent() != null && p.getParent().equals(mods)) return p;
        }
        return null;
    }

    private static boolean isDisabled(Path jar) {
        if (jar == null) return false;
        return Files.exists(disabledDir().resolve(jar.getFileName()));
    }

    public record ModInfo(String id, String name, String version, Path jar, boolean disabled) {
    }

    public record Result(boolean ok, String message) {
        public static Result ok(String message) {
            return new Result(true, message);
        }

        public static Result fail(String message) {
            return new Result(false, message);
        }
    }
}

