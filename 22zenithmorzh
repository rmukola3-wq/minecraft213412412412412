public final class HeadPipeline {
    private Shader shader;

    private void ensureShader() {
        if (shader == null) shader = new Shader("round_head.vert", "round_head.frag");
    }

    public void draw(Identifier textureId, float x, float y, float width, float height,
                     float u0, float v0, float u1, float v1,
                     float radius, float alpha, float hurt) {
        MinecraftClient client = MinecraftClient.getInstance();
        if (client.getFramebuffer() == null || textureId == null || client.getWindow() == null) return;

        AbstractTexture texture = client.getTextureManager().getTexture(textureId);
        if (texture == null) return;

        double kx = client.getWindow().getFramebufferWidth() / (double) Math.max(1, client.getWindow().getWidth());
        double ky = client.getWindow().getFramebufferHeight() / (double) Math.max(1, client.getWindow().getHeight());
        float screenW = client.getWindow().getFramebufferWidth();
        float screenH = client.getWindow().getFramebufferHeight();
        float rx = (float) (x * kx);
        float ry = (float) (y * ky);
        float rw = (float) (width * kx);
        float rh = (float) (height * ky);
        float rr = (float) (radius * kx);

        ensureShader();
        GL.bindTexture(texture.getGlId(), 0);
        shader.bind();
        shader.set("Sampler0", 0);
        shader.set("u_Rect", rx, ry, rw, rh);
        shader.set("u_Uv", u0, v0, u1, v1);
        shader.set("u_Radii", rr, rr, rr, rr);
        shader.set("u_Rotation", 0, 0, 0, 0);
        shader.set("u_Screen", screenW, screenH, 1f, 1f);
        shader.set("hurt_time", hurt);
        shader.set("alpha", alpha);
