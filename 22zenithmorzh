package dev.morzh.client.utils.render.perf;

import it.unimi.dsi.fastutil.objects.ObjectOpenHashSet;
import dev.morzh.client.MixinPlugin;
import dev.morzh.client.systems.modules.Modules;
import dev.morzh.client.systems.modules.render.Freecam;
import dev.morzh.client.systems.modules.render.NoRender;
import dev.morzh.client.systems.modules.render.WallHack;
import dev.morzh.client.systems.modules.render.Xray;
import dev.morzh.client.utils.world.BlockUtils;
import net.irisshaders.iris.api.v0.IrisApi;
import net.minecraft.block.Block;
import net.minecraft.block.BlockState;
import net.minecraft.block.Blocks;
import net.minecraft.util.math.BlockPos;

import java.util.List;
import java.util.Set;

public final class WallRenderPerf {
    public static boolean skipOcclusion;

    public static boolean wallHackActive;
    public static boolean xrayActive;
    public static boolean forceInvisible;
    public static int wallOpacity;
    public static int xrayOpacity;
    public static int xrayNightOpacity;
    public static boolean xrayExposedOnly;
    public static boolean xrayFullBright;
    public static boolean xrayBypassOcclusion;
    public static WallHack.Mode wallMode;

    private static final Set<Block> WALL_BLOCKS = new ObjectOpenHashSet<>();
    private static final Set<Block> XRAY_BLOCKS = new ObjectOpenHashSet<>();

    private WallRenderPerf() {
    }

    public static void sync() {
        Modules modules = Modules.get();
        if (modules == null) {
            reset();
            return;
        }

        WallHack wall = modules.get(WallHack.class);
        Xray xray = modules.get(Xray.class);
        Freecam freecam = modules.get(Freecam.class);
        NoRender noRender = modules.get(NoRender.class);

        wallHackActive = wall != null && wall.isActive();
        xrayActive = xray != null && xray.isActive();

        boolean xrayBypass = xrayActive;
        boolean noCave = noRender != null && noRender.isActive() && noRender.noCaveCulling();

        skipOcclusion = xrayBypass
            || (freecam != null && freecam.isActive())
            || (wallHackActive && wall != null && !wall.occludeChunks.get())
            || noCave;

        forceInvisible = MixinPlugin.isSodiumPresent
            || (MixinPlugin.isIrisPresent && IrisApi.getInstance().isShaderPackInUse());

        if (wallHackActive && wall != null) {
            wallOpacity = wall.opacity.get();
            wallMode = wall.mode.get();
            rebuild(WALL_BLOCKS, wall.blocks.get());
        } else {
            WALL_BLOCKS.clear();
            wallMode = WallHack.Mode.Target;
        }

        if (xrayActive && xray != null) {
            xrayOpacity = xray.opacity.get();
            xrayNightOpacity = xrayOpacity;
            xrayExposedOnly = xray.isExposedOnly();
            xrayFullBright = false;
            xrayBypassOcclusion = true;
            rebuild(XRAY_BLOCKS, xray.getBlocks());
        } else {
            XRAY_BLOCKS.clear();
            xrayExposedOnly = false;
            xrayFullBright = false;
            xrayBypassOcclusion = false;
        }
    }

    private static void rebuild(Set<Block> out, List<Block> in) {
        out.clear();
        if (in != null) out.addAll(in);
    }

    public static void reset() {
        skipOcclusion = false;
        wallHackActive = false;
        xrayActive = false;
        forceInvisible = false;
        wallOpacity = 0;
        xrayOpacity = 0;
        xrayNightOpacity = 0;
        xrayExposedOnly = false;
        xrayFullBright = false;
        xrayBypassOcclusion = false;
        wallMode = WallHack.Mode.Target;
        WALL_BLOCKS.clear();
        XRAY_BLOCKS.clear();
    }

    public static int getAlpha(BlockState state, BlockPos pos) {
        if (!wallHackActive && !xrayActive) return -1;

        Block block = state.getBlock();
        if (block == Blocks.AIR || state.isAir()) return -1;

        if (xrayActive) {
            boolean whitelisted = XRAY_BLOCKS.contains(block);
            if (whitelisted) {
                if (xrayExposedOnly && pos != null && !BlockUtils.isExposed(pos)) {
                    return forceInvisible ? 0 : activeXrayOpacity();
                }
                return -1;
            }
            if (wallHackActive) {
                int wall = wallAlpha(block);
                if (wall != Integer.MIN_VALUE) return wall;
            }
            return forceInvisible ? 0 : activeXrayOpacity();
        }

        if (wallHackActive) {
            int wall = wallAlpha(block);
            if (wall != Integer.MIN_VALUE) return wall;
        }

        return -1;
    }

    private static int activeXrayOpacity() {
        if (isNight()) return xrayNightOpacity;
        return xrayOpacity;
    }

    private static boolean isNight() {
        if (dev.morzh.client.MorzhClient.mc == null || dev.morzh.client.MorzhClient.mc.world == null) {
            return false;
        }
        long time = dev.morzh.client.MorzhClient.mc.world.getTimeOfDay() % 24000L;
        return time >= 13000 && time <= 23000;
    }

    private static int wallAlpha(Block block) {
        boolean inList = WALL_BLOCKS.contains(block);
        return switch (wallMode) {
            case Target -> inList ? (forceInvisible ? 0 : wallOpacity) : Integer.MIN_VALUE;
            case Invert -> inList ? Integer.MIN_VALUE : (forceInvisible ? 0 : wallOpacity);
            case All -> forceInvisible ? 0 : wallOpacity;
        };
    }
}

