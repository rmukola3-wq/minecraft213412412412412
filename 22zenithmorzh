    private void renderHeader(MorzhGuiContext context, int left, int top) {
        int accent = MorzhGuiColors.packed(MorzhGuiColors.ACCENT);
        int accentDark = MorzhGuiColors.packed(MorzhGuiColors.ACCENT_DARK);

        MorzhSmoothRenderer.gradientRect(
            context.draw,
            left,
            top,
            WIDTH,
            HEADER_HEIGHT - 2f,
            context.fade(accent),
            context.fade(accentDark)
