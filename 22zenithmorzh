import net.minecraft.entity.Entity;

import static dev.morzh.client.MorzhClient.mc;
import static org.lwjgl.glfw.GLFW.glfwGetTime;

public abstract class PostProcessShader {
    public OutlineVertexConsumerProvider vertexConsumerProvider;
    public Framebuffer framebuffer;

    protected Shader shader;

    public void init(String frag) {
        int width = scaledWidth(
            mc.getWindow().getFramebufferWidth()
        );

        int height = scaledHeight(
            mc.getWindow().getFramebufferHeight()
        );

        vertexConsumerProvider = new OutlineVertexConsumerProvider(
            mc.getBufferBuilders().getEntityVertexConsumers()
        );

        framebuffer = new SimpleFramebuffer(
            width,
            height,
            true
        );

        shader = new Shader(
            "post-process/base.vert",
            "post-process/" + frag + ".frag"
        );
    }

    protected abstract boolean shouldDraw();

    public abstract boolean shouldDraw(Entity entity);

    protected void preDraw() {
    }

    protected void postDraw() {
    }

    protected abstract void setUniforms();

    public void beginRender() {
        if (!ready()) return;

        framebuffer.clear();

        restoreMainFramebuffer();
    }

    public void endRender(Runnable draw) {
        if (!ready() || draw == null) return;

        boolean pushed = false;

        try {
            preDraw();
            pushed = true;

            draw.run();
        }
        finally {
            if (pushed) {
                postDraw();
            }

            restoreMainFramebuffer();
        }

        try {
            GL.bindTexture(
                framebuffer.getColorAttachment(),
                0
            );

            shader.bind();

            shader.set(
                "u_Size",
                mc.getWindow().getFramebufferWidth(),
                mc.getWindow().getFramebufferHeight()
            );

            shader.set("u_Texture", 0);
            shader.set("u_Time", glfwGetTime());

            setUniforms();
            PostProcessRenderer.render();
        }
        finally {

            restoreMainFramebuffer();

            RenderSystem.setShaderColor(
                1f,
                1f,
                1f,
                1f
            );

            RenderSystem.defaultBlendFunc();
            RenderSystem.depthMask(true);
            RenderSystem.enableDepthTest();
            RenderSystem.enableCull();
        }
    }

    public void onResized(int width, int height) {
        if (framebuffer == null) return;

        framebuffer.resize(
            scaledWidth(width),
            scaledHeight(height)
        );

        restoreMainFramebuffer();
    }

    private boolean ready() {
        return shouldDraw()
            && framebuffer != null
            && shader != null
            && mc.getFramebuffer() != null;
    }

    private void restoreMainFramebuffer() {
        int width = mc.getWindow().getFramebufferWidth();
        int height = mc.getWindow().getFramebufferHeight();

        mc.getFramebuffer().beginWrite(true);
        GL.viewport(0, 0, width, height);
    }

    private static int scaledWidth(int width) {
        return Math.max(
            1,
            Math.round(width * VisualPerf.POST_PROCESS_SCALE)
        );
    }

    private static int scaledHeight(int height) {
        return Math.max(
            1,
            Math.round(height * VisualPerf.POST_PROCESS_SCALE)
        );
    }
}

