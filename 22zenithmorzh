    private LivingEntity updateTarget() {
        if (!basicCheck()) return null;

        TargetFinder.EntityFilter filter = new TargetFinder.EntityFilter(buildTargetTypes());
        float fov = attackFov.get().floatValue();
        float searchRange = range.get().floatValue() + 0.25F + lookRange.get().floatValue();
        boolean ignoreWalls = walls.get() != WallMode.Off;

        targetSelector.searchTargets(mc.world.getEntities(), searchRange, fov, ignoreWalls);
        targetSelector.validateTarget(filter::isValid);

        if (sort.get() == SortMode.LastAttacked && lastAttackedTarget != null
            && lastAttackedTarget.isAlive()
            && filter.isValid(lastAttackedTarget)
            && mc.player.distanceTo(lastAttackedTarget) <= searchRange) {
            targetSelector.lockTarget(lastAttackedTarget);
            return lastAttackedTarget;
        }

        targetSelector.sortPotentialTargets((a, b) -> switch (sort.get()) {
            case Fov -> {
                double fovA = AngleConnection.computeRotationDifference(
                    AngleConnection.INSTANCE.getRotation(),
                    MathAngle.calculateAngle(a.getEyePos())
                );
                double fovB = AngleConnection.computeRotationDifference(
                    AngleConnection.INSTANCE.getRotation(),
                    MathAngle.calculateAngle(b.getEyePos())
                );
                yield Double.compare(fovA, fovB);
            }
            case Health -> Float.compare(a.getHealth(), b.getHealth());
            case LastAttacked -> Double.compare(a == lastAttackedTarget ? 0 : 1, b == lastAttackedTarget ? 0 : 1);
            case Distance -> Double.compare(a.distanceTo(mc.player), b.distanceTo(mc.player));
        });

        return targetSelector.getCurrentTarget();
    }

