package dev.morzh.client.gui.rasty.util.render;

import dev.morzh.client.MorzhClient;
import net.minecraft.client.MinecraftClient;
import net.minecraft.client.network.ServerInfo;
import net.minecraft.client.texture.NativeImage;
import net.minecraft.client.texture.NativeImageBackedTexture;
import net.minecraft.util.Identifier;

import java.io.ByteArrayInputStream;
import java.util.Arrays;
import java.util.HashMap;
import java.util.Map;

public final class MenuFavicons {
    public static final Identifier UNKNOWN = Identifier.ofVanilla("textures/misc/unknown_server.png");

    private final Map<String, Identifier> icons = new HashMap<>();
    private final Map<String, byte[]> bytes = new HashMap<>();
    private int loadsThisTick;

    public void beginTick() {
        loadsThisTick = 0;
    }

    public void sync(ServerInfo info) {
        if (info == null || info.address == null) return;
        MinecraftClient client = MinecraftClient.getInstance();
        if (client == null) return;

        byte[] data = info.getFavicon();
        byte[] previous = bytes.get(info.address);
        if (Arrays.equals(data, previous)) return;
        if (loadsThisTick >= 1) return;

        Identifier old = icons.remove(info.address);
        if (old != null) client.getTextureManager().destroyTexture(old);
        bytes.remove(info.address);
        if (data == null || data.length == 0) return;

        try (ByteArrayInputStream in = new ByteArrayInputStream(data)) {
            NativeImage image = NativeImage.read(in);
            Identifier id = Identifier.of(MorzhClient.MOD_ID, "mp_icon/" + Integer.toUnsignedString(info.address.hashCode(), 16));
            client.getTextureManager().registerTexture(id, new NativeImageBackedTexture(image));
            icons.put(info.address, id);
            bytes.put(info.address, data);
            loadsThisTick++;
        } catch (Exception ignored) {
        }
    }

    public Identifier get(ServerInfo info) {
        if (info == null || info.address == null) return UNKNOWN;
        Identifier id = icons.get(info.address);
        return id != null ? id : UNKNOWN;
    }

    public void clear() {
        MinecraftClient client = MinecraftClient.getInstance();
        if (client != null) {
            for (Identifier id : icons.values()) {
                client.getTextureManager().destroyTexture(id);
            }
        }
        icons.clear();
        bytes.clear();
    }
}

