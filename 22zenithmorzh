    public void render(HudRenderer renderer) {

        boolean preview =
            staff.isEmpty() &&
                isInEditor();

        if (
            staff.isEmpty() &&
                !isInEditor()
        ) {
            setSize(0, 0);
            return;
        }

        double s = scale();
        double fs = 0.55 * s;

        float width = 140 * (float) s;
        float headerHeight = 20 * (float) s;
        float rowHeight = 16 * (float) s;

        for (StaffEntry entry : staff) {
            double nameWidth =
                MorzhSmoothRenderer.textWidth(
                    entry.name,
                    fs
                );

            double rankWidth =
                MorzhSmoothRenderer.textWidth(
                    entry.label,
                    fs
                );

