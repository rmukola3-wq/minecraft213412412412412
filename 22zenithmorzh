    @EventHandler
    private void onRender(Render3DEvent event) {
        if (mc.world == null || mc.player == null) return;

        HitResult target = mc.crosshairTarget;
        Box worldBox = null;
        BlockPos pos = null;

        if (target instanceof BlockHitResult result && result.getType() == HitResult.Type.BLOCK) {
            pos = result.getBlockPos();
            if (pos != null && !mc.world.getBlockState(pos).isAir()) {
                VoxelShapeHelper helper = new VoxelShapeHelper();
                Box outline = helper.outlineShape(mc.world.getBlockState(pos), mc.world, pos);
                if (outline != null) worldBox = outline;
            }
        }

        if (worldBox == null) return;

        event.matrices.push();
        event.matrices.translate(-event.offsetX, -event.offsetY, -event.offsetZ);

        renderOverlay(event.matrices, applyPrimaryAnimation(worldBox), overlayColor());

        if (animationMode.get() == AnimMode.Wave) {
            renderWave(event.matrices, worldBox, overlayColor());
        }

        event.matrices.pop();
    }

    private Box applyPrimaryAnimation(Box box) {
        if (animationMode.get() != AnimMode.Pulse) return box;

        float progress = (float) ((Math.sin(System.currentTimeMillis() / 260.0D) + 1.0D) * 0.5D);
        return scaleBox(box, 1.0F + progress * 0.04F);
    }

    private void renderOverlay(MatrixStack matrices, Box box, Color color) {
        matrices.push();
        RenderSystem.enableBlend();
        RenderSystem.defaultBlendFunc();
        RenderSystem.disableCull();
        RenderSystem.depthMask(false);
        RenderSystem.depthFunc(GL11.GL_ALWAYS);

        if (fillEnabled.get()) {
            drawFill(matrices, box, color);
        }

        if (outlineEnabled.get()) {
            drawOutline(matrices, box, color, 1.0F, (float) lineWidth.get().doubleValue());
        }

        RenderSystem.depthFunc(GL11.GL_LEQUAL);
        RenderSystem.depthMask(true);
        RenderSystem.enableCull();
        RenderSystem.disableBlend();
        matrices.pop();
    }

    private void renderWave(MatrixStack matrices, Box box, Color color) {
        float progress = (System.currentTimeMillis() % 1000L) / 1000.0F;
        Box waveBox = scaleBox(box, 1.0F + progress * 0.18F);

        matrices.push();
        RenderSystem.enableBlend();
        RenderSystem.defaultBlendFunc();
        RenderSystem.depthFunc(GL11.GL_ALWAYS);
        drawOutline(matrices, waveBox, color, 1.0F - progress, Math.max(1.0F, (float) lineWidth.get().doubleValue() - 0.5F));
        RenderSystem.depthFunc(GL11.GL_LEQUAL);
        RenderSystem.disableBlend();
        matrices.pop();
    }

    private void drawOutline(MatrixStack matrices, Box box, Color color, float alpha, float width) {
        GL11.glEnable(GL11.GL_LINE_SMOOTH);
        RenderSystem.setShader(ShaderProgramKeys.POSITION_COLOR);
        RenderSystem.lineWidth(width);

        BufferBuilder buffer = Tessellator.getInstance().begin(VertexFormat.DrawMode.DEBUG_LINES, VertexFormats.POSITION_COLOR);
        Matrix4f matrix = matrices.peek().getPositionMatrix();
        addBoxLines(buffer, matrix, box, color, alpha);
        BufferRenderer.drawWithGlobalProgram(buffer.end());

        RenderSystem.lineWidth(1.0F);
        GL11.glDisable(GL11.GL_LINE_SMOOTH);
    }

    private void drawFill(MatrixStack matrices, Box box, Color baseColor) {
        RenderSystem.setShader(ShaderProgramKeys.POSITION_COLOR);

        BufferBuilder buffer = Tessellator.getInstance().begin(VertexFormat.DrawMode.QUADS, VertexFormats.POSITION_COLOR);
        Matrix4f matrix = matrices.peek().getPositionMatrix();

        if (fillType.get() == FillType.Shader) {
            addShaderBoxQuads(buffer, matrix, box, (float) shaderAlpha.get().doubleValue());
        } else {
            addBoxQuads(buffer, matrix, box, baseColor, (float) fillAlpha.get().doubleValue());
