public class MorzhHotbar extends Module {
    private final SettingGroup sg = settings.getDefaultGroup();

    private final Setting<Offhand> offhand = sg.add(new EnumSetting.Builder<Offhand>()
        .name("offhand")
        .defaultValue(Offhand.Merged)
        .build()
    );

    private final Setting<Boolean> hideVanilla = sg.add(new BoolSetting.Builder()
        .name("hide-vanilla")
        .defaultValue(true)
        .build()
    );

    public MorzhHotbar() {
        super(Categories.Render, "hotbar", "Custom rounded hotbar.");
    }

    public boolean hidesVanilla() {
        return isActive() && hideVanilla.get();
    }

    @EventHandler
    private void onRender(Render2DEvent event) {
        if (mc.player == null || mc.options.hudHidden) return;
        DrawContext context = event.drawContext;
        float sw = Utils.getWindowWidth();
        float sh = Utils.getWindowHeight();
        float scale = (float) mc.getWindow().getScaleFactor();
        float slot = 20 * scale;
        float barH = 22 * scale;
        float barW = 9 * slot;
        float x = sw / 2f - barW / 2f;
        float y = sh - 8 * scale - barH;

        boolean hasOff = !mc.player.getOffHandStack().isEmpty();
        if (hasOff && offhand.get() == Offhand.Merged) {
            HudChrome.panel(context, x - slot - 4 * scale, y, barW + slot + 4 * scale, barH, 5 * scale);
            MorzhSmoothRenderer.roundedRect(context, x - 2 * scale, y + 3 * scale, 1f, barH - 6 * scale, 0.4f, DropDownColors.rgba(255, 255, 255, 50));
            renderItem(context, mc.player.getOffHandStack(), x - slot, y + 3 * scale, scale);
        } else {
            HudChrome.panel(context, x, y, barW, barH, 5 * scale);
            if (hasOff) {
                HudChrome.panel(context, x - slot - 6 * scale, y, barH, barH, 5 * scale);
                renderItem(context, mc.player.getOffHandStack(), x - slot - 4 * scale, y + 3 * scale, scale);
            }
        }

        int selected = mc.player.getInventory().selectedSlot;
        MorzhSmoothRenderer.roundedRect(context, x + selected * slot + 2 * scale, y + 2 * scale, slot - 4 * scale, barH - 4 * scale, 4 * scale, DropDownColors.rgba(255, 255, 255, 28));

        for (int i = 0; i < 9; i++) {
            ItemStack stack = mc.player.getInventory().getStack(i);
            float iy = i == selected ? y + 1 * scale : y + 3 * scale;
            renderItem(context, stack, x + i * slot + 2 * scale, iy, scale);
        }

        if (mc.player.experienceLevel > 0) {
            String lvl = String.valueOf(mc.player.experienceLevel);
            double fs = 0.55;
            float tw = (float) MorzhSmoothRenderer.textWidth(lvl, fs);
            MorzhSmoothRenderer.text(context, lvl, sw / 2f - tw / 2f, y - 12 * scale, DropDownColors.rgb(128, 255, 32), true, fs);
        }
    }

    private static void renderItem(DrawContext context, ItemStack stack, float x, float y, float scale) {
        if (stack.isEmpty()) return;
            RenderUtils.drawItem(context, stack, Math.round(x), Math.round(y), Math.max(1f, scale * 0.85f), true);
    }

    public enum Offhand {
        Merged,
        Separate
    }
}

