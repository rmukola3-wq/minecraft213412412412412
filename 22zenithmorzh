            from, to, RaycastContext.ShapeType.COLLIDER, RaycastContext.FluidHandling.NONE, mc.player
        )).getType() == HitResult.Type.MISS;
    }

    private double closestDistanceSquared(Entity entity) {
        Vec3d eyes = mc.player.getEyePos();
