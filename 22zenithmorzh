        KillAura killAura = Modules.get().get(KillAura.class);
        if (killAura != null && killAura.isDrivingPlayerRotation()) return true;
        ExpensiveAura expensiveAura = Modules.get().get(ExpensiveAura.class);
        return expensiveAura != null && expensiveAura.isActive() && expensiveAura.target() != null;
    }
