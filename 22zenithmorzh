import java.util.List;
import java.util.Random;

import static dev.morzh.client.MorzhClient.mc;

public class HitPointResolver {
    public final Random random = new SecureRandom();
    public Vec3d offset = Vec3d.ZERO;

    public Pair<Vec3d, Box> computeVector(LivingEntity entity, float range, Rotation rotation, Vec3d randomScale, boolean ignoreWalls) {
        Pair<List<Vec3d>, Box> points = generateCandidatePoints(entity, range, ignoreWalls);
        randomizeOffset(randomScale);
        Vec3d best = findBestPoint(points.getLeft(), rotation);
        return new Pair<>((best == null ? entity.getEyePos() : best).add(offset), points.getRight());
    }

    public Pair<List<Vec3d>, Box> generateCandidatePoints(LivingEntity entity, float range, boolean ignoreWalls) {
        Box box = entity.getBoundingBox();
        double step = box.getLengthY() / 10.0d;
        Vec3d eye = mc.player.getEyePos();
        ArrayList<Vec3d> points = new ArrayList<>();
        for (double y = box.minY; y <= box.maxY; y += step) {
            Vec3d point = new Vec3d(box.getCenter().x, y, box.getCenter().z);
            if (isReachable(eye, point, range, ignoreWalls)) points.add(point);
        }
        if (points.isEmpty()) {
            Vec3d closest = getClosestVec(eye, box);
            if (isReachable(eye, closest, range, ignoreWalls)) points.add(closest);
        }
        return new Pair<>(points, box);
    }

    public Vec3d getClosestVec(Vec3d from, Box box) {
        return new Vec3d(
            FastMathUtils.clamp(from.x, box.minX, box.maxX),
            FastMathUtils.clamp(from.y, box.minY, box.maxY),
            FastMathUtils.clamp(from.z, box.minZ, box.maxZ)
        );
    }

    public boolean hasValidPoint(LivingEntity entity, float range, boolean ignoreWalls) {
        if (entity == null) return false;
        Box box = entity.getBoundingBox();
        double step = box.getLengthY() / 10.0d;
        Vec3d eye = mc.player.getEyePos();
        for (double y = box.minY; y < box.maxY; y += step) {
            if (isReachable(eye, new Vec3d(box.getCenter().x, y, box.getCenter().z), range, ignoreWalls)) return true;
        }
        return isReachable(eye, getClosestVec(eye, box), range, ignoreWalls);
    }

    public boolean isReachable(Vec3d from, Vec3d to, float range, boolean ignoreWalls) {
        return from.distanceTo(to) <= range && (ignoreWalls || !WorldRaycastUtils.raycast(from, to, RaycastContext.ShapeType.COLLIDER).getType().equals(HitResult.Type.BLOCK));
    }

    public Vec3d findBestPoint(List<Vec3d> points, Rotation rotation) {
        return points.stream().min(Comparator.comparing(point -> computeRotationCost(mc.player.getEyePos(), point, rotation))).orElse(null);
    }

    public double computeRotationCost(Vec3d from, Vec3d to, Rotation rotation) {
        Rotation diff = RotationMath.INSTANCE.calculateRotationDifference(RotationMath.INSTANCE.fromVec3d(to.subtract(from)), rotation);
        return Math.hypot(diff.getYaw(), diff.getPitch());
    }

    public void randomizeOffset(Vec3d scale) {
        offset = offset.add(random.nextGaussian(), random.nextGaussian(), random.nextGaussian()).multiply(scale);
    }
}

