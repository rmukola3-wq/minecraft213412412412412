    private final SettingGroup sg = settings.getDefaultGroup();

    private final Setting<Keybind> openBind = sg.add(new KeybindSetting.Builder()
        .name("кнопка")
        .description("Dual: свап. Triple: держи — круглое меню на 3 слота.")
        .defaultValue(Keybind.fromKey(GLFW.GLFW_KEY_V))
        .build()
    );

    private final Setting<Mode> mode = sg.add(new EnumSetting.Builder<Mode>()
        .name("режим")
        .defaultValue(Mode.Triple)
        .build()
    );

    private final Setting<SwapItem> first = sg.add(new EnumSetting.Builder<SwapItem>()
        .name("первый")
        .defaultValue(SwapItem.Sphere)
        .visible(() -> mode.get() == Mode.Dual)
        .build()
    );

    private final Setting<SwapItem> second = sg.add(new EnumSetting.Builder<SwapItem>()
        .name("второй")
        .defaultValue(SwapItem.Totem)
        .visible(() -> mode.get() == Mode.Dual)
        .build()
    );

    private final ItemStack[] radial = {ItemStack.EMPTY, ItemStack.EMPTY, ItemStack.EMPTY};
    private boolean picking;
    private int pickSlot = -1;

    public AutoSwap() {
        super(Categories.Combat, "auto-swap", "Быстрый свап во вторую руку. Triple — круглая панель на 3 предмета (Delta).");
    }

    public ItemStack radial(int slot) {
        return radial[Math.floorMod(slot, radial.length)];
    }

    public void setRadial(int slot, ItemStack stack) {
        radial[Math.floorMod(slot, radial.length)] = stack == null || stack.isEmpty() ? ItemStack.EMPTY : stack.copy();
    }

    public boolean isPicking() {
        return picking;
    }

    public void beginPick(int slot) {
        picking = true;
        pickSlot = slot;
    }

    public void pickFromInventory(ItemStack stack) {
        if (!picking || pickSlot < 0) return;
        setRadial(pickSlot, stack);
        picking = false;
        pickSlot = -1;
        if (mc != null) mc.setScreen(new SwapRadialScreen());
    }

    public void cancelPick() {
        picking = false;
        pickSlot = -1;
    }

    public void moveToOffhand(ItemStack template) {
        if (mc.player == null || template == null || template.isEmpty()) return;
        if (ItemStack.areItemsAndComponentsEqual(mc.player.getOffHandStack(), template)) return;
        FindItemResult found = InvUtils.find(stack -> ItemStack.areItemsAndComponentsEqual(stack, template));
        if (!found.found()) found = InvUtils.find(template.getItem());
        if (!found.found()) return;
        if (found.isOffhand()) return;
        InvUtils.move().from(found.slot()).toOffhand();
    }

    @EventHandler
    private void onKey(KeyEvent event) {
        if (!openBind.get().matches(true, event.key, event.modifiers)) return;
        if (event.action == KeyAction.Press) press();
        else if (event.action == KeyAction.Release) release();
    }

    @EventHandler
    private void onMouse(MouseButtonEvent event) {
        if (!openBind.get().matches(false, event.button, 0)) return;
        if (event.action == KeyAction.Press) press();
        else if (event.action == KeyAction.Release) release();
    }

    private void press() {
        if (mc.player == null) return;
        if (mode.get() == Mode.Dual) {
            Item want = mc.player.getOffHandStack().getItem() == first.get().item ? second.get().item : first.get().item;
            FindItemResult found = InvUtils.find(want);
            if (found.found() && !found.isOffhand()) InvUtils.move().from(found.slot()).toOffhand();
            return;
        }
        if (!(mc.currentScreen instanceof SwapRadialScreen)) mc.setScreen(new SwapRadialScreen());
    }

    private void release() {
        if (mc.currentScreen instanceof SwapRadialScreen) mc.setScreen(null);
    }

    @EventHandler
    private void onScreen(OpenScreenEvent event) {
        if (picking && event.screen == null) cancelPick();
    }

    @Override
    public NbtCompound toTag() {
        NbtCompound tag = super.toTag();
        if (tag == null) return null;
        NbtList list = new NbtList();
        for (ItemStack stack : radial) {
            NbtCompound entry = new NbtCompound();
            if (!stack.isEmpty()) {
                Identifier id = Registries.ITEM.getId(stack.getItem());
                entry.putString("id", id.toString());
                entry.putInt("Count", stack.getCount());
            }
            list.add(entry);
        }
        tag.put("radial", list);
        return tag;
    }

    @Override
    public Module fromTag(NbtCompound tag) {
        super.fromTag(tag);
        NbtList list = tag.getList("radial", NbtElement.COMPOUND_TYPE);
        for (int i = 0; i < Math.min(3, list.size()); i++) {
            NbtCompound entry = list.getCompound(i);
            String id = entry.getString("id");
            if (id == null || id.isEmpty()) {
                radial[i] = ItemStack.EMPTY;
                continue;
            }
            Item item = Registries.ITEM.get(Identifier.of(id));
            int count = Math.max(1, entry.getInt("Count"));
            radial[i] = item == Items.AIR ? ItemStack.EMPTY : new ItemStack(item, count);
        }
        return this;
    }
}

