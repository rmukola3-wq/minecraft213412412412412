import com.mojang.blaze3d.systems.RenderSystem;
import dev.morzh.client.MorzhClient;
import dev.morzh.client.gui.rasty.util.render.pipeline.GlDraw;
import dev.morzh.client.renderer.GL;
import dev.morzh.client.renderer.Shader;
import dev.morzh.client.systems.hud.HudTheme;
import dev.morzh.client.systems.modules.render.VisualTheme;
import net.minecraft.client.MinecraftClient;
import net.minecraft.client.gl.Framebuffer;
import org.joml.Matrix4f;
import org.lwjgl.opengl.GL11;
import org.lwjgl.opengl.GL12;

import static org.lwjgl.opengl.GL11C.GL_RGBA;
import static org.lwjgl.opengl.GL11C.GL_RGBA8;
import static org.lwjgl.opengl.GL11C.GL_TEXTURE_2D;
import static org.lwjgl.opengl.GL11C.GL_UNSIGNED_BYTE;
import static org.lwjgl.opengl.GL11C.glCopyTexSubImage2D;
import static org.lwjgl.opengl.GL11C.glTexImage2D;

public final class MorzhGlassRenderer {
    private static Shader shader;
    private static boolean failed;

    public static boolean chromaticAberration = true;

    private static int snapshotTexture;
    private static int lastWidth, lastHeight;

    private MorzhGlassRenderer() {}

    public static void captureScene() {
        MinecraftClient client = MinecraftClient.getInstance();
        Framebuffer fb = client.getFramebuffer();
        if (fb == null || fb.textureWidth <= 0 || fb.textureHeight <= 0) return;

        int w = fb.textureWidth;
        int h = fb.textureHeight;
        if (snapshotTexture == 0) snapshotTexture = GL.genTexture();

        GL.bindTexture(snapshotTexture);
        GL.textureParam(GL_TEXTURE_2D, GL11.GL_TEXTURE_MIN_FILTER, GL11.GL_LINEAR);
        GL.textureParam(GL_TEXTURE_2D, GL11.GL_TEXTURE_MAG_FILTER, GL11.GL_LINEAR);
        GL.textureParam(GL_TEXTURE_2D, GL11.GL_TEXTURE_WRAP_S, GL12.GL_CLAMP_TO_EDGE);
        GL.textureParam(GL_TEXTURE_2D, GL11.GL_TEXTURE_WRAP_T, GL12.GL_CLAMP_TO_EDGE);
        if (lastWidth != w || lastHeight != h) {
            glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, 0L);
            lastWidth = w;
            lastHeight = h;
        }

        glCopyTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, 0, 0, w, h);
        GL.bindTexture(0);
    }

    public static boolean drawGlass(float x, float y, float width, float height, float radius, float alpha) {
        return drawGlass(x, y, width, height, radius, radius, radius, radius, alpha);
    }

    public static boolean drawGlass(float x, float y, float width, float height,
                                    float rTL, float rBL, float rTR, float rBR, float alpha) {
        if (alpha <= 0 || width <= 1 || height <= 1) return false;
        if (snapshotTexture == 0) {

            captureScene();
            if (snapshotTexture == 0) return false;
        }

        MinecraftClient client = MinecraftClient.getInstance();
        Framebuffer mainFb = client.getFramebuffer();
        if (mainFb == null) return false;

        if (!ensureShader()) return false;

        int fbW = client.getWindow().getFramebufferWidth();
        int fbH = client.getWindow().getFramebufferHeight();
        if (fbW <= 0 || fbH <= 0) return false;

        float fr = 1f, fg = 1f, fbB = 1f;
        if (HudTheme.accentFromTheme) {
            var tc = VisualTheme.getColor(0, 255);
            fr = tc.r / 255f;
            fg = tc.g / 255f;
            fbB = tc.b / 255f;
        }

        float distort = 0.07f * Math.min(1f, 220f / Math.max(width, height));

        Matrix4f modelView = new Matrix4f(RenderSystem.getModelViewStack());
        Matrix4f proj = new Matrix4f(RenderSystem.getProjectionMatrix());

        mainFb.beginWrite(false);
        GL.viewport(0, 0, fbW, fbH);

        RenderSystem.enableBlend();
        RenderSystem.defaultBlendFunc();
        RenderSystem.disableDepthTest();
        RenderSystem.disableCull();

        shader.bind();
        GL.bindTexture(snapshotTexture, 0);

        shader.set("Sampler0", 0);
        shader.set("u_Rect", x, y, width, height);
        shader.set("ModelViewMat", modelView);
        shader.set("ProjMat", proj);
        shader.set("u_Size", (double) width, (double) height);
        shader.set("u_Radius", rTL, rBL, rTR, rBR);
        shader.set("u_CornerSmoothness", 3.0);
        shader.set("u_GlobalAlpha", (double) alpha);
        shader.set("u_FresnelPower", 25.0);

        shader.set("u_FresnelColor", fr, fg, fbB);
        shader.set("u_FresnelAlpha", 0.5);
        shader.set("u_BaseAlpha", 1.0);
        shader.set("u_FresnelInvert", 1);
        shader.set("u_FresnelMix", 0.5);
        shader.set("u_DistortStrength", (double) distort);
        shader.set("u_Texel", 1.0 / fbW, 1.0 / fbH);
        shader.set("u_Blur", 2.0);
        shader.set("u_Ca", chromaticAberration ? 1.0 : 0.0);
        shader.set("u_Time", (double) ((System.currentTimeMillis() % 1000000L) / 1000.0));

        GlDraw.triangles(6);

        mainFb.beginWrite(false);
        GL.viewport(0, 0, fbW, fbH);
        return true;
    }

    private static boolean ensureShader() {
        if (failed) return false;
        if (shader != null) return true;

        try {
            shader = new Shader("post-process/liquid_glass.vert", "post-process/liquid_glass.fsh");
            MorzhClient.LOG.info("MorzhGlass: liquid glass shader loaded OK");
            return true;
        } catch (Exception e) {
            failed = true;
            MorzhClient.LOG.error("MorzhGlass: liquid glass shader FAILED", e);
            return false;
        }
    }
}

