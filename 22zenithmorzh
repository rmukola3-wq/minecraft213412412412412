        if (expensiveAuraActive()) {
            return PlayerRotationManager.INSTANCE.getCurrentRotation().getYaw();
        }
        Angle current = AngleConnection.INSTANCE.getRotation();
        return current != null ? current.getYaw() : mc.player.getYaw();
    }

