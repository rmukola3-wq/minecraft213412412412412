                return;
            }
            value = lerp(start, target, easeInOut(elapsed / (double) duration));
        }

        public void update(boolean thirdPerson, long ms, float thirdDistance) {
            duration = Math.max(1, ms);
            if (thirdPerson && !third) {
                start = 1;
                target = thirdDistance;
                value = 1;
                startMs = System.currentTimeMillis();
            } else if (!thirdPerson && third) {
                start = value;
                target = 1;
                startMs = System.currentTimeMillis();
            } else if (thirdPerson && startMs == 0) {
                target = thirdDistance;
                value = thirdDistance;
            }
            third = thirdPerson;
        }

        public float distance() {
            return value;
        }
    }

    private static float lerp(float a, float b, double t) {
        return (float) (a + (b - a) * t);
    }

    private static double easeOut(double t) {
        t = Math.max(0, Math.min(1, t));
        return 1 - Math.pow(1 - t, 3);
    }

    private static double easeInOut(double t) {
        t = Math.max(0, Math.min(1, t));
        return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    }
