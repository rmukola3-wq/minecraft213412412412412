        if (mc.player == null) return -1;

        int selected = serverSelectedSlot();
        if (isHealSplash(mc.player.getInventory().getStack(selected))) return 1;

        if (movedIn || swapped) cleanupAfterThrow();

        for (int i = 0; i < 9; i++) {
            if (isHealSplash(mc.player.getInventory().getStack(i))) {
                if (i != serverSelectedSlot()) {
                    oldSelectedSlot = mc.player.getInventory().selectedSlot;
                    selectSlotServer(i);
                    swapped = true;
                }
                return 1;
            }
        }

        int best = bestInventoryPotion();
        if (best == -1) return -1;
        if (!canClickInventoryNow()) return 0; 

        potSlot = best;
        movedFromSlot = best;
        if (tempHotbarSlot < 0 || tempHotbarSlot == serverSelectedSlot()) {
            tempHotbarSlot = pickTempHotbarSlot();
        }
        InvUtils.move().from(best).toHotbar(tempHotbarSlot);
        movedIn = true;
        if (tempHotbarSlot != serverSelectedSlot()) {
            oldSelectedSlot = mc.player.getInventory().selectedSlot;
            selectSlotServer(tempHotbarSlot);
            swapped = true;
        }
        return 1;
    }

    private void sendUse(float yaw, float pitch) {
        if (mc.player == null || mc.player.networkHandler == null || mc.world == null || mc.interactionManager == null) return;

        Rotation target = new Rotation(yaw, pitch).normalize();

        boolean aligned = lastSentLook != null && target.angleTo(lastSentLook) < 0.5f;
        if (!aligned) {

            sendLook(target);
        }

        try {
            ((ClientPlayerInteractionManagerInvoker) mc.interactionManager).morzh$sendSequencedPacket(
                mc.world,
                seq -> new PlayerInteractItemC2SPacket(Hand.MAIN_HAND, seq, target.getYaw(), target.getPitch())
            );
        } catch (Throwable ignored) {
            mc.player.networkHandler.sendPacket(new PlayerInteractItemC2SPacket(Hand.MAIN_HAND, 0, target.getYaw(), target.getPitch()));
