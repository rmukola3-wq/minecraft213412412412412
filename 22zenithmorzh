            if (!boat.isAlive() || boat.hasPassengers()) continue;
            double d = mc.player.squaredDistanceTo(boat);
            if (d <= bestDist) {
                bestDist = d;
                best = boat;
                lastBoatId = boat.getId();
            }
        }
        return best;
    }

    private void resetState(boolean clearBoat) {
        if (clearBoat) lastBoatId = -1;
        wasInBoat = false;
        intentionalExit = false;
