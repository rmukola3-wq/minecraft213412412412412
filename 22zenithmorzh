    private boolean clockwise;
    private boolean wasColliding;

    private int switchTimer;
    private int waterTicks;
    private int cubePoint;

    private double oldSpeed;
    private float contextFriction = 0.91f;

    public TargetStrafe() {
        super(
            Categories.Movement,
            "target-strafe",
            "HvH orbit around Alternative Aura target. Main Aura is ignored."
        );
    }

    @Override
    public void onActivate() {
        clockwise =
            directionMode.get()
                != DirectionMode.CounterClockwise;

        cubePoint = 0;
        switchTimer = 0;
        waterTicks = 0;

        oldSpeed = 0;
        contextFriction = 0.91f;

        wasColliding = false;
    }

    @Override
    public void onDeactivate() {
        oldSpeed = 0;
    }

    @Override
    public String getInfoString() {
        KillAura aura = getAura();

        if (
            aura != null
                && aura.isWaitingForCritical()
        ) {
            return "Crit Sync";
        }

        return profile.get().name();
    }

    @EventHandler(priority = EventPriority.LOW)
    private void onTick(TickEvent.Pre event) {
        if (
            mc.player == null
                || mc.world == null
        ) {
            return;
        }

        if (switchTimer > 0) {
            switchTimer--;
        }

        if (mc.player.isSubmergedInWater()) {
            waterTicks = 10;
        } else if (waterTicks > 0) {
            waterTicks--;
        }

        double movedX =
            mc.player.getX()
                - mc.player.prevX;

        double movedZ =
            mc.player.getZ()
                - mc.player.prevZ;

        oldSpeed =
            Math.hypot(movedX, movedZ)
                * contextFriction;

        updateDirection();

        boolean collision =
            mc.player.horizontalCollision;

        if (
            collisionSwitch.get()
                && collision
                && !wasColliding
        ) {
            changeDirection();
        }

        wasColliding = collision;

        LivingEntity target =
            getTarget();

        if (
            target == null
                || !canStrafe()
                || !hasRequiredInput()
        ) {
            return;
        }

        KillAura aura = getAura();

        if (sprint.get()) {
            mc.player.setSprinting(true);
        }

        if (
            autoJump.get()
                && mc.player.isOnGround()
                && (aura == null || !aura.isActive() || aura.shouldTargetStrafeJump())
        ) {
            mc.player.jump();
        }
    }

    @EventHandler(priority = EventPriority.LOW)
    private void onInput(PlayerInputEvent event) {
        if (mc.player == null || mc.world == null) return;
        if (!autoJump.get() || getTarget() == null || !canStrafe() || !hasRequiredInput()) return;
        if (!mc.player.isOnGround()) return;

        KillAura aura = getAura();
        if (aura != null && aura.isActive() && !aura.shouldTargetStrafeJump()) return;
        event.setJump(true);
    }

    @EventHandler(
        priority = EventPriority.LOWEST - 100
    )
    private void onMove(PlayerMoveEvent event) {
        if (
            mc.player == null
                || mc.world == null
                || event.type != MovementType.SELF
        ) {
            return;
        }

        LivingEntity target =
            getTarget();

        if (
            target == null
                || !canStrafe()
                || !hasRequiredInput()
        ) {
            oldSpeed = 0;
            return;
        }

        Engine engine = getEngine();
        OrbitMode orbit = getOrbit();

        double radius = getRadius();

        Vec3d targetPosition =
            predictTarget(target);

        double movementSpeed =
            getMovementSpeed(
                event,
                engine
            );

        if (
            hurtBoost.get()
                && mc.player.hurtTime > 0
        ) {
            movementSpeed +=
                hurtBoostAmount.get();
        }

        movementSpeed =
            MathHelper.clamp(
                movementSpeed,
                0.01,
                2.0
            );

        Point point =
            calculatePoint(
                targetPosition,
                radius,
                movementSpeed,
                orbit
            );

        if (
            shouldSwitch(
                point.x,
                point.z
            )
        ) {
            changeDirection();

            point =
                calculatePoint(
                    targetPosition,
                    radius,
                    movementSpeed,
                    orbit
                );
        }

        double yaw =
            yawTo(point.x, point.z);

        if (
            engine == Engine.Grim
                && grimEightDirections.get()
        ) {
            double relative =
                MathHelper.wrapDegrees(
                    yaw - mc.player.getYaw()
                );

            relative =
                Math.round(relative / 45.0)
                    * 45.0;

            yaw =
                mc.player.getYaw()
                    + relative;
        }

        double wantedX =
            -Math.sin(
                Math.toRadians(yaw)
            ) * movementSpeed;

        double wantedZ =
            Math.cos(
                Math.toRadians(yaw)
            ) * movementSpeed;

        double smoothing =
            getSmoothing();

        if (smoothing > 0) {
            wantedX =
                MathHelper.lerp(
                    smoothing,
                    wantedX,
                    event.movement.x
                );

            wantedZ =
                MathHelper.lerp(
                    smoothing,
                    wantedZ,
                    event.movement.z
                );
        }

        ((IVec3d) event.movement)
            .morzh$setXZ(
                wantedX,
                wantedZ
            );
    }

    @EventHandler
    private void onPacketReceive(
        PacketEvent.Receive event
    ) {
        if (
            event.packet
                instanceof PlayerPositionLookS2CPacket
        ) {
            oldSpeed = 0;
            switchTimer = 0;
        }
    }

    @EventHandler
    private void onRender(
        Render3DEvent event
    ) {
        if (
            !render.get()
                || mc.player == null
                || mc.world == null
        ) {
            return;
        }

        LivingEntity target =
            getTarget();

        if (target == null) {
            return;
        }

        Vec3d center =
            predictTarget(target);

        double radius =
            getRadius();

        double y =
            target.getY() + 0.05;

        if (getOrbit() == OrbitMode.Cube) {
            Vec3d[] points =
                cubePoints(center, radius);

            for (int i = 0; i < 4; i++) {
                Vec3d first = points[i];
                Vec3d second =
                    points[(i + 1) % 4];

                event.renderer.line(
                    first.x,
                    y,
                    first.z,
                    second.x,
                    y,
                    second.z,
                    renderColor
                );
            }

            return;
        }

        if (
            getOrbit()
                == OrbitMode.Center
        ) {
            return;
        }

        int points =
            renderPoints.get();

        double previousX =
            center.x + radius;

        double previousZ =
            center.z;

        for (int i = 1;
             i <= points;
             i++) {
            double angle =
                Math.PI
                    * 2.0
                    * i
                    / points;

            double x =
                center.x
                    + Math.cos(angle)
                    * radius;

            double z =
                center.z
                    + Math.sin(angle)
                    * radius;

            event.renderer.line(
                previousX,
                y,
                previousZ,
                x,
                y,
                z,
                renderColor
            );

            previousX = x;
            previousZ = z;
        }
    }

    private Point calculatePoint(
        Vec3d target,
        double radius,
        double speed,
        OrbitMode orbit
    ) {
        if (orbit == OrbitMode.Center) {
            return new Point(
                target.x,
                target.z
            );
        }

        if (orbit == OrbitMode.Cube) {
            Vec3d[] points =
                cubePoints(target, radius);

            Vec3d current =
                points[cubePoint];

            if (
                mc.player
                    .getPos()
                    .squaredDistanceTo(current)
                    <= pointReach.get()
                    * pointReach.get()
            ) {
                cubePoint +=
                    clockwise ? 1 : -1;

                normalizeCubePoint();
                current = points[cubePoint];
            }

            return new Point(
                current.x,
                current.z
            );
        }

        double differenceX =
            mc.player.getX() - target.x;

        double differenceZ =
            mc.player.getZ() - target.z;

        double currentDistance =
            Math.max(
                0.001,
                Math.hypot(
                    differenceX,
                    differenceZ
                )
            );

        double angle =
            Math.atan2(
                differenceZ,
                differenceX
            );

        double angleStep =
            speed / currentDistance;

        angle += clockwise
            ? angleStep
            : -angleStep;

        return new Point(
            target.x
                + radius
                * Math.cos(angle),
            target.z
                + radius
                * Math.sin(angle)
        );
    }

    private Vec3d[] cubePoints(
        Vec3d target,
        double radius
    ) {
        return new Vec3d[] {
            new Vec3d(
                target.x - radius,
                mc.player.getY(),
                target.z - radius
            ),
            new Vec3d(
                target.x - radius,
                mc.player.getY(),
                target.z + radius
            ),
            new Vec3d(
                target.x + radius,
                mc.player.getY(),
                target.z + radius
            ),
            new Vec3d(
                target.x + radius,
                mc.player.getY(),
                target.z - radius
            )
        };
    }

    private double getMovementSpeed(
        PlayerMoveEvent event,
        Engine engine
    ) {
        if (engine == Engine.Fixed) {
            contextFriction = 0.91f;
            return getConfiguredSpeed();
        }

        if (engine == Engine.Grim) {
            contextFriction = 0.91f;

            double current =
                Math.hypot(
                    event.movement.x,
                    event.movement.z
                );

            current =
                Math.max(0.08, current);

            return Math.min(
                getConfiguredSpeed(),
                current + 0.018
            );
        }

        BlockPos position =
            BlockPos.ofFloored(
                mc.player.getX(),
                mc.player
                    .getBoundingBox()
                    .minY
                    - event.movement.y,
                mc.player.getZ()
            );

        float friction =
            mc.player.isOnGround()
                ? mc.world
                  .getBlockState(position)
                  .getBlock()
                  .getSlipperiness()
                  * 0.91f
                : mc.player.isUsingItem()
                && oldSpeed > 0.32
                  ? 0.88f
                  : 0.91f;

        double acceleration;

        if (mc.player.isOnGround()) {
            acceleration =
                mc.player.getMovementSpeed()
                    * 1.3
                    * (
                    0.1631
                        / Math.pow(
                        friction,
                        3.0
                    )
                );

            if (event.movement.y > 0) {
                acceleration +=
                    getGroundBoost();
            }
        } else {
            acceleration =
                getAirAcceleration();
        }

        contextFriction = friction;

        double result =
            Math.max(
                getConfiguredSpeed(),
                oldSpeed + acceleration
            );

        result -=
            mc.player.age % 2 == 0
                ? 0.001
                : 0.002;

        return Math.max(
            getConfiguredSpeed(),
            result
        );
    }

    private Vec3d predictTarget(
        LivingEntity target
    ) {
        double prediction =
            getPrediction();

        return new Vec3d(
            target.getX()
                + (
                target.getX()
                    - target.prevX
            ) * prediction,
            target.getY()
                + (
                target.getY()
                    - target.prevY
            ) * prediction,
            target.getZ()
                + (
                target.getZ()
                    - target.prevZ
            ) * prediction
        );
    }

    private void updateDirection() {
        if (
            directionMode.get()
                == DirectionMode.Manual
        ) {
            if (mc.options.leftKey.isPressed()) {
                clockwise = false;
            } else if (
                mc.options.rightKey.isPressed()
            ) {
                clockwise = true;
            }
        } else if (
            directionMode.get()
                == DirectionMode.Clockwise
        ) {
            clockwise = true;
        } else if (
            directionMode.get()
                == DirectionMode.CounterClockwise
        ) {
            clockwise = false;
        } else if (
            mc.player.age % 80 == 0
        ) {
            clockwise = !clockwise;
        }
    }

    private boolean shouldSwitch(
        double x,
        double z
    ) {
        if (switchTimer > 0) {
            return false;
        }

        if (
            collisionSwitch.get()
                && mc.player.horizontalCollision
        ) {
            return true;
        }

        return voidCheck.get()
            && dangerousPoint(x, z);
    }

    private boolean dangerousPoint(
        double x,
        double z
    ) {
        int startY =
            MathHelper.floor(
                mc.player.getY() + 3
            );

        int minimumY =
            groundScanDepth.get() == 0
                ? mc.world.getBottomY()
                : Math.max(
                mc.world.getBottomY(),
                startY
                - groundScanDepth.get()
            );

        BlockPos.Mutable position =
            new BlockPos.Mutable();

        for (
            int y = startY;
            y >= minimumY;
            y--
        ) {
            position.set(
                MathHelper.floor(x),
                y,
                MathHelper.floor(z)
            );

            BlockState state =
                mc.world.getBlockState(
                    position
                );

            Block block =
                state.getBlock();

            if (
                avoidHazards.get()
                    && (
                    block == Blocks.LAVA
                        || block == Blocks.FIRE
                        || block
                        == Blocks.SOUL_FIRE
                )
            ) {
                return true;
            }

            if (!state.isAir()) {
                return false;
            }
        }

        return true;
    }

    private LivingEntity getTarget() {
        KillAura aura = getAura();

        if (
            aura == null
                || !aura.isActive()
        ) {
            return null;
        }

        Entity target =
            aura.getTarget();

        if (
            target
                instanceof LivingEntity living
                && living.isAlive()
                && living != mc.player
        ) {
            return living;
        }

        if (
            KillAura.TARGET instanceof LivingEntity living
                && living.isAlive()
                && living != mc.player
        ) {
            return living;
        }

        return null;
    }

    private KillAura getAura() {
        return Modules.get()
            .get(KillAura.class);
    }

    private boolean canStrafe() {
        if (
            pauseSneaking.get()
                && mc.player.isSneaking()
        ) {
            return false;
        }

        if (
            pauseLiquids.get()
                && (
                mc.player
                    .isSubmergedInWater()
                    || mc.player.isInLava()
                    || waterTicks > 0
            )
        ) {
            return false;
        }

        if (
            mc.player
                .getAbilities()
                .flying
        ) {
            return false;
        }

        if (
            pauseSpeed.get()
                && Modules.get()
                .isActive(Speed.class)
        ) {
            return false;
        }

        return !pauseScaffold.get()
            || !Modules.get()
            .isActive(Scaffold.class);
    }

    private boolean hasRequiredInput() {
        if (!onlyOnInput.get()) {
            return true;
        }

        return mc.options
            .forwardKey
            .isPressed()
            || mc.options
            .backKey
            .isPressed()
            || mc.options
            .leftKey
            .isPressed()
