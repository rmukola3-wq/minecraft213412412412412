    private float easeOutCubic(float value) {
        float t = MathHelper.clamp(value, 0.0f, 1.0f);
        float inverse = 1.0f - t;
        return 1.0f - inverse * inverse * inverse;
    }

    private float easeInOutCubic(float value) {
        float t = MathHelper.clamp(value, 0.0f, 1.0f);
        return t < 0.5f ? 4f * t * t * t : 1f - (float) Math.pow(-2f * t + 2f, 3) / 2f;
    }

    private float easeOutSine(float t) {
        t = MathHelper.clamp(t, 0f, 1f);
        return (float) Math.sin(t * Math.PI * 0.5);
    }

    private float easeOutQuad(float t) {
        t = MathHelper.clamp(t, 0f, 1f);
        return 1f - (1f - t) * (1f - t);
    }

    private float easeOutBack(float t) {
        t = MathHelper.clamp(t, 0f, 1f);
        float c1 = 1.70158f;
        float c3 = c1 + 1f;
        float p = t - 1f;
        return 1f + c3 * p * p * p + c1 * p * p;
    }

    private float styleEase(float t) {
        return switch (style.get()) {
            case ReallyVisual, Ambient, Thunder, NurikZapen, Rust, Dento, Novoline -> easeOutCubic(t);
            case Rockstar, Circle -> easeOutSine(t);
            case Xyeta -> easeOutBack(t);
            case Pulse, Compact, Expensive, Morzh -> t;
            case Punch -> easeOutCubic(t);
            case LiquidBounce -> easeOutQuad(t);
        };
    }

    private float styleAnimSpeed(boolean opening) {
        float mul = openAnimationSpeed.get().floatValue() / 9f;
        float speed = switch (style.get()) {
            case Xyeta -> opening ? 10f : 8f;
            case Rockstar, Circle -> opening ? 8f : 6f;
            case Pulse -> 6f;
            case Punch -> 9f;
            case LiquidBounce -> 12f;
            case ReallyVisual, Ambient -> 8f;
            case Thunder, NurikZapen -> 11f;
            case Compact, Expensive, Morzh -> 9f;
            case Novoline -> 10f;
            case Rust -> 7f;
            case Dento -> 10f;
        };
        return speed * mul;
    }

    private float styleAlpha(float eased) {
        float t = Math.min(1f, Math.max(0f, eased));
        return switch (style.get()) {
            case Pulse, Compact, Expensive, Morzh, ReallyVisual, Ambient, Novoline, LiquidBounce, Rust -> t;
            case Xyeta -> Math.min(1f, t);
            case Punch -> t;
            case Rockstar, Circle, Thunder, NurikZapen, Dento -> t;
        };
    }

    private int fa(int packed) {
        int a = (packed >>> 24) & 255;
        if (a == 0) a = 255;
        int na = MathHelper.clamp(Math.round(a * hudAnimAlpha), 0, 255);
        return (packed & 0x00FFFFFF) | (na << 24);
    }

    private Color fa(Color color) {
        Color out = color.copy();
        out.a(MathHelper.clamp(Math.round(color.a * hudAnimAlpha), 0, 255));
        return out;
    }

