package dev.morzh.client.renderer;

import dev.morzh.client.MorzhClient;
import dev.morzh.client.events.game.ResolutionChangedEvent;
import dev.morzh.client.utils.PreInit;
import meteordevelopment.orbit.EventHandler;
import net.minecraft.client.MinecraftClient;

public final class KawaseBlur {
    private static final KawaseBlur INSTANCE = new KawaseBlur();
    private static final Framebuffer[] FBOS = new Framebuffer[6];

    private Shader shaderDown;
    private Shader shaderUp;
    private int lastWidth;
    private int lastHeight;
    private boolean ready;

    private KawaseBlur() {}

    @PreInit(dependencies = PostProcessRenderer.class)
    public static void init() {
        MorzhClient.EVENT_BUS.subscribe(INSTANCE);
    }

    public static int texture() {
        return INSTANCE.ready && FBOS[0] != null ? FBOS[0].texture : 0;
    }

    public static boolean isReady() {
        return INSTANCE.ready && texture() != 0;
    }

    @EventHandler
    private void onResize(ResolutionChangedEvent event) {
        for (int i = 0; i < FBOS.length; i++) {
            if (FBOS[i] != null) FBOS[i].resize();
            else FBOS[i] = new Framebuffer(1 / Math.pow(2, i));
        }
        ready = false;
    }

    public static void prepare(int iterations, double offset) {
        INSTANCE.prepareInternal(iterations, offset);
    }

    private void prepareInternal(int iterations, double offset) {
        MinecraftClient mc = MinecraftClient.getInstance();
        if (mc.getFramebuffer() == null) {
            ready = false;
            return;
        }

        if (shaderDown == null) {
            shaderDown = new Shader("blur.vert", "blur_down.frag");
            shaderUp = new Shader("blur.vert", "blur_up.frag");
            for (int i = 0; i < FBOS.length; i++) {
                if (FBOS[i] == null) FBOS[i] = new Framebuffer(1 / Math.pow(2, i));
            }
        }

        int fw = mc.getWindow().getFramebufferWidth();
        int fh = mc.getWindow().getFramebufferHeight();
        if (fw != lastWidth || fh != lastHeight) {
            lastWidth = fw;
            lastHeight = fh;
            for (Framebuffer fbo : FBOS) {
                if (fbo != null) fbo.resize();
            }
        }

        iterations = Math.max(1, Math.min(iterations, 4));

        PostProcessRenderer.beginRender();
        renderToFbo(FBOS[0], mc.getFramebuffer().getColorAttachment(), shaderDown, offset);
        for (int i = 0; i < iterations; i++) {
            renderToFbo(FBOS[i + 1], FBOS[i].texture, shaderDown, offset);
        }
        for (int i = iterations; i >= 1; i--) {
            renderToFbo(FBOS[i - 1], FBOS[i].texture, shaderUp, offset);
        }
        PostProcessRenderer.endRender();
        restoreMainTarget(mc);
        ready = true;
    }

    public static void blitToScreen() {
        if (!isReady()) return;
        MinecraftClient mc = MinecraftClient.getInstance();
        restoreMainTarget(mc);
        Shader passthrough = INSTANCE.passthrough();
        PostProcessRenderer.beginRender();
        passthrough.bind();
        GL.bindTexture(texture());
        passthrough.set("uTexture", 0);
        PostProcessRenderer.render();
        PostProcessRenderer.endRender();
        restoreMainTarget(mc);
    }

    private static void restoreMainTarget(MinecraftClient mc) {
        mc.getFramebuffer().beginWrite(true);
        GL.viewport(0, 0, mc.getWindow().getFramebufferWidth(), mc.getWindow().getFramebufferHeight());
    }

    private Shader passthroughShader;

    private Shader passthrough() {
        if (passthroughShader == null) passthroughShader = new Shader("passthrough.vert", "passthrough.frag");
        return passthroughShader;
    }

    private void renderToFbo(Framebuffer targetFbo, int sourceText, Shader shader, double offset) {
        if (targetFbo == null || targetFbo.width <= 0 || targetFbo.height <= 0 || sourceText <= 0) return;
        targetFbo.bind();
        targetFbo.setViewport();
        shader.bind();
        GL.bindTexture(sourceText);
        shader.set("uTexture", 0);
        shader.set("uHalfTexelSize", .5 / targetFbo.width, .5 / targetFbo.height);
        shader.set("uOffset", offset);
        PostProcessRenderer.render();
    }
}

