        .defaultValue(true)
        .build()
    );

    private final Setting<Boolean> vanishRequiresEntity = sgDetect.add(new BoolSetting.Builder()
        .name("vanish-requires-entity")
        .description("Mark VANISH only if the player entity is present in the world.")
        .defaultValue(true)
        .build()
    );

    private final Setting<Integer> maxRows = sgDetect.add(new IntSetting.Builder()
        .name("max-rows")
        .description("Maximum number of staff entries to show.")
        .defaultValue(10)
        .min(1)
        .sliderMax(30)
        .build()
    );

    private final Set<String> excludeNames = new HashSet<>();
    private final Set<String> excludeKeywords = new HashSet<>();
    private final List<String> keywords = new ArrayList<>();
    private final List<StaffDetector.GlyphRule> glyphRules = new ArrayList<>();

    private boolean showDonate = true;
    private boolean includeMediaText = true;
    private boolean includeDonateText = true;
    private boolean scanDisplayFallback = true;
    private boolean ignoreSelf = false;

    public StaffBoardHud() {
        super(INFO);

        setSize(140, 38);
    }

    @Override
    public void tick(HudRenderer renderer) {
        staff.clear();

        if (MC.player == null || MC.getNetworkHandler() == null) {
            return;
        }

        StaffDetector.excludeNames = excludeNames;
        StaffDetector.excludeKeywords = excludeKeywords;
        StaffDetector.keywords = keywords;
        StaffDetector.userGlyphRules = glyphRules;
        StaffDetector.showDonate = showDonate;
        StaffDetector.includeMediaText = includeMediaText;
        StaffDetector.includeDonateText = includeDonateText;
        StaffDetector.scanDisplayFallback = scanDisplayFallback;
        StaffDetector.ignoreSelf = ignoreSelf;

        String host = "countrymc";

        Set<String> tabNamesLower = new HashSet<>();

        for (PlayerListEntry entry : MC.getNetworkHandler().getPlayerList()) {
            String name = entry.getProfile().getName();

            if (name == null || name.isBlank()) {
                continue;
            }

            tabNamesLower.add(name.toLowerCase(Locale.ROOT));

            if (containsIgnoreCase(excludeNames, name)) {
                continue;
            }

            if (
                ignoreSelf &&
                    MC.player.getName().getString().equals(name)
            ) {
                continue;
            }

            String display = "";

            if (entry.getDisplayName() != null) {
                display = StaffDetector.plain(
                    StaffDetector.flatten(entry.getDisplayName())
                );
            }

            String before = StaffDetector.beforeName(
                display,
                name
            );

            String teamPrefix = "";

            Team team = entry.getScoreboardTeam();

            if (team != null && team.getPrefix() != null) {
                teamPrefix = StaffDetector.plain(
                    StaffDetector.flatten(team.getPrefix())
                );
            }

            String prefix;

            if (!before.isBlank()) {
                prefix = before;
            }
            else {
                prefix = teamPrefix;
            }

            if (
                prefix.isBlank() &&
                    scanDisplayFallback
            ) {
                prefix = display;
            }

            StaffDetector.RankHit hit =
                StaffDetector.findRank(prefix, host);

            if (hit == null) {
                continue;
            }

            Status status =
                entry.getGameMode() == GameMode.SPECTATOR
                    ? Status.GM3
                    : Status.ACTIVE;

            if (status == Status.GM3 && !showGm3.get()) continue;

            staff.add(
                new StaffEntry(
                    name,
                    hit.label,
                    hit.kind,
                    status
                )
            );

            if (staff.size() >= maxRows.get()) {
                break;
            }
        }

        if (showVanish.get() && MC.world != null && staff.size() < maxRows.get()) {
            Set<String> seenNames = new HashSet<>();
            for (StaffEntry e : staff) seenNames.add(e.name.toLowerCase(Locale.ROOT));

            Set<String> worldEntityNames = new HashSet<>();
            if (vanishRequiresEntity.get()) {
                for (PlayerEntity p : MC.world.getPlayers()) {
                    String n = p.getName().getString();
                    if (n != null) worldEntityNames.add(n.toLowerCase(Locale.ROOT));
                }
            }

            Scoreboard board = MC.world.getScoreboard();
            if (board != null) {
                outer:
                for (Team team : board.getTeams()) {
                    if (team == null) continue;

                    String teamPfx = team.getPrefix() != null
                        ? StaffDetector.plain(StaffDetector.flatten(team.getPrefix())) : "";
                    String teamSfx = team.getSuffix() != null
                        ? StaffDetector.plain(StaffDetector.flatten(team.getSuffix())) : "";

                    String rankPrefix = !teamPfx.isBlank() ? teamPfx : teamSfx;
                    if (rankPrefix.isBlank()) rankPrefix = team.getName();

                    StaffDetector.RankHit teamHit = StaffDetector.findRank(rankPrefix, host);
                    if (teamHit == null) continue;

                    for (String member : team.getPlayerList()) {
                        if (staff.size() >= maxRows.get()) break outer;
                        if (member == null || member.isBlank()) continue;

                        String lower = member.toLowerCase(Locale.ROOT);
                        if (tabNamesLower.contains(lower)) continue; 
                        if (seenNames.contains(lower)) continue;

                        if (containsIgnoreCase(excludeNames, member)) continue;
                        if (ignoreSelf && MC.player.getName().getString().equalsIgnoreCase(member)) continue;

                        if (vanishRequiresEntity.get() && !worldEntityNames.contains(lower)) continue;

                        seenNames.add(lower);
                        staff.add(new StaffEntry(member, teamHit.label + " V", teamHit.kind, Status.VANISH));
                    }
                }
            }
        }
    }

