        if (mc.player.distanceTo(rival) > 24.0) return false;
        return currentHealth() >= rivalHealth(rival);
    }

    private float rivalHealth(LivingEntity rival) {
        float hp = rival.getHealth();
        if (considerAbsorption.get()) hp += rival.getAbsorptionAmount();
        return hp;
    }

    private float currentHealth() {
        float hp = mc.player.getHealth();
        if (considerAbsorption.get()) hp += mc.player.getAbsorptionAmount();
        return hp;
    }

