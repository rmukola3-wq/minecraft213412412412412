        StaffBoardHud::new
    );

    private static final MinecraftClient MC = MinecraftClient.getInstance();

    private final List<StaffEntry> staff = new ArrayList<>();

    private final SettingGroup sgDetect = settings.createGroup("Detect");

    private final Setting<Boolean> showVanish = sgDetect.add(new BoolSetting.Builder()
        .name("show-vanish")
