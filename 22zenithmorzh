        double time = (System.currentTimeMillis() % 360_000L) / 1000.0;

        boolean prevDepth = event.renderer.triangles.depthTest;
        event.renderer.triangles.depthTest = !throughWalls;

        Color base = hurtColor(tint, hurt, fade);
        float halfWidth = 0.02f * width;
        float glowMul = 0.8f + glow * 0.6f;

        double cy = y + height * 0.52;
        float midR = entityWidth * (0.52f + 0.24f * radius);
        float hoopR = entityWidth * (0.6f + 0.3f * radius);
        float headR = midR * 0.5f;

        try {

            double breath = 1.0 + 0.05 * Math.sin(time * 1.7);
            drawFlatRing(event, cam, x, cy, z, midR * breath, MID_SEGMENTS, halfWidth, glowMul, base,
                time * speed * 2.0, time * speed * 1.3);

            drawFlatRing(event, cam, x, y + height * 0.9, z, headR, HEAD_SEGMENTS, halfWidth * 0.9f, glowMul, base,
                -time * speed * 3.0, time * speed * 0.9);

            double tilt = 1.15 + 0.16 * Math.sin(time * 0.8);
            double precess = time * speed * 1.1;
            drawHoop(event, cam, x, cy, z, hoopR, tilt, precess, HOOP_SEGMENTS, halfWidth, glowMul, base,
