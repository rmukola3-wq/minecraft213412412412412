        if (!canWalkInScreen() && !(mc.currentScreen instanceof InventoryScreen)) return;

        SlotActionType type = packet.getActionType();
        if (type == SlotActionType.PICKUP
            || type == SlotActionType.PICKUP_ALL
            || type == SlotActionType.CLONE
            || type == SlotActionType.QUICK_CRAFT) {
            rockstarPickup.add(packet);
