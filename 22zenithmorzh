        if (!showBox.get() || mc.player == null || serverPos == null) return;
        if (queue.isEmpty()) return;

        Color c = boxColor.get();
        Box box = mc.player.getBoundingBox().offset(serverPos.subtract(mc.player.getPos()));
        event.renderer.box(box.minX, box.minY, box.minZ, box.maxX, box.maxY, box.maxZ, c, c, ShapeMode.Both, 0);
