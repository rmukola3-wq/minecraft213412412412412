import dev.morzh.client.systems.modules.Categories;
import dev.morzh.client.systems.modules.Module;
import dev.morzh.client.utils.render.color.Color;
import dev.morzh.client.utils.render.color.SettingColor;
import meteordevelopment.orbit.EventHandler;
import net.minecraft.util.math.MathHelper;

public class PlayerRing extends Module {
    public enum RingMode {
        Circle,
        Octagon;

        @Override
        public String toString() {
            return switch (this) {
                case Circle -> "Круг";
                case Octagon -> "Восьмиугольник";
            };
        }
    }

    private final SettingGroup sg = settings.getDefaultGroup();

    private final Setting<RingMode> mode = sg.add(new EnumSetting.Builder<RingMode>()
        .name("форма")
        .defaultValue(RingMode.Circle)
        .build()
    );

    private final Setting<Boolean> themeSync = sg.add(new BoolSetting.Builder()
        .name("цвет-из-темы")
        .description("Брать цвета из модуля VisualTheme (основной + второй).")
        .defaultValue(true)
        .build()
    );

    private final Setting<SettingColor> color1 = sg.add(new ColorSetting.Builder()
        .name("цвет-1")
        .defaultValue(new SettingColor(70, 70, 85, 220))
        .visible(() -> !themeSync.get())
        .build()
    );

    private final Setting<SettingColor> color2 = sg.add(new ColorSetting.Builder()
        .name("цвет-2")
        .defaultValue(new SettingColor(35, 35, 50, 140))
        .visible(() -> !themeSync.get())
        .build()
    );

    private final Setting<Double> radius = sg.add(new DoubleSetting.Builder()
        .name("радиус")
        .defaultValue(1.0)
        .min(0.5)
        .sliderMax(4)
        .build()
    );

    private final Setting<Double> height = sg.add(new DoubleSetting.Builder()
        .name("высота")
        .description("Высота градиентной полоски.")
        .defaultValue(0.18)
        .min(0.05)
        .sliderMax(0.8)
        .build()
    );

    private final Setting<Double> lineWidth = sg.add(new DoubleSetting.Builder()
        .name("толщина")
        .defaultValue(1.5)
        .min(0.5)
        .sliderMax(4)
        .build()
    );

    private final Setting<Boolean> throughWalls = sg.add(new BoolSetting.Builder()
        .name("сквозь-стены")
        .defaultValue(false)
        .build()
    );

    private final Setting<Double> rotationSpeed = sg.add(new DoubleSetting.Builder()
        .name("скорость-вращения")
        .defaultValue(0.8)
        .min(0)
        .sliderMax(3)
        .build()
    );

    private float rotation;

    public PlayerRing() {
        super(Categories.Render, "player-ring", "Анимированное 3D-кольцо вокруг игрока (Soup/Rasty).");
    }

    @Override
    public void onDeactivate() {
        rotation = 0;
    }

    @EventHandler
    private void onRender3D(Render3DEvent event) {
        if (mc.player == null || mc.world == null) return;

        float delta = event.tickDelta;
        rotation += rotationSpeed.get().floatValue() * delta;
        if (rotation > 360f) rotation -= 360f;

        double px = MathHelper.lerp(delta, mc.player.lastRenderX, mc.player.getX());
        double py = MathHelper.lerp(delta, mc.player.lastRenderY, mc.player.getY()) + 0.02;
        double pz = MathHelper.lerp(delta, mc.player.lastRenderZ, mc.player.getZ());

        float r = radius.get().floatValue();
        float h = height.get().floatValue();
        int segments = mode.get() == RingMode.Octagon ? 8 : 64;
        double rotRad = Math.toRadians(rotation);
        boolean depth = throughWalls.get();

        boolean prevLineDepth = event.renderer.lines.depthTest;
        boolean prevTriDepth = event.renderer.triangles.depthTest;
        event.renderer.lines.depthTest = !depth;
        event.renderer.triangles.depthTest = !depth;

        for (int i = 0; i < segments; i++) {
            float t = (float) i / segments;
            float tNext = (float) (i + 1) / segments;

            double a1 = 2 * Math.PI * t + rotRad;
            double a2 = 2 * Math.PI * tNext + rotRad;

            float x1 = (float) (Math.cos(a1) * r);
            float z1 = (float) (Math.sin(a1) * r);
            float x2 = (float) (Math.cos(a2) * r);
            float z2 = (float) (Math.sin(a2) * r);

            float gradT = (float) (0.5 - 0.5 * Math.cos(t * Math.PI * 2));
            float gradTNext = (float) (0.5 - 0.5 * Math.cos(tNext * Math.PI * 2));

            SettingColor c1 = themeSync.get() && VisualTheme.themeActive()
                ? toSetting(VisualTheme.getColor(0)) : color1.get();
            SettingColor c2 = themeSync.get() && VisualTheme.themeActive()
                ? toSetting(VisualTheme.getColor(6)) : color2.get();

            Color top = lerp(c1, c2, gradT);
            Color topNext = lerp(c1, c2, gradTNext);
            Color bot = top.copy();
            bot.a = 0;
            Color botNext = topNext.copy();
            botNext.a = 0;

            double x1t = px + x1, z1t = pz + z1;
            double x2t = px + x2, z2t = pz + z2;

            event.renderer.quad(x1t, py, z1t, x2t, py, z2t, x2t, py - h, z2t, x1t, py - h, z1t, top, topNext, botNext, bot);
            Color line = top.copy();
            line.a = (int) (line.a * 0.9);
            Color lineNext = topNext.copy();
            lineNext.a = (int) (lineNext.a * 0.9);
            event.renderer.line(x1t, py, z1t, x2t, py, z2t, line, lineNext);
        }

        event.renderer.lines.depthTest = prevLineDepth;
        event.renderer.triangles.depthTest = prevTriDepth;
    }

    private static SettingColor toSetting(Color c) {
        return new SettingColor(c.r, c.g, c.b, c.a);
    }

    private static Color lerp(SettingColor a, SettingColor b, float t) {
        return new Color(
            (int) MathHelper.lerp(t, a.r, b.r),
            (int) MathHelper.lerp(t, a.g, b.g),
            (int) MathHelper.lerp(t, a.b, b.b),
            (int) MathHelper.lerp(t, a.a, b.a)
        );
    }
}

