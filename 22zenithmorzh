public final class HudAnim {

    public static class Smooth {
        private double value;
        private double target;
        private boolean started;

        public void set(double targetValue) {
            if (!started) {
                value = targetValue;
                target = targetValue;
                started = true;
            }
            target = targetValue;
        }

        public double get() {
            return value;
        }

        public void tick(double frameDelta, double speedPerSecond) {
            double alpha = 1.0 - Math.exp(-speedPerSecond * Math.max(0, frameDelta));
            value += (target - value) * alpha;
            if (Math.abs(target - value) < 0.01) value = target;
        }

        public boolean isMoving() {
            return Math.abs(target - value) >= 0.01;
        }
    }

    public static String fmtInt(double v) {
        return String.valueOf(Math.round(v));
    }

    private HudAnim() {}
}

