import java.io.File;
import java.io.IOException;
import java.nio.file.Files;
import java.util.ArrayList;
import java.util.Comparator;
import java.util.List;
import java.util.Locale;

public final class CfgManager {
    public static final File FOLDER = new File(MorzhClient.FOLDER, "cfgs");
    public static final int VERSION = 1;

    private CfgManager() {}

    public static void ensureFolder() {
        FOLDER.mkdirs();
    }

    public static String sanitize(String raw) {
        if (raw == null) return null;
        String name = raw.trim();
        if (name.regionMatches(true, name.length() - 4, ".cfg", 0, 4)) {
            name = name.substring(0, name.length() - 4);
        }
        name = name.trim();
        if (name.isEmpty()) return null;
        if (name.contains("..") || name.indexOf('/') >= 0 || name.indexOf('\\') >= 0) return null;

        StringBuilder out = new StringBuilder(name.length());
        for (int i = 0; i < name.length(); i++) {
            char c = name.charAt(i);
            if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')
                || c == '_' || c == '-' || c == '.' || c == ' ') {
                out.append(c);
            }
        }
        name = out.toString().trim();
        return name.isEmpty() ? null : name;
    }

    public static File file(String name) {
        String sanitized = sanitize(name);
        if (sanitized == null) return null;
        return new File(FOLDER, sanitized + ".cfg");
    }

    public static boolean exists(String name) {
        File file = file(name);
        return file != null && file.isFile();
    }

    public static List<String> list() {
        ensureFolder();
        File[] files = FOLDER.listFiles((dir, n) -> n.toLowerCase(Locale.ROOT).endsWith(".cfg"));
        List<String> names = new ArrayList<>();
        if (files == null) return names;
        List<File> sorted = new ArrayList<>(List.of(files));
        sorted.sort(Comparator.comparingLong(File::lastModified).reversed());
        for (File file : sorted) {
            String n = file.getName();
            names.add(n.substring(0, n.length() - 4));
        }
        return names;
    }

    public static boolean save(String name) {
        String sanitized = sanitize(name);
        File dest = file(sanitized);
        if (dest == null) return false;

        ensureFolder();
        NbtCompound tag = new NbtCompound();
        tag.putInt("version", VERSION);
        tag.putString("client", "morzh");
        tag.putString("name", sanitized);
        tag.putLong("created", System.currentTimeMillis());
        tag.put("modules", Modules.get().toTag());
        tag.put("hud", Hud.get().toTag());
        tag.put("macros", Macros.get().toTag());
        tag.put("friends", Friends.get().toTag());
        tag.put("config", Config.get().toTag());

        NbtCompound gui = new NbtCompound();
        if (GuiThemes.get() != null) {
            gui.putString("currentTheme", GuiThemes.get().name);
            NbtCompound themeTag = GuiThemes.get().toTag();
            if (themeTag != null) gui.put("theme", themeTag);
        }
        tag.put("gui", gui);

        try {
            File temp = File.createTempFile("morzh-cfg", ".cfg");
            NbtIo.write(tag, temp.toPath());
            StreamUtils.copy(temp, dest);
            temp.delete();
            return true;
        } catch (IOException e) {
            MorzhClient.LOG.error("Failed to save cfg {}", sanitized, e);
            return false;
        }
    }

    public static boolean load(String name) {
        File src = file(name);
        if (src == null || !src.isFile()) return false;

        try {
            NbtCompound tag = NbtIo.read(src.toPath());
            if (tag == null) return false;

            resetModuleSettings();

            if (tag.contains("modules")) Modules.get().fromTag(tag.getCompound("modules"));
            if (tag.contains("hud")) Hud.get().fromTag(tag.getCompound("hud"));
            if (tag.contains("macros")) Macros.get().fromTag(tag.getCompound("macros"));
            if (tag.contains("friends")) Friends.get().fromTag(tag.getCompound("friends"));
            if (tag.contains("config")) Config.get().fromTag(tag.getCompound("config"));

            if (tag.contains("gui")) {
                NbtCompound gui = tag.getCompound("gui");
                if (gui.contains("currentTheme")) GuiThemes.select(gui.getString("currentTheme"));
                if (gui.contains("theme") && GuiThemes.get() != null) {
                    GuiThemes.get().fromTag(gui.getCompound("theme"));
                }
                GuiThemes.save();
            }

            Systems.save();
            return true;
        } catch (IOException e) {
            MorzhClient.LOG.error("Failed to load cfg {}", name, e);
            return false;
        }
    }

    public static boolean delete(String name) {
        File src = file(name);
        if (src == null || !src.isFile()) return false;
        return src.delete();
    }

    public static boolean copy(String from, String to) {
        File src = file(from);
        File dest = file(to);
        if (src == null || dest == null || !src.isFile()) return false;
        ensureFolder();
        try {
            Files.copy(src.toPath(), dest.toPath(), java.nio.file.StandardCopyOption.REPLACE_EXISTING);
            return true;
        } catch (IOException e) {
            MorzhClient.LOG.error("Failed to copy cfg {} -> {}", from, to, e);
            return false;
        }
    }

    public static void openFolder() {
        ensureFolder();
        Util.getOperatingSystem().open(FOLDER);
    }

    private static void resetModuleSettings() {
        for (Module module : Modules.get().getList()) {
            for (SettingGroup group : module.settings) {
                for (Setting<?> setting : group) setting.reset();
            }
        }
    }
