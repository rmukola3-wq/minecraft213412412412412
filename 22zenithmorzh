    @EventHandler(priority = EventPriority.HIGHEST)
    private void onTick(TickEvent.Pre event) {
        if (mc.player == null || mc.world == null || mc.interactionManager == null) return;
        if (!(mc.player.currentScreenHandler instanceof PlayerScreenHandler)) return;

        totems = countTotems();

        boolean shouldHold = shouldHoldTotem();
        if (pauseOnEat.get() && mc.player.isUsingItem() && !shouldHold) return;

        locked = shouldHold && totems > 0;

        ItemStack offhand = mc.player.getOffHandStack();
        boolean offhandTotem = offhand.isOf(Items.TOTEM_OF_UNDYING);

        if (shouldHold) {
            if (offhandTotem) return;
            if (System.currentTimeMillis() - lastPopAt < popCooldown.get()) return;
            if (!canSwapNow()) return;

            int slot = findTotemSlot();
            if (slot == -1) return;

            if (swapBack.get() && previousSlot == -1 && !offhand.isEmpty() && !offhandTotem) {
                previousSlot = slot;
            }

            swapWithOffhand(slot);
            return;
        }

        if (swapBack.get() && previousSlot != -1 && (offhand.isEmpty() || offhandTotem)) {
            if (!canSwapNow() && profile.get() != Profile.Fast) return;
            swapWithOffhand(previousSlot);
            previousSlot = -1;
        }

        locked = false;
    }

    @EventHandler(priority = EventPriority.HIGH)
    private void onReceivePacket(PacketEvent.Receive event) {
        if (!(event.packet instanceof EntityStatusS2CPacket packet)) return;
        if (packet.getStatus() != 35) return;

        Entity entity = packet.getEntity(mc.world);
        if (entity == null || entity != mc.player) return;

        lastPopAt = System.currentTimeMillis();
        locked = true;
