package dev.morzh.client.commands.commands;

import com.mojang.brigadier.arguments.FloatArgumentType;
import com.mojang.brigadier.builder.LiteralArgumentBuilder;
import dev.morzh.client.MorzhClient;
import dev.morzh.client.commands.Command;
import dev.morzh.client.events.packets.PacketEvent;
import dev.morzh.client.events.world.TickEvent;
import dev.morzh.client.systems.modules.misc.delta.AutoBuyEntry;
import dev.morzh.client.systems.modules.misc.delta.FunTimeAh;
import meteordevelopment.orbit.EventHandler;
import net.minecraft.command.CommandSource;
import net.minecraft.item.Item;
import net.minecraft.item.ItemStack;
import net.minecraft.item.tooltip.TooltipType;
import net.minecraft.network.packet.s2c.play.InventoryS2CPacket;

import java.util.ArrayList;
import java.util.List;

public class AhCommand extends Command {
    private final List<CachedPrice> priceHistory = new ArrayList<>();
    private String pendingCommand;
    private SellRequest searchRequest;

    public AhCommand() {
        super("ah", "Поиск АХ и авто-выставление доната дешевле рынка (Delta).");
        MorzhClient.EVENT_BUS.subscribe(this);
    }

    @Override
    public void build(LiteralArgumentBuilder<CommandSource> builder) {
        builder.executes(context -> {
            if (mc.player == null || mc.player.networkHandler == null) return SINGLE_SUCCESS;
            ItemStack stack = mc.player.getMainHandStack();
            if (!stack.isEmpty()) {
                mc.player.networkHandler.sendChatCommand("ah search " + searchName(stack));
            }
            return SINGLE_SUCCESS;
        });

        builder.then(literal("sell").executes(context -> {
            startSell(0.0f);
            return SINGLE_SUCCESS;
        }).then(argument("percent", FloatArgumentType.floatArg(0.0f, 99.0f)).executes(context -> {
            startSell(FloatArgumentType.getFloat(context, "percent"));
            return SINGLE_SUCCESS;
        })));
    }

    @EventHandler
    private void onPacket(PacketEvent.Receive event) {
        if (searchRequest == null || pendingCommand != null) return;
        if (!(event.packet instanceof InventoryS2CPacket packet)) return;
        if (packet.getSyncId() == 0 || mc.player == null) return;

        List<ItemStack> contents = packet.getContents();
        int chestEnd = Math.max(0, contents.size() - 36);
        List<Integer> prices = contents.subList(0, chestEnd).stream()
            .filter(stack -> searchRequest.entry.a(stack) && stack.getTooltip(Item.TooltipContext.DEFAULT, mc.player, TooltipType.BASIC).stream()
                .noneMatch(line -> line.getString().contains("Нажмите, чтобы забрать")))
            .map(FunTimeAh::unitPrice)
            .filter(price -> price > 0)
            .sorted()
            .toList();

        if (!prices.isEmpty()) {
            int reference = prices.get(Math.min(2, prices.size() - 1));
            int cheapest = prices.stream()
                .filter(price -> price >= reference * 0.75d)
                .findFirst()
                .orElse(reference);
            priceHistory.removeIf(entry -> entry.entry == searchRequest.entry);
            priceHistory.add(new CachedPrice(searchRequest.entry, cheapest, System.currentTimeMillis()));
            listAt(searchRequest, cheapest);
        }
        searchRequest = null;
    }

    @EventHandler
    private void onTick(TickEvent.Pre event) {
        if (pendingCommand == null || mc.player == null || mc.player.networkHandler == null) return;
        if (mc.currentScreen != null) {
            mc.player.closeHandledScreen();
        } else {
            mc.player.networkHandler.sendChatCommand(pendingCommand);
            pendingCommand = null;
        }
    }

    private void startSell(float percent) {
        if (mc.player == null || mc.player.networkHandler == null) return;
        ItemStack stack = mc.player.getMainHandStack();
        AutoBuyEntry item = null;
        for (AutoBuyEntry entry : AutoBuyEntry.values()) {
            if (entry.a(stack)) {
                item = entry;
                break;
            }
        }
        if (item == null) {
            error("Авто-продажа недоступна для обычных предметов — только для донатных");
            return;
        }

        SellRequest request = new SellRequest(item, stack.getCount(), percent);
        long now = System.currentTimeMillis();
        CachedPrice cached = null;
        for (CachedPrice entry : priceHistory) {
            if (entry.entry == item && now - entry.at < 15000L) {
                cached = entry;
                break;
            }
        }
        if (cached != null) {
            listAt(request, cached.cheapest);
        } else {
            searchRequest = request;
            mc.player.networkHandler.sendChatCommand("ah search " + searchName(stack));
        }
    }

    private void listAt(SellRequest sell, int cheapest) {
        long price = Math.max(1L, Math.round(cheapest * (1.0d - sell.percent / 100.0d) * Math.max(1, sell.count)));
        info("Выставляю %s за %s (-%s%% от %s)", sell.entry.getDisplayName(), price, (int) sell.percent, cheapest);
        pendingCommand = "ah sell " + price;
    }

    private static String searchName(ItemStack stack) {
        String name = stack.getName().getString();
        name = name.replaceAll("(?i)\\bxxx\\b", "").replaceAll("[^\\p{L}\\p{N}\\s]", " ");
        name = name.replaceAll("\\[\\d+x\\d+]", "").replace("⚡", "").replace("xxx", "").replace("[", "").replace("]", "").replace("★", "");
        return name.trim().replaceAll("\\s+", " ");
    }

    private record SellRequest(AutoBuyEntry entry, int count, float percent) {
    }

    private record CachedPrice(AutoBuyEntry entry, int cheapest, long at) {
    }
}

