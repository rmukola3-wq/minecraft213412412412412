    private void renderScrollbar(
        MorzhGuiContext context,
        int left,
        int top,
        int viewport
    ) {
        int content = childrenHeight();

        if (content <= viewport) return;

        float thumbHeight = Math.max(
            8f,
            viewport * (viewport / (float) content)
        );

        float travel = viewport - thumbHeight;
        float progress = maxScroll() <= 0 ? 0f : -scroll / maxScroll();

        MorzhSmoothRenderer.roundedRect(
            context.draw,
            left + WIDTH - 2f,
            top + HEADER_HEIGHT + travel * MorzhAnimUtil.clamp01(progress),
            1.5f,
            thumbHeight,
            0.75f,
            context.fade(MorzhGuiColors.packed(MorzhGuiColors.ACCENT))
        );
    }

    public boolean isOverHeader(double mouseX, double mouseY) {
        int left = absoluteX();
        int top = absoluteY();

        return mouseX >= left
            && mouseX < left + WIDTH
            && mouseY >= top
            && mouseY < top + HEADER_HEIGHT;
    }

    public boolean isOverViewport(double mouseX, double mouseY) {
        int left = absoluteX();
        int top = absoluteY() + HEADER_HEIGHT;

        return mouseX >= left
            && mouseX < left + WIDTH
            && mouseY >= top
            && mouseY < top + viewportHeight();
    }

    @Override
    public boolean mouseClicked(double mouseX, double mouseY, int button) {
        if (isOverHeader(mouseX, mouseY)) {
            if (button == 0) {
                dragging = true;
                dragOffsetX = (int) mouseX - x();
                dragOffsetY = (int) mouseY - y();

                return true;
            }

            if (button == 1) {
                toggleExpanded();
                MorzhSoundManager.playBoolean();

                return true;
            }

            return false;
        }

        if (!isOverViewport(mouseX, mouseY)) return false;

        return super.mouseClicked(mouseX, mouseY, button);
    }

    @Override
    public boolean mouseDragged(double mouseX, double mouseY, int button) {
        if (dragging) {
            setX(
                MathHelper.clamp(
                    (int) mouseX - dragOffsetX,
                    0,
                    Math.max(0, screenWidth - WIDTH)
                )
            );

            setY(
                MathHelper.clamp(
                    (int) mouseY - dragOffsetY,
                    0,
                    Math.max(0, screenHeight - HEADER_HEIGHT)
                )
            );

            return true;
        }

        return super.mouseDragged(mouseX, mouseY, button);
    }

    @Override
    public void mouseReleased(double mouseX, double mouseY, int button) {
        dragging = false;

        super.mouseReleased(mouseX, mouseY, button);
    }

    public boolean mouseScrolled(double mouseX, double mouseY, double amount) {
        if (!isOverViewport(mouseX, mouseY)) return false;
        if (maxScroll() <= 0) return false;

        scrollTarget = MathHelper.clamp(
            scrollTarget + (float) amount * SCROLL_STEP,
            -maxScroll(),
            0f
        );

        MorzhSoundManager.playScroll();

        return true;
    }

    public void clampToScreen() {
        setX(MathHelper.clamp(x(), 0, Math.max(0, screenWidth - WIDTH)));
        setY(MathHelper.clamp(y(), 0, Math.max(0, screenHeight - HEADER_HEIGHT)));
    }
