    public ExpensiveAura() {
        super(Categories.Combat, "aura", "Main aura (Expensive). Silent rotations, FunTime/Grim/Delta/Neuro.", "expensive-aura");
    }

    public static ExpensiveAura get() {
        return Modules.get().get(ExpensiveAura.class);
    }

    @Override
    public void onActivate() {
        PlayerRotationManager.INSTANCE.ensureSubscribed();
        SlotSprintSync.ensureSubscribed();
        KillAura killAura = Modules.get().get(KillAura.class);
        if (killAura != null && killAura.isActive()) killAura.toggle();
        target = null;
        lastTarget = null;
        attackCooldown = 0;
        sprintTicks = 0;
        universalRotation.engine.reset();
        deltaRotation.reset();
        javelinRotation.reset();
        intpolRotation.reset();
        shard1Rotation.reset();
        shard2Rotation.reset();
    }

    @Override
    public void onDeactivate() {
        target = null;
        universalRotation.engine.reset();
        deltaRotation.reset();
        javelinRotation.reset();
        intpolRotation.reset();
        shard1Rotation.reset();
        shard2Rotation.reset();
        PlayerRotationManager.INSTANCE.cancelTasksFor(this);
        PlayerRotationManager.INSTANCE.clear();
        AngleConnection.INSTANCE.reset();
    }

    @EventHandler
    private void onTick(TickEvent.Pre event) {
        if (mc.world == null || mc.player == null) return;
        System.arraycopy(verticalCollisionHistory, 0, verticalCollisionHistory, 1, verticalCollisionHistory.length - 1);
        verticalCollisionHistory[0] = mc.player.verticalCollision;
        actionScheduler.cleanupIfFinished().update();
        if (isActive()) deltaRotation.tick();
        SlotSprintSync.tick();
    }

    @EventHandler
    private void onInteractItem(InteractItemEvent event) {
        if (!isActive() || mc.world == null || target == null) return;
        ItemStack main = mc.player.getMainHandStack();
        ItemStack off = mc.player.getOffHandStack();
        if (main.isOf(Items.FIREWORK_ROCKET) || off.isOf(Items.FIREWORK_ROCKET)) return;
        if (canCrit(mc.player, 0)) event.toReturn = ActionResult.FAIL;
    }

    @EventHandler
    private void onPacketSend(PacketEvent.Send event) {
        if (!isActive() || mc.world == null || target == null) return;
        if (event.packet instanceof HandSwingC2SPacket || event.packet instanceof UpdateSelectedSlotC2SPacket) {
            attackCooldown = Math.max(0, Math.round(getAttackDelay() * (tpsSync.get() ? 20.0f / FastMathUtils.clamp(TickRate.INSTANCE.getTickRate(), 1.0f, 20.0f) : 1.0f)));
        }
    }

    @EventHandler
    private void onPacketReceive(PacketEvent.Receive event) {
        if (!isActive() || mc.world == null || target == null) return;
        if (event.packet instanceof EntityStatusS2CPacket packet && packet.getStatus() == 30 && packet.getEntity(mc.world) == target) {
            ChatUtils.info("Сломал щит игроку " + target.getName().getString());
        }
    }

    @EventHandler(priority = EventPriority.HIGH)
    private void onRotationUpdate(RotationUpdateEvent event) {
        if (!isActive() || mc.world == null || mc.player == null) return;
        if (event.type == RotationUpdateEvent.Type.PRE) {
            updateRotation(mc.player, PlayerRotationManager.INSTANCE);
        } else {
            performAttack(mc.player, mc.interactionManager, PlayerRotationManager.INSTANCE);
        }
    }

    @EventHandler(priority = EventPriority.HIGH)
    private void onInput(PlayerInputEvent event) {
        if (!isActive() || mc.world == null || mc.player == null) return;
        MoveCorrectionMode mode = moveCorrectionMode.get();
        if (mode == MoveCorrectionMode.ZENITH_FREE) {
            applyZenithCorrection(event, mc.player.getYaw());
        } else if (mode == MoveCorrectionMode.ZENITH_FOCUS && target != null) {
            applyZenithCorrection(event, yawToZenithFocus());
        } else if (mode == MoveCorrectionMode.TARGET && target != null) {
            applyTargetCorrection(event);
        }
        if (shouldStopSprintProgression() && event.input.sprint()) {
            event.input = new net.minecraft.util.PlayerInput(
                event.input.forward(), event.input.backward(), event.input.left(), event.input.right(),
                event.input.jump(), event.input.sneak(), false
            );
        }
    }

    @EventHandler(priority = EventPriority.HIGH)
    private void onTickMovement(PlayerTickMovementEvent event) {
        if (!shouldStopSprintProgression() || mc.player == null) return;
        unsprintForHit(mc.player);
    }

    public void updateRotation(ClientPlayerEntity player, PlayerRotationManager rotationManager) {
        if (!isActive()) return;
        if (pauseForHeal.get() && isHealBlocking()) {

            rotationManager.cancelTasksFor(this);
            return;
        }
        target = findTarget(player, true);
        if (target == null) {
            if (effectiveRotationMode() == AuraRotationMode.UNIVERSAL) universalRotation.engine.reset();
            if (effectiveRotationMode() == AuraRotationMode.JAVELIN) javelinRotation.reset();
            if (effectiveRotationMode() == AuraRotationMode.INTPOL) intpolRotation.reset();
            if (isShard1()) {
                shard1Rotation.reset();
                rotationManager.releaseFor(this);
            }
            if (isShard2()) {
                shard2Rotation.reset();
                rotationManager.releaseFor(this);
            }
            if (effectiveRotationMode().deltaKeep()) deltaRotation.reset();
            return;
        }
        if (isShard1()) {
            rotationManager.releaseFor(this);
            lastTarget = target;
            return;
        }
        if (elytraLock()) {
            lastTarget = target;

            rotationManager.cancelTasksFor(this);
            rotationManager.releaseFor(this);
            return;
        }
        float range = isShard2() ? rotationRange(player) : lockRange(player);
        boolean elytra = elytraLock();
        Vec3d point = hitPointResolver.computeVector(
            target, range, rotationManager.getCurrentRotation(), getRotationMode().randomValue(), ignoreWalls.get() || elytra
        ).getLeft();
        Vec3d delta = point.subtract(player.getEyePos());
        Rotation targetRotation = RotationMath.INSTANCE.fromVec3d(delta);
        int keepTicks = effectiveRotationMode() == AuraRotationMode.GRIM ? 2
            : effectiveRotationMode() == AuraRotationMode.SHARD_2 ? 9
            : (effectiveRotationMode() == AuraRotationMode.FUNTIME || effectiveRotationMode() == AuraRotationMode.SPOOKYTIME
                || effectiveRotationMode() == AuraRotationMode.FUNTIME_R || effectiveRotationMode() == AuraRotationMode.SPOOKYTIME_R
                || effectiveRotationMode() == AuraRotationMode.JAVELIN
                || effectiveRotationMode() == AuraRotationMode.INTPOL
                || effectiveRotationMode() == AuraRotationMode.UNIVERSAL || effectiveRotationMode().deltaKeep()) ? 20
            : effectiveRotationMode().zenithKeepShort() ? 1
            : effectiveRotationMode().zenithSnapHold() ? 3 : 5;
        int attackLookahead = effectiveRotationMode() == AuraRotationMode.GRIM ? 4
            : effectiveRotationMode() == AuraRotationMode.SHARD_2 ? 0
            : (effectiveRotationMode() == AuraRotationMode.FUNTIME || effectiveRotationMode() == AuraRotationMode.SPOOKYTIME
                || effectiveRotationMode() == AuraRotationMode.FUNTIME_R || effectiveRotationMode() == AuraRotationMode.SPOOKYTIME_R) ? 5 : 0;
        if (effectiveRotationMode() == AuraRotationMode.Z_SNAP && !canAttack(player, 0) && !canAttack(player, 1)) {
            lastTarget = target;
            return;
        }
        if (attackLookahead > 0 && !canAttack(player, attackLookahead)) {
            lastTarget = target;
            return;
        }
        rotationManager.scheduleRotation(
            new RotationVector(targetRotation, delta),
            target,
            new RotationConfig(
                getRotationMode(),
                false,
                !isShard1() && moveCorrectionMode.get().moveCorrection(),
                !isShard1() && moveCorrectionMode.get().focusedCorrection()
            ),
            1,
            this,
            keepTicks
        );
        lastTarget = target;
    }

    public void configureShard2Engine(Shard2StrikeEngine engine) {
        engine.configure(
            shard2Pull.get().floatValue(),
            shard2HitSteps.get()
        );
    }

    public void performAttack(ClientPlayerEntity player, ClientPlayerInteractionManager interactionManager, PlayerRotationManager rotationManager) {
        if (attackCooldown > 0) attackCooldown--;
        if (sprintTicks > 0) sprintTicks--;
        if (!isActive() || target == null) return;
        if (pauseForHeal.get() && isHealBlocking()) return;
        if (isShard1()) {
            performShard1Attack(player, interactionManager, rotationManager);
            return;
        }
        if (isShard2()) {
            performShard2Attack(player, interactionManager, rotationManager);
            return;
        }
        if (elytraLock()) {
            performElytraAttack(player, interactionManager, rotationManager);
            return;
        }
        float range = attackRange(player);
        Box hitBox = target.getBoundingBox();
        Rotation look = rotationManager.getCurrentRotation();
        Rotation prev = rotationManager.getPreviousRotation();
        boolean ray = WorldRaycastUtils.rayTrace(
            hitPointResolver,
            target,
            player.getEyePos(),
            RotationMath.INSTANCE.rotationToVector(look),
            range,
            hitBox,
            ignoreWalls.get()
        );
        if (!ray && effectiveRotationMode() == AuraRotationMode.JAVELIN) {
            ray = WorldRaycastUtils.grimLooksHit(
                look.getYaw(), look.getPitch(),
                prev.getYaw(), prev.getPitch(),
                range, hitBox
            ) && hitPointResolver.hasValidPoint(target, range, ignoreWalls.get());
        }
        if (ray && canAttack(player, 1)) {
            sprintTicks = 1;
            unsprintForHit(player);
            if (unpressShield.get() && player.isUsingItem() && player.getActiveItem().getItem() == Items.SHIELD && mc.options.useKey.isPressed() && actionScheduler.isFinished()) {
                interactionManager.stopUsingItem(player);
                mc.options.useKey.setPressed(false);
                actionScheduler.cleanup().addTickStep(1, () -> mc.options.useKey.setPressed(true));
            }
        }
        if (ray && canAttack(player, 0)) {
            executeAttack(player, interactionManager, rotationManager, false);
        }
    }

    private void performElytraAttack(ClientPlayerEntity player, ClientPlayerInteractionManager interactionManager, PlayerRotationManager rotationManager) {
        float range = elytraMeleeRange(player);
        ElytraTarget elytra = ElytraTarget.getInstance();

        Box predictedBox = elytra != null ? elytra.getPredictedBox(target) : null;
        Box hitBox = predictedBox != null ? predictedBox : target.getBoundingBox();

        Vec3d eyes = player.getEyePos();

        Vec3d aimCenter = hitBox.getCenter();
        Rotation exact = RotationMath.INSTANCE.fromVec3d(aimCenter.subtract(eyes));
        float yaw = exact.getYaw();
        float pitch = exact.getPitch();
        Rotation prev = rotationManager.getPreviousRotation();

        if (player.distanceTo(target) > range + 0.05f) return;

        boolean ray = WorldRaycastUtils.grimLooksHit(yaw, pitch, prev.getYaw(), prev.getPitch(), range, hitBox)
            || WorldRaycastUtils.lookHits(yaw, pitch, range, hitBox);

        boolean noRay = predictedBox != null
            && predictedBox.getCenter().squaredDistanceTo(player.getBoundingBox().getCenter()) < 16.0;
        if (!ray && !noRay) return;

        if (canAttack(player, 1)) {
            sprintTicks = 1;
            unsprintForHit(player);
            if (unpressShield.get() && player.isUsingItem() && player.getActiveItem().getItem() == Items.SHIELD && mc.options.useKey.isPressed() && actionScheduler.isFinished()) {
                interactionManager.stopUsingItem(player);
                mc.options.useKey.setPressed(false);
                actionScheduler.cleanup().addTickStep(1, () -> mc.options.useKey.setPressed(true));
            }
        }
        if (canAttack(player, 0)) {

            executeAttack(player, interactionManager, rotationManager, false);
        }
    }

    private float elytraMeleeRange(ClientPlayerEntity player) {
        ElytraTarget elytra = ElytraTarget.getInstance();
        float override = elytra != null && elytra.isActive() && target != null ? elytra.overrideRange(target) : 3.0f;
        return Math.min(attackRange(player), override);
    }

    private void performShard1Attack(ClientPlayerEntity player, ClientPlayerInteractionManager interactionManager, PlayerRotationManager rotationManager) {
        float range = attackRange(player);
        Box hitBox = target.getBoundingBox().expand(shard1HitboxExpand.get().floatValue());
        Rotation look = Rotation.playerRotation();
        Rotation prev = rotationManager.getPreviousRotation();
        if (canAttack(player, 0)) {
            Vec3d eyes = player.getEyePos();
            float aimAngle = shard1Rotation.engine().aimAngle(eyes, target);
            boolean melee = player.distanceTo(target) <= range + 0.4F;
            if (aimAngle <= shard1AimCone.get() || melee) {
                Rotation micro = shard1Rotation.engine().microAim(
                    look, target, range, shard1HitboxExpand.get().floatValue(), shard1MicroSteps.get()
                );
                if (micro.angleTo(look) > 0.2F) {
                    rotationManager.applyStrike(micro, false);
                }
                look = micro;
            }
        }
        boolean ray = WorldRaycastUtils.lookHits(look.getYaw(), look.getPitch(), range, hitBox);
        if (!ray) {
            ray = WorldRaycastUtils.grimLooksHit(
                look.getYaw(), look.getPitch(),
                prev.getYaw(), prev.getPitch(),
                range, hitBox
            );
            if (!ray) {
                ray = WorldRaycastUtils.deltaAimHits(look.getYaw(), look.getPitch(), range, target, ignoreWalls.get());
            }
            if (!ray && player.distanceTo(target) <= range + 0.45F) {
                ray = shardInRange(target, player, range, ignoreWalls.get());
            }
        }
        if (ray && canAttack(player, 1)) {
            sprintTicks = 1;
            unsprintForHit(player);
            if (unpressShield.get() && player.isUsingItem() && player.getActiveItem().getItem() == Items.SHIELD && mc.options.useKey.isPressed() && actionScheduler.isFinished()) {
                interactionManager.stopUsingItem(player);
                mc.options.useKey.setPressed(false);
                actionScheduler.cleanup().addTickStep(1, () -> mc.options.useKey.setPressed(true));
            }
        }
        if (ray && canAttack(player, 0)) {
            Vec3d eyes = player.getEyePos();
            float aimAngle = shard1Rotation.engine().aimAngle(eyes, target);
            boolean melee = player.distanceTo(target) <= range + 0.4F;
            if (aimAngle > shard1AimCone.get() && !melee) return;
            executeAttack(player, interactionManager, rotationManager, true);
        }
    }

    private void performShard2Attack(ClientPlayerEntity player, ClientPlayerInteractionManager interactionManager, PlayerRotationManager rotationManager) {
        float range = attackRange(player);
        Box hitBox = target.getBoundingBox().expand(shard2HitboxExpand.get().floatValue());
        Rotation look = rotationManager.getCurrentRotation();
        Rotation prev = rotationManager.getPreviousRotation();
        Shard2StrikeEngine engine = shard2Rotation.engine();
        configureShard2Engine(engine);
        if (canAttack(player, 0)) {
            Rotation finished = engine.critFinish(look, target, range);
            if (finished.angleTo(look) > 0.01F) {
                rotationManager.applyStrike(finished, false);
            }
            look = finished;
        }
        boolean ray = WorldRaycastUtils.lookHits(look.getYaw(), look.getPitch(), range, hitBox);
        if (!ray && canAttack(player, 0)) {
            ray = WorldRaycastUtils.grimLooksHit(
                look.getYaw(), look.getPitch(),
                prev.getYaw(), prev.getPitch(),
                range, hitBox
            );
        }
        if (ray && canAttack(player, 1)) {
            sprintTicks = 1;
            unsprintForHit(player);
            if (unpressShield.get() && player.isUsingItem() && player.getActiveItem().getItem() == Items.SHIELD && mc.options.useKey.isPressed() && actionScheduler.isFinished()) {
                interactionManager.stopUsingItem(player);
                mc.options.useKey.setPressed(false);
                actionScheduler.cleanup().addTickStep(1, () -> mc.options.useKey.setPressed(true));
            }
        }
        if (ray && canAttack(player, 0)) {
            if (shard2PacketSync.get()) {
                player.networkHandler.sendPacket(new PlayerMoveC2SPacket.Full(
                    player.getX(), player.getY(), player.getZ(),
                    look.getYaw(), look.getPitch(),
                    player.isOnGround(), player.horizontalCollision
                ));
            }
            executeAttack(player, interactionManager, rotationManager, false);
        }
    }

    private void executeAttack(ClientPlayerEntity player, ClientPlayerInteractionManager interactionManager, PlayerRotationManager rotationManager, boolean shardRelease) {
        SlotSprintSync.ensureSubscribed();
        if (SlotSprintSync.lastSprinting) {
            sprintTicks = 1;
            SlotSprintSync.delayHitUntilUnsprinted();
            if (!shardRelease) return;
        }
        if (elytraLock()) ensureElytraWeapon(player);
        interactionManager.attackEntity(player, target);
        player.swingHand(Hand.MAIN_HAND);
        breakShieldWithAxe(player, interactionManager);
        hitCounter++;
        attackTimer.reset();
        deltaRotation.onHit();
        if (shardRelease) {
            rotationManager.releaseFor(this);
        }
    }

    public boolean shouldStopSprintProgression() {
        if (!isActive() || sprintTicks <= 0 || target == null || mc.player == null || mc.player.input == null) return false;
        return mc.player.input.movementForward != 0.0f || mc.player.input.movementSideways != 0.0f;
    }

    public void unsprintForHit(ClientPlayerEntity player) {
        SlotSprintSync.ensureSubscribed();
        SlotSprintSync.unsprintQuiet();
    }

    public void breakShieldWithAxe(ClientPlayerEntity player, ClientPlayerInteractionManager interactionManager) {
        if (!breakShield.get() || target == null) return;
        if (target.getActiveItem().getItem() != Items.SHIELD || !isActiveItemStackBlocking(target, 2)) return;

        FindItemResult axe = InvUtils.findInHotbar(stack -> stack.getItem() instanceof AxeItem);
        if (!axe.found() || !axe.isHotbar()) return;
        InvUtils.swap(axe.slot(), true);
        interactionManager.attackEntity(player, target);
        player.swingHand(Hand.MAIN_HAND);
        InvUtils.swapBack();
    }

    public boolean isActiveItemStackBlocking(LivingEntity entity, int minUseTicks) {
        if (!entity.isUsingItem() || entity.getActiveItem().isEmpty()) return false;
        Item item = entity.getActiveItem().getItem();
        return item.getUseAction(entity.getActiveItem()) == UseAction.BLOCK
            && item.getMaxUseTime(entity.getActiveItem(), entity) - entity.getItemUseTimeLeft() >= minUseTicks;
    }

    public RotationMode getRotationMode() {
        return switch (effectiveRotationMode()) {
            case FUNTIME -> new FuntimeRotationMode();
            case SPOOKYTIME -> new SpookytimeRotationMode();
            case SMOOTH -> new SmoothRotationMode();
            case GRIM, NONE -> new GrimRotationMode();
            case NEURO -> new NeuroRotationMode();
            case UNIVERSAL -> universalRotation;
            case FUNTIME_D -> deltaRotation.funtime;
            case FUNTIME_FOV -> deltaRotation.funtimeFov;
            case LEGIT_D -> deltaRotation.legit;
            case Z_FUNTIME -> new ZenithRotationMode(ZenithRotationMode.Kind.FUNTIME);
            case Z_SPOOKYTIME -> new ZenithRotationMode(ZenithRotationMode.Kind.SPOOKY);
            case Z_HOLYWORLD -> new ZenithRotationMode(ZenithRotationMode.Kind.HOLYWORLD);
            case Z_LEGIT -> new ZenithRotationMode(ZenithRotationMode.Kind.LEGIT);
            case Z_SNAP -> new ZenithRotationMode(ZenithRotationMode.Kind.SNAP);
            case Z_HVH -> new ZenithRotationMode(ZenithRotationMode.Kind.HVH);
            case FUNTIME_R -> funTimeRRotation;
            case SPOOKYTIME_R -> spookyTimeRRotation;
            case JAVELIN -> javelinRotation;
            case ELYRA_TARGET -> elytraTargetRotation;
