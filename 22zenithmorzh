package dev.morzh.client.gui.screens;

import dev.morzh.client.systems.modules.Modules;
import dev.morzh.client.systems.modules.combat.AutoSwap;
import net.minecraft.client.gui.DrawContext;
import net.minecraft.client.gui.screen.Screen;
import net.minecraft.client.gui.screen.ingame.InventoryScreen;
import net.minecraft.client.render.BufferBuilder;
import net.minecraft.client.render.BufferRenderer;
import net.minecraft.client.render.Tessellator;
import net.minecraft.client.render.VertexFormat;
import net.minecraft.client.render.VertexFormats;
import net.minecraft.client.gl.ShaderProgramKeys;
import net.minecraft.item.ItemStack;
import net.minecraft.text.Text;
import com.mojang.blaze3d.systems.RenderSystem;
import org.joml.Matrix4f;
import org.lwjgl.glfw.GLFW;

public class SwapRadialScreen extends Screen {
    private static final float INNER = 75f;
    private static final float OUTER = 101.25f;
    private static final int SLICES = 3;

    public SwapRadialScreen() {
        super(Text.literal("SwapMenu"));
    }

    @Override
    public boolean shouldPause() {
        return false;
    }

    @Override
    public void renderBackground(DrawContext context, int mouseX, int mouseY, float delta) {
    }

    @Override
    public void render(DrawContext context, int mouseX, int mouseY, float delta) {
        AutoSwap swap = module();
        if (swap == null) return;
        float cx = width / 2f;
        float cy = height / 2f;
        int hovered = hoverSlice(mouseX, mouseY, cx, cy);

        for (int i = 0; i < SLICES; i++) {
            double start = -Math.PI / 2 + (Math.PI * 2 / SLICES) * i;
            double end = start + Math.PI * 2 / SLICES;
            int color = i == hovered ? 0x88FFFFFF : 0x50808080;
            drawSlice(context, cx, cy, INNER, OUTER, start + 0.02, end - 0.02, color);
            double mid = (start + end) / 2;
            float ix = cx + (float) Math.cos(mid) * ((INNER + OUTER) / 2f);
            float iy = cy + (float) Math.sin(mid) * ((INNER + OUTER) / 2f);
            ItemStack stack = swap.radial(i);
            if (stack.isEmpty()) {
                context.drawCenteredTextWithShadow(textRenderer, "+", (int) ix, (int) iy - 4, 0xFFFFFFFF);
            } else {
                context.drawItem(stack, (int) ix - 8, (int) iy - 8);
            }
        }

        if (hovered >= 0 && !swap.radial(hovered).isEmpty()) {
            context.drawCenteredTextWithShadow(textRenderer, swap.radial(hovered).getName(), width / 2, (int) (cy + OUTER + 10), 0xFFFFFFFF);
        }
    }

    @Override
    public boolean mouseClicked(double mouseX, double mouseY, int button) {
        AutoSwap swap = module();
        if (swap == null) return false;
        int slot = hoverSlice(mouseX, mouseY, width / 2.0, height / 2.0);
        if (slot < 0) return false;

        if (button == GLFW.GLFW_MOUSE_BUTTON_RIGHT) {
            swap.setRadial(slot, ItemStack.EMPTY);
            return true;
        }
        if (button != GLFW.GLFW_MOUSE_BUTTON_LEFT) return false;

        ItemStack stack = swap.radial(slot);
        if (stack.isEmpty()) {
            swap.beginPick(slot);
            if (client != null && client.player != null) client.setScreen(new InventoryScreen(client.player));
        } else {
            swap.moveToOffhand(stack);
            close();
        }
        return true;
    }

    private int hoverSlice(double mouseX, double mouseY, double cx, double cy) {
        double dist = Math.hypot(mouseX - cx, mouseY - cy);
        if (dist < INNER * 0.25) return -1;
        double angle = Math.atan2(mouseY - cy, mouseX - cx) + Math.PI / 2;
        if (angle < 0) angle += Math.PI * 2;
        return Math.min((int) (angle / (Math.PI * 2 / SLICES)), SLICES - 1);
    }

    private void drawSlice(DrawContext context, float cx, float cy, float inner, float outer, double start, double end, int argb) {
        float a = ((argb >> 24) & 255) / 255f;
        float r = ((argb >> 16) & 255) / 255f;
        float g = ((argb >> 8) & 255) / 255f;
        float b = (argb & 255) / 255f;
        Matrix4f matrix = context.getMatrices().peek().getPositionMatrix();
        RenderSystem.enableBlend();
        RenderSystem.defaultBlendFunc();
        RenderSystem.setShader(ShaderProgramKeys.POSITION_COLOR);
        BufferBuilder buf = Tessellator.getInstance().begin(VertexFormat.DrawMode.TRIANGLE_STRIP, VertexFormats.POSITION_COLOR);
        int steps = 32;
        for (int i = 0; i <= steps; i++) {
            double t = start + (end - start) * i / steps;
            float cos = (float) Math.cos(t);
            float sin = (float) Math.sin(t);
            buf.vertex(matrix, cx + cos * outer, cy + sin * outer, 0).color(r, g, b, a);
            buf.vertex(matrix, cx + cos * inner, cy + sin * inner, 0).color(r, g, b, a);
        }
        BufferRenderer.drawWithGlobalProgram(buf.end());
        RenderSystem.disableBlend();
    }

    private AutoSwap module() {
        return Modules.get() == null ? null : Modules.get().get(AutoSwap.class);
    }
}

