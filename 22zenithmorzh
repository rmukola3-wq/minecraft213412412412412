            value,
            left + width() - PADDING - valueWidth,
            top + 2f,
            valueColor(context),
            false
        );

        float trackX = trackX();
        float trackWidth = trackWidth();
        float trackY = top + height() - TRACK_HEIGHT - 4f;

        MorzhSmoothRenderer.roundedRect(
            context.draw,
            trackX,
            trackY,
            trackWidth,
            TRACK_HEIGHT,
            TRACK_HEIGHT / 2f,
            context.fade(MorzhGuiColors.packed(MorzhGuiColors.SLIDER_TRACK))
        );

        float filled = trackWidth * MorzhAnimUtil.clamp01(fillProgress);

        if (filled > 0.5f) {
            MorzhSmoothRenderer.roundedRect(
                context.draw,
                trackX,
                trackY,
                filled,
                TRACK_HEIGHT,
                TRACK_HEIGHT / 2f,
                context.fade(MorzhGuiColors.packed(MorzhGuiColors.SLIDER_FILL))
            );
        }

        MorzhSmoothRenderer.circle(
            context.draw,
            trackX + filled,
            trackY + TRACK_HEIGHT / 2f,
            KNOB_RADIUS,
            context.fade(MorzhGuiColors.packed(MorzhGuiColors.ACCENT_LIGHT))
        );

        offerTooltip(context);
    }

    @Override
    public boolean mouseClicked(double mouseX, double mouseY, int button) {
        if (button != 0 || !isHovered(mouseX, mouseY)) return false;

        dragging = true;
        applyFromMouse(mouseX);
        MorzhSoundManager.playScroll();

        return true;
    }

    @Override
    public boolean mouseDragged(double mouseX, double mouseY, int button) {
        if (!dragging) return false;

        applyFromMouse(mouseX);

        return true;
    }

    @Override
    public void mouseReleased(double mouseX, double mouseY, int button) {
        dragging = false;
    }

    private float trackX() {
        return absoluteX() + PADDING;
    }

    private float trackWidth() {
        return Math.max(1f, width() - PADDING * 2f);
    }

    private void applyFromMouse(double mouseX) {
        double ratio = MathHelper.clamp(
            (mouseX - trackX()) / trackWidth(),
            0,
            1
        );

        if (setting instanceof IntSetting intSetting) {
            int value = (int) Math.round(
                intSetting.sliderMin
                    + (intSetting.sliderMax - intSetting.sliderMin) * ratio
            );

            intSetting.set(
                MathHelper.clamp(value, intSetting.min, intSetting.max)
            );
        }
        else if (setting instanceof DoubleSetting doubleSetting) {
            double value = doubleSetting.sliderMin
                + (doubleSetting.sliderMax - doubleSetting.sliderMin) * ratio;

            double step = Math.pow(10, doubleSetting.decimalPlaces);
            value = Math.round(value * step) / step;

            doubleSetting.set(
                MathHelper.clamp(value, doubleSetting.min, doubleSetting.max)
            );
        }
