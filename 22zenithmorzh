            String host,
            String glyph,
            String label,
            String kind
        ) {
            this.host = host;
            this.glyph = glyph;
            this.label = label;
            this.kind = kind;
        }
    }

    public static class RankHit {

        public final String label;
        public final String kind;
        public final String source;

        public RankHit(
            String label,
            String kind,
            String source
        ) {
            this.label = label;
            this.kind = kind;
            this.source = source;
        }
    }
}

