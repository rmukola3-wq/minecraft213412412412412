    private int breakStage;
    private int breakWait;
    private int swordSlot = -1;
    private double trackedFall;
    private double lastY;
    private boolean yInitialized;
    private int ticksOnGround;
    private LivingEntity target;
    private int hitDelay;
    private int afterHitDelay;
    private float cooldownJitter;
    private double expandJitter;
    private double critFallJitter;
    private int smartGroundTicks;

    public TriggerBot() {
        super(Categories.Combat, "trigger-bot", "Бьёт цель под прицелом, ловит крит в прыжке и в 2 блоках.");
    }

    @Override
    public void onDeactivate() {
        abortBreak();
        trackedFall = 0.0;
        yInitialized = false;
        ticksOnGround = 0;
        hitDelay = 0;
        afterHitDelay = 0;
        target = null;
    }

    public LivingEntity getTarget() {
        return target != null && isValid(target) ? target : null;
    }

    @EventHandler
    private void onTick(TickEvent.Post event) {
        if (mc.player == null || mc.world == null || mc.interactionManager == null || mc.currentScreen != null) {
            target = null;
            return;
        }

        updateTrackedFall();

        if (pauseAura.get()) {
            KillAura aura = Modules.get().get(KillAura.class);
            if (aura != null && aura.isActive() && aura.getTarget() != null) {
                abortBreak();
                target = null;
                return;
            }
        }

        if (breakStage > 0) {
            tickShieldBreak();
            return;
        }

        LivingEntity aimed = resolveAimed();
        target = aimed;

        if (aimed == null) return;
        if (noHitWhileShield.get() && holdingShield()) return;

        if (legitShieldBreak.get() && aimed.isBlocking()) {
            startShieldBreak();
            return;
        }

        if (swordOnly.get() && !holdingSword()) {
            hitDelay = 0;
            return;
        }

        ThreadLocalRandom random = ThreadLocalRandom.current();
        if (afterHitDelay > 0) {
            afterHitDelay--;
            return;
        }

        if (mc.player.getAttackCooldownProgress(0.5f) < neededCooldown(random)) {
            hitDelay = 0;
            return;
        }
        if (onlyCrits.get() && !canCrit()) {
            hitDelay = 0;
            return;
        }

        if (hitDelay <= 0) {
            hitDelay = random.nextInt(0, 3);
            if (random.nextFloat() < 0.11F) hitDelay += random.nextInt(1, 3);
        }
        if (hitDelay > 0) {
            hitDelay--;
            if (hitDelay > 0) return;
        }

        if (random.nextFloat() < 0.08F) {
            hitDelay = random.nextInt(1, 3);
            return;
        }

        mc.interactionManager.attackEntity(mc.player, aimed);
        mc.player.swingHand(Hand.MAIN_HAND);
        afterHitDelay = random.nextInt(0, 3);
        rerollJitter(random);
    }

    private float neededCooldown(ThreadLocalRandom random) {
        if (cooldownJitter == 0.0F) rerollJitter(random);
        return MathHelper.clamp(cooldown.get().floatValue() + cooldownJitter, 0.78F, 1.0F);
    }

    private void rerollJitter(ThreadLocalRandom random) {
        cooldownJitter = random.nextFloat(-0.05F, 0.07F);
        expandJitter = random.nextDouble(-0.04, 0.05);
        critFallJitter = random.nextDouble(-0.03, 0.05);
        smartGroundTicks = random.nextInt(4, 8);
    }

    private void updateTrackedFall() {
        double currentY = mc.player.getY();
        if (!yInitialized) {
            yInitialized = true;
            lastY = currentY;
            trackedFall = 0.0;
            return;
        }

        double movementY = currentY - lastY;
        lastY = currentY;

        if (mc.player.isOnGround() || mc.player.isClimbing() || mc.player.hasVehicle()) {
            ticksOnGround++;
            trackedFall = 0.0;
            return;
        }

        ticksOnGround = 0;

        if (movementY < 0.0) {
            trackedFall += -movementY;
        } else if (movementY > 0.0) {
            trackedFall = 0.0;
        }
    }

    private boolean canCrit() {
        if (cannotCritAnyway()) return true;

        if (smartCrits.get()
            && mc.player.isOnGround()
            && !mc.options.jumpKey.isPressed()
            && ticksOnGround >= (smartGroundTicks > 0 ? smartGroundTicks : 5)) {
