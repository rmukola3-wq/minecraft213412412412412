        }
        FindItemResult found = InvUtils.find(item);
        if (!found.found()) {
            ChatUtils.errorPrefix("Binds", name + " — нет в инвентаре");
            return;
        }
        int previous = mc.player.getInventory().selectedSlot;
        if (found.getHand() == Hand.OFF_HAND) {
