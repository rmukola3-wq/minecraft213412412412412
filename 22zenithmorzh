import static dev.morzh.client.MorzhClient.mc;

public final class AuraRotationSolver {

    public static final float MAX_SAFE_YAW_DELTA = 300.0f;

    private float yaw;
    private float pitch;
    private boolean synced;

    private float pitchStep = 1.0f;
    private float lastYaw;
    private float lastPitch;

    public void reset(ClientPlayerEntity player) {
        synced = false;
        pitchStep = 1.0f;

        if (player != null) sync(player);
    }

    public void sync(ClientPlayerEntity player) {
        if (player == null) return;

        yaw = player.getYaw();
        pitch = player.getPitch();

        lastYaw = yaw;
        lastPitch = pitch;

        synced = true;
    }

    public void setState(float yaw, float pitch) {
        this.yaw = yaw;
        this.pitch = MathHelper.clamp(pitch, -90.0f, 90.0f);

        this.lastYaw = this.yaw;
        this.lastPitch = this.pitch;

        synced = true;
    }

    public boolean isSynced() {
        return synced;
    }

    public float getYaw() {
        return yaw;
    }

    public float getPitch() {
        return pitch;
    }

    public float getLastYaw() {
        return lastYaw;
    }

    public float getLastPitch() {
        return lastPitch;
    }

    public static float gcd() {
        double factor =
            mc.options.getMouseSensitivity().getValue() * 0.6 + 0.2;

        return (float) (factor * factor * factor * 1.2);
    }

    public static float remainder(float delta) {
        float gcd = gcd();

        if (gcd <= 0.0f) return delta;

        return delta - delta % gcd;
    }

    public static float quantize(float delta) {
        float gcd = gcd();

        if (gcd <= 0.0f) return delta;

        return Math.round(delta / gcd) * gcd;
    }

    public static float[] anglesTo(Vec3d eyes, Vec3d point) {
        double differenceX = point.x - eyes.x;
        double differenceY = point.y - eyes.y;
        double differenceZ = point.z - eyes.z;

        double horizontalDistance = Math.sqrt(
            differenceX * differenceX
                + differenceZ * differenceZ
        );

        float yaw = (float) (
            Math.toDegrees(
                Math.atan2(differenceZ, differenceX)
            ) - 90
        );

        float pitch = MathHelper.clamp(
            (float) -Math.toDegrees(
                Math.atan2(differenceY, horizontalDistance)
            ),
            -90,
            90
        );

        return new float[]{yaw, pitch};
    }

    public void step(
        float targetYaw,
        float targetPitch,
        float maximumYawStep,
        float maximumPitchStep,
        boolean gcdAlign
    ) {
        step(targetYaw, targetPitch, maximumYawStep, maximumPitchStep, gcdAlign, true);
    }

    public void step(
        float targetYaw,
        float targetPitch,
        float maximumYawStep,
        float maximumPitchStep,
        boolean gcdAlign,
        boolean remainderGcd
    ) {
        lastYaw = yaw;
        lastPitch = pitch;

        float yawDelta = MathHelper.clamp(
            MathHelper.wrapDegrees(targetYaw - yaw),
            -Math.min(maximumYawStep, MAX_SAFE_YAW_DELTA),
            Math.min(maximumYawStep, MAX_SAFE_YAW_DELTA)
        );

        float pitchDelta = MathHelper.clamp(
            MathHelper.clamp(targetPitch, -90, 90) - pitch,
            -maximumPitchStep,
            maximumPitchStep
        );

        if (gcdAlign) {
            yawDelta = remainderGcd ? remainder(yawDelta) : quantize(yawDelta);
            pitchDelta = remainderGcd ? remainder(pitchDelta) : quantize(pitchDelta);
        }

        yaw += yawDelta;

        pitch = MathHelper.clamp(
            pitch + pitchDelta,
            -90.0f,
            90.0f
        );

        synced = true;
    }

    public boolean changedThisStep() {
        return Math.abs(yaw - lastYaw) > 1.0E-4f
            || Math.abs(pitch - lastPitch) > 1.0E-4f;
    }

    public float nextPitchStep(
        boolean onTarget,
        float aimedStep,
        float maximumStep,
        float accelerate
    ) {
        if (onTarget) {
            pitchStep = aimedStep;
        } else if (pitchStep < maximumStep) {
            pitchStep = Math.min(
                maximumStep,
                Math.max(0.05f, pitchStep) * accelerate
            );
        } else {
            pitchStep = maximumStep;
        }

        float jitter = (float) ThreadLocalRandom.current()
            .nextDouble(-0.35, 0.35);

        return Math.max(0.05f, pitchStep + jitter);
    }

    public static float randomBetween(float minimum, float maximum) {
        if (maximum <= minimum) return minimum;

        return (float) ThreadLocalRandom.current()
            .nextDouble(minimum, maximum);
    }
}

