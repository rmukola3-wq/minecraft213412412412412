package dev.morzh.client.utils.render;

import java.awt.Color;

public final class SkyConfig {
    public static Color BASE_COLOR = new Color(13, 26, 255);
    public static float[] SKY_ZENITH;
    public static float[] SKY_HORIZON;
    public static float[] NEB_COLOR1;
    public static float[] NEB_COLOR2;
    public static float NEB_INTENSITY = 0.75F;
    public static float TIME_SCALE = 1.0F;
    public static float[] STAR_COLOR;
    private static int lastComputedRgb = Integer.MIN_VALUE;
    private static float hueShiftDeg;
    private static float nebMul = 1.0F;
    private static float starMul = 1.0F;
    private static float zenithMul = 1.0F;

    static {
        compute();
    }

    private SkyConfig() {
    }

    public static void applyPreset(Preset preset, Color color, float brightness) {
        TIME_SCALE = preset.timeScale;
        hueShiftDeg = preset.hueShift;
        nebMul = preset.nebMul;
        starMul = preset.starMul;
        zenithMul = preset.zenithMul;
        NEB_INTENSITY = preset.nebIntensity * brightness;
        BASE_COLOR = color;
        lastComputedRgb = Integer.MIN_VALUE;
        compute();
    }

    public static void compute() {
        int rgb = BASE_COLOR.getRGB();
        if (rgb != lastComputedRgb) {
            lastComputedRgb = rgb;
            float[] hsb = Color.RGBtoHSB(BASE_COLOR.getRed(), BASE_COLOR.getGreen(), BASE_COLOR.getBlue(), null);
            float h = hueShift(hsb[0], hueShiftDeg);
            float s = hsb[1];
            float b = hsb[2];
            SKY_ZENITH = hsb2rgb(h, clamp(s * 0.9F), clamp(b * 0.12F * zenithMul));
            SKY_HORIZON = hsb2rgb(h, clamp(s * 0.7F), clamp(b * 0.28F));
            NEB_COLOR1 = scale(hsb2rgb(hueShift(h, 20.0F), clamp(s * 1.1F), clamp(b * 0.65F)), nebMul);
            NEB_COLOR2 = scale(hsb2rgb(hueShift(h, -15.0F), clamp(s * 0.85F), clamp(b * 0.4F)), nebMul);
            STAR_COLOR = scale(hsb2rgb(hueShift(h, 40.0F), clamp(s * 0.9F), clamp(b * 0.85F)), starMul);
            SkyShaderHolder.markDirty();
        }
    }

    public static void setBaseColor(Color color) {
        BASE_COLOR = color;
        compute();
    }

    private static float[] scale(float[] rgb, float mul) {
        return new float[]{
            clamp(rgb[0] * mul),
            clamp(rgb[1] * mul),
            clamp(rgb[2] * mul)
        };
    }

    private static float hueShift(float h, float angleDeg) {
        float shifted = h + angleDeg / 360.0F;
        return shifted - (float) Math.floor(shifted);
    }

    private static float clamp(float v) {
        return Math.max(0.0F, Math.min(1.0F, v));
    }

    private static float[] hsb2rgb(float h, float s, float b) {
        int packed = Color.HSBtoRGB(h, s, b);
        return new float[]{
            (packed >> 16 & 255) * 0.003921569F,
            (packed >> 8 & 255) * 0.003921569F,
            (packed & 255) * 0.003921569F
        };
    }

