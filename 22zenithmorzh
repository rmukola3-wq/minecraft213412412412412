    public boolean reactionElapsed(boolean visible, int reactionMilliseconds) {
        if (reactionMilliseconds <= 0) return true;

        if (!visible) {
            visibleSince = -1;
            return false;
        }

        long now = System.currentTimeMillis();

        if (visibleSince < 0) {
            visibleSince = now;
            return false;
        }

        return now - visibleSince >= reactionMilliseconds;
    }

    public void clearReaction() {
        visibleSince = -1;
    }

    public boolean timingReady() {
