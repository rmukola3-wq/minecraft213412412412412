        if (text.isEmpty()) return;

        Set<Module> modules = Modules.get().searchTitles(text);

        if (!modules.isEmpty()) {
            WSection section = container.add(theme.section("Modules"))
                .expandX()
                .widget();

            section.spacing = 0;

            int count = 0;

            for (Module module : modules) {
                if (count >= Config.get().moduleSearchCount.get()
                    || count >= modules.size()) {
                    break;
                }

                section.add(theme.module(module)).expandX();
                count++;
            }
        }

        modules = Modules.get().searchSettingTitles(text);

        if (!modules.isEmpty()) {
            WSection section = container.add(theme.section("Settings"))
                .expandX()
                .widget();

            section.spacing = 0;

            int count = 0;

            for (Module module : modules) {
                if (count >= Config.get().moduleSearchCount.get()
                    || count >= modules.size()) {
                    break;
                }

                section.add(theme.module(module)).expandX();
                count++;
            }
