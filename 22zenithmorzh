    }

    public boolean isRocketBoosting() {
        if (mc.world == null || mc.player == null) return false;
        for (Entity entity : mc.world.getEntities()) {
            if (entity instanceof FireworkRocketEntity rocket && rocket.getOwner() == mc.player) return true;
        }
        return false;
    }

    private void useFirework() {
        if (mc.player == null || mc.world == null || mc.interactionManager == null) return;

        if (mc.player.getOffHandStack().isOf(Items.FIREWORK_ROCKET)) {
            mc.interactionManager.interactItem(mc.player, Hand.OFF_HAND);
            mc.player.swingHand(Hand.OFF_HAND);
            fireworkTimer = System.currentTimeMillis();
            return;
        }

        FindItemResult hotbar = InvUtils.findInHotbar(Items.FIREWORK_ROCKET);
        if (hotbar.found() && hotbar.isHotbar()) {
            int previous = mc.player.getInventory().selectedSlot;
            boolean changed = hotbar.slot() != previous;
            if (changed) {
                mc.player.getInventory().selectedSlot = hotbar.slot();
                mc.player.networkHandler.sendPacket(new UpdateSelectedSlotC2SPacket(hotbar.slot()));
            }
            mc.interactionManager.interactItem(mc.player, Hand.MAIN_HAND);
            if (changed) {
                mc.player.getInventory().selectedSlot = previous;
                mc.player.networkHandler.sendPacket(new UpdateSelectedSlotC2SPacket(previous));
            }
            fireworkTimer = System.currentTimeMillis();
            return;
        }

        FindItemResult inventory = InvUtils.find(Items.FIREWORK_ROCKET);
        if (inventory.found() && mc.currentScreen == null) {
            InvUtils.move().from(inventory.slot()).toOffhand();
            fireworkTimer = System.currentTimeMillis();
        }
    }

    @Override
    public String getInfoString() {
        if (!isActive() || mc.player == null || !mc.player.isGliding()) return null;
        return resolveTarget() == null ? "Поиск" : "Цель";
    }
