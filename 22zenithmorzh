    private boolean ensureShaders(int width, int height) {
        try {
            if (glassShader == null) {
                glassShader = new Shader("glass_world.vert", "post-process/glass_world.frag");
                copyShader = new Shader("passthrough.vert", "passthrough.frag");
                int fw = Math.max(1, (int) (width * VisualPerf.GLASS_SCENE_SCALE));
                int fh = Math.max(1, (int) (height * VisualPerf.GLASS_SCENE_SCALE));
                sceneFb = new SimpleFramebuffer(fw, fh, true);
                mesh = new GlassMesh();
                lastWidth = width;
                lastHeight = height;
                return true;
            }
            if (width != lastWidth || height != lastHeight) {
                int fw = Math.max(1, (int) (width * VisualPerf.GLASS_SCENE_SCALE));
                int fh = Math.max(1, (int) (height * VisualPerf.GLASS_SCENE_SCALE));
                sceneFb.resize(fw, fh);
                lastWidth = width;
                lastHeight = height;
            }
            return true;
        } catch (RuntimeException e) {
            shaderFailed = true;
            MorzhClient.LOG.error("WorldLighting glass shader failed", e);
            return false;
        }
    }

    private void relight() {
        if (mc.player == null || mc.worldRenderer == null) return;
        dirtyAround(mc.player.getBlockPos(), playerRadius.get());
        LivingEntity target = targetEntity();
        if (target != null) dirtyAround(target.getBlockPos(), targetRadius.get());
