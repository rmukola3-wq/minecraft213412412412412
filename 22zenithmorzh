package dev.morzh.client.gui.morzh;

import dev.morzh.client.gui.themes.morzh.MorzhGuiColors;
import dev.morzh.client.utils.sound.MorzhSoundManager;

public class MorzhActionComponent extends MorzhComponent {

    private static final int ROW_HEIGHT = MorzhSettingComponent.ROW_HEIGHT;
    private static final float HOVER_RESPONSIVENESS = 14f;

    private final Runnable action;
    private float hoverProgress;

    public MorzhActionComponent(
        MorzhComponent parent,
        String label,
        int x, int y, int width,
        Runnable action
    ) {
        super(parent, label, x, y, width, ROW_HEIGHT);
        this.action = action;
    }

    @Override
    public void tick(float delta) {
        hoverProgress = MorzhAnimUtil.approach(
            hoverProgress,
            isHovered(0, 0) ? 1f : 0f,  
            HOVER_RESPONSIVENESS,
            delta
        );
    }

    @Override
    public void render(MorzhGuiContext context) {
        float top  = absoluteY();
        float left = absoluteX();

        boolean hovered = isHovered(context.mouseX, context.mouseY)
            && MorzhScissor.contains(context.mouseX, context.mouseY);

        hoverProgress = MorzhAnimUtil.approach(
            hoverProgress, hovered ? 1f : 0f,
            HOVER_RESPONSIVENESS, context.delta
        );

        int bg = MorzhGuiColors.interpolateArgb(
            MorzhGuiColors.packed(MorzhGuiColors.ROW_BG),
            MorzhGuiColors.packed(MorzhGuiColors.ROW_HOVER),
            hoverProgress
        );
        MorzhSmoothRenderer.roundedRect(context.draw, left, top, width(), ROW_HEIGHT, 0f, context.fade(bg));

        if (hoverProgress > 0.01f) {
            float barH = (ROW_HEIGHT - 4f) * hoverProgress;
            MorzhSmoothRenderer.roundedRect(context.draw,
                left, top + (ROW_HEIGHT - barH) / 2f,
                1.5f, barH, 0.75f,
                context.fade(withAlpha(MorzhGuiColors.packed(MorzhGuiColors.ACCENT), hoverProgress)));
        }

        double textH = MorzhSmoothRenderer.textHeight();
        float textY = top + (ROW_HEIGHT - (float) textH) / 2f;

        int textColor = MorzhGuiColors.interpolateArgb(
            MorzhGuiColors.packed(MorzhGuiColors.TEXT_MUTED),
            MorzhGuiColors.packed(MorzhGuiColors.ACCENT),
            hoverProgress
        );

        String label = name();
        double labelW = MorzhSmoothRenderer.textWidth(label);
        MorzhSmoothRenderer.text(context.draw, label,
            left + (width() - labelW) / 2f,
            textY,
            context.fade(textColor), false);
    }

    @Override
    public boolean mouseClicked(double mouseX, double mouseY, int button) {
        if (button != 0 || !isHovered(mouseX, mouseY)) return false;
        if (!MorzhScissor.contains((int) mouseX, (int) mouseY)) return false;

        action.run();
        MorzhSoundManager.playBoolean();
        return true;
    }

    private static int withAlpha(int packed, float t) {
        int a = Math.round(((packed >>> 24) & 0xFF) * MorzhAnimUtil.clamp01(t));
        return (a << 24) | (packed & 0x00FFFFFF);
    }
}

