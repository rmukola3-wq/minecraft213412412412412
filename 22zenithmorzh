    private BlockHitResult getPlaceInfo(BlockPos blockPos) {
        ((IVec3d) vec3d).morzh$set(mc.player.getX(), mc.player.getY() + mc.player.getEyeHeight(mc.player.getPose()), mc.player.getZ());

