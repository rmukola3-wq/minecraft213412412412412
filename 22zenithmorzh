        private final String label;
        private final String kind;
        private final Status status;

        private StaffEntry(
            String name,
            String label,
            String kind,
            Status status
        ) {
            this.name = name;
            this.label = label;
            this.kind = kind;
            this.status = status;
        }
    }

    private enum Status {
        ACTIVE,
        VANISH,
        GM3
    }
}

