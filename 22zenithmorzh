package dev.morzh.client.systems.modules.render;

import dev.morzh.client.events.render.Render3DEvent;
import dev.morzh.client.renderer.Renderer3D;
import dev.morzh.client.utils.render.color.Color;
import net.minecraft.client.render.Camera;
import net.minecraft.entity.LivingEntity;
import net.minecraft.util.math.MathHelper;
import net.minecraft.util.math.Vec3d;

import static dev.morzh.client.MorzhClient.mc;

public final class MorzhEsp {
    private static final int SEGMENTS = 48;

    private MorzhEsp() {}

    public static void render(Render3DEvent event, LivingEntity target, float fade, float speed,
                              float width, float glow, float radius, boolean throughWalls, Color tint) {
        if (target == null || fade <= 0.01f) return;

        Camera camera = mc.gameRenderer.getCamera();
        Vec3d cam = camera.getPos();
        float tickDelta = event.tickDelta;
        double x = MathHelper.lerp(tickDelta, target.lastRenderX, target.getX());
        double y = MathHelper.lerp(tickDelta, target.lastRenderY, target.getY());
        double z = MathHelper.lerp(tickDelta, target.lastRenderZ, target.getZ());
        float height = target.getHeight();
        float entityWidth = target.getWidth();
        float hurt = target.hurtTime / 10.0f;
        double time = (System.currentTimeMillis() % 360_000L) / 1000.0 * speed;

        boolean prevDepth = event.renderer.triangles.depthTest;
        event.renderer.triangles.depthTest = !throughWalls;

        Color base = hurtColor(tint, hurt, fade);
        float halfWidth = 0.022f * width;
        float centerOrbit = 0.72f + radius * 0.08f;
        float glowMul = 0.85f + glow * 0.55f;
        float stretch = height * 0.14f;

        try {
            drawHelix(event, cam, x, y, z, height, stretch, entityWidth, time, halfWidth, glowMul, base,
                centerOrbit, -0.06, 1.06, Math.PI * 0.5 + time * 0.35);
        } finally {
            event.renderer.triangles.depthTest = prevDepth;
        }
    }

    private static void drawHelix(Render3DEvent event, Vec3d cam,
                                  double x, double y, double z, float height, float stretch, float entityWidth,
                                  double time, float halfWidth, float glowMul, Color base,
                                  float orbitMul, double tMin, double tMax, double phase) {
        double prevX = 0, prevY = 0, prevZ = 0;
        boolean hasPrev = false;

        for (int i = 0; i <= SEGMENTS; i++) {
            double t = tMin + (tMax - tMin) * (i / (double) SEGMENTS);
            double angle = t * Math.PI * 4.8 + phase + time * 1.2;
            double wave = Math.sin(t * Math.PI * 2.5 + time * 1.8) * 0.07;
            double r = entityWidth * (orbitMul + wave);
            double px = x + Math.cos(angle) * r;
            double py = y - stretch * 0.45 + t * (height + stretch);
            double pz = z + Math.sin(angle) * r;

            if (hasPrev) {
                drawGlowingSegment(event, cam, prevX, prevY, prevZ, px, py, pz,
                    halfWidth, glowMul, base, 0, t);
            }

            prevX = px;
            prevY = py;
            prevZ = pz;
            hasPrev = true;
        }
    }

    private static void drawGlowingSegment(Render3DEvent event, Vec3d cam,
                                         double x0, double y0, double z0,
                                         double x1, double y1, double z1,
                                         float halfWidth, float glowMul, Color base, int strand, double t) {
        double mx = (x0 + x1) * 0.5;
        double my = (y0 + y1) * 0.5;
        double mz = (z0 + z1) * 0.5;

        double dx = x1 - x0;
        double dy = y1 - y0;
        double dz = z1 - z0;
        double len = Math.sqrt(dx * dx + dy * dy + dz * dz);
        if (len < 1.0e-4) return;
        dx /= len;
        dy /= len;
        dz /= len;

        double tcx = cam.x - mx;
        double tcy = cam.y - my;
        double tcz = cam.z - mz;
        double tcl = Math.sqrt(tcx * tcx + tcy * tcy + tcz * tcz);
        if (tcl < 1.0e-4) return;
        tcx /= tcl;
        tcy /= tcl;
        tcz /= tcl;

        double sx = dy * tcz - dz * tcy;
        double sy = dz * tcx - dx * tcz;
        double sz = dx * tcy - dy * tcx;
        double sl = Math.sqrt(sx * sx + sy * sy + sz * sz);
        if (sl < 1.0e-4) return;
        sx /= sl;
        sy /= sl;
        sz /= sl;

        int pulseAlpha = (int) (base.a * (0.55 + 0.45 * Math.sin(t * Math.PI * 2.0 + strand)));
        Color core = tint(base, strand * 40, MathHelper.clamp(pulseAlpha, 0, 255));
        Color mid = tint(base, strand * 40 + 10, MathHelper.clamp((int) (pulseAlpha * 0.42f), 0, 255));
        Color outer = tint(base, strand * 40 + 20, MathHelper.clamp((int) (pulseAlpha * 0.18f), 0, 255));
        Color halo = tint(base, strand * 40 + 30, MathHelper.clamp((int) (pulseAlpha * 0.08f), 0, 255));

        drawRibbon(event, x0, y0, z0, x1, y1, z1, sx, sy, sz, halfWidth * 5.5f * glowMul, halo);
        drawRibbon(event, x0, y0, z0, x1, y1, z1, sx, sy, sz, halfWidth * 3.6f * glowMul, outer);
        drawRibbon(event, x0, y0, z0, x1, y1, z1, sx, sy, sz, halfWidth * 2.1f * glowMul, mid);
        drawRibbon(event, x0, y0, z0, x1, y1, z1, sx, sy, sz, halfWidth * 0.75f, core);
    }

    private static void drawRibbon(Render3DEvent event,
                                   double x0, double y0, double z0,
                                   double x1, double y1, double z1,
                                   double sx, double sy, double sz,
                                   float half, Color color) {
        Renderer3D r = event.renderer;
        double ox = sx * half;
        double oy = sy * half;
        double oz = sz * half;

        int a = r.triangles.vec3(x0 - ox, y0 - oy, z0 - oz).color(color).next();
        int b = r.triangles.vec3(x0 + ox, y0 + oy, z0 + oz).color(color).next();
        int c = r.triangles.vec3(x1 + ox, y1 + oy, z1 + oz).color(color).next();
        int d = r.triangles.vec3(x1 - ox, y1 - oy, z1 - oz).color(color).next();
        r.triangles.quad(a, b, c, d);
    }

    private static Color hurtColor(Color base, float hurt, float fade) {
        if (hurt <= 0) {
            return new Color(base.r, base.g, base.b, MathHelper.clamp((int) (base.a * fade), 0, 255));
        }
        int r = (int) (base.r + (255 - base.r) * hurt);
        int g = (int) (base.g * (1f - hurt * 0.65f));
        int b = (int) (base.b * (1f - hurt * 0.65f));
        return new Color(r, g, b, MathHelper.clamp((int) (base.a * fade), 0, 255));
    }

    private static Color tint(Color base, int hueOffset, int alpha) {
        java.awt.Color hsb = java.awt.Color.getHSBColor(((System.currentTimeMillis() / 24 + hueOffset) % 360) / 360f, 0.55f, 1f);
        float mix = 0.32f;
        int r = (int) (base.r * (1f - mix) + hsb.getRed() * mix);
        int g = (int) (base.g * (1f - mix) + hsb.getGreen() * mix);
        int b = (int) (base.b * (1f - mix) + hsb.getBlue() * mix);
        return new Color(r, g, b, MathHelper.clamp(alpha, 0, 255));
    }
}

