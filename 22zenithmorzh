        aimOffset = new Vec3d(
            MathHelper.clamp(aimOffset.x, -limitX, limitX),
            MathHelper.clamp(aimOffset.y, 0.05, Math.max(0.05, lengthY - 0.05)),
            MathHelper.clamp(aimOffset.z, -limitZ, limitZ)
        );

        double safeJitter = Math.max(0, jitter);

        Vec3d point = new Vec3d(
            box.getCenter().x + aimOffset.x,
            box.minY + aimOffset.y,
            box.getCenter().z + aimOffset.z
        );

        if (safeJitter > 0) {
            point = point.add(
