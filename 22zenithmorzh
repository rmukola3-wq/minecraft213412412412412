    private static void drawPointer(float cx, float cy, float yawDeg, float dist, float height, float width, Color color) {
        double a = Math.toRadians(yawDeg);
        float px = cx + (float) Math.sin(a) * dist;
        float py = cy - (float) Math.cos(a) * dist;
        float nx = (float) Math.sin(a);
        float ny = (float) -Math.cos(a);
        float bx = -ny;
        float by = nx;
        float tipX = px + nx * height * 0.15f;
        float tipY = py + ny * height * 0.15f;
        float backX = px - nx * height;
        float backY = py - ny * height;
        Renderer2D.COLOR.triangle(
            tipX, tipY,
            backX + bx * width, backY + by * width,
            backX - bx * width, backY - by * width,
