            if (tier > bestTier) {
                bestTier = tier;
                best = i;
            }
        }

        return bestTier >= 0 ? best : -1;
    }

    private int findElytraSlot() {
        for (int i = 0; i < mc.player.getInventory().main.size(); i++) {
            ItemStack stack = mc.player.getInventory().main.get(i);
            if (stack.contains(DataComponentTypes.GLIDER)) return i;
        }
        return -1;
    }

    private static int chestplateTier(Item item) {
        if (item == Items.NETHERITE_CHESTPLATE) return 4;
        if (item == Items.DIAMOND_CHESTPLATE) return 3;
        if (item == Items.IRON_CHESTPLATE) return 2;
        if (item == Items.CHAINMAIL_CHESTPLATE || item == Items.GOLDEN_CHESTPLATE) return 1;
        if (item == Items.LEATHER_CHESTPLATE) return 0;
        return -1;
    }

    @Override
    public String getInfoString() {
        return frozen ? "frozen" : null;
    }
}

