    private PlayerInput tickHook(PlayerInput original) {
        PlayerInputEvent event = PlayerInputEvent.get(original);
        MorzhClient.EVENT_BUS.post(event);
        return transformInput(event.input);
    }

    @Unique
    private PlayerInput transformInput(PlayerInput input) {
        GUIMove guiMove = Modules.get() == null ? null : Modules.get().get(GUIMove.class);
        if (guiMove != null && guiMove.isStoppingForGrim()) return input;

        ScheduledRotation expensive = PlayerRotationManager.INSTANCE.getCurrentStrategy();
        Rotation expensiveRot = PlayerRotationManager.INSTANCE.getCurrentRotationOriginal();
        if (mc.player != null && expensive != null && expensiveRot != null && expensive.moveCorrection()) {
            if (!expensive.focusedCorrection()) {
                return MovementInputHelper.expensiveFreeRemap(input, mc.player.getYaw(), expensiveRot.getYaw());
            }
            return input;
        }

        AngleConnection rotationController = AngleConnection.INSTANCE;
        Angle angle = rotationController.getCurrentAngle();
        AngleConstructor configurable = rotationController.getCurrentRotationPlan();

        if (mc.player == null || angle == null || configurable == null
            || !(configurable.isMoveCorrection() && configurable.isFreeCorrection())) {
            return input;
        }

        float deltaYaw = mc.player.getYaw() - angle.getYaw();
        float z = rasty$movementMultiplier(input.forward(), input.backward());
        float x = rasty$movementMultiplier(input.left(), input.right());
        float newX = x * MathHelper.cos(deltaYaw * 0.017453292f) - z * MathHelper.sin(deltaYaw * 0.017453292f);
        float newZ = z * MathHelper.cos(deltaYaw * 0.017453292f) + x * MathHelper.sin(deltaYaw * 0.017453292f);
        int movementSideways = Math.round(newX);
        int movementForward = Math.round(newZ);

        return new PlayerInput(
            movementForward > 0F,
            movementForward < 0F,
            movementSideways > 0F,
            movementSideways < 0F,
            input.jump(),
            input.sneak(),
            input.sprint()
        );
    }

    @Unique
    private static float rasty$movementMultiplier(boolean positive, boolean negative) {
        if (positive == negative) return 0.0F;
        return positive ? 1.0F : -1.0F;
    }

    @Inject(method = "tick", at = @At("TAIL"))
    private void isPressed(CallbackInfo ci) {
