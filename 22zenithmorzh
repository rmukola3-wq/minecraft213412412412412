    @EventHandler(priority = EventPriority.LOW)
    private void onTick(TickEvent.Pre event) {
        if (pearlPauseTicks > 0) {
            pearlPauseTicks--;
            if (eating) {
                setPressed(false);
                eating = false;
            }
            return;
        }

        if (Modules.get().get(AutoGap.class).isEating()) return;

        if (eating) {

