    }

    public static boolean delayHitUntilUnsprinted() {
        ensureSubscribed();
        if (MorzhClient.mc.player == null) return true;
        if (!lastSprinting) {
            MorzhClient.mc.player.setSprinting(false);
            return false;
        }
        if (suppressTicks > 0) return true;

        MorzhClient.mc.player.setSprinting(false);
        suppressTicks = 2;
        return true;
    }

    public static void unsprintQuiet() {
