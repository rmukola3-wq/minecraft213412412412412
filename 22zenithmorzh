    private static Color fallback(int index, int alpha) {

        return twoColor(new SettingColor(129, 135, 255), new SettingColor(80, 225, 255), 24, index * 4);
    }

    private static Color themed(SettingColor c, int alpha) {
        return new Color(c.r, c.g, c.b, alpha);
    }

    private static Color rainbow(int speed, int index, float saturation, float brightness, float opacity) {
        int angle = (int) ((System.currentTimeMillis() / (float) speed + index) % 360);
        float hue = angle / 360f;
        int rgb = java.awt.Color.HSBtoRGB(hue, saturation, brightness);
        return new Color((rgb >> 16) & 255, (rgb >> 8) & 255, rgb & 255, (int) (opacity * 255));
    }

    private static Color fade(int speed, int index, SettingColor color, float alpha) {
        float[] hsb = java.awt.Color.RGBtoHSB(color.r, color.g, color.b, null);
        int angle = (int) ((System.currentTimeMillis() / (float) speed + index) % 360);
        angle = (angle > 180 ? 360 - angle : angle) + 180;
        int rgb = java.awt.Color.HSBtoRGB(hsb[0], hsb[1], angle / 360f);
        return new Color((rgb >> 16) & 255, (rgb >> 8) & 255, rgb & 255,
            Math.max(0, Math.min(255, (int) (alpha * 255))));
    }

    private static Color twoColor(SettingColor c1, SettingColor c2, double speed, double count) {
        int angle = (int) (((System.currentTimeMillis()) / speed + count) % 360);
        angle = (angle >= 180 ? 360 - angle : angle) * 2;
        return interpolateC(c1, c2, angle / 360f);
    }

    private static Color interpolate(SettingColor c1, SettingColor c2, int speed, int index) {
        int angle = (int) (((System.currentTimeMillis()) / (float) speed + index) % 360);
        angle = (angle >= 180 ? 360 - angle : angle) * 2;
        return interpolateC(c1, c2, angle / 360f);
    }

    private static Color interpolateC(SettingColor c1, SettingColor c2, float amount) {
        amount = Math.min(1, Math.max(0, amount));
        return new Color(
            lerp(c1.r, c2.r, amount),
            lerp(c1.g, c2.g, amount),
            lerp(c1.b, c2.b, amount),
            lerp(c1.a, c2.a, amount)
        );
    }

    private static SettingColor analogous(SettingColor color) {
        float[] hsb = java.awt.Color.RGBtoHSB(color.r, color.g, color.b, null);
        float degree = 0.84f;
        float newHue = hsb[0] - degree;
        newHue -= (float) Math.floor(newHue);
        int rgb = java.awt.Color.HSBtoRGB(newHue, hsb[1], hsb[2]);
        return new SettingColor((rgb >> 16) & 255, (rgb >> 8) & 255, rgb & 255, color.a);
    }

    private static int lerp(int from, int to, float t) {
        return (int) (from + (to - from) * t);
    }

    public enum ColorMode {
        Static("Статика"),
        Rainbow("Радуга"),
