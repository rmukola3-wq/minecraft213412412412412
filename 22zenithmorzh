            return;
        }
        if (found.isHotbar()) {
            InvUtils.swap(found.slot(), false);
            interact(Hand.MAIN_HAND);
            InvUtils.swap(previous, false);
            return;
        }
        InvUtils.move().from(found.slot()).to(previous);
        interact(Hand.MAIN_HAND);
        InvUtils.move().from(previous).to(found.slot());
    }

    private void interact(Hand hand) {
