    private static final int HEADER = 22;
    private static final int GROUND = 22;

    private static final float GRAVITY = 0.42f;
    private static final float FLAP = -5.6f;
    private static final float PIPE_SPEED = 2.35f;
    private static final int PIPE_W = 34;
    private static final int PIPE_GAP = 74;
    private static final int PIPE_SPACING = 108;

    private final SettingGroup sg = settings.getDefaultGroup();

    private final Setting<Boolean> pauseInMenus = sg.add(new BoolSetting.Builder()
        .name("пауза-в-меню")
        .description("Ставить на паузу при открытом чате и других экранах.")
        .defaultValue(true)
        .build()
    );

    private final List<Pipe> pipes = new ArrayList<>();
    private float birdY = GAME_H * 0.45f;
    private float birdVy;
    private int score;
    private int best;
    private boolean dead;
    private boolean lastJump;
    private int tick;

    public FlappyBirdHud() {
        super(INFO);
        setSize(GAME_W, GAME_H + HEADER);
        resetGame();
    }

    @Override
    public void tick(HudRenderer renderer) {
        if (!isActive()) return;
        if (paused()) return;

        boolean jump = jumpPressed();
        if (jump && !lastJump) {
            if (dead) resetGame();
            else flap();
        }
        lastJump = jump;

        if (dead) return;

        tick++;
        birdVy += GRAVITY;
        birdY += birdVy;

        spawnPipes();
        movePipes();
        checkCollisions();
    }

    @Override
    public void render(HudRenderer renderer) {
        float s = scale();
        float w = GAME_W * s;
        float h = (GAME_H + HEADER) * s;
        setSize(w, h);

        float birdDrawY = birdY;
        int drawScore = score;
        boolean drawDead = dead;
        List<Pipe> drawPipes = new ArrayList<>(pipes);

        renderer.post(() -> {
            DrawContext context = HudRenderer.INSTANCE.drawContext;
            if (context == null) return;

            float px = x;
            float py = y;
            float gameH = GAME_H * s;
            float headerH = HEADER * s;

            HudChrome.card(context, px, py, w, h, 6 * s);
            MorzhSmoothRenderer.text(context, "Flappy", px + 8 * s, py + 5 * s, 0xFFFFFFFF, true, 0.55 * s);
            String scoreText = String.valueOf(drawScore);
            float scoreW = (float) MorzhSmoothRenderer.textWidth(scoreText, 0.55 * s) + 10 * s;
            MorzhSmoothRenderer.roundedRect(context, px + w - scoreW - 8 * s, py + 4 * s, scoreW, headerH - 8 * s, 4 * s, HudChrome.RV_PILL);
            MorzhSmoothRenderer.text(context, scoreText, px + w - scoreW - 3 * s, py + 5 * s, 0xFFFFFFFF, true, 0.55 * s);

            float gx = px + 4 * s;
            float gy = py + headerH + 4 * s;
            float gw = w - 8 * s;
            float gh = gameH - 8 * s;

            MorzhSmoothRenderer.roundedRect(context, gx, gy, gw, gh, 5 * s, 0xFF6EC6E8);

            float scaleY = gh / GAME_H;
            float scaleX = gw / GAME_W;

            for (Pipe pipe : drawPipes) {
                float pipeX = gx + pipe.x * scaleX;
                float gapTop = gy + (pipe.gapY - PIPE_GAP / 2f) * scaleY;
                float gapBot = gy + (pipe.gapY + PIPE_GAP / 2f) * scaleY;
                float pipeW = PIPE_W * scaleX;
                MorzhSmoothRenderer.roundedRect(context, pipeX, gy, pipeW, Math.max(0, gapTop - gy), 3 * s, 0xFF66BB6A);
                MorzhSmoothRenderer.roundedRect(context, pipeX, gapBot, pipeW, gy + gh - gapBot, 3 * s, 0xFF66BB6A);
                MorzhSmoothRenderer.roundedRect(context, pipeX + pipeW - 4 * s, gapTop - 6 * s, 6 * s, PIPE_GAP * scaleY + 12 * s, 2 * s, 0xFF43A047);
            }

            float groundY = gy + gh - GROUND * scaleY;
            MorzhSmoothRenderer.roundedRect(context, gx, groundY, gw, GROUND * scaleY, 0, 0xFF8D6E63);
            MorzhSmoothRenderer.roundedRect(context, gx, groundY, gw, 3 * s, 0, 0xFF5D4037);

            float bx = gx + 44 * scaleX;
            float by = gy + birdDrawY * scaleY;
            float bw = 14 * scaleX;
            float bh = 11 * scaleY;
            MorzhSmoothRenderer.roundedRect(context, bx, by, bw, bh, 3 * s, 0xFFFFD54F);
            MorzhSmoothRenderer.roundedRect(context, bx + bw - 2 * s, by + bh * 0.35f, 4 * s, 3 * s, 1 * s, 0xFFFF8F00);
            MorzhSmoothRenderer.roundedRect(context, bx + 3 * s, by + 2 * s, 2.5f * s, 2.5f * s, 1 * s, 0xFF212121);

            if (drawDead) {
                MorzhSmoothRenderer.roundedRect(context, gx, gy, gw, gh, 5 * s, 0x88000000);
                String msg = "Game Over";
                String hint = "Space / ЛКМ";
                double fs = 0.62 * s;
                MorzhSmoothRenderer.text(context, msg, gx + (gw - MorzhSmoothRenderer.textWidth(msg, fs)) / 2f, gy + gh * 0.38f, 0xFFFFFFFF, true, fs);
                MorzhSmoothRenderer.text(context, hint, gx + (gw - MorzhSmoothRenderer.textWidth(hint, fs * 0.75)) / 2f, gy + gh * 0.52f, 0xFFDDDDDD, true, fs * 0.75);
            } else if (paused()) {
                String msg = "Пауза";
                double fs = 0.58 * s;
                MorzhSmoothRenderer.text(context, msg, gx + (gw - MorzhSmoothRenderer.textWidth(msg, fs)) / 2f, gy + gh * 0.46f, 0xEEFFFFFF, true, fs);
            }
        });
    }

    private boolean paused() {
        if (!pauseInMenus.get()) return false;
        if (mc.currentScreen instanceof HudEditorScreen) return false;
        return mc.currentScreen != null;
    }

    private boolean jumpPressed() {
        if (mc.getWindow() == null) return false;
        long handle = mc.getWindow().getHandle();
        boolean space = GLFW.glfwGetKey(handle, GLFW.GLFW_KEY_SPACE) == GLFW.GLFW_PRESS;
        if (mc.options != null) {
            space = space || mc.options.jumpKey.isPressed();
            if (mc.options.attackKey.wasPressed()) return true;
        }
        return space;
    }

    private void flap() {
        birdVy = FLAP;
    }

    private void resetGame() {
        pipes.clear();
        birdY = GAME_H * 0.45f;
        birdVy = 0;
        score = 0;
        dead = false;
        tick = 0;
        pipes.add(new Pipe(GAME_W + 40, randomGap()));
    }

    private void spawnPipes() {
        if (pipes.isEmpty() || pipes.getLast().x < GAME_W - PIPE_SPACING) {
            pipes.add(new Pipe(GAME_W + 20, randomGap()));
        }
    }

    private void movePipes() {
        Iterator<Pipe> it = pipes.iterator();
        while (it.hasNext()) {
            Pipe pipe = it.next();
            pipe.x -= PIPE_SPEED;
            if (!pipe.passed && pipe.x + PIPE_W < 44) {
                pipe.passed = true;
                score++;
                best = Math.max(best, score);
            }
            if (pipe.x + PIPE_W < -20) it.remove();
        }
    }

    private void checkCollisions() {
        float bx = 44;
        float by = birdY;
        float bw = 14;
        float bh = 11;

        if (by < 0 || by + bh > GAME_H - GROUND) {
            dead = true;
            return;
        }

        for (Pipe pipe : pipes) {
            if (bx + bw <= pipe.x || bx >= pipe.x + PIPE_W) continue;
            float gapTop = pipe.gapY - PIPE_GAP / 2f;
            float gapBot = pipe.gapY + PIPE_GAP / 2f;
            if (by < gapTop || by + bh > gapBot) {
                dead = true;
                return;
            }
        }
    }

    private float randomGap() {
        return 48 + (float) (Math.random() * (GAME_H - GROUND - PIPE_GAP - 56));
    }

    private static final class Pipe {
        float x;
        float gapY;
        boolean passed;

        Pipe(float x, float gapY) {
            this.x = x;
            this.gapY = gapY;
        }
    }
}

