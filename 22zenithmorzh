public class AuctionHelper extends Module {
    private final SettingGroup sgGeneral = settings.getDefaultGroup();

    private final Setting<Integer> cheapPercent = sgGeneral.add(new IntSetting.Builder()
        .name("дешевле-среднего-%")
        .description("Подсветка слотов дешевле средней цены на столько процентов.")
        .defaultValue(20)
        .min(5)
        .sliderMax(70)
        .build()
    );

    private final Setting<SettingColor> cheapColor = sgGeneral.add(new ColorSetting.Builder()
        .name("цвет")
        .description("Цвет выгодного слота.")
        .defaultValue(new SettingColor(64, 255, 64, 140))
        .build()
    );

    public AuctionHelper() {
        super(Categories.Misc, "ah-helper", "Подсвечивает дешёвые лоты на аукционе.");
    }

    public int slotColor(Slot slot) {
        if (!isActive() || mc.player == null) return -1;
        if (!(mc.currentScreen instanceof GenericContainerScreen screen)) return -1;
        if (!AuctionPriceParser.auctionScreen(Formatting.strip(screen.getTitle().getString()))) return -1;

        ScreenHandler handler = screen.getScreenHandler();
        int chestSlots = Math.max(0, handler.slots.size() - 36);
        if (slot.id < 0 || slot.id >= chestSlots) return -1;

        long sum = 0;
        int count = 0;
        long cheapest = Long.MAX_VALUE;
        int cheapestId = -1;

        for (int i = 0; i < Math.min(chestSlots, 45); i++) {
            ItemStack stack = handler.getSlot(i).getStack();
            long price = AuctionPriceParser.price(stack);
            if (price <= 0) continue;
            sum += price;
            count++;
            if (price < cheapest) {
                cheapest = price;
                cheapestId = i;
            }
        }

        if (count == 0) return -1;
        long average = sum / count;
        long limit = (long) (average * (1.0 - cheapPercent.get() / 100.0));
        long here = AuctionPriceParser.price(slot.getStack());
        if (here <= 0) return -1;
        if (slot.id == cheapestId || here <= limit) return cheapColor.get().getPacked();
        return -1;
    }
}

