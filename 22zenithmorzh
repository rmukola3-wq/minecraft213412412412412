                                 double travel, double seed) {
        double cp = Math.cos(precess);
        double sp = Math.sin(precess);
        double st = Math.sin(tilt);
        double ct = Math.cos(tilt);
        drawOrbit(event, cam, base, halfWidth, glowMul, segments, new Vec3d(cx, cy, cz),
            new Vec3d(cp, 0, sp),
            new Vec3d(-sp * st, ct, cp * st),
            r, travel, seed);
    }

    private static void drawOrbit(Render3DEvent event, Vec3d cam, Color base, float halfWidth, float glowMul,
                                  int segments, Vec3d center, Vec3d u, Vec3d v, double radius,
                                  double travel, double seed) {
        double tau = Math.PI * 2;
        double p0x = 0, p0y = 0, p0z = 0;
        boolean has = false;
        for (int i = 0; i <= segments; i++) {
            double a = tau * i / (double) segments;
            double ca = Math.cos(a);
            double sa = Math.sin(a);
            double px = center.x + (u.x * ca + v.x * sa) * radius;
            double py = center.y + (u.y * ca + v.y * sa) * radius;
            double pz = center.z + (u.z * ca + v.z * sa) * radius;
            if (has) {
                double delta = (a - tau / segments * 0.5) - travel;
                drawGlowSegment(event, cam, p0x, p0y, p0z, px, py, pz, halfWidth, glowMul, base, delta, seed);
            }
            p0x = px;
            p0y = py;
            p0z = pz;
            has = true;
        }
    }

    private static void drawGlowSegment(Render3DEvent event, Vec3d cam,
                                        double x0, double y0, double z0,
                                        double x1, double y1, double z1,
                                        float halfWidth, float glowMul, Color base,
                                        double delta, double seed) {
        double mx = (x0 + x1) * 0.5;
        double my = (y0 + y1) * 0.5;
        double mz = (z0 + z1) * 0.5;

        double dx = x1 - x0;
        double dy = y1 - y0;
        double dz = z1 - z0;
        double len = Math.sqrt(dx * dx + dy * dy + dz * dz);
        if (len < 1.0e-4) return;
        dx /= len;
        dy /= len;
        dz /= len;

        double tcx = cam.x - mx;
        double tcy = cam.y - my;
        double tcz = cam.z - mz;
        double tcl = Math.sqrt(tcx * tcx + tcy * tcy + tcz * tcz);
        if (tcl < 1.0e-4) return;
        tcx /= tcl;
        tcy /= tcl;
        tcz /= tcl;

        double sx = dy * tcz - dz * tcy;
        double sy = dz * tcx - dx * tcz;
        double sz = dx * tcy - dy * tcx;
        double sl = Math.sqrt(sx * sx + sy * sy + sz * sz);
        if (sl < 1.0e-4) return;
        sx /= sl;
        sy /= sl;
        sz /= sl;

        double pulse = Math.pow(Math.max(0.0, Math.cos(delta)), 10.0);
        float p = (float) (0.3 + 0.7 * pulse);
        int alpha = MathHelper.clamp((int) (base.a * p), 0, 255);
        float hot = (float) (0.10 + 0.55 * pulse);
        float flicker = 1.0f + 0.08f * (float) Math.sin(seed + delta * 6.0);

        drawRibbon(event, x0, y0, z0, x1, y1, z1, sx, sy, sz, halfWidth * 5.4f * glowMul * flicker,
            mix(base, hot * 0.8f, (int) (alpha * 0.08f)));
        drawRibbon(event, x0, y0, z0, x1, y1, z1, sx, sy, sz, halfWidth * 3.5f * glowMul * flicker,
            mix(base, hot * 0.9f, (int) (alpha * 0.2f)));
        drawRibbon(event, x0, y0, z0, x1, y1, z1, sx, sy, sz, halfWidth * 2.0f * glowMul,
            mix(base, hot, (int) (alpha * 0.5f)));
        drawRibbon(event, x0, y0, z0, x1, y1, z1, sx, sy, sz, halfWidth * 0.85f,
            mix(base, hot + 0.3f, alpha));
    }

    private static void drawRibbon(Render3DEvent event,
                                   double x0, double y0, double z0,
                                   double x1, double y1, double z1,
                                   double sx, double sy, double sz,
                                   float half, Color color) {
        Renderer3D r = event.renderer;
        double ox = sx * half;
        double oy = sy * half;
        double oz = sz * half;

        int a = r.triangles.vec3(x0 - ox, y0 - oy, z0 - oz).color(color).next();
        int b = r.triangles.vec3(x0 + ox, y0 + oy, z0 + oz).color(color).next();
        int c = r.triangles.vec3(x1 + ox, y1 + oy, z1 + oz).color(color).next();
        int d = r.triangles.vec3(x1 - ox, y1 - oy, z1 - oz).color(color).next();
        r.triangles.quad(a, b, c, d);
    }

    private static Color hurtColor(Color base, float hurt, float fade) {
        if (hurt <= 0) {
            return new Color(base.r, base.g, base.b, MathHelper.clamp((int) (base.a * fade), 0, 255));
        }
        int r = (int) (base.r + (255 - base.r) * hurt);
        int g = (int) (base.g * (1f - hurt * 0.65f));
        int b = (int) (base.b * (1f - hurt * 0.65f));
        return new Color(r, g, b, MathHelper.clamp((int) (base.a * fade), 0, 255));
    }

    private static Color mix(Color base, float white, int alpha) {
        white = MathHelper.clamp(white, 0.0f, 1.0f);
        int r = (int) (base.r + (255 - base.r) * white);
        int g = (int) (base.g + (255 - base.g) * white);
        int b = (int) (base.b + (255 - base.b) * white);
        return new Color(r, g, b, MathHelper.clamp(alpha, 0, 255));
    }
