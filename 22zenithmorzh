    private void sendUse(Hand hand, float yaw, float pitch) {
        if (mc.player == null || mc.player.networkHandler == null || mc.world == null || mc.interactionManager == null) return;

        mc.player.networkHandler.sendPacket(new PlayerMoveC2SPacket.LookAndOnGround(
            yaw, pitch, mc.player.isOnGround(), mc.player.horizontalCollision
        ));
        try {
            ((ClientPlayerInteractionManagerInvoker) mc.interactionManager).morzh$sendSequencedPacket(
                mc.world,
                seq -> new PlayerInteractItemC2SPacket(hand, seq, yaw, pitch)
            );
        } catch (Throwable ignored) {
            mc.player.networkHandler.sendPacket(new PlayerInteractItemC2SPacket(hand, 0, yaw, pitch));
        }
        mc.player.networkHandler.sendPacket(new HandSwingC2SPacket(hand));
    }

    private int findTempHotbar(int previous) {
        for (int slot = 0; slot < 9; slot++) {
            if (slot != previous && mc.player.getInventory().getStack(slot).isEmpty()) return slot;
        }
        return previous == 8 ? 7 : 8;
    }

    private EnderPearlEntity findPearl() {
        Entity chase = chaseTarget();
        EnderPearlEntity best = null;
        double bestDist = Double.MAX_VALUE;
        long now = System.currentTimeMillis();

        for (Entity entity : mc.world.getEntities()) {
            if (!(entity instanceof EnderPearlEntity pearl) || !pearl.isAlive() || pearl.isRemoved()) continue;
            if (handledPearls.contains(pearl.getId())) continue;
            if (isOwnPearl(pearl)) continue;
            if (isFriendPearl(pearl)) continue;

            Entity owner = resolveOwner(pearl);
            if (onlyTarget.get()) {
                if (owner == null || owner == mc.player) continue;

                if (chase == null) {
                    chase = owner;
                    rememberedTarget = owner;
                    rememberedTargetAt = now;
                } else if (owner != chase) {
                    continue;
                }
            }

            Vec3d landing = predictLanding(pearl);
            if (landing == null) continue;
            double dist = mc.player.getPos().distanceTo(landing);
            if (dist < minDist.get() || dist > MAX_LANDING || dist >= bestDist) continue;
            bestDist = dist;
            best = pearl;
        }
        return best;
    }

    private Entity chaseTarget() {
        LivingEntity aura = CombatTargets.current();
        long now = System.currentTimeMillis();
        if (aura != null && aura.isAlive()) {
            rememberedTarget = aura;
            rememberedTargetAt = now;
            return aura;
        }
        if (rememberedTarget != null) {
            if (!rememberedTarget.isAlive()) {
                rememberedTarget = null;
                return null;
            }
            if (now - rememberedTargetAt < TARGET_MEMORY_MS) return rememberedTarget;
            rememberedTarget = null;
        }
        return null;
    }

    private Entity resolveOwner(EnderPearlEntity pearl) {
        Entity owner = pearl.getOwner();
        if (owner != null) return owner;

        UUID uuid = ownerUuid(pearl);
        if (uuid != null) {
            if (uuid.equals(mc.player.getUuid())) return mc.player;
            for (PlayerEntity player : mc.world.getPlayers()) {
                if (player.getUuid().equals(uuid)) return player;
            }
        }

        String name = pearlOwners.get(pearl.getId());
        if (name != null && !name.isEmpty()) {
            for (PlayerEntity player : mc.world.getPlayers()) {
                if (player.getName().getString().equals(name)) return player;
            }
        }

        PlayerEntity nearest = null;
        double best = Double.MAX_VALUE;
        for (PlayerEntity player : mc.world.getPlayers()) {
            double d = player.squaredDistanceTo(pearl);
            if (d < best) {
                best = d;
                nearest = player;
            }
        }
        return nearest;
    }

    private boolean isOwnPearl(EnderPearlEntity pearl) {
        if (pearl.getOwner() == mc.player) return true;
        UUID uuid = ownerUuid(pearl);
        if (uuid != null && uuid.equals(mc.player.getUuid())) return true;
        String owner = pearlOwners.get(pearl.getId());
        return owner != null && owner.isEmpty();
    }

    private boolean isFriendPearl(EnderPearlEntity pearl) {
        if (!ignoreFriends.get()) return false;
        Entity owner = resolveOwner(pearl);
        return owner instanceof PlayerEntity player && Friends.get().isFriend(player);
    }

    private UUID ownerUuid(EnderPearlEntity pearl) {
        try {
            return ((ProjectileEntityAccessor) pearl).getOwnerUuid();
        } catch (Throwable ignored) {
            return null;
        }
    }

    private Vec3d predictLanding(EnderPearlEntity pearl) {
        Vec3d pos = pearl.getPos();
        Vec3d vel = pearl.getVelocity();
        for (int i = 0; i < 200; i++) {
            Vec3d next = pos.add(vel);
            vel = updatePearlMotion(vel, next);
            if (next.y <= mc.world.getBottomY()) return snap(next);
            BlockPos bp = BlockPos.ofFloored(next);
            if (!mc.world.getBlockState(bp).getCollisionShape(mc.world, bp).isEmpty()) return snap(next);
            pos = next;
        }
        return null;
    }

    private Vec3d updatePearlMotion(Vec3d motion, Vec3d pos) {
        BlockPos bp = BlockPos.ofFloored(pos);
        if (mc.world.getBlockState(bp).isOf(Blocks.WATER)) {
            return motion.multiply(0.8).add(0, -0.03, 0);
        }
        return motion.multiply(0.99).add(0, -0.03, 0);
    }

    private Vec3d snap(Vec3d v) {
        return new Vec3d(MathHelper.floor(v.x) + 0.5, MathHelper.floor(v.y), MathHelper.floor(v.z) + 0.5);
    }

    private float[] solveRotation(Vec3d target) {
        float[] rot = calculateYawPitch(target);
        if (rot == null) rot = scanYaws(target, 60, 3.0f);
        if (rot == null) rot = scanYaws(target, 180, 6.0f);
        if (rot == null) rot = fallbackRotation(target);
        return rot;
    }

    private float[] calculateYawPitch(Vec3d target) {
        Vec3d eye = mc.player.getEyePos();
        double dx = target.x - eye.x;
        double dz = target.z - eye.z;
        float yaw = (float) Math.toDegrees(Math.atan2(dz, dx)) - 90f;

        PitchResult best = null;
        for (float pitch = 89f; pitch >= -85f; pitch -= 1.0f) {
            PitchResult r = testPitch(yaw, pitch, target);
            if (r != null && (best == null || r.ticks < best.ticks)) best = r;
        }
        if (best == null) return null;

        PitchResult fine = null;
        for (float pitch = best.pitch - 1.0f; pitch <= best.pitch + 1.0001f; pitch += 0.1f) {
            PitchResult r = testPitch(yaw, pitch, target);
            if (r != null && (fine == null || r.ticks < fine.ticks)) fine = r;
        }
        float p = fine != null ? fine.pitch : best.pitch;
        return new float[]{yaw, MathHelper.clamp(p, -90f, 90f)};
    }

    private float[] scanYaws(Vec3d target, float yawRange, float yawStep) {
        Vec3d eye = mc.player.getEyePos();
        double dx = target.x - eye.x;
        double dz = target.z - eye.z;
        float baseYaw = (float) Math.toDegrees(Math.atan2(dz, dx)) - 90f;

        PitchResult best = null;
        float bestYaw = 0;
        for (float yawOff = -yawRange; yawOff <= yawRange; yawOff += yawStep) {
            float yaw = baseYaw + yawOff;
            for (float pitch = 89f; pitch >= -85f; pitch -= 2.0f) {
                PitchResult r = testPitch(yaw, pitch, target);
                if (r == null) continue;
                if (best == null || r.ticks < best.ticks) {
                    best = r;
                    bestYaw = yaw;
                }
                break; 
            }
        }
        if (best == null) return null;
        return new float[]{bestYaw, MathHelper.clamp(best.pitch, -90f, 90f)};
    }

    private float[] fallbackRotation(Vec3d target) {
        Vec3d eye = mc.player.getEyePos();
        double dx = target.x - eye.x;
        double dz = target.z - eye.z;
        double dy = target.y - eye.y;
        double distXZ = Math.sqrt(dx * dx + dz * dz);
        if (distXZ < 0.001) return null;
        float yaw = (float) Math.toDegrees(Math.atan2(dz, dx)) - 90f;
        float pitch = (float) -Math.toDegrees(Math.atan2(dy, distXZ));
        Vec3d landing = simulateTrajectory(yaw, pitch);
        if (landing != null && target.distanceTo(landing) <= errorBudget(target) * 2.5) {
            return new float[]{yaw, MathHelper.clamp(pitch, -90f, 90f)};
        }
        return null;
    }

    private double errorBudget(Vec3d landing) {
        Vec3d eye = mc.player.getEyePos();
        double dist = eye.distanceTo(landing);
        boolean high = landing.y - eye.y > 5.0;
        double maxErr = dist > 60 ? 3.0 : 2.25;
        if (high) maxErr = 4.5;
        if (hasObstacleBetween(eye, landing)) maxErr = high ? 6.0 : 3.75;
        return maxErr;
    }

    private boolean hasObstacleBetween(Vec3d start, Vec3d end) {
        Vec3d dir = end.subtract(start);
        double len = dir.length();
        if (len < 0.001) return false;
        Vec3d norm = dir.normalize();
        int steps = (int) (len / 0.5) + 1;
        for (int i = 1; i < steps; i++) {
            BlockPos bp = BlockPos.ofFloored(start.add(norm.multiply(i * 0.5)));
            if (!mc.world.getBlockState(bp).getCollisionShape(mc.world, bp).isEmpty()) return true;
        }
        return false;
    }

    private boolean hasPlayerOnPath(float yaw, float pitch) {
        Vec3d pos = throwPos(yaw);
        Vec3d motion = throwMotion(yaw, pitch);
        for (int i = 0; i < 200; i++) {
            Vec3d prev = pos;
            pos = pos.add(motion);
            motion = updatePearlMotion(motion, pos);
            if (pos.y <= mc.world.getBottomY()) break;
            BlockPos bp = BlockPos.ofFloored(pos);
            if (!mc.world.getBlockState(bp).getCollisionShape(mc.world, bp).isEmpty()) break;
            Box segment = new Box(prev, pos).expand(0.35);
            for (Entity entity : mc.world.getOtherEntities(mc.player, segment, e ->
                e instanceof PlayerEntity && e.isAlive() && !e.isSpectator() && e != mc.player)) {
                if (entity.getBoundingBox().expand(0.25).intersects(segment)) return true;
            }
        }
        return false;
    }

    private PitchResult testPitch(float yaw, float pitch, Vec3d target) {
        Vec3d start = throwPos(yaw);
        Vec3d pos = start;
        Vec3d motion = throwMotion(yaw, pitch);
        double targetDX = target.x - start.x;
        double targetDZ = target.z - start.z;
        double targetXZ = Math.sqrt(targetDX * targetDX + targetDZ * targetDZ);
        double maxErr = errorBudget(target);

        int ticks = 0;
        for (; ticks < 200; ticks++) {
            pos = pos.add(motion);
            motion = updatePearlMotion(motion, pos);

            double dx = pos.x - start.x;
            double dz = pos.z - start.z;
            if (Math.sqrt(dx * dx + dz * dz) > targetXZ + 10.0) return null; 

            if (pos.y <= mc.world.getBottomY()) break;
            BlockPos bp = BlockPos.ofFloored(pos);
            if (!mc.world.getBlockState(bp).getCollisionShape(mc.world, bp).isEmpty()) break;
        }

        double error = snap(pos).distanceTo(target);
        if (error > maxErr) return null;
        return new PitchResult(pitch, ticks);
    }

    private Vec3d simulateTrajectory(float yaw, float pitch) {
        Vec3d pos = throwPos(yaw);
        Vec3d motion = throwMotion(yaw, pitch);
        for (int i = 0; i < 200; i++) {
            pos = pos.add(motion);
            motion = updatePearlMotion(motion, pos);
            if (pos.y <= mc.world.getBottomY()) return snap(pos);
            BlockPos bp = BlockPos.ofFloored(pos);
            if (!mc.world.getBlockState(bp).getCollisionShape(mc.world, bp).isEmpty()) return snap(pos);
        }
        return null;
    }

    private Vec3d throwPos(float yaw) {
        float yr = (float) Math.toRadians(yaw);
        return new Vec3d(
            mc.player.getX() - MathHelper.cos(yr) * 0.16,
            mc.player.getY() + mc.player.getEyeHeight(mc.player.getPose()) - 0.1,
            mc.player.getZ() - MathHelper.sin(yr) * 0.16
        );
    }

    private Vec3d throwMotion(float yaw, float pitch) {
        float yr = (float) Math.toRadians(yaw);
        float pr = (float) Math.toRadians(pitch);
        Vec3d dir = new Vec3d(
            -MathHelper.sin(yr) * MathHelper.cos(pr),
            -MathHelper.sin(pr),
            MathHelper.cos(yr) * MathHelper.cos(pr)
        ).multiply(1.5);
        Vec3d pv = mc.player.getVelocity();
        double addY = mc.player.isOnGround() ? 0.0 : pv.y;
        return dir.add(pv.x, addY, pv.z);
    }

    private boolean hasPearl() {
        if (mc.player.getOffHandStack().isOf(Items.ENDER_PEARL)) return true;
        return InvUtils.find(Items.ENDER_PEARL).found();
    }

    private float currentHealth() {
        return mc.player.getHealth() + mc.player.getAbsorptionAmount();
    }

    private float entityHealth(LivingEntity entity) {
        return entity.getHealth() + entity.getAbsorptionAmount();
    }

    private void cancelEating() {
        AutoGap gap = Modules.get().get(AutoGap.class);
        if (gap != null) gap.interruptForPearl();
        AutoEat eat = Modules.get().get(AutoEat.class);
        if (eat != null) eat.interruptForPearl();
        mc.options.useKey.setPressed(false);
        if (mc.player.isUsingItem() && mc.interactionManager != null) {
            mc.interactionManager.stopUsingItem(mc.player);
            mc.player.networkHandler.sendPacket(new PlayerActionC2SPacket(
                PlayerActionC2SPacket.Action.RELEASE_USE_ITEM, BlockPos.ORIGIN, Direction.DOWN
            ));
            mc.player.stopUsingItem();
        }
    }

    private void cleanup() {
        Set<Integer> live = new HashSet<>();
        for (Entity entity : mc.world.getEntities()) {
            if (entity instanceof EnderPearlEntity) live.add(entity.getId());
        }
        pearlOwners.keySet().removeIf(id -> !live.contains(id));
        handledPearls.removeIf(id -> !live.contains(id));
    }

    private static final class PitchResult {
        final float pitch;
        final int ticks;

        PitchResult(float pitch, int ticks) {
            this.pitch = pitch;
            this.ticks = ticks;
        }
    }
