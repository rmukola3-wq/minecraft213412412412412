    private static double lookCost(Vec3d eyes, Vec3d point, float yaw, float pitch) {
        Vec3d delta = point.subtract(eyes);
        float wantedYaw = (float) MathHelper.wrapDegrees(Math.toDegrees(Math.atan2(delta.z, delta.x)) - 90.0);
        float wantedPitch = (float) -Math.toDegrees(Math.atan2(delta.y, Math.hypot(delta.x, delta.z)));
        return Math.hypot(MathHelper.wrapDegrees(wantedYaw - yaw), (wantedPitch - pitch) * 0.72F);
