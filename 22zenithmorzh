        float gcd = gcdStep();
        if (gcd <= 1e-5F) return to;
        float yd = MathHelper.wrapDegrees(to.getYaw() - from.getYaw());
        float pd = to.getPitch() - from.getPitch();
        float yaw = from.getYaw() + gcdRound(MathHelper.clamp(yd, -gcd, gcd));
        float pitch = MathHelper.clamp(
            from.getPitch() + gcdRound(MathHelper.clamp(pd, -gcd, gcd)),
            -90.0F, 90.0F
        );
        return new Rotation(yaw, pitch);
    }

    private static float gcdRound(float delta) {
        float gcd = gcdStep();
        if (gcd <= 1e-5F || Math.abs(delta) < 1e-5F) return 0.0F;
        float steps = Math.round(delta / gcd);
        if (steps == 0 && Math.abs(delta) >= gcd * 0.35F) steps = Math.signum(delta);
        return steps * gcd;
    }

    private static List<Vec3d> multipoints(Vec3d eyes, Box box, float yaw, float pitch) {
