public class WMorzhCheckbox extends WCheckbox implements MorzhWidget {
    private double animationProgress;

    public WMorzhCheckbox(boolean checked) {
        super(checked);
        animationProgress = checked ? 1 : 0;
    }

    @Override
    protected void onRender(
        GuiRenderer renderer,
        double mouseX,
        double mouseY,
        double delta
    ) {
        MorzhGuiThemeBase theme = theme();

        animationProgress += (checked ? 1 : -1)
            * delta
            * (isMorzh(theme) ? 18 : 14);

        animationProgress = MathHelper.clamp(
            animationProgress,
            0,
            1
        );

        if (isMorzh(theme)) {
            renderMorzh(renderer, theme);
        } else {
            renderClassic(renderer, theme);
        }
    }

    private void renderClassic(
        GuiRenderer renderer,
        MorzhGuiThemeBase theme
    ) {
        renderBackground(
            renderer,
            this,
            pressed,
            mouseOver
        );

        if (animationProgress > 0) {
            double size = (width - theme.scale(2))
                / 1.75
                * animationProgress;

            renderer.quad(
                x + (width - size) / 2,
                y + (height - size) / 2,
                size,
                size,
                theme.checkboxColor.get()
            );
        }
    }

    private void renderMorzh(
        GuiRenderer renderer,
        MorzhGuiThemeBase theme
    ) {
        double border = theme.scale(1);

        renderer.quad(
            x,
            y,
            width,
            height,
            theme.backgroundColor.get(pressed, mouseOver)
        );

        renderer.quad(
            x,
            y,
            width,
            border,
            theme.outlineColor.get(pressed, mouseOver)
        );

        renderer.quad(
            x,
            y + height - border,
            width,
            border,
            theme.outlineColor.get(pressed, mouseOver)
        );

        renderer.quad(
            x,
            y,
            border,
            height,
            theme.outlineColor.get(pressed, mouseOver)
        );

        renderer.quad(
            x + width - border,
            y,
            border,
            height,
            theme.outlineColor.get(pressed, mouseOver)
        );

        if (animationProgress > 0) {
            double inset = theme.scale(3);
            double size = Math.max(
                0,
                width - inset * 2
            );

            size *= animationProgress;

            renderer.quad(
                x + width / 2 - size / 2,
                y + height / 2 - size / 2,
                size,
                size,
                GuiRenderer.CIRCLE,
                theme.checkboxColor.get()
            );
        }
    }

    private boolean isMorzh(MorzhGuiThemeBase theme) {
        return "Morzh".equals(theme.name);
    }
