public class CustomPlayerModel extends Module {
    public static final File FOLDER = new File(MorzhClient.FOLDER, "player-models");
    private static final Identifier TEXTURE_ID = MorzhClient.identifier("custom-player-model");
    private static final Identifier MORZH_TEXTURE_ID = MorzhClient.identifier("entity/morzh");

    private final SettingGroup sgGeneral = settings.getDefaultGroup();
    private final SettingGroup sgMorzh = settings.createGroup("Morzh");
    private final SettingGroup sgSkin = settings.createGroup("Skin");
    private final SettingGroup sgEntity = settings.createGroup("Entity");

    private final Setting<Mode> mode = sgGeneral.add(new EnumSetting.Builder<Mode>()
        .name("mode")
        .description("Morzh cube model, Wild-style vanilla mob, or a PNG skin.")
        .defaultValue(Mode.Morzh)
        .onChanged(m -> {
            if (!isActive()) return;
            despawnStandIn();
            if (m == Mode.Skin) loadTexture();
            else if (m == Mode.Entity) spawnStandIn();
            else ensureMorzhTexture();
        })
        .build()
    );

    private final Setting<Target> who = sgGeneral.add(new EnumSetting.Builder<Target>()
        .name("who")
        .description("Whose player model is replaced.")
        .defaultValue(Target.Self)
        .build()
    );

    private final Setting<Keybind> bind = sgGeneral.add(new KeybindSetting.Builder()
        .name("bind")
        .description("Toggle the model on a key. Click, then press the key.")
        .defaultValue(Keybind.none())
        .onChanged(k -> {
            if (k != null) keybind.set(k);
        })
        .build()
    );

    private final Setting<Double> morzhScale = sgMorzh.add(new DoubleSetting.Builder()
        .name("scale")
        .description("Size of the walrus model.")
        .defaultValue(1.2)
        .min(0.4)
        .sliderRange(0.4, 2.5)
        .visible(() -> mode.get() == Mode.Morzh)
        .build()
    );

    private final Setting<String> fileName = sgSkin.add(new StringSetting.Builder()
        .name("file")
        .description("PNG skin in morzh-client/player-models (64x64 or 64x32).")
        .defaultValue("custom.png")
        .visible(() -> mode.get() == Mode.Skin)
        .onChanged(name -> {
            if (isActive() && mode.get() == Mode.Skin) loadTexture();
        })
        .build()
    );

    private final Setting<ArmModel> armModel = sgSkin.add(new EnumSetting.Builder<ArmModel>()
        .name("arms")
        .description("Steve (wide) or Alex (slim) arms.")
        .defaultValue(ArmModel.Keep)
        .visible(() -> mode.get() == Mode.Skin)
        .build()
    );

    private final Setting<Double> scale = sgSkin.add(new DoubleSetting.Builder()
        .name("scale")
        .description("Client-side player model scale.")
        .defaultValue(1.0)
        .min(0.2)
        .sliderRange(0.2, 2.5)
        .visible(() -> mode.get() == Mode.Skin)
        .build()
    );

    private final Setting<EntityKind> entityKind = sgEntity.add(new EnumSetting.Builder<EntityKind>()
