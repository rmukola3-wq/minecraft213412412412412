    private Color shaderColor(float x, float y, float z, float alpha) {
        float time = (System.currentTimeMillis() % 100_000L) / 1000.0F * (float) shaderSpeed.get().doubleValue();
        ShaderKind shader = shaderType.get();

        if (shader == ShaderKind.Stars) {
