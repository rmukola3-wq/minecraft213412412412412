    private static String extractOwnKillVictim(String raw) {
        String text = raw.replaceAll("§.", "").trim();
        String lower = text.toLowerCase(Locale.ROOT);

        if (lower.contains("вас убил")
            || lower.contains("убил вас")
            || lower.contains("убиты")
            || lower.contains("were killed")
            || lower.contains("killed you")
            || lower.contains("slain by")
            || lower.contains("вы умерли")
            || lower.contains("you died")) {
            return null;
        }

        boolean ownKill = lower.contains("вы убили") || lower.contains("you killed");
        if (!ownKill) return null;

        String[] parts = text.split("\\s+");
        for (int i = 0; i < parts.length - 1; i++) {
            String word = stripPunct(parts[i]);
            if (!word.equalsIgnoreCase("убили") && !word.equalsIgnoreCase("killed")) continue;
            String next = stripPunct(parts[i + 1]);
            if (next.equalsIgnoreCase("игрока") && i + 2 < parts.length) {
                return stripPunct(parts[i + 2]);
            }
            if (!next.isEmpty() && !next.equalsIgnoreCase("by") && !next.equalsIgnoreCase("you")) return next;
        }

        return null;
    }

    private static String stripPunct(String word) {
        return word.replaceAll("[!.,;:]+$", "");
    }

