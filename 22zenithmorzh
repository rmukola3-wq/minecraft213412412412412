        List<Row> list = new ArrayList<>();
        if (mc.player == null) return list;
        try {
            ItemCooldownManagerAccessor accessor = (ItemCooldownManagerAccessor) mc.player.getItemCooldownManager();
            int tick = accessor.getTick();
            Map<Item, Object> entries = accessor.getEntries();
            if (entries == null) return list;
            for (Map.Entry<Item, Object> entry : entries.entrySet()) {
                Item item = entry.getKey();
                Object val = entry.getValue();
                if (item == null || item == Items.AIR || val == null) continue;
                int remaining = remainingTicks(val, tick);
                if (remaining <= 0) continue;
                float secs = remaining / 20.0f;
                String time = secs < 10f
                    ? String.format("%.1fs", secs).replace('.', ',')
                    : String.format("%d:%02d", (int) secs / 60, (int) secs % 60);
                String name = ITEM_NAMES.getOrDefault(item, item.getDefaultStack().getName().getString());
                list.add(new Row(item.getDefaultStack(), name, time));
            }
        } catch (Exception ignored) {
        }
        return list;
    }

    private static int remainingTicks(Object entry, int tick) {
        if (endTickField != null) {
            try {
                return endTickField.getInt(entry) - tick;
            } catch (Exception ignored) {
            }
        }
        try {
            Object end = entry.getClass().getMethod("endTick").invoke(entry);
            if (end instanceof Integer i) return i - tick;
        } catch (Exception ignored) {
        }
        return 0;
    }

    private record Row(ItemStack stack, String name, String time) {}
}

