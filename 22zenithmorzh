        if (event.packet instanceof ClientCommandC2SPacket packet) {
            ClientCommandC2SPacket.Mode mode = packet.getMode();
            if (mode == ClientCommandC2SPacket.Mode.START_SPRINTING) lastSprinting = true;
            else if (mode == ClientCommandC2SPacket.Mode.STOP_SPRINTING) lastSprinting = false;
        }
