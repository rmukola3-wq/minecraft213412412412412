package dev.morzh.client.systems.modules.misc.delta;

import dev.morzh.client.events.world.TickEvent;
import dev.morzh.client.systems.modules.Modules;
import dev.morzh.client.systems.modules.misc.AutoBuy;
import dev.morzh.client.utils.player.ChatUtils;
import meteordevelopment.orbit.EventHandler;
import net.minecraft.client.MinecraftClient;
import net.minecraft.client.gui.screen.ingame.GenericContainerScreen;
import net.minecraft.item.Item;
import net.minecraft.item.ItemStack;
import net.minecraft.item.tooltip.TooltipType;
import net.minecraft.screen.ScreenHandler;
import net.minecraft.screen.slot.Slot;
import net.minecraft.screen.slot.SlotActionType;
import net.minecraft.util.Hand;

import java.util.ArrayList;
import java.util.List;

public final class AhParser {
    private static final AhParser INSTANCE = new AhParser();
    private static final MinecraftClient mc = MinecraftClient.getInstance();
    private static final int MAX_PAGES = 2;
    private static final int NEXT_PAGE_SLOT = 50;

    private enum State {
        IDLE, CLOSE, SEARCH, WAIT, SCAN, NEXT_PAGE, WAIT_PAGE, APPLY, NEXT
    }

    private State state = State.IDLE;
    private final List<AutoBuyEntry> queue = new ArrayList<>();
    private int index;
    private int page;
    private int waitTicks;
    private int cheapest;
    private String lastTitle = "";
    private long lastAfk;

    private AhParser() {
    }

    public static AhParser get() {
        return INSTANCE;
    }

    public boolean isRunning() {
        return state != State.IDLE;
    }

    public void toggle() {
        if (isRunning()) stop("Parser остановлен");
        else start();
    }

    public void start() {
        queue.clear();
        for (AutoBuyEntry entry : AutoBuyEntry.values()) {
            if (entry.l()) queue.add(entry);
        }
        if (queue.isEmpty()) {
            ChatUtils.errorPrefix("Parser", "Сначала включи предметы галочкой в редакторе AutoBuy.");
            return;
        }
        AutoBuy autoBuy = Modules.get().get(AutoBuy.class);
        if (autoBuy != null) autoBuy.loadConfig();
        index = 0;
        cheapest = Integer.MAX_VALUE;
        page = 1;
        waitTicks = 0;
        lastTitle = "";
        lastAfk = System.currentTimeMillis();
        ChatUtils.infoPrefix("Parser", "Сканирую %s предметов, скидка %s%% от самой дешёвой цены.", queue.size(), percent());
        state = State.CLOSE;
    }

    public void stop(String reason) {
        state = State.IDLE;
        queue.clear();
        if (reason != null) ChatUtils.infoPrefix("Parser", reason);
    }

    @EventHandler
    private void onTick(TickEvent.Pre event) {
        if (state == State.IDLE || mc.player == null || mc.player.networkHandler == null) return;

        if (System.currentTimeMillis() - lastAfk > 20000L) {
            mc.player.swingHand(Hand.MAIN_HAND);
            lastAfk = System.currentTimeMillis();
        }

        switch (state) {
            case CLOSE -> {
                if (mc.currentScreen != null) {
                    mc.player.closeHandledScreen();
                    waitTicks = 0;
                    return;
                }
                if (++waitTicks >= 4) {
                    waitTicks = 0;
                    state = State.SEARCH;
                }
            }
            case SEARCH -> {
                AutoBuyEntry entry = current();
                if (entry == null) {
                    finish();
                    return;
                }
                cheapest = Integer.MAX_VALUE;
                page = 1;
                lastTitle = "";
                mc.player.networkHandler.sendChatCommand("ah search " + entry.searchQuery());
                waitTicks = 0;
                state = State.WAIT;
            }
            case WAIT -> {
                waitTicks++;
                if (waitTicks > 50) {
                    ChatUtils.warningPrefix("Parser", "Нет выдачи: %s", current().getDisplayName());
                    state = State.NEXT;
                    return;
                }
                if (!(mc.currentScreen instanceof GenericContainerScreen screen)) return;
                String title = screen.getTitle().getString();
                if (emptySearch(title)) {
                    ChatUtils.warningPrefix("Parser", "Не найдено: %s", current().getDisplayName());
                    state = State.NEXT;
                    return;
                }
                if (screen.getScreenHandler().slots.size() < 10) return;
                lastTitle = title;
                state = State.SCAN;
            }
            case SCAN -> {
                if (!(mc.currentScreen instanceof GenericContainerScreen screen)) {
                    state = State.APPLY;
                    return;
                }
                scan(screen);
                if (page < MAX_PAGES && hasNextPage(screen)) {
                    waitTicks = 0;
                    state = State.NEXT_PAGE;
                } else {
                    state = State.APPLY;
                }
            }
            case NEXT_PAGE -> {
                if (++waitTicks < 4) return;
                if (!(mc.currentScreen instanceof GenericContainerScreen screen) || mc.interactionManager == null) {
                    state = State.APPLY;
                    return;
                }
                lastTitle = screen.getTitle().getString();
                mc.interactionManager.clickSlot(screen.getScreenHandler().syncId, NEXT_PAGE_SLOT, 0, SlotActionType.PICKUP, mc.player);
                waitTicks = 0;
                state = State.WAIT_PAGE;
            }
            case WAIT_PAGE -> {
                if (++waitTicks > 30) {
                    state = State.APPLY;
                    return;
                }
                if (!(mc.currentScreen instanceof GenericContainerScreen screen)) {
                    state = State.APPLY;
                    return;
                }
                if (!screen.getTitle().getString().equals(lastTitle)) {
                    page++;
                    state = State.SCAN;
                }
            }
            case APPLY -> {
                AutoBuyEntry entry = current();
                if (entry != null && cheapest < Integer.MAX_VALUE) {
                    int buy = Math.max(1, (int) Math.round(cheapest * (1.0 - percent() / 100.0)));
                    entry.setPrice(buy);
                    AutoBuy autoBuy = Modules.get().get(AutoBuy.class);
                    if (autoBuy != null) autoBuy.saveConfig();
                    ChatUtils.infoPrefix("Parser", "%s: рынок %s → лимит %s (−%s%%)", entry.getDisplayName(), cheapest, buy, percent());
                } else if (entry != null) {
                    ChatUtils.warningPrefix("Parser", "Нет цены: %s", entry.getDisplayName());
                }
                state = State.NEXT;
            }
            case NEXT -> {
                index++;
                if (index >= queue.size()) finish();
                else state = State.CLOSE;
            }
            default -> {
            }
        }
    }

    private void finish() {
        if (mc.player != null && mc.currentScreen != null) mc.player.closeHandledScreen();
        ChatUtils.infoPrefix("Parser", "Готово. Лимиты записаны в редактор AutoBuy.");
        state = State.IDLE;
        queue.clear();
    }

    private AutoBuyEntry current() {
        if (index < 0 || index >= queue.size()) return null;
        return queue.get(index);
    }

    private static int percent() {
        AutoBuy autoBuy = Modules.get().get(AutoBuy.class);
        return autoBuy == null ? 25 : autoBuy.getParserPercent();
    }

    private void scan(GenericContainerScreen screen) {
        AutoBuyEntry entry = current();
        if (entry == null) return;
        ScreenHandler handler = screen.getScreenHandler();
        int end = Math.min(45, Math.max(0, handler.slots.size() - 36));
        for (int i = 0; i < end; i++) {
            Slot slot = handler.slots.get(i);
            ItemStack stack = slot.getStack();
            if (stack.isEmpty() || !entry.a(stack)) continue;
            if (owned(stack)) continue;
            int price = FunTimeAh.unitPrice(stack);
            if (price > 0 && price < cheapest) cheapest = price;
        }
    }

    private static boolean owned(ItemStack stack) {
        if (mc.player == null) return false;
        return stack.getTooltip(Item.TooltipContext.DEFAULT, mc.player, TooltipType.BASIC).stream()
            .anyMatch(line -> line.getString().contains("Нажмите, чтобы забрать"));
    }

    private static boolean emptySearch(String title) {
        String t = title.toLowerCase();
        return t.contains("не найден") || t.contains("ничего") || t.contains("нет результатов") || t.contains("товары не найдены");
    }

    private static boolean hasNextPage(GenericContainerScreen screen) {
        ScreenHandler handler = screen.getScreenHandler();
        if (handler.slots.size() <= NEXT_PAGE_SLOT) return false;
        return !handler.getSlot(NEXT_PAGE_SLOT).getStack().isEmpty();
    }
}

