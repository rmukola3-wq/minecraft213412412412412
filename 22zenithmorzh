        if (mode.get() == Mode.Pulse && syncWithAura.get() && isCombatStrikeImminent()) {
            syncUntilMs = Math.max(syncUntilMs, System.currentTimeMillis() + syncMs.get());
            if (queue.size() >= 2) flush();
        }

        if (mode.get() == Mode.Pulse) {
            long now = System.currentTimeMillis();
            if (now - lastFlushMs >= delayMs.get()) {
                flush();
                lastFlushMs = now;
            }
        }

