            if (Math.abs(pd) >= gcd * 0.35F) {
                sp = gcdRound(MathHelper.clamp(pd, -gcd, gcd));
                if (sp == 0.0F) sp = Math.signum(pd) * gcd;
            }
            if (sy == 0.0F && sp == 0.0F) break;
            yaw += sy;
            pitch = MathHelper.clamp(pitch + sp, -90.0F, 90.0F);
        }
        return new Rotation(yaw, pitch);
    }

