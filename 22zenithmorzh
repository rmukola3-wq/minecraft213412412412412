        for (Entity entity : mc.world.getEntities()) {
            if (!(entity instanceof LivingEntity living) || !filter.matches(living)) continue;
            if (!isValidTarget(living, player, range, walls)) continue;
            double dot = look.dotProduct(living.getPos().subtract(player.getPos()).normalize());
            if (dot <= cos) continue;
            found.add(living);
