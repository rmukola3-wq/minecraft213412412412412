import net.minecraft.util.math.RotationAxis;
import org.joml.Matrix4f;

import java.awt.Color;

import static dev.morzh.client.MorzhClient.mc;

import dev.morzh.client.utils.render.perf.VisualPerf;

public class ChinaHat extends Module {
    private static final float TAU = 6.2831855f;
    private static final float PI = 3.1415927f;

    private final SettingGroup sg = settings.getDefaultGroup();

    private final Setting<SettingColor> color = sg.add(new ColorSetting.Builder()
        .name("color")
        .description("Цвет шляпы.")
        .defaultValue(new SettingColor(129, 103, 255, 255))
        .build()
    );

    private final Setting<SettingColor> friendColor = sg.add(new ColorSetting.Builder()
        .name("friend-color")
        .description("Цвет для друзей.")
        .defaultValue(new SettingColor(0, 255, 0, 255))
        .build()
    );

    private final Setting<Boolean> others = sg.add(new BoolSetting.Builder()
        .name("other-players")
        .defaultValue(true)
        .build()
    );

    public ChinaHat() {
        super(Categories.Render, "china-hat", "Delta China Hat 1:1.");
    }

    public void renderDelta(MatrixStack matrices, VertexConsumerProvider providers, PlayerEntity player, ModelWithHead model) {
        if (!(model instanceof BipedEntityModel<?> bipedModel)) return;
        if (player == mc.player && mc.options.getPerspective().isFirstPerson()) return;

        boolean friend = Friends.get().isFriend(player);
        if (player != mc.player && !friend && !others.get()) return;

        double radius = player.getBoundingBox().maxX - player.getBoundingBox().minX;
        float verticalOffset = !player.getInventory().getArmorStack(3).isEmpty() ? 0.48f : 0.45f;

        int postColor = packedColor(player, friend);
        long time = System.currentTimeMillis();

        matrices.push();
        bipedModel.head.rotate(matrices);
        matrices.translate(0.0f, -verticalOffset, 0.0f);
        matrices.multiply(RotationAxis.NEGATIVE_Z.rotationDegrees(180.0f));
        matrices.multiply(RotationAxis.POSITIVE_Y.rotationDegrees(90.0f));
        Matrix4f matrix = matrices.peek().getPositionMatrix();

        VertexConsumer buffer = providers.getBuffer(RenderLayer.getDebugQuads());

        for (int i = 0; i < VisualPerf.CHINA_HAT_CONE_SEGMENTS; i++) {
            float angle1 = i * TAU / VisualPerf.CHINA_HAT_CONE_SEGMENTS;
            float angle2 = (i + 1) * TAU / VisualPerf.CHINA_HAT_CONE_SEGMENTS;
            int gradientAngle = i * (360 / VisualPerf.CHINA_HAT_CONE_SEGMENTS);
            int col = gradient(3, gradientAngle, postColor, darken(postColor, 0.5f), time);

            float x1 = MathHelper.sin(angle1) * (float) radius;
            float z1 = MathHelper.cos(angle1) * (float) radius;
            float x2 = MathHelper.sin(angle2) * (float) radius;
            float z2 = MathHelper.cos(angle2) * (float) radius;

            vertex(buffer, matrix, x1, 0.0f, z1, col);
            vertex(buffer, matrix, x2, 0.0f, z2, col);
            vertex(buffer, matrix, 0.0f, 0.3f, 0.0f, postColor);
            vertex(buffer, matrix, 0.0f, 0.3f, 0.0f, postColor);
        }

        float radiusOuter = (float) radius + 0.01f;
        float radiusInner = (float) radius - 0.01f;
        float prevOuterX = MathHelper.sin(0.0f) * radiusOuter;
        float prevOuterZ = MathHelper.cos(0.0f) * radiusOuter;
        float prevInnerX = MathHelper.sin(0.0f) * radiusInner;
        float prevInnerZ = MathHelper.cos(0.0f) * radiusInner;

        for (int i = 1; i <= VisualPerf.CHINA_HAT_RIM_SEGMENTS; i++) {
            float angle = i * PI / VisualPerf.CHINA_HAT_RIM_SEGMENTS;
            int gradientAngle = (i - 1) * (180 / VisualPerf.CHINA_HAT_RIM_SEGMENTS);
            int col = gradient(3, gradientAngle, postColor, darken(postColor, 0.5f), time);

            float outerX = MathHelper.sin(angle) * radiusOuter;
            float outerZ = MathHelper.cos(angle) * radiusOuter;
            float innerX = MathHelper.sin(angle) * radiusInner;
            float innerZ = MathHelper.cos(angle) * radiusInner;

            vertex(buffer, matrix, prevOuterX, -0.01f, prevOuterZ, col);
            vertex(buffer, matrix, prevOuterX, 0.0f, prevOuterZ, col);
            vertex(buffer, matrix, outerX, 0.0f, outerZ, col);
            vertex(buffer, matrix, outerX, -0.01f, outerZ, col);

            vertex(buffer, matrix, prevInnerX, 0.0f, prevInnerZ, col);
            vertex(buffer, matrix, innerX, 0.0f, innerZ, col);
            vertex(buffer, matrix, outerX, 0.0f, outerZ, col);
            vertex(buffer, matrix, prevOuterX, 0.0f, prevOuterZ, col);

            prevOuterX = outerX;
            prevOuterZ = outerZ;
            prevInnerX = innerX;
            prevInnerZ = innerZ;
        }

        matrices.pop();

        if (providers instanceof VertexConsumerProvider.Immediate immediate) {
            immediate.draw();
        }
    }

    private int packedColor(PlayerEntity player, boolean friend) {
        if (player == mc.player) return color.get().getPacked();
        if (friend) return friendColor.get().getPacked();
        return color.get().getPacked();
    }

    private static void vertex(VertexConsumer buffer, Matrix4f matrix, float x, float y, float z, int rgba) {
        buffer.vertex(matrix, x, y, z).color((rgba >> 16) & 255, (rgba >> 8) & 255, rgba & 255, (rgba >>> 24) & 255);
    }

    private static int darken(int color, float factor) {
        int a = (color >>> 24) & 255;
        int r = (color >> 16) & 255;
        int g = (color >> 8) & 255;
        int b = color & 255;
        float[] hsb = Color.RGBtoHSB(r, g, b, null);
        hsb[2] = MathHelper.clamp(hsb[2] * factor, 0f, 1f);
        int rgbI = Color.HSBtoRGB(hsb[0], hsb[1], hsb[2]);
        return argb(a, (rgbI >> 16) & 255, (rgbI >> 8) & 255, rgbI & 255);
    }

    private static int argb(int a, int r, int g, int b) {
        return (a << 24) | (r << 16) | (g << 8) | b;
    }

    private static int gradient(int speed, int angle, int startColor, int endColor, long time) {
        float animatedAngle = (angle + (time / 10f)) % 360f;
        float ratio = animatedAngle / 360f;
        float t = (float) ((Math.sin(ratio * Math.PI * 2 * speed) + 1) / 2);
        return lerpArgb(startColor, endColor, t);
    }

    private static int lerpArgb(int start, int end, float t) {
        int a0 = (start >>> 24) & 255;
        int r0 = (start >> 16) & 255;
        int g0 = (start >> 8) & 255;
        int b0 = start & 255;
        int a1 = (end >>> 24) & 255;
        int r1 = (end >> 16) & 255;
        int g1 = (end >> 8) & 255;
        int b1 = end & 255;
        return argb(
            (int) (a0 + (a1 - a0) * t),
            (int) (r0 + (r1 - r0) * t),
            (int) (g0 + (g1 - g0) * t),
            (int) (b0 + (b1 - b0) * t)
        );
    }
}

