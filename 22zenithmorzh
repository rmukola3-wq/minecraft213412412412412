        else if (path.contains("bit"))
            return NoteBlockInstrument.BIT;
        else if (path.contains("banjo"))
            return NoteBlockInstrument.BANJO;
        else if (path.contains("pling"))
            return NoteBlockInstrument.PLING;
        return null;
    }
