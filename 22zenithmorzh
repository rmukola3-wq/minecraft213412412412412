    }

    private static String ticksToTime(int ticks) {
        if (ticks > 20 * 3600) {
            int h = ticks / 20 / 3600;
            return h + " h";
        } else if (ticks > 20 * 60) {
            int m = ticks / 20 / 60;
            return m + " m";
        } else {
            int s = ticks / 20;
            int ms = (ticks % 20) / 2;
            return s + "." + ms + " s";
        }
    }

    @EventHandler
    private void onTick(TickEvent.Post event) {
        entityList.clear();
        itemTags.clear();
        itemClusters.clear();

        boolean freecamNotActive = !Modules.get().isActive(Freecam.class);
        boolean notThirdPerson = mc.options.getPerspective().isFirstPerson();
        Vec3d cameraPos = mc.gameRenderer.getCamera().getPos();
        boolean optimizeItems = itemOptimize.get() && trackItems;
        double itemRangeSq = itemRange.get() * itemRange.get();
        double mergeSize = itemMergeSize.get();
        boolean merge = mergeDrops.get();
        boolean doCull = culling.get();
        double cullRange = maxCullRange.get();

        for (Entity entity : RenderCaches.entities()) {
            EntityType<?> type = entity.getType();
            if (!trackedTypes.contains(type)) continue;

            if (type == EntityType.PLAYER) {
                if ((ignoreSelf.get() || (freecamNotActive && notThirdPerson)) && entity == mc.player) continue;
                if (EntityUtils.getGameMode((PlayerEntity) entity) == null && ignoreBots.get()) continue;
                if (Friends.get().isFriend((PlayerEntity) entity) && ignoreFriends.get()) continue;
            }

            if (type == EntityType.ITEM && optimizeItems) {
                if (cameraPos.squaredDistanceTo(entity.getX(), entity.getY(), entity.getZ()) > itemRangeSq) continue;

                ItemStack stack = ((ItemEntity) entity).getStack();
                if (stack.isEmpty()) continue;

                ItemCell key;
                if (merge) {
                    int ix = MathHelper.floor(entity.getX() / mergeSize);
                    int iy = MathHelper.floor(entity.getY() / mergeSize);
                    int iz = MathHelper.floor(entity.getZ() / mergeSize);
                    key = new ItemCell(Registries.ITEM.getRawId(stack.getItem()), stack.getComponents().hashCode(), ix, iy, iz);
                } else {
                    key = new ItemCell(entity.getId(), 0, 0, 0, 0);
                }

                ItemCluster cluster = itemClusters.get(key);
                if (cluster == null) {
                    cluster = new ItemCluster();
                    cluster.stack = stack;
                    itemClusters.put(key, cluster);
                }

                int amount = Math.max(1, stack.getCount());
                cluster.x += entity.getX();
                cluster.y += entity.getY() + getHeight(entity);
                cluster.z += entity.getZ();
                cluster.n++;
                cluster.count += amount;
                continue;
            }

            if (!doCull || PlayerUtils.isWithinCamera(entity, cullRange)) {
                entityList.add(entity);
            }
        }

        if (doCull) entityList.sort(Comparator.comparing(e -> e.squaredDistanceTo(cameraPos)));

        if (optimizeItems && !itemClusters.isEmpty()) {
            for (ItemCluster cluster : itemClusters.values()) {
                double inv = 1.0 / cluster.n;
                itemTags.add(new ItemTag(cluster.x * inv, cluster.y * inv, cluster.z * inv, cluster.stack, cluster.count));
            }

            itemTags.sort(Comparator.comparingDouble(tag -> {
                double dx = tag.x - cameraPos.x;
                double dy = tag.y - cameraPos.y;
                double dz = tag.z - cameraPos.z;
                return dx * dx + dy * dy + dz * dz;
            }));

            int max = Math.min(itemMaxCount.get(), itemTags.size());
            if (itemTags.size() > max) itemTags.subList(max, itemTags.size()).clear();
        }
    }

    @EventHandler
    private void onRender2D(Render2DEvent event) {
        int count = getRenderCount();
        boolean shadow = Config.get().customFont.get();
        double tagScale = scale.get();

        for (int i = count - 1; i > -1; i--) {
            Entity entity = entityList.get(i);

            Utils.set(pos, entity, event.tickDelta);
            pos.add(0, getHeight(entity), 0);

            EntityType<?> type = entity.getType();

            if (NametagUtils.to2D(pos, tagScale)) {
                if (type == EntityType.PLAYER) renderNametagPlayer(event, (PlayerEntity) entity, shadow);
                else if (type == EntityType.ITEM) {
                    ItemStack stack = ((ItemEntity) entity).getStack();
                    renderNametagItem(stack, stack.getCount(), shadow);
                }
                else if (type == EntityType.ITEM_FRAME || type == EntityType.GLOW_ITEM_FRAME) {
                    ItemStack stack = ((ItemFrameEntity) entity).getHeldItemStack();
                    renderNametagItem(stack, stack.getCount(), shadow);
                }
                else if (type == EntityType.TNT) renderTntNametag(ticksToTime(((TntEntity) entity).getFuse()), shadow);
                else if (type == EntityType.TNT_MINECART && ((TntMinecartEntity) entity).isPrimed())
                    renderTntNametag(ticksToTime(((TntMinecartEntity) entity).getFuseTicks()), shadow);
                else if (entity instanceof LivingEntity) renderGenericLivingNametag((LivingEntity) entity, shadow);
                else renderGenericNametag(entity, shadow);
            }
        }

        for (int i = itemTags.size() - 1; i > -1; i--) {
            ItemTag tag = itemTags.get(i);
            pos.set(tag.x, tag.y, tag.z);
            if (NametagUtils.to2D(pos, tagScale)) renderNametagItem(tag.stack, tag.count, shadow);
        }
    }

    private int getRenderCount() {
        int count = culling.get() ? maxCullCount.get() : entityList.size();
        count = MathHelper.clamp(count, 0, entityList.size());

        return count;
    }

    @Override
    public String getInfoString() {
        return Integer.toString(getRenderCount() + itemTags.size());
    }

    private double getHeight(Entity entity) {
        double height = entity.getEyeHeight(entity.getPose());

        if (entity.getType() == EntityType.ITEM || entity.getType() == EntityType.ITEM_FRAME || entity.getType() == EntityType.GLOW_ITEM_FRAME) height += 0.2;
        else height += 0.5;

        return height;
    }

    private void renderNametagPlayer(Render2DEvent event, PlayerEntity player, boolean shadow) {
