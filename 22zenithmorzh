        .name("smash-attack")
        .description("Smash-атака булавой.")
        .defaultValue(true)
        .build()
    );

    private final Setting<Double> extraHeight = sgMace.add(new DoubleSetting.Builder()
        .name("additional-height")
        .description("Доп. высота для булавы.")
        .defaultValue(0.0)
        .min(0)
        .sliderRange(0, 100)
        .visible(mace::get)
        .build()
    );

    private PlayerInteractEntityC2SPacket attackPacket;
    private HandSwingC2SPacket swingPacket;
    private boolean sendPackets;
    private int sendTimer;

    public Criticals() {
        super(Categories.Combat, "criticals", "Критические удары (Rockstar / LB / Morzh).");
    }

    @Override
    public void onActivate() {
        attackPacket = null;
        swingPacket = null;
        sendPackets = false;
        sendTimer = 0;
    }

    @EventHandler
    private void onAttack(AttackEntityEvent event) {
        if (mode.get() == Mode.None || skipCrit()) return;
        if (!(event.entity instanceof LivingEntity living)) return;
        if (!shouldCritTarget(living)) return;

        if (mace.get() && mc.player.getMainHandStack().getItem() instanceof MaceItem) {
            if (mc.player.isGliding()) return;
            sendOffset(0);
            sendOffset(1.501 + extraHeight.get());
            sendOffset(0);
            return;
        }

        switch (mode.get()) {
            case Grim -> applyGrim();
            case Vanilla -> applyVanilla();
            case NCP -> applyNcp();
            case Funtime -> applyFuntime();
            case Spooky -> applySpooky();
            case Packet -> {
                sendOffset(0.0625);
                sendOffset(0);
            }
            case RW -> applyRw();
            case Jump, MiniJump -> {  }
            case None -> { }
        }
    }

    @EventHandler
    private void onSendPacket(PacketEvent.Send event) {
        if (mode.get() != Mode.Jump && mode.get() != Mode.MiniJump) return;

        if (event.packet instanceof IPlayerInteractEntityC2SPacket packet
            && packet.morzh$getType() == PlayerInteractEntityC2SPacket.InteractType.ATTACK) {
            if (skipCrit()) return;

            Entity entity = packet.morzh$getEntity();
            if (!(entity instanceof LivingEntity living) || !shouldCritTarget(living)) return;

            if (!sendPackets) {
                sendPackets = true;
                sendTimer = mode.get() == Mode.Jump ? 6 : 4;
                attackPacket = (PlayerInteractEntityC2SPacket) event.packet;

                if (mode.get() == Mode.Jump) mc.player.jump();
                else ((IVec3d) mc.player.getVelocity()).morzh$setY(0.25);

                event.cancel();
            }
        } else if (event.packet instanceof HandSwingC2SPacket && sendPackets && swingPacket == null) {
            if (skipCrit()) return;
            swingPacket = (HandSwingC2SPacket) event.packet;
            event.cancel();
        }
    }

    @EventHandler
    private void onTick(TickEvent.Pre event) {
        if (!sendPackets) return;

        if (sendTimer <= 0) {
            sendPackets = false;
            if (attackPacket == null || swingPacket == null) return;
            mc.getNetworkHandler().sendPacket(attackPacket);
            mc.getNetworkHandler().sendPacket(swingPacket);
            attackPacket = null;
            swingPacket = null;
        } else {
            sendTimer--;
        }
    }

    private void applyGrim() {
        if (!mc.player.isOnGround()) {
            sendOffset(-EPS);
            sendOffset(EPS);
            sendOffset(0);
        } else {
            sendOffset(EPS);
            sendOffset(0);
        }
    }

    private void applyVanilla() {
        if (!mc.player.isOnGround()) sendOffset(-EPS);
        else {
            sendOffset(EPS, true);
            sendOffset(0);
        }
    }

    private void applyNcp() {
        sendOffset(0.11);
        sendOffset(0.1100013579);
        sendOffset(0.0000013579);
    }

    private void applyFuntime() {
        if (mc.player.hurtTime != 0) return;
        sendOffset(EPS, true);
        sendOffset(0);
    }

    private void applySpooky() {
        if (!mc.player.isOnGround()) sendOffset(-EPS);
        else {
            sendOffset(EPS);
            sendOffset(0);
        }
    }

    private void applyRw() {
        sendOffset(0.0625);
        sendOffset(0.1);
        sendOffset(0.15);
        sendOffset(0.1);
        sendOffset(0.0625);
        sendOffset(0);
    }

    private void sendOffset(double height) {
        sendOffset(height, false);
    }

    private void sendOffset(double height, boolean onGround) {
        PlayerMoveC2SPacket packet = new PlayerMoveC2SPacket.Full(
            mc.player.getX(),
            mc.player.getY() + height,
            mc.player.getZ(),
            mc.player.getYaw(),
            mc.player.getPitch(),
            onGround,
            mc.player.horizontalCollision
        );
        ((IPlayerMoveC2SPacket) packet).morzh$setTag(1337);
        mc.player.networkHandler.sendPacket(packet);
    }

    private boolean shouldCritTarget(LivingEntity entity) {
        if (!onlyKillAura.get()) return true;

        KillAura killAura = Modules.get().get(KillAura.class);
        if (killAura != null && killAura.isActive() && entity == killAura.getTarget()) return true;

        ExpensiveAura expensiveAura = Modules.get().get(ExpensiveAura.class);
        return expensiveAura != null && expensiveAura.isActive() && entity == expensiveAura.target;
    }

    private boolean skipCrit() {
        if (mc.player == null) return true;

        KillAura killAura = Modules.get().get(KillAura.class);
        if (killAura != null && killAura.isManagingCriticals()) return true;

        AirCrits airCrits = Modules.get().get(AirCrits.class);
        if (airCrits != null && airCrits.isFrozen()) return false;

        if (mode.get() == Mode.RW) {
            boolean slowFalling = mc.player.hasStatusEffect(StatusEffects.SLOW_FALLING);
            boolean inCobweb = mc.world.getBlockState(BlockPos.ofFloored(mc.player.getPos())).isOf(Blocks.COBWEB);
            return !(slowFalling || inCobweb);
        }

        return !mc.player.isOnGround()
            || mc.player.isSubmergedInWater()
            || mc.player.isInLava()
            || mc.player.isClimbing();
    }

