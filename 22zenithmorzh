            || mc.currentScreen instanceof SignEditScreen
            || mc.currentScreen instanceof AnvilScreen
            || mc.currentScreen instanceof AbstractCommandBlockScreen
            || mc.currentScreen instanceof StructureBlockScreen;
    }
