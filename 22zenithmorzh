        for (PotionEntity potion : mc.world.getEntitiesByClass(PotionEntity.class, box, e -> true)) {
            if (potion.squaredDistanceTo(mc.player) <= 16.0) return true;
        }
        return false;
    }

    private int findPotionSlot() {
        if (mc.player == null) return -1;

        if (!preferStrong.get()) {
            for (int i = 0; i < 9; i++) {
                if (isHealSplash(mc.player.getInventory().getStack(i))) return i;
            }
            for (int i = 9; i < 36; i++) {
                if (isHealSplash(mc.player.getInventory().getStack(i))) return i;
            }
            return -1;
        }

        int best = -1;
        int bestAmp = -1;
        for (int i = 0; i < 36; i++) {
            int amp = healAmplifier(mc.player.getInventory().getStack(i));
            if (amp < 0) continue;
            if (amp > bestAmp) {
                bestAmp = amp;
                best = i;
            }
        }
        return best;
    }

    private int bestInventoryPotion() {
        if (mc.player == null) return -1;

        if (!preferStrong.get()) {
            for (int i = 9; i < 36; i++) {
                if (isHealSplash(mc.player.getInventory().getStack(i))) return i;
            }
            return -1;
        }

        int best = -1;
        int bestAmp = -1;
        for (int i = 9; i < 36; i++) {
            int amp = healAmplifier(mc.player.getInventory().getStack(i));
            if (amp < 0) continue;
            if (amp > bestAmp) {
                bestAmp = amp;
                best = i;
            }
        }
        return best;
    }

    private int pickTempHotbarSlot() {
        for (int i = 0; i < 9; i++) {
            if (mc.player.getInventory().getStack(i).isEmpty()) return i;
        }
        return 8;
    }

    private boolean refillHotbar() {
        if (mc.player == null || mc.player.currentScreenHandler.getStacks().size() != 46) return false;

        int emptyHotbar = -1;
        for (int i = 0; i < 9; i++) {
            if (mc.player.getInventory().getStack(i).isEmpty()) {
                emptyHotbar = i;
                break;
            }
        }
        if (emptyHotbar == -1) return false;

        int from = bestInventoryPotion();
        if (from == -1) return false;

        InvUtils.move().from(from).toHotbar(emptyHotbar);
        return true;
    }

    private boolean isHealSplash(ItemStack stack) {
        return healAmplifier(stack) >= 0;
    }

    private int healAmplifier(ItemStack stack) {
        if (stack == null || stack.isEmpty() || !stack.isOf(Items.SPLASH_POTION)) return -1;

        PotionContentsComponent contents = stack.get(DataComponentTypes.POTION_CONTENTS);
        if (contents == null) return -1;

        int amp = -1;
        for (StatusEffectInstance effect : contents.getEffects()) {
            if (effect.getEffectType() != StatusEffects.INSTANT_HEALTH) continue;
            amp = Math.max(amp, effect.getAmplifier());
        }
        return amp;
    }

    private void releaseRotation() {
        if (expensiveAuraActive()) {
            PlayerRotationManager.INSTANCE.cancelTasksFor(this);
        } else {
            AngleConnection.INSTANCE.startReturning();
        }
    }

    private void resetState() {
