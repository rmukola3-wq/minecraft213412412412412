        if (
            orbit.get()
                && !shouldStabilize()
        ) {
            double step = Math.toRadians(
                orbitDegrees.get()
            );

            orbitAngle += orbitClockwise
                ? step
                : -step;

            orbitAngle %= Math.PI * 2;
