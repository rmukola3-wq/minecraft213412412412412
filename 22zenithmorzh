    private boolean shouldFlushNow(Packet<?> packet) {
        return packet instanceof PlayerInteractEntityC2SPacket
            || packet instanceof PlayerInteractBlockC2SPacket
            || packet instanceof PlayerInteractItemC2SPacket
            || packet instanceof UpdateSelectedSlotC2SPacket
            || packet instanceof ClickSlotC2SPacket;
    }

    private void flush() {
        if (queue.isEmpty()) {
            if (mc.player != null) serverPos = mc.player.getPos();
            updateGhost();
            return;
        }

        if (mc.getNetworkHandler() == null) {
            queue.clear();
            return;
        }

        PacketBypass.runSilently(() -> {
            Packet<?> packet;
            while ((packet = queue.poll()) != null) {
                mc.getNetworkHandler().getConnection().send(packet, null);
            }
