    @EventHandler(priority = EventPriority.LOWEST - 2000)
    private void onAirAttack(TickEvent.Post event) {
        if (
            !airAttack.get()
                || !canControl()
                || mc.interactionManager == null
                || mc.getNetworkHandler() == null
                || mc.player.isUsingItem()
                || mc.player.getAttackCooldownProgress(0.5f)
                < airAttackCooldown.get()
        ) {
            return;
        }

        Box targetBox = getServerTargetBox();

        if (
            distanceToBox(
                mc.player.getEyePos(),
                targetBox
            ) > airAttackRange.get()
        ) {
            return;
        }

        Vec3d aimPoint = new Vec3d(
            (targetBox.minX + targetBox.maxX) * 0.5,
            targetBox.minY
                + (targetBox.maxY - targetBox.minY) * 0.55,
            (targetBox.minZ + targetBox.maxZ) * 0.5
        );

        Vec3d delta =
            aimPoint.subtract(mc.player.getEyePos());

        float yaw = (float) (
            Math.toDegrees(
                Math.atan2(delta.z, delta.x)
            ) - 90
        );

        float pitch = (float) -Math.toDegrees(
            Math.atan2(
                delta.y,
                Math.hypot(delta.x, delta.z)
            )
        );

        pitch = MathHelper.clamp(
            pitch,
            -89,
            89
        );

        float originalYaw = mc.player.getYaw();
        float originalPitch = mc.player.getPitch();

        mc.getNetworkHandler().sendPacket(
            new PlayerMoveC2SPacket.Full(
                mc.player.getX(),
                mc.player.getY(),
                mc.player.getZ(),
                yaw,
                pitch,
                mc.player.isOnGround(),
                mc.player.horizontalCollision
            )
        );

        mc.interactionManager.attackEntity(
            mc.player,
            target
        );

        mc.player.swingHand(Hand.MAIN_HAND);

        if (returnRotation.get()) {
            mc.getNetworkHandler().sendPacket(
                new PlayerMoveC2SPacket.Full(
                    mc.player.getX(),
                    mc.player.getY(),
                    mc.player.getZ(),
                    originalYaw,
                    originalPitch,
                    mc.player.isOnGround(),
                    mc.player.horizontalCollision
                )
            );
        }
    }

    private void updateTarget() {
        PlayerEntity locked = null;

        if (targetUuid != null) {
            locked = mc.world.getPlayerByUuid(
                targetUuid
            );
        }

        if (
            targetLock.get()
                && isValidTarget(locked)
        ) {
            target = locked;
            missingTicks = 0;
            return;
        }

        if (
            targetLock.get()
                && locked == null
                && target != null
                && target.isAlive()
                && !target.isRemoved()
                && missingTicks < lostGraceTicks.get()
        ) {
            missingTicks++;
            return;
        }

        LivingEntity auraTarget =
            getAuraTarget();

        if (auraTarget != null) {
            setTarget(auraTarget);
            return;
        }

        setTarget(findTarget());
    }

    private Vec3d calculateVelocity() {
        if (
            mc.player == null
                || target == null
        ) {
            return null;
        }

        Vec3d playerCenter =
            mc.player.getBoundingBox().getCenter();

        boolean grounded = isTargetGrounded();
        boolean stabilize = shouldStabilize();

        Vec3d predictedCenter =
            getPredictedTargetCenter(
                grounded,
                stabilize
            );

        double radius =
            orbit.get()
                ? orbitRadius.get()
                : 0.65;

        double desiredX =
            predictedCenter.x
                + Math.cos(orbitAngle) * radius;

        double desiredZ =
            predictedCenter.z
                + Math.sin(orbitAngle) * radius;

        double desiredY =
            predictedCenter.y
                + heightOffset.get();

        if (grounded) {
            desiredY += groundHover.get();
        }

        Vec3d correction = new Vec3d(
            desiredX - playerCenter.x,
            desiredY - playerCenter.y,
            desiredZ - playerCenter.z
        );

        double horizontal = Math.hypot(
            correction.x,
            correction.z
        );

        double velocityX = correction.x;
        double velocityZ = correction.z;

        if (
            horizontal > attachmentSpeed.get()
                && horizontal > 1.0E-5
        ) {
            double scale =
                attachmentSpeed.get() / horizontal;

            velocityX *= scale;
            velocityZ *= scale;
        }

        double velocityY = MathHelper.clamp(
            correction.y,
            -verticalSpeed.get(),
            verticalSpeed.get()
        );

        return protectFromBlocks(
            new Vec3d(
                velocityX,
                velocityY,
                velocityZ
            )
        );
    }

    private Vec3d getPredictedTargetCenter(
        boolean grounded,
        boolean stabilize
    ) {
        ServerTrack track =
            SERVER_TRACKS.get(target.getId());

        Vec3d base;
        Vec3d velocity;
        Vec3d acceleration;

        if (track != null) {
            base = track.position;
            velocity = track.velocity;
            acceleration = track.acceleration;
        } else {
            base = target.getPos();
            velocity = target.getVelocity();
            acceleration = Vec3d.ZERO;
        }

        if (
            grounded
                && disableGroundPrediction.get()
        ) {
            velocity = new Vec3d(
                velocity.x,
                0,
                velocity.z
            );

            acceleration = new Vec3d(
                acceleration.x,
                0,
                acceleration.z
            );
        }

        Vec3d center = base.add(
            0,
            target.getHeight() * 0.5,
            0
        );

        if (stabilize) {
            return center;
        }

        double ticks =
            predictionTicks.get()
                + getTargetPing()
                / 50.0
                * pingInfluence.get();

        Vec3d lead = velocity.multiply(ticks);

        lead = lead.add(
            acceleration.multiply(
                0.5
                    * ticks
                    * ticks
                    * accelerationInfluence.get()
            )
        );

        double horizontalLead = Math.hypot(
            lead.x,
            lead.z
        );

        double leadX = lead.x;
        double leadZ = lead.z;

        if (
            horizontalLead > maximumHorizontalLead.get()
                && horizontalLead > 1.0E-5
        ) {
            double scale =
                maximumHorizontalLead.get()
                    / horizontalLead;

            leadX *= scale;
            leadZ *= scale;
        }

        double leadY = grounded
            ? 0
            : MathHelper.clamp(
            lead.y,
            -maximumVerticalLead.get(),
            maximumVerticalLead.get()
        );

        return center.add(
            leadX,
            leadY,
            leadZ
        );
    }

    private boolean isTargetGrounded() {
        if (
            target == null
                || mc.world == null
        ) {
            return false;
        }

        if (target.isOnGround()) {
            return true;
        }

        Box below = target
            .getBoundingBox()
            .stretch(0, -0.15, 0);

        return !mc.world.isSpaceEmpty(below);
    }

    private Vec3d protectFromBlocks(Vec3d desired) {
        if (isPathClear(desired)) {
            return desired;
        }

        reverseOrbit();

        for (
            double climb = 0.5;
            climb <= maximumClimb.get();
            climb += 0.5
        ) {
            Vec3d escape = new Vec3d(
                desired.x * 0.35,
                Math.max(escapeSpeed.get(), climb),
                desired.z * 0.35
            );

            if (isPathClear(escape)) {
                return escape;
            }
        }

        Vec3d verticalEscape = new Vec3d(
            0,
            escapeSpeed.get(),
            0
        );

        if (isPathClear(verticalEscape)) {
            return verticalEscape;
        }

        return Vec3d.ZERO;
    }

    private boolean isPathClear(Vec3d movement) {
        if (
            mc.player == null
                || mc.world == null
        ) {
            return false;
        }

        int steps = Math.max(
            1,
            (int) Math.ceil(
                movement.length()
                    / collisionStep.get()
            )
        );

        Box box = mc.player.getBoundingBox();

        for (int i = 1; i <= steps; i++) {
            double progress =
                (double) i / steps;

            Box moved = box.offset(
                movement.x * progress,
                movement.y * progress,
                movement.z * progress
            );

            if (!mc.world.isSpaceEmpty(moved)) {
                return false;
            }
        }

        return true;
    }

    private void reverseOrbit() {
        if (collisionCooldown > 0) return;

        orbitClockwise = !orbitClockwise;
        collisionCooldown = 4;
    }

    private Box getServerTargetBox() {
        ServerTrack track =
            SERVER_TRACKS.get(target.getId());

        if (track == null) {
            return target.getBoundingBox();
        }

        Vec3d offset =
            track.position.subtract(
                target.getPos()
            );

        return target.getBoundingBox().offset(
            offset.x,
            offset.y,
            offset.z
        );
    }

    private double distanceToBox(
        Vec3d point,
        Box box
    ) {
        double x = MathHelper.clamp(
            point.x,
            box.minX,
            box.maxX
        );

        double y = MathHelper.clamp(
            point.y,
            box.minY,
            box.maxY
        );

        double z = MathHelper.clamp(
            point.z,
            box.minZ,
            box.maxZ
        );

        return point.distanceTo(
            new Vec3d(x, y, z)
        );
    }

    private LivingEntity getAuraTarget() {
        if (!syncAura.get()) return null;

        KillAura aura =
            Modules.get().get(KillAura.class);

        if (
            aura == null
                || !aura.isActive()
        ) {
            return null;
        }

        Entity auraTarget = aura.getTarget();

        if (
            auraTarget instanceof LivingEntity living
                && isValidTarget(living)
        ) {
            return living;
        }

        return null;
    }

    private PlayerEntity findTarget() {
        PlayerEntity best = null;
        double bestScore = Double.MAX_VALUE;

        for (PlayerEntity player : mc.world.getPlayers()) {
            if (!isValidTarget(player)) continue;

            double horizontal = Math.hypot(
                player.getX() - mc.player.getX(),
                player.getZ() - mc.player.getZ()
            );

            double vertical = Math.abs(
                player.getY() - mc.player.getY()
            );

            double score =
                horizontal + vertical * 0.25;

            if (score < bestScore) {
                bestScore = score;
                best = player;
            }
        }

        return best;
    }

    private boolean isValidTarget(
        LivingEntity entity
    ) {
        if (
            mc.player == null
                || mc.world == null
                || !(entity instanceof PlayerEntity player)
                || entity == mc.player
                || !entity.isAlive()
                || entity.isRemoved()
                || entity.getHealth() <= 0
                || player.isCreative()
                || player.isSpectator()
        ) {
            return false;
        }

        if (!Friends.get().shouldAttack(player)) {
            return false;
        }

        if (
            requireTabList.get()
                && mc.getNetworkHandler() != null
        ) {
            PlayerListEntry entry =
                mc.getNetworkHandler()
                    .getPlayerListEntry(
                        player.getUuid()
                    );

            if (entry == null) return false;
        }

        double horizontal = Math.hypot(
            player.getX() - mc.player.getX(),
            player.getZ() - mc.player.getZ()
        );

        double vertical = Math.abs(
            player.getY() - mc.player.getY()
        );

        return horizontal <= horizontalRange.get()
            && vertical <= verticalRange.get();
    }

    private int getTargetPing() {
        if (
            !(target instanceof PlayerEntity player)
                || mc.getNetworkHandler() == null
        ) {
            return 0;
        }

        PlayerListEntry entry =
            mc.getNetworkHandler()
                .getPlayerListEntry(
                    player.getUuid()
                );

        return entry == null
            ? 0
            : Math.max(0, entry.getLatency());
    }

    private boolean shouldStabilize() {
        if (
            !stabilizeAttack.get()
                || mc.player == null
                || target == null
        ) {
            return false;
        }

        KillAura aura =
            Modules.get().get(KillAura.class);

        if (
            aura == null
                || !aura.isActive()
                || aura.getTarget() != target
        ) {
            return false;
        }

        return mc.player.getAttackCooldownProgress(0.5f)
            >= stabilizeProgress.get();
    }

    private boolean canRun() {
        if (
            mc.player == null
                || mc.world == null
                || !mc.player.isAlive()
        ) {
            return false;
        }

        Flight flight =
            Modules.get().get(Flight.class);

        return flight != null
            && flight.isActive();
    }

    private boolean canControl() {
        return canRun()
            && target != null
            && target.isAlive()
            && !target.isRemoved();
    }

    private void setTarget(
        LivingEntity newTarget
    ) {
        if (newTarget == target) return;

        target = newTarget;
        targetUuid =
            newTarget == null
                ? null
                : newTarget.getUuid();

        missingTicks = 0;

        if (
            target == null
                || mc.player == null
        ) {
            orbitAngle = 0;
            return;
        }

        Vec3d playerCenter =
            mc.player.getBoundingBox().getCenter();

        Vec3d targetCenter =
            target.getBoundingBox().getCenter();

        orbitAngle = Math.atan2(
            playerCenter.z - targetCenter.z,
            playerCenter.x - targetCenter.x
        );
    }

    private void clearTarget(boolean stop) {
        if (
            stop
                && controlling
                && mc.player != null
        ) {
            mc.player.setVelocity(Vec3d.ZERO);
        }

        target = null;
        targetUuid = null;
        orbitAngle = 0;
        missingTicks = 0;
        controlling = false;
    }

    public LivingEntity getTarget() {
        return target;
    }

    @Override
    public String getInfoString() {
        return target == null
            ? "Searching"
            : "Attached "
              + target.getName().getString();
    }

    private static final class ServerTrack {
        private volatile Vec3d position;
        private volatile Vec3d velocity;
        private volatile Vec3d acceleration;
        private volatile long updateTime;

        private ServerTrack(
            Vec3d position,
            Vec3d velocity,
            long updateTime
        ) {
            this.position = position;
            this.velocity = velocity;
            this.acceleration = Vec3d.ZERO;
            this.updateTime = updateTime;
        }

        private synchronized void update(
            Vec3d newPosition,
            long now
        ) {
            double elapsedTicks = MathHelper.clamp(
                (now - updateTime) / 50_000_000.0,
                0.25,
                10
            );

            Vec3d newVelocity =
                newPosition.subtract(position)
                    .multiply(1.0 / elapsedTicks);

            Vec3d newAcceleration =
                newVelocity.subtract(velocity)
                    .multiply(1.0 / elapsedTicks);

            position = newPosition;
            velocity = newVelocity;
            acceleration = newAcceleration;
            updateTime = now;
        }
    }
