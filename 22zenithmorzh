        float baseYaw = current.getYaw() + diffYaw * pull;
        float basePitch = current.getPitch() + diffPitch * pull;

        float helixYaw = (float) (Math.sin(now * 18.0) * 14.0 + Math.cos(now * 9.0) * 6.0) * helixScale;
