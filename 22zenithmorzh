                && cached.pingMs == info.ping
                && cached.label == info.label
                && cached.playersLabel == info.playerCountLabel) {
            return cached;
        }

        String motdSrc = info.label != null ? info.label.getString() : (info.address != null ? info.address : "");
        if (motdSrc.length() > 64) motdSrc = motdSrc.substring(0, 64);

        CachedLine line = new CachedLine();
