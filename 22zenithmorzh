            return;
        }
        String cmd = command.get().trim();
        if (cmd.startsWith("/")) cmd = cmd.substring(1);
        if (!cmd.isEmpty()) mc.player.networkHandler.sendChatCommand(cmd);
        pending = false;
    }

    private static boolean isTpRequest(String msg) {
        return msg.contains("телепорт") || msg.contains("телепортац") || msg.contains("tpa")
            || msg.contains("tpaccept") || msg.contains("хочет телепортироваться")
            || msg.contains("просит телепортироваться") || msg.contains("requested to teleport");
    }

    private static boolean mentionsFriend(String msg) {
        for (Friend friend : Friends.get()) {
            if (friend.name != null && !friend.name.isEmpty() && msg.contains(friend.name.toLowerCase(Locale.ROOT))) {
                return true;
            }
        }
        return false;
    }
