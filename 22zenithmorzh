        boolean attackReady =
            aura.canCritical()
                && aura.attackTimerPassed(300);

        float yawDelta = MathHelper.wrapDegrees(
            desired[0] - yaw
        );

        float pitchDelta =
            desired[1] - pitch;

        float yawStep =
            attackReady ? 180 : 70;

