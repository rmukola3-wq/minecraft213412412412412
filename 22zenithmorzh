            float sp = 0.0F;
            if (Math.abs(yd) >= gcd * 0.35F) {
                sy = gcdRound(MathHelper.clamp(yd, -gcd, gcd));
                if (sy == 0.0F) sy = Math.signum(yd) * gcd;
