        if (tempHotbarSlot < 0) tempHotbarSlot = pickTempHotbarSlot();
        movedFromSlot = slot;
        InvUtils.move().from(slot).toHotbar(tempHotbarSlot);
        movedIn = true;

        if (tempHotbarSlot != serverSelectedSlot()) {
            oldSelectedSlot = mc.player.getInventory().selectedSlot;
            selectSlotServer(tempHotbarSlot);
            swapped = true;
        }
        return 1;
    }

