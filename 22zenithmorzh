        for (Vec3d point : multipoints(eyes, strict, current.getYaw(), current.getPitch())) {
            Rotation aimed = gcdLoopToward(best, eyes, point, strict, range, hitFinishSteps);
            if (WorldRaycastUtils.lookHits(aimed.getYaw(), aimed.getPitch(), range, strict)) {
                return aimed;
            }
            best = aimed;
        }
