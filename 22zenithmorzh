        if (effects.get()) {
            fakePlayer.addStatusEffect(new StatusEffectInstance(StatusEffects.REGENERATION, 9999, 2));
            fakePlayer.addStatusEffect(new StatusEffectInstance(StatusEffects.ABSORPTION, 9999, 4));
            fakePlayer.addStatusEffect(new StatusEffectInstance(StatusEffects.RESISTANCE, 9999, 1));
        }

        if (autoTotem.get()) {
            fakePlayer.setStackInHand(Hand.OFF_HAND, new ItemStack(Items.TOTEM_OF_UNDYING));
        }
    }

    private void removeFakePlayer() {
        FakePlayerManager.clear();
        fakePlayer = null;
    }

    private float getDamage() {
        ItemStack weapon = mc.player.getMainHandStack();
        float base = weapon.isEmpty() ? 1.0f : 6.0f;
        if (mc.player.fallDistance > 0) base *= 1.5f;
        return base;
    }

    private float calcExplosionDamage(Vec3d explosionPos) {
        double distance = fakePlayer.getPos().distanceTo(explosionPos);
        float power = 6.0f;
        float exposure = (float) Math.max(0.0, 1.0 - distance / (power * 2.0f));
        return (exposure * exposure + exposure) / 2.0f * 7.0f * power * 2.0f + 1.0f;
    }

    private boolean tryUseTotem() {
        if (fakePlayer == null) return false;
        ItemStack offhand = fakePlayer.getOffHandStack();
        if (!offhand.isOf(Items.TOTEM_OF_UNDYING)) return false;

        offhand.decrement(1);
        fakePlayer.clearStatusEffects();
        fakePlayer.setHealth(1.0f);
        fakePlayer.setAbsorptionAmount(Math.max(fakePlayer.getAbsorptionAmount(), 8.0f));
        fakePlayer.addStatusEffect(new StatusEffectInstance(StatusEffects.REGENERATION, 900, 1));
        fakePlayer.addStatusEffect(new StatusEffectInstance(StatusEffects.ABSORPTION, 100, 1));
        fakePlayer.addStatusEffect(new StatusEffectInstance(StatusEffects.FIRE_RESISTANCE, 800, 0));
        mc.world.sendEntityStatus(fakePlayer, (byte) 35);
        return true;
    }

    public FakePlayerEntity getFakePlayer() {
        return fakePlayer;
    }

    @Override
    public String getInfoString() {
        return name.get().name();
    }

    private record PlayerState(double x, double y, double z, float yaw, float pitch) {}
}

