        ((ItemCooldownManager) (Object) this).set(Identifier.of("delta", "heal"), duration);
    }

    @Inject(method = {"getGroup"}, at = {@At("HEAD")}, cancellable = true)
    private void getGroup(ItemStack stack, CallbackInfoReturnable<Identifier> cir) {
