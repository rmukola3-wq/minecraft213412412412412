package meteordevelopment.meteorclient.systems.modules.combat.aura.rasty.util.math;

import meteordevelopment.meteorclient.systems.modules.Module;

import java.util.PriorityQueue;

public class TaskProcessor<T> {
    public int tickCounter = 0;
    public PriorityQueue<Task<T>> activeTasks = new PriorityQueue<>((r1, r2) -> Integer.compare(r2.priority, r1.priority));

    public void tick(int deltaTime) {
        tickCounter += deltaTime;
    }

    public void addTask(Task<T> task) {
        activeTasks.removeIf(r -> r.provider.equals(task.provider));
        task.expiresIn += tickCounter;
        this.activeTasks.add(task);
    }

    public T fetchActiveTaskValue() {
        while (!activeTasks.isEmpty() && activeTasks.peek() != null && (activeTasks.peek().expiresIn <= tickCounter || !activeTasks.peek().provider.isActive())) {
            activeTasks.poll();
        }

        if (activeTasks.isEmpty()) {
            return null;
        } else if (activeTasks.peek() != null) {
            return activeTasks.peek().value;
        } else {
            return null;
        }
    }

    public static class Task<T> {
        int expiresIn;
        int priority;
        Module provider;
        T value;

        public Task(int expiresIn, int priority, Module provider, T value) {
            this.expiresIn = expiresIn;
            this.priority = priority;
            this.provider = provider;
            this.value = value;
        }
    }
}


