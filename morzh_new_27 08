public class Panic extends Module {
    private final List<Module> saved = new ArrayList<>();

    public Panic() {
        super(Categories.Misc, "panic", "Turns off every other module. Turn Panic off to restore the exact same set.");
        runInMainMenu = true;
        serialize = false;
    }

    @Override
    public void onActivate() {
        saved.clear();

        for (Module module : Modules.get().getAll()) {
            if (module == this) continue;
            if (module.isActive()) saved.add(module);
        }

        for (Module module : new ArrayList<>(saved)) {
            if (module.isActive()) module.toggle();
        }
    }

    @Override
    public void onDeactivate() {
        for (Module module : saved) {
            if (!module.isActive()) module.toggle();
        }

        saved.clear();
    }
}


