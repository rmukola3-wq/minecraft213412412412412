import java.util.Locale;

public class AutoAccept extends Module {
    private final SettingGroup sgGeneral = settings.getDefaultGroup();

    private final Setting<Boolean> friendsOnly = sgGeneral.add(new BoolSetting.Builder()
        .name("только-друзья")
        .description("Принимать ТП только от друзей.")
        .defaultValue(true)
        .build()
    );

    private final Setting<Integer> delayTicks = sgGeneral.add(new IntSetting.Builder()
        .name("задержка-тиков")
        .description("Пауза перед /tpaccept.")
        .defaultValue(5)
        .min(0)
        .sliderMax(40)
        .build()
    );

    private final Setting<String> command = sgGeneral.add(new StringSetting.Builder()
        .name("команда")
        .description("Команда принятия без /.")
        .defaultValue("tpaccept")
        .build()
    );

    private int wait;
    private boolean pending;

    public AutoAccept() {
        super(Categories.Player, "auto-accept", "Автопринятие запросов на телепорт.");
    }

    @Override
    public void onActivate() {
        wait = 0;
        pending = false;
    }

    @EventHandler
    private void onMessage(ReceiveMessageEvent event) {
        String msg = Formatting.strip(event.getMessage().getString()).toLowerCase(Locale.ROOT);
        if (!isTpRequest(msg)) return;
        if (friendsOnly.get() && !mentionsFriend(msg)) return;
        pending = true;
        wait = delayTicks.get();
    }

    @EventHandler
    private void onTick(TickEvent.Pre event) {
        if (!pending || mc.player == null || mc.player.networkHandler == null) return;
        if (wait > 0) {
            wait--;
            return;
        }
        String cmd = command.get().trim();
        if (cmd.startsWith("/")) cmd = cmd.substring(1);
        if (!cmd.isEmpty()) mc.player.networkHandler.sendChatCommand(cmd);
        pending = false;
    }

    private static boolean isTpRequest(String msg) {
        return msg.contains("телепорт") || msg.contains("телепортац") || msg.contains("tpa")
            || msg.contains("tpaccept") || msg.contains("хочет телепортироваться")
            || msg.contains("просит телепортироваться") || msg.contains("requested to teleport");
    }

    private static boolean mentionsFriend(String msg) {
        for (Friend friend : Friends.get()) {
            if (friend.name != null && !friend.name.isEmpty() && msg.contains(friend.name.toLowerCase(Locale.ROOT))) {
                return true;
            }
        }
        return false;
    }
}


