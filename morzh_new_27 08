        float x = getX() + 5;
        float y = getY() + 10;
        float w = getWidth() - 9;

        String draw = typing ? buffer : format(setting.get());
        if (typing && System.currentTimeMillis() % 1000 > 500) draw += "_";

        DropDownDraw.text(context, setting.title, x, y - 7, DropDownColors.WHITE, 6);
        DropDownDraw.rounded(context, x, y, w, 12, 4, DropDownColors.STRING_BG);
        DropDownDraw.text(context, draw, x + 2, y + 3, DropDownColors.rgba(255, 255, 255, 64), 6);

