package meteordevelopment.meteorclient.gui.morzh;

import meteordevelopment.meteorclient.gui.themes.morzh.MorzhGuiColors;
import meteordevelopment.meteorclient.systems.modules.Category;
import meteordevelopment.meteorclient.systems.modules.Module;
import meteordevelopment.meteorclient.systems.modules.Modules;
import meteordevelopment.meteorclient.utils.sound.MorzhSoundManager;
import net.minecraft.util.math.MathHelper;

/**
 * One draggable column of modules.
 *
 * The panel never invents its own idea of how tall its content is: it asks the
 * module list, which asks each module, which asks its settings. It then draws
 * only as much of that as fits between its own top edge and the bottom of the
 * screen, and scrolls the rest — so a panel can never spill past the screen no
 * matter how many modules are expanded.
 */
public class MorzhCategoryPanel extends MorzhExpandableComponent {
    public static final int WIDTH = 100;
    public static final int HEADER_HEIGHT = 17;
    public static final int GAP = 5;

    private static final int MODULE_INSET = 1;
    private static final int BOTTOM_PADDING = 3;
    private static final float SCROLL_STEP = 18f;
    private static final float SCROLL_RESPONSIVENESS = 22f;

    private final Category category;

    private float scroll;
    private float scrollTarget;

    private boolean dragging;
    private int dragOffsetX;
    private int dragOffsetY;

    private int screenWidth;
    private int screenHeight;

    public MorzhCategoryPanel(Category category, int x, int y) {
        super(null, category.name, x, y, WIDTH, HEADER_HEIGHT);

        this.category = category;

        int moduleWidth = WIDTH - MODULE_INSET * 2;
        int offsetY = HEADER_HEIGHT;

        for (Module module : Modules.get().getGroup(category)) {
            children.add(
                new MorzhModuleComponent(
                    this,
                    module,
                    MODULE_INSET,
                    offsetY,
                    moduleWidth
                )
            );

            offsetY += MorzhModuleComponent.ROW_HEIGHT;
        }

        setExpanded(true);
    }

    public Category category() {
        return category;
    }

    public void setScreenBounds(int screenWidth, int screenHeight) {
        this.screenWidth = screenWidth;
        this.screenHeight = screenHeight;
    }

    public void applySearch(String query) {
        for (MorzhComponent child : children) {
            if (child instanceof MorzhModuleComponent module) {
                module.applySearch(query);
            }
        }
    }

    // -------------------------------------------------------------- layout

    @Override
    protected int childrenStartY() {
        return HEADER_HEIGHT + Math.round(scroll);
    }

    /** Height actually occupied on screen, header included. */
    public int visibleHeight() {
        return HEADER_HEIGHT + viewportHeight();
    }

    /** Height of the scrollable window under the header. */
    public int viewportHeight() {
        int wanted = revealedHeight();

        if (wanted <= 0) return 0;

        int available = screenHeight
            - absoluteY()
            - HEADER_HEIGHT
            - BOTTOM_PADDING;

        return Math.max(0, Math.min(wanted, available));
    }

    private float maxScroll() {
        return Math.max(0f, childrenHeight() - viewportHeight());
    }

    @Override
    public void tick(float delta) {
        scrollTarget = MathHelper.clamp(scrollTarget, -maxScroll(), 0f);

        scroll = MorzhAnimUtil.approach(
            scroll,
            scrollTarget,
            SCROLL_RESPONSIVENESS,
            delta
        );

        super.tick(delta);
    }

    // ------------------------------------------------------------- drawing

    @Override
    public void render(MorzhGuiContext context) {
        int left = absoluteX();
        int top = absoluteY();
        int height = visibleHeight();

        if (height > HEADER_HEIGHT) {
            MorzhSmoothRenderer.roundedRect(
                context.draw,
                left,
                top + HEADER_HEIGHT - 2,
                WIDTH,
                height - HEADER_HEIGHT + 2,
                2f,
                context.fade(MorzhGuiColors.packed(MorzhGuiColors.PANEL_BODY))
            );
        }

        renderHeader(context, left, top);

        int viewport = viewportHeight();

        if (viewport > 0) {
            MorzhScissor.push(left, top + HEADER_HEIGHT, WIDTH, viewport);

            super.render(context);

            MorzhScissor.pop();

            renderScrollbar(context, left, top, viewport);
        }

        // Accent underline, the reference's way of closing off a column.
        MorzhSmoothRenderer.gradientRect(
            context.draw,
            left,
            top + height,
            WIDTH,
            1f,
            context.fade(MorzhGuiColors.packed(MorzhGuiColors.ACCENT)),
            context.fade(
                MorzhGuiColors.packed(MorzhGuiColors.ACCENT_DARK) & 0x00FFFFFF
            )
        );
    }

    private void renderHeader(MorzhGuiContext context, int left, int top) {
        int accent = MorzhGuiColors.packed(MorzhGuiColors.ACCENT);
        int accentDark = MorzhGuiColors.packed(MorzhGuiColors.ACCENT_DARK);

        MorzhSmoothRenderer.gradientRect(
            context.draw,
            left,
            top,
            WIDTH,
            HEADER_HEIGHT - 2f,
            context.fade(accent),
            context.fade(accentDark)
        );

        double textHeight = MorzhSmoothRenderer.textHeight();

        MorzhSmoothRenderer.text(
            context.draw,
            category.name,
            left + 6,
            top + (HEADER_HEIGHT - 2 - textHeight) / 2f,
            context.fade(MorzhGuiColors.packed(MorzhGuiColors.TEXT_ENABLED)),
            false
        );

        MorzhSmoothRenderer.text(
            context.draw,
            isExpanded() ? "-" : "+",
            left + WIDTH - 9,
            top + (HEADER_HEIGHT - 2 - textHeight) / 2f,
            context.fade(MorzhGuiColors.packed(MorzhGuiColors.TEXT_ENABLED)),
            false
        );
    }

    private void renderScrollbar(
        MorzhGuiContext context,
        int left,
        int top,
        int viewport
    ) {
        int content = childrenHeight();

        if (content <= viewport) return;

        float thumbHeight = Math.max(
            8f,
            viewport * (viewport / (float) content)
        );

        float travel = viewport - thumbHeight;
        float progress = maxScroll() <= 0 ? 0f : -scroll / maxScroll();

        MorzhSmoothRenderer.roundedRect(
            context.draw,
            left + WIDTH - 2f,
            top + HEADER_HEIGHT + travel * MorzhAnimUtil.clamp01(progress),
            1.5f,
            thumbHeight,
            0.75f,
            context.fade(MorzhGuiColors.packed(MorzhGuiColors.ACCENT))
        );
    }

    // -------------------------------------------------------------- events

    public boolean isOverHeader(double mouseX, double mouseY) {
        int left = absoluteX();
        int top = absoluteY();

        return mouseX >= left
            && mouseX < left + WIDTH
            && mouseY >= top
            && mouseY < top + HEADER_HEIGHT;
    }

    public boolean isOverViewport(double mouseX, double mouseY) {
        int left = absoluteX();
        int top = absoluteY() + HEADER_HEIGHT;

        return mouseX >= left
            && mouseX < left + WIDTH
            && mouseY >= top
            && mouseY < top + viewportHeight();
    }

    @Override
    public boolean mouseClicked(double mouseX, double mouseY, int button) {
        if (isOverHeader(mouseX, mouseY)) {
            if (button == 0) {
                dragging = true;
                dragOffsetX = (int) mouseX - x();
                dragOffsetY = (int) mouseY - y();

                return true;
            }

            if (button == 1) {
                toggleExpanded();
                MorzhSoundManager.playBoolean();

                return true;
            }

            return false;
        }

        if (!isOverViewport(mouseX, mouseY)) return false;

        return super.mouseClicked(mouseX, mouseY, button);
    }

    @Override
    public boolean mouseDragged(double mouseX, double mouseY, int button) {
        if (dragging) {
            setX(
                MathHelper.clamp(
                    (int) mouseX - dragOffsetX,
                    0,
                    Math.max(0, screenWidth - WIDTH)
                )
            );

            setY(
                MathHelper.clamp(
                    (int) mouseY - dragOffsetY,
                    0,
                    Math.max(0, screenHeight - HEADER_HEIGHT)
                )
            );

            return true;
        }

        return super.mouseDragged(mouseX, mouseY, button);
    }

    @Override
    public void mouseReleased(double mouseX, double mouseY, int button) {
        dragging = false;

        super.mouseReleased(mouseX, mouseY, button);
    }

    public boolean mouseScrolled(double mouseX, double mouseY, double amount) {
        if (!isOverViewport(mouseX, mouseY)) return false;
        if (maxScroll() <= 0) return false;

        scrollTarget = MathHelper.clamp(
            scrollTarget + (float) amount * SCROLL_STEP,
            -maxScroll(),
            0f
        );

        MorzhSoundManager.playScroll();

        return true;
    }

    /** Keeps a panel reachable when the window is resized under it. */
    public void clampToScreen() {
        setX(MathHelper.clamp(x(), 0, Math.max(0, screenWidth - WIDTH)));
        setY(MathHelper.clamp(y(), 0, Math.max(0, screenHeight - HEADER_HEIGHT)));
    }
}


