        List<Layer> layers = LAYERS.get(dimension);
        return layers != null && !layers.isEmpty();
    }

    public static boolean hideVanillaSky() {
        Ambience ambience = ambience();
        return ambience != null && ambience.useBuiltinSkybox();
    }

    /** @return true if vanilla sun/moon/stars should be skipped */
    public static boolean renderReplacingVanilla(MatrixStack matrices) {
        return renderReplacingVanilla(matrices, null);
    }

    public static boolean renderReplacingVanilla(MatrixStack matrices, Fog fog) {
        Ambience ambience = ambience();
        if (ambience == null || !ambience.useBuiltinSkybox()) return false;
        Identifier texture = ambience.skyboxTexture();
        if (texture == null) return false;
        float tickDelta = mc.getRenderTickCounter().getTickDelta(true);
        float celestial = mc.world == null ? 0 : mc.world.getSkyAngle(tickDelta);
        Color tint = ambience.cubemapTint(1f, fog);
        drawCubemap(matrices, texture, celestial, tint, new float[]{0, 1, 0}, true, 1f, ambience.tintsCustomSky());
        return true;
    }

    public static void renderPack(MatrixStack matrices) {
        renderPack(matrices, null);
    }

    public static void renderPack(MatrixStack matrices, Fog fog) {
        Ambience ambience = ambience();
        if (ambience != null && ambience.isActive() && !ambience.usePackSkybox() && !ambience.useBuiltinSkybox()) {
            return;
        }
        if (ambience != null && ambience.useBuiltinSkybox()) return;
        if (mc.world == null) return;
        List<Layer> layers = LAYERS.get(dimensionIndex());
        if (layers == null || layers.isEmpty()) return;

        float tickDelta = mc.getRenderTickCounter().getTickDelta(true);
        int timeOfDay = (int) (mc.world.getTimeOfDay() % 24000L);
        float celestial = mc.world.getSkyAngle(tickDelta);
        float rain = mc.world.getRainGradient(tickDelta);
        float thunder = mc.world.getThunderGradient(tickDelta);
        if (rain > 0.0f) thunder /= rain;
        boolean tinted = ambience != null && ambience.tintsCustomSky();

        for (Layer layer : layers) {
            if (!layer.isActive(mc.world, timeOfDay)) continue;
            float brightness = layer.brightness(mc.world, timeOfDay, rain, thunder);
            if (brightness < 1.0e-4f) continue;
            Color tint = ambience != null ? ambience.cubemapTint(brightness, fog) : new Color(255, 255, 255, (int) (brightness * 255));
            drawCubemap(matrices, layer.texture, celestial, tint, layer.axis, layer.rotate, layer.speed, tinted);
        }
    }

    private static Ambience ambience() {
        Modules modules = Modules.get();
        if (modules == null) return null;
        return modules.get(Ambience.class);
    }

    private static void drawCubemap(MatrixStack matrices, Identifier texture, float celestial, Color tint, float[] axis, boolean rotate, float speed, boolean ambienceTint) {
        if (mc.player == null || texture == null) return;

        Matrix4f mat = new Matrix4f();
        if (rotate) {
            float extra = 0;
            if (speed != Math.round(speed) && mc.world != null) {
                long days = (mc.world.getTimeOfDay() + 18000L) / 24000L;
                extra = (float) ((days * (speed % 1.0f)) % 1.0);
            }
            mat.rotate((float) Math.toRadians(360.0f * (extra + celestial * speed)), axis[0], axis[1], axis[2]);
        }
        mat.rotate((float) Math.toRadians(90), 1, 0, 0);
        mat.rotate((float) Math.toRadians(-90), 0, 0, 1);

        int packed = tint.getPacked();
        if (!skyMeshReady || cachedSkyTex != texture || cachedSkyTint != packed) {
            mesh.begin();
            emitSide(mesh, new Matrix4f(), 4, tint);
            emitSide(mesh, new Matrix4f().rotate((float) Math.toRadians(90), 1, 0, 0), 1, tint);
            emitSide(mesh, new Matrix4f().rotate((float) Math.toRadians(-90), 1, 0, 0), 0, tint);
            Matrix4f z = new Matrix4f().rotate((float) Math.toRadians(90), 0, 0, 1);
            emitSide(mesh, z, 5, tint);
            z.rotate((float) Math.toRadians(90), 0, 0, 1);
            emitSide(mesh, z, 2, tint);
            z.rotate((float) Math.toRadians(90), 0, 0, 1);
            emitSide(mesh, z, 3, tint);
            mesh.end();
            skyMeshReady = true;
            cachedSkyTex = texture;
            cachedSkyTint = packed;
        }

        boolean rendering3D = Utils.rendering3D;
        Utils.rendering3D = false;
        Matrix4fStack mv = RenderSystem.getModelViewStack();
        mv.pushMatrix();
        if (matrices != null) mv.mul(matrices.peek().getPositionMatrix());
        mv.mul(mat);
        try {
            GL.bindTexture(texture);
            GlStateManager._depthMask(false);
            GlStateManager._enableBlend();
            if (ambienceTint) {
                GlStateManager._blendFuncSeparate(GL11.GL_SRC_ALPHA, GL11.GL_ONE_MINUS_SRC_ALPHA, GL11.GL_ONE, GL11.GL_ZERO);
            } else {
                GlStateManager._blendFuncSeparate(GL11.GL_SRC_ALPHA, GL11.GL_ONE, GL11.GL_ONE, GL11.GL_ZERO);
            }
            mesh.render(null);
            GlStateManager._blendFuncSeparate(GL11.GL_SRC_ALPHA, GL11.GL_ONE_MINUS_SRC_ALPHA, GL11.GL_ONE, GL11.GL_ZERO);
            GlStateManager._depthMask(true);
        } finally {
            mv.popMatrix();
            Utils.rendering3D = rendering3D;
        }
    }

    private static void emitSide(ShaderMesh mesh, Matrix4f mat, int side, Color color) {
        float u = (side % 3) / 3.0f;
        float v = (side / 3) / 2.0f;
        float u2 = u + 1.0f / 3.0f;
        float v2 = v + 0.5f;
        int i1 = vert(mesh, mat, -100, -100, -100, u, v, color);
        int i2 = vert(mesh, mat, -100, -100, 100, u, v2, color);
        int i3 = vert(mesh, mat, 100, -100, 100, u2, v2, color);
        int i4 = vert(mesh, mat, 100, -100, -100, u2, v, color);
        mesh.quad(i1, i2, i3, i4);
    }

    private static int vert(ShaderMesh mesh, Matrix4f mat, float x, float y, float z, float u, float v, Color color) {
        Vector3f p = new Vector3f(x, y, z);
        p.mulPosition(mat);
        return mesh.vec3(p.x, p.y, p.z).vec2(u, v).color(color).next();
    }

    private static int dimensionIndex() {
        if (mc.world == null) return 0;
        if (mc.world.getRegistryKey() == World.NETHER) return -1;
        if (mc.world.getRegistryKey() == World.END) return 1;
        return 0;
    }

    private static void reload() {
        LAYERS.clear();
        if (mc == null || mc.getResourceManager() == null) return;

        scan("optifine/sky");
        scan("mcpatcher/sky");

        int total = LAYERS.values().stream().mapToInt(List::size).sum();
        if (total > 0) MeteorClient.LOG.info("CustomSky: loaded {} layer(s) from resource packs", total);
        else MeteorClient.LOG.info("CustomSky: no optifine/mcpatcher sky layers in resource packs");
    }

    private static void scan(String root) {
        Map<Identifier, Resource> found;
        try {
            found = mc.getResourceManager().findResources(root, id -> id.getPath().endsWith(".properties"));
        } catch (Exception e) {
            return;
        }

        for (Map.Entry<Identifier, Resource> entry : found.entrySet()) {
            Identifier id = entry.getKey();
            int world = parseWorldIndex(id.getPath());
            if (world == Integer.MIN_VALUE) continue;

            try (InputStream in = entry.getValue().getInputStream()) {
                Properties props = new Properties();
                props.load(in);
                String folder = id.getPath().substring(0, id.getPath().lastIndexOf('/'));
                String defSource = stripExtension(id.getPath().substring(id.getPath().lastIndexOf('/') + 1)) + ".png";
                Layer layer = Layer.parse(props, folder, defSource, id.getNamespace());
                if (layer == null) continue;
                LAYERS.computeIfAbsent(world, k -> new ArrayList<>()).add(layer);
            } catch (Exception ignored) {
            }
        }
    }

    private static int parseWorldIndex(String path) {
        int i = path.indexOf("world");
        if (i < 0) return Integer.MIN_VALUE;
        int start = i + 5;
        int end = start;
        if (end < path.length() && path.charAt(end) == '-') end++;
        while (end < path.length() && Character.isDigit(path.charAt(end))) end++;
        if (end == start || (end == start + 1 && path.charAt(start) == '-')) return Integer.MIN_VALUE;
        try {
            return Integer.parseInt(path.substring(start, end));
        } catch (NumberFormatException e) {
            return Integer.MIN_VALUE;
        }
    }

    private static String stripExtension(String name) {
        int d = name.lastIndexOf('.');
        return d < 0 ? name : name.substring(0, d);
    }

    private static Identifier texture(String namespace, String path) {
        if (path.startsWith("assets/minecraft/")) path = path.substring("assets/minecraft/".length());
        int colon = path.indexOf(':');
        if (colon >= 0) {
            namespace = path.substring(0, colon);
            path = path.substring(colon + 1);
        }
        if (!path.endsWith(".png") && !path.contains(".")) path = path + ".png";
        return Identifier.of(namespace, path);
    }

    private static final class Layer {
        final Identifier texture;
        private final int startFadeIn, endFadeIn, startFadeOut, endFadeOut;
        final boolean rotate;
        final float speed;
        final float[] axis;
        private final boolean weatherClear, weatherRain, weatherThunder;
        private final int daysLoop;
        private final int[] days;
        private final boolean always;

        private Layer(Identifier texture, int startFadeIn, int endFadeIn, int startFadeOut, int endFadeOut,
                      boolean rotate, float speed, float[] axis, boolean weatherClear, boolean weatherRain,
                      boolean weatherThunder, int daysLoop, int[] days, boolean always) {
            this.texture = texture;
            this.startFadeIn = startFadeIn;
            this.endFadeIn = endFadeIn;
            this.startFadeOut = startFadeOut;
            this.endFadeOut = endFadeOut;
            this.rotate = rotate;
            this.speed = speed;
            this.axis = axis;
            this.weatherClear = weatherClear;
            this.weatherRain = weatherRain;
            this.weatherThunder = weatherThunder;
            this.daysLoop = daysLoop;
            this.days = days;
            this.always = always;
        }

        static Layer parse(Properties props, String folder, String defSource, String namespace) {
            String source = props.getProperty("source", defSource).trim();
            if (source.startsWith("./")) source = folder + "/" + source.substring(2);
            else if (!source.contains("/") && !source.contains(":")) source = folder + "/" + source;

            Identifier tex = texture(namespace, source);
            Optional<Resource> res = mc.getResourceManager().getResource(tex);
            if (res.isEmpty()) return null;

            int startFadeIn = parseTime(props.getProperty("startFadeIn"));
            int endFadeIn = parseTime(props.getProperty("endFadeIn"));
            int startFadeOut = parseTime(props.getProperty("startFadeOut"));
            int endFadeOut = parseTime(props.getProperty("endFadeOut"));
            boolean always = startFadeIn < 0 || endFadeIn < 0 || endFadeOut < 0;
            if (!always) {
                int fadeInLen = normalize(endFadeIn - startFadeIn);
                if (startFadeOut < 0) {
                    startFadeOut = normalize(endFadeOut - fadeInLen);
                    if (between(startFadeOut, startFadeIn, endFadeIn)) startFadeOut = endFadeIn;
                }
            }

            boolean rotate = parseBool(props.getProperty("rotate"), true);
            float speed = parseFloat(props.getProperty("speed"), 1.0f);
            if (speed < 0) speed = 1;
            float[] axis = parseAxis(props.getProperty("axis"));
            int daysLoop = Math.max(1, parseInt(props.getProperty("daysLoop"), 8));
            int[] days = parseDays(props.getProperty("days"));

            String weather = props.getProperty("weather", "clear").toLowerCase();
            boolean clear = weather.contains("clear");
            boolean rain = weather.contains("rain");
            boolean thunder = weather.contains("thunder");
            if (!clear && !rain && !thunder) clear = true;

            return new Layer(tex, startFadeIn, endFadeIn, startFadeOut, endFadeOut, rotate, speed, axis, clear, rain, thunder, daysLoop, days, always);
        }

        boolean isActive(World world, int timeOfDay) {
            if (always) return true;
            if (between(timeOfDay, endFadeOut, startFadeIn)) return false;
            if (days == null) return true;
            long t = world.getTimeOfDay();
            long j = t - startFadeIn;
            while (j < 0) j += 24000L * daysLoop;
            int day = (int) (j / 24000L) % daysLoop;
            for (int i = 0; i < days.length; i += 2) {
                if (day >= days[i] && day <= days[i + 1]) return true;
            }
            return false;
        }

        float brightness(World world, int timeOfDay, float rain, float thunder) {
            if (always) return 1;
            float fade = fadeBrightness(timeOfDay);
            float clearAmt = 1.0f - rain;
            float rainOnly = rain - thunder;
            float w = 0;
            if (weatherClear) w += clearAmt;
            if (weatherRain) w += rainOnly;
            if (weatherThunder) w += thunder;
            return MathHelper.clamp(fade * MathHelper.clamp(w, 0, 1), 0, 1);
        }

        private float fadeBrightness(int timeOfDay) {
            if (between(timeOfDay, startFadeIn, endFadeIn)) {
                int len = normalize(endFadeIn - startFadeIn);
                return len == 0 ? 1 : (float) normalize(timeOfDay - startFadeIn) / (float) len;
            }
            if (between(timeOfDay, endFadeIn, startFadeOut)) return 1;
            if (between(timeOfDay, startFadeOut, endFadeOut)) {
                int len = normalize(endFadeOut - startFadeOut);
                return len == 0 ? 0 : 1.0f - (float) normalize(timeOfDay - startFadeOut) / (float) len;
            }
            return 0;
        }

        private static int parseTime(String str) {
            if (str == null) return -1;
            String[] p = str.trim().replace("\\", "").split(":");
            if (p.length != 2) return -1;
            try {
                int h = Integer.parseInt(p[0].trim());
                int m = Integer.parseInt(p[1].trim());
                if (h < 0 || h > 23 || m < 0 || m > 59) return -1;
                h -= 6;
                if (h < 0) h += 24;
                return h * 1000 + (int) (m / 60.0 * 1000.0);
            } catch (NumberFormatException e) {
                return -1;
            }
        }

        private static boolean parseBool(String str, boolean def) {
            if (str == null) return def;
            if (str.equalsIgnoreCase("true")) return true;
            if (str.equalsIgnoreCase("false")) return false;
            return def;
        }

        private static float parseFloat(String str, float def) {
            if (str == null) return def;
            try {
                return Float.parseFloat(str.trim());
            } catch (NumberFormatException e) {
                return def;
            }
        }

        private static int parseInt(String str, int def) {
            if (str == null) return def;
            try {
                return Integer.parseInt(str.trim());
            } catch (NumberFormatException e) {
                return def;
            }
        }

        private static float[] parseAxis(String str) {
            float[] def = {1, 0, 0};
            if (str == null) return def;
            String[] p = str.trim().split("\\s+");
            if (p.length != 3) return def;
            try {
                float x = Float.parseFloat(p[0]);
                float y = Float.parseFloat(p[1]);
                float z = Float.parseFloat(p[2]);
                if (x * x + y * y + z * z < 1.0e-5f) return def;
                return new float[]{z, y, -x};
            } catch (NumberFormatException e) {
                return def;
            }
        }

        private static int[] parseDays(String str) {
            if (str == null || str.isBlank()) return null;
            List<Integer> pairs = new ArrayList<>();
            for (String part : str.split("[\\s,]+")) {
                if (part.isBlank()) continue;
                int dash = part.indexOf('-');
                try {
                    if (dash < 0) {
                        int v = Integer.parseInt(part.trim());
                        pairs.add(v);
                        pairs.add(v);
                    } else {
                        pairs.add(Integer.parseInt(part.substring(0, dash).trim()));
                        pairs.add(Integer.parseInt(part.substring(dash + 1).trim()));
                    }
                } catch (NumberFormatException ignored) {
                }
            }
            if (pairs.isEmpty()) return null;
            int[] out = new int[pairs.size()];
            for (int i = 0; i < pairs.size(); i++) out[i] = pairs.get(i);
            return out;
        }

        private static int normalize(int t) {
            t %= 24000;
            if (t < 0) t += 24000;
            return t;
        }

        private static boolean between(int t, int start, int end) {
            if (start <= end) return t >= start && t <= end;
            return t >= start || t <= end;
        }
    }
}


