    public boolean keyPressed(KeyInput input) {
        if (transitionPhase != TransitionPhase.NONE) return false;

        if (currentView == View.MAIN_MENU) {
            if (!isUnlocked) { unlock(); return true; }
        } else if (currentView == View.ALT_SCREEN) {
            if (nicknameFieldFocused) {
                int key = input.key();

                if (MenuClipboard.handled(input)) {
                    nicknameText = sanitizeNick(MenuClipboard.apply(input, client, nicknameText, 16, false));
                    return true;
                }

                if (key == 259) {
                    if (!nicknameText.isEmpty()) nicknameText = nicknameText.substring(0, nicknameText.length() - 1);
                    return true;
                }
                if (key == 256) { nicknameFieldFocused = false; return true; }
                if (key == 257 || key == 335) {
                    if (!nicknameText.isEmpty()) { addAccount(nicknameText); nicknameText = ""; }
                    nicknameFieldFocused = false;
                    return true;
                }
            }
            if (searchFocused) {
                if (MenuClipboard.handled(input)) {
                    searchText = MenuClipboard.apply(input, client, searchText, 24, false);
                    return true;
                }
                int key = input.key();
                if (key == 259) {
                    if (!searchText.isEmpty()) searchText = searchText.substring(0, searchText.length() - 1);
                    return true;
                }
                if (key == 256) { searchFocused = false; return true; }
            }
            if (input.key() == 256) {
                MorzhSoundManager.playClose();
                switchToView(View.MAIN_MENU);
                accountConfig.save();
                return true;
            }
        }
        return super.keyPressed(input.key(), input.scancode(), input.modifiers());
    }

    public boolean charTyped(CharInput input) {
        if (Screen.hasControlDown()) return true;
        if (currentView == View.ALT_SCREEN && transitionPhase == TransitionPhase.NONE) {
            int cp = input.codepoint();
            if (nicknameFieldFocused && (Character.isLetterOrDigit(cp) || cp == '_')) {
                if (nicknameText.length() < 16) nicknameText += Character.toString(cp);
                return true;
            }
            if (searchFocused && !Character.isISOControl(cp) && searchText.length() < 24) {
                searchText += Character.toString(cp);
                return true;
            }
        }
        return super.charTyped((char) input.codepoint(), input.modifiers());
    }

