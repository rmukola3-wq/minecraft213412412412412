/**
 * Custom billboards / ribbons behind thrown pearls / arrows / potions.
 * Rockstar: glow bloom sparks. Delta: UUID-hue stars. Smoke: fat additive glowing trail.
 */
public class ProjectileParticles extends Module {
    private static final Identifier TEX_STAR = MeteorClient.identifier("textures/particles/star.png");
    private static final Identifier TEX_FIREFLY = MeteorClient.identifier("textures/particles/firefly.png");
    private static final int SMOKE_SAMPLES = 22;

    private final SettingGroup sg = settings.getDefaultGroup();

    private final Setting<Style> style = sg.add(new EnumSetting.Builder<Style>()
        .name("style")
        .description("Rockstar sparks, Delta stars, or a fat glowing smoke line.")
