package meteordevelopment.meteorclient.systems.modules.combat.aura.rasty.rotations;

import meteordevelopment.meteorclient.systems.modules.combat.KillAura;
import meteordevelopment.meteorclient.systems.modules.combat.aura.rasty.Angle;
import meteordevelopment.meteorclient.systems.modules.combat.aura.rasty.MathAngle;
import meteordevelopment.meteorclient.systems.modules.combat.aura.rasty.RastyAttackPerpetrator;
import meteordevelopment.meteorclient.systems.modules.combat.aura.rasty.impl.RotateConstructor;
import net.minecraft.entity.Entity;
import net.minecraft.entity.LivingEntity;
import net.minecraft.util.math.Box;
import net.minecraft.util.math.MathHelper;
import net.minecraft.util.math.Vec3d;

import java.security.SecureRandom;

import static meteordevelopment.meteorclient.MeteorClient.mc;

/** Rockstar 1.21.4 FunTime / SpookyTime aim. Letter R = from Rockstar. */
public class RockstarRAngle extends RotateConstructor {
    public enum Kind {
        FUNTIME,
        SPOOKY
    }

    private final Kind kind;
    private final SecureRandom random = new SecureRandom();
    private float savedYaw;
    private float savedPitch;
    private long yawWaveAt;
    private long pitchWaveAt;
    private boolean yawRising = true;
    private boolean pitchRising = true;
    private float yawWave = 0.5f;
    private float pitchWave = 0.5f;

    public RockstarRAngle(Kind kind) {
        super(kind == Kind.FUNTIME ? "FunTime R" : "SpookyTime R");
        this.kind = kind;
    }

    @Override
    public Angle limitAngleChange(Angle currentAngle, Angle targetAngle, Vec3d vec3d, Entity entity) {
        if (currentAngle == null) return targetAngle;
        if (mc.player == null) return currentAngle;

        boolean canAttack = entity != null
            && KillAura.get() != null
            && RastyAttackPerpetrator.get().getAttackHandler().canAttack(KillAura.get().getConfig(), 0);

        if (kind == Kind.FUNTIME) {
            return funTime(currentAngle, entity, canAttack);
        }
        return spooky(currentAngle, entity, canAttack);
    }

    private Angle funTime(Angle current, Entity entity, boolean canAttack) {
        float yaw;
        float pitch;
        if (entity instanceof LivingEntity living) {
            Box box = living.getBoundingBox();
            Vec3d aim = box.getCenter();
            double targetY = MathHelper.clamp((mc.player.getY() + aim.y) * 0.5, box.minY, box.maxY);
            Vec3d playerPos = mc.player.getPos().add(mc.player.getVelocity().x, 0, mc.player.getVelocity().z);
            double dx = living.getX() - playerPos.x;
            double dy = targetY - (playerPos.y + mc.player.getEyeHeight(mc.player.getPose()));
            double dz = living.getZ() - playerPos.z;
            yaw = (float) Math.toDegrees(Math.atan2(dz, dx)) - 90.0f;
            pitch = (float) (-Math.toDegrees(Math.atan2(dy, Math.hypot(dx, dz))));
        } else {
            yaw = current.getYaw();
            pitch = current.getPitch();
        }

        float yawOff = nextWave(true, canAttack ? 470 : 170, 40);
        float pitchOff = nextWave(false, canAttack ? 300 : 130, 40);
        float yawSpeed;
        float pitchSpeed;
        if (canAttack) {
            yaw += yawOff / 4.0f;
            pitch += pitchOff / 4.0f;
            yawSpeed = random(30, 69);
            pitchSpeed = random(8, 15);
        } else {
            yaw = savedYaw + yawOff;
            pitch = savedPitch + pitchOff;
            yawSpeed = random(20, 35);
            pitchSpeed = random(8, 15);
        }

        Angle out = lerpBySpeed(current, yaw, MathHelper.clamp(pitch, -90, 90), yawSpeed, pitchSpeed);
        savedYaw = out.getYaw();
        savedPitch = out.getPitch();
        return out;
    }

    private Angle spooky(Angle current, Entity entity, boolean canAttack) {
        float yaw;
        float pitch;
        if (entity instanceof LivingEntity living) {
            Box box = living.getBoundingBox();
            Vec3d hit = box.getCenter();
            double aimY = MathHelper.clamp((mc.player.getY() + hit.y) * 0.5, box.minY, box.maxY);
            Vec3d playerPos = mc.player.getPos().add(mc.player.getVelocity().x * 2, 0, mc.player.getVelocity().z * 2);
            double dx = living.getX() - playerPos.x;
            double dy = aimY - (playerPos.y + mc.player.getEyeHeight(mc.player.getPose()));
            double dz = living.getZ() - playerPos.z;
            yaw = (float) Math.toDegrees(Math.atan2(dz, dx)) - 90.0f;
            pitch = (float) (-Math.toDegrees(Math.atan2(dy, Math.hypot(dx, dz))));
        } else {
            Angle cam = MathAngle.cameraAngle();
            yaw = cam.getYaw() + random(-5, 5);
            pitch = cam.getPitch() + random(-5, 5);
        }

        yaw += random(-5, 5);
        pitch += random(-5, 5);
        float yawSpeed = random(60, 80);
        float pitchSpeed = random(40, 80);
        if (entity instanceof LivingEntity living && !living.isOnGround() && living.fallDistance > 0) {
            pitchSpeed /= 12.0f;
        }
        if (!canAttack) {
            yawSpeed /= random(5, 10);
            pitchSpeed /= random(5, 10);
        }
        return lerpBySpeed(current, yaw, MathHelper.clamp(pitch, -90, 90), yawSpeed, pitchSpeed);
    }

    private Angle lerpBySpeed(Angle from, float yaw, float pitch, float yawSpeed, float pitchSpeed) {
        Angle delta = MathAngle.calculateDelta(from, new Angle(yaw, pitch));
        float yawStep = MathHelper.clamp(delta.getYaw(), -yawSpeed, yawSpeed);
        float pitchStep = MathHelper.clamp(delta.getPitch(), -pitchSpeed, pitchSpeed);
        return new Angle(from.getYaw() + yawStep, MathHelper.clamp(from.getPitch() + pitchStep, -90, 90));
    }

    private float nextWave(boolean yaw, long durationMs, float width) {
        long now = System.currentTimeMillis();
        if (yaw) {
            if (now - yawWaveAt >= durationMs) {
                yawWaveAt = now;
                yawRising = !yawRising;
            }
            float t = MathHelper.clamp((now - yawWaveAt) / (float) durationMs, 0, 1);
            yawWave = yawRising ? t : 1 - t;
            return -20.0f + width * yawWave;
        }
        if (now - pitchWaveAt >= durationMs) {
            pitchWaveAt = now;
            pitchRising = !pitchRising;
        }
        float t = MathHelper.clamp((now - pitchWaveAt) / (float) durationMs, 0, 1);
        pitchWave = pitchRising ? t : 1 - t;
        return -20.0f + width * pitchWave;
    }

    private float random(float min, float max) {
        return min + random.nextFloat() * (max - min);
    }

