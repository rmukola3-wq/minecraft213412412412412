        if (list.isEmpty() && !isInEditor()) {
            setSize(0, 0);
            return;
        }

        float cardW = 118 * s;
        if (preview) cardW = Math.max(cardW, 118 * s);
        for (Module module : list) {
            cardW = Math.max(cardW, (float) (
                MorzhSmoothRenderer.textWidth(module.title, fs)
                    + MorzhSmoothRenderer.textWidth(keyName(module), fs)
                    + 40 * s
            ));
        }
        float header = 20 * s;
        float rowH = 16 * s;
        int count = preview ? 1 : list.size();
        setSize(cardW, header + count * rowH + 4 * s);

        renderer.post(() -> {
            DrawContext context = HudRenderer.INSTANCE.drawContext;
            if (context == null) return;
            HudChrome.card(context, x, y, getWidth(), getHeight(), 7 * s);
            HudChrome.header(context, "Hot Keys", x, y, getWidth(), s, fs);

            float rowY = y + header;
            if (preview) {
                drawRow(context, "Armor HUD", "R", rowY, s, fs);
                return;
            }
            for (Module module : list) {
                drawRow(context, module.title, keyName(module), rowY, s, fs);
                rowY += rowH;
            }
        });
    }

    private void drawRow(DrawContext context, String name, String key, float rowY, float s, double fs) {
        MorzhSmoothRenderer.text(context, name, x + 8 * s, rowY + 3 * s, 0xFFFFFFFF, true, fs);
        float timeW = (float) MorzhSmoothRenderer.textWidth(key, fs) + 8 * s;
        float pillX = x + getWidth() - 6 * s - timeW;
        MorzhSmoothRenderer.roundedRect(context, pillX, rowY + 1 * s, timeW, 12 * s, 4 * s, HudChrome.RV_PILL_ALT);
        MorzhSmoothRenderer.text(context, key, pillX + 4 * s, rowY + 2 * s, 0xFFFFFFFF, true, fs);
    }

    private static String keyName(Module module) {
        String raw = module.keybind.toString();
        if (raw == null || raw.isBlank() || raw.equalsIgnoreCase("None")) return "NONE";
        StringBuilder out = new StringBuilder();
        for (char c : raw.toCharArray()) out.append(RU_TO_EN.getOrDefault(c, c));
        return out.toString().toUpperCase();
    }
}


