package meteordevelopment.meteorclient.systems.hud;

import meteordevelopment.meteorclient.MeteorClient;
import meteordevelopment.meteorclient.events.entity.player.AttackEntityEvent;
import meteordevelopment.meteorclient.events.game.ReceiveMessageEvent;
import meteordevelopment.meteorclient.events.packets.PacketEvent;
import meteordevelopment.meteorclient.events.world.TickEvent;
import meteordevelopment.meteorclient.systems.modules.Modules;
import meteordevelopment.meteorclient.systems.modules.combat.ExpensiveAura;
import meteordevelopment.meteorclient.systems.modules.combat.KillAura;
import meteordevelopment.meteorclient.systems.modules.combat.aura.expensive.CombatTargets;
import meteordevelopment.orbit.EventHandler;
import meteordevelopment.orbit.EventPriority;
import net.minecraft.entity.Entity;
import net.minecraft.entity.LivingEntity;
import net.minecraft.entity.player.PlayerEntity;
import net.minecraft.network.packet.s2c.play.EntityStatusS2CPacket;
import net.minecraft.network.packet.s2c.play.GameMessageS2CPacket;

import java.util.Locale;
import java.util.Map;
import java.util.UUID;
import java.util.concurrent.ConcurrentHashMap;

import static meteordevelopment.meteorclient.MeteorClient.mc;

public final class MorzhCombatStats {
    public static int kills, deaths, streak;

    private static final long COMBAT_MS = 12_000L;
    private static final long KILL_DEDUPE_MS = 2_500L;

    private static boolean hooked;
    private final Map<UUID, Long> recentCombat = new ConcurrentHashMap<>();
    private long lastKillAt;
    private UUID lastKillUuid;
    private String lastKillName;

    private MorzhCombatStats() {}

    public static void init() {
        if (hooked) return;
        hooked = true;
        MeteorClient.EVENT_BUS.subscribe(new MorzhCombatStats());
    }

    public static void reset() {
        kills = deaths = streak = 0;
    }

    public static String kd() {
        float d = deaths <= 0 ? 1f : deaths;
        return String.format("%.2f", kills / d);
    }

    @EventHandler
    private void onTick(TickEvent.Pre event) {
        remember(CombatTargets.current());
        remember(CombatTargets.lastHit());

        KillAura ka = Modules.get() == null ? null : Modules.get().get(KillAura.class);
        if (ka != null) {
            remember(ka.getTargetEntity());
            remember(ka.getLastTarget());
            remember(ka.getLastAttackedTarget());
        }

        ExpensiveAura expensive = Modules.get() == null ? null : Modules.get().get(ExpensiveAura.class);
        if (expensive != null) {
            remember(expensive.target());
            remember(expensive.lastTarget());
        }

        long now = System.currentTimeMillis();
        recentCombat.entrySet().removeIf(entry -> now - entry.getValue() > COMBAT_MS);
    }

    @EventHandler(priority = EventPriority.LOWEST)
    private void onAttack(AttackEntityEvent event) {
        if (event.isCancelled()) return;
        if (event.entity instanceof LivingEntity living) remember(living);
    }

    @EventHandler
    private void onPacket(PacketEvent.Receive event) {
        if (event.packet instanceof GameMessageS2CPacket message) {
            String victim = extractOwnKillVictim(message.content().getString());
            if (victim != null) creditKill(null, victim);
            return;
        }

        if (!(event.packet instanceof EntityStatusS2CPacket packet) || mc.world == null) return;
        if (packet.getStatus() != 3) return;

        Entity entity = packet.getEntity(mc.world);
        if (!(entity instanceof PlayerEntity player)) return;

        if (entity == mc.player) {
            deaths++;
            streak = 0;
            MorzhNotifications.push("Death", "you died", MorzhNotifications.Kind.Off);
            return;
        }

        if (wasRecentCombat(player)) creditKill(player.getUuid(), player.getName().getString());
    }

    @EventHandler
    private void onChat(ReceiveMessageEvent event) {
        if (event.getMessage() == null) return;
        String victim = extractOwnKillVictim(event.getMessage().getString());
        if (victim != null) creditKill(null, victim);
    }

    private void remember(LivingEntity entity) {
        if (!(entity instanceof PlayerEntity player) || player == mc.player) return;
        recentCombat.put(player.getUuid(), System.currentTimeMillis());
    }

    private boolean wasRecentCombat(PlayerEntity player) {
        Long at = recentCombat.get(player.getUuid());
        return at != null && System.currentTimeMillis() - at <= COMBAT_MS;
    }

    private void creditKill(UUID uuid, String name) {
        long now = System.currentTimeMillis();
        boolean sameUuid = uuid != null && uuid.equals(lastKillUuid) && now - lastKillAt < KILL_DEDUPE_MS;
        boolean sameName = name != null && !name.isEmpty() && name.equalsIgnoreCase(lastKillName) && now - lastKillAt < KILL_DEDUPE_MS;
        if (sameUuid || sameName) return;
        lastKillAt = now;
        lastKillUuid = uuid;
        lastKillName = name;
        kills++;
        streak++;
        MorzhNotifications.push("Kill", name == null || name.isEmpty() ? "kill" : name, MorzhNotifications.Kind.On);
    }

    private static String extractOwnKillVictim(String raw) {
        if (raw == null || raw.isEmpty()) return null;
        String text = raw.replaceAll("§.", "").trim();
        String lower = text.toLowerCase(Locale.ROOT);

        if (lower.contains("вас убил")
            || lower.contains("убил вас")
            || lower.contains("убиты")
            || lower.contains("were killed")
            || lower.contains("killed you")
            || lower.contains("slain by")
            || lower.contains("вы умерли")
            || lower.contains("you died")) {
            return null;
        }

        if (!lower.contains("вы убили") && !lower.contains("you killed")) return null;

        String[] parts = text.split("\\s+");
        for (int i = 0; i < parts.length - 1; i++) {
            String word = parts[i].replaceAll("[!.,;:]+$", "");
            if (!word.equalsIgnoreCase("убили") && !word.equalsIgnoreCase("killed")) continue;
            String next = parts[i + 1].replaceAll("[!.,;:]+$", "");
            if (next.equalsIgnoreCase("игрока") && i + 2 < parts.length) {
                return parts[i + 2].replaceAll("[!.,;:]+$", "");
            }
            if (!next.isEmpty() && !next.equalsIgnoreCase("by") && !next.equalsIgnoreCase("you")) return next;
        }
        return "kill";
    }
}


