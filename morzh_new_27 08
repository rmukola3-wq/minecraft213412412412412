package meteordevelopment.meteorclient.systems.hud;

import meteordevelopment.meteorclient.MeteorClient;
import meteordevelopment.meteorclient.events.packets.PacketEvent;
import meteordevelopment.orbit.EventHandler;
import net.minecraft.entity.Entity;
import net.minecraft.entity.player.PlayerEntity;
import net.minecraft.network.packet.s2c.play.EntityStatusS2CPacket;

import java.util.ArrayList;
import java.util.Iterator;
import java.util.List;

import static meteordevelopment.meteorclient.MeteorClient.mc;

/** Toast queue. Drawing is done by NotifyHud in the HUD editor. */
public final class MorzhNotifications {
    private static final List<Toast> TOASTS = new ArrayList<>();
    private static boolean hooked;

    private MorzhNotifications() {}

    public static void init() {
        if (hooked) return;
        hooked = true;
        MeteorClient.EVENT_BUS.subscribe(new MorzhNotifications());
    }

    public static void push(String title, String body, Kind kind) {
        String t = clean(title);
        String b = clean(body);
        if (t.isEmpty() && b.isEmpty()) return;
        synchronized (TOASTS) {
            TOASTS.add(new Toast(t, b, kind, System.currentTimeMillis()));
            while (TOASTS.size() > 8) TOASTS.removeFirst();
        }
    }

    public static void toggle(String module, boolean on) {
        push(module, on ? "активирован" : "деактивирован", on ? Kind.On : Kind.Off);
    }

    public static List<Toast> snapshot(long now, long lifeMs) {
        List<Toast> out = new ArrayList<>();
        synchronized (TOASTS) {
            Iterator<Toast> it = TOASTS.iterator();
            while (it.hasNext()) {
                Toast t = it.next();
                if (now - t.at > lifeMs) it.remove();
                else out.add(t);
            }
        }
        return out;
    }

    private static String clean(String s) {
        if (s == null) return "";
        return s.replace("(highlight)", "").replace("(default)", "").replaceAll("§.", "").trim();
    }

    @EventHandler
    private void onPacket(PacketEvent.Receive event) {
        if (!(event.packet instanceof EntityStatusS2CPacket packet)) return;
        if (mc.world == null) return;
        if (packet.getStatus() != 35) return;
        Entity entity = packet.getEntity(mc.world);
        if (entity instanceof PlayerEntity player) {
            push("Totem", player.getName().getString() + " popped", Kind.Warn);
        }
    }

    public enum Kind { On, Off, Warn, Info }

    public record Toast(String title, String body, Kind kind, long at) {}
}


