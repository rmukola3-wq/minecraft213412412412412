package meteordevelopment.meteorclient.systems.modules.combat;

import meteordevelopment.meteorclient.events.world.TickEvent;
import meteordevelopment.meteorclient.settings.BoolSetting;
import meteordevelopment.meteorclient.settings.DoubleSetting;
import meteordevelopment.meteorclient.settings.EnumSetting;
import meteordevelopment.meteorclient.settings.IntSetting;
import meteordevelopment.meteorclient.settings.Setting;
import meteordevelopment.meteorclient.settings.SettingGroup;
import meteordevelopment.meteorclient.systems.friends.Friends;
import meteordevelopment.meteorclient.systems.modules.Categories;
import meteordevelopment.meteorclient.systems.modules.Module;
import meteordevelopment.orbit.EventHandler;
import net.minecraft.entity.Entity;
import net.minecraft.entity.LivingEntity;
import net.minecraft.entity.player.PlayerEntity;
import net.minecraft.item.AxeItem;
import net.minecraft.item.ItemStack;
import net.minecraft.item.ShieldItem;
import net.minecraft.item.consume.UseAction;

import java.util.concurrent.ThreadLocalRandom;

/**
 * Rasty ShieldDesync: release shield when the opponent holds an axe.
 */
public class ShieldDesync extends Module {
    private final SettingGroup sg = settings.getDefaultGroup();

    public enum Mode {
        AntiAxe,
        Spam,
        AutoHold
    }

    private final Setting<Mode> mode = sg.add(new EnumSetting.Builder<Mode>()
        .name("режим")
        .defaultValue(Mode.AntiAxe)
        .build()
    );

    private final Setting<Double> range = sg.add(new DoubleSetting.Builder()
        .name("дальность")
        .defaultValue(3.5)
        .min(0)
        .sliderMax(6)
        .build()
    );

    private final Setting<Boolean> pauseWhenUsing = sg.add(new BoolSetting.Builder()
        .name("пауза-при-юзании")
        .description("Не трогает RMB, пока ешь / пьёшь / лук.")
        .defaultValue(true)
        .build()
    );

    private final Setting<Integer> spamMin = sg.add(new IntSetting.Builder()
        .name("спам-мин-мс")
        .defaultValue(150)
        .range(50, 1000)
        .visible(() -> mode.get() == Mode.Spam)
        .build()
    );

    private final Setting<Integer> spamMax = sg.add(new IntSetting.Builder()
        .name("спам-макс-мс")
        .defaultValue(400)
        .range(50, 1500)
        .visible(() -> mode.get() == Mode.Spam)
        .build()
    );

    private static final int AXE_GRACE_TICKS = 8;

    private boolean weControllingKey;
    private long nextToggleMs;
    private boolean spamPressed;
    private int axeGrace;

    public ShieldDesync() {
        super(Categories.Combat, "shield-desync", "Отжимает щит, когда противник берёт топор (Rasty).");
    }

    @Override
    public void onDeactivate() {
        releaseControl();
    }

    @EventHandler
    private void onTick(TickEvent.Pre event) {
        if (mc.player == null || mc.world == null) return;

        if (!(mc.player.getOffHandStack().getItem() instanceof ShieldItem)
            && !(mc.player.getMainHandStack().getItem() instanceof ShieldItem)) {
            releaseControl();
            return;
        }

        if (pauseWhenUsing.get()) {
            ItemStack main = mc.player.getMainHandStack();
            boolean mainNeedsUse = !main.isEmpty()
                && !(main.getItem() instanceof ShieldItem)
                && main.getUseAction() != UseAction.NONE;
            boolean playerIsUsing = mc.player.isUsingItem()
                && !(mc.player.getActiveItem().getItem() instanceof ShieldItem);
            if (mainNeedsUse || playerIsUsing) {
                releaseControl();
                return;
            }
        }

        LivingEntity target = findTarget();
        if (target == null) {
            releaseControl();
            return;
        }

        if (holdsAxe(target)) axeGrace = AXE_GRACE_TICKS;
        else if (axeGrace > 0) axeGrace--;
        boolean danger = axeGrace > 0;

        switch (mode.get()) {
            case AntiAxe -> {
                if (danger) setShield(false);
                else weControllingKey = false;
            }
            case Spam -> {
                if (danger) {
                    setShield(false);
                    spamPressed = false;
                    nextToggleMs = System.currentTimeMillis() + 120L;
                    return;
                }
                long now = System.currentTimeMillis();
                if (now >= nextToggleMs) {
                    spamPressed = !spamPressed;
                    int lo = spamMin.get();
                    int hi = Math.max(lo + 10, spamMax.get());
                    nextToggleMs = now + lo + ThreadLocalRandom.current().nextInt(hi - lo);
                    setShield(spamPressed);
                }
            }
            case AutoHold -> {
                if (danger) setShield(false);
                else setShield(true);
            }
        }
    }

    private void setShield(boolean press) {
        weControllingKey = press;
        mc.options.useKey.setPressed(press);
    }

    private void releaseControl() {
        if (weControllingKey) {
            mc.options.useKey.setPressed(false);
            weControllingKey = false;
        }
        spamPressed = false;
        axeGrace = 0;
    }

    private LivingEntity findTarget() {
        LivingEntity best = null;
        float bestDist = Float.MAX_VALUE;
        float max = range.get().floatValue();
        for (Entity entity : mc.world.getEntities()) {
            if (!(entity instanceof LivingEntity living) || living == mc.player || !living.isAlive()) continue;
            if (!(living instanceof PlayerEntity player)) continue;
            if (Friends.get().isFriend(player)) continue;
            float dist = mc.player.distanceTo(living);
            if (dist > max) continue;
            if (dist < bestDist) {
                bestDist = dist;
                best = living;
            }
        }
        return best;
    }

    private static boolean holdsAxe(LivingEntity entity) {
        return entity.getMainHandStack().getItem() instanceof AxeItem
            || entity.getOffHandStack().getItem() instanceof AxeItem;
    }
}


