        int fromA = from >>> 24 & 0xFF;
        int fromR = from >> 16 & 0xFF;
        int fromG = from >> 8 & 0xFF;
        int fromB = from & 0xFF;

        int toA = to >>> 24 & 0xFF;
        int toR = to >> 16 & 0xFF;
        int toG = to >> 8 & 0xFF;
        int toB = to & 0xFF;

        int a = (int) (fromA + (toA - fromA) * t);
        int r = (int) (fromR + (toR - fromR) * t);
        int g = (int) (fromG + (toG - fromG) * t);
        int b = (int) (fromB + (toB - fromB) * t);

        return a << 24 | r << 16 | g << 8 | b;
    }

    public static Color accentAt(int degrees) {
        float hue = (degrees % 360) / 360f;
        return Color.fromHsv(hue, 0.15f, 0.75f);
    }
