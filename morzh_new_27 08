import org.spongepowered.asm.mixin.injection.Inject;
import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
import org.spongepowered.asm.mixin.injection.callback.CallbackInfoReturnable;

import static meteordevelopment.meteorclient.MeteorClient.mc;
import static org.lwjgl.glfw.GLFW.GLFW_MOUSE_BUTTON_LEFT;

@Mixin(HandledScreen.class)
public abstract class HandledScreenMixin<T extends ScreenHandler> extends Screen implements ScreenHandlerProvider<T> {
    @Shadow
    protected Slot focusedSlot;

    @Shadow
    protected int x;
    @Shadow
    protected int y;

    @Shadow
    protected int backgroundWidth;

    @Shadow
    protected int backgroundHeight;

    @Shadow
    @Nullable
    protected abstract Slot getSlotAt(double xPosition, double yPosition);

    @Shadow
    public abstract T getScreenHandler();

    @Shadow
    private boolean doubleClicking;

    @Shadow
    protected abstract void onMouseClick(Slot slot, int invSlot, int clickData, SlotActionType actionType);

    @Shadow
    public abstract void close();

    @Unique
    private static final ItemStack[] ITEMS = new ItemStack[27];

    @Unique
    private final MenuCursorTrail morzhTrail = new MenuCursorTrail();

    @Unique
    private long morzhLastFrame;

    @Unique
    private long morzhOpenAt;

    @Unique
    private long morzhCloseAt;

    @Unique
    private boolean morzhClosing;

    @Unique
    private boolean morzhActuallyClosing;

    @Unique
    private boolean morzhPushedAnim;

    public HandledScreenMixin(Text title) {
        super(title);
    }

    @Inject(method = "init", at = @At("TAIL"))
    private void onInit(CallbackInfo info) {
        long now = Util.getMeasuringTimeMs();
        morzhLastFrame = now;
        morzhOpenAt = now;
        morzhClosing = false;
        morzhActuallyClosing = false;
        InventoryTweaks invTweaks = Modules.get().get(InventoryTweaks.class);

        if (invTweaks.isActive() && invTweaks.showButtons() && invTweaks.canSteal(getScreenHandler())) {
            addDrawableChild(
                new ButtonWidget.Builder(Text.literal("Steal"), button -> invTweaks.steal(getScreenHandler()))
                    .position(x, y - 22)
                    .size(40, 20)
                    .build()
            );

            addDrawableChild(
                new ButtonWidget.Builder(Text.literal("Dump"), button -> invTweaks.dump(getScreenHandler()))
                    .position(x + 42, y - 22)
                    .size(40, 20)
                    .build()
            );
        }

        AutoBuy autoBuy = Modules.get().get(AutoBuy.class);
        if (autoBuy != null && getScreenHandler() instanceof GenericContainerScreenHandler) {
            String raw = Formatting.strip(getTitle().getString());
            String title = (raw == null ? getTitle().getString() : raw).toLowerCase(java.util.Locale.ROOT);
            if (title.contains("аукцион") || title.contains("категория: настоящие вещи")
                || title.contains("auction") || title.contains("поиск")) {
                int leftX = (width - backgroundWidth) / 2 - 104;
                int startY = (height - backgroundHeight) / 2;
                AhParser parser = AhParser.get();
                addDrawableChild(
                    new ButtonWidget.Builder(parserStatus(parser.isRunning()), button -> {
                        parser.toggle();
                        button.setMessage(parserStatus(parser.isRunning()));
                    })
                        .dimensions(leftX, startY, 95, 20)
                        .build()
                );
                addDrawableChild(new ParserPercentSlider(leftX, startY + 24, 95, 20, autoBuy.getParserPercent(), autoBuy));
                addDrawableChild(
                    new ButtonWidget.Builder(autobuyStatus(autoBuy.isBuying()), button -> {
                        autoBuy.toggleBuyingFromAh();
                        button.setMessage(autobuyStatus(autoBuy.isBuying()));
                    })
                        .position(width / 2 - 50, (height + backgroundHeight) / 2 + 4)
                        .size(100, 20)
                        .build()
                );
            }
        }
    }

    @Unique
    private static Text autobuyStatus(boolean on) {
        return Text.literal("AutoBuy: ").append(Text.literal(on ? "ON" : "OFF").formatted(on ? Formatting.GREEN : Formatting.RED));
    }

    @Unique
    private static Text parserStatus(boolean on) {
        return Text.literal("Parser: ").append(Text.literal(on ? "ON" : "OFF").formatted(on ? Formatting.GREEN : Formatting.RED));
    }

    @Unique
    private static final class ParserPercentSlider extends SliderWidget {
        private final AutoBuy autoBuy;

        private ParserPercentSlider(int x, int y, int width, int height, int percent, AutoBuy autoBuy) {
            super(x, y, width, height, Text.literal("Процент: " + percent + "%"), (Math.max(1, Math.min(80, percent)) - 1) / 79.0);
            this.autoBuy = autoBuy;
        }

        @Override
        protected void updateMessage() {
            setMessage(Text.literal("Процент: " + percent() + "%"));
        }

        @Override
        protected void applyValue() {
            autoBuy.setParserPercent(percent());
        }

        private int percent() {
            return (int) Math.round(value * 79.0) + 1;
        }
    }

    @Inject(method = "close", at = @At("HEAD"), cancellable = true)
    private void morzhInventoryCloseAnim(CallbackInfo ci) {
        InventoryAnim anim = InventoryAnim.instance();
        if (anim == null || !anim.isActive() || !anim.closeEnabled() || morzhActuallyClosing) return;
        if (!morzhClosing) {
            morzhClosing = true;
            morzhCloseAt = Util.getMeasuringTimeMs();
        }
        ci.cancel();
    }

    @Inject(method = "render", at = @At("HEAD"))
    private void morzhInventoryOpenAnim(DrawContext context, int mouseX, int mouseY, float delta, CallbackInfo ci) {
        morzhPushedAnim = false;
        InventoryAnim anim = InventoryAnim.instance();
        if (anim == null || !anim.isActive()) return;

        float p = morzhInventoryAnimProgress(anim);
        if (p >= 0.999f && !morzhClosing) return;

        float eased = 1f - (1f - p) * (1f - p);
        float scale = 0.82f + 0.18f * eased;
        float cx = width / 2f;
        float cy = height / 2f;
        context.getMatrices().push();
        context.getMatrices().translate(cx, cy, 0);
        context.getMatrices().scale(scale, scale, 1f);
        context.getMatrices().translate(-cx, -cy, 0);
        morzhPushedAnim = true;
    }

    @Inject(method = "render", at = @At("TAIL"))
    private void morzhInventoryTrail(DrawContext context, int mouseX, int mouseY, float delta, CallbackInfo ci) {
        if (morzhPushedAnim) {
            context.getMatrices().pop();
            morzhPushedAnim = false;
        }

        InventoryAnim anim = InventoryAnim.instance();
        if (anim != null && anim.isActive() && morzhClosing && !morzhActuallyClosing
            && Util.getMeasuringTimeMs() - morzhCloseAt >= anim.durationMs()) {
            morzhActuallyClosing = true;
            close();
        }

        if (!CursorEmber.showInventory()) {
            drawAutoBuyDeals(context);
            return;
        }
        long now = Util.getMeasuringTimeMs();
        float dt = MathHelper.clamp((now - morzhLastFrame) / 1000f, 0f, 0.08f);
        morzhLastFrame = now;
        float y = mouseY + CursorEmber.y();
        morzhTrail.tick(mouseX, y, dt);
        morzhTrail.drawGui(context);
        drawAutoBuyDeals(context);
    }

    @Unique
    private void drawAutoBuyDeals(DrawContext context) {
        AutoBuy autoBuy = Modules.get() == null ? null : Modules.get().get(AutoBuy.class);
        if (autoBuy == null || autoBuy.deals().isEmpty()) return;
        if (!(getScreenHandler() instanceof GenericContainerScreenHandler)) return;
        String raw = Formatting.strip(getTitle().getString());
        String title = (raw == null ? getTitle().getString() : raw).toLowerCase(java.util.Locale.ROOT);
        if (!(title.contains("аукцион") || title.contains("категория: настоящие вещи")
            || title.contains("auction") || title.contains("поиск"))) return;

        int panelX = x + backgroundWidth + 8;
        int panelY = y;
        int panelW = 148;
        var deals = autoBuy.deals();
        int shown = Math.min(14, deals.size());
        int panelH = 22 + shown * 22 + 6;
        context.fill(panelX, panelY, panelX + panelW, panelY + panelH, 0xC0101010);
        context.drawBorder(panelX, panelY, panelW, panelH, 0xFF3C3C3C);
        context.drawTextWithShadow(textRenderer, "Покупки / окуп (" + deals.size() + ")", panelX + 6, panelY + 6, 0xFFFFFF);
        int rowY = panelY + 20;
        for (int i = 0; i < shown; i++) {
            AutoBuy.Deal deal = deals.get(i);
            String name = deal.name();
            if (name.length() > 18) name = name.substring(0, 17) + "…";
            context.drawTextWithShadow(textRenderer, name, panelX + 6, rowY, 0xFFDDDDDD);
            context.drawTextWithShadow(textRenderer, AutoBuy.formatMoney(deal.paid()), panelX + 6, rowY + 9, 0xFFFF5555);
            String sell = "→ " + AutoBuy.formatMoney(deal.sellToBreakEven());
            context.drawTextWithShadow(textRenderer, sell, panelX + 70, rowY + 9, 0xFF55FF55);
            rowY += 22;
        }
    }

    @Unique
    private float morzhInventoryAnimProgress(InventoryAnim anim) {
        long now = Util.getMeasuringTimeMs();
        float dur = Math.max(80f, (float) anim.durationMs());
        if (morzhClosing) {
            return MathHelper.clamp(1f - (now - morzhCloseAt) / dur, 0f, 1f);
        }
        if (!anim.openEnabled()) return 1f;
        return MathHelper.clamp((now - morzhOpenAt) / dur, 0f, 1f);
    }

    @Inject(method = "shouldPause", at = @At("HEAD"), cancellable = true)
    private void morzhWalkInInventory(CallbackInfoReturnable<Boolean> cir) {
        if (Modules.get() == null) return;
        GUIMove move = Modules.get().get(GUIMove.class);
        if (move != null && move.isActive()) cir.setReturnValue(false);
    }

    @Inject(method = "onMouseClick(Lnet/minecraft/screen/slot/Slot;IILnet/minecraft/screen/slot/SlotActionType;)V", at = @At("HEAD"), cancellable = true)
    private void autoSwapPick(Slot slot, int slotId, int button, SlotActionType actionType, CallbackInfo ci) {
        AutoSwap swap = Modules.get().get(AutoSwap.class);
        if (swap == null || !swap.isPicking() || slot == null || slot.getStack().isEmpty()) return;
        swap.pickFromInventory(slot.getStack());
        ci.cancel();
    }

    // Inventory Tweaks
    @Inject(method = "mouseDragged", at = @At("TAIL"))
    private void onMouseDragged(double mouseX, double mouseY, int button, double deltaX, double deltaY, CallbackInfoReturnable<Boolean> info) {
        if (button != GLFW_MOUSE_BUTTON_LEFT || doubleClicking || !Modules.get().get(InventoryTweaks.class).mouseDragItemMove()) return;

        Slot slot = getSlotAt(mouseX, mouseY);
        if (slot != null && slot.hasStack() && hasShiftDown()) onMouseClick(slot, slot.id, button, SlotActionType.QUICK_MOVE);
    }

    // Middle click open
    @Inject(method = "mouseClicked", at = @At("HEAD"), cancellable = true)
    private void mouseClicked(double mouseX, double mouseY, int button, CallbackInfoReturnable<Boolean> cir) {
        BetterTooltips toolips = Modules.get().get(BetterTooltips.class);

        if (button == GLFW.GLFW_MOUSE_BUTTON_MIDDLE && focusedSlot != null && !focusedSlot.getStack().isEmpty() && mc.player.currentScreenHandler.getCursorStack().isEmpty() && toolips.middleClickOpen()) {
            ItemStack itemStack = focusedSlot.getStack();
            if (Utils.hasItems(itemStack) || itemStack.getItem() == Items.ENDER_CHEST) {
                cir.setReturnValue(Utils.openContainer(focusedSlot.getStack(), ITEMS, false));
            }
            else if (itemStack.get(DataComponentTypes.WRITTEN_BOOK_CONTENT) != null || itemStack.get(DataComponentTypes.WRITABLE_BOOK_CONTENT) != null) {
                close();
                mc.setScreen(new BookScreen(BookScreen.Contents.create(itemStack)));
                cir.setReturnValue(true);
            }
        }
    }

    // Item Highlight
    @Inject(method = "drawSlot", at = @At("HEAD"))
    private void onDrawSlot(DrawContext context, Slot slot, CallbackInfo ci) {
        int color = Modules.get().get(ItemHighlight.class).getColor(slot.getStack());
        if (color != -1) context.fill(slot.x, slot.y, slot.x + 16, slot.y + 16, color);
        AuctionHelper ah = Modules.get().get(AuctionHelper.class);
        if (ah != null) {
            int deal = ah.slotColor(slot);
            if (deal != -1) context.fill(slot.x, slot.y, slot.x + 16, slot.y + 16, deal);
        }
    }
}


