package meteordevelopment.meteorclient.gui.morzh;

import net.minecraft.client.gui.DrawContext;

/**
 * Everything a component needs for one frame, passed down the component tree
 * instead of being threaded through every method as loose parameters.
 */
public final class MorzhGuiContext {
    public final DrawContext draw;

    public final int mouseX;
    public final int mouseY;
    public final float delta;

    /** Open/close fade, multiplied into every colour the tree draws. */
    public final float alpha;

    public String tooltip;

    public MorzhGuiContext(
        DrawContext draw,
        int mouseX,
        int mouseY,
        float delta,
        float alpha
    ) {
        this.draw = draw;
        this.mouseX = mouseX;
        this.mouseY = mouseY;
        this.delta = delta;
        this.alpha = alpha;
    }

    public int fade(int packedColor) {
        int faded = Math.round(
            (packedColor >>> 24) * MorzhAnimUtil.clamp01(alpha)
        );

        return faded << 24 | packedColor & 0x00FFFFFF;
    }
}


