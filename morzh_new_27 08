package meteordevelopment.meteorclient.gui.morzh.dropdown;

import meteordevelopment.meteorclient.gui.morzh.MorzhScissor;
import meteordevelopment.meteorclient.systems.modules.Category;
import meteordevelopment.meteorclient.systems.modules.Module;
import meteordevelopment.meteorclient.systems.modules.Modules;
import net.minecraft.client.gui.DrawContext;
import net.minecraft.util.math.MathHelper;

import java.util.ArrayList;
import java.util.List;

/**
 * One category column. Layout runs in screen space; the header is drawn outside
 * the content scissor so category names are always visible.
 */
public class DropDownPanel {
    private static final float MODULE_GAP = 4f;
    /** Space between header separator and first module row. */
    private static final float CONTENT_TOP_PAD = 4f;

    private static final float MODULE_ROW = 16f;

    private final Category category;
    private final List<DropDownModuleComponent> modules = new ArrayList<>();

    private float x;
    private float y;
    private float width = DropDownScreen.PANEL_WIDTH;
    private float height = DropDownScreen.PANEL_HEIGHT;

    private float scroll;
    private float animatedScroll;
    private float contentHeight;

    private float contentTop;
    private float contentBottom;
    private float viewportHeight;
    private float appear = 1f;

    public DropDownPanel(Category category) {
        this.category = category;

        List<Module> group = Modules.get().getGroup(category);
        if (group == null) return;

        for (Module module : group) {
            modules.add(new DropDownModuleComponent(module));
        }
    }

    /**
     * Computes panel position, scroll limits, and every module rect in screen space.
     * Called before render and before any mouse handler.
     */
    public void layout(int screenW, int screenH, int index, int panelCount, float topInset, float bottomReserve, float extraX, float extraY, float appear) {
        this.appear = appear;
        float gap = DropDownScreen.PANEL_GAP;
        width = Math.min(DropDownScreen.PANEL_WIDTH, (screenW - gap * (panelCount + 1)) / panelCount);

        float header = DropDownScreen.HEADER;
        float maxHeight = screenH - topInset - bottomReserve;
        height = Math.min(DropDownScreen.PANEL_HEIGHT, maxHeight);

        float totalW = panelCount * width + gap * (panelCount - 1);
        x = (screenW - totalW) / 2f + index * (width + gap) + extraX;
        y = topInset + Math.max(0, (screenH - topInset - bottomReserve - height) / 2f) + extraY;

        contentTop = y + header;
        // Use the full panel body for modules. Previously we reserved another header-
        // sized band at the bottom (Expensive footer fade). That empty strip clipped
        // modules early and looked like a solid bar covering the last rows.
        float bottomInset = 4f;
        contentBottom = y + height - bottomInset;
        viewportHeight = Math.max(0, contentBottom - contentTop);

        animatedScroll = DropDownDraw.fast(animatedScroll, scroll, 10);

        float maxSettingsVisible = maxSettingsVisible();

        float moduleW = width - 10;
        float offset = 0;

        for (DropDownModuleComponent module : modules) {
            if (!module.matchesSearch()) continue;
            module.animation.update();
            module.measure(moduleW);
            float expandT = module.animation.getValueF();
            offset += MODULE_ROW + module.getVisibleSettingsHeight(maxSettingsVisible, expandT) + MODULE_GAP;
        }

        contentHeight = offset;

        float scrollRange = Math.max(0, contentHeight + CONTENT_TOP_PAD - viewportHeight);
        if (scrollRange > 0) {
            scroll = MathHelper.clamp(scroll, -scrollRange, 0);
            animatedScroll = MathHelper.clamp(animatedScroll, -scrollRange, 0);
        } else {
            scroll = 0;
            animatedScroll = 0;
        }

        offset = 0;
        for (DropDownModuleComponent module : modules) {
            if (!module.matchesSearch()) continue;
            float expandT = module.animation.getValueF();
            float visibleSettings = module.getVisibleSettingsHeight(maxSettingsVisible, expandT);
            float moduleH = MODULE_ROW + visibleSettings;

            module.clampSettingsScroll(maxSettingsVisible);
            module.updateAnimatedSettingsScroll();

            module.setX(x + 5);
            module.setY(contentTop + CONTENT_TOP_PAD + offset + animatedScroll);
            module.setWidth(moduleW);
            module.setHeight(moduleH);
            module.layoutChildren();

            offset += moduleH + MODULE_GAP;
        }
    }

    private float maxSettingsVisible() {
        return Math.min(200f, Math.max(72f, viewportHeight * 0.55f));
    }

    public void applySearch(String query) {
        for (DropDownModuleComponent module : modules) {
            module.applySearch(query);
        }
    }

    public void render(DrawContext context, float mouseX, float mouseY) {
        if (appear <= 0.01f) return;

        DropDownDraw.setAlpha(appear);
        var matrices = context.getMatrices();
        matrices.push();
        float cx = x + width / 2f;
        float cy = y + height / 2f;
        float scale = 0.92f + 0.08f * appear;
        matrices.translate(cx, cy, 0);
        matrices.scale(scale, scale, 1f);
        matrices.translate(-cx, -cy, 0);
        try {
            float header = DropDownScreen.HEADER;
            float headerFont = 9f;

            float r = DropDownScreen.PANEL_RADIUS;
            DropDownDraw.glass(context, x, y, width, height, r);
            DropDownDraw.rectH(context, x + 8, y + header - 0.5f, width - 16, 0.75f,
                DropDownColors.withAlpha(DropDownColors.PRIMARY, 70),
                DropDownColors.withAlpha(DropDownColors.PRIMARY, 12));
            DropDownDraw.text(
                context,
                category.name,
                x + 10,
                y + header / 2f - DropDownDraw.textHeight(headerFont) / 2f,
                DropDownColors.HEADER_TEXT,
                headerFont
            );

            if (viewportHeight > 0) {
                MorzhScissor.push(x, contentTop, width, viewportHeight);
                for (DropDownModuleComponent module : modules) {
                    if (!module.matchesSearch()) continue;
                    module.render(context, mouseX, mouseY);
                }
                MorzhScissor.pop();
            }
        } finally {
            matrices.pop();
            DropDownDraw.setAlpha(1f);
        }
    }

    public float getX() {
        return x;
    }

    public float getY() {
        return y;
    }

    public float getWidth() {
        return width;
    }

    public float getHeight() {
        return height;
    }

    public void mouseClick(float mouseX, float mouseY, int button) {
        if (!inContent(mouseX, mouseY)) return;

        // Topmost visible module first (same stacking order as render).
        for (int i = modules.size() - 1; i >= 0; i--) {
            DropDownModuleComponent module = modules.get(i);
            if (!module.matchesSearch()) continue;
            if (!module.isHovered(mouseX, mouseY)) continue;
            if (module.getY() + module.getHeight() <= contentTop) continue;
            if (module.getY() >= contentBottom) continue;
            module.mouseClick(mouseX, mouseY, button);
            return;
        }
    }

    public void mouseRelease(float mouseX, float mouseY, int button) {
        for (DropDownModuleComponent module : modules) {
            module.mouseRelease(mouseX, mouseY, button);
        }
    }

    /**
     * Routes scroll to expanded module settings first, then the category module list.
     * @return true if the scroll event was handled
     */
    public boolean mouseScrolled(float mouseX, float mouseY, double verticalAmount) {
        if (!inPanel(mouseX, mouseY)) return false;

        float maxSettingsVisible = maxSettingsVisible();

        if (inContent(mouseX, mouseY)) {
            for (int i = modules.size() - 1; i >= 0; i--) {
                DropDownModuleComponent module = modules.get(i);
                if (!module.matchesSearch()) continue;
                if (module.getY() + module.getHeight() <= contentTop) continue;
                if (module.getY() >= contentBottom) continue;
                if (module.mouseScrolled(mouseX, mouseY, verticalAmount, maxSettingsVisible)) {
                    return true;
                }
            }

            setScroll(getScroll() + (float) (verticalAmount * 20));
            return true;
        }

        return false;
    }

    public void keyPressed(int key, int scanCode, int modifiers) {
        for (DropDownModuleComponent module : modules) {
            module.keyPressed(key, scanCode, modifiers);
        }
    }

    public void charTyped(char codePoint, int modifiers) {
        for (DropDownModuleComponent module : modules) {
            module.charTyped(codePoint, modifiers);
        }
    }

    public boolean isBinding() {
        for (DropDownModuleComponent module : modules) {
            if (module.isBinding()) return true;
        }
        return false;
    }

    public boolean inPanel(float mouseX, float mouseY) {
        return DropDownDraw.hovered(mouseX, mouseY, x, y, width, height);
    }

    public boolean inContent(float mouseX, float mouseY) {
        return DropDownDraw.hovered(mouseX, mouseY, x, contentTop, width, viewportHeight);
    }

    public float getScroll() {
        return scroll;
    }

    public void setScroll(float scroll) {
        this.scroll = scroll;
    }

    public Category getCategory() {
        return category;
    }
}


