/** Really Visual cooldowns: every cooling item, remaining time as 0,0s / m:ss. */
public class CooldownHud extends ScaledHudElement {
    public static final HudElementInfo<CooldownHud> INFO = new HudElementInfo<>(
        Hud.GROUP, "cooldowns", "Item cooldown list.", CooldownHud::new
    );

    private static final Map<Item, String> ITEM_NAMES = new HashMap<>();
    private static Field endTickField;

    static {
        ITEM_NAMES.put(Items.GOLDEN_APPLE, "Золотое яблоко");
        ITEM_NAMES.put(Items.ENCHANTED_GOLDEN_APPLE, "Золотое яблоко");
        ITEM_NAMES.put(Items.FIREWORK_ROCKET, "Фейерверк");
        ITEM_NAMES.put(Items.ENDER_PEARL, "Эндер-шар");
        ITEM_NAMES.put(Items.CHORUS_FRUIT, "Хорус");
        ITEM_NAMES.put(Items.CHORUS_FLOWER, "Хорус");
        ITEM_NAMES.put(Items.SHIELD, "Щит");
        ITEM_NAMES.put(Items.TOTEM_OF_UNDYING, "Тотем");
        ITEM_NAMES.put(Items.ENDER_EYE, "Глаз эндера");
        ITEM_NAMES.put(Items.WIND_CHARGE, "Заряд ветра");
        ITEM_NAMES.put(Items.TRIDENT, "Трезубец");
        ITEM_NAMES.put(Items.CROSSBOW, "Арбалет");
        try {
            for (Class<?> inner : Class.forName("net.minecraft.entity.player.ItemCooldownManager").getDeclaredClasses()) {
                Field first = null;
                Field second = null;
                for (Field field : inner.getDeclaredFields()) {
                    if (field.getType() != int.class && field.getType() != Integer.TYPE) continue;
                    field.setAccessible(true);
                    if (first == null) first = field;
                    else if (second == null) second = field;
                }
                if (first != null && second != null) {
                    endTickField = second;
                    break;
                }
            }
        } catch (Exception ignored) {
        }
    }

    public CooldownHud() {
        super(INFO);
        setSize(135, 28);
    }

    @Override
    public void render(HudRenderer renderer) {
        float s = scale();
        double fs = 0.55 * s;
        List<Row> rows = active();
        if (rows.isEmpty() && isInEditor()) {
            rows.add(new Row(Items.ENDER_PEARL.getDefaultStack(), "Эндер-шар", "0,0s"));
        }
        if (rows.isEmpty() && !isInEditor()) {
            setSize(0, 0);
            return;
        }

        float cardW = 135 * s;
        for (Row row : rows) {
            cardW = Math.max(cardW, (float) MorzhSmoothRenderer.textWidth(row.name, fs) + 70 * s);
        }
        float header = 22 * s;
        float rowH = 18 * s;
        setSize(cardW, header + rows.size() * rowH + 4 * s);

        List<Row> draw = rows;
        renderer.post(() -> {
            DrawContext context = HudRenderer.INSTANCE.drawContext;
            if (context == null) return;
            HudChrome.card(context, x, y, getWidth(), getHeight(), 8 * s);
            HudChrome.header(context, "Cooldowns", x, y, getWidth(), s, fs);

            float rowY = y + header;
            for (Row row : draw) {
                RenderUtils.drawItem(context, row.stack, Math.round(x + 6 * s), Math.round(rowY + 1 * s), 0.7f * s, false);
                MorzhSmoothRenderer.text(context, row.name, x + 26 * s, rowY + 4 * s, 0xFFFFFFFF, true, fs);
                float timeW = (float) MorzhSmoothRenderer.textWidth(row.time, fs) + 8 * s;
                float pillX = x + getWidth() - 6 * s - timeW;
                MorzhSmoothRenderer.roundedRect(context, pillX, rowY + 2 * s, timeW, 13 * s, 4 * s, HudChrome.RV_PILL_ALT);
                MorzhSmoothRenderer.text(context, row.time, pillX + 4 * s, rowY + 3 * s, 0xFFFFFFFF, true, fs);
                rowY += rowH;
            }
        });
    }

    private static List<Row> active() {
        List<Row> list = new ArrayList<>();
        if (mc.player == null) return list;
        try {
            ItemCooldownManagerAccessor accessor = (ItemCooldownManagerAccessor) mc.player.getItemCooldownManager();
            int tick = accessor.getTick();
            Map<Item, Object> entries = accessor.getEntries();
            if (entries == null) return list;
            for (Map.Entry<Item, Object> entry : entries.entrySet()) {
                Item item = entry.getKey();
                Object val = entry.getValue();
                if (item == null || item == Items.AIR || val == null) continue;
                int remaining = remainingTicks(val, tick);
                if (remaining <= 0) continue;
                float secs = remaining / 20.0f;
                String time = secs < 10f
                    ? String.format("%.1fs", secs).replace('.', ',')
                    : String.format("%d:%02d", (int) secs / 60, (int) secs % 60);
                String name = ITEM_NAMES.getOrDefault(item, item.getDefaultStack().getName().getString());
                list.add(new Row(item.getDefaultStack(), name, time));
            }
        } catch (Exception ignored) {
        }
        return list;
    }

    private static int remainingTicks(Object entry, int tick) {
        if (endTickField != null) {
            try {
                return endTickField.getInt(entry) - tick;
            } catch (Exception ignored) {
            }
        }
        try {
            Object end = entry.getClass().getMethod("endTick").invoke(entry);
            if (end instanceof Integer i) return i - tick;
        } catch (Exception ignored) {
        }
        return 0;
    }

    private record Row(ItemStack stack, String name, String time) {}
}


