    public WorldLighting() {
        super(
            Categories.Render,
            "world-lighting",
            "Vanilla Minecraft light around you and Target ESP. Gloss sits on block tops.",
            "dynamic-light",
            "dynamic light",
            "player-intensity",
            "мощность",
            "intensity",
            "gloss",
            "gloss-level",
            "wet-noise",
            "wet-reflect",
            "wet-blur",
            "target-glow",
            "глянец",
            "освещение",
