    private static float easeOut(float t) {
        t = MathHelper.clamp(t, 0f, 1f);
        return 1f - (float) Math.pow(1f - t, 3);
    }

    private static float smooth(float a, float b, float x) {
        float v = MathHelper.clamp((x - a) / (b - a), 0f, 1f);
        return v * v * (3f - 2f * v);
    }

    private record Fx(Vec3d pos, long at, int life, Mode mode) {}

    public enum Mode { Shatter, Soul }

    public enum KillSound { Skeet, Metallic, Crit, Bonk, Off }

    private static class LineMesh extends ShaderMesh {
        private LineMesh() {
            super(Shaders.POS_COLOR, DrawMode.Triangles, Mesh.Attrib.Vec3, Mesh.Attrib.Color);
        }

        @Override
        protected void beforeRender() {
            super.beforeRender();
            GlStateManager._enableBlend();
            GlStateManager._blendFunc(GL_SRC_ALPHA, GL_ONE);
            GlStateManager._depthMask(false);
            GlStateManager._disableCull();
        }
    }

