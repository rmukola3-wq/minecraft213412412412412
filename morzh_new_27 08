import meteordevelopment.meteorclient.gui.morzh.MorzhSmoothRenderer;
import meteordevelopment.meteorclient.gui.morzh.dropdown.DropDownColors;
import meteordevelopment.meteorclient.systems.hud.Hud;
import meteordevelopment.meteorclient.systems.hud.HudChrome;
import meteordevelopment.meteorclient.systems.hud.HudElementInfo;
import meteordevelopment.meteorclient.systems.hud.HudRenderer;
import meteordevelopment.meteorclient.systems.hud.MorzhNotifications;
import meteordevelopment.meteorclient.systems.hud.ScaledHudElement;
import net.minecraft.client.gui.DrawContext;
import net.minecraft.util.math.MathHelper;

import java.util.List;

public class NotifyHud extends ScaledHudElement {
    public static final HudElementInfo<NotifyHud> INFO = new HudElementInfo<>(
        Hud.GROUP, "notify", "On-screen alerts. Drag and scale in the HUD editor.", NotifyHud::new
    );

    public NotifyHud() {
        super(INFO);
        setSize(160, 24);
    }

    @Override
    protected void onScaleChanged() {
        setSize(Math.max(80, getWidth()), Math.max(18, getHeight()));
    }

    @Override
    public void render(HudRenderer renderer) {
        float s = scale();
        double fs = 0.58 * s;
        long now = System.currentTimeMillis();
        List<MorzhNotifications.Toast> toasts = MorzhNotifications.snapshot(now, 2800);
        if (toasts.isEmpty() && isInEditor()) {
            toasts = List.of(
                new MorzhNotifications.Toast("KillAura", "активирован", MorzhNotifications.Kind.On, now),
                new MorzhNotifications.Toast("Totem", "Steve popped", MorzhNotifications.Kind.Warn, now)
            );
        }
        if (toasts.isEmpty()) {
            setSize(140 * s, 20 * s);
            return;
        }

        float rowH = 18 * s;
        float gap = 3 * s;
        float width = 140 * s;
        for (MorzhNotifications.Toast toast : toasts) {
            String line = line(toast);
            width = Math.max(width, (float) MorzhSmoothRenderer.textWidth(line, fs) + 22 * s);
        }
        float height = toasts.size() * (rowH + gap) - gap;
        setSize(width, height);

        final float panelW = width;
        final List<MorzhNotifications.Toast> draw = toasts;
        renderer.post(() -> {
            DrawContext context = HudRenderer.INSTANCE.drawContext;
            if (context == null) return;
            for (int i = 0; i < draw.size(); i++) {
                MorzhNotifications.Toast toast = draw.get(i);
                float life = isInEditor() ? 1f : 1f - (now - toast.at()) / 2800f;
                float anim = isInEditor() ? 1f : Math.min(1f, (now - toast.at()) / 160f) * MathHelper.clamp(life * 5f, 0f, 1f);
                if (anim <= 0.02f) continue;
                float rowY = y + i * (rowH + gap) + (1f - anim) * 6f * s;
                int a = MathHelper.clamp((int) (255 * anim), 0, 255);

                HudChrome.card(context, x, rowY, panelW, rowH, 6 * s);
                int accent = switch (toast.kind()) {
                    case On -> DropDownColors.rgb(90, 210, 110);
                    case Off -> DropDownColors.rgb(230, 80, 80);
                    case Warn -> DropDownColors.rgb(230, 180, 70);
                    case Info -> DropDownColors.PRIMARY;
                };
                MorzhSmoothRenderer.roundedRect(context, x + 5 * s, rowY + 4 * s, 3 * s, rowH - 8 * s, 1.4f * s,
                    DropDownColors.withAlpha(accent, a));
                MorzhSmoothRenderer.text(context, line(toast), x + 12 * s, rowY + 4 * s,
                    DropDownColors.withAlpha(0xFFFFFFFF, a), true, fs);
            }
        });
    }

    private static String line(MorzhNotifications.Toast toast) {
        if (toast.title().isEmpty()) return toast.body();
        if (toast.body().isEmpty()) return toast.title();
        return toast.title() + "  " + toast.body();
    }
}


