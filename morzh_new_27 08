            while (dx != 0.0 && dz != 0.0 && player.getEntityWorld().isSpaceEmpty(player, boundingBox.offset(dx, -STEP_HEIGHT, dz))) {
                dx = (dx < step && dx >= -step) ? 0.0 : (dx > 0 ? dx - step : dx + step);
                if (dz < step && dz >= -step) {
