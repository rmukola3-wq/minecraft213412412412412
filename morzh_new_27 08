package meteordevelopment.meteorclient.gui.rasty.util.render.pipeline;

import meteordevelopment.meteorclient.renderer.GL;
import meteordevelopment.meteorclient.renderer.Shader;
import net.minecraft.client.MinecraftClient;
import org.lwjgl.opengl.GL11;
import org.lwjgl.opengl.GL12;

import static org.lwjgl.opengl.GL11C.GL_RGBA;
import static org.lwjgl.opengl.GL11C.GL_RGBA8;
import static org.lwjgl.opengl.GL11C.GL_TEXTURE_2D;
import static org.lwjgl.opengl.GL11C.GL_UNSIGNED_BYTE;
import static org.lwjgl.opengl.GL11C.glCopyTexSubImage2D;
import static org.lwjgl.opengl.GL11C.glTexImage2D;

public class BlurPipeline {
    private static final float FIXED_GUI_SCALE = 2.0f;
    private Shader shader;
    private int copyTexture;
    private int lastWidth;
    private int lastHeight;

    private void ensureShader() {
        if (shader == null) shader = new Shader("rasty_blur.vert", "rasty_blur.frag");
    }

    public void drawBlur(float x, float y, float width, float height, float blurRadius, float[] radii, int tintColor) {
        MinecraftClient client = MinecraftClient.getInstance();
        if (client.getFramebuffer() == null) return;

        ensureShader();
        int source = meteordevelopment.meteorclient.renderer.KawaseBlur.texture();
        if (source <= 0) {
            client.getFramebuffer().beginWrite(false);
            copyFramebuffer(client);
            source = copyTexture;
        }
        if (source <= 0) return;
        GL.bindTexture(source, 0);

        int framebufferWidth = client.getWindow().getFramebufferWidth();
        int framebufferHeight = client.getWindow().getFramebufferHeight();
        float fixedScreenWidth = framebufferWidth / FIXED_GUI_SCALE;
        float fixedScreenHeight = framebufferHeight / FIXED_GUI_SCALE;

        float a = ((tintColor >> 24) & 0xFF) / 255.0f;
        float r = ((tintColor >> 16) & 0xFF) / 255.0f;
        float g = ((tintColor >> 8) & 0xFF) / 255.0f;
        float b = (tintColor & 0xFF) / 255.0f;

        shader.bind();
        shader.set("Sampler0", 0);
        shader.set("u_Rect", x, y, width, height);
        shader.set("u_Screen", fixedScreenWidth, fixedScreenHeight, FIXED_GUI_SCALE, blurRadius);
        shader.set("u_FramebufferSize", (float) framebufferWidth, (float) framebufferHeight, 0, 0);
        shader.set("u_Radii", radii[0], radii[1], radii[2], radii[3]);
        shader.set("u_Color", r, g, b, a);
        GlDraw.triangles(6);
    }

    private void copyFramebuffer(MinecraftClient client) {
        int w = client.getFramebuffer().textureWidth;
        int h = client.getFramebuffer().textureHeight;
        if (copyTexture == 0) copyTexture = GL.genTexture();
        GL.bindTexture(copyTexture);
        GL.textureParam(GL_TEXTURE_2D, GL11.GL_TEXTURE_MIN_FILTER, GL11.GL_LINEAR);
        GL.textureParam(GL_TEXTURE_2D, GL11.GL_TEXTURE_MAG_FILTER, GL11.GL_LINEAR);
        GL.textureParam(GL_TEXTURE_2D, GL11.GL_TEXTURE_WRAP_S, GL12.GL_CLAMP_TO_EDGE);
        GL.textureParam(GL_TEXTURE_2D, GL11.GL_TEXTURE_WRAP_T, GL12.GL_CLAMP_TO_EDGE);
        if (lastWidth != w || lastHeight != h) {
            glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, 0L);
            lastWidth = w;
            lastHeight = h;
        }
        glCopyTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, 0, 0, w, h);
    }
}


