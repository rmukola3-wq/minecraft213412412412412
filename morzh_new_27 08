package meteordevelopment.meteorclient.gui.morzh;

import meteordevelopment.meteorclient.gui.themes.morzh.MorzhGuiColors;
import meteordevelopment.meteorclient.settings.BoolSetting;
import meteordevelopment.meteorclient.utils.sound.MorzhSoundManager;

public class MorzhBoolSettingComponent extends MorzhSettingComponent {
    private static final float BOX_SIZE = 8f;
    private static final float CHECK_RESPONSIVENESS = 18f;

    private final BoolSetting boolSetting;

    private float checkProgress;

    public MorzhBoolSettingComponent(
        MorzhComponent parent,
        BoolSetting setting,
        int x,
        int y,
        int width
    ) {
        super(parent, setting, x, y, width, ROW_HEIGHT);

        this.boolSetting = setting;
        this.checkProgress = setting.get() ? 1f : 0f;
    }

    @Override
    public void tick(float delta) {
        checkProgress = MorzhAnimUtil.approach(
            checkProgress,
            boolSetting.get() ? 1f : 0f,
            CHECK_RESPONSIVENESS,
            delta
        );
    }

    @Override
    public void render(MorzhGuiContext context) {
        float top = absoluteY();

        drawLabel(context, top, BOX_SIZE + 3);

        float boxX = absoluteX() + width() - PADDING - BOX_SIZE;
        float boxY = top + (ROW_HEIGHT - BOX_SIZE) / 2f;

        MorzhSmoothRenderer.roundedRect(
            context.draw,
            boxX,
            boxY,
            BOX_SIZE,
            BOX_SIZE,
            2f,
            context.fade(MorzhGuiColors.packed(MorzhGuiColors.TOGGLE_TRACK)),
            context.fade(MorzhGuiColors.packed(MorzhGuiColors.OUTLINE_DARK)),
            1f
        );

        if (checkProgress > 0.01f) {
            float inset = 2f + (1f - checkProgress) * (BOX_SIZE / 2f - 2f);

            MorzhSmoothRenderer.roundedRect(
                context.draw,
                boxX + inset,
                boxY + inset,
                BOX_SIZE - inset * 2f,
                BOX_SIZE - inset * 2f,
                1.5f,
                context.fade(
                    withAlpha(
                        MorzhGuiColors.packed(MorzhGuiColors.ACCENT),
                        checkProgress
                    )
                )
            );
        }

        offerTooltip(context);
    }

    @Override
    public boolean mouseClicked(double mouseX, double mouseY, int button) {
        if (button != 0 || !isHovered(mouseX, mouseY)) return false;

        boolSetting.set(!boolSetting.get());
        MorzhSoundManager.playBoolean();

        return true;
    }

    private static int withAlpha(int packedColor, float multiplier) {
        int alpha = Math.round(
            (packedColor >>> 24) * MorzhAnimUtil.clamp01(multiplier)
        );

        return alpha << 24 | packedColor & 0x00FFFFFF;
    }
}


