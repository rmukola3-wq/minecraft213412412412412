package meteordevelopment.meteorclient.systems.modules.movement.speed.modes;

import meteordevelopment.meteorclient.events.entity.player.PlayerMoveEvent;
import meteordevelopment.meteorclient.mixininterface.IVec3d;
import meteordevelopment.meteorclient.systems.modules.movement.speed.SpeedMode;
import meteordevelopment.meteorclient.systems.modules.movement.speed.SpeedModes;
import net.minecraft.network.packet.c2s.play.PlayerMoveC2SPacket;
import net.minecraft.util.math.Vec3d;

/**
 * Vulcan Y-Port: 4-tick air cycle, Y snap to 1/64, extra on-ground packet.
 * From the dump — motion only, no process/network extras.
 */
public class YPort extends SpeedMode {
    private static final double GRID = 0.015625;

    private int step;
    private double startHeight;
    private double lastMotionX, lastMotionZ;
    private boolean vulcanSwitch;
    private boolean vulcanFalling;
    private int vulcanResetCount;

    public YPort() {
        super(SpeedModes.YPort);
    }

    @Override
    public void onActivate() {
        resetCycle();
        if (mc.player != null) startHeight = snapDown(mc.player.getY());
    }

    @Override
    public void onDeactivate() {
        resetCycle();
    }

    @Override
    public void onRubberband() {
        resetCycle();
    }

    @Override
    public void onMove(PlayerMoveEvent event) {
        if (mc.player == null || mc.player.networkHandler == null) return;
        if (mc.player.isOnGround()) {
            resetCycle();
            startHeight = snapDown(mc.player.getY());
            return;
        }

        boolean sneaking = mc.player.isSneaking() || mc.options.sneakKey.isPressed();
        boolean jumping = mc.options.jumpKey.isPressed();
        double currentY = mc.player.getY();

        if (vulcanFalling && !sneaking) {
            startHeight = snapDown(currentY);
            vulcanFalling = false;
            vulcanResetCount++;
            step--;
        }

        double motionX = mc.player.getVelocity().x;
        double motionY = 0;
        double motionZ = mc.player.getVelocity().z;
        double deltaY = currentY - startHeight;
        step++;

        switch (step) {
            case 1 -> {
                if (deltaY < 0.073) {
                    if (deltaY > 0 || vulcanResetCount > 1) motionY = -deltaY;
                    vulcanSwitch = true;
                } else {
                    step--;
                    return;
                }
            }
            case 2 -> mc.player.networkHandler.sendPacket(
                new PlayerMoveC2SPacket.OnGroundOnly(false, mc.player.horizontalCollision)
            );
            case 3 -> {
                lastMotionX = motionX;
                lastMotionZ = motionZ;
                motionY = -deltaY + (vulcanSwitch ? GRID : (jumping ? 0.5 : 0.0625));
                if (jumping) startHeight = currentY + motionY;
            }
            case 4 -> {
                vulcanSwitch = !vulcanSwitch;
                motionX = lastMotionX * 0.88;
                motionY = sneaking ? (vulcanSwitch ? -0.097000002 : -0.147000003) : -0.097000002;
                motionZ = lastMotionZ * 0.88;
                vulcanFalling = sneaking;
                if (sneaking) step--;
                else step = 1;
            }
            default -> step = 1;
        }

        Vec3d next = new Vec3d(motionX, motionY, motionZ);
        mc.player.setVelocity(next);
        ((IVec3d) event.movement).meteor$set(motionX, motionY, motionZ);
    }

    private void resetCycle() {
        step = 0;
        vulcanSwitch = false;
        vulcanFalling = false;
        vulcanResetCount = 0;
        lastMotionX = lastMotionZ = 0;
    }

    private static double snapDown(double y) {
        return Math.floor(y / GRID) * GRID;
    }
}


