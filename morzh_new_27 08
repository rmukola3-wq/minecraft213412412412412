package meteordevelopment.meteorclient.systems.modules.combat.aura.expensive;

import net.minecraft.block.Block;
import net.minecraft.block.BlockState;
import net.minecraft.util.math.BlockPos;
import net.minecraft.util.math.Box;
import net.minecraft.util.math.MathHelper;

import java.util.function.Predicate;

import static meteordevelopment.meteorclient.MeteorClient.mc;

public final class BlockUtil {
    public static boolean checkBlockIntersection(Box box, Predicate<Block> predicate) {
        if (mc.player == null || mc.world == null) return false;
        int minX = MathHelper.floor(box.minX);
        int minY = MathHelper.floor(box.minY);
        int minZ = MathHelper.floor(box.minZ);
        int maxX = MathHelper.ceil(box.maxX);
        int maxY = MathHelper.ceil(box.maxY);
        int maxZ = MathHelper.ceil(box.maxZ);
        BlockPos.Mutable pos = new BlockPos.Mutable();
        for (int x = minX; x <= maxX; x++) {
            for (int y = minY; y <= maxY; y++) {
                for (int z = minZ; z <= maxZ; z++) {
                    pos.set(x, y, z);
                    BlockState state = mc.world.getBlockState(pos);
                    if (state != null && predicate.test(state.getBlock()) && box.intersects(new Box(pos))) return true;
                }
            }
        }
        return false;
    }

    private BlockUtil() {}
}


