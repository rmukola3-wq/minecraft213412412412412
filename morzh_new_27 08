        GuiAnimations animations = Modules.get() != null ? Modules.get().get(GuiAnimations.class) : null;
        if (animations != null && animations.chatEnabled()) {
            animations.chatLineAnims.values().forEach(GuiAnimations.SlideAnim::tick);
            animations.chatLineAnims.entrySet().removeIf(e -> e.getValue().finished());
            pulseChatIndex = 0;
