package meteordevelopment.meteorclient.systems.modules.render;

import meteordevelopment.meteorclient.renderer.Mesh;
import meteordevelopment.meteorclient.utils.render.color.Color;
import net.minecraft.util.math.MathHelper;
import net.minecraft.util.math.Vec3d;
import org.joml.Matrix4f;
import org.joml.Vector4f;

final class XyetaJumpCircles {
    private final Color tmp = new Color();
    private final Vector4f scratch = new Vector4f();

    void draw(JumpCircle.XyetaMode mode, Mesh fill, Mesh lines, Matrix4f matrix, Vec3d cam, float radius, float alpha, long elapsed, Color theme) {
        float a = MathHelper.clamp(alpha, 0.0f, 2.0f);
        if (a < 0.01f) return;

        float t = elapsed * 0.004f;
        switch (mode) {
            case Pulse -> drawPulse(fill, lines, matrix, cam, radius, a, t, theme);
            case Spiral -> drawSpiral(fill, lines, matrix, cam, radius, a, t, theme);
            case Nova -> drawNova(fill, lines, matrix, cam, radius, a, t, theme);
        }
    }

    private void drawPulse(Mesh fill, Mesh lines, Matrix4f matrix, Vec3d cam, float radius, float alpha, float t, Color theme) {
        for (int i = 0; i < 6; i++) {
            float f = i / 6.0f;
            float inner = radius * (0.55f + f * 0.7f + pulse(t + f) * 0.04f);
            float outer = inner + radius * 0.07f;
            ring(fill, matrix, cam, inner, outer, 40, tint(theme, alpha * (1.0f - f) * 0.35f));
        }
        ringLine(lines, matrix, cam, radius * (1.05f + pulse(t) * 0.05f), 48, tint(theme, alpha * 0.9f));
    }

    private void drawSpiral(Mesh fill, Mesh lines, Matrix4f matrix, Vec3d cam, float radius, float alpha, float t, Color theme) {
        int segs = 64;
        int prev = -1;
        for (int i = 0; i <= segs; i++) {
            float f = i / (float) segs;
            float ang = f * 6.2831855f * 2.2f + t;
            float r = radius * (0.15f + f * 0.95f);
            int cur = vert(lines, matrix, cam, (float) Math.cos(ang) * r, (float) Math.sin(ang) * r, tint(theme, alpha * (1.0f - f * 0.4f)));
            if (prev >= 0) lines.line(prev, cur);
            prev = cur;
        }
        ring(fill, matrix, cam, radius * 0.12f, radius * 0.22f, 28, tint(theme, alpha * 0.45f));
    }

    private void drawNova(Mesh fill, Mesh lines, Matrix4f matrix, Vec3d cam, float radius, float alpha, float t, Color theme) {
        int spokes = 12;
        for (int i = 0; i < spokes; i++) {
            float ang = i / (float) spokes * 6.2831855f + t * 0.35f;
            float c = (float) Math.cos(ang);
            float s = (float) Math.sin(ang);
            int a0 = vert(fill, matrix, cam, c * radius * 0.08f, s * radius * 0.08f, tint(theme, alpha * 0.15f));
            int a1 = vert(fill, matrix, cam, c * radius * 1.05f, s * radius * 1.05f, tint(theme, 0));
            int a2 = vert(fill, matrix, cam, (float) Math.cos(ang + 0.08f) * radius * 1.05f, (float) Math.sin(ang + 0.08f) * radius * 1.05f, tint(theme, 0));
            fill.triangle(a0, a1, a2);
        }
        ring(fill, matrix, cam, radius * 0.85f, radius * 0.98f, 36, tint(theme, alpha * 0.4f));
        ringLine(lines, matrix, cam, radius * 1.02f, 36, tint(theme, alpha * 0.8f));
    }

    private void ring(Mesh mesh, Matrix4f matrix, Vec3d cam, float inner, float outer, int segs, Color color) {
        Color fade = new Color(color.r, color.g, color.b, 0);
        for (int i = 0; i < segs; i++) {
            float a0 = i / (float) segs * 6.2831855f;
            float a1 = (i + 1) / (float) segs * 6.2831855f;
            float c0 = (float) Math.cos(a0), s0 = (float) Math.sin(a0);
            float c1 = (float) Math.cos(a1), s1 = (float) Math.sin(a1);
            int i1 = vert(mesh, matrix, cam, c0 * inner, s0 * inner, fade);
            int i2 = vert(mesh, matrix, cam, c0 * outer, s0 * outer, color);
            int i3 = vert(mesh, matrix, cam, c1 * outer, s1 * outer, color);
            int i4 = vert(mesh, matrix, cam, c1 * inner, s1 * inner, fade);
            mesh.quad(i1, i2, i3, i4);
        }
    }

    private void ringLine(Mesh mesh, Matrix4f matrix, Vec3d cam, float radius, int segs, Color color) {
        int first = -1;
        int prev = -1;
        for (int i = 0; i <= segs; i++) {
            float ang = i / (float) segs * 6.2831855f;
            int cur = vert(mesh, matrix, cam, (float) Math.cos(ang) * radius, (float) Math.sin(ang) * radius, color);
            if (i == 0) first = cur;
            if (prev >= 0) mesh.line(prev, cur);
            prev = cur;
        }
        if (first >= 0 && prev >= 0) mesh.line(prev, first);
    }

    private int vert(Mesh mesh, Matrix4f matrix, Vec3d cam, float lx, float ly, Color color) {
        scratch.set(lx, ly, 0.0f, 1.0f);
        scratch.mul(matrix);
        return mesh.vec3(scratch.x + cam.x, scratch.y + cam.y, scratch.z + cam.z).color(color).next();
    }

    private Color tint(Color theme, float alpha) {
        tmp.set(theme.r, theme.g, theme.b, MathHelper.clamp((int) (theme.a * MathHelper.clamp(alpha, 0.0f, 1.0f)), 0, 255));
        return tmp;
    }

    private static float pulse(float t) {
        return (float) (0.5 + 0.5 * Math.sin(t));
    }
}


