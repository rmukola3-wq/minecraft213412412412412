package meteordevelopment.meteorclient.systems.modules.combat.aura.rockstar;

import net.minecraft.client.MinecraftClient;
import net.minecraft.entity.Entity;
import net.minecraft.entity.LivingEntity;
import net.minecraft.util.hit.HitResult;
import net.minecraft.util.math.Box;
import net.minecraft.util.math.MathHelper;
import net.minecraft.util.math.Vec3d;
import net.minecraft.world.RaycastContext;

import java.util.concurrent.ThreadLocalRandom;

import static meteordevelopment.meteorclient.MeteorClient.mc;

/**
 * Rotation and reach helpers ported from Rockstar Premium
 * {@code fun.rockstarity.api.helpers.math.aura} / {@code MathUtility}.
 */
public final class RockstarMath {
    private RockstarMath() {
    }

    public static float gcd() {
        double sensitivity = mc.options.getMouseSensitivity().getValue();
        double factor = sensitivity * 0.6 + 0.2;
        return (float) (factor * factor * factor * 8.0 * 0.15);
    }

    /** {@code Rotation.get} GCD used by Classic / FunTime. */
    public static float[] anglesTo(Vec3d from, Vec3d target) {
        double posX = target.x - from.x;
        double posY = target.y - from.y;
        double posZ = target.z - from.z;
        double horizontal = MathHelper.sqrt((float) (posX * posX + posZ * posZ));

        float yaw = (float) (Math.atan2(posZ, posX) * 180.0 / Math.PI) - 90.0f;
        float pitch = (float) (-(Math.atan2(posY, horizontal) * 180.0 / Math.PI));

        float sensitivity = (float) (
            Math.pow(mc.options.getMouseSensitivity().getValue(), 1.5) * 0.05f + 0.1f
        );
        float pow = sensitivity * sensitivity * sensitivity * 1.2f;

        yaw -= yaw % pow;
        pitch -= pitch % (pow * sensitivity);

        return new float[]{yaw, MathHelper.clamp(pitch, -90.0f, 90.0f)};
    }

    public static float[] anglesToEyes(Vec3d target) {
        return anglesTo(mc.player.getEyePos(), target);
    }

    public static float correctRotation(float rotation) {
        float gcd = gcd();
        if (gcd == 0.0f) return rotation;
        return rotation - rotation % gcd;
    }

    public static float[] correctRotation(float yaw, float pitch) {
        return new float[]{
            correctRotation(yaw),
            MathHelper.clamp(correctRotation(pitch), -90.0f, 90.0f)
        };
    }

    public static float getSens(float rotation) {
        float gcd = gcd();
        if (gcd == 0.0f) return rotation;
        return Math.round(rotation / gcd) * gcd;
    }

    public static Vec3d closestPoint(LivingEntity target) {
        return closestPoint(target, target.getBoundingBox());
    }

    public static Vec3d closestPoint(LivingEntity target, Box box) {
        Vec3d eyes = mc.player.getEyePos();

        return new Vec3d(
            MathHelper.clamp(eyes.x, box.minX, box.maxX),
            MathHelper.clamp(eyes.y, box.minY, box.maxY),
            MathHelper.clamp(eyes.z, box.minZ, box.maxZ)
        );
    }

    /** Equivalent to vanilla {@code Entity#getRotationVector(pitch, yaw)}. */
    public static Vec3d rotationVector(float yaw, float pitch) {
        float yawRad = -yaw * ((float) Math.PI / 180.0f);
        float pitchRad = pitch * ((float) Math.PI / 180.0f);
        float yawCos = MathHelper.cos(yawRad);
        float yawSin = MathHelper.sin(yawRad);
        float pitchCos = MathHelper.cos(pitchRad);
        float pitchSin = MathHelper.sin(pitchRad);

        return new Vec3d(yawSin * pitchCos, -pitchSin, yawCos * pitchCos);
    }

    public static boolean rayTrace(
        double range,
        float yaw,
        float pitch,
        Entity target
    ) {
        return rayTrace(range, yaw, pitch, target, null);
    }

    /**
     * @param combatBox box the aim point was taken from. Resolver and backtrack modes aim
     *                  at a shifted box, so the ray has to be tested against that same box
     *                  instead of the live hitbox.
     */
    public static boolean rayTrace(
        double range,
        float yaw,
        float pitch,
        Entity target,
        Box combatBox
    ) {
        if (mc.player == null || target == null || range <= 0) return false;

        Vec3d eyes = mc.player.getEyePos();
        Vec3d end = eyes.add(rotationVector(yaw, pitch).multiply(range));

        Box box = (combatBox != null ? combatBox : target.getBoundingBox()).expand(0.2);

        // Box#raycast finds no intersection when the origin is already inside the box,
        // which happens point blank. Vanilla ProjectileUtil treats that as a hit.
        if (box.contains(eyes)) return true;

        return box.raycast(eyes, end).isPresent();
    }

    public static boolean canSee(Vec3d point) {
        if (mc.player == null || mc.world == null || point == null) return false;

        return mc.world.raycast(
            new RaycastContext(
                mc.player.getEyePos(),
                point,
                RaycastContext.ShapeType.COLLIDER,
                RaycastContext.FluidHandling.NONE,
                mc.player
            )
        ).getType() == HitResult.Type.MISS;
    }

    public static float step(float current, float target, float step) {
        float difference = target - current;
        if (Math.abs(difference) <= step) return target;
        return current + Math.signum(difference) * step;
    }

    public static float wrapDelta(float from, float to) {
        return (float) (((((to - from) % 360.0) + 540.0) % 360.0) - 180.0);
    }

    public static float fovTo(Entity entity, float yaw) {
        double diffX = entity.getX() - mc.player.getX();
        double diffZ = entity.getZ() - mc.player.getZ();
        float angle = (float) (Math.toDegrees(Math.atan2(diffZ, diffX)) - 90.0);
        return Math.abs(MathHelper.wrapDegrees(angle - yaw));
    }

    public static float random(double min, double max) {
        if (max <= min) return (float) min;
        return (float) ThreadLocalRandom.current().nextDouble(min, max);
    }

    public static int randomInt(int min, int max) {
        if (max <= min) return min;
        return ThreadLocalRandom.current().nextInt(min, max + 1);
    }

    public static float[] fixDeltaNonVanillaMouse(float delta, float secondDelta) {
        float value = random(0.1, 0.8) + (float) Math.pow(random(-0.3, 0.3), 3);
        if (Math.abs(delta) > 0 && Math.abs(secondDelta) == 0) secondDelta += value;
        if (Math.abs(secondDelta) > 0 && Math.abs(delta) == 0) delta += value;
        return new float[]{delta, secondDelta};
    }

    public static MinecraftClient client() {
        return mc;
    }
}


