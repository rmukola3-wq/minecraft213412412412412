            DrawContext context = HudRenderer.INSTANCE.drawContext;
            if (context == null) return;
            if (background.get()) HudChrome.card(context, x, y, cardW, cardH, 8 * s);

            for (int row = 0; row < rows; row++) {
                for (int col = 0; col < cols; col++) {
                    int slotIndex = 9 + row * cols + col;
                    float slotX = x + padding + col * (slotSize + gap);
                    float slotY = y + padding + row * (slotSize + gap);
