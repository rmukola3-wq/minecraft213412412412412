/**
 * Rasty AutoPotion 1:1: Linear look-down, wait until pitch &gt;= 80 and 2 ticks, then hotbar slot + sequenced interact.
 */
public class AutoPotion extends Module {
    private static final float THROW_PITCH = 90f;
    private static final int ROTATION_WAIT_TICKS = 2;
    private static final long THROW_COOLDOWN_MS = 500L;
    private static final RotationConfig LOOK_DOWN = new RotationConfig(new BlockRotationMode(), false, true, false);

    private final SettingGroup sgGeneral = settings.getDefaultGroup();

    private final Setting<Boolean> strength = sgGeneral.add(new BoolSetting.Builder()
        .name("сила")
        .defaultValue(true)
        .build()
    );

    private final Setting<Boolean> speed = sgGeneral.add(new BoolSetting.Builder()
        .name("скорость")
        .defaultValue(true)
        .build()
    );

    private final Setting<Boolean> fireResistance = sgGeneral.add(new BoolSetting.Builder()
        .name("огнестойкость")
        .defaultValue(false)
        .build()
    );

    private final Setting<Boolean> autoOff = sgGeneral.add(new BoolSetting.Builder()
        .name("авто-отключение")
        .description("Выключить модуль после броска.")
        .defaultValue(false)
        .build()
    );

    private boolean spoofed;
    private boolean isActivePotion;
    private int rotationTicks;
    private int selectedSlot = -1;
    private long lastThrowAt;

    public AutoPotion() {
        super(
            Categories.Combat,
            "auto-potion",
            "Rasty AutoPotion: смотрит в пол, ждёт pitch и кидает splash с хотбара.",
            "autobuff",
            "перебаф",
            "зелье"
        );
    }

    @Override
    public void onActivate() {
        resetThrowState(false);
        lastThrowAt = 0;
    }

    @Override
    public void onDeactivate() {
        resetThrowState(true);
        AngleConnection.INSTANCE.startReturning();
        if (expensiveAuraActive()) PlayerRotationManager.INSTANCE.cancelTasksFor(this);
    }

    public boolean isThrowing() {
        return isActive() && (spoofed || isActivePotion);
    }

    private enum PotionType {
        STRENGTH(StatusEffects.STRENGTH),
        SPEED(StatusEffects.SPEED),
        FIRE_RESISTANCE(StatusEffects.FIRE_RESISTANCE);

        private final RegistryEntry<StatusEffect> effect;

        PotionType(RegistryEntry<StatusEffect> effect) {
            this.effect = effect;
        }

        private boolean enabled(AutoPotion module) {
            return switch (this) {
                case STRENGTH -> module.strength.get();
                case SPEED -> module.speed.get();
                case FIRE_RESISTANCE -> module.fireResistance.get();
            };
        }
    }

    private int findPotionSlot(PotionType type) {
        if (mc.player == null) return -1;

        for (int i = 0; i < 9; i++) {
            ItemStack stack = mc.player.getInventory().getStack(i);
            if (!stack.isOf(Items.SPLASH_POTION)) continue;

            PotionContentsComponent potionComponent = stack.get(DataComponentTypes.POTION_CONTENTS);
            if (potionComponent == null) continue;

            for (StatusEffectInstance effect : potionComponent.getEffects()) {
                if (effect.getEffectType() == type.effect) return i;
            }
        }
        return -1;
    }

    private boolean hasEffect(RegistryEntry<StatusEffect> effect) {
        return mc.player != null && mc.player.hasStatusEffect(effect);
    }

    private boolean canBuff(PotionType type) {
        if (hasEffect(type.effect)) return false;
        return type.enabled(this) && findPotionSlot(type) != -1;
    }

    private boolean canBuff() {
        if (mc.player == null || mc.world == null) return false;

        return (canBuff(PotionType.STRENGTH) || canBuff(PotionType.SPEED) || canBuff(PotionType.FIRE_RESISTANCE))
            && mc.player.isOnGround()
            && System.currentTimeMillis() - lastThrowAt >= THROW_COOLDOWN_MS;
    }

    private boolean wantsPotion() {
        return isActivePotion || canBuff(PotionType.STRENGTH) || canBuff(PotionType.SPEED) || canBuff(PotionType.FIRE_RESISTANCE);
    }

    private boolean shouldThrow() {
        if (mc.player == null || mc.world == null) return false;

        return wantsPotion()
            && canBuff()
            && mc.world.getBlockState(mc.player.getBlockPos().down()).getBlock() != Blocks.AIR;
    }

    @EventHandler(priority = EventPriority.HIGH)
    private void onRotationUpdate(RotationUpdateEvent event) {
        if (mc.player == null || mc.world == null) return;
        if (event.type != RotationUpdateEvent.Type.PRE) return;

        if (shouldThrow() || spoofed) performRotation();
    }

    private void performRotation() {
        Angle throwAngle = new Angle(mc.player.getYaw(), THROW_PITCH);
        AngleConfig config = new AngleConfig(new LinearConstructor(), true, true);

        AngleConnection.INSTANCE.rotateTo(
            throwAngle,
            3,
            config,
            TaskPriority.HIGH_IMPORTANCE_2,
            this
        );

        if (expensiveAuraActive()) {
            Rotation throwLook = new Rotation(mc.player.getYaw(), THROW_PITCH);
            PlayerRotationManager mgr = PlayerRotationManager.INSTANCE;
            mgr.ensureSubscribed();
            mgr.cancelTasksFor(this);
            mgr.scheduleRotation(
                new RotationVector(throwLook, throwLook.getDirectionVector()),
                mc.player,
                LOOK_DOWN,
                5,
                this,
                3
            );
        }

        if (!spoofed) {
            spoofed = true;
            isActivePotion = true;
            rotationTicks = 0;
            selectedSlot = mc.player.getInventory().selectedSlot;
        }
    }

    @EventHandler
    private void onTick(TickEvent.Pre event) {
        if (mc.player == null || mc.world == null) return;

        if (isActivePotion && !shouldThrow() && !spoofed) {
            isActivePotion = false;
            if (autoOff.get()) toggle();
        }

        if (spoofed) processThrow();
    }

    private void processThrow() {
        rotationTicks++;

        boolean rotationReady = currentPitch() >= 80f;
        boolean waitedEnough = rotationTicks >= ROTATION_WAIT_TICKS;

        if (rotationReady && waitedEnough) {
            if (canBuff(PotionType.STRENGTH)) throwPotion(PotionType.STRENGTH);
            if (canBuff(PotionType.SPEED)) throwPotion(PotionType.SPEED);
            if (canBuff(PotionType.FIRE_RESISTANCE)) throwPotion(PotionType.FIRE_RESISTANCE);

            if (selectedSlot != -1) {
                mc.player.networkHandler.sendPacket(new UpdateSelectedSlotC2SPacket(selectedSlot));
            }

            lastThrowAt = System.currentTimeMillis();
            spoofed = false;
            rotationTicks = 0;
            isActivePotion = false;
            selectedSlot = -1;
            if (expensiveAuraActive()) PlayerRotationManager.INSTANCE.cancelTasksFor(this);

            if (autoOff.get() && isActive()) toggle();
        }

        if (rotationTicks > 10) resetThrowState(true);
    }

    private float currentPitch() {
        if (expensiveAuraActive()) {
            return PlayerRotationManager.INSTANCE.getCurrentRotation().getPitch();
        }

        Angle currentRotation = AngleConnection.INSTANCE.getRotation();
        return currentRotation != null ? currentRotation.getPitch() : mc.player.getPitch();
    }

    private void resetThrowState(boolean restoreSlot) {
        spoofed = false;
        rotationTicks = 0;
        isActivePotion = false;
        if (restoreSlot && selectedSlot != -1 && mc.player != null && mc.player.networkHandler != null) {
            mc.player.networkHandler.sendPacket(new UpdateSelectedSlotC2SPacket(selectedSlot));
        }
        selectedSlot = -1;
        if (expensiveAuraActive()) PlayerRotationManager.INSTANCE.cancelTasksFor(this);
    }

    private void throwPotion(PotionType type) {
        if (!type.enabled(this) || hasEffect(type.effect)) return;
        if (mc.player == null || mc.player.networkHandler == null) return;

        int slot = findPotionSlot(type);
        if (slot == -1) return;

        mc.player.networkHandler.sendPacket(new UpdateSelectedSlotC2SPacket(slot));
        sendSequencedInteract();
    }

    private void sendSequencedInteract() {
        if (mc.player == null || mc.player.networkHandler == null || mc.world == null || mc.interactionManager == null) return;

        float yaw = mc.player.getYaw();
        try {
            ((ClientPlayerInteractionManagerInvoker) mc.interactionManager).meteor$sendSequencedPacket(
                mc.world,
                seq -> new PlayerInteractItemC2SPacket(Hand.MAIN_HAND, seq, yaw, THROW_PITCH)
            );
        } catch (Throwable ignored) {
            mc.player.networkHandler.sendPacket(new PlayerInteractItemC2SPacket(Hand.MAIN_HAND, 0, yaw, THROW_PITCH));
        }
    }

    private boolean expensiveAuraActive() {
        ExpensiveAura aura = Modules.get().get(ExpensiveAura.class);
        return aura != null && aura.isActive();
    }
}


