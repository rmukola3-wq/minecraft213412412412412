        return isActive() && oldAnimations.get();
    }

    public boolean showSwapping() {
        return isActive() && showSwapping.get();
    }

    public boolean disableFoodAnimation() {
        return isActive() && disableFoodAnimation.get();
    }

    public enum SwingMode {
