            float off = DropDownDraw.textWidth(text, 7f) + 2;
            if (offset + off >= getWidth() - 10) {
                offset = 0;
                heightOff += 11;
            }
            float tw = DropDownDraw.textWidth(text, 7f);
            float th = DropDownDraw.textHeight(7f) + 1;
            if (DropDownDraw.hovered(mouseX, mouseY, getX() + 8 + offset, getY() + 11.5f + heightOff, tw, th)) {
                if (setting instanceof EnumSetting<?> enumSetting) {
                    Object current = enumSetting.get();
                    if (current instanceof Enum<?> currentEnum) {
                        for (Enum<?> value : currentEnum.getDeclaringClass().getEnumConstants()) {
