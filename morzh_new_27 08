@Mixin(BossBarHud.class)
public abstract class BossBarHudMixin {
    @Unique
    private boolean vanillaHudPushed;

    @Inject(method = "render", at = @At("HEAD"), cancellable = true)
    private void onRender(DrawContext context, CallbackInfo info) {
        if (Modules.get().get(NoRender.class).noBossBar()) info.cancel();
        vanillaHudPushed = false;
        VanillaHud hud = VanillaHud.get();
        if (hud != null && !info.isCancelled()) {
            hud.pushBoss(context);
            vanillaHudPushed = hud.bossOn();
        }
    }

    @Inject(method = "render", at = @At("RETURN"))
    private void vanillaHudBossPop(DrawContext context, CallbackInfo info) {
        if (!vanillaHudPushed) return;
        vanillaHudPushed = false;
        VanillaHud hud = VanillaHud.get();
        if (hud != null) hud.popBoss(context);
    }

    @Redirect(
        method = "renderBossBar(Lnet/minecraft/client/gui/DrawContext;IILnet/minecraft/entity/boss/BossBar;I[Lnet/minecraft/util/Identifier;[Lnet/minecraft/util/Identifier;)V",
        at = @At(value = "INVOKE", target = "Lnet/minecraft/client/gui/DrawContext;drawGuiTexture(Ljava/util/function/Function;Lnet/minecraft/util/Identifier;IIIIIIII)V")
    )
    private void vanillaHudBossBar(DrawContext context, Function<Identifier, RenderLayer> layer, Identifier texture, int tw, int th, int u, int v, int x, int y, int w, int h) {
        VanillaHud hud = VanillaHud.get();
        float alpha = hud != null ? hud.bossBackgroundAlpha() : 1f;
        if (alpha < 0.999f) {
            com.mojang.blaze3d.systems.RenderSystem.setShaderColor(1f, 1f, 1f, alpha);
            context.drawGuiTexture(layer, texture, tw, th, u, v, x, y, w, h);
            com.mojang.blaze3d.systems.RenderSystem.setShaderColor(1f, 1f, 1f, 1f);
        } else {
            context.drawGuiTexture(layer, texture, tw, th, u, v, x, y, w, h);
        }
    }

    @Redirect(method = "render", at = @At(value = "INVOKE", target = "Ljava/util/Collection;iterator()Ljava/util/Iterator;"))
    public Iterator<ClientBossBar> onRender(Collection<ClientBossBar> collection) {
        RenderBossBarEvent.BossIterator event = MeteorClient.EVENT_BUS.post(RenderBossBarEvent.BossIterator.get(collection.iterator()));
        return event.iterator;
    }

    @Redirect(method = "render", at = @At(value = "INVOKE", target = "Lnet/minecraft/client/gui/hud/ClientBossBar;getName()Lnet/minecraft/text/Text;"))
    public Text onAsFormattedString(ClientBossBar clientBossBar) {
        RenderBossBarEvent.BossText event = MeteorClient.EVENT_BUS.post(RenderBossBarEvent.BossText.get(clientBossBar, clientBossBar.getName()));
        return event.name;
    }

    @ModifyConstant(method = "render", constant = @Constant(intValue = 9, ordinal = 1))
    public int modifySpacingConstant(int j) {
        RenderBossBarEvent.BossSpacing event = MeteorClient.EVENT_BUS.post(RenderBossBarEvent.BossSpacing.get(j));
        return event.spacing;
    }
