                }
            }
        });
    }

    private ItemStack stackAt(int slotIndex) {
        if (isInEditor() || mc.player == null) return ItemStack.EMPTY;
        if (slotIndex >= mc.player.getInventory().main.size()) return ItemStack.EMPTY;
        return mc.player.getInventory().main.get(slotIndex);
    }
