package meteordevelopment.meteorclient.gui.morzh;

import meteordevelopment.meteorclient.gui.themes.morzh.MorzhGuiColors;
import meteordevelopment.meteorclient.settings.DoubleSetting;
import meteordevelopment.meteorclient.settings.IntSetting;
import meteordevelopment.meteorclient.settings.Setting;
import meteordevelopment.meteorclient.utils.sound.MorzhSoundManager;
import net.minecraft.util.math.MathHelper;

import java.util.Locale;

public class MorzhNumberSettingComponent extends MorzhSettingComponent {
    private static final float TRACK_HEIGHT = 3f;
    private static final float KNOB_RADIUS = 2.5f;
    private static final float FILL_RESPONSIVENESS = 20f;

    private boolean dragging;
    private float fillProgress;

    public MorzhNumberSettingComponent(
        MorzhComponent parent,
        Setting<?> setting,
        int x,
        int y,
        int width
    ) {
        super(parent, setting, x, y, width, SLIDER_ROW_HEIGHT);

        this.fillProgress = (float) progress();
    }

    @Override
    public void tick(float delta) {
        fillProgress = MorzhAnimUtil.approach(
            fillProgress,
            (float) progress(),
            FILL_RESPONSIVENESS,
            delta
        );
    }

    @Override
    public void render(MorzhGuiContext context) {
        float left = absoluteX();
        float top = absoluteY();

        String value = formatValue();
        double valueWidth = MorzhSmoothRenderer.textWidth(value);

        MorzhSmoothRenderer.text(
            context.draw,
            MorzhSmoothRenderer.fitText(
                setting.title,
                width() - PADDING * 2 - valueWidth - 4
            ),
            left + PADDING,
            top + 2f,
            labelColor(context),
            false
        );

        MorzhSmoothRenderer.text(
            context.draw,
            value,
            left + width() - PADDING - valueWidth,
            top + 2f,
            valueColor(context),
            false
        );

        float trackX = trackX();
        float trackWidth = trackWidth();
        float trackY = top + height() - TRACK_HEIGHT - 4f;

        MorzhSmoothRenderer.roundedRect(
            context.draw,
            trackX,
            trackY,
            trackWidth,
            TRACK_HEIGHT,
            TRACK_HEIGHT / 2f,
            context.fade(MorzhGuiColors.packed(MorzhGuiColors.SLIDER_TRACK))
        );

        float filled = trackWidth * MorzhAnimUtil.clamp01(fillProgress);

        if (filled > 0.5f) {
            MorzhSmoothRenderer.roundedRect(
                context.draw,
                trackX,
                trackY,
                filled,
                TRACK_HEIGHT,
                TRACK_HEIGHT / 2f,
                context.fade(MorzhGuiColors.packed(MorzhGuiColors.SLIDER_FILL))
            );
        }

        MorzhSmoothRenderer.circle(
            context.draw,
            trackX + filled,
            trackY + TRACK_HEIGHT / 2f,
            KNOB_RADIUS,
            context.fade(MorzhGuiColors.packed(MorzhGuiColors.ACCENT_LIGHT))
        );

        offerTooltip(context);
    }

    @Override
    public boolean mouseClicked(double mouseX, double mouseY, int button) {
        if (button != 0 || !isHovered(mouseX, mouseY)) return false;

        dragging = true;
        applyFromMouse(mouseX);
        MorzhSoundManager.playScroll();

        return true;
    }

    @Override
    public boolean mouseDragged(double mouseX, double mouseY, int button) {
        if (!dragging) return false;

        applyFromMouse(mouseX);

        return true;
    }

    @Override
    public void mouseReleased(double mouseX, double mouseY, int button) {
        dragging = false;
    }

    // ------------------------------------------------------------- helpers

    private float trackX() {
        return absoluteX() + PADDING;
    }

    private float trackWidth() {
        return Math.max(1f, width() - PADDING * 2f);
    }

    private void applyFromMouse(double mouseX) {
        double ratio = MathHelper.clamp(
            (mouseX - trackX()) / trackWidth(),
            0,
            1
        );

        if (setting instanceof IntSetting intSetting) {
            int value = (int) Math.round(
                intSetting.sliderMin
                    + (intSetting.sliderMax - intSetting.sliderMin) * ratio
            );

            intSetting.set(
                MathHelper.clamp(value, intSetting.min, intSetting.max)
            );
        }
        else if (setting instanceof DoubleSetting doubleSetting) {
            double value = doubleSetting.sliderMin
                + (doubleSetting.sliderMax - doubleSetting.sliderMin) * ratio;

            double step = Math.pow(10, doubleSetting.decimalPlaces);
            value = Math.round(value * step) / step;

            doubleSetting.set(
                MathHelper.clamp(value, doubleSetting.min, doubleSetting.max)
            );
        }
    }

    private double progress() {
        if (setting instanceof IntSetting intSetting) {
            if (intSetting.sliderMax == intSetting.sliderMin) return 0;

            return MathHelper.clamp(
                (intSetting.get() - intSetting.sliderMin)
                    / (double) (intSetting.sliderMax - intSetting.sliderMin),
                0,
                1
            );
        }

        if (setting instanceof DoubleSetting doubleSetting) {
            if (doubleSetting.sliderMax == doubleSetting.sliderMin) return 0;

            return MathHelper.clamp(
                (doubleSetting.get() - doubleSetting.sliderMin)
                    / (doubleSetting.sliderMax - doubleSetting.sliderMin),
                0,
                1
            );
        }

        return 0;
    }

    private String formatValue() {
        Object value = setting.get();

        if (value instanceof Double number
            && setting instanceof DoubleSetting doubleSetting) {
            return String.format(
                Locale.ROOT,
                "%." + Math.min(3, doubleSetting.decimalPlaces) + "f",
                number
            );
        }

        return String.valueOf(value);
    }
}


