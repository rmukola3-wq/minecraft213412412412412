                                meteordevelopment.meteorclient.utils.sound.MorzhSoundManager.playBoolean();
                                break;
                            }
                        }
                    }
                } else {
                    ((Setting<String>) setting).set(text);
                    meteordevelopment.meteorclient.utils.sound.MorzhSoundManager.playBoolean();
                }
            }
            offset += off;
        }
    }

    private String[] options() {
        if (setting instanceof ProvidedStringSetting provided) {
            String[] values = provided.supplier.get();
            return values != null ? values : new String[0];
        }
        if (setting instanceof EnumSetting<?> enumSetting) {
            Object current = enumSetting.get();
            if (current instanceof Enum<?> currentEnum) {
                Enum<?>[] values = currentEnum.getDeclaringClass().getEnumConstants();
                String[] names = new String[values.length];
                for (int i = 0; i < values.length; i++) names[i] = values[i].toString();
                return names;
            }
        }
        return new String[0];
    }

    private String current() {
        Object value = setting.get();
        return value == null ? "" : value.toString();
    }

    @SuppressWarnings({"unchecked", "rawtypes"})
    private static void setEnum(EnumSetting setting, Enum<?> value) {
        setting.set(value);
    }

    @Override
    public boolean isVisible() {
        return setting.isVisible();
    }
}


