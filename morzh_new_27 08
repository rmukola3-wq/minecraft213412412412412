    private boolean alwaysRenderCrosshairInFreecam(boolean firstPerson) {
        return Modules.get().isActive(Freecam.class) || firstPerson;
    }

    @Inject(method = "renderCrosshair", at = @At("HEAD"), cancellable = true)
    private void onRenderCrosshair(DrawContext context, RenderTickCounter tickCounter, CallbackInfo ci) {
        if (Modules.get().get(NoRender.class).noCrosshair()) ci.cancel();
        if (Modules.get().isActive(meteordevelopment.meteorclient.systems.modules.render.MorzhCrosshair.class)
            && Modules.get().get(meteordevelopment.meteorclient.systems.modules.render.MorzhCrosshair.class).hidesVanilla()) {
            ci.cancel();
        }
    }

    @Inject(method = "renderHotbar", at = @At("HEAD"), cancellable = true)
    private void onRenderHotbar(DrawContext context, RenderTickCounter tickCounter, CallbackInfo ci) {
        if (Modules.get().get(NoRender.class).noHotbar()) ci.cancel();
        if (Modules.get().isActive(meteordevelopment.meteorclient.systems.modules.render.MorzhHotbar.class)
            && Modules.get().get(meteordevelopment.meteorclient.systems.modules.render.MorzhHotbar.class).hidesVanilla()) {
            ci.cancel();
        }

        GuiAnimations animations = Modules.get().get(GuiAnimations.class);
        if (animations != null && animations.hotbarEnabled() && client.player != null) {
            animations.hotbarAnim.update(client.player.getInventory().selectedSlot, context.getScaledWindowWidth() / 2, animations.hotbarDuration.get());
            animations.hotbarAnim.tick();
        }
    }

    @Redirect(
        method = "renderHotbar",
        at = @At(value = "INVOKE", target = "Lnet/minecraft/client/gui/DrawContext;drawGuiTexture(Ljava/util/function/Function;Lnet/minecraft/util/Identifier;IIII)V", ordinal = 1)
    )
    private void pulseHotbarSelection(DrawContext context, Function<Identifier, RenderLayer> layer, Identifier texture, int x, int y, int w, int h) {
        GuiAnimations animations = Modules.get().get(GuiAnimations.class);
        if (animations != null && animations.hotbarEnabled()) {
            deferredHighlightY = y;
            deferHighlight = true;
            return;
        }
        context.drawGuiTexture(layer, texture, x, y, w, h);
    }

    @Inject(method = "renderHotbar", at = @At("RETURN"))
    private void pulseHotbarSelectionDraw(DrawContext context, RenderTickCounter tickCounter, CallbackInfo ci) {
        if (!deferHighlight) return;
        deferHighlight = false;
        GuiAnimations animations = Modules.get().get(GuiAnimations.class);
        if (animations == null) return;
        int x = Math.round(animations.hotbarAnim.x());
        context.draw();
        MatrixStack matrices = context.getMatrices();
        matrices.push();
        matrices.translate(0f, 0f, 200f);
        context.drawGuiTexture(RenderLayer::getGuiTextured, HOTBAR_SELECTION_TEXTURE, x, deferredHighlightY, 24, 23);
        matrices.pop();
    }

    @Inject(method = "renderPlayerList", at = @At("HEAD"), cancellable = true)
    private void pulseTabList(DrawContext context, RenderTickCounter tickCounter, CallbackInfo ci) {
        GuiAnimations animations = Modules.get().get(GuiAnimations.class);
        if (animations == null || !animations.tabEnabled() || client.world == null || client.player == null) {
            prevTabShown = false;
            return;
        }

        ci.cancel();
        Scoreboard scoreboard = client.world.getScoreboard();
        ScoreboardObjective objective = scoreboard.getObjectiveForSlot(ScoreboardDisplaySlot.LIST);
        boolean pressed = client.options.playerListKey.isPressed();
        boolean hide = client.isInSingleplayer() && client.player.networkHandler.getListedPlayerListEntries().size() <= 1 && objective == null;
        boolean show = pressed && !hide;
        long duration = animations.tabDuration.get();
        if (show && !prevTabShown) animations.tabAnim.show(duration);
        else if (!show && prevTabShown) animations.tabAnim.hide(duration);
        prevTabShown = show;
        animations.tabAnim.tick();
        if (!show && !animations.tabAnim.renderable()) {
            playerListHud.setVisible(false);
            return;
        }
        playerListHud.setVisible(true);
        float scale = animations.tabAnim.value();
        if (scale < 0.001f) {
            playerListHud.setVisible(false);
            return;
        }
        MatrixStack matrices = context.getMatrices();
        matrices.push();
        float cx = context.getScaledWindowWidth() / 2f;
        matrices.translate(cx, 0f, 0f);
        matrices.scale(scale, scale, 1f);
        matrices.translate(-cx, 0f, 0f);
        playerListHud.render(context, context.getScaledWindowWidth(), scoreboard, objective);
        matrices.pop();
    }

    @Inject(method = "renderStatusBars", at = @At("HEAD"), cancellable = true)
    private void morzhNoStatusBars(CallbackInfo ci) {
        if (Modules.get().get(NoRender.class).noStatusBars()) ci.cancel();
