    public static final class SlideAnim {
        private static final float START = 14;
        private float value = Float.NaN;
        private float start;
        private float target;
        private long startMs;
        private long duration = 160;

        public SlideAnim() {}

        public SlideAnim(float from, float to, long ms) {
            duration = Math.max(1, ms);
            value = from;
            start = from;
            target = to;
            startMs = System.currentTimeMillis();
        }

        public void tick() {
            if (Float.isNaN(value) || startMs == 0) return;
            long elapsed = System.currentTimeMillis() - startMs;
            if (elapsed >= duration) {
                value = target;
                startMs = 0;
                return;
            }
            value = lerp(start, target, easeOut(elapsed / (double) duration));
        }

        public void open(long ms) {
            duration = Math.max(1, ms);
            if (!Float.isNaN(value)) {
                if (value != target) {
                    start = value;
                    target = 0;
                    startMs = System.currentTimeMillis();
                }
                return;
            }
            value = START;
            start = START;
            target = 0;
            startMs = System.currentTimeMillis();
        }

        public float value() {
            return Float.isNaN(value) ? 0 : value;
        }

        public boolean sliding() {
            return value() > 0;
        }

        public boolean finished() {
            return startMs == 0 && !Float.isNaN(value) && value == target;
        }

        public void reset() {
            value = Float.NaN;
            startMs = 0;
        }
    }

    public static final class HotbarAnim {
        private static final int UNSET = -1;
        private static final int LEFT = 91;
        private static final int SLOT = 20;
        private static final int TEX = 1;

        private float value = Float.NaN;
        private float start;
        private float target;
        private long startMs;
        private long duration = 160;
        private int slot = UNSET;

        public void tick() {
            if (Float.isNaN(value) || startMs == 0) return;
            long elapsed = System.currentTimeMillis() - startMs;
            if (elapsed >= duration) {
                value = target;
                startMs = 0;
                return;
            }
            value = lerp(start, target, easeOut(elapsed / (double) duration));
        }

        public void update(int selected, int centerX, long ms) {
            duration = Math.max(1, ms);
            float next = centerX - LEFT - TEX + selected * SLOT;
            if (slot == UNSET || Float.isNaN(value)) {
                slot = selected;
                value = start = target = next;
                startMs = 0;
            } else if (selected == slot) {
                target = next;
                if (startMs == 0) value = next;
            } else {
                start = value;
                target = next;
                startMs = System.currentTimeMillis();
                slot = selected;
            }
        }

        public float x() {
            return Float.isNaN(value) ? 0 : value;
        }
    }

    public static final class PerspectiveAnim {
        private float value = 4;
        private float start = 4;
        private float target = 4;
        private long startMs;
        private long duration = 300;
        private boolean third;

        public void tick() {
            if (startMs == 0) return;
            long elapsed = System.currentTimeMillis() - startMs;
            if (elapsed >= duration) {
                value = target;
                startMs = 0;
                return;
            }
            value = lerp(start, target, easeInOut(elapsed / (double) duration));
        }

        public void update(boolean thirdPerson, long ms, float thirdDistance) {
            duration = Math.max(1, ms);
            if (thirdPerson && !third) {
                start = 1;
                target = thirdDistance;
                value = 1;
                startMs = System.currentTimeMillis();
            } else if (!thirdPerson && third) {
                start = value;
                target = 1;
                startMs = System.currentTimeMillis();
            } else if (thirdPerson && startMs == 0) {
                target = thirdDistance;
                value = thirdDistance;
            }
            third = thirdPerson;
        }

        public float distance() {
            return value;
        }
    }

    private static float lerp(float a, float b, double t) {
        return (float) (a + (b - a) * t);
    }

    private static double easeOut(double t) {
        t = Math.max(0, Math.min(1, t));
        return 1 - Math.pow(1 - t, 3);
    }

    private static double easeInOut(double t) {
        t = Math.max(0, Math.min(1, t));
        return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    }
}


