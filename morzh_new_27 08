        .name("цвет")
        .defaultValue(new SettingColor(255, 255, 255, 255))
        .build()
    );

    private final List<Circle> circles = new ArrayList<>();
    private final CircleMesh texMesh = new CircleMesh();
    private final AdditiveColorMesh fillMesh = new AdditiveColorMesh(DrawMode.Triangles);
    private final AdditiveColorMesh lineMesh = new AdditiveColorMesh(DrawMode.Lines);
    private final XyetaJumpCircles xyeta = new XyetaJumpCircles();
    private final Color packed = new Color();
    private final Color uzInner = new Color();
    private final Color uzOuter = new Color();
    private boolean xyetaOnGround;

    public JumpCircle() {
        super(Categories.Render, "jump-circle", "Jump circles: Rockstar stacked glow, Expensive, Xyeta, UZBEk.");
    }

    @Override
    public void onDeactivate() {
        circles.clear();
        xyetaOnGround = false;
