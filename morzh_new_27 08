import java.util.concurrent.ThreadLocalRandom;

import static meteordevelopment.meteorclient.MeteorClient.mc;

public final class FastMathUtils {
    public static int clamp(int value, int min, int max) {
        return Math.min(Math.max(value, min), max);
    }

    public static double clamp(double value, double min, double max) {
        return Math.min(Math.max(value, min), max);
    }

    public static float clamp(float value, float min, float max) {
        return Math.min(Math.max(value, min), max);
    }

    public static Rotation interpolate(Rotation from, Rotation to) {
        return new Rotation(interpolate(from.getYaw(), to.getYaw()), interpolate(from.getPitch(), to.getPitch()));
    }

    public static float interpolate(float from, float to) {
        float tick = mc.getRenderTickCounter().getTickDelta(true);
        return from + (to - from) * tick;
    }

    public static double interpolate(double from, double to) {
        float tick = mc.getRenderTickCounter().getTickDelta(true);
        return from + (to - from) * tick;
    }

    public static int getRandom(int min, int max) {
        return (int) getRandom(min, max + 1.0f);
    }

    public static float getRandom(float min, float max) {
        return (float) getRandom((double) min, (double) max);
    }

    public static double getRandom(double min, double max) {
        if (min == max) return min;
        if (min > max) {
            double tmp = min;
            min = max;
            max = tmp;
        }
        return ThreadLocalRandom.current().nextDouble(min, max);
    }

    public static double computeGcd() {
        double sensitivity = ((Double) mc.options.getMouseSensitivity().getValue()) * 0.6000000238418579d + 0.20000000298023224d;
        return sensitivity * sensitivity * sensitivity * 8.0d * 0.15d;
    }

    public static float snapGcd(float lastYaw, float current) {
        double sens = (mc.options.getMouseSensitivity().getValue() * 0.6000000498956214d) + 0.19999998556632664d;
