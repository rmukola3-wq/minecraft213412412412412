    public static final int TEXT_MUTED = rgb(190, 194, 204);
    public static final int TEXT_DARK = rgb(46, 47, 51);

    public static final int OUTLINE_LIGHT = rgba(255, 255, 255, 10);
    public static final int OUTLINE_BLACK = rgb(0, 0, 0);

    public static final int MODULE_FILL = rgba(133, 156, 255, 10);
    public static final int MODULE_INNER = rgba(255, 255, 255, 6);
    public static final int MODULE_INNER2 = rgba(8, 8, 10, 0);
    public static final int MODULE_BORDER_TL = rgba(255, 255, 255, 5);
    public static final int MODULE_BORDER_BL = rgba(255, 255, 255, 5);

    public static final int STENCIL_INNER = rgba(8, 8, 8, 40);
    public static final int FOOTER = rgba(8, 8, 8, 0);

    public static final int SETTING_SEP_LEFT = rgba(255, 255, 255, 8);
    public static final int SETTING_SEP_RIGHT = rgba(255, 255, 255, 8);

    public static final int TOGGLE_TRACK = rgb(29, 29, 31);
    public static final int TOGGLE_OFF = rgb(56, 61, 75);
    public static final int TOGGLE_ON = ON;

    public static final int SLIDER_TRACK = rgb(28, 28, 31);
    public static final int SLIDER_FILL = rgb(133, 156, 255);

    public static final int CHIP_BG = rgba(8, 8, 10, 80);
    public static final int BIND_BG = rgba(8, 8, 8, 80);
    public static final int STRING_BG = rgba(0, 0, 0, 80);

    public static final int MODE_LABEL = rgb(255, 255, 255);
    public static final int MODE_SELECTED = ON;
    public static final int MODE_IDLE = rgb(228, 230, 238);

    public static int rgb(int r, int g, int b) {
        return rgba(r, g, b, 255);
    }

    public static int rgba(int r, int g, int b, int a) {
        return (a & 255) << 24 | (r & 255) << 16 | (g & 255) << 8 | (b & 255);
    }

    public static int withAlpha(int packed, int alpha) {
        return (alpha & 255) << 24 | packed & 0x00FFFFFF;
    }

    public static int interpolate(int start, int end, float t) {
        t = Math.max(0f, Math.min(1f, t));

        int sA = start >>> 24 & 255, sR = start >> 16 & 255, sG = start >> 8 & 255, sB = start & 255;
        int eA = end >>> 24 & 255, eR = end >> 16 & 255, eG = end >> 8 & 255, eB = end & 255;

        int a = (int) (eA + (sA - eA) * t);
        int r = (int) (eR + (sR - eR) * t);
        int g = (int) (eG + (sG - eG) * t);
        int b = (int) (eB + (sB - eB) * t);

        return rgba(r, g, b, a);
    }

    public static Color color(int packed) {
        return new Color(packed);
    }
}


