public class DropDownColorComponent extends DropDownComponent {
    private final ColorSetting setting;
    private int dragging = -1;

    public DropDownColorComponent(ColorSetting setting) {
        this.setting = setting;
        setHeight(18);
    }

    @Override
    public void measure(float width) {
        super.measure(width);
        setHeight(open() ? 18 + 16 * 4 : 16);
    }

    @Override
    public void render(DrawContext context, float mouseX, float mouseY) {
        SettingColor color = setting.get();
        DropDownDraw.text(context, setting.title, getX() + 5, getY() + 6.5f / 2f + 1, DropDownColors.TEXT_SETTING, 6.5f);

        float previewW = 18;
        float previewH = 8;
        float px = getX() + getWidth() - previewW - 7;
        float py = getY() + getHeight() / 2f - previewH / 2f;
        if (getHeight() > 20) py = getY() + 4;

        DropDownDraw.rounded(context, px, py, previewW, previewH, 2, color.getPacked());

        if (isHovered(mouseX, mouseY, 16) && DropDownDraw.hovered(mouseX, mouseY, px, py, previewW, previewH)) {
            DropDownDraw.cursorHand();
        }

        if (open()) {
            drawChannel(context, mouseX, mouseY, 0, "R", color.r, 255);
            drawChannel(context, mouseX, mouseY, 1, "G", color.g, 255);
            drawChannel(context, mouseX, mouseY, 2, "B", color.b, 255);
            drawChannel(context, mouseX, mouseY, 3, "A", color.a, 255);
        }
    }

    private boolean open() {
        return dragging >= 0 || expanded;
    }

    private boolean expanded;

    private void drawChannel(DrawContext context, float mouseX, float mouseY, int index, String name, int value, int max) {
        float y = getY() + 16 + index * 16;
        DropDownDraw.text(context, name, getX() + 5, y + 2, DropDownColors.TEXT_SETTING, 5.5f);
        String label = Integer.toString(value);
        DropDownDraw.text(context, label, getX() + getWidth() - 5 - DropDownDraw.textWidth(label, 5.5f), y + 2, DropDownColors.TEXT_SETTING, 5.5f);

        float trackX = getX() + 5;
        float trackY = y + 11;
        float trackW = getWidth() - 10;
        float fill = trackW * (value / (float) max);

        DropDownDraw.rounded(context, trackX, trackY, trackW, 2, 0.6f, DropDownColors.SLIDER_TRACK);
        DropDownDraw.rounded(context, trackX, trackY, fill, 2, 0.6f, DropDownColors.SLIDER_FILL);
        DropDownDraw.circle(context, trackX + fill, trackY + 1, 5, DropDownColors.SLIDER_FILL);

        if (dragging == index) {
            DropDownDraw.cursorResize();
            apply(index, mouseX);
        } else if (DropDownDraw.hovered(mouseX, mouseY, trackX, trackY - 1, trackW, 4)) {
            DropDownDraw.cursorResize();
        }
    }

    @Override
    public void mouseClick(float mouseX, float mouseY, int button) {
        float previewW = 18;
        float previewH = 8;
        float px = getX() + getWidth() - previewW - 7;
        float py = getY() + 4;
        if (DropDownDraw.hovered(mouseX, mouseY, px, py, previewW, previewH) && button == 0) {
            expanded = !expanded;
            return;
        }
        if (button == 1 && isHovered(mouseX, mouseY, 16)) {
            DropDownScreens.open(setting);
            return;
        }

        if (!expanded) return;
        for (int i = 0; i < 4; i++) {
            float y = getY() + 16 + i * 16;
            if (DropDownDraw.hovered(mouseX, mouseY, getX() + 5, y + 10, getWidth() - 10, 4)) {
                dragging = i;
                apply(i, mouseX);
            }
        }
    }

    @Override
    public void mouseRelease(float mouseX, float mouseY, int button) {
        dragging = -1;
    }

    private void apply(int channel, float mouseX) {
        int value = (int) MathHelper.clamp((mouseX - getX() - 5) / (getWidth() - 10) * 255, 0, 255);
        SettingColor color = setting.get();
        switch (channel) {
            case 0 -> color.r = value;
            case 1 -> color.g = value;
            case 2 -> color.b = value;
            case 3 -> color.a = value;
        }
        color.validate();
        setting.set(color);
        setting.onChanged();
    }

    @Override
    public boolean isVisible() {
        return setting.isVisible();
    }
}


