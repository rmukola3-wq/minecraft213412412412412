package meteordevelopment.meteorclient.gui.rasty.util.render;

import net.minecraft.util.Util;

/** Light aurora backdrop — two blobs, no stacked rings. */
public final class MenuAurora {
    private MenuAurora() {}

    public static void draw(float zoom, int sw, int sh) {
        float zw = Math.max(1f, sw * zoom);
        float zh = Math.max(1f, sh * zoom);
        float ox = (sw - zw) / 2f;
        float oy = (sh - zh) / 2f;

        Render2D.gradientRect(ox, oy, zw, zh, new int[]{0xFF05060A, 0xFF0A0C14, 0xFF05060A, 0xFF0A0C14}, 0f);

        float t = Util.getMeasuringTimeMs() / 1000f;
        blob(ox + zw * (0.28f + 0.12f * sin(t, 0.18f)), oy + zh * 0.42f, 220, 0x22859CFF);
        blob(ox + zw * (0.72f + 0.10f * sin(t, 0.14f)), oy + zh * 0.62f, 200, 0x185ADC78);

        Render2D.gradientRect(ox, oy, zw, 40, new int[]{0x8805060A, 0x8805060A, 0x0005060A, 0x0005060A}, 0f);
        Render2D.gradientRect(ox, oy + zh - 48, zw, 48, new int[]{0x0005060A, 0x0005060A, 0x9905060A, 0x9905060A}, 0f);
    }

    private static void blob(float cx, float cy, float size, int packed) {
        Render2D.rect(cx - size / 2f, cy - size / 2f, size, size, packed, size / 2f);
    }

    private static float sin(float t, float speed) {
        return (float) Math.sin(t * speed);
    }
}


