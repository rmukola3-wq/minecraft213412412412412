public final class RastyMatrixRotation extends RockstarRotationMode {
    @Override
    public void update(KillAura aura, LivingEntity target) {
        if (mc.player == null) return;

        if (target == null) {
            yaw = mc.player.getYaw();
            pitch = mc.player.getPitch();
            return;
        }

        float[] desired = RockstarMath.anglesToEyes(
            aimPoint(aura, target)
        );

        float yawDelta = MathHelper.wrapDegrees(
            desired[0] - yaw
        );

        float pitchDelta =
            desired[1] - pitch;

        float difference = (float) Math.hypot(
            yawDelta,
            pitchDelta
        );

        boolean attackReady =
            aura.canCritical()
                && aura.attackTimerPassed(300);

        float speed;

        if (attackReady) {
            speed = RockstarMath.random(
                0.76,
                0.92
            );
        } else if (difference <= 4) {
            speed = RockstarMath.random(
                0.04,
                0.08
            );
        } else {
            speed = RockstarMath.random(
                0.15,
                0.45
            );
        }

        yaw += yawDelta * speed;

        pitch += pitchDelta
            * Math.min(1, speed * 0.85f);

        if (!attackReady) {
            yaw += RockstarMath.random(
                -0.35,
                0.35
            );

            pitch += RockstarMath.random(
                -0.15,
                0.15
            );
        }

        float[] corrected =
            RockstarMath.correctRotation(
                yaw,
                pitch
            );

        yaw = corrected[0];

        pitch = MathHelper.clamp(
            corrected[1],
            -90,
