        .name("команда")
        .description("Команда входа на арену без /.")
        .defaultValue("darena")
        .build()
    );

    private final Setting<Boolean> waitNoPlayers = sgGeneral.add(new BoolSetting.Builder()
        .name("ждать-пока-нет-пвп")
        .description("Не писать команду, если рядом чужие игроки.")
        .defaultValue(true)
        .build()
    );

    private final Setting<Double> radius = sgGeneral.add(new DoubleSetting.Builder()
        .name("радиус")
        .description("Дистанция проверки игроков.")
        .defaultValue(10)
        .min(2)
        .sliderMax(40)
        .visible(waitNoPlayers::get)
        .build()
    );

    private final Setting<Integer> clickDelay = sgGeneral.add(new IntSetting.Builder()
        .name("задержка-клика")
        .description("Тики между кликами по меню.")
        .defaultValue(5)
        .min(1)
        .sliderMax(20)
        .build()
    );

    private boolean sent;
    private int cooldown;

    public AutoDarena() {
        super(Categories.Misc, "auto-darena", "PvE: заходит на дуэль-арену и жмёт иглобрюха в меню.");
    }

    @Override
    public void onActivate() {
        sent = false;
        cooldown = 0;
    }

    @EventHandler
    private void onTick(TickEvent.Pre event) {
        if (mc.player == null || mc.world == null || mc.interactionManager == null) return;

        if (mc.currentScreen instanceof GenericContainerScreen) {
            if (cooldown > 0) {
                cooldown--;
                return;
            }
            ScreenHandler handler = mc.player.currentScreenHandler;
            int chest = Math.max(0, handler.slots.size() - 36);
            for (int i = 0; i < chest; i++) {
                ItemStack stack = handler.getSlot(i).getStack();
                if (stack.isOf(Items.PUFFERFISH)) {
                    mc.interactionManager.clickSlot(handler.syncId, i, 0, SlotActionType.QUICK_MOVE, mc.player);
                    cooldown = clickDelay.get();
                    return;
                }
            }
            return;
        }

        if (!sent && !inPvp()) {
            String cmd = joinCommand.get().trim();
            if (cmd.startsWith("/")) cmd = cmd.substring(1);
            if (!cmd.isEmpty() && mc.player.networkHandler != null) {
                mc.player.networkHandler.sendChatCommand(cmd);
                sent = true;
            }
        }
    }

    private boolean inPvp() {
        if (!waitNoPlayers.get()) return false;
        double r = radius.get();
        for (PlayerEntity player : mc.world.getPlayers()) {
            if (player == mc.player || player.isSpectator() || player.isCreative()) continue;
            if (Friends.get().isFriend(player)) continue;
            if (mc.player.squaredDistanceTo(player) <= r * r) return true;
        }
        return false;
    }
}


