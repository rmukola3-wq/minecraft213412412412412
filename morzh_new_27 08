            Render2D.rect(0, y, sw, 0.5f, line, 0f);
        }
        float gx = Math.round(mx / cell) * cell;
        float gy = Math.round(my / cell) * cell;
        Render2D.rect(gx - 1.4f, gy - 1.4f, 2.8f, 2.8f, MenuPalette.withAlpha(MenuPalette.ACCENT, (int) (90 * alpha)), 1.2f);
    }
}


