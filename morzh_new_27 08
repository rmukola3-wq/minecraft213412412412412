    private EntityHitResult findLivingHit(Vec3d from, Vec3d to, Entity owner) {
        Entity closest = null;
        Vec3d closestHit = null;
        double closestDistance = Double.MAX_VALUE;
        Box search = new Box(from, to).expand(1.0);
        for (Entity entity : mc.world.getOtherEntities(owner, search)) {
            if (entity == owner || entity.isSpectator() || !entity.isAlive() || !(entity instanceof LivingEntity)) continue;
            Optional<Vec3d> hit = entity.getBoundingBox().expand(0.3).raycast(from, to);
            if (hit.isPresent()) {
                double d = from.squaredDistanceTo(hit.get());
                if (d < closestDistance) {
                    closestDistance = d;
                    closest = entity;
                    closestHit = hit.get();
                }
            }
        }
        return closest == null ? null : new EntityHitResult(closest, closestHit);
    }

    private Entity findLiving(Vec3d from, Vec3d to, Entity owner) {
        EntityHitResult hit = findLivingHit(from, to, owner);
        return hit == null ? null : hit.getEntity();
    }

    private EntityHitResult findAnyHit(Vec3d from, Vec3d to, Entity owner) {
        Entity closest = null;
        Vec3d closestHit = null;
        double closestDistance = Double.MAX_VALUE;
        Box search = new Box(from, to).expand(1.0);
        for (Entity entity : mc.world.getOtherEntities(owner, search, e -> e != null && e.isAlive() && e.canHit())) {
            Optional<Vec3d> hit = entity.getBoundingBox().expand(0.3).raycast(from, to);
            if (hit.isEmpty()) continue;
            double d = from.squaredDistanceTo(hit.get());
            if (d < closestDistance) {
                closestDistance = d;
                closest = entity;
                closestHit = hit.get();
            }
        }
        return closest == null ? null : new EntityHitResult(closest, closestHit);
    }

