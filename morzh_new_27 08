        drawGl(textureId, x, y, width, height, 0, 0, 1, 1, colors, radii, 1f, 0f);
    }

    private void drawGl(int glId, float x, float y, float width, float height,
                        float u0, float v0, float u1, float v1,
                        int[] colors, float[] radii, float smoothness, float rotation) {
        MinecraftClient client = MinecraftClient.getInstance();
        if (client.getFramebuffer() == null) return;

        ensureShader();

        int framebufferWidth = client.getWindow().getFramebufferWidth();
        int framebufferHeight = client.getWindow().getFramebufferHeight();
        float fixedScreenWidth = framebufferWidth / FIXED_GUI_SCALE;
        float fixedScreenHeight = framebufferHeight / FIXED_GUI_SCALE;

        GL.bindTexture(glId, 0);
        shader.bind();
        shader.set("Sampler0", 0);
        shader.set("u_Rect", x, y, width, height);
        shader.set("u_Uv", u0, v0, u1, v1);
        shader.set("u_Radii", radii[0], radii[1], radii[2], radii[3]);
        shader.set("u_Rotation", rotation, 0, 0, 0);
        shader.set("u_Screen", fixedScreenWidth, fixedScreenHeight, smoothness, FIXED_GUI_SCALE);
        for (int i = 0; i < 4; i++) {
            int color = i < colors.length ? colors[i] : colors[colors.length - 1];
            float a = ((color >> 24) & 0xFF) / 255.0f;
            float r = ((color >> 16) & 0xFF) / 255.0f;
            float g = ((color >> 8) & 0xFF) / 255.0f;
            float b = (color & 0xFF) / 255.0f;
            shader.set("u_Colors[" + i + "]", r, g, b, a);
        }
        GlDraw.triangles(6);
    }
}


