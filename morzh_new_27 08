import static org.lwjgl.opengl.GL11.GL_SRC_ALPHA;

/** ThunderHack Recode Aura ESP: ThunderHack / NurikZapen / CelkaPasta / ThunderHackV2. */
public final class ThunderHackEsp {
    private static final Identifier CAPTURE = MeteorClient.identifier("textures/thunderhack/capture.png");
    private static final Identifier FIREFLY = MeteorClient.identifier("textures/thunderhack/firefly.png");
    private static final long INIT = System.currentTimeMillis();

    private static final TexturedMesh TEX = new TexturedMesh();
    private static Color customTint;

    private static float espValue = 1f;
    private static float prevEspValue = 1f;
    private static float espSpeed = 1f;
    private static boolean flipSpeed;
    private static float circleStep;
    private static float prevCircleStep;

    private ThunderHackEsp() {}

    public static void tick() {
        prevEspValue = espValue;
        espValue += espSpeed;
        if (espSpeed > 25) flipSpeed = true;
        if (espSpeed < -25) flipSpeed = false;
        espSpeed = flipSpeed ? espSpeed - 0.5f : espSpeed + 0.5f;

        prevCircleStep = circleStep;
        circleStep += 0.15f;
    }

    public static void render(Render3DEvent event, Entity target, Mode mode, int espLength, int factor, float shaking, float amplitude, Color tint) {
        customTint = tint;
        try {
            if (target == null || mc.player == null) return;
            switch (mode) {
                case ThunderHack -> drawThunderHack(event, target);
                case NurikZapen -> drawNurikZapen(event, target);
                case CelkaPasta -> drawCelkaPasta(event, target);
                case ThunderHackV2 -> drawGhosts(event, target, espLength, factor, shaking, amplitude);
            }
        } finally {
            customTint = null;
        }
    }

    public static int hudColor(int count) {
        int angle = (int) ((System.currentTimeMillis() / 18 + count) % 360);
        java.awt.Color c = java.awt.Color.getHSBColor(angle / 360f, 1f, 1f);
        return 0xFF000000 | c.getRGB();
    }

    public static Color hudColorC(int count, int alpha) {
        int a = MathHelper.clamp(alpha, 0, 255);
        if (customTint != null) {
            return new Color(customTint.r, customTint.g, customTint.b, a);
        }
        int rgb = hudColor(count);
        return new Color((rgb >> 16) & 255, (rgb >> 8) & 255, rgb & 255, a);
    }

    private static void drawThunderHack(Render3DEvent event, Entity target) {
        float tickDelta = event.tickDelta;
        double x = MathHelper.lerp(tickDelta, target.lastRenderX, target.getX());
        double y = MathHelper.lerp(tickDelta, target.lastRenderY, target.getY());
        double z = MathHelper.lerp(tickDelta, target.lastRenderZ, target.getZ());
        double height = target.getHeight();
        Renderer3D r = event.renderer;
        long now = System.currentTimeMillis() - INIT;

        for (int ring = 0; ring < 3; ring++) {
            int phase = ring * 120;
            int prev = -1;
            int prevUp = -1;
            for (int i = 0; i <= 361; i++) {
                double v = Math.sin(Math.toRadians(i + phase));
                double u = Math.cos(Math.toRadians(i + phase));
                float h = (float) (height - i * 0.004f);
                float alpha = 1f - (((float) i + (now / 5f)) % 360) / 60f;
                Color c = hudColorC((int) (i / 20f), (int) (MathHelper.clamp(alpha, 0, 1) * 255));
                int base = r.triangles.vec3(x + u * 0.5, y + h, z + v * 0.5).color(c).next();
                int up = r.triangles.vec3(x + u * 0.5, y + h + 0.1, z + v * 0.5).color(c).next();
                if (prev >= 0) {
                    r.triangles.triangle(prev, prevUp, up);
                    r.triangles.triangle(prev, up, base);
                }
                prev = base;
                prevUp = up;
            }
        }
    }

    private static void drawCelkaPasta(Render3DEvent event, Entity target) {
        float tickDelta = event.tickDelta;
        double cs = prevCircleStep + (circleStep - prevCircleStep) * tickDelta;
        double prevSin = Math.abs(1 + Math.sin(cs - 0.45f)) / 2;
        double sin = Math.abs(1 + Math.sin(cs)) / 2;
        double x = MathHelper.lerp(tickDelta, target.lastRenderX, target.getX());
        double y = MathHelper.lerp(tickDelta, target.lastRenderY, target.getY());
        double z = MathHelper.lerp(tickDelta, target.lastRenderZ, target.getZ());
        double y0 = y + prevSin * target.getHeight();
        double y1 = y + sin * target.getHeight();
        Renderer3D r = event.renderer;
        int prevLo = -1, prevHi = -1;
        for (int i = 0; i <= 30; i++) {
            double cx = x + Math.cos(i * 6.28 / 30) * target.getWidth() * 0.8;
            double cz = z + Math.sin(i * 6.28 / 30) * target.getWidth() * 0.8;
            Color hi = hudColorC(i, 170);
            Color lo = hudColorC(i, 0);
            int iHi = r.triangles.vec3(cx, y1, cz).color(hi).next();
            int iLo = r.triangles.vec3(cx, y0, cz).color(lo).next();
            if (prevHi >= 0) {
                r.triangles.triangle(prevHi, prevLo, iLo);
                r.triangles.triangle(prevHi, iLo, iHi);
            }
            prevHi = iHi;
            prevLo = iLo;
        }
    }

    private static void drawNurikZapen(Render3DEvent event, Entity target) {
        Camera camera = mc.gameRenderer.getCamera();
        Vec3d cam = camera.getPos();
        float tickDelta = event.tickDelta;
        double dx = MathHelper.lerp(tickDelta, target.lastRenderX, target.getX()) - cam.x;
        double dy = MathHelper.lerp(tickDelta, target.lastRenderY, target.getY()) - cam.y;
        double dz = MathHelper.lerp(tickDelta, target.lastRenderZ, target.getZ()) - cam.z;
        float spin = MathHelper.lerp(tickDelta, prevEspValue, espValue);

        MatrixStack matrices = new MatrixStack();
        matrices.translate(dx, dy + target.getEyeHeight(target.getPose()) / 2.0, dz);
        matrices.multiply(camera.getRotation());
        matrices.multiply(RotationAxis.POSITIVE_Z.rotationDegrees(spin));
        matrices.translate(-0.75, -0.75, -0.01);

        TEX.texture = CAPTURE;
        TEX.additive = true;
        TEX.depthTest = false;
        TEX.begin();
        addQuad(matrices.peek().getPositionMatrix(), cam, 0, 1.5f, 1.5f, 1.5f,
            hudColorC(90, 255), hudColorC(0, 255), hudColorC(180, 255), hudColorC(270, 255));
        TEX.render(event.matrices);
    }

    private static void drawGhosts(Render3DEvent event, Entity target, int espLength, int factor, float shaking, float amplitude) {
        Camera camera = mc.gameRenderer.getCamera();
        Vec3d cam = camera.getPos();
        float tickDelta = event.tickDelta;
        double tPosX = MathHelper.lerp(tickDelta, target.lastRenderX, target.getX()) - cam.x;
        double tPosY = MathHelper.lerp(tickDelta, target.lastRenderY, target.getY()) - cam.y;
        double tPosZ = MathHelper.lerp(tickDelta, target.lastRenderZ, target.getZ()) - cam.z;
        float iAge = (float) MathHelper.lerp(tickDelta, target.age - 1, target.age);

        TEX.texture = FIREFLY;
        TEX.additive = true;
        TEX.depthTest = false;
        TEX.begin();
        for (int j = 0; j < 3; j++) {
            for (int i = 0; i <= espLength; i++) {
                double radians = Math.toRadians((((float) i / 1.5f + iAge) * factor + (j * 120)) % (factor * 360));
                double sinQuad = Math.sin(Math.toRadians(iAge * 2.5f + i * (j + 1)) * amplitude) / shaking;
                float offset = i / (float) espLength;
                MatrixStack matrices = new MatrixStack();
                matrices.translate(
                    tPosX + Math.cos(radians) * target.getWidth(),
                    tPosY + 1 + sinQuad,
                    tPosZ + Math.sin(radians) * target.getWidth()
                );
                matrices.multiply(camera.getRotation());
                float scale = Math.max(0.24f * offset, 0.2f);
                Color c = hudColorC((int) (180 * offset), (int) (offset * 255));
                addQuad(matrices.peek().getPositionMatrix(), cam, -scale, scale, scale * 2, scale * 2, c, c, c, c);
            }
        }
        TEX.render(event.matrices);
    }

    private static void addQuad(Matrix4f matrix, Vec3d cam, float x, float y, float w, float h, Color c00, Color c10, Color c11, Color c01) {
        int i1 = corner(matrix, cam, x, y, 0, 1, c00);
        int i2 = corner(matrix, cam, x + w, y, 1, 1, c10);
        int i3 = corner(matrix, cam, x + w, y - h, 1, 0, c11);
        int i4 = corner(matrix, cam, x, y - h, 0, 0, c01);
        TEX.quad(i1, i2, i3, i4);
    }

    private static int corner(Matrix4f matrix, Vec3d cam, float lx, float ly, float u, float v, Color color) {
        Vector4f p = new Vector4f(lx, ly, 0, 1);
        p.mul(matrix);
        return TEX.vec3(p.x + cam.x, p.y + cam.y, p.z + cam.z).vec2(u, v).color(color).next();
    }

    public enum Mode {
        ThunderHack("ThunderHack"),
        NurikZapen("NurikZapen"),
        CelkaPasta("CelkaPasta"),
        ThunderHackV2("ThunderHack V2");

        private final String title;

        Mode(String title) {
            this.title = title;
        }

        @Override
        public String toString() {
            return title;
        }
    }

    private static class TexturedMesh extends ShaderMesh {
        private Identifier texture;
        private boolean additive;

        private TexturedMesh() {
            super(Shaders.POS_TEX_COLOR, DrawMode.Triangles, Mesh.Attrib.Vec3, Mesh.Attrib.Vec2, Mesh.Attrib.Color);
        }

        @Override
        protected void beforeRender() {
            super.beforeRender();
            GL.bindTexture(texture);
            GlStateManager._enableBlend();
            if (additive) GlStateManager._blendFunc(GL_SRC_ALPHA, GL_ONE);
            else GlStateManager._blendFunc(GL_SRC_ALPHA, org.lwjgl.opengl.GL11.GL_ONE_MINUS_SRC_ALPHA);
        }
    }
}


