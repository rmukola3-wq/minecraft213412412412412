    public static final int ACCENT = 0x859CFF;
    public static final int ACCENT_DIM = 0x5A6BB8;
    public static final int ON = 0x5ADC78;
    public static final int DANGER = 0xE65050;
    public static final int GOLD = 0xE8B84A;

