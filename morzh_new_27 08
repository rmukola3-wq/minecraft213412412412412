    private float renderLabeledField(float px, float y, String label, String value,
                                     boolean focused, float prog, long now, int alpha) {
        float fx = px + 10f, fw = PANEL_W - 20f;


        Fonts.INTER.draw(label, fx, y, 5f, withAlpha(COL_MUTED, (int)(prog * 150)));
        y += 8f;


        int fieldBg = withAlpha(focused ? COL_PANEL_BG2 : COL_PANEL_BG, alpha);
        Render2D.rect(fx, y, fw, FIELD_H, fieldBg, FIELD_R);
        int outlineC = withAlpha(focused ? COL_ACCENT : COL_OUTLINE, (int)(prog * (focused ? 180 : 50)));
        Render2D.outline(fx, y, fw, FIELD_H, OUTLINE_T, outlineC, FIELD_R);


        if (focused) Render2D.rect(fx, y, 2f, FIELD_H, withAlpha(COL_ACCENT, (int)(prog * 200)), 0f);


        String displayText = value;
        float textX = fx + (focused ? 7f : 5f);
        float maxW  = fw - (focused ? 14f : 10f);
        if (Fonts.INTER.getWidth(displayText, 7f) > maxW) {
            while (displayText.length() > 1 && Fonts.INTER.getWidth(displayText, 7f) > maxW)
                displayText = displayText.substring(1);
        }
        float textY = y + FIELD_H / 2f - Fonts.INTER.getHeight(7f) / 2f;
        Fonts.INTER.draw(displayText, textX, textY, 7f, withAlpha(COL_TEXT, alpha));


        if (focused) {
            boolean cursorVisible = ((now - cursorBlink) / 530L) % 2 == 0;
            if (cursorVisible) {
                float cursorX = textX + Fonts.INTER.getWidth(displayText, 7f) + 1f;
                Render2D.rect(cursorX, y + 4f, 1f, FIELD_H - 8f, withAlpha(COL_ACCENT, alpha), 0f);
