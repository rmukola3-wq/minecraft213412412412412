    private boolean grimBusy() {
        if (mc.player == null) return false;
        if (grimKeysDown()) return true;
        if (isMoving()) return true;
        if (mc.player.isSprinting()) return true;
        if (mc.player.input == null) return false;
        var in = mc.player.input.playerInput;
        return in.jump() || in.sprint() || in.forward() || in.backward() || in.left() || in.right();
    }

    private boolean grimKeysDown() {
        if (mc.getWindow() == null || mc.options == null) return false;
        for (KeyBinding binding : new KeyBinding[]{
            mc.options.forwardKey, mc.options.backKey, mc.options.rightKey, mc.options.leftKey, mc.options.jumpKey
        }) {
            InputUtil.Key key = ((KeyBindingAccessor) binding).getKey();
            if (key.getCategory() == InputUtil.Type.KEYSYM
                && InputUtil.isKeyPressed(mc.getWindow().getHandle(), key.getCode())) {
                return true;
            }
        }
        return false;
    }

    private void grimCleanup() {
        grimQueued.clear();
        grimSilent = false;
        grimResumeSprint = false;
        grimPhase = -1;
        grimWait = 0;
        grimCloseSync = -1;
    }

