package meteordevelopment.meteorclient.gui.morzh.dropdown.settings;

import meteordevelopment.meteorclient.gui.morzh.dropdown.DropDownColors;
import meteordevelopment.meteorclient.gui.morzh.dropdown.DropDownComponent;
import meteordevelopment.meteorclient.gui.morzh.dropdown.DropDownDraw;
import meteordevelopment.meteorclient.settings.Vector3dSetting;
import net.minecraft.client.gui.DrawContext;
import net.minecraft.util.math.MathHelper;
import org.joml.Vector3d;

import java.util.Locale;

public class DropDownVectorComponent extends DropDownComponent {
    private final Vector3dSetting setting;
    private int dragging = -1;
    private final float[] anim = new float[3];

    public DropDownVectorComponent(Vector3dSetting setting) {
        this.setting = setting;
        setHeight(18 * 3);
    }

    @Override
    public void measure(float width) {
        super.measure(width);
        setHeight(12 + 18 * 3);
    }

    @Override
    public void render(DrawContext context, float mouseX, float mouseY) {
        DropDownDraw.text(context, setting.title, getX() + 5, getY() + 2, DropDownColors.MODE_LABEL, 5.5f);

        drawAxis(context, mouseX, mouseY, 0, "X", setting.get().x);
        drawAxis(context, mouseX, mouseY, 1, "Y", setting.get().y);
        drawAxis(context, mouseX, mouseY, 2, "Z", setting.get().z);
    }

    private void drawAxis(DrawContext context, float mouseX, float mouseY, int index, String name, double value) {
        float y = getY() + 12 + index * 18;
        String label = String.format(Locale.US, "%." + setting.decimalPlaces + "f", value);

        DropDownDraw.text(context, name, getX() + 5, y + 2, DropDownColors.TEXT_SETTING, 5.5f);
        DropDownDraw.text(context, label, getX() + getWidth() - 5 - DropDownDraw.textWidth(label, 5.5f), y + 2, DropDownColors.TEXT_SETTING, 5.5f);

        double min = setting.sliderMin;
        double max = setting.sliderMax;
        if (max <= min) {
            min = setting.min;
            max = setting.max;
        }
        if (max <= min) max = min + 1;

        double clamped = MathHelper.clamp(value, min, max);
        float target = (float) ((getWidth() - 10) * (clamped - min) / (max - min));
        anim[index] = DropDownDraw.fast(anim[index], target, 20);

        DropDownDraw.rounded(context, getX() + 5, y + 11, getWidth() - 10, 2, 0.6f, DropDownColors.SLIDER_TRACK);
        DropDownDraw.rounded(context, getX() + 5, y + 11, anim[index], 2, 0.6f, DropDownColors.SLIDER_FILL);
        DropDownDraw.circle(context, getX() + 5 + anim[index], y + 12, 5, DropDownColors.SLIDER_FILL);

        if (dragging == index) {
            DropDownDraw.cursorResize();
            apply(index, mouseX, min, max);
        } else if (DropDownDraw.hovered(mouseX, mouseY, getX() + 5, y + 10, getWidth() - 10, 3)) {
            DropDownDraw.cursorResize();
        }
    }

    @Override
    public void mouseClick(float mouseX, float mouseY, int button) {
        for (int i = 0; i < 3; i++) {
            float y = getY() + 12 + i * 18;
            if (DropDownDraw.hovered(mouseX, mouseY, getX() + 5, y + 10, getWidth() - 10, 3)) {
                dragging = i;
            }
        }
    }

    @Override
    public void mouseRelease(float mouseX, float mouseY, int button) {
        dragging = -1;
    }

    private void apply(int index, float mouseX, double min, double max) {
        double increment = Math.pow(10, -setting.decimalPlaces);
        double raw = (mouseX - getX() - 5) / (getWidth() - 10) * (max - min) + min;
        raw = MathHelper.clamp(DropDownDraw.round(raw, increment), setting.min, setting.max);

        Vector3d value = setting.get();
        switch (index) {
            case 0 -> value.x = raw;
            case 1 -> value.y = raw;
            case 2 -> value.z = raw;
        }
        setting.set(value.x, value.y, value.z);
    }

    @Override
    public boolean isVisible() {
        return setting.isVisible();
    }
}


