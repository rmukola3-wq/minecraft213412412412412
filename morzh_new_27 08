package meteordevelopment.meteorclient.systems.modules.combat.aura.expensive;

import meteordevelopment.meteorclient.MeteorClient;
import meteordevelopment.meteorclient.events.packets.PacketEvent;
import meteordevelopment.orbit.EventHandler;
import net.minecraft.network.packet.c2s.play.ClientCommandC2SPacket;

/**
 * Tracks server sprint like Expensive SlotSyncHandler. Does not cancel START/STOP —
 * that left sprint off after a hit.
 */
public final class SlotSprintSync {
    public static boolean lastSprinting;
    public static int suppressTicks;
    private static boolean subscribed;

    public static void ensureSubscribed() {
        if (subscribed) return;
        MeteorClient.EVENT_BUS.subscribe(INSTANCE);
        subscribed = true;
    }

    private static final SlotSprintSync INSTANCE = new SlotSprintSync();

    public static void tick() {
        if (suppressTicks > 0) suppressTicks--;
    }

    public static boolean delayHitUntilUnsprinted() {
        ensureSubscribed();
        if (MeteorClient.mc.player == null) return true;
        if (!lastSprinting) {
            MeteorClient.mc.player.setSprinting(false);
            return false;
        }
        if (MeteorClient.mc.player.networkHandler != null) {
            MeteorClient.mc.player.networkHandler.sendPacket(
                new ClientCommandC2SPacket(MeteorClient.mc.player, ClientCommandC2SPacket.Mode.STOP_SPRINTING)
            );
        }
        MeteorClient.mc.player.setSprinting(false);
        return true;
    }

    public static void unsprintQuiet() {
        if (MeteorClient.mc.player != null) {
            MeteorClient.mc.player.setSprinting(false);
        }
    }

    @EventHandler
    private void onSent(PacketEvent.Sent event) {
        if (event.packet instanceof ClientCommandC2SPacket packet) {
            ClientCommandC2SPacket.Mode mode = packet.getMode();
            if (mode == ClientCommandC2SPacket.Mode.START_SPRINTING) lastSprinting = true;
            else if (mode == ClientCommandC2SPacket.Mode.STOP_SPRINTING) lastSprinting = false;
        }
    }
}


