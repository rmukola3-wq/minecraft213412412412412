    private final Setting<SettingColor> color = sg.add(new ColorSetting.Builder()
        .name("color")
        .description("Base color. Rockstar rainbows from this, Delta tints with UUID hue.")
        .defaultValue(new SettingColor(129, 135, 255, 220))
        .build()
    );

    private final List<Spark> sparks = new ArrayList<>();
    private final Map<Integer, ArrayDeque<Vec3d>> smoke = new HashMap<>();
    private final TexturedMesh mesh = new TexturedMesh();
    private final GlowMesh glow = new GlowMesh();
    private Vec3d camPos = Vec3d.ZERO;

    public ProjectileParticles() {
        super(Categories.Render, "projectile-particles", "Custom sprites behind pearls and other thrown items.");
    }

    @Override
    public void onDeactivate() {
        sparks.clear();
        smoke.clear();
    }

    @EventHandler
    private void onTick(TickEvent.Post event) {
        if (mc.world == null) return;
        sparks.removeIf(Spark::tick);
        if (style.get() == Style.Smoke) return;

        ThreadLocalRandom rng = ThreadLocalRandom.current();
        int n = style.get() == Style.Rockstar ? perTick.get() : Math.max(1, perTick.get() - 1);

        for (Entity entity : mc.world.getEntities()) {
            if (!tracks(entity)) continue;
            if (entity instanceof ProjectileInGroundAccessor ppe && ppe.invokeIsInGround()) continue;

            Vec3d pos = entity.getLerpedPos(1f);
            Vec3d vel = entity.getVelocity();
            if (vel.lengthSquared() < 1e-6) continue;

            Vec3d back = vel.normalize().multiply(-0.12);
            float hueBase = (entity.getUuid().getLeastSignificantBits() & 65535) / 65535f;

            for (int i = 0; i < n; i++) {
                double ox = rng.nextDouble(-0.08, 0.08);
                double oy = rng.nextDouble(-0.06, 0.1);
                double oz = rng.nextDouble(-0.08, 0.08);
                sparks.add(new Spark(
                    pos.x + back.x + ox,
                    pos.y + back.y + oy,
                    pos.z + back.z + oz,
                    vel.x * 0.08 + rng.nextDouble(-0.04, 0.04),
                    vel.y * 0.08 + rng.nextDouble(0.01, 0.05),
                    vel.z * 0.08 + rng.nextDouble(-0.04, 0.04),
                    hueBase,
                    style.get() == Style.Rockstar
                ));
            }
        }
    }

    @EventHandler
    private void onRender(Render3DEvent event) {
        if (style.get() == Style.Smoke) {
            sparks.clear();
            renderSmoke(event);
            return;
        }
        smoke.clear();
        if (sparks.isEmpty()) return;
        mesh.texture = style.get() == Style.Rockstar ? TEX_FIREFLY : TEX_STAR;
        mesh.additive = true;
        mesh.depthTest = true;
        mesh.begin();
        for (Spark spark : sparks) spark.render(event.tickDelta);
        if (style.get() == Style.Rockstar) {
            mesh.render(event.matrices);
            mesh.texture = TEX_STAR;
            mesh.begin();
            for (Spark spark : sparks) {
                if (spark.core) spark.renderCore(event.tickDelta);
            }
        }
        mesh.render(event.matrices);
        GlStateManager._blendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
    }

    private void renderSmoke(Render3DEvent event) {
        if (mc.world == null || mc.player == null) return;
        camPos = mc.gameRenderer.getCamera().getPos();
        Set<Integer> alive = new HashSet<>();

        for (Entity entity : mc.world.getEntities()) {
            if (!tracks(entity)) continue;
            if (entity instanceof ProjectileInGroundAccessor ppe && ppe.invokeIsInGround()) continue;
            Vec3d vel = entity.getVelocity();
            if (vel.lengthSquared() < 1e-6) continue;

            int id = entity.getId();
            alive.add(id);
            Vec3d pos = new Vec3d(
                MathHelper.lerp(event.tickDelta, entity.prevX, entity.getX()),
                MathHelper.lerp(event.tickDelta, entity.prevY, entity.getY()),
                MathHelper.lerp(event.tickDelta, entity.prevZ, entity.getZ())
            );
            ArrayDeque<Vec3d> trail = smoke.computeIfAbsent(id, k -> new ArrayDeque<>());
            Vec3d last = trail.peekLast();
            if (last == null) {
                trail.addLast(pos);
            } else {
                double dist = last.distanceTo(pos);
                if (dist > 1.0e-4) {
                    int steps = dist > 0.18 ? Math.min(5, (int) (dist / 0.09)) : 1;
                    for (int s = 1; s <= steps; s++) {
                        trail.addLast(last.lerp(pos, s / (double) steps));
                    }
                    while (trail.size() > SMOKE_SAMPLES) trail.removeFirst();
                }
            }
        }

        smoke.keySet().removeIf(id -> !alive.contains(id));
        if (smoke.isEmpty()) return;

        SettingColor base = color.get();
        double width = size.get();

        glow.additive = true;
        glow.depthTest = false;
        glow.begin();
        for (ArrayDeque<Vec3d> trail : smoke.values()) {
            if (trail.size() < 2) continue;
            List<Vec3d> pts = new ArrayList<>(trail);
            drawRibbon(pts, width * 1.35, 0.22f, base);
            drawRibbon(pts, width * 0.78, 0.45f, base);
            drawRibbon(pts, width * 0.38, 0.75f, base);
            drawRibbon(pts, width * 0.12, 1.00f, base);
        }
        glow.render(event.matrices);

        mesh.texture = TEX_FIREFLY;
        mesh.additive = true;
        mesh.depthTest = false;
        mesh.begin();
        for (ArrayDeque<Vec3d> trail : smoke.values()) {
            if (trail.isEmpty()) continue;
            List<Vec3d> pts = new ArrayList<>(trail);
            int n = pts.size();
            for (int i = 0; i < n; i++) {
                float t = i / (float) Math.max(1, n - 1);
                float fade = t * t;
                Vec3d p = pts.get(i);
                double wobble = Math.sin(i * 1.7 + n * 0.3) * width * 0.18;
                Vec3d jitter = cameraRight().multiply(wobble).add(cameraUp().multiply(wobble * 0.35));
                Color blob = new Color(base.r, base.g, base.b, MathHelper.clamp((int) (base.a * fade * 0.55), 0, 255));
                Color halo = new Color(
                    Math.min(255, base.r + 40),
                    Math.min(255, base.g + 40),
                    Math.min(255, base.b + 50),
                    MathHelper.clamp((int) (base.a * fade * 0.28), 0, 255)
                );
                addBillboard(p.x + jitter.x, p.y + jitter.y, p.z + jitter.z, width * (0.55 + fade * 0.55), blob);
                addBillboard(p.x, p.y, p.z, width * (0.28 + fade * 0.22), halo);
            }
        }
        mesh.render(event.matrices);
        GlStateManager._blendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
    }

    private void drawRibbon(List<Vec3d> pts, double half, float alphaMul, SettingColor base) {
        int n = pts.size();
        for (int i = 1; i < n; i++) {
            Vec3d from = pts.get(i - 1);
            Vec3d to = pts.get(i);
            float ta = (i - 1) / (float) (n - 1);
            float tb = i / (float) (n - 1);
            Color ca = smokeColor(base, ta * ta * alphaMul);
            Color cb = smokeColor(base, tb * tb * alphaMul);
            Vec3d dir = to.subtract(from);
            Vec3d side = dir.crossProduct(from.subtract(camPos));
            if (side.lengthSquared() < 1.0e-8) side = new Vec3d(0, 1, 0);
            side = side.normalize().multiply(half);
            int i1 = glow.vec3(from.x + side.x, from.y + side.y, from.z + side.z).color(ca).next();
            int i2 = glow.vec3(from.x - side.x, from.y - side.y, from.z - side.z).color(ca).next();
            int i3 = glow.vec3(to.x - side.x, to.y - side.y, to.z - side.z).color(cb).next();
            int i4 = glow.vec3(to.x + side.x, to.y + side.y, to.z + side.z).color(cb).next();
            glow.quad(i1, i2, i3, i4);
        }
    }

    private static Color smokeColor(SettingColor base, float a) {
        Color c = new Color(base.r, base.g, base.b, MathHelper.clamp((int) (base.a * MathHelper.clamp(a, 0, 1)), 0, 255));
        return c;
    }

    private Vec3d cameraRight() {
        float yaw = (float) Math.toRadians(mc.gameRenderer.getCamera().getYaw());
        return new Vec3d(Math.cos(yaw), 0, Math.sin(yaw));
    }

    private Vec3d cameraUp() {
        float yaw = (float) Math.toRadians(mc.gameRenderer.getCamera().getYaw());
        float pitch = (float) Math.toRadians(mc.gameRenderer.getCamera().getPitch());
        return new Vec3d(-Math.sin(yaw) * Math.sin(pitch), Math.cos(pitch), Math.cos(yaw) * Math.sin(pitch));
    }

    private boolean tracks(Entity entity) {
        if (entity instanceof EnderPearlEntity) return pearls.get();
        if (entity instanceof ArrowEntity) return arrows.get();
        if (entity instanceof PotionEntity) return potions.get();
        if (entity instanceof TridentEntity || entity instanceof SnowballEntity || entity instanceof EggEntity || entity instanceof ExperienceBottleEntity) {
            return others.get();
        }
        return false;
    }

    private void addBillboard(double x, double y, double z, double spriteSize, Color spriteColor) {
        if (spriteColor.a <= 0) return;
        Vec3d right = cameraRight();
        Vec3d up = cameraUp();
        Vec3d h = right.multiply(spriteSize);
        Vec3d v = up.multiply(spriteSize);
        Vec3d c = new Vec3d(x, y, z);
        int i1 = mesh.vec3(c.subtract(h).add(v).x, c.subtract(h).add(v).y, c.subtract(h).add(v).z).vec2(0, 0).color(spriteColor).next();
        int i2 = mesh.vec3(c.subtract(h).subtract(v).x, c.subtract(h).subtract(v).y, c.subtract(h).subtract(v).z).vec2(0, 1).color(spriteColor).next();
        int i3 = mesh.vec3(c.add(h).subtract(v).x, c.add(h).subtract(v).y, c.add(h).subtract(v).z).vec2(1, 1).color(spriteColor).next();
        int i4 = mesh.vec3(c.add(h).add(v).x, c.add(h).add(v).y, c.add(h).add(v).z).vec2(1, 0).color(spriteColor).next();
        mesh.quad(i1, i2, i3, i4);
    }

    private class Spark {
        double px, py, pz, x, y, z, mx, my, mz;
        int age, maxAge;
        final float hueBase;
        final boolean core;

        Spark(double x, double y, double z, double mx, double my, double mz, float hueBase, boolean core) {
            this.x = this.px = x;
            this.y = this.py = y;
            this.z = this.pz = z;
            this.mx = mx;
            this.my = my;
            this.mz = mz;
            this.hueBase = hueBase;
            this.core = core;
            maxAge = age = ThreadLocalRandom.current().nextInt(core ? 14 : 10, core ? 26 : 18);
        }

        boolean tick() {
            age--;
            if (age < 0) return true;
            px = x;
            py = y;
            pz = z;
            x += mx;
            y += my;
            z += mz;
            mx *= 0.88;
            my *= 0.90;
            mz *= 0.88;
            my += core ? 0.004 : -0.006;
            return false;
        }

        void render(float tickDelta) {
            draw(tickDelta, size.get() * (core ? 1.35 : 0.85), 1f);
        }

        void renderCore(float tickDelta) {
            draw(tickDelta, size.get() * 0.45, 1.15f);
        }

        private void draw(float tickDelta, double spriteSize, float alphaMul) {
            double ix = MathHelper.lerp(tickDelta, px, x);
            double iy = MathHelper.lerp(tickDelta, py, y);
            double iz = MathHelper.lerp(tickDelta, pz, z);
            float life = age / (float) maxAge;
            SettingColor base = color.get();
            int r, g, b;
            if (style.get() == Style.Rockstar) {
                int packed = HudChrome.astolfo((int) (hueBase * 360 + age * 8));
                r = (packed >> 16) & 255;
                g = (packed >> 8) & 255;
                b = packed & 255;
                r = (r + base.r) / 2;
                g = (g + base.g) / 2;
                b = (b + base.b) / 2;
            } else {
                float hue = (((hueBase + (float) (ix * 0.05 + iz * 0.05)) % 1f) + 1f) % 1f;
                int rgb = java.awt.Color.HSBtoRGB(hue, 0.65f, 1f);
                r = (int) (((rgb >> 16) & 255) * 0.45f + base.r * 0.55f);
                g = (int) (((rgb >> 8) & 255) * 0.45f + base.g * 0.55f);
                b = (int) ((rgb & 255) * 0.45f + base.b * 0.55f);
            }
            int a = MathHelper.clamp((int) (base.a * life * alphaMul), 0, 255);
            addBillboard(ix, iy, iz, spriteSize * (0.55 + life * 0.45), new Color(r, g, b, a));
        }
    }

    public enum Style {
        Rockstar,
        Delta,
        Smoke
    }

    private static class TexturedMesh extends ShaderMesh {
        Identifier texture;
        boolean additive;

        private TexturedMesh() {
            super(Shaders.POS_TEX_COLOR, DrawMode.Triangles, Mesh.Attrib.Vec3, Mesh.Attrib.Vec2, Mesh.Attrib.Color);
        }

        @Override
        protected void beforeRender() {
            super.beforeRender();
            GL.bindTexture(texture);
            if (additive) GlStateManager._blendFunc(GL_SRC_ALPHA, GL_ONE);
            else GlStateManager._blendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
        }
    }

    private static class GlowMesh extends ShaderMesh {
        boolean additive;

        private GlowMesh() {
            super(Shaders.POS_COLOR, DrawMode.Triangles, Mesh.Attrib.Vec3, Mesh.Attrib.Color);
        }

        @Override
        protected void beforeRender() {
            super.beforeRender();
            GlStateManager._enableBlend();
            if (additive) GlStateManager._blendFunc(GL_SRC_ALPHA, GL_ONE);
            else GlStateManager._blendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
            GlStateManager._depthMask(!additive);
            GlStateManager._disableCull();
        }
    }
}


