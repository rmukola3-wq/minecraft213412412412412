/**
 * Rockstar 2.0 HUD editor: drag widgets on the game, bottom chips, inline settings plate.
 * No ThunderHack sidebar, no Meteor settings window.
 */
public class MorzhHudEditorScreen extends HudEditorScreen {
    private static final float CHIP_H = 18f;
    private static final float CHIP_PAD = 7f;
    private static final float CHIP_GAP = 4f;
    private static final float CARD_W = 176f;
    private static final float ROW_H = 22f;

    private static final float PLUS = 28f;

    private HudElement focused;
    private final List<Chip> chips = new ArrayList<>();
    private final List<Row> rows = new ArrayList<>();
    private final List<CatRow> catalog = new ArrayList<>();
    private float cardX, cardY, cardW, cardH;
    private float barX, barY, barW, barH;
    private float plusX, plusY;
    private float catX, catY, catW, catH;
    private boolean catalogOpen;
    private Row sliding;

    public MorzhHudEditorScreen(GuiTheme theme) {
        super(theme);
        MorzhHudSounds.playEditorOpen();
    }

    @Override
    public void removed() {
        MorzhHudSounds.playEditorClose();
        super.removed();
    }

    @Override
    protected boolean allowMarqueeSelection() {
        return false;
    }

    @Override
    protected void renderEditorBackground(DrawContext context) {
        MorzhSmoothRenderer.roundedRect(context, 0, 0,
            (float) Utils.getWindowWidth(), (float) Utils.getWindowHeight(), 0, 0x66000000);
    }

    @Override
    protected void renderElement(HudElement element, Color bgColor, Color olColor) {
        // Rockstar editor has no Meteor red/grey selection boxes.
    }

    @Override
    protected void renderEditorForeground(DrawContext context, int mouseX, int mouseY) {
        for (HudElement element : hud) {
            if (element == focused) continue;
            if (!element.isActive()) {
                MorzhSmoothRenderer.roundedRect(context, element.x - 2, element.y - 2,
                    element.getWidth() + 4, element.getHeight() + 4, 4, 0x22FFFFFF, 0x44FFFFFF, 0.8f);
            }
        }

        HudElement hovered = getHovered(mouseX, mouseY);
        HudElement outline = focused != null ? focused : hovered;
        if (outline != null) {
            int line = outline == focused ? HudChrome.astolfo(0) : 0x66FFFFFF;
            MorzhSmoothRenderer.roundedRect(context, outline.x - 3, outline.y - 3,
                outline.getWidth() + 6, outline.getHeight() + 6, 5, 0x14FFFFFF, line, 1.2f);
        }

        renderChips(context, mouseX, mouseY);
        if (focused != null) renderCard(context, mouseX, mouseY);
        renderPlus(context, mouseX, mouseY);
        if (catalogOpen) renderCatalog(context, mouseX, mouseY);

        String hint = "перетащи элемент  ·  клик — настройки  ·  + добавить худ";
        float tw = (float) MorzhSmoothRenderer.textWidth(hint, 0.72);
        float hx = (float) (Utils.getWindowWidth() - tw) / 2f;
        MorzhSmoothRenderer.roundedRect(context, hx - 10, 8, tw + 20, 16, 4, HudChrome.FIRST);
        MorzhSmoothRenderer.text(context, hint, hx, 11, HudChrome.MUTED, false, 0.72);
    }

    private void renderChips(DrawContext context, int mouseX, int mouseY) {
        chips.clear();
        float maxW = (float) Utils.getWindowWidth() - 24f;
        float x = 0;
        float y = 0;
        float rowW = 0;
        float rowsH = CHIP_H;
        List<float[]> laid = new ArrayList<>();

        for (HudElement element : hud) {
            String label = chipName(element);
            float w = (float) MorzhSmoothRenderer.textWidth(label, 0.70) + 16f;
            if (x > 0 && x + w > maxW - CHIP_PAD * 2) {
                x = 0;
                y += CHIP_H + CHIP_GAP;
                rowsH = y + CHIP_H;
            }
            laid.add(new float[] { x, y, w });
            x += w + CHIP_GAP;
            rowW = Math.max(rowW, x - CHIP_GAP);
        }

        barW = Math.min(maxW, rowW + CHIP_PAD * 2);
        barH = rowsH + CHIP_PAD * 2;
        barX = ((float) Utils.getWindowWidth() - barW) / 2f;
        barY = (float) Utils.getWindowHeight() - barH - 10f;

        MorzhSmoothRenderer.roundedRect(context, barX, barY, barW, barH, 6, HudChrome.FIRST);

        int i = 0;
        for (HudElement element : hud) {
            float[] p = laid.get(i++);
            float cx = barX + CHIP_PAD + p[0];
            float cy = barY + CHIP_PAD + p[1];
            float cw = p[2];
            boolean hover = mouseX >= cx && mouseX <= cx + cw && mouseY >= cy && mouseY <= cy + CHIP_H;
            int fill = element.isActive()
                ? (hover ? 0xFF3A3A44 : 0xFF2A2A32)
                : (hover ? 0xFF24242C : HudChrome.SECOND);
            int text = element.isActive() ? 0xFFFFFFFF : HudChrome.MUTED;
            MorzhSmoothRenderer.roundedRect(context, cx, cy, cw, CHIP_H, 4, fill);
            if (element.isActive()) {
                MorzhSmoothRenderer.roundedRect(context, cx, cy + CHIP_H - 2f, cw, 2f, 1, HudChrome.astolfo(i * 40));
            }
            MorzhSmoothRenderer.text(context, chipName(element), cx + 8, cy + 5, text, false, 0.70);
            chips.add(new Chip(element, cx, cy, cw, CHIP_H));
        }
    }

    private void renderPlus(DrawContext context, int mouseX, int mouseY) {
        plusX = (float) Utils.getWindowWidth() - PLUS - 12f;
        plusY = 12f;
        boolean hover = mouseX >= plusX && mouseX <= plusX + PLUS && mouseY >= plusY && mouseY <= plusY + PLUS;
        HudChrome.card(context, plusX, plusY, PLUS, PLUS, 7);
        int plusColor = hover || catalogOpen ? 0xFFFFFFFF : HudChrome.RV_ORANGE;
        float cx = plusX + PLUS / 2f;
        float cy = plusY + PLUS / 2f;
        MorzhSmoothRenderer.roundedRect(context, cx - 7, cy - 1.4f, 14, 2.8f, 1.2f, plusColor);
        MorzhSmoothRenderer.roundedRect(context, cx - 1.4f, cy - 7, 2.8f, 14, 1.2f, plusColor);
    }

    private void renderCatalog(DrawContext context, int mouseX, int mouseY) {
        catalog.clear();
        List<HudElementInfo<?>> infos = new ArrayList<>(hud.infos.values());
        infos.sort(Comparator.comparing(info -> catalogName(info).toLowerCase(Locale.ROOT)));

        catW = 188f;
        float rowH = 22f;
        catH = 30f + infos.size() * (rowH + 3f) + 10f;
        catX = plusX + PLUS - catW;
        catY = plusY + PLUS + 8f;
        float sh = (float) Utils.getWindowHeight();
        if (catY + catH > sh - 12f) catY = Math.max(8f, sh - 12f - catH);
        if (catX < 8f) catX = 8f;

        HudChrome.card(context, catX, catY, catW, catH, 8);
        MorzhSmoothRenderer.text(context, "Добавить HUD", catX + 12, catY + 9, 0xFFFFFFFF, true, 0.78);

        float y = catY + 30f;
        for (HudElementInfo<?> info : infos) {
            boolean hover = mouseX >= catX + 8 && mouseX <= catX + catW - 8 && mouseY >= y && mouseY <= y + rowH;
            int fill = hover ? 0xFF2A2A32 : HudChrome.RV_SLOT;
            MorzhSmoothRenderer.roundedRect(context, catX + 8, y, catW - 16, rowH, 5, fill);
            MorzhSmoothRenderer.text(context, catalogName(info), catX + 16, y + 6, 0xFFFFFFFF, false, 0.70);
            float plusBox = catX + catW - 30;
            MorzhSmoothRenderer.roundedRect(context, plusBox, y + 4, 14, 14, 3, hover ? HudChrome.RV_ORANGE : HudChrome.RV_PILL);
            MorzhSmoothRenderer.text(context, "+", plusBox + 3.5f, y + 6, 0xFFFFFFFF, false, 0.70);
            catalog.add(new CatRow(info, catX + 8, y, catW - 16, rowH));
            y += rowH + 3f;
        }
    }

    private String catalogName(HudElementInfo<?> info) {
        return switch (info.name) {
            case "watermark" -> "Ватермарка";
            case "coords" -> "Координаты";
            case "key-binds" -> "Хоткеи";
            case "potion-timers" -> "Эффекты";
            case "staff-board" -> "Стафф";
            case "notify" -> "Алерты";
            case "armor" -> "Броня";
            case "pvp-resources" -> "Предметы";
            case "cooldowns" -> "КД";
            case "kill-stats" -> "Статистика";
            case "target" -> "Таргет";
            case "inventory" -> "Инвентарь";
            case "player-model" -> "Модель";
            case "text" -> "Текст";
            default -> info.title;
        };
    }

    private void addFromCatalog(HudElementInfo<?> info) {
        int x = (int) (Utils.getWindowWidth() / 2.0 - 40);
        int y = (int) (Utils.getWindowHeight() / 2.0 - 20);
        hud.add(info, x, y);
        for (HudElement element : hud) {
            if (element.info == info) focused = element;
        }
        catalogOpen = false;
        MorzhHudSounds.playElementSelect();
    }

    private void renderCard(DrawContext context, int mouseX, int mouseY) {
        rows.clear();
        HudElement el = focused;
        List<Setting<?>> settings = visibleSettings(el);
        int n = 1 + (el instanceof HudScalableElement ? 1 : 0) + settings.size();
        cardH = 28 + n * ROW_H + 10;
        cardW = CARD_W;
        cardX = el.x + el.getWidth() + 8f;
        cardY = el.y;
        float sw = (float) Utils.getWindowWidth();
        float sh = (float) Utils.getWindowHeight();
        if (cardX + cardW > sw - 8) cardX = el.x - cardW - 8f;
        if (cardX < 8) cardX = 8;
        if (cardY + cardH > sh - barH - 16) cardY = Math.max(8, sh - barH - 16 - cardH);

        MorzhSmoothRenderer.roundedRect(context, cardX, cardY, cardW, cardH, 5, HudChrome.FIRST);
        MorzhSmoothRenderer.roundedRect(context, cardX, cardY, cardW, 22, 5, HudChrome.SECOND);
        MorzhSmoothRenderer.text(context, chipName(el), cardX + 8, cardY + 7, 0xFFFFFFFF, true, 0.78);

        float y = cardY + 26;
        y = boolRow(context, mouseX, mouseY, y, "активен", el.isActive(), () -> {
            el.toggle();
            MorzhHudSounds.playElementToggle();
        });

        if (el instanceof HudScalableElement scalable) {
            y = sliderRow(context, y, "размер", scalable.getScaleValue(), 0.5, 5.0,
                v -> scalable.adjustScale(v - scalable.getScaleValue()));
        }

        for (Setting<?> setting : settings) {
            if (setting instanceof BoolSetting bool) {
                y = boolRow(context, mouseX, mouseY, y, setting.title, bool.get(), () -> {
                    bool.set(!bool.get());
                    MorzhHudSounds.playBoolean();
                });
            } else if (setting instanceof EnumSetting<?> en) {
                y = enumRow(context, mouseX, mouseY, y, setting.title, en);
            } else if (setting instanceof DoubleSetting d) {
                y = sliderRow(context, y, setting.title, d.get(), d.sliderMin, d.sliderMax, d::set);
            } else if (setting instanceof IntSetting in) {
                y = sliderRow(context, y, setting.title, in.get(), in.sliderMin, in.sliderMax,
                    v -> in.set((int) Math.round(v)));
            } else if (setting instanceof ColorSetting col) {
                y = colorRow(context, y, setting.title, col.get());
            }
        }
    }

    private float boolRow(DrawContext context, int mouseX, int mouseY, float y, String label, boolean on, Runnable click) {
        float x = cardX + 8;
        float w = cardW - 16;
        boolean hover = mouseX >= x && mouseX <= x + w && mouseY >= y && mouseY <= y + ROW_H;
        MorzhSmoothRenderer.text(context, label, x, y + 6, hover ? 0xFFFFFFFF : HudChrome.TEXT, false, 0.70);
        float tx = x + w - 28;
        int track = on ? 0xFF818497 : 0xFF1D1D1F;
        MorzhSmoothRenderer.roundedRect(context, tx, y + 5, 26, 12, 6, track);
        float knob = on ? tx + 14 : tx + 2;
        MorzhSmoothRenderer.roundedRect(context, knob, y + 6, 10, 10, 5, 0xFFE8E8EC);
        rows.add(new Row(x, y, w, ROW_H, click, null, 0, 0));
        return y + ROW_H;
    }

    @SuppressWarnings({"unchecked", "rawtypes"})
    private float enumRow(DrawContext context, int mouseX, int mouseY, float y, String label, EnumSetting en) {
        float x = cardX + 8;
        float w = cardW - 16;
        boolean hover = mouseX >= x && mouseX <= x + w && mouseY >= y && mouseY <= y + ROW_H;
        MorzhSmoothRenderer.text(context, label, x, y + 6, HudChrome.MUTED, false, 0.66);
        String value = en.get().toString();
        float vw = (float) MorzhSmoothRenderer.textWidth(value, 0.70);
        MorzhSmoothRenderer.roundedRect(context, x + w - vw - 10, y + 3, vw + 8, 16, 3, hover ? 0xFF3A3A44 : HudChrome.SECOND);
        MorzhSmoothRenderer.text(context, value, x + w - vw - 6, y + 6, 0xFFFFFFFF, false, 0.70);
        rows.add(new Row(x, y, w, ROW_H, () -> {
            Enum<?> current = (Enum<?>) en.get();
            Enum<?>[] vals = current.getDeclaringClass().getEnumConstants();
            int i = 0;
            for (int k = 0; k < vals.length; k++) if (vals[k] == current) i = k;
            en.set(vals[(i + 1) % vals.length]);
            MorzhHudSounds.playBoolean();
        }, null, 0, 0));
        return y + ROW_H;
    }

    private float sliderRow(DrawContext context, float y, String label, double value, double min, double max, DoubleConsumer set) {
        float x = cardX + 8;
        float w = cardW - 16;
        MorzhSmoothRenderer.text(context, label, x, y + 2, HudChrome.MUTED, false, 0.62);
        String txt = Math.abs(max - min) > 5 ? String.format(java.util.Locale.US, "%.1f", value)
            : String.format(java.util.Locale.US, "%.2f", value);
        float tw = (float) MorzhSmoothRenderer.textWidth(txt, 0.62);
        MorzhSmoothRenderer.text(context, txt, x + w - tw, y + 2, HudChrome.TEXT, false, 0.62);
        float sx = x;
        float sy = y + 13;
        float t = MathHelper.clamp((float) ((value - min) / (max - min)), 0f, 1f);
        MorzhSmoothRenderer.roundedRect(context, sx, sy, w, 4, 2, 0xFF1C1C1F);
        MorzhSmoothRenderer.roundedRect(context, sx, sy, w * t, 4, 2, 0xFF808496);
        MorzhSmoothRenderer.circle(context, sx + w * t, sy + 2, 3.5f, 0xFFE8E8EC);
        rows.add(new Row(sx, sy - 4, w, 12, null, set, min, max));
        return y + ROW_H;
    }

    private float colorRow(DrawContext context, float y, String label, SettingColor color) {
        float x = cardX + 8;
        MorzhSmoothRenderer.text(context, label, x, y + 6, HudChrome.MUTED, false, 0.70);
        int packed = (color.a << 24) | (color.r << 16) | (color.g << 8) | color.b;
        MorzhSmoothRenderer.roundedRect(context, x + cardW - 16 - 22, y + 5, 22, 12, 3, packed);
        return y + ROW_H;
    }

    private List<Setting<?>> visibleSettings(HudElement el) {
        List<Setting<?>> out = new ArrayList<>();
        for (SettingGroup group : el.settings) {
            for (Setting<?> setting : group) {
                if (!setting.isVisible()) continue;
                if ("scale".equals(setting.name)) continue;
                if (setting instanceof BoolSetting || setting instanceof EnumSetting || setting instanceof DoubleSetting
                    || setting instanceof IntSetting || setting instanceof ColorSetting) {
                    out.add(setting);
                }
            }
        }
        return out;
    }

    private String chipName(HudElement element) {
        return switch (element.info.name) {
            case "watermark" -> "Ватермарка";
            case "coords" -> "Координаты";
            case "key-binds" -> "Хоткеи";
            case "potion-timers" -> "Эффекты";
            case "staff-board" -> "Стафф";
            case "notify" -> "Алерты";
            case "armor" -> "Броня";
            case "pvp-resources" -> "Предметы";
            case "cooldowns" -> "КД";
            case "kill-stats" -> "Статистика";
            case "target" -> "Таргет";
            case "inventory" -> "Инвентарь";
            case "player-model" -> "Модель";
            case "text" -> "Текст";
            default -> element.info.title;
        };
    }

    private double[] scaleMouse(double mouseX, double mouseY) {
        double s = mc.getWindow().getScaleFactor();
        return new double[] { mouseX * s, mouseY * s };
    }

    private boolean in(double x, double y, float rx, float ry, float rw, float rh) {
        return x >= rx && x <= rx + rw && y >= ry && y <= ry + rh;
    }

    private boolean handleUiClick(double x, double y) {
        if (in(x, y, plusX, plusY, PLUS, PLUS)) {
            catalogOpen = !catalogOpen;
            MorzhHudSounds.playBoolean();
            return true;
        }
        if (catalogOpen) {
            for (CatRow row : catalog) {
                if (in(x, y, row.x, row.y, row.w, row.h)) {
                    addFromCatalog(row.info);
                    return true;
                }
            }
            if (in(x, y, catX, catY, catW, catH)) return true;
            catalogOpen = false;
            return true;
        }
        for (Chip chip : chips) {
            if (in(x, y, chip.x, chip.y, chip.w, chip.h)) {
                chip.element.toggle();
                focused = chip.element;
                MorzhHudSounds.playElementToggle();
                return true;
            }
        }
        if (focused != null && in(x, y, cardX, cardY, cardW, cardH)) {
            for (Row row : rows) {
                if (!in(x, y, row.x, row.y, row.w, row.h)) continue;
                if (row.click != null) {
                    row.click.run();
                    return true;
                }
                if (row.slider != null) {
                    sliding = row;
                    applySlider(row, x);
                    return true;
                }
            }
            return true;
        }
        return false;
    }

    private void applySlider(Row row, double x) {
        float t = MathHelper.clamp((float) ((x - row.x) / row.w), 0f, 1f);
        row.slider.accept(row.min + t * (row.max - row.min));
    }

    @Override
    public boolean mouseClicked(double mouseX, double mouseY, int button) {
        double[] scaled = scaleMouse(mouseX, mouseY);
        double sx = scaled[0];
        double sy = scaled[1];

        if (button == GLFW.GLFW_MOUSE_BUTTON_LEFT && handleUiClick(sx, sy)) return true;

        if (button == GLFW.GLFW_MOUSE_BUTTON_LEFT) {
            HudElement hovered = getHovered((int) sx, (int) sy);
            focused = hovered;
            if (hovered != null) MorzhHudSounds.playElementSelect();
        }

        return super.mouseClicked(mouseX, mouseY, button);
    }

    @Override
    public boolean mouseDragged(double mouseX, double mouseY, int button, double deltaX, double deltaY) {
        if (sliding != null && button == GLFW.GLFW_MOUSE_BUTTON_LEFT) {
            applySlider(sliding, scaleMouse(mouseX, mouseY)[0]);
            return true;
        }
        if (button == GLFW.GLFW_MOUSE_BUTTON_LEFT && dragging && !selection.isEmpty()) {
            MorzhHudSounds.playElementDrag();
        }
        return super.mouseDragged(mouseX, mouseY, button, deltaX, deltaY);
    }

    @Override
    public boolean mouseReleased(double mouseX, double mouseY, int button) {
        sliding = null;

        double[] scaled = scaleMouse(mouseX, mouseY);
        double sx = scaled[0];
        double sy = scaled[1];

        if (!moved && button == GLFW.GLFW_MOUSE_BUTTON_LEFT) {
            HudElement hovered = getHovered((int) sx, (int) sy);
            if (hovered != null) focused = hovered;
        }

        if (button == GLFW.GLFW_MOUSE_BUTTON_LEFT) {
            if (addedHoveredToSelectionWhenClickedElement != null) {
                selection.remove(addedHoveredToSelectionWhenClickedElement);
                addedHoveredToSelectionWhenClickedElement = null;
            }
            snapper.unsnap();
            moved = dragging = false;
            pressed = false;
        }

        return true;
    }

    @Override
    public boolean mouseScrolled(double mouseX, double mouseY, double horizontalAmount, double verticalAmount) {
        double[] scaled = scaleMouse(mouseX, mouseY);
        HudElement target = focused != null ? focused : getHovered((int) scaled[0], (int) scaled[1]);
        if (target instanceof HudScalableElement scalable) {
            scalable.adjustScale(verticalAmount * 0.08);
            focused = target;
            MorzhHudSounds.playSidebarScroll();
            return true;
        }
        return super.mouseScrolled(mouseX, mouseY, horizontalAmount, verticalAmount);
    }

    @Override
    public boolean keyPressed(int keyCode, int scanCode, int modifiers) {
        if (keyCode == GLFW.GLFW_KEY_ESCAPE && catalogOpen) {
            catalogOpen = false;
            return true;
        }
        if (focused instanceof HudScalableElement scalable) {
            if (keyCode == GLFW.GLFW_KEY_EQUAL || keyCode == GLFW.GLFW_KEY_KP_ADD) {
                scalable.adjustScale(0.1);
                MorzhHudSounds.playBoolean();
                return true;
            }
            if (keyCode == GLFW.GLFW_KEY_MINUS || keyCode == GLFW.GLFW_KEY_KP_SUBTRACT) {
                scalable.adjustScale(-0.1);
                MorzhHudSounds.playBoolean();
                return true;
            }
        }
        return super.keyPressed(keyCode, scanCode, modifiers);
    }

    private record Chip(HudElement element, float x, float y, float w, float h) {}

    private record CatRow(HudElementInfo<?> info, float x, float y, float w, float h) {}

    private record Row(float x, float y, float w, float h, Runnable click, DoubleConsumer slider, double min, double max) {}
}


