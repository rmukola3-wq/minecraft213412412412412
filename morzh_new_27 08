        NbtList modulesTag = tag.getList("modules", 10);
        for (NbtElement moduleTagI : modulesTag) {
            NbtCompound moduleTag = (NbtCompound) moduleTagI;
            String name = moduleTag.getString("name");
            Module module = get(name);
            if (module == null && name.equalsIgnoreCase("kill-aura")) module = get(KillAura.class);
            if (module == null && name.equalsIgnoreCase("expensive-aura")) module = get(ExpensiveAura.class);
