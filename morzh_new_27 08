        return (na << 24) | (argb & 0x00FFFFFF);
    }

    public int chatBackground(int argb) {
        return chatOn() ? tint(argb, chatOpacity.get()) : argb;
    }

    public int scoreboardBackground(int argb) {
        return scoreboardOn() ? tint(argb, scoreboardOpacity.get()) : argb;
    }

    public float bossBackgroundAlpha() {
        return bossOn() ? bossOpacity.get().floatValue() : 1f;
    }

    public void pushChat(DrawContext context) {
        if (!chatOn()) return;
        MatrixStack m = context.getMatrices();
        m.push();
        float x = chatX.get().floatValue();
        float y = chatY.get().floatValue();
        float s = chatScale.get().floatValue();
        m.translate(x, y, 0);
        m.scale(s, s, 1f);
    }

    public void popChat(DrawContext context) {
        context.getMatrices().pop();
    }

    public void pushScoreboard(DrawContext context) {
        if (!scoreboardOn()) return;
        MatrixStack m = context.getMatrices();
        m.push();
        float s = scoreboardScale.get().floatValue();
        float w = context.getScaledWindowWidth();
        m.translate(w + scoreboardX.get().floatValue(), scoreboardY.get().floatValue(), 0);
        m.scale(s, s, 1f);
        m.translate(-w, 0, 0);
    }

    public void popScoreboard(DrawContext context) {
        context.getMatrices().pop();
    }

    public void pushBoss(DrawContext context) {
        if (!bossOn()) return;
        MatrixStack m = context.getMatrices();
        m.push();
        float s = bossScale.get().floatValue();
        float cx = context.getScaledWindowWidth() / 2f;
        float y = 12f + bossY.get().floatValue();
        m.translate(cx, y, 0);
        m.scale(s, s, 1f);
        m.translate(-cx, -12f, 0);
    }

    public void popBoss(DrawContext context) {
        context.getMatrices().pop();
    }
}


