/**
 * Full port of Rasty FakePlayer settings and behaviour.
 */
public class FakePlayer extends Module {
    public enum Name {
        FakePlayer,
        TargetDummy,
        Bot,
        NPC,
        Player123
    }

    private static final List<List<String>> HIT_PHRASES = List.of(
        List.of("Ай!", "Ой...", "Хм.", "Больно же!"),
        List.of("Эй, ты чего?!", "Больно!", "Хватит бить!"),
        List.of("Стоп!", "Серьёзно?!", "Ты нормальный вообще?"),
        List.of("Да хватит уже!", "Больно!", "Остановись!"),
        List.of("Стоп", "Иди отсюда", "Ща как дам сдачи")
    );

    private final SettingGroup sg = settings.getDefaultGroup();

    public final Setting<Name> name = sg.add(new EnumSetting.Builder<Name>()
        .name("имя")
        .description("Имя фейк игрока")
        .defaultValue(Name.FakePlayer)
        .build()
    );

    public final Setting<Boolean> copyInv = sg.add(new BoolSetting.Builder()
        .name("копировать-инвентарь")
        .description("Копировать предметы игрока")
        .defaultValue(true)
        .build()
    );

    private final Setting<Boolean> autoTotem = sg.add(new BoolSetting.Builder()
        .name("авто-тотем")
        .description("Тотем в оффхенд")
        .defaultValue(true)
        .build()
    );

    private final Setting<Boolean> effects = sg.add(new BoolSetting.Builder()
        .name("эффекты")
        .description("Реген, Абсорбция, Сопротивление")
        .defaultValue(true)
        .build()
    );

    private final Setting<Boolean> chatReactions = sg.add(new BoolSetting.Builder()
        .name("реакции-в-чат")
        .description("Писать фразы в чат при ударе")
        .defaultValue(false)
        .build()
    );

    private final Setting<Boolean> record = sg.add(new BoolSetting.Builder()
        .name("запись")
        .description("Записывать движения игрока")
        .defaultValue(false)
        .build()
    );

    private final Setting<Boolean> play = sg.add(new BoolSetting.Builder()
        .name("воспроизведение")
        .description("Воспроизводить записанные движения")
        .defaultValue(false)
        .visible(() -> !record.get())
        .build()
    );

    private final Setting<Integer> respawnDelay = sg.add(new IntSetting.Builder()
        .name("задержка-респавна")
        .description("Тики до респавна")
        .defaultValue(20)
        .min(10)
        .sliderMax(100)
        .build()
    );

    public static FakePlayerEntity fakePlayer;

    private int hitCount;
    private int deathTime;
    private int movementTick;
    private final List<PlayerState> positions = new ArrayList<>();

    public FakePlayer() {
        super(Categories.Player, "fake-player", "Фейк игрок для тестов (Rasty).");
    }

    @Override
    public void onActivate() {
        spawnFakePlayer();
    }

    @Override
    public void onDeactivate() {
        removeFakePlayer();
        positions.clear();
        deathTime = 0;
        movementTick = 0;
        hitCount = 0;
    }

    @EventHandler
    private void onTick(TickEvent.Pre event) {
        if (mc.player == null || mc.world == null) return;

        if (record.get()) {
            positions.add(new PlayerState(
                mc.player.getX(), mc.player.getY(), mc.player.getZ(),
                mc.player.getYaw(), mc.player.getPitch()
            ));
            if (positions.size() > 2000) positions.removeFirst();
            return;
        }

        if (fakePlayer == null) return;

        if (play.get() && !positions.isEmpty()) {
            movementTick++;
            if (movementTick >= positions.size()) movementTick = 0;
            PlayerState state = positions.get(movementTick);
            Vec3d pos = new Vec3d(state.x, state.y, state.z);
            fakePlayer.setYaw(state.yaw);
            fakePlayer.setPitch(state.pitch);
            fakePlayer.setHeadYaw(state.yaw);
            fakePlayer.setPosition(pos);
        } else {
            movementTick = 0;
        }

        if (autoTotem.get() && !fakePlayer.getOffHandStack().isOf(Items.TOTEM_OF_UNDYING)) {
            fakePlayer.setStackInHand(Hand.OFF_HAND, new ItemStack(Items.TOTEM_OF_UNDYING));
        }

        if (fakePlayer.isDead() || fakePlayer.getHealth() <= 0.0f) {
            deathTime++;
            if (deathTime > respawnDelay.get()) {
                removeFakePlayer();
                deathTime = 0;
                hitCount = 0;
                spawnFakePlayer();
            }
        }
    }

    @EventHandler
    private void onAttack(AttackEntityEvent event) {
        if (fakePlayer == null || mc.player == null || mc.world == null) return;
        if (event.entity != fakePlayer || fakePlayer.hurtTime != 0) return;

        mc.world.playSound(mc.player, fakePlayer.getX(), fakePlayer.getY(), fakePlayer.getZ(),
            SoundEvents.ENTITY_PLAYER_HURT, SoundCategory.PLAYERS, 1f, 1f);

        if (mc.player.fallDistance > 0) {
            mc.world.playSound(mc.player, fakePlayer.getX(), fakePlayer.getY(), fakePlayer.getZ(),
                SoundEvents.ENTITY_PLAYER_ATTACK_CRIT, SoundCategory.PLAYERS, 1f, 1f);
        }

        fakePlayer.onDamaged(mc.world.getDamageSources().generic());

        if (chatReactions.get()) {
            int phase = Math.min(hitCount / 2, HIT_PHRASES.size() - 1);
            List<String> phrases = HIT_PHRASES.get(phase);
            String phrase = phrases.get((int) (Math.random() * phrases.size()));
            mc.inGameHud.getChatHud().addMessage(Text.literal("<" + fakePlayer.getName().getString() + "> " + phrase));
            hitCount++;
        }

        float newHp = fakePlayer.getHealth() + fakePlayer.getAbsorptionAmount() - getDamage();
        fakePlayer.setHealth(newHp);

        if (newHp <= 0.0f || fakePlayer.isDead()) {
            if (!tryUseTotem()) fakePlayer.setHealth(0.0f);
        }
    }

    @EventHandler
    private void onPacket(PacketEvent.Receive event) {
        if (fakePlayer == null || mc.world == null) return;
        if (!(event.packet instanceof ExplosionS2CPacket explosion)) return;
        if (fakePlayer.hurtTime != 0) return;

        fakePlayer.onDamaged(mc.world.getDamageSources().generic());
        float newHp = fakePlayer.getHealth() + fakePlayer.getAbsorptionAmount() - calcExplosionDamage(explosion.center());
        fakePlayer.setHealth(newHp);
        if (newHp <= 0.0f || fakePlayer.isDead()) {
            if (!tryUseTotem()) fakePlayer.setHealth(0.0f);
        }
    }

    private void spawnFakePlayer() {
        if (mc.player == null || mc.world == null) return;
        FakePlayerManager.clear();
        FakePlayerManager.add(name.get().name(), 20, copyInv.get(), 0);
        fakePlayer = FakePlayerManager.get(name.get().name());
        if (fakePlayer == null) return;

        fakePlayer.copyPositionAndRotation(mc.player);
        fakePlayer.setHealth(20.0f);

        if (effects.get()) {
            fakePlayer.addStatusEffect(new StatusEffectInstance(StatusEffects.REGENERATION, 9999, 2));
            fakePlayer.addStatusEffect(new StatusEffectInstance(StatusEffects.ABSORPTION, 9999, 4));
            fakePlayer.addStatusEffect(new StatusEffectInstance(StatusEffects.RESISTANCE, 9999, 1));
        }

        if (autoTotem.get()) {
            fakePlayer.setStackInHand(Hand.OFF_HAND, new ItemStack(Items.TOTEM_OF_UNDYING));
        }
    }

    private void removeFakePlayer() {
        FakePlayerManager.clear();
        fakePlayer = null;
    }

    private float getDamage() {
        ItemStack weapon = mc.player.getMainHandStack();
        float base = weapon.isEmpty() ? 1.0f : 6.0f;
        if (mc.player.fallDistance > 0) base *= 1.5f;
        return base;
    }

    private float calcExplosionDamage(Vec3d explosionPos) {
        double distance = fakePlayer.getPos().distanceTo(explosionPos);
        float power = 6.0f;
        float exposure = (float) Math.max(0.0, 1.0 - distance / (power * 2.0f));
        return (exposure * exposure + exposure) / 2.0f * 7.0f * power * 2.0f + 1.0f;
    }

    private boolean tryUseTotem() {
        if (fakePlayer == null) return false;
        ItemStack offhand = fakePlayer.getOffHandStack();
        if (!offhand.isOf(Items.TOTEM_OF_UNDYING)) return false;

        offhand.decrement(1);
        fakePlayer.clearStatusEffects();
        fakePlayer.setHealth(1.0f);
        fakePlayer.setAbsorptionAmount(Math.max(fakePlayer.getAbsorptionAmount(), 8.0f));
        fakePlayer.addStatusEffect(new StatusEffectInstance(StatusEffects.REGENERATION, 900, 1));
        fakePlayer.addStatusEffect(new StatusEffectInstance(StatusEffects.ABSORPTION, 100, 1));
        fakePlayer.addStatusEffect(new StatusEffectInstance(StatusEffects.FIRE_RESISTANCE, 800, 0));
        mc.world.sendEntityStatus(fakePlayer, (byte) 35);
        return true;
    }

    public FakePlayerEntity getFakePlayer() {
        return fakePlayer;
    }

    @Override
    public String getInfoString() {
        return name.get().name();
    }

    private record PlayerState(double x, double y, double z, float yaw, float pitch) {}
}


