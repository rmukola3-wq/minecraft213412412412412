package meteordevelopment.meteorclient.gui.morzh.dropdown.settings;

import meteordevelopment.meteorclient.gui.morzh.dropdown.DropDownBindTracker;
import meteordevelopment.meteorclient.gui.morzh.dropdown.DropDownColors;
import meteordevelopment.meteorclient.gui.morzh.dropdown.DropDownComponent;
import meteordevelopment.meteorclient.gui.morzh.dropdown.DropDownDraw;
import meteordevelopment.meteorclient.gui.utils.CharFilter;
import meteordevelopment.meteorclient.settings.StringSetting;
import net.minecraft.client.MinecraftClient;
import net.minecraft.client.gui.DrawContext;
import net.minecraft.client.gui.screen.Screen;
import org.lwjgl.glfw.GLFW;

import java.util.ArrayList;
import java.util.List;

public class DropDownStringComponent extends DropDownComponent implements DropDownBindTracker {
    private final StringSetting setting;
    private boolean typing;

    public DropDownStringComponent(StringSetting setting) {
        this.setting = setting;
        setHeight(24);
    }

    @Override
    public boolean isBinding() {
        return typing;
    }

    @Override
    public void measure(float width) {
        super.measure(width);
        float boxW = width - 9;
        String draw = setting.get();
        if ((draw == null || draw.isEmpty()) && setting.description != null && !setting.description.isEmpty()) {
            draw = setting.description;
        }
        if (draw == null) draw = "";
        float h = Math.max(8, calculateHeight(draw, boxW - 1));
        setHeight(h + 12);
    }

    @Override
    public void render(DrawContext context, float mouseX, float mouseY) {
        float x = getX() + 5;
        float y = getY() + 10;
        float w = getWidth() - 9;

        String draw = setting.get();
        if (!typing && (draw == null || draw.isEmpty()) && setting.description != null && !setting.description.isEmpty()) {
            draw = setting.description;
        }
        if (draw == null) draw = "";
        if (typing && draw.length() < 59 && System.currentTimeMillis() % 1000 > 500) draw += "_";

        float h = Math.max(8, calculateHeight(draw.replace("_", ""), w - 1));

        DropDownDraw.text(context, setting.title, x, y - 7, DropDownColors.WHITE, 6);
        DropDownDraw.rounded(context, x, y, w, h, 4, DropDownColors.STRING_BG);
        drawWrapped(context, draw, x + 1, y + DropDownDraw.textHeight(6) / 2, w - 1);

        if (isHovered(mouseX, mouseY) && DropDownDraw.hovered(mouseX, mouseY, x, y, w, h)) {
            DropDownDraw.cursorIbeam();
        }
    }

    @Override
    public void charTyped(char codePoint, int modifiers) {
        if (!typing || setting.get().length() >= 60) return;
        if (codePoint < 32) return;

        CharFilter filter = setting.filter;
        if (filter != null && !filter.filter(setting.get(), codePoint)) return;

        setting.set(setting.get() + codePoint);
    }

    @Override
    public void keyPressed(int key, int scanCode, int modifiers) {
        if (!typing) return;

        if (Screen.isPaste(key)) {
            String clip = MinecraftClient.getInstance().keyboard.getClipboard();
            if (clip != null) {
                String next = setting.get() + clip;
                if (next.length() > 60) next = next.substring(0, 60);
                setting.set(next);
            }
            return;
        }

        if (key == GLFW.GLFW_KEY_BACKSPACE) {
            String text = setting.get();
            if (!text.isEmpty()) setting.set(text.substring(0, text.length() - 1));
            return;
        }

        if (key == GLFW.GLFW_KEY_ENTER || key == GLFW.GLFW_KEY_ESCAPE) {
            typing = false;
        }
    }

    @Override
    public void mouseClick(float mouseX, float mouseY, int button) {
        typing = isHovered(mouseX, mouseY);
    }

    private void drawWrapped(DrawContext context, String text, float x, float y, float maxWidth) {
        float currentY = y;
        for (String line : wrap(text, 6, maxWidth)) {
            DropDownDraw.text(context, line, x, currentY, DropDownColors.rgba(255, 255, 255, 64), 6);
            currentY += DropDownDraw.textHeight(6);
        }
    }

    private float calculateHeight(String text, float maxWidth) {
        List<String> lines = wrap(text == null || text.isEmpty() ? " " : text, 6, maxWidth);
        return 5 + lines.size() * DropDownDraw.textHeight(6);
    }

    private List<String> wrap(String text, float size, float maxWidth) {
        List<String> lines = new ArrayList<>();
        if (text == null || text.isEmpty()) {
            lines.add("");
            return lines;
        }

        StringBuilder current = new StringBuilder();
        for (int i = 0; i < text.length(); i++) {
            char c = text.charAt(i);
            if (c == '\n') {
                lines.add(current.toString());
                current = new StringBuilder();
                continue;
            }
            String next = current.toString() + c;
            if (DropDownDraw.textWidth(next, size) <= maxWidth) {
                current.append(c);
            } else {
                if (!current.isEmpty()) lines.add(current.toString());
                current = new StringBuilder(String.valueOf(c));
            }
        }
        lines.add(current.toString());
        return lines;
    }

    @Override
    public boolean isVisible() {
        return setting.isVisible();
    }
}


