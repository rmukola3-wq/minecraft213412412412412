package meteordevelopment.meteorclient.gui.morzh.dropdown.settings;

import meteordevelopment.meteorclient.gui.morzh.dropdown.DropDownColors;
import meteordevelopment.meteorclient.gui.morzh.dropdown.DropDownComponent;
import meteordevelopment.meteorclient.gui.morzh.dropdown.DropDownDraw;
import meteordevelopment.meteorclient.settings.DoubleSetting;
import meteordevelopment.meteorclient.settings.IntSetting;
import meteordevelopment.meteorclient.settings.Setting;
import net.minecraft.client.gui.DrawContext;
import net.minecraft.util.math.MathHelper;

import java.util.Locale;

public class DropDownSliderComponent extends DropDownComponent {
    private final Setting<? extends Number> setting;
    private final double sliderMin;
    private final double sliderMax;
    private final double absMin;
    private final double absMax;
    private final double increment;
    private final int decimals;
    private final boolean integer;
    private final boolean noSlider;

    private float anim;
    private boolean drag;

    public DropDownSliderComponent(DoubleSetting setting) {
        this.setting = setting;
        this.sliderMin = setting.sliderMin;
        this.sliderMax = setting.sliderMax;
        this.absMin = setting.min;
        this.absMax = setting.max;
        this.decimals = Math.max(0, setting.decimalPlaces);
        this.increment = Math.pow(10, -decimals);
        this.integer = false;
        this.noSlider = setting.noSlider;
        setHeight(18);
    }

    public DropDownSliderComponent(IntSetting setting) {
        this.setting = setting;
        this.sliderMin = setting.sliderMin;
        this.sliderMax = setting.sliderMax;
        this.absMin = setting.min;
        this.absMax = setting.max;
        this.decimals = 0;
        this.increment = 1;
        this.integer = true;
        this.noSlider = setting.noSlider;
        setHeight(18);
    }

    @Override
    public void render(DrawContext context, float mouseX, float mouseY) {
        String valueText = format(setting.get().doubleValue());

        DropDownDraw.text(context, setting.title, getX() + 5, getY() + 4.5f / 2f + 1, DropDownColors.TEXT, 7f);
        DropDownDraw.text(
            context,
            valueText,
            getX() + getWidth() - 5 - DropDownDraw.textWidth(valueText, 7f),
            getY() + 4.5f / 2f + 1,
            DropDownColors.TEXT,
            7f
        );

        double min = sliderMin;
        double max = sliderMax;
        if (max <= min) {
            min = absMin;
            max = absMax;
        }
        if (max <= min) max = min + 1;

        double value = MathHelper.clamp(setting.get().doubleValue(), min, max);
        float target = (float) ((getWidth() - 10) * (value - min) / (max - min));
        anim = DropDownDraw.fast(anim, target, 20);

        DropDownDraw.rounded(context, getX() + 5, getY() + 11, getWidth() - 10, 2, 0.6f, DropDownColors.SLIDER_TRACK);
        DropDownDraw.rounded(context, getX() + 5, getY() + 11, anim, 2, 0.6f, DropDownColors.SLIDER_FILL);
        DropDownDraw.circle(context, getX() + 5 + anim, getY() + 12, 5, DropDownColors.SLIDER_FILL);
        DropDownDraw.shadowCircle(context, getX() + 5 + anim, getY() + 12, 6, DropDownColors.rgba(128, 132, 150, 64));

        if (drag) {
            DropDownDraw.cursorResize();
            apply(mouseX, min, max);
        } else if (isHovered(mouseX, mouseY) && DropDownDraw.hovered(mouseX, mouseY, getX() + 5, getY() + 10, getWidth() - 10, 3)) {
            DropDownDraw.cursorResize();
        }
    }

    @Override
    public void mouseClick(float mouseX, float mouseY, int button) {
        if (DropDownDraw.hovered(mouseX, mouseY, getX() + 5, getY() + 10, getWidth() - 10, 3)) {
            drag = true;
            meteordevelopment.meteorclient.utils.sound.MorzhSoundManager.playScroll();
        }
    }

    @Override
    public void mouseRelease(float mouseX, float mouseY, int button) {
        drag = false;
    }

    @SuppressWarnings("unchecked")
    private void apply(float mouseX, double min, double max) {
        double raw = (mouseX - getX() - 5) / (getWidth() - 10) * (max - min) + min;
        raw = DropDownDraw.round(raw, increment);
        raw = MathHelper.clamp(raw, absMin, absMax);

        if (integer) {
            ((Setting<Integer>) setting).set((int) Math.round(raw));
        } else {
            ((Setting<Double>) setting).set(raw);
        }
    }

    private String format(double value) {
        if (integer) return Integer.toString((int) Math.round(value));
        return String.format(Locale.US, "%." + decimals + "f", value);
    }

    @Override
    public boolean isVisible() {
        return setting.isVisible();
    }
}


