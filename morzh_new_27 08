    private void onGrimSend(PacketEvent.Send event) {
        if (mc.player == null || mc.player.networkHandler == null) {
            grimCleanup();
            return;
        }

        boolean busy = grimBusy();

        if (event.packet instanceof ClickSlotC2SPacket click) {
            if (!grimInPlayerInv()) return;
        if (click.getActionType() == SlotActionType.PICKUP_ALL
            || (click.getButton() == 1 && click.getActionType() == SlotActionType.PICKUP)) {
            if (busy || !grimQueued.isEmpty() || grimPhase >= 0) {
                event.cancel();
                return;
            }
        }
            if (busy || !grimQueued.isEmpty() || grimPhase >= 0) {
                grimQueued.add(click);
                event.cancel();
            }
            return;
        }

        if (event.packet instanceof CloseHandledScreenC2SPacket close) {
            int sync = ((CloseHandledScreenC2SPacketAccessor) close).getSyncId();
            if (busy || !grimQueued.isEmpty() || grimPhase >= 0) {
                event.cancel();
                if (grimPhase < 0) startGrimStop(sync);
                else if (grimCloseSync < 0) grimCloseSync = sync;
            }
            return;
        }

        if (grimPhase < 0) return;

        if (event.packet instanceof PlayerInputC2SPacket) {
            event.cancel();
            sendSilent(new PlayerInputC2SPacket(new PlayerInput(false, false, false, false, false, false, false)));
            return;
        }

        if (event.packet instanceof HandSwingC2SPacket
            || event.packet instanceof PlayerInteractEntityC2SPacket
            || event.packet instanceof PlayerInteractItemC2SPacket
            || event.packet instanceof PlayerInteractBlockC2SPacket) {
            event.cancel();
        }
    }

    private void onGrimTick() {
        boolean inMoveGui = mc.currentScreen instanceof InventoryScreen
            || mc.currentScreen instanceof WidgetScreen
            || mc.currentScreen instanceof CreativeInventoryScreen;

        if (grimPhase < 0) {
            if (!inMoveGui && !grimQueued.isEmpty() && mc.player.currentScreenHandler != null) {
                startGrimStop(mc.player.currentScreenHandler.syncId);
            }
            return;
        }

        lockMovementKeys();
        if (mc.player.isSprinting()) {
            mc.player.setSprinting(false);
        }

        switch (grimPhase) {
            case 0 -> {
                sendGrimStopPackets();
                grimPhase = 1;
                grimWait = 0;
            }
            case 1 -> {
                grimWait++;
                if (!mc.player.isSprinting() && grimWait >= 1) grimPhase = 2;
                else if (grimWait >= 3) grimPhase = 2;
            }
            case 2 -> {
                for (Packet<?> packet : grimQueued) {
                    if (!(packet instanceof CloseHandledScreenC2SPacket)) sendSilent(packet);
                }
                grimQueued.removeIf(packet -> !(packet instanceof CloseHandledScreenC2SPacket));
                grimPhase = 3;
            }
            case 3 -> {
                int sync = grimCloseSync >= 0 ? grimCloseSync : mc.player.currentScreenHandler.syncId;
                sendSilent(new CloseHandledScreenC2SPacket(sync));
                grimQueued.clear();
                if (mc.currentScreen != null) mc.setScreen(null);
                unlockMovementKeys();
                restoreGrimSprint();
                grimCleanup();
            }
        }
    }

    private void startGrimStop(int sync) {
        grimPhase = 0;
        grimWait = 0;
        grimCloseSync = sync;
        grimResumeSprint = mc.player.isSprinting()
            || Input.isPressed(mc.options.sprintKey)
            || Input.isPressed(mc.options.forwardKey);
        lockMovementKeys();
        sendGrimStopPackets();
