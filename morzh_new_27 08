                if (look == Profile.Punch && player == mc.player && mc.options.getPerspective().isFirstPerson()) continue;
                Vec3d pos = new Vec3d(
                    MathHelper.lerp(event.tickDelta, player.prevX, player.getX()),
                    MathHelper.lerp(event.tickDelta, player.prevY, player.getY()),
                    MathHelper.lerp(event.tickDelta, player.prevZ, player.getZ())
                );
                List<Sample> list = trails.computeIfAbsent(player.getUuid(), id -> new ArrayList<>());
                if (!list.isEmpty() && list.getLast().pos.squaredDistanceTo(pos) > 36) list.clear();
                if (list.isEmpty() || list.getLast().pos.squaredDistanceTo(pos) > 0.0025) {
                    list.add(new Sample(pos, now, playerColor(player)));
