        .build()
    );

    private final Setting<Integer> fireworkDelay = sgRocket.add(new IntSetting.Builder()
        .name("задержка-фейерверка")
        .description("Тики между ракетами")
        .defaultValue(10)
        .range(4, 40)
        .sliderRange(4, 20)
        .build()
    );

    private final Setting<Boolean> fireworkWhenSlow = sgRocket.add(new BoolSetting.Builder()
        .name("фейерверк-при-замедлении")
        .defaultValue(true)
        .build()
    );

    private final Setting<Boolean> stopOnEat = sgRocket.add(new BoolSetting.Builder()
        .name("стопать-при-еде")
        .defaultValue(true)
        .build()
    );

    private int fireworkTicks;
    private int jumpTicks;
    private boolean swappedElytra;
    private boolean warnedNoElytra;
    private boolean warnedNoFirework;
    private boolean warnedNoSlot;
    private boolean warnedNoTarget;
    private LivingEntity heldTarget;
    private int heldTicks;

    public ElytraTarget() {
        super(Categories.Movement, "elytra-target", "Включил — летит на цель ауры. Фейерверк сам кладётся в пустой слот.");
    }

    public static ElytraTarget getInstance() {
        Modules modules = Modules.get();
        return modules == null ? null : modules.get(ElytraTarget.class);
    }

    public boolean isState() {
        return isActive();
    }

    public boolean isChasing() {
        return isActive() && shouldElytraTarget;
    }

    public float getElytraFindRange() {
        return elytraFindRange.get().floatValue();
    }

    public float getElytraForward() {
        return elytraForward.get().floatValue();
    }

    @Override
    public void onActivate() {
        shouldElytraTarget = true;
        fireworkTicks = 0;
        jumpTicks = 0;
        swappedElytra = false;
        warnedNoElytra = false;
        warnedNoFirework = false;
        warnedNoSlot = false;
        warnedNoTarget = false;
        heldTarget = null;
        heldTicks = 0;
        tryEquipElytra();
        parkFirework();
    }

    @Override
    public void onDeactivate() {
        shouldElytraTarget = false;
        stopChase();
        heldTarget = null;
    }

    @EventHandler
    private void onKey(KeyEvent e) {
        if (e.action != KeyAction.Press) return;
        if (!pauseBind.get().matches(true, e.key, e.modifiers)) return;
        togglePause();
    }

    @EventHandler
    private void onMouse(MouseButtonEvent e) {
        if (e.action != KeyAction.Press) return;
        if (!pauseBind.get().matches(false, e.button, 0)) return;
        togglePause();
    }

    private void togglePause() {
        shouldElytraTarget = !shouldElytraTarget;
        MorzhSoundManager.playModuleState(shouldElytraTarget);
        if (!shouldElytraTarget) stopChase();
    }

    @EventHandler
    private void onTick(TickEvent.Pre e) {
        if (!isActive() || mc.player == null || mc.world == null || mc.getNetworkHandler() == null) return;
        if (!shouldElytraTarget) return;
        if (fireworkTicks > 0) fireworkTicks--;

        LivingEntity target = resolveTarget();
        if (target == null) {
            if (!warnedNoTarget) {
                warning("Нет цели. Включи основную ауру и посмотри на игрока.");
                warnedNoTarget = true;
            }
            return;
        }
        warnedNoTarget = false;

        if (!isElytraCurrentlyEquipped()) {
            tryEquipElytra();
            if (!isElytraCurrentlyEquipped()) return;
        }

        if (!mc.player.isGliding()) {
            takeoff();
            return;
        }

        aimAtTarget(target);
        if (stopOnEat.get() && mc.player.isUsingItem()) return;
        tryFirework();
    }

    private LivingEntity resolveTarget() {
        LivingEntity found = null;

        ExpensiveAura expensive = ExpensiveAura.get();
        if (expensive != null && expensive.isActive()) {
            if (alive(expensive.target())) found = expensive.target();
            else if (alive(expensive.lastTarget())) found = expensive.lastTarget();
        }

        if (found == null) {
            LivingEntity shared = CombatTargets.current();
            if (alive(shared)) found = shared;
        }

        if (found == null) {
            KillAura aura = KillAura.get();
            if (aura != null && alive(aura.getLastTarget())) found = aura.getLastTarget();
        }

        if (found != null && mc.player.distanceTo(found) <= elytraFindRange.get()) {
            heldTarget = found;
            heldTicks = 40;
            return found;
        }

        if (heldTarget != null && alive(heldTarget) && heldTicks > 0 && mc.player.distanceTo(heldTarget) <= elytraFindRange.get() + 8) {
            heldTicks--;
            return heldTarget;
        }

        heldTarget = null;
        return null;
    }

    private boolean alive(LivingEntity target) {
        return target != null && target.isAlive() && !target.isRemoved() && target != mc.player;
    }

    private void takeoff() {
        if (mc.player.isOnGround()) {
            mc.player.jump();
            jumpTicks = 0;
            return;
        }
        jumpTicks++;
        if (jumpTicks % 4 == 0) {
            mc.getNetworkHandler().sendPacket(
                new ClientCommandC2SPacket(mc.player, ClientCommandC2SPacket.Mode.START_FALL_FLYING)
            );
        }
    }

    public Vec3d aimPoint(LivingEntity target) {
        Vec3d predicted = target.getBoundingBox().getCenter().add(target.getVelocity().multiply(elytraForward.get()));
        Vec3d eye = mc.player.getEyePos();
        double dx = predicted.x - eye.x;
        double dz = predicted.z - eye.z;
        double horizontal = Math.sqrt(dx * dx + dz * dz);
        double nx = horizontal == 0 ? 0 : dx / horizontal;
        double nz = horizontal == 0 ? 0 : dz / horizontal;
        double lift = Math.max(0.0, 2.5 - groundClearance());
        double lead = mc.player.distanceTo(target) < 5 ? 1.5 : 3.5;
        return new Vec3d(predicted.x + nx * lead, predicted.y + lift, predicted.z + nz * lead);
    }

    private void aimAtTarget(LivingEntity target) {
        Vec3d pos = aimPoint(target);
        double diffX = pos.x - mc.player.getX();
        double diffY = pos.y - mc.player.getY();
        double diffZ = pos.z - mc.player.getZ();
        float yaw = (float) (MathHelper.atan2(diffZ, diffX) * (180.0 / Math.PI)) - 90.0f;
        float pitch = (float) (-(MathHelper.atan2(diffY, Math.sqrt(diffX * diffX + diffZ * diffZ)) * (180.0 / Math.PI)));
        if (groundClearance() < 2.0) pitch = Math.min(pitch, -8.0f);
        mc.player.setYaw(yaw);
        mc.player.setPitch(MathHelper.clamp(pitch, -89.0f, 89.0f));
    }

    private double groundClearance() {
        Vec3d start = mc.player.getPos();
        BlockHitResult hit = mc.world.raycast(new RaycastContext(
            start, start.subtract(0.0, 4.0, 0.0),
            RaycastContext.ShapeType.COLLIDER, RaycastContext.FluidHandling.NONE, mc.player
        ));
        if (hit.getType() == HitResult.Type.MISS) return 4.0;
        return start.y - hit.getPos().y;
    }

    private void tryFirework() {
        boolean slow = fireworkWhenSlow.get() && mc.player.getVelocity().length() < 1.45;
        if (fireworkTicks > 0 && !slow) return;
        if (slow && fireworkTicks > 2) return;
        if (!useFirework()) return;
        fireworkTicks = fireworkDelay.get();
    }

    private boolean useFirework() {
        int slot = parkFirework();
        if (slot < 0) return false;

        int previous = mc.player.getInventory().selectedSlot;
        mc.player.getInventory().selectedSlot = slot;
        mc.getNetworkHandler().sendPacket(new UpdateSelectedSlotC2SPacket(slot));
        float yaw = mc.player.getYaw();
        float pitch = mc.player.getPitch();
        try {
            ((ClientPlayerInteractionManagerInvoker) mc.interactionManager).meteor$sendSequencedPacket(
                mc.world,
                seq -> new PlayerInteractItemC2SPacket(Hand.MAIN_HAND, seq, yaw, pitch)
            );
        } catch (Throwable ignored) {
            mc.interactionManager.interactItem(mc.player, Hand.MAIN_HAND);
        }
        mc.player.getInventory().selectedSlot = previous;
        mc.getNetworkHandler().sendPacket(new UpdateSelectedSlotC2SPacket(previous));
        return true;
    }

    /** Moves a firework into an empty hotbar slot and returns that hotbar index. */
    private int parkFirework() {
        if (mc.player == null || mc.interactionManager == null) return -1;

        int existing = hotbarFireworkSlot();
        if (existing != -1) return existing;

        int dest = pickHotbarSlot();
        if (dest == -1) {
            if (!warnedNoSlot) {
                warning("Нет пустого слота в хотбаре под фейерверк.");
                warnedNoSlot = true;
            }
            return -1;
        }
        warnedNoSlot = false;

        if (mc.player.getOffHandStack().isOf(Items.FIREWORK_ROCKET)) {
            InvUtils.move().fromOffhand().toHotbar(dest);
            return dest;
        }

        FindItemResult firework = InvUtils.find(Items.FIREWORK_ROCKET);
        if (!firework.found()) {
            if (!warnedNoFirework) {
                warning("Нет фейерверков в инвентаре.");
                warnedNoFirework = true;
            }
            return -1;
        }
        warnedNoFirework = false;
        InvUtils.move().from(firework.slot()).toHotbar(dest);
        return dest;
    }

    private int hotbarFireworkSlot() {
        for (int i = 0; i < 9; i++) {
            if (mc.player.getInventory().getStack(i).isOf(Items.FIREWORK_ROCKET)) return i;
        }
        return -1;
    }

    private int pickHotbarSlot() {
        int fixed = fireworkSlot.get();
        int selected = mc.player.getInventory().selectedSlot;
        if (fixed >= 1 && fixed <= 9) return fixed - 1;

        for (int i = 8; i >= 0; i--) {
            if (i == selected) continue;
            if (mc.player.getInventory().getStack(i).isEmpty()) return i;
        }
        return -1;
    }

    private void tryEquipElytra() {
        if (isElytraCurrentlyEquipped()) return;
        int elytraSlot = findChestArmorSlot(true);
        if (elytraSlot == -1) {
            if (!warnedNoElytra) {
                warning("Нет элитры в инвентаре.");
                warnedNoElytra = true;
            }
            return;
        }
        performSafeSwap(elytraSlot);
        swappedElytra = true;
    }

    private void stopChase() {
        jumpTicks = 0;
        fireworkTicks = 0;
        if (swappedElytra && isElytraCurrentlyEquipped()) {
            int chestSlot = findChestArmorSlot(false);
            if (chestSlot != -1) performSafeSwap(chestSlot);
        }
        swappedElytra = false;
    }

    private int findChestArmorSlot(boolean findElytra) {
        if (mc.player == null) return -1;
        int limit = hotbarOnly.get() ? 9 : 36;
        for (int i = 0; i < limit; i++) {
            ItemStack stack = mc.player.getInventory().getStack(i);
            EquippableComponent component = stack.get(DataComponentTypes.EQUIPPABLE);
            if (component == null || component.slot() != EquipmentSlot.CHEST) continue;
            if (findElytra) {
                if (stack.isOf(Items.ELYTRA)) return i;
            } else if (!stack.isOf(Items.ELYTRA)) {
                return i;
            }
        }
        return -1;
    }

    private boolean isElytraCurrentlyEquipped() {
        if (mc.player == null) return false;
        ItemStack chest = mc.player.getEquippedStack(EquipmentSlot.CHEST);
        return !chest.isEmpty() && chest.isOf(Items.ELYTRA);
    }

    private void performSafeSwap(int invSlot) {
        if (mc.player == null || mc.interactionManager == null) return;
        if (invSlot >= 0 && invSlot <= 8) {
            mc.interactionManager.clickSlot(mc.player.playerScreenHandler.syncId, 6, invSlot, SlotActionType.SWAP, mc.player);
            return;
        }
        int handlerSlot = invSlot < 9 ? invSlot + 36 : invSlot;
        mc.interactionManager.clickSlot(mc.player.playerScreenHandler.syncId, handlerSlot, 0, SlotActionType.PICKUP, mc.player);
        mc.interactionManager.clickSlot(mc.player.playerScreenHandler.syncId, 6, 0, SlotActionType.PICKUP, mc.player);
        mc.interactionManager.clickSlot(mc.player.playerScreenHandler.syncId, handlerSlot, 0, SlotActionType.PICKUP, mc.player);
    }

    @Override
    public String getInfoString() {
        if (!isActive()) return null;
        return shouldElytraTarget ? "Перегон" : "Пауза";
    }
}


