package meteordevelopment.meteorclient.systems.modules.combat.aura.sloth;

import meteordevelopment.meteorclient.systems.modules.combat.aura.expensive.Rotation;
import meteordevelopment.meteorclient.systems.modules.combat.aura.expensive.RotationMath;
import net.minecraft.entity.Entity;
import net.minecraft.util.math.Box;
import net.minecraft.util.math.MathHelper;
import net.minecraft.util.math.Vec3d;

import java.util.concurrent.ThreadLocalRandom;

import static meteordevelopment.meteorclient.MeteorClient.mc;

public final class SlothRotationEngine {
    private int targetId = -1;

    private float pointX = 0.5F;
    private float pointY = 0.62F;
    private float pointZ = 0.5F;

    private float driftX;
    private float driftY;
    private float driftZ;

    private float wantedDriftX;
    private float wantedDriftY;
    private float wantedDriftZ;
    private int driftTicks;

    private float speed = 0.20F;

    private float noiseYaw;
    private float noisePitch;
    private float wantedNoiseYaw;
    private float wantedNoisePitch;
    private long noiseUpdateAt;

    public void reset() {
        targetId = -1;

        pointX = 0.5F;
        pointY = 0.62F;
        pointZ = 0.5F;

        driftX = 0.0F;
        driftY = 0.0F;
        driftZ = 0.0F;

        wantedDriftX = 0.0F;
        wantedDriftY = 0.0F;
        wantedDriftZ = 0.0F;

        driftTicks = 0;
        speed = 0.20F;

        noiseYaw = 0.0F;
        noisePitch = 0.0F;
        wantedNoiseYaw = 0.0F;
        wantedNoisePitch = 0.0F;
        noiseUpdateAt = 0L;
    }

    public void onAttack() {
        // Удар не меняет точку и не создаёт отдельного паттерна.
    }

    public Vec3d randomBias() {
        return Vec3d.ZERO;
    }

    public void pulse(Entity entity) {
        if (entity == null) return;

        ThreadLocalRandom random = ThreadLocalRandom.current();
        if (entity.getId() != targetId) {
            reset();
            targetId = entity.getId();
            chooseDrift(random);
        }

        updateAimPoint(random);
        updateNoise(random, false);
    }

    public Vec3d aimPoint(Entity entity) {
        if (entity == null) return null;
        return pointOnBox(entity.getBoundingBox());
    }

    public float[] tick(
        float currentYaw,
        float currentPitch,
        Entity entity,
        boolean hitNow,
        boolean hitSoon
    ) {
        if (mc.player == null || entity == null) {
            return new float[]{currentYaw, currentPitch};
        }

        ThreadLocalRandom random = ThreadLocalRandom.current();

        if (entity.getId() != targetId) {
            reset();
            targetId = entity.getId();
            chooseDrift(random);
        }

        updateAimPoint(random);
        updateNoise(random, hitNow || hitSoon);

        Vec3d point = pointOnBox(entity.getBoundingBox());
        Rotation wanted = RotationMath.INSTANCE.fromVec3d(
            point.subtract(mc.player.getEyePos())
        );

        float yawError = MathHelper.wrapDegrees(
            wanted.getYaw() - currentYaw
        );

        float pitchError =
            wanted.getPitch() - currentPitch;

        float difference = (float) Math.hypot(
            yawError,
            pitchError
        );

        float wantedSpeed;

        if (hitNow) {
            wantedSpeed = random.nextFloat(0.60F, 0.76F);
        } else if (hitSoon) {
            wantedSpeed = random.nextFloat(0.32F, 0.48F);
        } else if (difference <= 4.0F) {
            wantedSpeed = random.nextFloat(0.055F, 0.11F);
        } else if (difference <= 15.0F) {
            wantedSpeed = random.nextFloat(0.14F, 0.27F);
        } else {
            wantedSpeed = random.nextFloat(0.22F, 0.40F);
        }

        // Не переключаем скорость мгновенно.
        speed = MathHelper.lerp(
            hitNow ? 0.46F : 0.27F,
            speed,
            wantedSpeed
        );

        boolean moving =
            mc.player.getVelocity().horizontalLengthSquared() > 0.003
                || mc.player.input != null
                && (
                    mc.player.input.movementForward != 0.0F
                        || mc.player.input.movementSideways != 0.0F
                );

        float yawCap = moving ? 16.0F : 28.0F;
        float pitchCap = moving ? 9.0F : 16.0F;

        if (hitNow) {
            yawCap = moving ? 21.0F : 36.0F;
            pitchCap = moving ? 12.0F : 21.0F;
        }

        float noiseScale =
            hitNow ? 0.12F : hitSoon ? 0.30F : 1.0F;

        float yawStep =
            yawError * speed
                + noiseYaw * noiseScale;

        float pitchStep =
            pitchError * (speed * 0.78F)
                + noisePitch * noiseScale;

        yawStep = MathHelper.clamp(
            yawStep,
            -yawCap,
            yawCap
        );

        pitchStep = MathHelper.clamp(
            pitchStep,
            -pitchCap,
            pitchCap
        );

        yawStep = preventOvershoot(yawStep, yawError);
        pitchStep = preventOvershoot(pitchStep, pitchError);

        return new float[]{
            currentYaw + yawStep,
            MathHelper.clamp(
                currentPitch + pitchStep,
                -89.9F,
                89.9F
            )
        };
    }

    private void updateAimPoint(ThreadLocalRandom random) {
        if (--driftTicks <= 0) {
            chooseDrift(random);
        }

        // Плавное изменение направления движения точки.
        driftX = MathHelper.lerp(0.14F, driftX, wantedDriftX);
        driftY = MathHelper.lerp(0.12F, driftY, wantedDriftY);
        driftZ = MathHelper.lerp(0.14F, driftZ, wantedDriftZ);

        pointX += driftX;
        pointY += driftY;
        pointZ += driftZ;

        if (pointX <= 0.24F) {
            pointX = 0.24F;
            wantedDriftX = Math.abs(wantedDriftX);
        } else if (pointX >= 0.76F) {
            pointX = 0.76F;
            wantedDriftX = -Math.abs(wantedDriftX);
        }

        if (pointY <= 0.28F) {
            pointY = 0.28F;
            wantedDriftY = Math.abs(wantedDriftY);
        } else if (pointY >= 0.88F) {
            pointY = 0.88F;
            wantedDriftY = -Math.abs(wantedDriftY);
        }

        if (pointZ <= 0.24F) {
            pointZ = 0.24F;
            wantedDriftZ = Math.abs(wantedDriftZ);
        } else if (pointZ >= 0.76F) {
            pointZ = 0.76F;
            wantedDriftZ = -Math.abs(wantedDriftZ);
        }
    }

    private void chooseDrift(ThreadLocalRandom random) {
        wantedDriftX = signed(random, 0.003F, 0.012F);
        wantedDriftY = signed(random, 0.002F, 0.009F);
        wantedDriftZ = signed(random, 0.003F, 0.012F);

        // Не позволяем новой скорости сразу вести наружу.
        if (pointX < 0.32F) wantedDriftX = Math.abs(wantedDriftX);
        if (pointX > 0.68F) wantedDriftX = -Math.abs(wantedDriftX);

        if (pointY < 0.38F) wantedDriftY = Math.abs(wantedDriftY);
        if (pointY > 0.78F) wantedDriftY = -Math.abs(wantedDriftY);

        if (pointZ < 0.32F) wantedDriftZ = Math.abs(wantedDriftZ);
        if (pointZ > 0.68F) wantedDriftZ = -Math.abs(wantedDriftZ);

        driftTicks = random.nextInt(9, 24);
    }

    private void updateNoise(
        ThreadLocalRandom random,
        boolean locking
    ) {
        long now = System.currentTimeMillis();

        if (now >= noiseUpdateAt) {
            float yawAmount = locking ? 0.10F : 0.32F;
            float pitchAmount = locking ? 0.055F : 0.16F;

            wantedNoiseYaw = random.nextFloat(
                -yawAmount,
                yawAmount
            );

            wantedNoisePitch = random.nextFloat(
                -pitchAmount,
                pitchAmount
            );

            noiseUpdateAt = now + random.nextLong(65L, 140L);
        }

        noiseYaw = MathHelper.lerp(
            0.22F,
            noiseYaw,
            wantedNoiseYaw
        );

        noisePitch = MathHelper.lerp(
            0.22F,
            noisePitch,
            wantedNoisePitch
        );
    }

    private Vec3d pointOnBox(Box box) {
        double marginX = box.getLengthX() * 0.12;
        double marginY = box.getLengthY() * 0.06;
        double marginZ = box.getLengthZ() * 0.12;

        return new Vec3d(
            MathHelper.lerp(
                pointX,
                box.minX + marginX,
                box.maxX - marginX
            ),
            MathHelper.lerp(
                pointY,
                box.minY + marginY,
                box.maxY - marginY
            ),
            MathHelper.lerp(
                pointZ,
                box.minZ + marginZ,
                box.maxZ - marginZ
            )
        );
    }

    private static float preventOvershoot(
        float step,
        float error
    ) {
        if (Math.signum(step) != Math.signum(error)) {
            return 0.0F;
        }

        if (Math.abs(step) > Math.abs(error)) {
            return error;
        }

        return step;
    }

    private static float signed(
        ThreadLocalRandom random,
        float minimum,
        float maximum
    ) {
        float value = random.nextFloat(minimum, maximum);
        return random.nextBoolean() ? value : -value;
    }
}


