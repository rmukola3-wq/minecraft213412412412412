    private BlockPos lastPlayerLight;
    private BlockPos lastTargetLight;
    private int lastPlayerPeak = -1;
    private int lastTargetPeak = -1;
    private int lastPlayerRange = -1;
    private int lastTargetRange = -1;

    private final List<Face> faces = new ArrayList<>();
    private final Color tmp = new Color();
    private GlassMesh mesh;
    private Shader glossShader;
    private Shader copyShader;
    private SimpleFramebuffer sceneFb;
    private int lastWidth;
    private int lastHeight;
