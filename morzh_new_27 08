    @Override
    public void measure(float width) {
        super.measure(width);
        String bind = bindLabel();
        float bindW = DropDownDraw.textWidth(bind, 5.5f);
        setHeight(bindW >= 16 ? 20 : 16);
    }

    @Override
    public void render(DrawContext context, float mouseX, float mouseY) {
        DropDownDraw.text(context, setting.title, getX() + 5, getY() + 6.5f / 2f + 1, DropDownColors.TEXT_SETTING, 6.5f);

        String bind = bindLabel();
        float font = 5.5f;
        float bindW = DropDownDraw.textWidth(bind, font);
        boolean next = bindW >= 16;

        float bx = next ? getX() + 5 : getX() + getWidth() - 7 - bindW;
        float by = getY() + 5.5f / 2f + (5.5f / 2f) + (next ? 8 : 0);

        DropDownDraw.rounded(context, bx - 2 + 0.5f, by - 2, bindW + 4, 5.5f + 4, 2, DropDownColors.BIND_BG);
        DropDownDraw.text(context, bind, bx, by, activated ? DropDownColors.WHITE : DropDownColors.TEXT_SETTING, font);

        if (isHovered(mouseX, mouseY) && DropDownDraw.hovered(mouseX, mouseY, bx - 2, by - 2, bindW + 4, 9.5f)) {
            DropDownDraw.cursorHand();
        }
    }

    @Override
    public void keyPressed(int key, int scanCode, int modifiers) {
        if (!activated) return;

        if (key == GLFW.GLFW_KEY_DELETE || key == GLFW.GLFW_KEY_ESCAPE || key == GLFW.GLFW_KEY_BACKSPACE) {
            setting.get().reset();
            setting.onChanged();
            activated = false;
            return;
        }

        if (setting.get().canBindTo(true, key, modifiers)) {
            setting.get().set(Keybind.fromKeys(key, modifiers));
            setting.onChanged();
        }
        activated = false;
    }

    @Override
    public void mouseClick(float mouseX, float mouseY, int button) {
        if (isHovered(mouseX, mouseY) && button == 0) {
            activated = !activated;
            return;
        }

        if (activated && button >= 1) {
            if (setting.get().canBindTo(false, button, 0)) {
                setting.get().set(Keybind.fromButton(button));
                setting.onChanged();
            }
            activated = false;
        }
    }

    private String bindLabel() {
        if (activated && !setting.get().isSet()) return "...";
        if (!setting.get().isSet()) return "None";
        return setting.get().toString();
    }

    @Override
    public boolean isVisible() {
        return setting.isVisible();
    }
}


