    public void updateRotation(ClientPlayerEntity player, PlayerRotationManager rotationManager) {
        if (!isActive()) return;
        target = findTarget(player, true);
        if (target == null) {
            if (rotationMode.get() == AuraRotationMode.UNIVERSAL) universalRotation.engine.reset();
            if (rotationMode.get() == AuraRotationMode.JAVELIN) javelinRotation.reset();
            if (rotationMode.get() == AuraRotationMode.SLOTH) {
                slothRotation.reset();
                rotationManager.cancelTasksFor(this);
            }
            if (rotationMode.get().deltaKeep()) deltaRotation.reset();
            return;
        }
        float range = lockRange(player);
        boolean elytra = ElytraTarget.getInstance() != null && ElytraTarget.getInstance().isChasing() && player.isGliding();
        Vec3d point = elytra
            ? ElytraTarget.getInstance().aimPoint(target)
            : hitPointResolver.computeVector(target, range, rotationManager.getCurrentRotation(), getRotationMode().randomValue(), ignoreWalls.get() || elytra).getLeft();
        Vec3d delta = point.subtract(player.getEyePos());
        Rotation targetRotation = RotationMath.INSTANCE.fromVec3d(delta);
        int keepTicks = rotationMode.get() == AuraRotationMode.GRIM ? 2
            : (rotationMode.get() == AuraRotationMode.FUNTIME || rotationMode.get() == AuraRotationMode.SPOOKYTIME
                || rotationMode.get() == AuraRotationMode.FUNTIME_R || rotationMode.get() == AuraRotationMode.SPOOKYTIME_R
                || rotationMode.get() == AuraRotationMode.JAVELIN
                || rotationMode.get() == AuraRotationMode.SLOTH
                || rotationMode.get() == AuraRotationMode.UNIVERSAL || rotationMode.get().deltaKeep()) ? 20
            : rotationMode.get().zenithKeepShort() ? 1
            : rotationMode.get().zenithSnapHold() ? 3 : 5;
        int attackLookahead = rotationMode.get() == AuraRotationMode.GRIM ? 4
            : (rotationMode.get() == AuraRotationMode.FUNTIME || rotationMode.get() == AuraRotationMode.SPOOKYTIME
                || rotationMode.get() == AuraRotationMode.FUNTIME_R || rotationMode.get() == AuraRotationMode.SPOOKYTIME_R) ? 5 : 0;
        if (rotationMode.get() == AuraRotationMode.Z_SNAP && !canAttack(player, 0) && !canAttack(player, 1)) {
            lastTarget = target;
            return;
        }
        if (attackLookahead > 0 && !canAttack(player, attackLookahead)) {
            lastTarget = target;
            return;
        }
        rotationManager.scheduleRotation(
            new RotationVector(targetRotation, delta),
            target,
            new RotationConfig(getRotationMode(), false, moveCorrectionMode.get().moveCorrection(), moveCorrectionMode.get().focusedCorrection()),
            1,
            this,
            keepTicks
        );
        lastTarget = target;
    }

    public void performAttack(ClientPlayerEntity player, ClientPlayerInteractionManager interactionManager, PlayerRotationManager rotationManager) {
        if (attackCooldown > 0) attackCooldown--;
        if (sprintTicks > 0) sprintTicks--;
        if (!isActive() || target == null) return;
        float range = attackRange(player);
        Box hitBox = target.getBoundingBox();
        if (rotationMode.get() == AuraRotationMode.SLOTH) hitBox = hitBox.expand(0.1);
        Rotation look = rotationManager.getCurrentRotation();
        boolean ray = WorldRaycastUtils.rayTrace(
            hitPointResolver,
            target,
            player.getEyePos(),
            RotationMath.INSTANCE.rotationToVector(look),
            range,
            hitBox,
            ignoreWalls.get()
        );
        if (!ray && rotationMode.get() == AuraRotationMode.JAVELIN) {
            Rotation prev = rotationManager.getPreviousRotation();
            ray = WorldRaycastUtils.grimLooksHit(
                look.getYaw(), look.getPitch(),
                prev.getYaw(), prev.getPitch(),
                range, hitBox
            ) && hitPointResolver.hasValidPoint(target, range, ignoreWalls.get());
        }
        if (ray && canAttack(player, 1)) {
            sprintTicks = 1;
            unsprintForHit(player);
            if (unpressShield.get() && player.isUsingItem() && player.getActiveItem().getItem() == Items.SHIELD && mc.options.useKey.isPressed() && actionScheduler.isFinished()) {
                interactionManager.stopUsingItem(player);
                mc.options.useKey.setPressed(false);
                actionScheduler.cleanup().addTickStep(1, () -> mc.options.useKey.setPressed(true));
            }
        }
        if (ray && canAttack(player, 0)) {
            SlotSprintSync.ensureSubscribed();
            if (SlotSprintSync.lastSprinting) {
                sprintTicks = 1;
                unsprintForHit(player);
                return;
            }
            interactionManager.attackEntity(player, target);
            player.swingHand(Hand.MAIN_HAND);
            breakShieldWithAxe(player, interactionManager);
            hitCounter++;
            attackTimer.reset();
            deltaRotation.onHit();
            if (rotationMode.get() == AuraRotationMode.SLOTH) slothRotation.onAttack();
        }
    }

    public boolean shouldStopSprintProgression() {
        if (!isActive() || sprintTicks <= 0 || target == null || mc.player == null || mc.player.input == null) return false;
        return mc.player.input.movementForward != 0.0f || mc.player.input.movementSideways != 0.0f;
    }

