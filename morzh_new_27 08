package meteordevelopment.meteorclient.systems.modules.combat.aura.expensive;

import net.minecraft.util.math.MathHelper;
import net.minecraft.util.math.Vec2f;
import net.minecraft.util.math.Vec3d;

public class RotationMath {
    public static final RotationMath INSTANCE = new RotationMath();

    public Vec3d rotationToVector(Rotation rotation) {
        float pitchRad = (float) Math.toRadians(rotation.getPitch());
        float yawRad = (float) Math.toRadians(-rotation.getYaw());
        float yawCos = MathHelper.cos(yawRad);
        float yawSin = MathHelper.sin(yawRad);
        float pitchCos = MathHelper.cos(pitchRad);
        return new Vec3d(yawSin * pitchCos, -MathHelper.sin(pitchRad), yawCos * pitchCos);
    }

    public Rotation fromVec2f(Vec2f vec) {
        return new Rotation(vec.x, vec.y);
    }

    public Rotation fromVec3d(Vec3d vec) {
        return new Rotation(
            (float) MathHelper.wrapDegrees(Math.toDegrees(Math.atan2(vec.z, vec.x)) - 90.0d),
            (float) MathHelper.wrapDegrees(Math.toDegrees(-Math.atan2(vec.y, Math.hypot(vec.x, vec.z))))
        );
    }

    public Rotation fromVec3d(Vec3d from, Vec3d to) {
        return fromVec3d(from.subtract(to));
    }

    public Rotation calculateRotationDifference(Rotation a, Rotation b) {
        return new Rotation(MathHelper.wrapDegrees(a.getYaw() - b.getYaw()), a.getPitch() - b.getPitch());
    }
}


