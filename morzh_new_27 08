package meteordevelopment.meteorclient.systems.modules.combat.aura.javelin;

import meteordevelopment.meteorclient.systems.modules.combat.aura.expensive.WorldRaycastUtils;
import meteordevelopment.meteorclient.utils.world.TickRate;
import net.minecraft.entity.Entity;
import net.minecraft.util.math.Box;
import net.minecraft.util.math.MathHelper;
import net.minecraft.util.math.Vec3d;

import java.util.Random;

import static meteordevelopment.meteorclient.MeteorClient.mc;

/**
 * Javelin ST rotation, finished against Grim 2.0 Hitboxes / AimModulo360 / GCD
 * and MX-style heuristics (no 360 wrap, no frozen look, no always-center).
 *
 * Grim Reach/Hitboxes accept current look, lastYaw+pitch, lastYaw+lastPitch.
 * Hits only land if one of those rays intercepts the real box — so we aim at
 * the closest point on the box and actually finish the turn on the hit tick.
 */
public final class JavelinStEngine {
    private static final float AIM_MODULO_CAP = 280.0f;

    private final Random random = new Random();
    private Vec3d lastBias = Vec3d.ZERO;
    private int lastEntityId = -1;
    private int jitterSign = 1;

    public void reset() {
        lastEntityId = -1;
        lastBias = Vec3d.ZERO;
        jitterSign = 1;
    }

    public Vec3d randomBias() {
        return lastBias;
    }

    /**
     * @param hitNow   cooldown+crit this tick — look must intercept the box
     * @param hitSoon  window in the next ticks — start locking
     * @param postHit  unused, kept for call sites
     */
    public float[] tick(float currentYaw, float currentPitch, Entity entity, boolean hitNow, boolean hitSoon, boolean postHit) {
        if (mc.player == null || entity == null) return new float[]{currentYaw, currentPitch};

        if (entity.getId() != lastEntityId) {
            lastEntityId = entity.getId();
            jitterSign = random.nextBoolean() ? 1 : -1;
        }

        Vec3d eyes = mc.player.getEyePos();
        Box box = entity.getBoundingBox();
        Box inner = shrink(box, 0.06);
        Vec3d point = closestPoint(eyes, inner);
        lastBias = point.subtract(box.getCenter()).multiply(0.25);

        float targetYaw = yawPitch(eyes, point)[0];
        float targetPitch = yawPitch(eyes, point)[1];
        float yawDiff = MathHelper.wrapDegrees(targetYaw - currentYaw);
        float pitchDiff = targetPitch - currentPitch;

        float range = 6.0f;
        boolean alreadyHits = WorldRaycastUtils.lookHits(currentYaw, currentPitch, range, inner);

        float stepYaw;
        float stepPitch;
        if (hitNow && !alreadyHits) {
            stepYaw = clampAimModulo(yawDiff);
            stepPitch = MathHelper.clamp(pitchDiff, -89.0f, 89.0f);
            stepYaw = gcdToward(stepYaw);
            stepPitch = gcdToward(stepPitch);
        } else if (alreadyHits && (hitNow || hitSoon)) {
            float gcd = gcdStep();
            stepYaw = jitterSign * gcd;
            stepPitch = (random.nextBoolean() ? 1 : -1) * gcd * 0.5f;
            if (!WorldRaycastUtils.lookHits(currentYaw + stepYaw, currentPitch + stepPitch, range, box)) {
                stepYaw = -stepYaw;
                stepPitch = 0;
            }
            if (!WorldRaycastUtils.lookHits(currentYaw + stepYaw, currentPitch + stepPitch, range, box)) {
                stepYaw = 0;
                stepPitch = 0;
            }
        } else {
            float dist = (float) eyes.distanceTo(point);
            float factor = dist < 2.2f ? 0.34f : (dist < 3.4f ? 0.42f : 0.55f);
            factor += random.nextFloat() * 0.08f;
            float tps = tpsFactor();
            if (tps < 0.85f) factor *= 1.15f;
            if (hitSoon) factor = Math.max(factor, 0.55f);

            float yawCap = hitSoon ? 48.0f : 36.0f;
            float pitchCap = hitSoon ? 28.0f : 22.0f;
            stepYaw = MathHelper.clamp(yawDiff * factor, -yawCap, yawCap);
            stepPitch = MathHelper.clamp(pitchDiff * (factor * 0.72f), -pitchCap, pitchCap);
            stepYaw = clampAimModulo(stepYaw);
            stepYaw = gcdRound(stepYaw);
            stepPitch = gcdRound(stepPitch);
        }

        float newYaw = currentYaw + stepYaw;
        float newPitch = MathHelper.clamp(currentPitch + stepPitch, -90.0f, 90.0f);

        if (hitNow && !WorldRaycastUtils.lookHits(newYaw, newPitch, range, box)) {
            newYaw = currentYaw + gcdToward(clampAimModulo(yawDiff));
            newPitch = MathHelper.clamp(currentPitch + gcdToward(pitchDiff), -90.0f, 90.0f);
        }

        return new float[]{newYaw, newPitch};
    }

    private static Box shrink(Box box, double pad) {
        Box inner = new Box(
            box.minX + pad, box.minY + pad, box.minZ + pad,
            box.maxX - pad, box.maxY - pad, box.maxZ - pad
        );
        if (inner.getLengthX() < 0.12 || inner.getLengthY() < 0.12 || inner.getLengthZ() < 0.12) return box;
        return inner;
    }

    private static Vec3d closestPoint(Vec3d from, Box box) {
        return new Vec3d(
            MathHelper.clamp(from.x, box.minX, box.maxX),
            MathHelper.clamp(from.y, box.minY, box.maxY),
            MathHelper.clamp(from.z, box.minZ, box.maxZ)
        );
    }

    private static float[] yawPitch(Vec3d from, Vec3d to) {
        Vec3d d = to.subtract(from);
        float yaw = (float) MathHelper.wrapDegrees(Math.toDegrees(Math.atan2(d.z, d.x)) - 90.0);
        float pitch = MathHelper.clamp((float) (-Math.toDegrees(Math.atan2(d.y, Math.hypot(d.x, d.z)))), -90.0f, 90.0f);
        return new float[]{yaw, pitch};
    }

    private static float clampAimModulo(float delta) {
        return MathHelper.clamp(delta, -AIM_MODULO_CAP, AIM_MODULO_CAP);
    }

    private float gcdStep() {
        if (mc.options == null) return 0.15f;
        double sensitivity = mc.options.getMouseSensitivity().getValue() * 0.6 + 0.2;
        return (float) (sensitivity * sensitivity * sensitivity * 8.0 * 0.15);
    }

    private float gcdRound(float delta) {
        float gcd = gcdStep();
        if (gcd <= 1e-5f || Math.abs(delta) < 1e-5f) return 0;
        float steps = Math.round(delta / gcd);
        if (steps == 0 && Math.abs(delta) >= gcd * 0.35f) steps = Math.signum(delta);
        return steps * gcd;
    }

    private float gcdToward(float delta) {
        float gcd = gcdStep();
        if (gcd <= 1e-5f) return delta;
        if (Math.abs(delta) < 1e-5f) return Math.copySign(gcd, jitterSign);
        float steps = (float) Math.ceil(Math.abs(delta) / gcd);
        return Math.copySign(steps * gcd, delta);
    }

    private static float tpsFactor() {
        float tps = TickRate.INSTANCE.getTickRate();
        if (tps < 1.0f || Float.isNaN(tps)) tps = 20.0f;
        return tps / 20.0f;
    }
