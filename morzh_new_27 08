package meteordevelopment.meteorclient.systems.modules.combat.aura.rasty.rotations;

import meteordevelopment.meteorclient.systems.modules.combat.aura.rasty.Angle;
import meteordevelopment.meteorclient.systems.modules.combat.aura.rasty.impl.RotateConstructor;
import net.minecraft.entity.Entity;
import net.minecraft.util.math.MathHelper;
import net.minecraft.util.math.Vec3d;

import java.util.Random;

import static meteordevelopment.meteorclient.MeteorClient.mc;

/**
 * Nuclear AttackAura "SpookyTime" rotator: lerp + sine jitter + mouse-step quantize.
 * Logic only — no IO.
 */
public class NuclearSpookyAngle extends RotateConstructor {
    private static final Random RANDOM = new Random();
    private static final double MOUSE_STEP = 0.005;
    private static final long HOLD_MS = 20L;
    private static final long RETURN_MS = 70L;

    private boolean returning;
    private long holdUntil;
    private boolean smoothingBack;
    private long smoothStart;
    private float savedStartYaw, savedStartPitch;
    private float savedEndYaw, savedEndPitch;
    private boolean hadTarget;
    private float lastYaw, lastPitch;

    public NuclearSpookyAngle() {
        super("Nuclear Spooky");
    }

    @Override
    public Angle limitAngleChange(Angle currentAngle, Angle targetAngle, Vec3d vec3d, Entity entity) {
        if (currentAngle == null) currentAngle = new Angle(mc.player.getYaw(), mc.player.getPitch());
        if (targetAngle == null) return currentAngle;

        long now = System.currentTimeMillis();
        float currentYaw = sanitize(currentAngle.getYaw());
        float currentPitch = sanitize(currentAngle.getPitch());
        float targetYaw = sanitize(targetAngle.getYaw());
        float targetPitch = sanitize(targetAngle.getPitch());
        boolean hasTarget = entity != null && entity.isAlive();

        Angle out = calculate(now, currentYaw, currentPitch, targetYaw, targetPitch, hasTarget);
        lastYaw = out.getYaw();
        lastPitch = out.getPitch();
        return out;
    }

    @Override
    public Vec3d randomValue() {
        return Vec3d.ZERO;
    }

    private Angle calculate(long now, float currentYaw, float currentPitch, float targetYaw, float targetPitch, boolean hasTarget) {
        if (!hasTarget) {
            if (hadTarget && !returning && !smoothingBack) {
                returning = true;
                holdUntil = now + HOLD_MS;
                savedStartYaw = currentYaw;
                savedStartPitch = currentPitch;
                savedEndYaw = targetYaw;
                savedEndPitch = targetPitch;
            }
            hadTarget = false;

            if (returning && now < holdUntil) {
                return quantize(savedStartYaw, savedStartPitch);
            }
            if (returning && !smoothingBack) {
                smoothingBack = true;
                smoothStart = now;
            }
            if (!smoothingBack) return quantize(targetYaw, targetPitch);

            float progress = MathHelper.clamp((now - smoothStart) / (float) RETURN_MS, 0.0f, 1.0f);
            float eased = progress * (0.5f + 0.5f * progress);
            float yaw = savedStartYaw + eased * wrap(savedEndYaw - savedStartYaw);
            float pitch = MathHelper.clamp(savedStartPitch + eased * (savedEndPitch - savedStartPitch), -89.0f, 90.0f);
            if (progress >= 1.0f) {
                returning = false;
                smoothingBack = false;
                holdUntil = 0L;
            }
            return quantize(yaw, pitch);
        }

        hadTarget = true;
        returning = false;
        smoothingBack = false;
        holdUntil = 0L;

        float yawDelta = wrap(targetYaw - currentYaw);
        float pitchDelta = wrap(targetPitch - currentPitch);
        float total = (float) Math.hypot(Math.abs(yawDelta), Math.abs(pitchDelta));
        if (total < 1.0e-4f) total = 1.0e-4f;

        float maxYaw = Math.abs(yawDelta / total) * 130.0f;
        float maxPitch = Math.abs(pitchDelta / total) * 130.0f;
        float baseYaw = MathHelper.lerp(0.85f, currentYaw, currentYaw + MathHelper.clamp(yawDelta, -maxYaw, maxYaw));
        float basePitch = MathHelper.lerp(0.85f, currentPitch, currentPitch + MathHelper.clamp(pitchDelta, -maxPitch, maxPitch));
        float yawNoise = (float) (rand(1.0f, 2.0f) * Math.sin(now / 160.0));
        float pitchNoise = (float) (rand(0.2f, 0.8f) * Math.cos(now / 160.0));
        return quantize(baseYaw + yawNoise, MathHelper.clamp(basePitch + pitchNoise, -89.0f, 90.0f));
    }

    private Angle quantize(float yaw, float pitch) {
        float qYaw = lastYaw + Math.round(wrap(yaw - lastYaw) / (float) MOUSE_STEP) * (float) MOUSE_STEP;
        float qPitch = lastPitch + Math.round((pitch - lastPitch) / (float) MOUSE_STEP) * (float) MOUSE_STEP;
        return new Angle(qYaw, MathHelper.clamp(qPitch, -90.0f, 90.0f));
    }

    private static float wrap(float angle) {
        if (!Float.isFinite(angle)) return 0.0f;
        return MathHelper.wrapDegrees(angle);
    }

    private static float sanitize(float angle) {
        return Float.isFinite(angle) ? angle : 0.0f;
    }

    private static float rand(float min, float max) {
        return min + RANDOM.nextFloat() * (max - min);
    }
}


