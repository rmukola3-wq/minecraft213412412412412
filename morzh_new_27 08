import meteordevelopment.meteorclient.settings.Setting;
import meteordevelopment.meteorclient.settings.SettingGroup;
import meteordevelopment.meteorclient.systems.modules.Categories;
import meteordevelopment.meteorclient.systems.modules.Module;
import meteordevelopment.meteorclient.utils.render.color.Color;
import meteordevelopment.orbit.EventHandler;
import net.minecraft.entity.EquipmentSlot;
import net.minecraft.entity.player.PlayerEntity;
import net.minecraft.util.math.MathHelper;

import static org.lwjgl.opengl.GL11.GL_ONE;
import static org.lwjgl.opengl.GL11.GL_ONE_MINUS_SRC_ALPHA;
import static org.lwjgl.opengl.GL11.GL_SRC_ALPHA;

/**
 * Rasty / Xyeta china hat: spinning two-sided cone + glowing rim.
 * Additive, no depth, 180 segments — not Meteor filled quads.
 */
public class ChinaHat extends Module {
    private static final int SEGMENTS = 180;

    private final SettingGroup sg = settings.getDefaultGroup();

    private final Setting<Boolean> others = sg.add(new BoolSetting.Builder()
        .name("other-players")
        .defaultValue(false)
        .build()
    );

    private final Setting<Double> radius = sg.add(new DoubleSetting.Builder()
        .name("radius")
        .defaultValue(0.62)
        .min(0.35)
        .sliderMax(1.1)
        .build()
    );

    private final Setting<Double> height = sg.add(new DoubleSetting.Builder()
        .name("height")
        .defaultValue(0.36)
        .min(0.14)
        .sliderMax(0.8)
        .build()
    );

    private final HatMesh mesh = new HatMesh();
    private final Color tip = new Color();
    private final Color rim = new Color();
    private final Color rimFade = new Color();

    public ChinaHat() {
        super(Categories.Render, "china-hat", "Spinning rainbow cone on the head.");
    }

    @EventHandler
    private void onRender(Render3DEvent event) {
        if (mc.player == null || mc.world == null) return;

        mesh.depthTest = false;
        mesh.begin();
        for (PlayerEntity player : mc.world.getPlayers()) {
            if (player == mc.player && mc.options.getPerspective().isFirstPerson()) continue;
            if (player != mc.player && !others.get()) continue;
            hat(player, event.tickDelta);
        }
        mesh.render(event.matrices);
        GlStateManager._blendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
        GlStateManager._depthMask(true);
    }

    private void hat(PlayerEntity player, float tickDelta) {
        double x = MathHelper.lerp(tickDelta, player.prevX, player.getX());
        double y = MathHelper.lerp(tickDelta, player.prevY, player.getY()) + player.getHeight() + 0.08;
        double z = MathHelper.lerp(tickDelta, player.prevZ, player.getZ());
        if (player.isSneaking()) y -= 0.18;
        if (!player.getEquippedStack(EquipmentSlot.HEAD).isEmpty()) y += 0.05;

        float r = radius.get().floatValue();
        float h = height.get().floatValue();
        float spin = (System.currentTimeMillis() % 5000L) / 5000f * (float) (Math.PI * 2);

        hue(tip, 0f, 230);
        int apex = mesh.vec3(x, y + h, z).color(tip).next();

        int prevRim = -1;
        for (int i = 0; i <= SEGMENTS; i++) {
            float t = i / (float) SEGMENTS;
            double a = spin + t * Math.PI * 2;
            hue(rim, t, 140);
            int v = mesh.vec3(x + Math.cos(a) * r, y, z + Math.sin(a) * r).color(rim).next();
            if (prevRim != -1) {
                mesh.triangle(apex, prevRim, v);
                mesh.triangle(apex, v, prevRim);
            }
            prevRim = v;
        }

        int prevOuter = -1;
        int prevInner = -1;
        float outerR = r * 1.035f;
        float innerR = r * 0.90f;
        for (int i = 0; i <= SEGMENTS; i++) {
            float t = i / (float) SEGMENTS;
            double a = spin + t * Math.PI * 2;
            hue(rim, t, 255);
            rimFade.set(rim.r, rim.g, rim.b, 0);
            int outer = mesh.vec3(x + Math.cos(a) * outerR, y + 0.012, z + Math.sin(a) * outerR).color(rim).next();
            int inner = mesh.vec3(x + Math.cos(a) * innerR, y + 0.012, z + Math.sin(a) * innerR).color(rimFade).next();
            if (prevOuter != -1) mesh.quad(prevOuter, outer, inner, prevInner);
            prevOuter = outer;
            prevInner = inner;
        }
    }

    private static void hue(Color out, float t, int alpha) {
        float hue = (t * 0.85f + (System.currentTimeMillis() % 2800) / 2800f) % 1f;
        int rgb = java.awt.Color.HSBtoRGB(hue, 0.78f, 1f);
        out.set((rgb >> 16) & 255, (rgb >> 8) & 255, rgb & 255, alpha);
    }

    private static class HatMesh extends ShaderMesh {
        private HatMesh() {
            super(Shaders.POS_COLOR, DrawMode.Triangles, Mesh.Attrib.Vec3, Mesh.Attrib.Color);
        }

        @Override
        protected void beforeRender() {
            super.beforeRender();
            GlStateManager._enableBlend();
            GlStateManager._blendFunc(GL_SRC_ALPHA, GL_ONE);
            GlStateManager._depthMask(false);
            GlStateManager._disableCull();
        }
    }
}


