    private float displayedHealthRatio;
    private float displayedAbsorptionRatio;
    private float openWanted;
    private float openDisplayed;
    private long lastAnimNs;
    private float hitFlashAmount;
    private float lastHealth = -1;
    private float hudAnimAlpha = 1f;

    public TargetHud() {
        super(INFO);
        calculateSize();
    }

    /** Called from HUD editor scroll to resize like ThunderHack drag-scale. */
    @Override
    public void adjustScale(double delta) {
        scale.set(MathHelper.clamp(scale.get() + delta, MIN_SCALE, MAX_SCALE));
        calculateSize();
    }

    @Override
    public double getScaleValue() {
        return scale.get();
    }

    /** Quick style cycle from the HUD editor toolbar. */
    public void cycleStyle() {
        Style[] values = Style.values();
        style.set(values[(style.get().ordinal() + 1) % values.length]);
        calculateSize();
    }

    public String getStyleLabel() {
        return style.get().toString();
    }

    private float getBaseWidth() {
        return switch (style.get()) {
            case ReallyVisual -> RV_WIDTH;
            case Compact -> COMPACT_WIDTH;
            case Thunder -> THUNDER_WIDTH;
            case NurikZapen -> nurikMini.get() ? NURIK_MINI_WIDTH : NURIK_WIDTH;
            case Rust -> RUST_WIDTH;
            case Ambient -> AMBIENT_WIDTH;
            case Expensive -> EXPENSIVE_WIDTH;
            case Rockstar -> ROCKSTAR_WIDTH;
            case Xyeta -> XYETA_WIDTH;
            case Pulse -> PULSE_WIDTH;
            case Punch -> PUNCH_WIDTH;
            case LiquidBounce -> LB_WIDTH;
            case Meteor -> METEOR_WIDTH;
            case Dento -> DENTO_WIDTH;
            case Circle -> CIRCLE_WIDTH;
            case Novoline -> NOVOLINE_WIDTH;
        };
    }

    private float getBaseHeight() {
        return switch (style.get()) {
            case ReallyVisual -> RV_HEIGHT;
            case Compact -> COMPACT_HEIGHT;
            case Thunder -> THUNDER_HEIGHT;
            case NurikZapen -> nurikMini.get() ? NURIK_MINI_HEIGHT : NURIK_HEIGHT;
            case Rust -> RUST_HEIGHT;
            case Ambient -> AMBIENT_HEIGHT;
            case Expensive -> expensiveTall() ? EXPENSIVE_HEIGHT : EXPENSIVE_HEIGHT_SMALL;
            case Rockstar -> ROCKSTAR_HEIGHT;
            case Xyeta -> XYETA_HEIGHT;
            case Pulse -> PULSE_HEIGHT;
            case Punch -> PUNCH_HEIGHT;
            case LiquidBounce -> LB_HEIGHT;
            case Meteor -> METEOR_HEIGHT;
            case Dento -> DENTO_HEIGHT;
            case Circle -> CIRCLE_HEIGHT;
            case Novoline -> NOVOLINE_HEIGHT;
        };
    }

    private boolean expensiveTall() {
        return !onlySmallVersion.get() && showArmor.get() && !expensiveEquipment().isEmpty();
    }

    private void calculateSize() {
        setSize(getBaseWidth() * scale.get().floatValue(), getBaseHeight() * scale.get().floatValue());
    }

    @Override
    public void tick(HudRenderer renderer) {
        if (isInEditor()) {
            currentTarget = mc.player;
            openWanted = openDisplayed = 1.0f;
            if (currentTarget != null) displayedHealthRatio = getHealthRatio(currentTarget);
            return;
        }

        LivingEntity target = resolveTarget();

        if (target != null) {
            if (target != currentTarget) lastHealth = target.getHealth();
            currentTarget = target;
            updateHealthAnimation(target);
            updateHitFlash(target, TICK_TIME);
            openWanted = 1.0f;
        } else {
            openWanted = 0.0f;
            if (openDisplayed <= 0.01f) {
                currentTarget = null;
                displayedHealthRatio = 0.0f;
                displayedAbsorptionRatio = 0.0f;
                hitFlashAmount = 0.0f;
                lastHealth = -1;
            }
        }

        if (style.get() == Style.Expensive || style.get() == Style.NurikZapen || style.get() == Style.Punch) calculateSize();
    }

    @Override
    public void render(HudRenderer renderer) {
        long now = System.nanoTime();
        float dt = lastAnimNs == 0 ? 0.016f : MathHelper.clamp((now - lastAnimNs) / 1_000_000_000f, 0f, 0.05f);
        lastAnimNs = now;

        if (!isInEditor()) {
            boolean opening = openWanted > openDisplayed;
            float k = 1f - (float) Math.exp(-dt * styleAnimSpeed(opening));
            openDisplayed += (openWanted - openDisplayed) * k;
            if (openDisplayed < 0.004f && openWanted <= 0f) {
                openDisplayed = 0f;
                currentTarget = null;
                return;
            }
            if (currentTarget != null) {
                displayedHealthRatio += (getHealthRatio(currentTarget) - displayedHealthRatio)
                    * (1f - (float) Math.exp(-dt * (8f + 40f * healthAnimationSpeed.get().floatValue())));
                float absorption = MathHelper.clamp(currentTarget.getAbsorptionAmount() / 20.0f, 0.0f, 1.0f);
                displayedAbsorptionRatio += (absorption - displayedAbsorptionRatio) * k;
            }
        } else {
            openDisplayed = 1f;
        }

        if (currentTarget == null || openDisplayed <= 0.004f) return;

        float anim = isInEditor() ? 1f : styleEase(openDisplayed);
        if (anim <= 0f && style.get() != Style.Pulse && style.get() != Style.Compact
            && style.get() != Style.Expensive && style.get() != Style.Meteor) return;

        renderer.post(() -> {
            DrawContext context = HudRenderer.INSTANCE.drawContext;
            if (context == null) return;
            drawContent(context, anim);
        });
    }

    private String getTargetName() {
        if (currentTarget == null) return "Unknown";

        if (currentTarget instanceof PlayerEntity player) {
            String profile = player.getGameProfile().getName();
            if (profile != null && !profile.isBlank()) return profile;
        }

        if (currentTarget.hasCustomName() && currentTarget.getCustomName() != null) {
            String custom = currentTarget.getCustomName().getString();
            if (!custom.isBlank()) return custom;
        }

        String display = currentTarget.getDisplayName() != null ? currentTarget.getDisplayName().getString() : "";
        if (!display.isBlank()) return display;

        String name = currentTarget.getName().getString();
        if (name != null && !name.isBlank()) return name;

        return currentTarget.getType().getName().getString();
    }

    private LivingEntity resolveTarget() {
        if (isInEditor()) return mc.player;

        LivingEntity living = CombatTargets.current();
        if (living != null && living.isAlive()) return living;

        if (mc.targetedEntity instanceof LivingEntity looked && looked.isAlive() && looked != mc.player) {
            return looked;
        }
        if (style.get() == Style.Expensive && showInRaycast.get()) {
            LivingEntity ray = raycastLiving();
            if (ray != null && ray.isAlive()) return ray;
        }
        return null;
    }

    private void drawContent(DrawContext context, float anim) {
        if (currentTarget == null) return;

        float baseW = getBaseWidth();
        float baseH = getBaseHeight();
        hudAnimAlpha = MathHelper.clamp(styleAlpha(anim), 0f, 1f);
        DrawBounds b = new DrawBounds(x, y, getWidth(), getHeight(), anim, baseW, baseH, style.get());

        if (style.get() == Style.ReallyVisual) drawReallyVisual(context, b, baseW, baseH);
        else if (style.get() == Style.Compact) drawCompact(context, b, baseW, baseH);
        else if (style.get() == Style.Thunder) drawThunder(context, b, baseW, baseH);
        else if (style.get() == Style.NurikZapen) drawNurikZapen(context, b, baseW, baseH);
        else if (style.get() == Style.Ambient) drawAmbient(context, b, baseW, baseH);
        else if (style.get() == Style.Expensive) drawExpensive(context, b, baseW, baseH);
        else if (style.get() == Style.Rockstar) drawRockstar(context, b, baseW, baseH);
        else if (style.get() == Style.Xyeta) drawXyeta(context, b, baseW, baseH);
        else if (style.get() == Style.Pulse) drawPulse(context, b, baseW, baseH);
        else if (style.get() == Style.Punch) drawPunch(context, b, baseW, baseH);
        else if (style.get() == Style.LiquidBounce) drawLiquidBounce(context, b, baseW, baseH);
        else if (style.get() == Style.Meteor) drawMeteor(context, b, baseW, baseH);
        else if (style.get() == Style.Dento) drawDento(context, b, baseW, baseH);
        else if (style.get() == Style.Circle) drawCircle(context, b, baseW, baseH);
        else if (style.get() == Style.Novoline) drawNovoline(context, b, baseW, baseH);
        else drawRust(context, b, baseW, baseH);
    }

    private void updateHealthAnimation(LivingEntity target) {
        float targetRatio = getHealthRatio(target);
        displayedHealthRatio = MathHelper.lerp(
            healthAnimationSpeed.get().floatValue(), displayedHealthRatio, targetRatio
        );
        float absorption = MathHelper.clamp(target.getAbsorptionAmount() / 20.0f, 0.0f, 1.0f);
        displayedAbsorptionRatio = MathHelper.lerp(
            healthAnimationSpeed.get().floatValue(), displayedAbsorptionRatio, absorption
        );
    }

    private void updateHitFlash(LivingEntity target, float frameTime) {
        if (!hitFlash.get()) {
            hitFlashAmount = 0.0f;
            return;
        }

        float health = target.getHealth();
        if (lastHealth >= 0 && health < lastHealth - 0.01f) hitFlashAmount = 1.0f;
        lastHealth = health;

        hitFlashAmount = Math.max(0.0f, hitFlashAmount - frameTime * hitFlashSpeed.get().floatValue());
    }

    private float getHealthRatio(LivingEntity entity) {
        float max = entity.getMaxHealth();
        if (max <= 0) return 0;
        return MathHelper.clamp(entity.getHealth() / max, 0.0f, 1.0f);
    }

    /**
     * Maps layout coords from the element's base size into absolute screen space.
     * Renderer2D (MorzhSmoothRenderer NoBegin) ignores DrawContext matrices, so every
     * draw call must use screen x/y — same as ThunderHack's getPosX()/getPosY() pattern.
     */
    private static final class DrawBounds {
        final float x, y, w, h;
        final float baseW, baseH;

        DrawBounds(int boxX, int boxY, int boxW, int boxH, float anim, float baseW, float baseH, Style style) {
            this.baseW = baseW;
            this.baseH = baseH;
            float t = MathHelper.clamp(anim, 0f, 1.15f);
            float s;
            float ox = 0f;
            float oy = 0f;
            switch (style) {
                case ReallyVisual, Ambient -> s = 0.8f + 0.2f * Math.min(t, 1f);
                case Rockstar, Circle -> s = t;
                case Xyeta -> s = t;
                case Pulse, Compact, Expensive, Meteor -> s = 1f;
                case Punch -> s = 0.85f + 0.15f * Math.min(t, 1f);
                case LiquidBounce -> {
                    s = 1f;
                    oy = -10f * (1f - Math.min(t, 1f));
                }
                case Thunder, NurikZapen -> s = Math.min(t, 1f);
                case Rust -> s = 0.92f + 0.08f * Math.min(t, 1f);
                case Dento -> s = 0.9f + 0.1f * Math.min(t, 1f);
                case Novoline -> {
                    s = 1f;
                    ox = -20f * (1f - Math.min(t, 1f));
                }
                default -> s = 0.90f + 0.10f * Math.min(t, 1f);
            }
            w = boxW * s;
            h = boxH * s;
            x = boxX + (boxW - w) / 2f + ox;
            y = boxY + (boxH - h) / 2f + oy;
        }

        float px(float localX) {
            return x + localX / baseW * w;
        }

        float py(float localY) {
            return y + localY / baseH * h;
        }

        float pw(float localW) {
            return localW / baseW * w;
        }

        float ph(float localH) {
            return localH / baseH * h;
        }
    }

    /** Expensive TargetHudWidget: avatar, optional armor row, name, HP/absorption pills. */
    private void drawExpensive(DrawContext context, DrawBounds b, float baseW, float baseH) {
        float uiScale = b.w / baseW;
        float radius = 8f * uiScale;
        boolean tall = expensiveTall();
        int bg = fa(DropDownColors.rgba(12, 12, 16, 230));
        int outline = fa(outlineColor.get().getPacked());
        int accent = fa(accentColor.get().getPacked());
        int gold = DropDownColors.rgb(212, 175, 55);

        MorzhSmoothRenderer.roundedRect(
            context, b.px(0), b.py(0), b.pw(baseW), b.ph(baseH), radius, bg, outline, 1.5f * uiScale
        );

        float pad = 10f;
        float avatar = Math.max(pad, baseH - 20f);
        float avatarX = pad;
        float avatarY = (baseH - avatar) / 2f;
        if (showPortrait.get()) {
            renderFaceTexture(context, b.px(avatarX), b.py(avatarY), b.pw(avatar), b.ph(avatar), (tall ? 8 : 6) * uiScale);
        }

        float contentX = avatarX + avatar + 8f;
        float contentY = avatarY;
        List<ItemStack> items = expensiveEquipment();
        float itemsBottom = contentY;
        if (tall) {
            float ix = contentX;
            float itemScale = 0.55f * uiScale;
            for (ItemStack stack : items) {
                if (stack.isEmpty()) continue;
                RenderUtils.drawItem(context, stack, Math.round(b.px(ix)), Math.round(b.py(contentY)), itemScale, false);
                ix += 15f;
            }
            itemsBottom = contentY + 14f;
        }

        double nameFs = 0.58 * Math.max(0.75f, uiScale);
        double valueFs = 0.52 * Math.max(0.75f, uiScale);
        float hp = currentTarget.getHealth();
        float absorption = currentTarget.getAbsorptionAmount();
        boolean showAbs = absorption > 0.05f && currentTarget.getMaxAbsorption() <= 20.0f;
        String hpText = formatHealth(hp);
        String absText = showAbs ? formatHealth(absorption) : "";

        float valueMax = (float) MorzhSmoothRenderer.textWidth("20.0", valueFs);
        float hpBlock = valueMax + 14f * uiScale;
        float absBlock = showAbs ? valueMax + 14f * uiScale : 0f;
        float nameMaxLocal = (baseW - pad) - contentX - (tall ? Math.max(hpBlock, absBlock) : hpBlock + (showAbs ? 4f + absBlock : 0f));
        String name = ellipsize(getTargetName(), b.pw(Math.max(8f, nameMaxLocal)), nameFs);
        float nameY = tall ? itemsBottom + 2f : contentY;
        MorzhSmoothRenderer.text(context, name, b.px(contentX), b.py(nameY), 0xFFFFFFFF, textShadow.get(), nameFs);

        float barX = contentX;
        float barW = (baseW - pad) - contentX - 4f;
        float barH = 3f;
        float barY = tall ? baseH - 17f : baseH - 14f;
        MorzhSmoothRenderer.roundedRect(context, b.px(barX), b.py(barY), b.pw(barW), b.ph(barH), 1.5f * uiScale,
            DropDownColors.rgba(28, 28, 36, 220));
        MorzhSmoothRenderer.roundedRect(context, b.px(barX), b.py(barY), b.pw(barW * displayedHealthRatio), b.ph(barH), 1.5f * uiScale, accent);
        if (showAbs && displayedAbsorptionRatio > 0.01f) {
            MorzhSmoothRenderer.roundedRect(context, b.px(barX), b.py(barY), b.pw(barW * displayedAbsorptionRatio), b.ph(barH), 1.5f * uiScale, gold);
        }

        float right = baseW - pad;
        if (tall) {
            float hpW = (float) MorzhSmoothRenderer.textWidth(hpText, valueFs);
            MorzhSmoothRenderer.text(context, "❤", b.px(right - hpW - 11f), b.py(contentY), accent, false, valueFs);
            MorzhSmoothRenderer.text(context, hpText, b.px(right) - hpW, b.py(contentY), accent, true, valueFs);
            if (showAbs) {
                float absW = (float) MorzhSmoothRenderer.textWidth(absText, valueFs);
                MorzhSmoothRenderer.text(context, "✦", b.px(right - absW - 11f), b.py(barY - 12f), gold, false, valueFs);
                MorzhSmoothRenderer.text(context, absText, b.px(right) - absW, b.py(barY - 12f), gold, true, valueFs);
            }
        } else {
            float textY = nameY;
            if (showAbs) {
                float absW = (float) MorzhSmoothRenderer.textWidth(absText, valueFs);
                MorzhSmoothRenderer.text(context, absText, b.px(right) - absW, b.py(textY), gold, true, valueFs);
                MorzhSmoothRenderer.text(context, "✦", b.px(right - absW - 11f), b.py(textY), gold, false, valueFs);
                right -= absW + 16f;
            }
            float hpW = (float) MorzhSmoothRenderer.textWidth(hpText, valueFs);
            MorzhSmoothRenderer.text(context, hpText, b.px(right) - hpW, b.py(textY), accent, true, valueFs);
            MorzhSmoothRenderer.text(context, "❤", b.px(right - hpW - 11f), b.py(textY), accent, false, valueFs);
        }
    }

    private List<ItemStack> expensiveEquipment() {
        List<ItemStack> list = new ArrayList<>();
        if (currentTarget == null || !showArmor.get()) return list;
        if (currentTarget instanceof PlayerEntity player) {
            list.add(player.getEquippedStack(EquipmentSlot.HEAD));
            list.add(player.getEquippedStack(EquipmentSlot.CHEST));
            list.add(player.getEquippedStack(EquipmentSlot.LEGS));
            list.add(player.getEquippedStack(EquipmentSlot.FEET));
        }
        list.removeIf(ItemStack::isEmpty);
        if (!currentTarget.getMainHandStack().isEmpty()) list.add(currentTarget.getMainHandStack());
        if (!currentTarget.getOffHandStack().isEmpty()) list.add(currentTarget.getOffHandStack());
        return list;
    }

    private LivingEntity raycastLiving() {
        if (mc.player == null || mc.world == null) return null;
        Entity camera = mc.getCameraEntity();
        if (camera == null) return null;
        double range = mc.player.getEntityInteractionRange();
        Vec3d start = camera.getCameraPosVec(1.0f);
        Vec3d look = camera.getRotationVec(1.0f);
        Vec3d end = start.add(look.multiply(range));
        LivingEntity best = null;
        double bestDist = Double.MAX_VALUE;
        for (LivingEntity entity : mc.world.getEntitiesByClass(LivingEntity.class,
            camera.getBoundingBox().stretch(look.multiply(range)).expand(1.0),
            e -> e != mc.player && e.isAlive() && !e.isSpectator())) {
            var hit = entity.getBoundingBox().expand(0.7).raycast(start, end);
            if (hit.isEmpty()) continue;
            double dist = start.squaredDistanceTo(hit.get());
            if (dist < bestDist) {
                bestDist = dist;
                best = entity;
            }
        }
        return best;
    }

    private void drawCompact(DrawContext context, DrawBounds b, float baseW, float baseH) {
        float uiScale = Math.max(0.75f, b.w / baseW);
        double nameFs = 0.58 * uiScale;
        double enchFs = 0.38 * uiScale;
        int green = DropDownColors.rgb(92, 214, 118);

        float barH = 16 * uiScale;
        float barY = b.py(baseH - barH);
        MorzhSmoothRenderer.roundedRect(
            context,
            b.px(0), barY, b.pw(baseW), b.ph(barH),
            3 * uiScale,
            fa(DropDownColors.rgba(8, 8, 10, 215))
        );

        String name = getTargetName();
        String hp = formatHealth(currentTarget.getHealth());
        String dist = "";
        if (showDistance.get() && mc.player != null) {
            dist = String.format("%.1fm", mc.player.distanceTo(currentTarget)).replace('.', ',');
        }

        float right = b.px(baseW - 8);
        if (!dist.isEmpty()) {
            float distW = (float) MorzhSmoothRenderer.textWidth(dist, nameFs);
            MorzhSmoothRenderer.text(context, dist, right - distW, barY + 4 * uiScale, green, true, nameFs);
            right -= distW + 8 * uiScale;
        }
        float hpW = (float) MorzhSmoothRenderer.textWidth(hp, nameFs);
        MorzhSmoothRenderer.text(context, hp, right - hpW, barY + 4 * uiScale, green, true, nameFs);

        float nameMax = (right - hpW - 6 * uiScale) - b.px(8);
        name = ellipsize(name, nameMax, nameFs);
        MorzhSmoothRenderer.text(context, name, b.px(8), barY + 4 * uiScale, 0xFFFFFFFF, true, nameFs);

        ItemStack[] stacks = compactStacks();
        int cols = stacks.length;
        float colW = b.pw(baseW) / cols;
        float itemY = b.py(22);
        float itemScale = 0.85f * uiScale;

        for (int i = 0; i < cols; i++) {
            ItemStack stack = stacks[i];
            float cx = b.px(i * (baseW / cols) + (baseW / cols) / 2f);
            if (!stack.isEmpty()) {
                List<String> labels = enchantLabels(stack);
                float textY = b.py(4);
                for (String label : labels) {
                    float tw = (float) MorzhSmoothRenderer.textWidth(label, enchFs);
                    MorzhSmoothRenderer.text(context, label, cx - tw / 2f, textY, 0xFFFFFFFF, true, enchFs);
                    textY += (float) MorzhSmoothRenderer.textHeight(enchFs);
                }

                RenderUtils.drawItem(context, stack, Math.round(cx - 8 * uiScale), Math.round(itemY), itemScale, false);

                if (stack.isDamageable()) {
                    float ratio = 1f - stack.getDamage() / (float) stack.getMaxDamage();
                    float bw = 14 * uiScale;
                    float bh = 2.2f * uiScale;
                    float bx = cx - bw / 2f;
                    float by = itemY + 16 * uiScale;
                    MorzhSmoothRenderer.roundedRect(context, bx, by, bw, bh, 0.8f, DropDownColors.rgba(12, 12, 14, 230));
                    int bar = durabilityColor(ratio);
                    MorzhSmoothRenderer.roundedRect(context, bx, by, bw * Math.max(0.04f, ratio), bh, 0.8f, bar);
                }
            }
        }
    }

    private ItemStack[] compactStacks() {
        if (currentTarget instanceof PlayerEntity player) {
            return new ItemStack[] {
                player.getEquippedStack(EquipmentSlot.FEET),
                player.getEquippedStack(EquipmentSlot.LEGS),
                player.getEquippedStack(EquipmentSlot.CHEST),
                player.getEquippedStack(EquipmentSlot.HEAD),
                player.getMainHandStack().isEmpty() ? player.getOffHandStack() : player.getMainHandStack()
            };
        }
        return new ItemStack[] { currentTarget.getMainHandStack() };
    }

    private static List<String> enchantLabels(ItemStack stack) {
        List<String> out = new ArrayList<>();
        Object2IntMap<RegistryEntry<Enchantment>> map = new Object2IntOpenHashMap<>();
        Utils.getEnchantments(stack, map);
        for (Object2IntMap.Entry<RegistryEntry<Enchantment>> entry : map.object2IntEntrySet()) {
            String shortName = Utils.getEnchantSimpleName(entry.getKey(), 1);
            out.add(shortName + entry.getIntValue());
            if (out.size() >= 2) break;
        }
        return out;
    }

    private static int durabilityColor(float ratio) {
        int r = (int) (255 * (1f - ratio));
        int g = (int) (80 + 140 * ratio);
        return DropDownColors.rgb(r, g, 40);
    }

    private void drawNurikZapen(DrawContext context, DrawBounds b, float baseW, float baseH) {
        boolean mini = nurikMini.get();
        float uiScale = b.w / baseW;
        float radius = (mini ? 7f : 9f) * uiScale;

        Color c90 = fa(ThunderHackEsp.hudColorC(90, 255));
        Color c0 = fa(ThunderHackEsp.hudColorC(0, 255));
        Color c180 = fa(ThunderHackEsp.hudColorC(180, 255));
        Color c270 = fa(ThunderHackEsp.hudColorC(270, 255));

        Renderer2D r = Renderer2D.COLOR;
        r.begin();
        r.quad(b.px(0), b.py(0), b.pw(baseW), b.ph(baseH), c90, c180, c0, c270);
        r.render(context.getMatrices());

        MorzhSmoothRenderer.roundedRect(
            context,
            b.px(0.5f), b.py(0.5f),
            b.pw(baseW - 1f), b.ph(baseH - 1.5f),
            Math.max(0f, radius - 0.5f * uiScale),
            fa(DropDownColors.rgba(0, 0, 0, 220))
        );

        float face = mini ? 30f : 40f;
        float facePad = mini ? 2.5f : 3.5f;
        float hurt = currentTarget.hurtTime / 8f;
        float faceScale = 1f - hurt / (mini ? 20f : 15f);

        if (showPortrait.get()) {
            context.getMatrices().push();
            float cx = b.px(facePad + face / 2f);
            float cy = b.py(facePad + face / 2f);
            context.getMatrices().translate(cx, cy, 0);
            context.getMatrices().scale(faceScale, faceScale, 1f);
            context.getMatrices().translate(-cx, -cy, 0);
            renderFaceTexture(context, b.px(facePad), b.py(facePad), b.pw(face), b.ph(face), (mini ? 5 : 7) * uiScale);
            context.getMatrices().pop();
        }

        float barX = mini ? 38f : 48f;
        float barY = mini ? 25f : 32f;
        float barW = mini ? 52f : 85f;
        float barH = mini ? 7f : 11f;
        float barR = (mini ? 2f : 4f) * uiScale;

        Color barDark = new Color(Math.max(0, c0.r / 5), Math.max(0, c0.g / 5), Math.max(0, c0.b / 5), 255);
