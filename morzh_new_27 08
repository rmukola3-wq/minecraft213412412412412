package meteordevelopment.meteorclient.gui.morzh;

/**
 * A component that can reveal its children underneath its own body.
 *
 * The expansion is animated, and — this is the part that matters — the same
 * animated progress feeds both the drawing and {@link #expandedHeight()}. The
 * parent therefore reserves exactly as much room as is actually painted at
 * every single frame of the animation, so nothing can ever be drawn on top of
 * the component that follows.
 */
public abstract class MorzhExpandableComponent extends MorzhComponent {
    private static final float EXPAND_RESPONSIVENESS = 16f;
    private static final float EPSILON = 0.001f;

    private boolean expanded;
    private float expandProgress;

    protected MorzhExpandableComponent(
        MorzhComponent parent,
        String name,
        int x,
        int y,
        int width,
        int height
    ) {
        super(parent, name, x, y, width, height);
    }

    public boolean canExpand() {
        return !children.isEmpty();
    }

    public boolean isExpanded() {
        return expanded && canExpand();
    }

    public void setExpanded(boolean expanded) {
        this.expanded = expanded && canExpand();
    }

    public void toggleExpanded() {
        setExpanded(!expanded);
    }

    /** 0 while collapsed, 1 while fully open, in between during the animation. */
    public float expandProgress() {
        return expandProgress;
    }

    public boolean isOpening() {
        return expandProgress > EPSILON;
    }

    /** Height of the revealed content only, without this component's own body. */
    public int revealedHeight() {
        if (!isOpening()) return 0;

        return Math.round(childrenHeight() * expandProgress);
    }

    /** Offset the first child sits at; a scrollable component shifts this. */
    protected int childrenStartY() {
        return height();
    }

    @Override
    public int expandedHeight() {
        return height() + revealedHeight();
    }

    @Override
    public int layoutHeight() {
        if (!isOpening()) return height();

        return expandedHeight() + Math.round(EXPAND_PADDING * expandProgress);
    }

    @Override
    public void tick(float delta) {
        expandProgress = MorzhAnimUtil.approach(
            expandProgress,
            isExpanded() ? 1f : 0f,
            EXPAND_RESPONSIVENESS,
            delta
        );

        if (isOpening()) super.tick(delta);

        // Children are placed only after they have advanced their own
        // animations, otherwise a child would be positioned from the height it
        // had on the previous frame and the stack would drift apart mid-expand.
        layoutChildren(childrenStartY());
    }
}


