        Vec3d start = RenderUtils.center;
        if (style.get() == TracerStyle.Camera && mc.gameRenderer != null) {
            var cam = mc.gameRenderer.getCamera();
            start = new Vec3d(0, 0, 1)
                .rotateX((float) -Math.toRadians(cam.getPitch()))
                .rotateY((float) -Math.toRadians(cam.getYaw()))
                .multiply(0.25)
                .add(cam.getPos());
        }

        for (Entity entity : mc.world.getEntities()) {
            if (shouldBeIgnored(entity)) continue;

            Color color = getEntityColor(entity);

            double x = entity.prevX + (entity.getX() - entity.prevX) * event.tickDelta;
            double y = entity.prevY + (entity.getY() - entity.prevY) * event.tickDelta;
            double z = entity.prevZ + (entity.getZ() - entity.prevZ) * event.tickDelta;

            double height = entity.getBoundingBox().maxY - entity.getBoundingBox().minY;
            if (target.get() == Target.Head) y += height;
            else if (target.get() == Target.Body) y += height / 2;
            else if (style.get() == TracerStyle.Camera) y += 0.1;

            event.renderer.line(start.x, start.y, start.z, x, y, z, color);
            if (stem.get() && style.get() == TracerStyle.Lines) event.renderer.line(x, entity.getY(), z, x, entity.getY() + height, z, color);

