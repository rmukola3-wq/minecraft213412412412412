    private void applyTargetCorrection(PlayerInputEvent event) {
        DirectionalInput input = MovementInputHelper.getDirectionalInputForDegrees(
            DirectionalInput.NONE,
            MovementInputHelper.getDegreesRelativeToView(target.getPos().subtract(mc.player.getPos()), mc.player.getYaw())
        );
        event.setDirectional(input.forward(), input.backward(), input.left(), input.right());
        if (mc.player.isSwimming()) {
            boolean jump = target.getEyeY() > mc.player.getEyeY() - (mc.player.isSwimming() ? 0 : 1);
            event.input = new net.minecraft.util.PlayerInput(
                event.input.forward(), event.input.backward(), event.input.left(), event.input.right(),
                jump, event.input.sneak(), event.input.sprint()
            );
        }
    }

    private void applyZenithCorrection(PlayerInputEvent event, float referenceYaw) {
        Rotation silent = PlayerRotationManager.INSTANCE.getCurrentRotationOriginal();
        float silentYaw = silent != null ? silent.getYaw() : mc.player.getYaw();
        event.input = MovementInputHelper.remapWasd(event.input, silentYaw, referenceYaw);
    }

    /** Zenith Focus: PlayerServiceCore.method01201(1) + method00962(target, 2). */
    private float yawToZenithFocus() {
        return MovementInputHelper.zenithFocusYaw(target);
