public class StrikeManager {
    private final Pressing clickScheduler = new Pressing();
    private final StopWatch attackTimer = new StopWatch();
    private final StopWatch shieldWatch = new StopWatch();

    private final StopWatch syncTpsTimer = new StopWatch();
    private long syncTpsExtraDelay = 0L;

    private int count = 0;
    private int ticksOnBlock = 0;

    private boolean jumpSyncWaitingForLanding = false;

    void tick() {
        if (mc.player != null && mc.player.isOnGround()) {
            ticksOnBlock++;
        } else {
            ticksOnBlock = 0;
        }
        tickJumpSync();
        SlotSprintSync.tick();
