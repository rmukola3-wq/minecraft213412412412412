package meteordevelopment.meteorclient.gui.rasty.util.render;

import net.minecraft.util.math.MathHelper;

import java.util.Random;

/** Ember / plasma trail that follows the cursor. */
public final class MenuCursorTrail {
    private static final int MAX = 36;
    private final float[] x = new float[MAX];
    private final float[] y = new float[MAX];
    private final float[] vx = new float[MAX];
    private final float[] vy = new float[MAX];
    private final float[] life = new float[MAX];
    private final float[] size = new float[MAX];
    private final Random rng = new Random();
    private float lastX = Float.NaN;
    private float lastY;
    private int cursor = 0;

    public void tick(float mx, float my, float dt) {
        tick(mx, my, dt, meteordevelopment.meteorclient.systems.modules.render.CursorEmber.riseMul());
    }

    public void tick(float mx, float my, float dt, float riseMul) {
        for (int i = 0; i < MAX; i++) {
            if (life[i] <= 0f) continue;
            life[i] -= dt * 2.6f;
            x[i] += vx[i] * dt;
            y[i] += vy[i] * dt;
            vx[i] *= 0.90f;
            vy[i] -= 55f * dt * riseMul;
        }

        if (!Float.isNaN(lastX)) {
            float dx = mx - lastX;
            float dy = my - lastY;
            float dist = (float) Math.hypot(dx, dy);
            int n = Math.min(5, 1 + (int) (dist / 3.5f));
            for (int k = 0; k < n; k++) {
                float t = n == 1 ? 0f : k / (float) n;
                spawn(mx - dx * t, my - dy * t, dist, riseMul);
            }
        } else {
            spawn(mx, my, 0f, riseMul);
        }
        lastX = mx;
        lastY = my;
    }

    public void drawGui(net.minecraft.client.gui.DrawContext context) {
        boolean was3d = meteordevelopment.meteorclient.utils.Utils.rendering3D;
        meteordevelopment.meteorclient.utils.Utils.rendering3D = false;
        try {
        int packed = meteordevelopment.meteorclient.systems.modules.render.CursorEmber.color();
        float sizeMul = meteordevelopment.meteorclient.systems.modules.render.CursorEmber.sizeMul();
        for (int i = 0; i < MAX; i++) {
            if (life[i] <= 0.02f) continue;
            float t = MathHelper.clamp(life[i], 0f, 1f);
            float s = size[i] * (0.45f + t) * sizeMul;
            int outer = meteordevelopment.meteorclient.systems.modules.render.CursorEmber.withAlpha(packed, t * t * 0.55f);
            int core  = meteordevelopment.meteorclient.systems.modules.render.CursorEmber.withAlpha(0xFFFFFFFF, t * 0.9f);
            int ember = meteordevelopment.meteorclient.systems.modules.render.CursorEmber.withAlpha(0xFFFF7A3A, t * t * 0.4f);
            meteordevelopment.meteorclient.gui.morzh.dropdown.DropDownDraw.rounded(context, x[i] - s, y[i] - s, s * 2f, s * 2f, s, outer);
            meteordevelopment.meteorclient.gui.morzh.dropdown.DropDownDraw.rounded(context, x[i] - s * 0.65f, y[i] - s * 0.5f, s * 1.3f, s * 1.3f, s * 0.65f, ember);
            meteordevelopment.meteorclient.gui.morzh.dropdown.DropDownDraw.rounded(context, x[i] - s * 0.25f, y[i] - s * 0.25f, s * 0.5f, s * 0.5f, s * 0.25f, core);
        }
        } finally {
            meteordevelopment.meteorclient.utils.Utils.rendering3D = was3d;
        }
    }

    public void draw() {
        for (int i = 0; i < MAX; i++) {
            if (life[i] <= 0.02f) continue;
            float t = MathHelper.clamp(life[i], 0f, 1f);
            float s = size[i] * (0.35f + t);
            int outer = (MenuPalette.ACCENT & 0x00FFFFFF) | (MathHelper.clamp((int) (t * t * 140), 0, 255) << 24);
            int core  = (0xFFFFFF & 0x00FFFFFF) | (MathHelper.clamp((int) (t * 220), 0, 255) << 24);
            int ember = (0xFF7A3A & 0x00FFFFFF) | (MathHelper.clamp((int) (t * t * 90), 0, 255) << 24);
            Render2D.rect(x[i] - s, y[i] - s, s * 2f, s * 2f, outer, s);
            Render2D.rect(x[i] - s * 0.7f, y[i] - s * 0.55f, s * 1.4f, s * 1.4f, ember, s * 0.7f);
            Render2D.rect(x[i] - s * 0.28f, y[i] - s * 0.28f, s * 0.56f, s * 0.56f, core, s * 0.28f);
        }
    }

    private void spawn(float mx, float my, float speed, float riseMul) {
        int i = cursor++ % MAX;
        life[i] = 0.85f + rng.nextFloat() * 0.25f;
        x[i] = mx + (rng.nextFloat() - 0.5f) * 3f;
        y[i] = my + (rng.nextFloat() - 0.5f) * 3f;
