package meteordevelopment.meteorclient.systems.modules.misc.delta;

import net.minecraft.client.MinecraftClient;
import net.minecraft.item.Item;
import net.minecraft.item.ItemStack;
import net.minecraft.item.Items;
import net.minecraft.item.tooltip.TooltipType;
import net.minecraft.scoreboard.Scoreboard;
import net.minecraft.scoreboard.Team;
import net.minecraft.util.Formatting;

import java.util.List;
import java.util.Locale;

/**
 * Delta {@code ServerUtil.a.a$(ItemStack)} / {@code e()} for FunTime AH.
 * Needle is {@code "$ Ценa: "} with a latin {@code a} in «Цена» — that is how FunTime writes lore.
 */
public final class FunTimeAh {
    /** Exact Delta string: Cyrillic Ц е н + Latin a. */
    private static final String DELTA_NEEDLE = "$ Ценa: ";
    private static final String[] NEEDLES = {
        DELTA_NEEDLE,
        "$ Цена: ",
        "$ цена: ",
        "Цена: ",
        "цена: "
    };

    private FunTimeAh() {
    }

    /** Unit price, same as Delta {@code ServerUtil.a.a$}. */
    public static int unitPrice(ItemStack itemStack) {
        MinecraftClient mc = MinecraftClient.getInstance();
        if (itemStack.isEmpty()) return -1;
        if (itemStack.getItem().getName().getString().contains("Товар не актуален") || itemStack.getItem() == Items.GRAY_DYE) {
            return -1;
        }

        List<String> tooltipLines = itemStack.getTooltip(Item.TooltipContext.DEFAULT, mc.player, TooltipType.BASIC).stream()
            .skip(1L)
            .map(line -> line.getString())
            .toList();

        for (String line : tooltipLines) {
            int parsed = parseDeltaLine(line, itemStack.getCount());
            if (parsed > 0) return parsed;
        }
        for (String line : tooltipLines) {
            int parsed = parseDeltaLine(strip(line), itemStack.getCount());
            if (parsed > 0) return parsed;
        }
        return -1;
    }

    /** Full lot = unit * count (AH lore is per-item after Delta divide). */
    public static long lotPrice(ItemStack itemStack) {
        int unit = unitPrice(itemStack);
        if (unit <= 0) return -1;
        return (long) unit * Math.max(itemStack.getCount(), 1);
    }

    private static int parseDeltaLine(String line, int count) {
        if (line == null || line.isEmpty()) return -1;
        for (String needle : NEEDLES) {
            int idx = indexOfIgnoreLatinA(line, needle);
            if (idx < 0) continue;
            String price = line.substring(idx + needle.length()).trim().replace(",", "").replace("$", "").replaceAll("\\s+", "");
            price = price.replaceAll("[^0-9]", "");
            if (price.isEmpty()) continue;
            try {
                return Integer.parseInt(price) / (count > 0 ? count : 1);
            } catch (NumberFormatException e) {
                return -1;
            }
        }
        return -1;
    }

    /** Match needle where «а» in Цена may be Latin a or Cyrillic а. */
    private static int indexOfIgnoreLatinA(String line, String needle) {
        int direct = line.indexOf(needle);
        if (direct >= 0) return direct;
        String folded = foldPriceWord(line);
        String foldedNeedle = foldPriceWord(needle);
        return folded.indexOf(foldedNeedle);
    }

    private static String foldPriceWord(String s) {
        return s.replace('a', 'а').replace('A', 'А');
    }

    private static String strip(String s) {
        String t = Formatting.strip(s);
        return t == null ? s : t;
    }

    /**
     * Delta {@code ServerUtil.a.e()} — coins from scoreboard team prefix.
     * Upstream does {@code lastIndexOf("") + 1} which is always {@code length + 1} and crashes.
     */
    public static long balance() {
        MinecraftClient mc = MinecraftClient.getInstance();
        if (mc.world == null) return -1L;
        Scoreboard scoreboard = mc.world.getScoreboard();
        for (Team team : scoreboard.getTeams()) {
            String message = team.getPrefix().getString().toLowerCase(Locale.ROOT);
            if (!message.contains("монет")) continue;
            String digits = message.replaceAll("[^0-9]", "");
            if (digits.isEmpty()) continue;
            try {
                return Long.parseLong(digits);
            } catch (NumberFormatException ignored) {
            }
        }
        return -1L;
    }
}


