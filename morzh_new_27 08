/**
 * Throws a pearl on a dedicated throw-bind, or once when the module is turned on
 * (so binding Click Pearl itself works). Pearls can be in hotbar or inventory.
 */
public class ClickPearl extends Module {
    private final SettingGroup sg = settings.getDefaultGroup();

    private final Setting<Keybind> throwBind = sg.add(new KeybindSetting.Builder()
        .name("throw-bind")
        .description("Отдельная клавиша кидка. Не путать с биндом самого модуля сверху.")
        .defaultValue(Keybind.fromButton(GLFW.GLFW_MOUSE_BUTTON_MIDDLE))
        .build()
    );

    private final Setting<Boolean> throwOnEnable = sg.add(new BoolSetting.Builder()
        .name("enable-throw")
        .description("Кидает жемчуг при включении модуля. Оставь выкл, если хочешь держать модуль всегда включённым.")
        .defaultValue(false)
        .build()
    );

    private final Setting<Boolean> autoDisable = sg.add(new BoolSetting.Builder()
        .name("disable-after-throw")
        .description("Выключает модуль после кидка при включении.")
        .defaultValue(false)
        .visible(throwOnEnable::get)
        .build()
    );

    private final Setting<Boolean> whileEating = sg.add(new BoolSetting.Builder()
        .name("пока-ешь")
        .description("Вкл — прервать еду и кинуть перл. Выкл — не кидать, пока ешь.")
        .defaultValue(true)
        .build()
    );

    private int restoreSlot = -1;
    private int restoreTicks;
    private boolean disableNextTick;

    public ClickPearl() {
        super(Categories.Player, "click-pearl", "Кидает эндер-жемчуг по бинду в направлении камеры.");
    }

    @Override
    public void onActivate() {
        disableNextTick = false;
        if (!throwOnEnable.get()) return;
        if (mc.currentScreen != null) return;
        throwPearl();
        disableNextTick = autoDisable.get();
    }

    @Override
    public void onDeactivate() {
        disableNextTick = false;
    }

    @EventHandler
    private void onKey(KeyEvent event) {
        if (event.action != KeyAction.Press) return;
        if (throwBind.get().matches(true, event.key, event.modifiers)) throwPearl();
    }

    @EventHandler
    private void onMouse(MouseButtonEvent event) {
        if (event.action != KeyAction.Press) return;
        if (throwBind.get().matches(false, event.button, 0)) {
            throwPearl();
            event.cancel();
        }
    }

    @EventHandler
    private void onTick(TickEvent.Post event) {
        if (disableNextTick) {
            disableNextTick = false;
            if (isActive()) toggle();
            return;
        }

        if (restoreTicks <= 0 || restoreSlot < 0) return;
        restoreTicks--;
        if (restoreTicks == 0) {
            InvUtils.swap(restoreSlot, false);
            restoreSlot = -1;
        }
    }

    private void throwPearl() {
        if (mc.player == null || mc.interactionManager == null || mc.world == null) return;
        if (mc.currentScreen != null) return;

        if (mc.player.isUsingItem() && !whileEating.get()) return;
        if (whileEating.get()) cancelUse();

        if (mc.player.getItemCooldownManager().isCoolingDown(Items.ENDER_PEARL.getDefaultStack())) return;

        if (mc.player.getOffHandStack().isOf(Items.ENDER_PEARL)) {
            usePearl(Hand.OFF_HAND);
            return;
        }

        FindItemResult pearl = InvUtils.find(Items.ENDER_PEARL);
        if (!pearl.found()) return;

        int previous = mc.player.getInventory().selectedSlot;

        if (pearl.isHotbar()) {
            restoreSlot = previous;
            InvUtils.swap(pearl.slot(), false);
            usePearl(Hand.MAIN_HAND);
            restoreTicks = 1;
            return;
        }

        InvUtils.move().from(pearl.slot()).to(previous);
        usePearl(Hand.MAIN_HAND);
        InvUtils.move().from(previous).to(pearl.slot());
    }

    private void usePearl(Hand hand) {
        float yaw = mc.player.getYaw();
        float pitch = mc.player.getPitch();
        try {
            ((ClientPlayerInteractionManagerInvoker) mc.interactionManager).meteor$sendSequencedPacket(
                mc.world,
                seq -> new PlayerInteractItemC2SPacket(hand, seq, yaw, pitch)
            );
        } catch (Throwable ignored) {
            mc.interactionManager.interactItem(mc.player, hand);
        }
        mc.player.swingHand(hand);
    }

    private void cancelUse() {
        AutoGap gap = Modules.get().get(AutoGap.class);
        if (gap != null) gap.interruptForPearl();
        AutoEat eat = Modules.get().get(AutoEat.class);
        if (eat != null) eat.interruptForPearl();
        mc.options.useKey.setPressed(false);
        if (mc.player.isUsingItem()) {
            mc.interactionManager.stopUsingItem(mc.player);
            mc.player.networkHandler.sendPacket(new PlayerActionC2SPacket(
                PlayerActionC2SPacket.Action.RELEASE_USE_ITEM, BlockPos.ORIGIN, Direction.DOWN
            ));
            mc.player.stopUsingItem();
        }
    }
}


