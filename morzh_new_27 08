package meteordevelopment.meteorclient.gui.morzh;

import meteordevelopment.meteorclient.gui.themes.morzh.MorzhGuiColors;
import meteordevelopment.meteorclient.settings.Setting;
import meteordevelopment.meteorclient.settings.SettingGroup;
import meteordevelopment.meteorclient.systems.config.Config;
import meteordevelopment.meteorclient.systems.modules.Module;
import meteordevelopment.meteorclient.utils.sound.MorzhSoundManager;

/**
 * A single module strip. Left click toggles the module, right click reveals its
 * settings underneath — the settings are real children, so the panel above
 * automatically reserves room for them.
 */
public class MorzhModuleComponent extends MorzhExpandableComponent {
    public static final int ROW_HEIGHT = 15;

    private static final int SETTING_INSET = 1;
    private static final float TOGGLE_RESPONSIVENESS = 14f;

    private final Module module;

    private float enabledProgress;
    private float hoverProgress;
    private boolean matchesSearch = true;

    public MorzhModuleComponent(
        MorzhComponent parent,
        Module module,
        int x,
        int y,
        int width
    ) {
        super(parent, module.title, x, y, width, ROW_HEIGHT);

        this.module = module;
        this.enabledProgress = module.isActive() ? 1f : 0f;

        int settingWidth = width - SETTING_INSET * 2;

        for (SettingGroup group : module.settings) {
            for (Setting<?> setting : group) {
                children.add(
                    MorzhSettingComponent.create(
                        this,
                        setting,
                        SETTING_INSET,
                        ROW_HEIGHT,
                        settingWidth
                    )
                );
            }
        }
    }

    public Module module() {
        return module;
    }

    public void applySearch(String query) {
        matchesSearch = module.matchesSearch(query);
    }

    @Override
    public boolean isVisible() {
        return matchesSearch
            && !Config.get().hiddenModules.get().contains(module);
    }

    @Override
    public void tick(float delta) {
        enabledProgress = MorzhAnimUtil.approach(
            enabledProgress,
            module.isActive() ? 1f : 0f,
            TOGGLE_RESPONSIVENESS,
            delta
        );

        super.tick(delta);
    }

    @Override
    public void render(MorzhGuiContext context) {
        float left = absoluteX();
        float top = absoluteY();

        // A row scrolled out of the panel is still submitted for drawing, it is
        // just clipped away, so hover has to respect the clip too.
        boolean hovered = isHovered(context.mouseX, context.mouseY)
            && MorzhScissor.contains(context.mouseX, context.mouseY);

        hoverProgress = MorzhAnimUtil.approach(
            hoverProgress,
            hovered ? 1f : 0f,
            TOGGLE_RESPONSIVENESS,
            context.delta
        );

        int background = MorzhGuiColors.interpolateArgb(
            MorzhGuiColors.packed(MorzhGuiColors.ROW_BG),
            MorzhGuiColors.packed(MorzhGuiColors.ROW_HOVER),
            hoverProgress
        );

        MorzhSmoothRenderer.roundedRect(
            context.draw,
            left,
            top,
            width(),
            ROW_HEIGHT,
            0f,
            context.fade(background)
        );

        // Accent bar on the left edge grows in as the module turns on, which is
        // what makes an enabled row readable at a glance.
        if (enabledProgress > 0.01f) {
            float barHeight = (ROW_HEIGHT - 4f) * enabledProgress;

            MorzhSmoothRenderer.roundedRect(
                context.draw,
                left,
                top + (ROW_HEIGHT - barHeight) / 2f,
                1.5f,
                barHeight,
                0.75f,
                context.fade(MorzhGuiColors.packed(MorzhGuiColors.ACCENT))
            );
        }

        int textColor = MorzhGuiColors.interpolateArgb(
            MorzhGuiColors.packed(MorzhGuiColors.TEXT_MUTED),
            MorzhGuiColors.packed(MorzhGuiColors.TEXT_ENABLED),
            enabledProgress
        );

        String title = MorzhSmoothRenderer.fitText(module.title, width() - 18);

        double titleWidth = MorzhSmoothRenderer.textWidth(title);
        double textHeight = MorzhSmoothRenderer.textHeight();

        MorzhSmoothRenderer.text(
            context.draw,
            title,
            left + (width() - titleWidth) / 2f,
            top + (ROW_HEIGHT - textHeight) / 2f,
            context.fade(textColor),
            false
        );

        if (canExpand()) {
            String arrow = expandProgress() > 0.5f ? "<" : ">";

            MorzhSmoothRenderer.text(
                context.draw,
                arrow,
                left + width() - 8f,
                top + (ROW_HEIGHT - textHeight) / 2f,
                context.fade(
                    MorzhGuiColors.packed(MorzhGuiColors.TEXT_MUTED)
                ),
                false
            );
        }

        if (hovered
            && module.description != null
            && !module.description.isEmpty()) {
            context.tooltip = module.description;
        }

        renderSettings(context);
    }

    private void renderSettings(MorzhGuiContext context) {
        int revealed = revealedHeight();

        if (revealed <= 0) return;

        MorzhScissor.push(
            absoluteX(),
            absoluteY() + ROW_HEIGHT,
            width(),
            revealed
        );

        super.render(context);

        MorzhScissor.pop();
    }

    @Override
    public boolean mouseClicked(double mouseX, double mouseY, int button) {
        if (isWithinReveal(mouseY)
            && super.mouseClicked(mouseX, mouseY, button)) {
            return true;
        }

        if (!isHovered(mouseX, mouseY)) return false;

        if (button == 0) {
            module.toggle();
            return true;
        }

        if (button == 1 && canExpand()) {
            toggleExpanded();
            MorzhSoundManager.playBoolean();

            return true;
        }

        return false;
    }

    @Override
    public boolean mouseDragged(double mouseX, double mouseY, int button) {
        return isOpening() && super.mouseDragged(mouseX, mouseY, button);
    }

    /** Clicks only reach a setting while it is actually painted. */
    private boolean isWithinReveal(double mouseY) {
        if (!isOpening()) return false;

        int top = absoluteY() + ROW_HEIGHT;

        return mouseY >= top && mouseY < top + revealedHeight();
    }
}


