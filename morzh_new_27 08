    private boolean grimFlag;
    private int grimTicks;
    private int lagCooldown;
    private Vec3d lastMotion = Vec3d.ZERO;
    private boolean gotVelocity;
    private boolean wasHurt;
    private boolean jumped;

    public Velocity() {
        super(Categories.Movement, "velocity", "Prevents you from being moved by external forces.");
    }

    @Override
    public void onActivate() {
        grimFlag = false;
        grimTicks = 0;
        lagCooldown = 0;
        lastMotion = Vec3d.ZERO;
        gotVelocity = false;
        wasHurt = false;
        jumped = false;
    }

    @EventHandler
    private void onTick(TickEvent.Post event) {
        if (lagCooldown > 0) lagCooldown--;

        if (mode.get() == Mode.Grim && grimFlag && mc.player != null && mc.player.networkHandler != null) {
            mc.player.networkHandler.sendPacket(new PlayerMoveC2SPacket.Full(
                mc.player.getX(), mc.player.getY(), mc.player.getZ(),
                mc.player.getYaw(), mc.player.getPitch(),
                mc.player.isOnGround(), mc.player.horizontalCollision
            ));
            mc.player.networkHandler.sendPacket(new PlayerActionC2SPacket(
                PlayerActionC2SPacket.Action.STOP_DESTROY_BLOCK,
                BlockPos.ofFloored(mc.player.getPos()),
                Direction.DOWN
            ));
            grimFlag = false;
        }

        if (mode.get() == Mode.Matrix && mc.player != null && mc.player.hurtTime > 0 && !mc.player.isOnGround()) {
            double yaw = Math.toRadians(mc.player.getYaw());
            double speed = Math.hypot(mc.player.getVelocity().x, mc.player.getVelocity().z);
            mc.player.setVelocity(-Math.sin(yaw) * speed, mc.player.getVelocity().y, Math.cos(yaw) * speed);
        }

        if (mode.get() == Mode.Compensation && gotVelocity && mc.player != null) {
            if (mc.player.hurtTime > 0) wasHurt = true;
            if (wasHurt && mc.player.hurtTime == 0) {
                if (mc.player.isOnGround()) {
                    mc.player.jump();
                    jumped = true;
                }
                Vec3d updated = lastMotion.normalize().multiply(-0.2);
                mc.player.setVelocity(updated.x, updated.y, updated.z);
                wasHurt = false;
                gotVelocity = false;
            }
            if (jumped && mc.player.isOnGround()) jumped = false;
        }

        if (!sinking.get()) return;
        if (mc.options.jumpKey.isPressed() || mc.options.sneakKey.isPressed()) return;

        if ((mc.player.isTouchingWater() || mc.player.isInLava()) && mc.player.getVelocity().y < 0) {
            ((IVec3d) mc.player.getVelocity()).meteor$setY(0);
        }
    }

    @EventHandler
    private void onPacketReceive(PacketEvent.Receive event) {
        if (mc.player == null) return;
        if (event.packet instanceof PlayerPositionLookS2CPacket) lagCooldown = 5;
        if (lagCooldown > 0) return;

        if (knockback.get() && event.packet instanceof EntityVelocityUpdateS2CPacket packet
            && packet.getEntityId() == mc.player.getId()) {
            switch (mode.get()) {
                case Cancel -> event.cancel();
                case Grim -> {
                    event.cancel();
                    grimFlag = true;
                }
                case OldGrim -> {
                    event.cancel();
                    grimTicks = 6;
                }
                case Matrix -> {
                    if (!grimFlag) {
                        event.cancel();
                        grimFlag = true;
                    } else {
                        grimFlag = false;
                        ((EntityVelocityUpdateS2CPacketAccessor) packet).setX((int) (packet.getVelocityX() * -0.1));
                        ((EntityVelocityUpdateS2CPacketAccessor) packet).setZ((int) (packet.getVelocityZ() * -0.1));
                    }
                }
                case Modify -> {
                    EntityVelocityUpdateS2CPacketAccessor acc = (EntityVelocityUpdateS2CPacketAccessor) packet;
                    acc.setX((int) (packet.getVelocityX() * 8000.0 * modifierX.get() / 100.0));
                    acc.setY((int) (packet.getVelocityY() * 8000.0 * modifierY.get() / 100.0));
                    acc.setZ((int) (packet.getVelocityZ() * 8000.0 * modifierZ.get() / 100.0));
                }
                case Compensation -> {
                    lastMotion = new Vec3d(
                        packet.getVelocityX() * 8000.0,
                        packet.getVelocityY() * 8000.0,
                        packet.getVelocityZ() * 8000.0
                    );
                    gotVelocity = true;
                }
            }
        }

        if (mode.get() == Mode.OldGrim && grimTicks > 0 && event.packet instanceof CommonPingS2CPacket) {
            event.cancel();
            grimTicks--;
        }
    }

    public double getHorizontal(Setting<Double> setting) {
        return isActive() ? setting.get() : 1;
    }

    public double getVertical(Setting<Double> setting) {
        return isActive() ? setting.get() : 1;
    }

    public enum Mode {
        Cancel,
        Modify,
        Compensation,
        Grim,
        OldGrim,
        Matrix
    }
}


