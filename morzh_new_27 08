public class CfgTab extends Tab {
    public CfgTab() {
        super("Configs");
    }

    @Override
    public TabScreen createScreen(GuiTheme theme) {
        return new CfgScreen(theme, this);
    }

    @Override
    public boolean isScreen(Screen screen) {
        return screen instanceof CfgScreen;
    }

    public static class CfgScreen extends WindowTabScreen {
        public CfgScreen(GuiTheme theme, Tab tab) {
            super(theme, tab);
        }

        @Override
        public void initWidgets() {
