package meteordevelopment.meteorclient.commands.commands;

import com.mojang.brigadier.arguments.StringArgumentType;
import com.mojang.brigadier.builder.LiteralArgumentBuilder;
import meteordevelopment.meteorclient.commands.Command;
import meteordevelopment.meteorclient.commands.arguments.CfgArgumentType;
import meteordevelopment.meteorclient.systems.cfg.CfgManager;
import net.minecraft.command.CommandSource;

import java.util.List;

public class CfgCommand extends Command {
    public CfgCommand() {
        super("cfg", "Save/load shareable config files.", "config");
    }

    @Override
    public void build(LiteralArgumentBuilder<CommandSource> builder) {
        builder.then(literal("save").then(argument("name", StringArgumentType.greedyString()).suggests((ctx, b) -> {
            for (String name : CfgManager.list()) b.suggest(name);
            return b.buildFuture();
        }).executes(context -> {
            String name = CfgManager.sanitize(StringArgumentType.getString(context, "name"));
            if (name == null) {
                error("Invalid cfg name.");
                return SINGLE_SUCCESS;
            }
            if (CfgManager.save(name)) info("Saved cfg (highlight)%s(default) to cfgs/%s.cfg", name, name);
            else error("Failed to save cfg (highlight)%s(default).", name);
            return SINGLE_SUCCESS;
        })));

        builder.then(literal("load").then(argument("cfg", CfgArgumentType.create()).executes(context -> {
            String name = CfgArgumentType.get(context);
            if (CfgManager.load(name)) info("Loaded cfg (highlight)%s(default).", name);
            else error("Failed to load cfg (highlight)%s(default).", name);
            return SINGLE_SUCCESS;
        })));

        builder.then(literal("delete").then(argument("cfg", CfgArgumentType.create()).executes(context -> {
            String name = CfgArgumentType.get(context);
            if (CfgManager.delete(name)) info("Deleted cfg (highlight)%s(default).", name);
            else error("Failed to delete cfg (highlight)%s(default).", name);
            return SINGLE_SUCCESS;
        })));

        builder.then(literal("copy").then(argument("cfg", CfgArgumentType.create()).then(
            argument("name", StringArgumentType.greedyString()).executes(context -> {
                String from = CfgArgumentType.get(context);
                String to = CfgManager.sanitize(StringArgumentType.getString(context, "name"));
                if (to == null) {
                    error("Invalid dest name.");
                    return SINGLE_SUCCESS;
                }
                if (CfgManager.copy(from, to)) info("Copied (highlight)%s(default) -> (highlight)%s(default).", from, to);
                else error("Failed to copy cfg.");
                return SINGLE_SUCCESS;
            })
        )));

        builder.then(literal("list").executes(context -> {
            List<String> names = CfgManager.list();
            if (names.isEmpty()) {
                info("No cfg files. Folder: meteor-client/cfgs");
                return SINGLE_SUCCESS;
            }
            info("Cfgs (%s):", names.size());
            for (String name : names) info(" - (highlight)%s(default)", name);
            return SINGLE_SUCCESS;
        }));

        builder.then(literal("dir").executes(context -> {
            CfgManager.openFolder();
            info("Opened (highlight)meteor-client/cfgs(default). Copy .cfg files from there.");
            return SINGLE_SUCCESS;
        }));
    }
}


