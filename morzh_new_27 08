    public Ambience() {
        super(Categories.World, "ambience", "Настраивает атмосферу и окружение игрового мира");
    }

    /** Fast path for mixins — no map lookup when the module is off. */
    public static Ambience get() {
        Modules modules = Modules.get();
        return modules == null ? null : modules.get(Ambience.class);
    }

    private boolean isDeltaProfile() {
        return profile.get() == Profile.Delta;
    }

    private boolean notDelta() {
        return !isDeltaProfile();
    }

    public boolean deltaActive() {
        return isActive() && isDeltaProfile();
    }

    @Override
    public void onActivate() {
        animatedTime = wildTime.get();
        if (needsChunkReload()) requestChunkReload();
    }

    @Override
    public void onDeactivate() {
        chunkReloadDelay = 0;
        if (needsChunkReload() && mc.worldRenderer != null) mc.worldRenderer.reload();
    }

    @EventHandler
    private void onPacketReceive(PacketEvent.Receive event) {
        if (isDeltaProfile()) return;
        if (changeTime.get() && event.packet instanceof WorldTimeUpdateS2CPacket) {
            event.cancel();
        }
    }

    @EventHandler
    private void onTick(TickEvent.Post event) {
        if (chunkReloadDelay > 0 && --chunkReloadDelay == 0 && isActive() && mc.worldRenderer != null) {
            mc.worldRenderer.reload();
        }
        if (mc.world == null || isDeltaProfile() || !changeTime.get() || profile.get() != Profile.Wild) return;
        double target = wildTime.get();
        animatedTime += (target - animatedTime) * 0.15;
    }

    private long currentTimeTicks() {
        return switch (profile.get()) {
            case ThunderHack -> timeOfDay.get() * 1000L;
            case Delta -> mc.world == null ? 1000L : mc.world.getTimeOfDay();
            case Expensive -> expensiveTime.get().ticks;
            case Wild -> (long) animatedTime;
        };
    }

    /** Mixin path: never writes world time (avoids lighting rebuilds every tick). */
    public long overlayTimeOfDay(long original) {
        if (!isActive()) return original;
        if (isDeltaProfile()) return deltaTimeOfDay(original);
        if (nightSkybox()) return 18000L;
        if (!changeTime.get()) return original;
        return currentTimeTicks();
    }

    private boolean nightSkybox() {
        Skybox box = skybox.get();
        return box == Skybox.Night || box == Skybox.GalaxyNight;
    }

    public float overlayRainGradient(float original) {
        if (!isActive()) return original;
        if (isDeltaProfile()) return deltaRainGradient(original);
        if (!changeWeather.get() || profile.get() != Profile.ThunderHack) return original;
        return switch (weather.get()) {
            case Unchanged -> original;
            case Clear -> 0.0f;
            case Rain, Storm -> 1.0f;
            case Snow -> 0.9f;
        };
    }

    public float overlayThunderGradient(float original) {
        if (!isActive()) return original;
        if (isDeltaProfile()) return deltaThunderGradient(original);
        if (!changeWeather.get() || profile.get() != Profile.ThunderHack) return original;
        return switch (weather.get()) {
            case Storm -> 1.0f;
            case Unchanged -> original;
            default -> 0.0f;
        };
    }

    private void applyProfileDefaults(Profile next) {
        if (next == Profile.Delta) {
            deltaWeather.set(DeltaWeather.Unchanged);
            deltaTime.set(DeltaTime.Unchanged);
            deltaCustomFog.set(false);
            deltaFogColor.set(new SettingColor(255, 255, 255, 255));
            deltaFogDistance.set(-8.0);
            deltaFogDensity.set(100.0);
        }
    }

    private boolean needsChunkReload() {
        return customGrassColor.get() || customFoliageColor.get() || customWaterColor.get() || customLavaColor.get();
    }

    private void requestChunkReload() {
        if (!isActive() || !needsChunkReload()) return;
        chunkReloadDelay = 8;
    }

