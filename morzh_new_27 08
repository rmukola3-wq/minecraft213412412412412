import java.util.concurrent.TimeUnit;

public class Stopwatch {
    public boolean started;
    public long startTime;
    public long pausedTime;
    public boolean paused;

    public Stopwatch(boolean start) {
        if (start) reset();
    }

    public Stopwatch() {
        reset();
    }

    public void reset() {
        startTime = System.nanoTime();
        paused = false;
        pausedTime = 0L;
        started = true;
    }

    public boolean hasElapsed(long amount) {
        return hasElapsed(amount, TimeUnit.MILLISECONDS);
    }

    public boolean hasElapsed(long amount, TimeUnit unit) {
        if (getElapsedTime(unit) < amount) return false;
        started = false;
        return true;
    }

    public long getElapsedTime(TimeUnit unit) {
        return unit.convert(computeElapsedNanos(), TimeUnit.NANOSECONDS);
    }

    public long computeElapsedNanos() {
        return paused ? pausedTime - startTime : System.nanoTime() - startTime;
    }
}


