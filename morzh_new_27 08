public class FunTimeBinds extends Module {
    public enum Server {
        FunTime,
        SpookyTime,
        HolyWorld
    }

    private final SettingGroup sg = settings.getDefaultGroup();
    private final SettingGroup sgFt = settings.createGroup("FunTime / Spooky");
    private final SettingGroup sgHw = settings.createGroup("HolyWorld");

    private final Setting<Server> server = sg.add(new EnumSetting.Builder<Server>()
        .name("сервер")
        .defaultValue(Server.FunTime)
        .build()
    );

    private final Setting<Keybind> trap = bind(sgFt, "трапка", Items.NETHERITE_SCRAP, true);
    private final Setting<Keybind> snow = bind(sgFt, "снежок-заморозка", Items.SNOWBALL, true);
    private final Setting<Keybind> stratum = bind(sgFt, "пласт", Items.DRIED_KELP, true);
    private final Setting<Keybind> disorient = bind(sgFt, "дезориентация", Items.ENDER_EYE, true);
    private final Setting<Keybind> dust = bind(sgFt, "явная-пыль", Items.SUGAR, true);
    private final Setting<Keybind> fire = bind(sgFt, "огненный-заряд", Items.FIRE_CHARGE, true);
    private final Setting<Keybind> wind = bind(sgFt, "заряд-ветра", Items.WIND_CHARGE, true);
    private final Setting<Keybind> aura = bind(sgFt, "божья-аура", Items.PHANTOM_MEMBRANE, true);

    private final Setting<Keybind> hwSnow = bind(sgHw, "ком-снега", Items.SNOWBALL, false);
    private final Setting<Keybind> hwStun = bind(sgHw, "стан", Items.NETHER_STAR, false);
    private final Setting<Keybind> hwTrap = bind(sgHw, "взрывная-трапка", Items.PRISMARINE_SHARD, false);
    private final Setting<Keybind> hwRod = bind(sgHw, "взрывная-палочка", Items.BLAZE_ROD, false);
    private final Setting<Keybind> hwCharge = bind(sgHw, "взрывная-штучка", Items.FIRE_CHARGE, false);

    public FunTimeBinds() {
        super(Categories.Misc, "funtime-binds", "Бинды предметов FunTime/Spooky/HolyWorld как в Delta Server Assistant.");
    }

    private Setting<Keybind> bind(SettingGroup group, String name, Item item, boolean funtime) {
        return group.add(new KeybindSetting.Builder()
            .name(name)
            .description("Использует " + item.getName().getString())
            .defaultValue(Keybind.none())
            .visible(() -> funtime ? server.get() != Server.HolyWorld : server.get() == Server.HolyWorld)
            .build()
        );
    }

    @EventHandler
    private void onKey(KeyEvent event) {
        if (event.action != KeyAction.Press) return;
        handle(true, event.key, event.modifiers);
    }

    @EventHandler
    private void onMouse(MouseButtonEvent event) {
        if (event.action != KeyAction.Press) return;
        handle(false, event.button, 0);
    }

    private void handle(boolean key, int value, int modifiers) {
        if (mc.currentScreen != null) return;
        if (server.get() == Server.HolyWorld) {
            useIf(hwSnow, key, value, modifiers, Items.SNOWBALL, "Ком снега");
            useIf(hwStun, key, value, modifiers, Items.NETHER_STAR, "Стан");
            useIf(hwTrap, key, value, modifiers, Items.PRISMARINE_SHARD, "Взрывная трапка");
            useIf(hwRod, key, value, modifiers, Items.BLAZE_ROD, "Взрывная палочка");
            useIf(hwCharge, key, value, modifiers, Items.FIRE_CHARGE, "Взрывная штучка");
            return;
        }
        useIf(trap, key, value, modifiers, Items.NETHERITE_SCRAP, "Трапка");
        useIf(snow, key, value, modifiers, Items.SNOWBALL, "Снежок заморозка");
        useIf(stratum, key, value, modifiers, Items.DRIED_KELP, "Пласт");
        useIf(disorient, key, value, modifiers, Items.ENDER_EYE, "Дезориентация");
        useIf(dust, key, value, modifiers, Items.SUGAR, "Явная пыль");
        useIf(fire, key, value, modifiers, Items.FIRE_CHARGE, "Огненный заряд");
        useIf(wind, key, value, modifiers, Items.WIND_CHARGE, "Заряд ветра");
        useIf(aura, key, value, modifiers, Items.PHANTOM_MEMBRANE, "Божья аура");
    }

    private void useIf(Setting<Keybind> bind, boolean key, int value, int modifiers, Item item, String name) {
        if (!bind.get().matches(key, value, modifiers)) return;
        if (mc.player.getItemCooldownManager().isCoolingDown(item.getDefaultStack())) {
            ChatUtils.errorPrefix("Binds", name + " — задержка");
            return;
        }
        FindItemResult found = InvUtils.find(item);
        if (!found.found()) {
            ChatUtils.errorPrefix("Binds", name + " — нет в инвентаре");
            return;
        }
        int previous = mc.player.getInventory().selectedSlot;
        if (found.getHand() == Hand.OFF_HAND) {
            interact(Hand.OFF_HAND);
            return;
        }
        if (found.isHotbar()) {
            InvUtils.swap(found.slot(), false);
            interact(Hand.MAIN_HAND);
            InvUtils.swap(previous, false);
            return;
        }
        InvUtils.move().from(found.slot()).to(previous);
        interact(Hand.MAIN_HAND);
        InvUtils.move().from(previous).to(found.slot());
    }

    private void interact(Hand hand) {
        float yaw = mc.player.getYaw();
        float pitch = mc.player.getPitch();
        try {
            ((ClientPlayerInteractionManagerInvoker) mc.interactionManager).meteor$sendSequencedPacket(
                mc.world,
                seq -> new PlayerInteractItemC2SPacket(hand, seq, yaw, pitch)
            );
        } catch (Throwable ignored) {
            mc.interactionManager.interactItem(mc.player, hand);
        }
        mc.player.swingHand(hand);
    }
}


