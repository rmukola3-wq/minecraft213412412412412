        ))
        .build()
    );

    private int cooldown;
    private UUID lastEz;
    private final Map<UUID, Long> recentHits = new HashMap<>();

    public AutoEZ() {
        super(Categories.Misc, "auto-ez", "Sends a Morzh EZ after a kill.");
    }

    @Override
    public void onActivate() {
        cooldown = 0;
        lastEz = null;
        recentHits.clear();
    }

    @EventHandler
    private void onLeave(GameLeftEvent event) {
        recentHits.clear();
        lastEz = null;
    }

    @EventHandler
    private void onAttack(AttackEntityEvent event) {
        if (event.entity instanceof PlayerEntity player && player != mc.player) {
            recentHits.put(player.getUuid(), System.currentTimeMillis());
        }
    }

    @EventHandler
    private void onTick(TickEvent.Post event) {
        if (cooldown > 0) cooldown--;
        if (mc.player == null || mc.world == null) return;

        if (isLocalDead()) {
            recentHits.clear();
            lastEz = null;
            return;
        }

        long now = System.currentTimeMillis();
        recentHits.entrySet().removeIf(e -> now - e.getValue() > HIT_WINDOW_MS);

        for (PlayerEntity player : mc.world.getPlayers()) {
            if (player == mc.player) continue;
            if (Friends.get().isFriend(player)) continue;

            Long hitAt = recentHits.get(player.getUuid());
            if (hitAt == null || now - hitAt > HIT_WINDOW_MS) continue;

            boolean dead = !player.isAlive() || player.getHealth() <= 0 || player.isDead();
            if (!dead) {
                if (player.getUuid().equals(lastEz)) lastEz = null;
                continue;
            }
            if (player.getUuid().equals(lastEz)) continue;

            say(player.getName().getString());
            lastEz = player.getUuid();
            recentHits.remove(player.getUuid());
            return;
        }
    }

    @EventHandler
    private void onPacket(PacketEvent.Receive event) {
        if (!(event.packet instanceof GameMessageS2CPacket packet) || mc.player == null) return;
        if (isLocalDead()) return;

        String victim = extractOwnKillVictim(packet.content().getString());
        if (victim == null || isSelfName(victim) || mc.world == null) return;
        if (!recentlyHitName(victim)) return;

        say(victim);
    }

    private boolean recentlyHitName(String name) {
        long now = System.currentTimeMillis();
        for (PlayerEntity player : mc.world.getPlayers()) {
            if (player == mc.player) continue;
            if (!player.getName().getString().equalsIgnoreCase(name)
                && !player.getGameProfile().getName().equalsIgnoreCase(name)) continue;
            Long hitAt = recentHits.get(player.getUuid());
            return hitAt != null && now - hitAt <= HIT_WINDOW_MS;
        }
        return false;
    }

    private boolean isLocalDead() {
        return mc.player == null
            || !mc.player.isAlive()
            || mc.player.isDead()
            || mc.player.getHealth() <= 0
            || mc.player.deathTime > 0;
    }

    private boolean isSelfName(String name) {
        String self = mc.player.getGameProfile().getName();
        return name.equalsIgnoreCase(self) || name.equalsIgnoreCase(mc.player.getName().getString());
    }

    /**
     * Only first-person kill lines: "Вы убили игрока X" / "You killed X".
     * Generic death chat ("Игрок X умер") must not match.
     */
    private static String extractOwnKillVictim(String raw) {
        String text = raw.replaceAll("§.", "").trim();
        String lower = text.toLowerCase(Locale.ROOT);

        if (lower.contains("вас убил")
            || lower.contains("убил вас")
            || lower.contains("убиты")
            || lower.contains("were killed")
            || lower.contains("killed you")
            || lower.contains("slain by")
            || lower.contains("вы умерли")
            || lower.contains("you died")) {
            return null;
        }

        boolean ownKill = lower.contains("вы убили") || lower.contains("you killed");
        if (!ownKill) return null;

        String[] parts = text.split("\\s+");
        for (int i = 0; i < parts.length - 1; i++) {
            String word = stripPunct(parts[i]);
            if (!word.equalsIgnoreCase("убили") && !word.equalsIgnoreCase("killed")) continue;
            String next = stripPunct(parts[i + 1]);
            if (next.equalsIgnoreCase("игрока") && i + 2 < parts.length) {
                return stripPunct(parts[i + 2]);
            }
            if (!next.isEmpty() && !next.equalsIgnoreCase("by") && !next.equalsIgnoreCase("you")) return next;
        }

        return null;
    }

    private static String stripPunct(String word) {
        return word.replaceAll("[!.,;:]+$", "");
    }

    private void say(String name) {
        if (cooldown > 0 || mc.player == null || mc.player.networkHandler == null) return;
        if (isLocalDead()) return;
        List<String> list = messages.get();
        if (list.isEmpty()) return;

        String line = list.get(ThreadLocalRandom.current().nextInt(list.size())).replace("%player%", name);
        if (global.get()) line = "!" + line;
        mc.player.networkHandler.sendChatMessage(line);
        cooldown = delay.get();
    }
}


