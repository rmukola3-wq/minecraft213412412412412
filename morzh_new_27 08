package meteordevelopment.meteorclient.systems.modules.combat.aura.rockstar;

import meteordevelopment.meteorclient.systems.modules.combat.KillAura;
import net.minecraft.entity.LivingEntity;
import net.minecraft.util.math.MathHelper;
import net.minecraft.util.math.Vec3d;

import static meteordevelopment.meteorclient.MeteorClient.mc;

/**
 * Rockstar {@code NeuroRotation} without the CatBoost model.
 * Same closest-point GCD aim as Classic, with the Neuro speed sliders
 * and extra human jitter the predictor usually added.
 */
public final class NeuroRotation extends RockstarRotationMode {
    private final RockstarInterp interp = new RockstarInterp();

    @Override
    public void update(KillAura aura, LivingEntity target) {
        if (mc.player == null) return;

        boolean snapIdle = aura.neuroSnap()
            && (!aura.canCritical() || !aura.attackTimerPassed(300));

        if (target == null || snapIdle) {
            float[] next = interp.animate(
                mc.player.getYaw(),
                mc.player.getPitch(),
                220,
                220
            );
            yaw = next[0];
            pitch = next[1];
            return;
        }

        Vec3d point = RockstarMath.closestPoint(target);
        float[] rot = RockstarMath.anglesToEyes(point);

        float shortest = RockstarMath.wrapDelta(interp.getYaw(), rot[0]);
        float targetYaw = interp.getYaw() + shortest
            + RockstarMath.random(-1.8, 1.8);
        float targetPitch = MathHelper.clamp(
            rot[1] + RockstarMath.random(-1.2, 1.2),
            -90.0f,
            90.0f
        );

        int yawSpeed = Math.max(1, (int) (100 - aura.neuroSpeedX()));
        int pitchSpeed = Math.max(1, (int) (100 - aura.neuroSpeedY()));

        float[] next = interp.animate(targetYaw, targetPitch, yawSpeed, pitchSpeed);
        yaw = next[0];
        pitch = MathHelper.clamp(next[1], -90.0f, 90.0f);

        float[] snapped = RockstarMath.correctRotation(yaw, pitch);
        yaw = snapped[0];
        pitch = snapped[1];
    }

    @Override
    public void reset(int reason) {
        super.reset(reason);
        if (mc.player == null) return;

        if (reason > 0) {
            float shortest = RockstarMath.wrapDelta(yaw, mc.player.getYaw());
            mc.player.setYaw(yaw + shortest);
        }

        interp.reset(mc.player.getYaw(), mc.player.getPitch());
        yaw = mc.player.getYaw();
        pitch = mc.player.getPitch();
    }
}


