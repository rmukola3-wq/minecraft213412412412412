                    if (!swarm.isActive()) swarm.toggle();

                    swarm.close();
                    swarm.mode.set(Swarm.Mode.Worker);
                    swarm.worker = new SwarmWorker(pendingConnection.left(), pendingConnection.rightInt());

                    pendingConnection = null;

                    try {
