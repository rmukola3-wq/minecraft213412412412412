import net.minecraft.sound.SoundEvent;
import net.minecraft.util.Identifier;

/** GUI / module sounds from bundled oggs in assets/meteor-client/sounds. */
public final class MorzhSoundManager {
    private static long lastScrollSoundNanos;
    private static long lastClickSoundNanos;

    private static final SoundEvent OPEN = event("gui.open");
    private static final SoundEvent CLOSE = event("gui.close");
    private static final SoundEvent CLICK = event("gui.pop");
    private static final SoundEvent HOVER = event("gui.soft");
    private static final SoundEvent KEY_PRESS = event("gui.keypress");
    private static final SoundEvent KEY_RELEASE = event("gui.keyrelease");
    private static final SoundEvent ENABLE = event("gui.enable");
    private static final SoundEvent DISABLE = event("gui.disable");
    private static final SoundEvent METALLIC = event("combat.metallic");
    private static final SoundEvent SKEET = event("combat.skeet");
    private static final SoundEvent CRIT = event("combat.crit");
    private static final SoundEvent BONK = event("combat.bonk");

    private MorzhSoundManager() {}

    public static void init() {}

    private static SoundEvent event(String path) {
        return SoundEvent.of(Identifier.of("meteor-client", path));
    }

    private static void play(SoundEvent sound, float pitch, float volume) {
        MinecraftClient client = MinecraftClient.getInstance();
        if (client == null || client.getSoundManager() == null || sound == null) return;
        client.getSoundManager().play(PositionedSoundInstance.master(sound, pitch, volume));
    }

    private static void click(SoundEvent sound, float pitch, float volume) {
        long now = System.nanoTime();
        if (now - lastClickSoundNanos < 25_000_000L) return;
        lastClickSoundNanos = now;
        play(sound, pitch, volume);
    }

    public static void playOpen() {
        play(OPEN, 1.0f, 0.7f);
    }

    public static void playClose() {
        play(CLOSE, 1.0f, 0.65f);
    }

    public static void playBoolean() {
        play(CLICK, 1.08f, 0.7f);
    }

    /** Distinct confirm when an account is picked — enable, not the regular pop. */
    public static void playAccountSelect() {
        play(ENABLE, 0.92f, 0.72f);
    }

    public static void playScroll() {
        long now = System.nanoTime();
        if (now - lastScrollSoundNanos < 40_000_000L) return;
        lastScrollSoundNanos = now;
        play(HOVER, 1.15f, 0.28f);
    }

    public static void playKeyPress() {
        play(KEY_PRESS, 1.0f, 0.35f);
    }

    public static void playKeyRelease() {
        play(KEY_RELEASE, 1.0f, 0.22f);
    }

    public static void playModuleEnable() {
        play(ENABLE, 1.0f, 0.6f);
    }

    public static void playModuleDisable() {
        play(DISABLE, 1.0f, 0.55f);
    }

    public static void playModuleState(boolean enabled) {
        if (enabled) playModuleEnable();
        else playModuleDisable();
    }

    public static void playMetallic() { play(METALLIC, 1.0f, 0.7f); }
    public static void playSkeet() { play(SKEET, 1.0f, 0.7f); }
    public static void playCrit() { play(CRIT, 1.0f, 0.7f); }
    public static void playBonk() { play(BONK, 1.0f, 0.7f); }
}


