import meteordevelopment.meteorclient.systems.modules.combat.ExpensiveAura;
import meteordevelopment.meteorclient.systems.modules.combat.KillAura;
import meteordevelopment.meteorclient.systems.modules.combat.aura.expensive.CombatTargets;
import meteordevelopment.orbit.EventHandler;
import meteordevelopment.orbit.EventPriority;

public class AutoJump extends Module {
    private final SettingGroup sgGeneral = settings.getDefaultGroup();

    private final Setting<Mode> mode = sgGeneral.add(new EnumSetting.Builder<Mode>()
        .name("mode")
        .description("The method of jumping.")
        .defaultValue(Mode.Jump)
        .build()
    );

    private final Setting<JumpWhen> jumpIf = sgGeneral.add(new EnumSetting.Builder<JumpWhen>()
        .name("jump-if")
        .description("Jump if.")
        .defaultValue(JumpWhen.Always)
        .build()
    );

    private final Setting<Boolean> onlyWithAura = sgGeneral.add(new BoolSetting.Builder()
        .name("only-with-aura")
        .description("Прыгает только пока Aura / Alternative Aura держит цель.")
        .defaultValue(true)
        .build()
    );

    private final Setting<Boolean> afterFirstHit = sgGeneral.add(new BoolSetting.Builder()
        .name("после-первого-удара")
        .description("Не прыгает, пока ты сам не ударил цель. Без первого удара PvP не считается начатым.")
        .defaultValue(true)
        .build()
    );

    private final Setting<Boolean> onlyWhenCrits = sgGeneral.add(new BoolSetting.Builder()
        .name("только-для-критов")
        .description("Прыгает только если у ауры включены only-critical / только криты и есть цель.")
        .defaultValue(true)
        .build()
    );

    private final Setting<Boolean> inWater = sgGeneral.add(new BoolSetting.Builder()
        .name("in-water")
        .description("Also jump when touching water surface (Expensive Auto Jump).")
        .defaultValue(false)
        .build()
    );

    private final Setting<Double> velocityHeight = sgGeneral.add(new DoubleSetting.Builder()
        .name("velocity-height")
        .description("The distance that velocity mode moves you.")
        .defaultValue(0.25)
        .min(0)
        .sliderMax(2)
        .visible(() -> mode.get() == Mode.LowHop)
        .build()
    );

    public AutoJump() {
        super(Categories.Movement, "auto-jump", "Automatically jumps. Holds jump for aura crits.");
    }

    private boolean canJump() {
        if (mc.player.isSneaking()) return false;
        boolean grounded = mc.player.isOnGround()
            || (inWater.get() && mc.player.isTouchingWater() && !mc.player.isSubmergedInWater());
        if (!grounded) return false;
        if (onlyWithAura.get() && CombatTargets.current() == null) return false;
        if (afterFirstHit.get() && !CombatTargets.hasHitRecently()) return false;
        if (onlyWhenCrits.get() && !auraNeedsCritJump()) return false;
        return switch (jumpIf.get()) {
            case Sprinting -> mc.player.isSprinting() && (mc.player.forwardSpeed != 0 || mc.player.sidewaysSpeed != 0);
            case Walking -> mc.player.forwardSpeed != 0 || mc.player.sidewaysSpeed != 0;
            case Always -> true;
        };
    }

    @EventHandler(priority = EventPriority.LOW)
    private void onInput(PlayerInputEvent event) {
        if (mode.get() != Mode.Jump || !canJump()) return;
        event.setJump(true);
    }

    @EventHandler
    private void onTick(TickEvent.Pre event) {
        if (mode.get() != Mode.LowHop || !canJump()) return;
        ((IVec3d) mc.player.getVelocity()).meteor$setY(velocityHeight.get());
    }

    private static boolean auraNeedsCritJump() {
        ExpensiveAura expensive = Modules.get().get(ExpensiveAura.class);
        if (expensive != null && expensive.isManagingCriticals()) return true;
        KillAura alternative = Modules.get().get(KillAura.class);
        return alternative != null && alternative.isManagingCriticals();
