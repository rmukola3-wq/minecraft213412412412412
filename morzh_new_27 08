        if (!yInitialized) {
            yInitialized = true;
            lastY = currentY;
            trackedFall = 0.0;
            return;
        }

        double movementY = currentY - lastY;
        lastY = currentY;

        if (mc.player.isOnGround() || mc.player.isClimbing() || mc.player.hasVehicle()) {
            ticksOnGround++;
            trackedFall = 0.0;
            return;
        }

        ticksOnGround = 0;

        if (movementY < 0.0) {
            trackedFall += -movementY;
        } else if (movementY > 0.0) {
            trackedFall = 0.0;
        }
    }

    private boolean canCrit() {
        if (cannotCritAnyway()) return true;

        if (smartCrits.get()
            && mc.player.isOnGround()
            && !mc.options.jumpKey.isPressed()
            && ticksOnGround >= (smartGroundTicks > 0 ? smartGroundTicks : 5)) {
            return true;
        }

        if (mc.player.isOnGround()) return false;
        if (mc.player.getVelocity().y > 0.02) return false;

        boolean ceiling = tightSpace.get() && hasLowCeiling();

        if (ceiling) {
            return mc.player.getVelocity().y <= 0.0;
        }

        if (mc.player.isSprinting()) return false;

        double needFall = OPEN_CRIT_FALL + critFallJitter;
        return mc.player.getVelocity().y <= 0.0 && effectiveFall() >= needFall;
    }

    private boolean cannotCritAnyway() {
        return mc.player.isClimbing()
            || mc.player.isTouchingWater()
            || mc.player.isInLava()
            || mc.player.hasVehicle()
            || mc.player.getAbilities().flying
            || mc.player.hasStatusEffect(StatusEffects.BLINDNESS)
            || mc.player.hasStatusEffect(StatusEffects.LEVITATION)
            || mc.player.hasStatusEffect(StatusEffects.SLOW_FALLING);
    }

    private double effectiveFall() {
        return Math.max(mc.player.fallDistance, trackedFall);
    }

    private boolean hasLowCeiling() {
        if (mc.player == null || mc.world == null) return false;
        BlockPos playerPos = mc.player.getBlockPos();
        BlockPos above1 = playerPos.up(2);
        BlockPos above2 = playerPos.up(3);
        BlockState state1 = mc.world.getBlockState(above1);
        BlockState state2 = mc.world.getBlockState(above2);
        boolean blocked1 = !state1.isAir() && !state1.getCollisionShape(mc.world, above1).isEmpty();
        boolean blocked2 = !state2.isAir() && !state2.getCollisionShape(mc.world, above2).isEmpty();
        return blocked1 || blocked2;
    }

    private LivingEntity resolveAimed() {
        HitResult hit = mc.crosshairTarget;
        if (hit instanceof EntityHitResult entityHit && hit.getType() == HitResult.Type.ENTITY) {
            Entity entity = entityHit.getEntity();
            if (isValid(entity)) return (LivingEntity) entity;
        }

        return raycastExpanded();
    }

    /**
     * Strange-style expanded hitbox ray for 2-block fights where vanilla crosshair slips off during jump.
     */
    private LivingEntity raycastExpanded() {
        Vec3d origin = mc.player.getEyePos();
        Vec3d look = Vec3d.fromPolar(mc.player.getPitch(), mc.player.getYaw());
        Vec3d end = origin.add(look.multiply(REACH));

        LivingEntity best = null;
        double bestDistance = REACH;

        for (Entity entity : mc.world.getEntities()) {
            if (!isValid(entity)) continue;
            LivingEntity living = (LivingEntity) entity;
            Box box = living.getBoundingBox().expand(
                BOX_EXPAND_X + expandJitter,
                BOX_EXPAND_Y + expandJitter * 0.5,
                BOX_EXPAND_Z + expandJitter
            );
            if (box.contains(origin)) {
                double distance = closestDistance(living);
                if (distance < bestDistance) {
                    bestDistance = distance;
                    best = living;
                }
                continue;
            }

            var hit = box.raycast(origin, end);
            if (hit.isEmpty()) continue;

            double distance = origin.distanceTo(hit.get());
            if (distance < bestDistance) {
                bestDistance = distance;
                best = living;
            }
        }

        return best;
    }

    private double closestDistance(Entity entity) {
        Vec3d eyes = mc.player.getEyePos();
        Box box = entity.getBoundingBox();
        Vec3d closest = new Vec3d(
            MathHelper.clamp(eyes.x, box.minX, box.maxX),
            MathHelper.clamp(eyes.y, box.minY, box.maxY),
            MathHelper.clamp(eyes.z, box.minZ, box.maxZ)
        );
        return eyes.distanceTo(closest);
    }

    private boolean holdingSword() {
        Item item = mc.player.getMainHandStack().getItem();
        if (item instanceof SwordItem) return true;
        String key = item.getTranslationKey().toLowerCase();
        return key.contains("sword");
    }

    private boolean holdingShield() {
        if (mc.player.isBlocking()) return true;
        boolean hasShield = mc.player.getOffHandStack().getItem() instanceof ShieldItem
            || mc.player.getMainHandStack().getItem() instanceof ShieldItem;
        return hasShield && mc.options.useKey.isPressed();
    }

    private void startShieldBreak() {
        FindItemResult axe = InvUtils.findInHotbar(stack -> stack.getItem() instanceof AxeItem);
        if (!axe.found() || !axe.isHotbar()) return;
        if (mc.player.getMainHandStack().getItem() instanceof AxeItem) {
            breakStage = 2;
            breakWait = randomized(swapDelay.get());
            return;
        }
        swordSlot = mc.player.getInventory().selectedSlot;
        InvUtils.swap(axe.slot(), false);
        breakStage = 1;
        breakWait = randomized(swapDelay.get());
    }

    private void tickShieldBreak() {
        if (breakWait > 0) {
            breakWait--;
            return;
        }

        if (breakStage == 1) {
            breakStage = 2;
            breakWait = 0;
            return;
        }

        if (breakStage == 2) {
            if (holdingShield()) {
                abortBreak();
                return;
            }
            LivingEntity aimed = resolveAimed();
            target = aimed;
            if (aimed != null && isValid(aimed) && mc.player.getAttackCooldownProgress(0.5f) >= 0.85f) {
                mc.interactionManager.attackEntity(mc.player, aimed);
                mc.player.swingHand(Hand.MAIN_HAND);
            }
            breakStage = 3;
            breakWait = randomized(swapBackDelay.get());
            return;
        }

        if (breakStage == 3) {
            if (swordSlot >= 0 && swordSlot < 9) InvUtils.swap(swordSlot, false);
            abortBreak();
        }
    }

    private void abortBreak() {
        breakStage = 0;
        breakWait = 0;
        swordSlot = -1;
    }

    private int randomized(int base) {
        return base + ThreadLocalRandom.current().nextInt(0, 3);
    }

    private boolean isValid(Entity entity) {
        if (!(entity instanceof LivingEntity living) || !living.isAlive() || living == mc.player) return false;
        if (living.isRemoved()) return false;
        if (!invisibles.get() && living.isInvisible()) return false;
        if (living instanceof PlayerEntity player) {
            if (Friends.get().isFriend(player)) return false;
            AntiBot antiBot = Modules.get().get(AntiBot.class);
            if (antiBot != null && antiBot.isBot(player)) return false;
            return true;
        }
        return !playersOnly.get();
    }
}


