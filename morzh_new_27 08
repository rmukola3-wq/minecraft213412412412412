package meteordevelopment.meteorclient.systems.modules.combat.aura.rockstar;

/**
 * Millisecond lerp used by Rockstar {@code RotationAnimation} / {@code InfinityAnimation}.
 */
public final class RockstarInterp {
    private float yaw;
    private float pitch;

    private float fromYaw;
    private float fromPitch;
    private float toYaw;
    private float toPitch;

    private long yawStarted;
    private long pitchStarted;
    private int yawMs = 1;
    private int pitchMs = 1;
    private boolean seeded;

    public void reset(float yaw, float pitch) {
        this.yaw = yaw;
        this.pitch = pitch;
        this.fromYaw = yaw;
        this.fromPitch = pitch;
        this.toYaw = yaw;
        this.toPitch = pitch;
        this.yawMs = 1;
        this.pitchMs = 1;
        this.yawStarted = System.currentTimeMillis();
        this.pitchStarted = this.yawStarted;
        this.seeded = true;
    }

    public float[] animate(float targetYaw, float targetPitch, int yawSpeed, int pitchSpeed) {
        long now = System.currentTimeMillis();

        if (!seeded) reset(targetYaw, targetPitch);

        if (Math.abs(targetYaw - toYaw) > 0.001f) {
            fromYaw = yaw;
            toYaw = targetYaw;
            yawStarted = now;
            yawMs = Math.max(1, yawSpeed);
        }

        if (Math.abs(targetPitch - toPitch) > 0.001f) {
            fromPitch = pitch;
            toPitch = targetPitch;
            pitchStarted = now;
            pitchMs = Math.max(1, pitchSpeed);
        }

        yaw = lerp(fromYaw, toYaw, now - yawStarted, yawMs);
        pitch = lerp(fromPitch, toPitch, now - pitchStarted, pitchMs);

        return new float[]{yaw, pitch};
    }

    public float getYaw() {
        return yaw;
    }

    public float getPitch() {
        return pitch;
    }

    private static float lerp(float from, float to, long elapsed, int duration) {
        if (duration <= 1) return to;
        float progress = Math.min(1.0f, elapsed / (float) duration);
        return from + (to - from) * progress;
    }
}


