    @EventHandler
    private void onTick(TickEvent.Pre event) {
        if (mc.world == null || mc.player == null) return;

        LivingEntity living = CombatTargets.current();
        if (living != null && living.getHealth() > 0.0f) target = living;
        if (fadeSmooth <= 0.0f && (living == null || living.getHealth() <= 0.0f)) target = null;

        fadeState = isActive() && living != null && living.getHealth() > 0.0f;
        tickFade();
        ThunderHackEsp.tick();

        prevRotation = rotation;
        rotation += spinVelocity * rotationSpeed.get().floatValue();
        if (spinVelocity > 25.0f) spinDecreasing = true;
        else if (spinVelocity < -25.0f) spinDecreasing = false;
        spinVelocity = spinDecreasing ? spinVelocity - 0.5f : spinVelocity + 0.5f;
    }

    @EventHandler
    private void onRender3D(Render3DEvent event) {
        if (mc.world == null || target == null) return;

        if (profile.get() == Profile.ThunderHack) {
            ThunderHackEsp.render(
                event,
                target,
                thunderMode.get(),
                espLength.get(),
                espFactor.get(),
                espShaking.get().floatValue(),
                espAmplitude.get().floatValue(),
                thunderRainbow.get() ? null : color.get()
            );
            return;
        }

        Camera camera = mc.gameRenderer.getCamera();
        Vec3d cam = camera.getPos();
        float tickDelta = event.tickDelta;
        double dx = MathHelper.lerp(tickDelta, target.lastRenderX, target.getX()) - cam.x;
        double dy = MathHelper.lerp(tickDelta, target.lastRenderY, target.getY()) - cam.y;
        double dz = MathHelper.lerp(tickDelta, target.lastRenderZ, target.getZ()) - cam.z;

        int packed = color.get().getPacked();
        int alpha = (int) (((packed >>> 24) & 255) * fadeSmooth);
        float hurt = target.hurtTime / 10.0f;
        if (hurt > 0.0f) packed = lerpArgb(packed, 0xFFFF0000, hurt);
        packed = (packed & 0x00FFFFFF) | (MathHelper.clamp(alpha, 0, 255) << 24);
        if (((packed >>> 24) & 255) <= 0) return;

        Color sprite = unpack(packed);
        mesh.depthTest = false;
        mesh.additive = false;

        switch (mode.get()) {
            case Cube -> {
                mesh.texture = TARGET_TEX;
                mesh.blend = blending.get();
                mesh.begin();
                float spin = MathHelper.lerp(tickDelta, prevRotation, rotation);
                MatrixStack matrices = new MatrixStack();
                matrices.translate(dx, dy + (target.getEyeHeight(target.getPose()) / 2.0f) + 0.1d, dz);
                matrices.multiply(camera.getRotation());
                matrices.multiply(RotationAxis.POSITIVE_Z.rotationDegrees(spin));
                matrices.scale(1.25f, 1.25f, 1.25f);
                addTexture(matrices.peek().getPositionMatrix(), cam, -0.5f, -0.5f, 1.0f, 1.0f, sprite);
                mesh.render(event.matrices);
            }
            case Ghosts -> {
                mesh.texture = BLOOM_TEX;
                mesh.blend = true;
                mesh.additive = true;
                mesh.begin();
                double clock = (System.currentTimeMillis() / 50.0d) * rotationSpeed.get();
                float height = (target.getHeight() / 2.0f) + 0.1f;
                float width = target.getWidth();
                for (int i = 0; i < 3; i++) {
                    for (int i2 = 0; i2 <= 10; i2++) {
                        double radians = Math.toRadians((((((i2 / 2.0f) + (clock * 3.0d)) * 10.0d) + (i * 120)) % 3600.0d));
                        double bounce = Math.sin(Math.toRadians((clock * 5.0d) + (i2 * (i + height))) * 2.0d) / 2.0d;
                        double x = dx + (Math.cos(radians) * width);
                        double y = dy + height + bounce;
                        double z = dz + (Math.sin(radians) * width);
                        float size = 0.5f * ((i2 + 10) / 20.0f);
                        MatrixStack matrices = new MatrixStack();
                        matrices.translate(x, y, z);
                        matrices.multiply(camera.getRotation());
                        addTexture(matrices.peek().getPositionMatrix(), cam, -size / 2.0f, -size / 2.0f, size, size, sprite);
                    }
                }
                mesh.render(event.matrices);
            }
        }
    }

    public Color lightColor() {
        if (!isActive() || target == null || fadeSmooth <= 0.02f) return null;
        Color c = color.get();
        return new Color(c.r, c.g, c.b, MathHelper.clamp((int) (c.a * fadeSmooth), 0, 255));
    }

    public LivingEntity lightTarget() {
        if (!isActive() || fadeSmooth <= 0.02f) return null;
        return target;
    }

    private void tickFade() {
        long now = System.nanoTime();
        float dt = Math.max(0.0f, Math.min((now - lastNano) / 1_000_000_000.0f, 0.05f));
        lastNano = now;
        float speed = 1000.0f / 700.0f;
        fadeAnimation = MathHelper.clamp(fadeAnimation + (fadeState ? dt * speed : -dt * speed), 0.0f, 1.0f);
        float t = fadeState ? fadeAnimation : 1.0f - fadeAnimation;
        float ease = t < 0.5f ? 4.0f * t * t * t : 1.0f - (float) (Math.pow((-2.0f * t) + 2.0f, 3.0d) / 2.0d);
        fadeSmooth = fadeState ? ease : 1.0f - ease;
    }

    private void addTexture(Matrix4f matrix, Vec3d cam, float x, float y, float w, float h, Color sprite) {
        addCorner(matrix, cam, x, y, 0, 0, sprite);
        addCorner(matrix, cam, x, y + h, 0, 1, sprite);
        addCorner(matrix, cam, x + w, y + h, 1, 1, sprite);
        addCorner(matrix, cam, x + w, y, 1, 0, sprite);
        int i = mesh.getNextQuadBase();
        mesh.quad(i, i + 1, i + 2, i + 3);
    }

    private void addCorner(Matrix4f matrix, Vec3d cam, float lx, float ly, float u, float v, Color sprite) {
        Vector4f p = new Vector4f(lx, ly, 0.0f, 1.0f);
        p.mul(matrix);
        mesh.vec3(p.x + cam.x, p.y + cam.y, p.z + cam.z).vec2(u, v).color(sprite).next();
    }

    private static int lerpArgb(int from, int to, float t) {
        t = MathHelper.clamp(t, 0.0f, 1.0f);
        int a = (int) (((from >>> 24) & 255) + ((((to >>> 24) & 255) - ((from >>> 24) & 255)) * t));
        int r = (int) (((from >> 16) & 255) + ((((to >> 16) & 255) - ((from >> 16) & 255)) * t));
        int g = (int) (((from >> 8) & 255) + ((((to >> 8) & 255) - ((from >> 8) & 255)) * t));
        int b = (int) (((from) & 255) + ((((to) & 255) - ((from) & 255)) * t));
        return (a << 24) | (r << 16) | (g << 8) | b;
    }

    private static Color unpack(int packed) {
        return new Color((packed >> 16) & 255, (packed >> 8) & 255, packed & 255, (packed >>> 24) & 255);
    }

    public enum Profile {
        Expensive("Expensive"),
        ThunderHack("ThunderHack");

        private final String title;

        Profile(String title) {
            this.title = title;
        }

        @Override
        public String toString() {
            return title;
        }
    }

    public enum Mode {
        Cube("Куб"),
        Ghosts("Призраки");

        private final String title;

        Mode(String title) {
            this.title = title;
        }

        @Override
        public String toString() {
            return title;
        }
    }

    private static class TexturedMesh extends ShaderMesh {
        private Identifier texture;
        private boolean additive;
        private boolean blend = true;
        private int nextVertex;

        private TexturedMesh() {
            super(Shaders.POS_TEX_COLOR, DrawMode.Triangles, Mesh.Attrib.Vec3, Mesh.Attrib.Vec2, Mesh.Attrib.Color);
        }

        int getNextQuadBase() {
            return nextVertex;
        }

        @Override
        public void begin() {
            super.begin();
            nextVertex = 0;
        }

        @Override
        public int next() {
            nextVertex++;
            return super.next();
        }

        @Override
        protected void beforeRender() {
            super.beforeRender();
            GL.bindTexture(texture);
            if (!blend) {
                GlStateManager._disableBlend();
                return;
            }
            GlStateManager._enableBlend();
            if (additive) GlStateManager._blendFunc(GL_SRC_ALPHA, org.lwjgl.opengl.GL11.GL_ONE);
            else GlStateManager._blendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
        }
    }
}


