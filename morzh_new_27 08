    private void renderTntNametag(String fuseText, boolean shadow) {
        TextRenderer text = TextRenderer.get();
        NametagUtils.begin(pos);

        double width = text.getWidth(fuseText, shadow);
        double heightDown = text.getHeight(shadow);

        double widthHalf = width / 2;

        drawBg(-widthHalf, -heightDown, width, heightDown);

        text.beginBig();
        double hX = -widthHalf;
        double hY = -heightDown;

        text.render(fuseText, hX, hY, nameColor.get(), shadow);
        text.end();

        NametagUtils.end();
    }

    private ItemStack getItem(PlayerEntity entity, int index) {
        if (itemLayout.get() == ItemLayout.Wild) {
            return switch (index) {
                case 0 -> entity.getInventory().armor.get(0);
                case 1 -> entity.getInventory().armor.get(1);
                case 2 -> entity.getInventory().armor.get(2);
                case 3 -> entity.getInventory().armor.get(3);
                case 4 -> entity.getMainHandStack();
                case 5 -> entity.getOffHandStack();
                default -> ItemStack.EMPTY;
            };
        }
        return switch (index) {
            case 0 -> entity.getMainHandStack();
            case 1 -> entity.getInventory().armor.get(3);
            case 2 -> entity.getInventory().armor.get(2);
            case 3 -> entity.getInventory().armor.get(1);
            case 4 -> entity.getInventory().armor.get(0);
            case 5 -> entity.getOffHandStack();
            default -> ItemStack.EMPTY;
        };
    }

    private void drawBg(double x, double y, double width, double height) {
        Renderer2D.COLOR.begin();
        Renderer2D.COLOR.quad(x - 1, y - 1, width + 2, height + 2, background.get());
        Renderer2D.COLOR.render(null);
    }

    private record ItemCell(int itemId, int components, int x, int y, int z) {}

    private static final class ItemCluster {
        double x, y, z;
        int n, count;
        ItemStack stack;
    }

    private record ItemTag(double x, double y, double z, ItemStack stack, int count) {}

    public enum Position {
        Above,
        OnTop
    }

    public enum Durability {
        None,
        Total,
        Percentage,
        Bar
    }

    public enum ItemLayout {
        Default,
        Wild
    }

    public enum DistanceColorMode {
        Gradient,
        Flat
    }

    public boolean excludeBots() {
        return ignoreBots.get();
    }

    public boolean playerNametags() {
        return isActive() && entities.get().contains(EntityType.PLAYER);
    }
}


