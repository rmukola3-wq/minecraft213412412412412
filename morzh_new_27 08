            add(theme.horizontalSeparator()).expandX();

            WHorizontalList create = add(theme.horizontalList()).expandX().widget();
            WTextBox nameBox = create.add(theme.textBox("", "cfg name", Utils::nameFilter)).expandX().widget();
            WButton saveNew = create.add(theme.button("Save")).widget();
            saveNew.action = () -> {
                String name = CfgManager.sanitize(nameBox.get());
                if (name == null) return;
                if (CfgManager.save(name)) {
                    ChatUtils.info("Saved cfg " + name);
                    reload();
                } else {
                    ChatUtils.error("Failed to save cfg " + name);
                }
            };

            WButton openDir = add(theme.button("Open folder")).expandX().widget();
            openDir.action = CfgManager::openFolder;

            add(theme.horizontalSeparator()).expandX();

            WTable table = add(theme.table()).expandX().minWidth(420).widget();
            initTable(table);
        }

        private void initTable(WTable table) {
            table.clear();
            for (String name : CfgManager.list()) {
                table.add(theme.label(name)).expandCellX();

                WButton load = table.add(theme.button("Load")).widget();
                load.action = () -> {
                    if (CfgManager.load(name)) ChatUtils.info("Loaded cfg " + name);
                    else ChatUtils.error("Failed to load cfg " + name);
                };

                WButton overwrite = table.add(theme.button("Save")).widget();
                overwrite.action = () -> {
                    if (CfgManager.save(name)) ChatUtils.info("Updated cfg " + name);
                    else ChatUtils.error("Failed to save cfg " + name);
                };

                WMinus remove = table.add(theme.minus()).widget();
                remove.action = () -> {
                    if (CfgManager.delete(name)) reload();
                };

                table.row();
            }
        }
    }
}


