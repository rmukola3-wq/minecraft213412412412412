    public static final int MUTED = 0x9AA0B0;
    public static final int SUB = 0x5C6270;

    public static int withAlpha(int color, int alpha) {
        return (color & 0x00FFFFFF) | (MathHelper.clamp(alpha, 0, 255) << 24);
    }

    /** Particle / cursor glow that lerps from slate toward accent. */
    public static int glowRgb(float t) {
        int ar = (ACCENT >> 16) & 0xFF;
        int ag = (ACCENT >> 8) & 0xFF;
        int ab = ACCENT & 0xFF;
        int r = (int) (0x2A + t * (ar - 0x2A));
        int g = (int) (0x3A + t * (ag - 0x3A));
        int b = (int) (0x4A + t * (ab - 0x4A));
        return (r << 16) | (g << 8) | b;
    }
}


