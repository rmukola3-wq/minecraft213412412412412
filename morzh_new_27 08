            Vec3d center = t.getBoundingBox().getCenter();
            double rad = Math.toRadians(t.getYaw());
            Vec3d fwdDir = new Vec3d(-Math.sin(rad), 0, Math.cos(rad)).normalize();
            Vec3d rgtDir = new Vec3d(-fwdDir.z, 0, fwdDir.x).normalize();

            Vec3d off = Vec3d.ZERO;
            if (w) off = off.add(fwdDir);
            if (s) off = off.add(fwdDir.multiply(-1.0));
            if (a) off = off.add(rgtDir.multiply(-1.0));
            if (d) off = off.add(rgtDir);

            Vec3d mt = off.lengthSquared() > 0
                ? center.add(off.normalize().multiply(t.getWidth() / 2.0 + 0.1))
                : center;
            Vec3d dir = new Vec3d(mt.x - playerPos.x, 0, mt.z - playerPos.z).normalize();
            applyDirectional(event, dir);
        }
    }

    private void applyDirectional(PlayerInputEvent event, Vec3d dir) {
        float yaw = AngleConnection.INSTANCE.getRotation().getYaw();
        float ma = (float) Math.toDegrees(Math.atan2(dir.z, dir.x)) - 90F;
        float diff = MathHelper.wrapDegrees(ma - yaw);

        boolean fwd = false, bck = false, lft = false, rgt = false;
        if (diff >= -22.5 && diff < 22.5) fwd = true;
        else if (diff >= 22.5 && diff < 67.5) { fwd = true; rgt = true; }
        else if (diff >= 67.5 && diff < 112.5) rgt = true;
        else if (diff >= 112.5 && diff < 157.5) { bck = true; rgt = true; }
        else if (diff >= -67.5 && diff < -22.5) { fwd = true; lft = true; }
        else if (diff >= -112.5 && diff < -67.5) lft = true;
        else if (diff >= -157.5 && diff < -112.5) { bck = true; lft = true; }
        else bck = true;

        event.setDirectional(fwd, bck, lft, rgt);
    }

    private float yawToTarget(LivingEntity t) {
        Vec3d delta = t.getPos().subtract(mc.player.getPos());
        return (float) MathHelper.wrapDegrees(Math.toDegrees(Math.atan2(delta.z, delta.x)) - 90.0);
    }

    public StrikerConstructor.AttackPerpetratorConfigurable getConfig() {
        LivingEntity cfgTarget = target != null ? target : lastTarget;
        if (cfgTarget == null || mc.player == null) {
            Angle camera = MathAngle.cameraAngle();
            return new StrikerConstructor.AttackPerpetratorConfigurable(
                null,
                camera,
                range.get().floatValue(),
                buildAttackOptions(),
                new RastySelectSetting(aimMode.get().rastyName),
                new Box(0, 0, 0, 0, 0, 0),
                walls.get() != WallMode.Off
            );
        }

        float baseRange = range.get().floatValue();
        boolean ignoreWalls = walls.get() != WallMode.Off;

        Pair<Vec3d, Box> pointData = pointFinder.computeVector(
            cfgTarget,
            baseRange,
            AngleConnection.INSTANCE.getRotation(),
            getSmoothMode().randomValue(),
            ignoreWalls
        );

        Vec3d computedPoint = pointData.getLeft();
        Box hitbox = pointData.getRight();

        if (mc.player.isGliding() && cfgTarget.isGliding()) {
            Vec3d tv = cfgTarget.getVelocity();
            float leadTicks = 0;
            if (ElytraTarget.shouldElytraTarget && ElytraTarget.getInstance() != null
                && ElytraTarget.getInstance().isState()) {
                leadTicks = ElytraTarget.getInstance().getElytraForward();
            }

            if (tv.horizontalLength() > 0.35) {
                Vec3d pred = cfgTarget.getPos().add(tv.multiply(leadTicks));
                computedPoint = pred.add(0, cfgTarget.getHeight() / 2, 0);
                hitbox = new Box(
                    pred.x - cfgTarget.getWidth() / 2, pred.y,
                    pred.z - cfgTarget.getWidth() / 2,
                    pred.x + cfgTarget.getWidth() / 2,
                    pred.y + cfgTarget.getHeight(),
                    pred.z + cfgTarget.getWidth() / 2
                );
            }
        }

        Angle angle = MathAngle.fromVec3d(computedPoint.subtract(mc.player.getEyePos()));

        List<String> attackOptions = buildAttackOptions();
        return new StrikerConstructor.AttackPerpetratorConfigurable(
            cfgTarget,
            angle,
            baseRange,
            attackOptions,
            new RastySelectSetting(aimMode.get().rastyName),
            hitbox,
            ignoreWalls
        );
    }

