    /** Same tint Delta/fog/sky color applies to the vanilla sky disc. */
    public Color cubemapTint(float layerBrightness, Fog fog) {
        float r = 1f, g = 1f, b = 1f, a = 1f;
        SettingColor custom = null;
        if (isActive() && deltaActive() && deltaCustomFog.get()) custom = deltaFogColor.get();
        else if (isActive() && modifyFog()) custom = fogColor.get();
        else if (isActive() && customSkyColor.get()) custom = skyColor();

        if (custom != null) {
            r = custom.r / 255f;
            g = custom.g / 255f;
            b = custom.b / 255f;
            a = custom.a / 255f;
        } else if (fog != null) {
            r = fog.red();
            g = fog.green();
            b = fog.blue();
            a = fog.alpha();
        }

        float weatherMul = 1f;
        if (mc.world != null) {
            float tickDelta = mc.getRenderTickCounter().getTickDelta(true);
            float rain = mc.world.getRainGradient(tickDelta);
            float thunder = mc.world.getThunderGradient(tickDelta);
            weatherMul = MathHelper.clamp(1f - rain * 0.55f - thunder * 0.2f, 0.15f, 1f);
        }

        a *= layerBrightness * weatherMul;
        tintScratch.set(
            MathHelper.clamp((int) (r * 255), 0, 255),
            MathHelper.clamp((int) (g * 255), 0, 255),
            MathHelper.clamp((int) (b * 255), 0, 255),
            MathHelper.clamp((int) (a * 255), 0, 255)
        );
        return tintScratch;
    }

