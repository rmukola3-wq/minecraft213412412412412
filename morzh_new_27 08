import org.spongepowered.asm.mixin.injection.callback.CallbackInfoReturnable;
import net.minecraft.client.gui.DrawContext;

@Mixin(value = ChatScreen.class, priority = 1001)
public abstract class ChatScreenMixin {
    @Shadow protected TextFieldWidget chatField;
    @Unique private boolean matrixPushed;
    @Unique private int originalChatFieldY;

    @Inject(method = "init", at = @At(value = "RETURN"))
    private void onInit(CallbackInfo info) {
        if (Modules.get().get(BetterChat.class).isInfiniteChatBox()) chatField.setMaxLength(Integer.MAX_VALUE);
        GuiAnimations animations = Modules.get().get(GuiAnimations.class);
        if (animations != null && animations.chatEnabled()) {
            animations.chatInputAnim.reset();
            animations.chatInputAnim.open(animations.chatDuration.get());
            originalChatFieldY = chatField.getY();
        }
    }

    @Inject(method = "removed", at = @At("HEAD"))
    private void pulseChatRemoved(CallbackInfo ci) {
        GuiAnimations animations = Modules.get().get(GuiAnimations.class);
        if (animations != null) animations.chatInputAnim.reset();
    }

    @Inject(method = "render", at = @At("HEAD"))
    private void pulseChatHead(DrawContext context, int mouseX, int mouseY, float delta, CallbackInfo ci) {
        GuiAnimations animations = Modules.get().get(GuiAnimations.class);
        matrixPushed = false;
        if (animations == null || !animations.chatEnabled()) return;
        animations.chatInputAnim.tick();
        float offset = animations.chatInputAnim.value();
        if (offset > 0) {
            chatField.setY(originalChatFieldY + (int) offset);
            context.getMatrices().push();
            context.getMatrices().translate(0f, offset, 0f);
            matrixPushed = true;
        }
    }

    @Inject(method = "render", at = @At("TAIL"))
    private void pulseChatTail(DrawContext context, int mouseX, int mouseY, float delta, CallbackInfo ci) {
        if (matrixPushed) {
            context.getMatrices().pop();
            matrixPushed = false;
        }
    }

    @Inject(method = "keyPressed", at = @At("HEAD"), cancellable = true)
    private void pulseChatKeys(int keyCode, int scanCode, int modifiers, CallbackInfoReturnable<Boolean> cir) {
        GuiAnimations animations = Modules.get().get(GuiAnimations.class);
        if (animations != null && animations.chatEnabled() && animations.chatInputAnim.sliding() && keyCode != 256) {
            cir.setReturnValue(false);
        }
    }
}


