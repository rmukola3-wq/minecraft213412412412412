package meteordevelopment.meteorclient.gui.morzh.dropdown;

import meteordevelopment.meteorclient.gui.GuiThemes;
import meteordevelopment.meteorclient.gui.tabs.builtin.CfgTab;
import meteordevelopment.meteorclient.systems.modules.Category;
import meteordevelopment.meteorclient.systems.modules.Modules;
import meteordevelopment.meteorclient.utils.Utils;
import net.minecraft.client.gui.DrawContext;
import net.minecraft.client.gui.screen.Screen;
import net.minecraft.text.Text;
import net.minecraft.util.math.MathHelper;
import org.lwjgl.glfw.GLFW;

import java.util.ArrayList;
import java.util.List;
import java.util.Locale;

/**
 * ClickGUI in raw scaled-GUI coordinates. One layout pass positions every panel
 * and module before render and before any mouse event, so hitboxes always match
 * what was drawn on the last frame.
 */
public class DropDownScreen extends Screen {
    public static final float PANEL_WIDTH = 125f;
    public static final float PANEL_HEIGHT = 270f;
    public static final float PANEL_GAP = 8f;
    public static final float HEADER = 24f;
    public static final float PANEL_RADIUS = 8f;

    public static final float SEARCH_WIDTH = 100f;
    public static final float SEARCH_HEIGHT = 20f;
    public static final float SEARCH_TOP = 8f;
    public static final float SEARCH_GAP = 12f;
    public static final float CFG_WIDTH = 44f;
    public static final float CFG_GAP = 8f;

    private final DropDownAnim animation = new DropDownAnim(0);

    private final List<DropDownPanel> panels = new ArrayList<>();
    private String search = "";
    private boolean searchFocused;
    private float searchX;
    private float searchY;
    private boolean closing;
    private boolean actuallyClosing;
    private boolean appearStarted;

    public DropDownScreen() {
        super(Text.literal("ClickGUI"));

        for (Category category : Modules.loopCategories()) {
            panels.add(new DropDownPanel(category));
        }
    }

    public DropDownAnim getAnimation() {
        return animation;
    }

    @Override
    protected void init() {
        super.init();
        closing = false;
        actuallyClosing = false;
        if (!appearStarted) {
            appearStarted = true;
            animation.snap(0);
            animation.animate(1, 0.28f, DropDownAnim.Ease.QUART_OUT);
            meteordevelopment.meteorclient.utils.sound.MorzhSoundManager.playOpen();
        }
    }

    @Override
    public boolean shouldPause() {
        return false;
    }

    @Override
    public boolean shouldCloseOnEsc() {
        return false;
    }

    public void requestClose() {
        if (closing) return;
        closing = true;
        meteordevelopment.meteorclient.utils.sound.MorzhSoundManager.playClose();
        animation.animate(0, 0.22f, DropDownAnim.Ease.QUART_OUT);
    }

    @Override
    public void close() {
        if (actuallyClosing) {
            DropDownDraw.arrowCursorNow();
            super.close();
            return;
        }
        requestClose();
    }

    /** Positions every panel and module; must run before render and before any mouse event. */
    private void layoutAll() {
        float a = animation.getValueF();
        float searchT = MathHelper.clamp(a, 0f, 1f);

        float bottomReserve = SEARCH_HEIGHT + SEARCH_GAP + 8f;
        float topInset = 8f;

        int count = panels.size();
        float panelBottom = height * 0.5f;
        for (int i = 0; i < count; i++) {
            float t = staggered(a, i, count);
            float vis = MathHelper.clamp(t, 0f, 1f);
            float extraY = closing ? (1f - vis) * 28f : (1f - vis) * -16f;
            float extraX = 0f;
            panels.get(i).layout(width, height, i, count, topInset, bottomReserve, extraX, extraY, vis);
            panelBottom = panels.get(i).getY() + panels.get(i).getHeight();
        }

        float searchSlide = closing ? (1f - searchT) * 18f : (1f - searchT) * -10f;
        float rowWidth = SEARCH_WIDTH + CFG_GAP + CFG_WIDTH;
        searchX = Math.max(10, (width - rowWidth) / 2f);
        searchY = panelBottom + SEARCH_GAP + searchSlide;
    }

    private void applySearchFilter() {
        String query = search.toLowerCase(Locale.ROOT);
        for (DropDownPanel panel : panels) {
            panel.applySearch(query);
        }
    }

    private void renderSearch(DrawContext context, float mouseX, float mouseY) {
        float a = MathHelper.clamp(animation.getValueF(), 0f, 1f);
        if (a <= 0.01f) return;

        DropDownDraw.setAlpha(a);
        try {
            DropDownDraw.glass(context, searchX, searchY, SEARCH_WIDTH, SEARCH_HEIGHT, 8f);

            boolean empty = search.isEmpty();
            String text = empty ? "Search..." : search;
            if (searchFocused && !empty && System.currentTimeMillis() % 1000 > 500) {
                text += "_";
            }

            DropDownDraw.text(
                context,
                text,
                searchX + 7,
                searchY + SEARCH_HEIGHT / 2f - DropDownDraw.textHeight(6.5f) / 2f,
                empty ? DropDownColors.TEXT_MUTED : DropDownColors.TEXT,
                6.5f
            );

            if (DropDownDraw.hovered(mouseX, mouseY, searchX, searchY, SEARCH_WIDTH, SEARCH_HEIGHT)) {
                DropDownDraw.cursorIbeam();
            }

            float cfgX = searchX + SEARCH_WIDTH + CFG_GAP;
            DropDownDraw.glass(context, cfgX, searchY, CFG_WIDTH, SEARCH_HEIGHT, 8f);
            String cfgLabel = "CFG";
            float cfgTw = DropDownDraw.textWidth(cfgLabel, 6.5f);
            DropDownDraw.text(
                context,
                cfgLabel,
                cfgX + (CFG_WIDTH - cfgTw) / 2f,
                searchY + SEARCH_HEIGHT / 2f - DropDownDraw.textHeight(6.5f) / 2f,
                DropDownColors.TEXT,
                6.5f
            );
            if (DropDownDraw.hovered(mouseX, mouseY, cfgX, searchY, CFG_WIDTH, SEARCH_HEIGHT)) {
                DropDownDraw.cursorHand();
            }
        } finally {
            DropDownDraw.setAlpha(1f);
        }
    }

    private boolean isOverSearch(float mouseX, float mouseY) {
        return DropDownDraw.hovered(mouseX, mouseY, searchX, searchY, SEARCH_WIDTH, SEARCH_HEIGHT);
    }

    private boolean isOverCfg(float mouseX, float mouseY) {
        return DropDownDraw.hovered(mouseX, mouseY, searchX + SEARCH_WIDTH + CFG_GAP, searchY, CFG_WIDTH, SEARCH_HEIGHT);
    }

    @Override
    public void renderBackground(DrawContext context, int mouseX, int mouseY, float delta) {
        // World stays as-is. Vanilla applyBlur here is what turned the sky magenta/pink
        // (missing blur buffer) after NoGuiDim cancelled the copy pass.
    }

    @Override
    public void render(DrawContext context, int mouseX, int mouseY, float delta) {
        context.draw();

        animation.update();

        if (closing && animation.getValue() < 0.03 && animation.finished()) {
            actuallyClosing = true;
            super.close();
            return;
        }

        layoutAll();

        float mx = mouseX;
        float my = mouseY;

        DropDownDraw.resetCursor();

        try {
            boolean was3d = Utils.rendering3D;
            Utils.rendering3D = false;
            try {
                renderSearch(context, mx, my);
                for (DropDownPanel panel : panels) {
                    panel.render(context, mx, my);
                }
            } finally {
                Utils.rendering3D = was3d;
            }
        } finally {
            DropDownDraw.resetScissor();
        }

        DropDownDraw.applyCursor();
    }

    private float staggered(float global, int index, int count) {
        if (count <= 1) return global;
        float stagger = 0.04f;
        float span = Math.max(0.72f, 1f - stagger * (count - 1));
        float delay = index * stagger;
        return MathHelper.clamp((global - delay) / span, 0f, 1.12f);
    }

    @Override
    public boolean mouseClicked(double mouseX, double mouseY, int button) {
        if (animation.getValue() < 0.4) return true;
        layoutAll();
        float mx = (float) mouseX;
        float my = (float) mouseY;

        if (isOverCfg(mx, my)) {
            searchFocused = false;
            client.setScreen(new CfgTab().createScreen(GuiThemes.get()));
            return true;
        }

        if (isOverSearch(mx, my)) {
            searchFocused = true;
            return true;
        }
        searchFocused = false;

        for (DropDownPanel panel : panels) {
            panel.mouseClick(mx, my, button);
        }
        return true;
    }

    @Override
    public boolean mouseReleased(double mouseX, double mouseY, int button) {
        layoutAll();
        float mx = (float) mouseX;
        float my = (float) mouseY;
        for (DropDownPanel panel : panels) {
            panel.mouseRelease(mx, my, button);
        }
        return super.mouseReleased(mouseX, mouseY, button);
    }

    @Override
    public boolean mouseScrolled(double mouseX, double mouseY, double horizontalAmount, double verticalAmount) {
        layoutAll();
        float mx = (float) mouseX;
        float my = (float) mouseY;
        for (DropDownPanel panel : panels) {
            if (panel.mouseScrolled(mx, my, verticalAmount)) {
                meteordevelopment.meteorclient.utils.sound.MorzhSoundManager.playScroll();
                return true;
            }
        }
        return super.mouseScrolled(mouseX, mouseY, horizontalAmount, verticalAmount);
    }

    @Override
    public boolean keyPressed(int keyCode, int scanCode, int modifiers) {
        if (searchFocused) {
            if (keyCode == GLFW.GLFW_KEY_ESCAPE) {
                searchFocused = false;
                return true;
            }
            if (keyCode == GLFW.GLFW_KEY_BACKSPACE) {
                if (!search.isEmpty()) {
                    search = search.substring(0, search.length() - 1);
                    applySearchFilter();
                    meteordevelopment.meteorclient.utils.sound.MorzhSoundManager.playKeyPress();
                }
                return true;
            }
            if (keyCode == GLFW.GLFW_KEY_ENTER) {
                searchFocused = false;
                return true;
            }
        }

        for (DropDownPanel panel : panels) {
            panel.keyPressed(keyCode, scanCode, modifiers);
        }

        if (keyCode == GLFW.GLFW_KEY_ESCAPE) {
            if (!anyBinding()) requestClose();
            return true;
        }
        return super.keyPressed(keyCode, scanCode, modifiers);
    }

    @Override
    public boolean charTyped(char chr, int modifiers) {
        if (searchFocused && chr >= 32 && !Character.isISOControl(chr) && search.length() < 40) {
            search += chr;
            applySearchFilter();
            meteordevelopment.meteorclient.utils.sound.MorzhSoundManager.playKeyPress();
            return true;
        }

        for (DropDownPanel panel : panels) {
            panel.charTyped(chr, modifiers);
        }
        return super.charTyped(chr, modifiers);
    }

    private boolean anyBinding() {
        for (DropDownPanel panel : panels) {
            if (panel.isBinding()) return true;
        }
        return false;
    }

    @Override
    public void removed() {
        DropDownDraw.arrowCursorNow();
        super.removed();
    }
}


