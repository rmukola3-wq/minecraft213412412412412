import meteordevelopment.meteorclient.utils.sound.MorzhSoundManager;
import net.minecraft.client.MinecraftClient;
import net.minecraft.client.gui.screen.Screen;
import net.minecraft.util.Util;
import net.minecraft.util.math.MathHelper;

public final class MenuLeave {
    public static final long DURATION = 320L;

    private boolean leaving;
    private boolean applied;
    private long start;

    public void begin() {
        if (leaving) return;
        leaving = true;
        start = Util.getMeasuringTimeMs();
        MorzhSoundManager.playClose();
    }

    public boolean active() {
        return leaving;
    }

    public float progress(long now, float appear) {
        if (!leaving) return appear;
        float t = MathHelper.clamp((now - start) / (float) DURATION, 0f, 1f);
        return 1f - t * t * (3f - 2f * t);
    }

    public void finishIfDue(long now, MinecraftClient client, Screen parent) {
        if (!leaving || applied || client == null) return;
        if (now - start < DURATION) return;
        applied = true;
        client.execute(() -> client.setScreen(parent));
    }
}


