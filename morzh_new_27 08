            Sample sb = list.get(i);
            Color ca = fade(sa.color, 1f - (now - sa.at) / (float) life);
            Color cb = fade(sb.color, 1f - (now - sb.at) / (float) life);
            int v1 = mesh.vec3(sa.pos.x, sa.pos.y + y0, sa.pos.z).color(ca).next();
            int v2 = mesh.vec3(sa.pos.x, sa.pos.y + y1, sa.pos.z).color(ca).next();
            int v3 = mesh.vec3(sb.pos.x, sb.pos.y + y1, sb.pos.z).color(cb).next();
            int v4 = mesh.vec3(sb.pos.x, sb.pos.y + y0, sb.pos.z).color(cb).next();
            mesh.quad(v1, v2, v3, v4);
        }
    }

    private void drawGlow(List<Sample> list, long now, long life, double half) {
        for (int i = 1; i < list.size(); i++) {
            Sample sa = list.get(i - 1);
            Sample sb = list.get(i);
            Color ca = fade(sa.color, 1f - (now - sa.at) / (float) life);
            Color cb = fade(sb.color, 1f - (now - sb.at) / (float) life);
            Vec3d from = sa.pos.add(0, 0.9, 0);
            Vec3d to = sb.pos.add(0, 0.9, 0);
            Vec3d dir = to.subtract(from);
            Vec3d side = dir.crossProduct(from.subtract(camPos));
            if (side.lengthSquared() < 1.0e-8) side = new Vec3d(0, 1, 0);
            side = side.normalize().multiply(half);
            int i1 = mesh.vec3(from.x + side.x, from.y + side.y, from.z + side.z).color(ca).next();
            int i2 = mesh.vec3(from.x - side.x, from.y - side.y, from.z - side.z).color(ca).next();
            int i3 = mesh.vec3(to.x - side.x, to.y - side.y, to.z - side.z).color(cb).next();
            int i4 = mesh.vec3(to.x + side.x, to.y + side.y, to.z + side.z).color(cb).next();
            mesh.quad(i1, i2, i3, i4);
        }
    }

    private void drawParticles(List<Sample> list, long now, long life) {
        float yaw = (float) Math.toRadians(mc.gameRenderer.getCamera().getYaw());
        float pitch = (float) Math.toRadians(mc.gameRenderer.getCamera().getPitch());
        Vec3d right = new Vec3d(Math.cos(yaw), 0, Math.sin(yaw));
        Vec3d up = new Vec3d(-Math.sin(yaw) * Math.sin(pitch), Math.cos(pitch), Math.cos(yaw) * Math.sin(pitch));
        for (int i = 0; i < list.size(); i += 1) {
            Sample s = list.get(i);
            float t = 1f - (now - s.at) / (float) life;
            if (t <= 0) continue;
            double size = 0.07 + 0.05 * t;
            Color c = fade(s.color, t);
            Vec3d p = s.pos.add(0, 0.2 + (i % 3) * 0.35, 0);
            Vec3d h = right.multiply(size);
            Vec3d v = up.multiply(size);
            int i1 = mesh.vec3(p.subtract(h).add(v).x, p.subtract(h).add(v).y, p.subtract(h).add(v).z).color(c).next();
            int i2 = mesh.vec3(p.subtract(h).subtract(v).x, p.subtract(h).subtract(v).y, p.subtract(h).subtract(v).z).color(c).next();
            int i3 = mesh.vec3(p.add(h).subtract(v).x, p.add(h).subtract(v).y, p.add(h).subtract(v).z).color(c).next();
            int i4 = mesh.vec3(p.add(h).add(v).x, p.add(h).add(v).y, p.add(h).add(v).z).color(c).next();
            mesh.quad(i1, i2, i3, i4);
        }
        drawGlow(list, now, life, 0.03);
    }

    private static Color fade(Color base, float t) {
        t = MathHelper.clamp(t, 0, 1);
        Color c = base.copy();
        c.a(MathHelper.clamp((int) (base.a * t * t), 0, 255));
        return c;
    }

    private void drawFlight(Render3DEvent event, Entity entity, Color col) {
        Vec3d pos = new Vec3d(
            MathHelper.lerp(event.tickDelta, entity.prevX, entity.getX()),
            MathHelper.lerp(event.tickDelta, entity.prevY, entity.getY()),
            MathHelper.lerp(event.tickDelta, entity.prevZ, entity.getZ())
        );
        Vec3d vel = entity.getVelocity();
        for (int i = 0; i < 40; i++) {
            Vec3d next = pos.add(vel);
            if (pos.squaredDistanceTo(next) > 16) break;
            Color c = col.copy();
            c.a((int) (col.a * (1f - i / 40f)));
            event.renderer.line(pos.x, pos.y, pos.z, next.x, next.y, next.z, c);
            pos = next;
            vel = vel.multiply(0.99).add(0, -0.03, 0);
            if (pos.y < mc.world.getBottomY()) break;
        }
    }

    public enum Profile {
        ThunderHack,
        Pulse,
        Particles,
        Punch
    }

    private static final class Sample {
        Vec3d pos;
        long at;
        final Color color;

        Sample(Vec3d pos, long at, Color color) {
            this.pos = pos;
            this.at = at;
            this.color = color;
        }
    }

    private static class TrailMesh extends ShaderMesh {
        boolean additive;

        private TrailMesh() {
            super(Shaders.POS_COLOR, DrawMode.Triangles, Mesh.Attrib.Vec3, Mesh.Attrib.Color);
        }

        @Override
        protected void beforeRender() {
            super.beforeRender();
            GlStateManager._enableBlend();
            if (additive) GlStateManager._blendFunc(GL_SRC_ALPHA, GL_ONE);
            else GlStateManager._blendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
            GlStateManager._depthMask(!additive);
            GlStateManager._disableCull();
        }
    }
}


