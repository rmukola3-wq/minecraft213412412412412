/**
 * ThunderHack-style world particles: textured billboards + additive fireflies.
 */
public class WorldParticles extends Module {
    private static final Identifier TEX_FIREFLY = MeteorClient.identifier("textures/particles/firefly.png");
    private static final Identifier TEX_SNOW = MeteorClient.identifier("textures/particles/snowflake.png");
    private static final Identifier TEX_STAR = MeteorClient.identifier("textures/particles/star.png");
    private static final Identifier TEX_HEART = MeteorClient.identifier("textures/particles/heart.png");
    private static final Identifier TEX_DOLLAR = MeteorClient.identifier("textures/particles/dollar.png");

    private final SettingGroup sgGeneral = settings.getDefaultGroup();
    private final SettingGroup sgFireflies = settings.createGroup("Fireflies");

    private final Setting<Boolean> fireflies = sgFireflies.add(new BoolSetting.Builder()
        .name("fireflies")
        .description("ThunderHack firefly trails.")
        .defaultValue(true)
        .build()
    );

    private final Setting<Integer> ffCount = sgFireflies.add(new IntSetting.Builder()
        .name("ff-count")
        .defaultValue(30)
        .range(8, 200)
        .sliderRange(8, 120)
        .visible(fireflies::get)
        .build()
    );

    private final Setting<Double> ffSize = sgFireflies.add(new DoubleSetting.Builder()
        .name("ff-size")
        .defaultValue(1.0)
        .range(0.1, 2.5)
        .sliderRange(0.1, 2)
        .visible(fireflies::get)
        .build()
    );

    private final Setting<Mode> mode = sgGeneral.add(new EnumSetting.Builder<Mode>()
        .name("mode")
        .defaultValue(Mode.Stars)
        .build()
    );

    private final Setting<Integer> count = sgGeneral.add(new IntSetting.Builder()
        .name("count")
        .defaultValue(80)
        .range(10, 400)
        .sliderRange(10, 250)
        .build()
    );

    private final Setting<Double> size = sgGeneral.add(new DoubleSetting.Builder()
        .name("size")
        .defaultValue(1.0)
        .range(0.1, 6)
        .sliderRange(0.1, 4)
        .build()
    );

    private final Setting<Physics> physics = sgGeneral.add(new EnumSetting.Builder<Physics>()
        .name("physics")
        .defaultValue(Physics.Fly)
        .build()
    );

    private final Setting<SettingColor> color = sgGeneral.add(new ColorSetting.Builder()
        .name("color")
        .defaultValue(new SettingColor(180, 90, 255, 220))
        .build()
    );

    private final List<ParticleBase> particles = new ArrayList<>();
    private final List<FireFly> flies = new ArrayList<>();
    private final TexturedMesh mesh = new TexturedMesh();

    public WorldParticles() {
        super(Categories.Render, "world-particles", "ThunderHack-style custom particles around you.");
    }

    @Override
    public void onActivate() {
        particles.clear();
        flies.clear();
    }

    @Override
    public void onDeactivate() {
        particles.clear();
        flies.clear();
    }

    @EventHandler
    private void onTick(TickEvent.Post event) {
        if (mc.player == null || mc.world == null) return;

        ThreadLocalRandom rng = ThreadLocalRandom.current();

        flies.removeIf(FireFly::tick);
        particles.removeIf(ParticleBase::tick);

        if (fireflies.get()) {
            while (flies.size() < ffCount.get()) {
                flies.add(new FireFly(
                    (float) (mc.player.getX() + rng(-25f, 25f)),
                    (float) (mc.player.getY() + rng(2f, 15f)),
                    (float) (mc.player.getZ() + rng(-25f, 25f)),
                    rng(-0.2f, 0.2f),
                    rng(-0.1f, 0.1f),
                    rng(-0.2f, 0.2f)
                ));
            }
        } else {
            flies.clear();
        }

        if (mode.get() != Mode.Off) {
            boolean drop = physics.get() == Physics.Drop;
            while (particles.size() < count.get()) {
                particles.add(new ParticleBase(
                    (float) (mc.player.getX() + rng(-48f, 48f)),
                    (float) (mc.player.getY() + rng(2f, 48f)),
                    (float) (mc.player.getZ() + rng(-48f, 48f)),
                    drop ? 0 : rng(-0.4f, 0.4f),
                    drop ? rng(-0.2f, -0.05f) : rng(-0.1f, 0.1f),
                    drop ? 0 : rng(-0.4f, 0.4f)
                ));
            }
        } else {
            particles.clear();
        }
    }

    @EventHandler
    private void onRender(Render3DEvent event) {
        if (mc.player == null) return;

        if (!flies.isEmpty()) {
            mesh.texture = TEX_FIREFLY;
            mesh.additive = true;
            mesh.depthTest = true;
            mesh.begin();
            for (FireFly fly : flies) fly.render(event.tickDelta);
            mesh.render(event.matrices);
        }

        if (mode.get() != Mode.Off && !particles.isEmpty()) {
            mesh.texture = textureFor(mode.get());
            mesh.additive = true;
            mesh.depthTest = true;
            mesh.begin();
            for (ParticleBase p : particles) p.render(event.tickDelta);
            mesh.render(event.matrices);
        }
    }

    private Identifier textureFor(Mode m) {
        return switch (m) {
            case Bloom -> TEX_FIREFLY;
            case SnowFlake -> TEX_SNOW;
            case Hearts -> TEX_HEART;
            case Dollars -> TEX_DOLLAR;
            case Stars, Off -> TEX_STAR;
        };
    }

    private static float rng(float min, float max) {
        return (float) ThreadLocalRandom.current().nextDouble(min, max);
    }

    private void addBillboard(double x, double y, double z, double spriteSize, Color spriteColor) {
        if (spriteColor.a <= 0) return;

        float yaw = (float) Math.toRadians(mc.gameRenderer.getCamera().getYaw());
        float pitch = (float) Math.toRadians(mc.gameRenderer.getCamera().getPitch());

        double sinYaw = Math.sin(yaw);
        double cosYaw = Math.cos(yaw);
        double sinPitch = Math.sin(pitch);
        double cosPitch = Math.cos(pitch);

        Vec3d right = new Vec3d(cosYaw, 0, sinYaw);
        Vec3d up = new Vec3d(-sinYaw * sinPitch, cosPitch, cosYaw * sinPitch);

        Vec3d horizontal = right.multiply(spriteSize);
        Vec3d vertical = up.multiply(spriteSize);
        Vec3d center = new Vec3d(x, y, z);

        addQuad(
            center.subtract(horizontal).add(vertical),
            center.subtract(horizontal).subtract(vertical),
            center.add(horizontal).subtract(vertical),
            center.add(horizontal).add(vertical),
            spriteColor
        );
    }

    private void addQuad(Vec3d topLeft, Vec3d bottomLeft, Vec3d bottomRight, Vec3d topRight, Color color) {
        int i1 = mesh.vec3(topLeft.x, topLeft.y, topLeft.z).vec2(0, 0).color(color).next();
        int i2 = mesh.vec3(bottomLeft.x, bottomLeft.y, bottomLeft.z).vec2(0, 1).color(color).next();
        int i3 = mesh.vec3(bottomRight.x, bottomRight.y, bottomRight.z).vec2(1, 1).color(color).next();
        int i4 = mesh.vec3(topRight.x, topRight.y, topRight.z).vec2(1, 0).color(color).next();
        mesh.quad(i1, i2, i3, i4);
    }

    private class ParticleBase {
        float prevX, prevY, prevZ, x, y, z, mx, my, mz;
        int age, maxAge;

        ParticleBase(float x, float y, float z, float mx, float my, float mz) {
            this.x = this.prevX = x;
            this.y = this.prevY = y;
            this.z = this.prevZ = z;
            this.mx = mx;
            this.my = my;
            this.mz = mz;
            age = ThreadLocalRandom.current().nextInt(100, 300);
            maxAge = age;
        }

        boolean tick() {
            if (mc.player.squaredDistanceTo(x, y, z) > 4096) age -= 8;
            else age--;
            if (age < 0) return true;

            prevX = x;
            prevY = y;
            prevZ = z;
            x += mx;
            y += my;
            z += mz;
            mx *= 0.9f;
            if (physics.get() == Physics.Fly) my *= 0.9f;
            mz *= 0.9f;
            my -= 0.001f;
            return false;
        }

        void render(float tickDelta) {
            double ix = MathHelper.lerp(tickDelta, prevX, x);
            double iy = MathHelper.lerp(tickDelta, prevY, y);
            double iz = MathHelper.lerp(tickDelta, prevZ, z);
            Color base = color.get();
            int a = MathHelper.clamp((int) (base.a * (age / (float) maxAge)), 0, 255);
            addBillboard(ix, iy, iz, size.get() * 0.35, new Color(base.r, base.g, base.b, a));
        }
    }

    private class FireFly extends ParticleBase {
        private final ArrayDeque<Vec3d> trail = new ArrayDeque<>();

        FireFly(float x, float y, float z, float mx, float my, float mz) {
            super(x, y, z, mx, my, mz);
        }

        @Override
        boolean tick() {
            if (mc.player.squaredDistanceTo(x, y, z) > 100) age -= 4;
            else if (!mc.world.getBlockState(BlockPos.ofFloored(x, y, z)).isAir()) age -= 8;
            else age--;

            if (age < 0) return true;

            prevX = x;
            prevY = y;
            prevZ = z;
            x += mx;
            y += my;
            z += mz;
            mx *= 0.99f;
            my *= 0.99f;
            mz *= 0.99f;

            trail.addLast(new Vec3d(x, y, z));
            while (trail.size() > 8) trail.removeFirst();
            return false;
        }

        @Override
        void render(float tickDelta) {
            Color base = color.get();
            float life = age / (float) maxAge;
            int i = 0;
            for (Vec3d p : trail) {
                float t = i / (float) Math.max(1, trail.size());
                int a = MathHelper.clamp((int) (base.a * life * t), 0, 255);
                addBillboard(p.x, p.y, p.z, ffSize.get() * 0.35 * t, new Color(base.r, base.g, base.b, a));
                i++;
            }
        }
    }

    private static class TexturedMesh extends ShaderMesh {
        Identifier texture;
        boolean additive;

        private TexturedMesh() {
            super(Shaders.POS_TEX_COLOR, DrawMode.Triangles, Mesh.Attrib.Vec3, Mesh.Attrib.Vec2, Mesh.Attrib.Color);
        }

        @Override
        protected void beforeRender() {
            super.beforeRender();
            GL.bindTexture(texture);
            if (additive) GlStateManager._blendFunc(GL_SRC_ALPHA, GL_ONE);
            else GlStateManager._blendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
        }
    }

    public enum Mode {
        Off,
        SnowFlake,
        Stars,
        Hearts,
        Dollars,
        Bloom
    }

    public enum Physics {
        Fly,
        Drop
    }
}


