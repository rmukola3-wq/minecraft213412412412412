/**
 * Punch TargetPearl trajectory + Rasty silent throw.
 * Chases an enemy pearl landing with one automatic throw.
 */
public class AutoPearl extends Module {
    private static final long THROW_COOLDOWN_MS = 2500L;
    private static final long TARGET_MEMORY_MS = 10_000L;
    private static final double MAX_LANDING = 120.0;

    private final SettingGroup sg = settings.getDefaultGroup();

    private final Setting<Boolean> onlyTarget = sg.add(new BoolSetting.Builder()
        .name("только-цель")
        .description("Кидать только за перлом цели ауры (цель помнится 10 сек).")
        .defaultValue(true)
        .build()
    );

    private final Setting<Boolean> ignoreFriends = sg.add(new BoolSetting.Builder()
        .name("игнор-друзей")
        .description("Не догонять перлы друзей.")
        .defaultValue(true)
        .build()
    );

    private final Setting<Double> minDist = sg.add(new DoubleSetting.Builder()
        .name("мин-дистанция")
        .description("Не кидать, если ленд ближе.")
        .defaultValue(10)
        .min(4)
        .sliderMax(30)
        .build()
    );

    private final Setting<Boolean> noThrowOnEntity = sg.add(new BoolSetting.Builder()
        .name("не-кидать-в-игрока")
        .description("Не кидать, если траектория проходит через игрока.")
        .defaultValue(true)
        .build()
    );

    private final Setting<Boolean> whileEating = sg.add(new BoolSetting.Builder()
        .name("пока-ешь")
        .description("Вкл — прервать еду и кинуть. Выкл — ждать, пока доешь, еда перл не блокирует.")
        .defaultValue(true)
        .build()
    );

    private final Map<Integer, String> pearlOwners = new HashMap<>();
    private final Set<Integer> handledPearls = new HashSet<>();
    private Entity rememberedTarget;
    private long rememberedTargetAt;
    private long lastThrowAt;
    private int restoreSlot = -1;
    private int restoreTicks;
    private boolean throwing;

    public AutoPearl() {
        super(
            Categories.Combat,
            "auto-pearl",
            "Догоняет чужой перл: считает ленд и кидает в ту же точку.",
            "targetpearl",
            "target-pearl"
        );
    }

    @Override
    public void onActivate() {
        pearlOwners.clear();
        handledPearls.clear();
        rememberedTarget = null;
        rememberedTargetAt = 0;
        lastThrowAt = 0;
        restoreSlot = -1;
        restoreTicks = 0;
        throwing = false;
    }

    @Override
    public void onDeactivate() {
        throwing = false;
        rememberedTarget = null;
    }

    public boolean isThrowing() {
        return isActive() && throwing;
    }

    @EventHandler
    private void onSpawn(PacketEvent.Receive event) {
        if (!(event.packet instanceof EntitySpawnS2CPacket spawn)) return;
        if (spawn.getEntityType() != EntityType.ENDER_PEARL || mc.world == null || mc.player == null) return;

        PlayerEntity closest = null;
        double best = 9.0;
        for (PlayerEntity player : mc.world.getPlayers()) {
            if (player == mc.player) continue;
            double d = player.squaredDistanceTo(spawn.getX(), spawn.getY(), spawn.getZ());
            if (d < best) {
                best = d;
                closest = player;
            }
        }
        pearlOwners.put(spawn.getEntityId(), closest != null ? closest.getName().getString() : "");
    }

    @EventHandler
    private void onTick(TickEvent.Pre event) {
        if (mc.player == null || mc.world == null || mc.interactionManager == null) return;
        if (restoreTicks > 0 && restoreSlot >= 0) {
            restoreTicks--;
            if (restoreTicks == 0) {
                InvUtils.swap(restoreSlot, false);
                restoreSlot = -1;
            }
        }

        throwing = false;
        cleanup();
        if (mc.currentScreen != null || mc.player.isGliding()) return;
        if (System.currentTimeMillis() - lastThrowAt < THROW_COOLDOWN_MS) return;
        if (mc.player.getItemCooldownManager().isCoolingDown(Items.ENDER_PEARL.getDefaultStack())) return;
        if (mc.player.isUsingItem() && !whileEating.get()) return;
        if (!hasPearl()) return;

        EnderPearlEntity pearl = findPearl();
        if (pearl == null) return;

        Vec3d landing = predictLanding(pearl);
        if (landing == null) return;

        double dist = mc.player.getPos().distanceTo(landing);
        if (dist < minDist.get() || dist > MAX_LANDING) return;

        float[] rot = calculateYawPitch(landing);
        if (rot == null) rot = findAnyWorkingRotation(landing);
        if (rot == null) return;

        Vec3d predicted = simulateTrajectory(rot[0], rot[1]);
        if (predicted != null) {
            double maxErr = errorBudget(landing);
            if (landing.distanceTo(predicted) > maxErr) {
                rot = findAnyWorkingRotation(landing);
                if (rot == null) return;
                predicted = simulateTrajectory(rot[0], rot[1]);
                if (predicted == null || landing.distanceTo(predicted) > maxErr * 1.5) return;
            }
        }

        if (noThrowOnEntity.get() && hasPlayerOnPath(rot[0], rot[1])) return;
        if (!throwPearl(rot[0], rot[1])) return;

        handledPearls.add(pearl.getId());
        lastThrowAt = System.currentTimeMillis();
        throwing = true;
    }

    private EnderPearlEntity findPearl() {
        Entity chase = chaseTarget();
        EnderPearlEntity best = null;
        double bestDist = Double.MAX_VALUE;

        for (Entity entity : mc.world.getEntities()) {
            if (!(entity instanceof EnderPearlEntity pearl) || !pearl.isAlive() || pearl.isRemoved()) continue;
            if (handledPearls.contains(pearl.getId())) continue;
            if (isOwnPearl(pearl)) continue;
            if (isFriendPearl(pearl)) continue;
            if (onlyTarget.get()) {
                if (chase == null) continue;
                Entity owner = resolveOwner(pearl);
                if (owner != chase) continue;
            }

            Vec3d landing = predictLanding(pearl);
            if (landing == null) continue;
            double dist = mc.player.getPos().distanceTo(landing);
            if (dist < minDist.get() || dist > MAX_LANDING || dist >= bestDist) continue;
            bestDist = dist;
            best = pearl;
        }
        return best;
    }

    private Entity chaseTarget() {
        LivingEntity aura = CombatTargets.current();
        long now = System.currentTimeMillis();
        if (aura != null && aura.isAlive()) {
            rememberedTarget = aura;
            rememberedTargetAt = now;
            return aura;
        }
        if (rememberedTarget != null) {
            if (!rememberedTarget.isAlive()) {
                rememberedTarget = null;
                return null;
            }
            if (now - rememberedTargetAt < TARGET_MEMORY_MS) return rememberedTarget;
            rememberedTarget = null;
        }
        return null;
    }

    private Entity resolveOwner(EnderPearlEntity pearl) {
        Entity owner = pearl.getOwner();
        if (owner != null) return owner;

        UUID uuid = ownerUuid(pearl);
        if (uuid != null) {
            if (uuid.equals(mc.player.getUuid())) return mc.player;
            for (PlayerEntity player : mc.world.getPlayers()) {
                if (player.getUuid().equals(uuid)) return player;
            }
        }

        String name = pearlOwners.get(pearl.getId());
        if (name != null && !name.isEmpty()) {
            for (PlayerEntity player : mc.world.getPlayers()) {
                if (player.getName().getString().equals(name)) return player;
            }
        }

        PlayerEntity nearest = null;
        double best = Double.MAX_VALUE;
        for (PlayerEntity player : mc.world.getPlayers()) {
            double d = player.squaredDistanceTo(pearl);
            if (d < best) {
                best = d;
                nearest = player;
            }
        }
        return nearest;
    }

    private boolean isOwnPearl(EnderPearlEntity pearl) {
        if (pearl.getOwner() == mc.player) return true;
        UUID uuid = ownerUuid(pearl);
        if (uuid != null && uuid.equals(mc.player.getUuid())) return true;
        String owner = pearlOwners.get(pearl.getId());
        return owner != null && owner.isEmpty();
    }

    private boolean isFriendPearl(EnderPearlEntity pearl) {
        if (!ignoreFriends.get()) return false;
        Entity owner = resolveOwner(pearl);
        return owner instanceof PlayerEntity player && Friends.get().isFriend(player);
    }

    private UUID ownerUuid(EnderPearlEntity pearl) {
        try {
            return ((ProjectileEntityAccessor) pearl).getOwnerUuid();
        } catch (Throwable ignored) {
            return null;
        }
    }

    private Vec3d predictLanding(EnderPearlEntity pearl) {
        Vec3d pos = pearl.getPos();
        Vec3d vel = pearl.getVelocity();
        for (int i = 0; i < 200; i++) {
            Vec3d next = pos.add(vel);
            vel = vel.multiply(0.99).add(0, -0.03, 0);
            if (next.y <= mc.world.getBottomY()) return snap(next);
            BlockPos bp = BlockPos.ofFloored(next);
            if (!mc.world.getBlockState(bp).getCollisionShape(mc.world, bp).isEmpty()) return snap(next);
            pos = next;
        }
        return null;
    }

    private Vec3d snap(Vec3d v) {
        return new Vec3d(MathHelper.floor(v.x) + 0.5, MathHelper.floor(v.y), MathHelper.floor(v.z) + 0.5);
    }

    private float[] calculateYawPitch(Vec3d target) {
        Vec3d eye = mc.player.getEyePos();
        double dx = target.x - eye.x;
        double dz = target.z - eye.z;
        float yaw = (float) Math.toDegrees(Math.atan2(dz, dx)) - 90f;
        double dist = eye.distanceTo(target);
        double hDiff = target.y - eye.y;
        boolean high = hDiff > 5.0;

        float maxPitch = high ? 89f : 85f;
        float minPitch = high ? -80f : (dist > 60 ? -50f : -30f);
        float step = high ? 0.2f : (dist > 60 ? 0.3f : 0.25f);
        double maxErr = high ? 4.0 : 2.0;

        float bestPitch = Float.MAX_VALUE;
        int bestTicks = Integer.MAX_VALUE;
        double bestError = Double.MAX_VALUE;

        for (float pitch = maxPitch; pitch >= minPitch; pitch -= step) {
            SimResult res = simulateWithTicks(yaw, pitch, target);
            if (res != null && res.error <= maxErr) {
                if (res.ticks < bestTicks || (res.ticks == bestTicks && res.error < bestError)) {
                    bestTicks = res.ticks;
                    bestPitch = pitch;
                    bestError = res.error;
                }
            }
        }
        if (bestTicks == Integer.MAX_VALUE) return null;
        return new float[]{yaw, MathHelper.clamp(bestPitch, -90f, 90f)};
    }

    private float[] findAnyWorkingRotation(Vec3d target) {
        Vec3d eye = mc.player.getEyePos();
        double dx = target.x - eye.x;
        double dz = target.z - eye.z;
        float baseYaw = (float) Math.toDegrees(Math.atan2(dz, dx)) - 90f;
        double dist = eye.distanceTo(target);
        boolean high = target.y - eye.y > 5.0;

        float maxPitch = high ? 89f : 85f;
        float minPitch = high ? -85f : (dist > 60 ? -70f : -50f);
        float step = high ? 0.8f : (dist > 60 ? 1.0f : 1.2f);
        float yawRange = high ? 40f : (dist > 60 ? 30f : 20f);
        float yawStep = high ? 2f : (dist > 60 ? 3f : 2.5f);
        double baseErr = high ? 4.5 : (dist > 60 ? 3.0 : 2.25);

        for (float pitch = maxPitch; pitch >= minPitch; pitch -= step) {
            Vec3d landing = simulateTrajectory(baseYaw, pitch);
            if (landing != null && target.distanceTo(landing) <= baseErr) {
                return new float[]{baseYaw, MathHelper.clamp(pitch, -90f, 90f)};
            }
        }

        for (float yawOff = -yawRange; yawOff <= yawRange; yawOff += yawStep) {
            if (yawOff == 0) continue;
            float yaw = baseYaw + yawOff;
            for (float pitch = maxPitch; pitch >= minPitch; pitch -= step) {
                Vec3d landing = simulateTrajectory(yaw, pitch);
                if (landing != null && target.distanceTo(landing) <= baseErr) {
                    return new float[]{yaw, MathHelper.clamp(pitch, -90f, 90f)};
                }
            }
        }
        return null;
    }

    private double errorBudget(Vec3d landing) {
        Vec3d eye = mc.player.getEyePos();
        double dist = eye.distanceTo(landing);
        boolean high = landing.y - eye.y > 5.0;
        double maxErr = dist > 60 ? 3.0 : 2.25;
        if (high) maxErr = 4.5;
        if (hasObstacleBetween(eye, landing)) maxErr = high ? 6.0 : 3.75;
        return maxErr;
    }

    private boolean hasObstacleBetween(Vec3d start, Vec3d end) {
        Vec3d dir = end.subtract(start);
        double len = dir.length();
        if (len < 0.001) return false;
        Vec3d norm = dir.normalize();
        int steps = (int) (len / 0.5) + 1;
        for (int i = 1; i < steps; i++) {
            BlockPos bp = BlockPos.ofFloored(start.add(norm.multiply(i * 0.5)));
            if (!mc.world.getBlockState(bp).getCollisionShape(mc.world, bp).isEmpty()) return true;
        }
        return false;
    }

    private boolean hasPlayerOnPath(float yaw, float pitch) {
        Vec3d pos = throwPos(yaw);
        Vec3d motion = throwMotion(yaw, pitch);
        for (int i = 0; i < 200; i++) {
            Vec3d prev = pos;
            pos = pos.add(motion);
            motion = motion.multiply(0.99).add(0, -0.03, 0);
            if (pos.y <= mc.world.getBottomY()) break;
            BlockPos bp = BlockPos.ofFloored(pos);
            if (!mc.world.getBlockState(bp).getCollisionShape(mc.world, bp).isEmpty()) break;
            Box segment = new Box(prev, pos).expand(0.35);
            for (Entity entity : mc.world.getOtherEntities(mc.player, segment, e ->
                e instanceof PlayerEntity && e.isAlive() && !e.isSpectator() && e != mc.player)) {
                if (entity.getBoundingBox().expand(0.25).intersects(segment)) return true;
            }
        }
        return false;
    }

    private SimResult simulateWithTicks(float yaw, float pitch, Vec3d target) {
        Vec3d pos = throwPos(yaw);
        Vec3d motion = throwMotion(yaw, pitch);
        for (int t = 0; t < 200; t++) {
            pos = pos.add(motion);
            motion = motion.multiply(0.99).add(0, -0.03, 0);
            if (pos.y <= mc.world.getBottomY()) return new SimResult(snap(pos).distanceTo(target), t + 1);
            BlockPos bp = BlockPos.ofFloored(pos);
            if (!mc.world.getBlockState(bp).getCollisionShape(mc.world, bp).isEmpty()) {
                return new SimResult(snap(pos).distanceTo(target), t + 1);
            }
        }
        return null;
    }

    private Vec3d simulateTrajectory(float yaw, float pitch) {
        Vec3d pos = throwPos(yaw);
        Vec3d motion = throwMotion(yaw, pitch);
        for (int i = 0; i < 200; i++) {
            pos = pos.add(motion);
            motion = motion.multiply(0.99).add(0, -0.03, 0);
            if (pos.y <= mc.world.getBottomY()) return snap(pos);
            BlockPos bp = BlockPos.ofFloored(pos);
            if (!mc.world.getBlockState(bp).getCollisionShape(mc.world, bp).isEmpty()) return snap(pos);
        }
        return null;
    }

    private Vec3d throwPos(float yaw) {
        float yr = (float) Math.toRadians(yaw);
        return new Vec3d(
            mc.player.getX() - MathHelper.cos(yr) * 0.16,
            mc.player.getY() + mc.player.getEyeHeight(mc.player.getPose()) - 0.1,
            mc.player.getZ() - MathHelper.sin(yr) * 0.16
        );
    }

    private Vec3d throwMotion(float yaw, float pitch) {
        float yr = (float) Math.toRadians(yaw);
        float pr = (float) Math.toRadians(pitch);
        return new Vec3d(
            -MathHelper.sin(yr) * MathHelper.cos(pr) * 1.5,
            -MathHelper.sin(pr) * 1.5 + mc.player.getVelocity().y,
            MathHelper.cos(yr) * MathHelper.cos(pr) * 1.5
        );
    }

    private boolean throwPearl(float yaw, float pitch) {
        if (whileEating.get()) cancelEating();
        else if (mc.player.isUsingItem()) return false;

        mc.player.networkHandler.sendPacket(new PlayerMoveC2SPacket.LookAndOnGround(
            yaw, pitch, mc.player.isOnGround(), mc.player.horizontalCollision
        ));

        if (mc.player.getOffHandStack().isOf(Items.ENDER_PEARL)) {
            sendUse(Hand.OFF_HAND, yaw, pitch);
            return true;
        }

        int previous = mc.player.getInventory().selectedSlot;
        FindItemResult hotbar = InvUtils.findInHotbar(Items.ENDER_PEARL);
        if (hotbar.found() && hotbar.isHotbar()) {
            if (hotbar.slot() != previous) {
                restoreSlot = previous;
                InvUtils.swap(hotbar.slot(), false);
                restoreTicks = 1;
            }
            sendUse(Hand.MAIN_HAND, yaw, pitch);
            return true;
        }

        FindItemResult inv = InvUtils.find(Items.ENDER_PEARL);
        if (!inv.found() || !inv.isMain()) return false;
        int temp = findTempHotbar(previous);
        int sync = mc.player.currentScreenHandler.syncId;
        int serverSlot = SlotUtils.indexToId(inv.slot());
        if (serverSlot < 0) return false;
        mc.interactionManager.clickSlot(sync, serverSlot, temp, SlotActionType.SWAP, mc.player);
        if (temp != previous) {
            restoreSlot = previous;
            InvUtils.swap(temp, false);
            restoreTicks = 1;
        }
        sendUse(Hand.MAIN_HAND, yaw, pitch);
        mc.interactionManager.clickSlot(sync, serverSlot, temp, SlotActionType.SWAP, mc.player);
        return true;
    }

    private void sendUse(Hand hand, float yaw, float pitch) {
        try {
            ((ClientPlayerInteractionManagerInvoker) mc.interactionManager).meteor$sendSequencedPacket(
                mc.world,
                seq -> new PlayerInteractItemC2SPacket(hand, seq, yaw, pitch)
            );
        } catch (Throwable ignored) {
            mc.player.networkHandler.sendPacket(new PlayerInteractItemC2SPacket(hand, 0, yaw, pitch));
        }
        mc.player.networkHandler.sendPacket(new HandSwingC2SPacket(hand));
    }

    private int findTempHotbar(int previous) {
        for (int slot = 0; slot < 9; slot++) {
            if (slot != previous && mc.player.getInventory().getStack(slot).isEmpty()) return slot;
        }
        return previous == 8 ? 7 : 8;
    }

    private boolean hasPearl() {
        if (mc.player.getOffHandStack().isOf(Items.ENDER_PEARL)) return true;
        return InvUtils.find(Items.ENDER_PEARL).found();
    }

    private void cancelEating() {
        AutoGap gap = Modules.get().get(AutoGap.class);
        if (gap != null) gap.interruptForPearl();
        AutoEat eat = Modules.get().get(AutoEat.class);
        if (eat != null) eat.interruptForPearl();
        mc.options.useKey.setPressed(false);
        if (mc.player.isUsingItem() && mc.interactionManager != null) {
            mc.interactionManager.stopUsingItem(mc.player);
            mc.player.networkHandler.sendPacket(new PlayerActionC2SPacket(
                PlayerActionC2SPacket.Action.RELEASE_USE_ITEM, BlockPos.ORIGIN, Direction.DOWN
            ));
            mc.player.stopUsingItem();
        }
    }

    private void cleanup() {
        Set<Integer> live = new HashSet<>();
        for (Entity entity : mc.world.getEntities()) {
            if (entity instanceof EnderPearlEntity) live.add(entity.getId());
        }
        pearlOwners.keySet().removeIf(id -> !live.contains(id));
        handledPearls.removeIf(id -> !live.contains(id));
    }

    private static final class SimResult {
        final double error;
        final int ticks;

        SimResult(double error, int ticks) {
            this.error = error;
            this.ticks = ticks;
        }
    }
}


