    @EventHandler
    private void onTick(TickEvent.Post event) {
        if (mc.player == null) return;
        if (profile.get() == Profile.Xyeta) {
            if (!xyetaOnGround && mc.player.isOnGround()) xyetaOnGround = true;
            if (xyetaOnGround && !mc.player.isOnGround()) {
                circles.add(Circle.xyeta(new Vec3d(mc.player.getX(), Math.floor(mc.player.getY()) + 0.05, mc.player.getZ()), xyetaAnim.get(), xyetaMode.get()));
                xyetaOnGround = false;
            }
            if (mc.currentScreen instanceof DeathScreen) xyetaOnGround = false;
        }

        long now = System.currentTimeMillis();
        circles.removeIf(c -> c.dead(now,
            c.profile == Profile.Rockstar ? (int) (1700 + rockstarSpeed.get() * 20) : lifetime.get(),
            xyetaTime.get(), uzbekRadius.get().floatValue()));
    }

    @EventHandler
    private void onRender(Render3DEvent event) {
        if (circles.isEmpty()) return;

        Camera camera = mc.gameRenderer.getCamera();
        Vec3d cam = camera.getPos();
        SettingColor theme = color.get();
        packed.set(theme.r, theme.g, theme.b, theme.a);

        boolean anyTex = false;
        boolean anyFill = false;
        boolean anyLine = false;
        for (Circle c : circles) {
            if (c.profile == Profile.Expensive || c.profile == Profile.Rockstar) anyTex = true;
            else anyFill = true;
            if (c.profile == Profile.Xyeta) anyLine = true;
        }

        if (anyTex) {
            texMesh.depthTest = true;
            texMesh.additive = true;
            texMesh.begin();
        }
        if (anyFill) {
            fillMesh.depthTest = true;
            fillMesh.begin();
        }
        if (anyLine) {
            lineMesh.depthTest = true;
            lineMesh.begin();
        }

        long now = System.currentTimeMillis();
        for (Circle c : circles) {
            switch (c.profile) {
                case Expensive -> {
                    float progress = c.expensiveProgress(now, lifetime.get());
                    if (progress <= 1.0f) renderExpensive(cam, c.pos.subtract(cam), size.get(), 1.0f - progress);
                }
                case Rockstar -> renderRockstar(cam, c, now);
                case Xyeta -> renderXyeta(cam, c, now);
                case UZBEk -> renderUzbek(c, now);
            }
        }

        if (anyTex) texMesh.render(event.matrices);
        if (anyFill) fillMesh.render(event.matrices);
        if (anyLine) lineMesh.render(event.matrices);

        // Overlay must not leave depthMask/blend dirty — that clips first-person hands into walls.
        GlStateManager._depthMask(true);
        GlStateManager._blendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
    }

    private void spawnExpensive() {
        float tickDelta = mc.getRenderTickCounter().getTickDelta(true);
        Vec3d pos = mc.player.getLerpedPos(tickDelta).add(0.0d, 0.01d, 0.0d);
        if (profile.get() == Profile.Rockstar) circles.add(Circle.rockstar(pos));
        else circles.add(Circle.expensive(pos));
    }

    private void spawnUzbek() {
        Vec3d pos = mc.player.getPos();
        long duration = (long) (500.0 / uzbekSpeed.get());
        circles.add(Circle.uzbek(new Vec3d(pos.x, pos.y + 0.05, pos.z), duration));
    }

    private void renderExpensive(Vec3d cam, Vec3d rel, double d, float f) {
        double dEase = d * 1.5d * easeOutCubic(1.0f - f);
        float f2 = (f > 0.5f ? 1.0f - f : f) * 2.0f;
        float fMin = Math.min((f2 < 0.5f ? 2.0f * f2 * f2 : 1.0f - (((float) Math.pow((-2.0f) * f2 + 2.0f, 2.0d)) / 2.0f)) * 1.75f, 1.0f);

        MatrixStack matrices = new MatrixStack();
        matrices.translate(rel.getX() - (dEase / 2.0d), rel.getY(), rel.getZ() - (dEase / 2.0d));
        matrices.multiply(RotationAxis.POSITIVE_X.rotationDegrees(90.0f));

        int alpha = MathHelper.clamp((int) (packed.a * fMin), 0, 255);
        Color sprite = new Color(packed.r, packed.g, packed.b, alpha);
        addTexture(matrices.peek().getPositionMatrix(), cam, 0.0f, 0.0f, (float) dEase, (float) dEase, sprite);
    }

    /** New Rockstar: 14 stacked glow discs, ease-out-back scale, rainbow corners. */
    private void renderRockstar(Vec3d cam, Circle c, long now) {
        float anim = c.rockstarScale(now);
        float alphaMul = c.rockstarAlpha(now, (int) (1700 + rockstarSpeed.get() * 20));
        if (alphaMul <= 0.01f || anim <= 0.01f) return;

        float sizeF = size.get().floatValue() * anim;
        Vec3d rel = c.pos.subtract(cam);
        MatrixStack matrices = new MatrixStack();
        matrices.translate(rel.x, rel.y - 0.49f * sizeF, rel.z);
        matrices.multiply(RotationAxis.POSITIVE_X.rotationDegrees(90.0f));

        Color a = new Color();
        Color b = new Color();
        Color d = new Color();
        Color e = new Color();
        for (int i = 0; i < 14; i++) {
            matrices.translate(0, 0, -0.03f);
            float layer = alphaMul * (1f - i / 14f) / 2f;
            int aa = MathHelper.clamp((int) (packed.a * layer), 0, 255);
            hueCorner(a, 0.25f, aa);
            hueCorner(b, 0.50f, aa);
            hueCorner(d, 0.66f, aa);
            hueCorner(e, 1.00f, aa);
            addTextureCorners(matrices.peek().getPositionMatrix(), cam, -sizeF / 2f, -sizeF / 2f, sizeF, sizeF, a, b, d, e);
        }
    }

    private void hueCorner(Color out, float t, int alpha) {
        float hue = (t + (System.currentTimeMillis() % 4000) / 4000f) % 1f;
        int rgb = java.awt.Color.HSBtoRGB(hue, 0.45f, 1f);
        out.set((rgb >> 16) & 255, (rgb >> 8) & 255, rgb & 255, alpha);
        if (packed.r + packed.g + packed.b < 760) {
            out.set(
                (out.r * packed.r) / 255,
                (out.g * packed.g) / 255,
                (out.b * packed.b) / 255,
                alpha
            );
        }
    }

    private void renderXyeta(Vec3d cam, Circle c, long now) {
        c.tickAnim(now, xyetaAnim.get() + xyetaTime.get());
        double animOut = c.animOutput(now);
        float alpha = xyetaAlphaAnim.get() ? (float) animOut : 2.0f;
        if (alpha < 0.01f) return;
        float animVal = xyetaAnimValue.get().floatValue();
        float sizeF = xyetaSizeAnim.get() ? (float) ((1.0f - animVal) + animOut * animVal) : 1.0f;
        float r = sizeF * xyetaRadius.get().floatValue();

        MatrixStack stack = new MatrixStack();
        stack.translate(c.pos.x - cam.x, c.pos.y - cam.y, c.pos.z - cam.z);
        stack.multiply(RotationAxis.POSITIVE_X.rotationDegrees(90.0f));
        xyeta.draw(c.xyetaMode, fillMesh, lineMesh, stack.peek().getPositionMatrix(), cam, r, alpha, now - c.birth, packed);
    }

    private void renderUzbek(Circle c, long now) {
        float maxR = uzbekRadius.get().floatValue();
        float t = MathHelper.clamp((now - c.birth) / (float) c.uzbekDuration, 0.0f, 1.0f);
        float current = sineInOut(t) * maxR;
        float alpha = uzbekAlpha(current, maxR);
        float glow = uzbekGlow.get().floatValue() * 20.0f;
        if (alpha <= 0.0f) alpha = 0.0f;

        int a = MathHelper.clamp((int) alpha, 0, 255);
        uzOuter.set(packed.r, packed.g, packed.b, a);
        uzInner.set(packed.r, packed.g, packed.b, 0);

        double x = c.pos.x;
        double y = c.pos.y;
        double z = c.pos.z;
        float step = (float) Math.PI / 180.0f;
        for (float deg = 0.0f; deg < 360.0f; deg += 8.0f) {
            double s0 = Math.sin((deg - 8.0f) * step);
            double c0 = Math.cos((deg - 8.0f) * step);
            double s1 = Math.sin(deg * step);
            double c1 = Math.cos(deg * step);

            double inner = current - current / 100.0f * glow;
            uzbekQuad(x, y, z, current, inner, s1, c1, s0, c0);

            double outer = current + current / 100.0f * glow;
            uzbekQuad(x, y, z, current, outer, s1, c1, s0, c0);

            double mid = current + (current - outer) / 8.0;
            uzbekQuad(x, y, z, current, mid, s1, c1, s0, c0);
        }
    }

    private void uzbekQuad(double x, double y, double z, float ring, double glowR, double s1, double c1, double s0, double c0) {
        int i1 = fillMesh.vec3(x + s0 * glowR, y, z + c0 * glowR).color(uzInner).next();
        int i2 = fillMesh.vec3(x + s0 * ring, y, z + c0 * ring).color(uzOuter).next();
        int i3 = fillMesh.vec3(x + s1 * ring, y, z + c1 * ring).color(uzOuter).next();
        int i4 = fillMesh.vec3(x + s1 * glowR, y, z + c1 * glowR).color(uzInner).next();
        fillMesh.quad(i1, i2, i3, i4);
    }

    private float uzbekAlpha(float current, float maxR) {
        float maxAlpha = 255.0f;
        float threshold = current / 6.0f;
        float alpha = current > threshold ? maxAlpha - threshold * 2000.0f / maxR : maxAlpha;
        return Math.max(0.0f, alpha);
    }

    private void addTexture(Matrix4f matrix, Vec3d cam, float x, float y, float w, float h, Color sprite) {
        addTextureCorners(matrix, cam, x, y, w, h, sprite, sprite, sprite, sprite);
    }

    private void addTextureCorners(Matrix4f matrix, Vec3d cam, float x, float y, float w, float h, Color c1, Color c2, Color c3, Color c4) {
        int i1 = corner(matrix, cam, x, y, 0, 0, c1);
        int i2 = corner(matrix, cam, x, y + h, 0, 1, c2);
        int i3 = corner(matrix, cam, x + w, y + h, 1, 1, c3);
        int i4 = corner(matrix, cam, x + w, y, 1, 0, c4);
        texMesh.quad(i1, i2, i3, i4);
    }

    private int corner(Matrix4f matrix, Vec3d cam, float lx, float ly, float u, float v, Color sprite) {
        Vector4f p = new Vector4f(lx, ly, 0.0f, 1.0f);
        p.mul(matrix);
        return texMesh.vec3(p.x + cam.x, p.y + cam.y, p.z + cam.z).vec2(u, v).color(sprite).next();
    }

    private static float easeOutCubic(float t) {
        float inv = 1.0f - MathHelper.clamp(t, 0.0f, 1.0f);
        return 1.0f - inv * inv * inv;
    }

    private static float sineInOut(float t) {
        return (float) (-(Math.cos(Math.PI * t) - 1.0) / 2.0);
    }

    public enum Profile {
        Rockstar("Rockstar"),
        Expensive("Expensive"),
        Xyeta("Xyeta"),
        UZBEk("UZBEk");

        private final String title;

        Profile(String title) {
