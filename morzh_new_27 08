    public boolean deltaModifyClearColor(float[] outRgba) {
        if (!deltaActive() || !deltaCustomFog.get()) return false;
        SettingColor c = deltaFogColor.get();
        outRgba[0] = c.r / 255f;
        outRgba[1] = c.g / 255f;
        outRgba[2] = c.b / 255f;
        outRgba[3] = c.a / 255f;
        return true;
    }

    public Fog deltaApplyFog(Fog original, Camera camera, float viewDistance) {
        if (!deltaActive() || !deltaCustomFog.get() || original == null) return original;
        FogShape shape = original.shape();
        if (camera.getSubmersionType() == CameraSubmersionType.NONE) {
            shape = FogShape.SPHERE;
        }
        SettingColor c = deltaFogColor.get();
        float start = MathHelper.clamp(deltaFogDistance.get().floatValue(), -8.0f, viewDistance);
        float end = MathHelper.clamp(deltaFogDistance.get().floatValue() + deltaFogDensity.get().floatValue(), 0.0f, viewDistance);
        return new Fog(start, end, shape, c.r / 255f, c.g / 255f, c.b / 255f, c.a / 255f);
    }

