package meteordevelopment.meteorclient.systems.hud.elements;

import meteordevelopment.meteorclient.gui.morzh.MorzhSmoothRenderer;
import meteordevelopment.meteorclient.mixin.MinecraftClientAccessor;
import meteordevelopment.meteorclient.settings.BoolSetting;
import meteordevelopment.meteorclient.settings.Setting;
import meteordevelopment.meteorclient.settings.SettingGroup;
import meteordevelopment.meteorclient.systems.hud.Hud;
import meteordevelopment.meteorclient.systems.hud.HudChrome;
import meteordevelopment.meteorclient.systems.hud.HudElementInfo;
import meteordevelopment.meteorclient.systems.hud.HudRenderer;
import meteordevelopment.meteorclient.systems.hud.ScaledHudElement;
import meteordevelopment.meteorclient.utils.Utils;
import net.minecraft.client.gui.DrawContext;
import net.minecraft.client.network.PlayerListEntry;

import java.time.LocalTime;
import java.time.format.DateTimeFormatter;
import java.util.ArrayList;
import java.util.List;

import static meteordevelopment.meteorclient.MeteorClient.mc;

/** New Rockstar watermark: brand plate + info chips. */
public class WatermarkHud extends ScaledHudElement {
    public static final HudElementInfo<WatermarkHud> INFO = new HudElementInfo<>(
        Hud.GROUP, "watermark", "Rockstar watermark: brand + chips.", WatermarkHud::new
    );

    private static final DateTimeFormatter TIME = DateTimeFormatter.ofPattern("HH:mm");

    private final SettingGroup sg = settings.getDefaultGroup();

    private final Setting<Boolean> showName = sg.add(new BoolSetting.Builder()
        .name("имя").description("Ник в ватермарке.").defaultValue(true).build());
    private final Setting<Boolean> showFps = sg.add(new BoolSetting.Builder()
        .name("fps").description("Счётчик FPS.").defaultValue(true).build());
    private final Setting<Boolean> showPing = sg.add(new BoolSetting.Builder()
        .name("пинг").description("Пинг до сервера.").defaultValue(true).build());
    private final Setting<Boolean> showServer = sg.add(new BoolSetting.Builder()
        .name("сервер").description("Адрес сервера.").defaultValue(false).build());
    private final Setting<Boolean> showTime = sg.add(new BoolSetting.Builder()
        .name("время").description("Системные часы.").defaultValue(false).build());
    private final Setting<Boolean> showBps = sg.add(new BoolSetting.Builder()
        .name("bps").description("Скорость в блоках/с.").defaultValue(true).build());
    private final Setting<Boolean> showMem = sg.add(new BoolSetting.Builder()
        .name("память").description("Использование RAM.").defaultValue(false).build());

    public WatermarkHud() {
        super(INFO);
        setSize(180, 22);
    }

    @Override
    public void render(HudRenderer renderer) {
        float s = scale();
        double fs = 0.58 * s;
        String brand = "MORZH";
        List<String> chips = new ArrayList<>();
        if (showName.get()) chips.add(mc.getSession() != null ? mc.getSession().getUsername() : "Player");
        if (showFps.get()) chips.add((isInEditor() ? 240 : MinecraftClientAccessor.getFps()) + " fps");
        if (showPing.get()) chips.add(ping() + " ms");
        if (showBps.get()) {
            double bps = isInEditor() ? 0 : (mc.player == null ? 0 : Utils.getPlayerSpeed().horizontalLength());
            chips.add(String.format(java.util.Locale.US, "%.1f b/s", bps));
        }
        if (showServer.get()) chips.add(server());
        if (showTime.get()) chips.add(LocalTime.now().format(TIME));
        if (showMem.get()) chips.add(mem());

        float pad = 7 * s;
        float gap = 8 * s;
        float h = 22 * s;
        float left = pad + (float) MorzhSmoothRenderer.textWidth(brand, fs) + pad;
        float right = chips.isEmpty() ? 0 : pad;
        for (int i = 0; i < chips.size(); i++) {
            right += (float) MorzhSmoothRenderer.textWidth(chips.get(i), fs);
            if (i < chips.size() - 1) right += gap;
        }
        if (!chips.isEmpty()) right += pad;
        float w = left + right;
        setSize(w, h);

        renderer.post(() -> {
            DrawContext context = HudRenderer.INSTANCE.drawContext;
            if (context == null) return;
            HudChrome.split(context, x, y, left, w, h, 4 * s);
            float ty = y + (h - (float) MorzhSmoothRenderer.textHeight(fs)) / 2f;
            MorzhSmoothRenderer.text(context, brand, x + pad, ty, 0xFFFFFFFF, true, fs);
            float cx = x + left + pad * 0.4f;
            for (int i = 0; i < chips.size(); i++) {
                MorzhSmoothRenderer.text(context, chips.get(i), cx, ty, HudChrome.TEXT, true, fs);
                cx += (float) MorzhSmoothRenderer.textWidth(chips.get(i), fs);
                if (i < chips.size() - 1) {
                    cx += gap / 2f - 1 * s;
                    MorzhSmoothRenderer.roundedRect(context, cx, y + 6 * s, 0.7f, h - 12 * s, 0.3f, HudChrome.OUTLINE);
                    cx += gap / 2f + 1 * s;
                }
            }
        });
    }

    private static int ping() {
        if (mc.player == null || mc.getNetworkHandler() == null) return 0;
        PlayerListEntry entry = mc.getNetworkHandler().getPlayerListEntry(mc.player.getUuid());
        return entry == null ? 0 : entry.getLatency();
    }

    private static String server() {
        if (mc.getCurrentServerEntry() != null) return mc.getCurrentServerEntry().address;
        return mc.isInSingleplayer() ? "Singleplayer" : "Server";
    }

    private static String mem() {
        long max = Runtime.getRuntime().maxMemory();
        long used = Runtime.getRuntime().totalMemory() - Runtime.getRuntime().freeMemory();
        return (used / 1024 / 1024) + "MB";
    }
}


