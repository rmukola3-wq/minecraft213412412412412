import net.minecraft.util.math.BlockPos;
import net.minecraft.util.math.Vec3d;

/** Expensive Speed HOLYWORLD: chase nearest player + collision boost. */
public class HolyWorld extends SpeedMode {
    private LivingEntity target;

    public HolyWorld() {
        super(SpeedModes.HolyWorld);
    }

    @Override
    public void onInput(PlayerInputEvent event) {
        target = pickTarget();
        if (target == null || mc.player == null) return;
        Vec3d delta = target.getPos().subtract(mc.player.getPos());
        if (delta.lengthSquared() < 1.0E-4) return;
        float yaw = mc.player.getYaw();
        double deg = Math.toDegrees(Math.atan2(-delta.x, delta.z)) - yaw;
        while (deg > 180) deg -= 360;
        while (deg < -180) deg += 360;
        boolean f = Math.abs(deg) < 67.5;
        boolean b = Math.abs(deg) > 112.5;
        boolean l = deg > 22.5 && deg < 157.5;
        boolean r = deg < -22.5 && deg > -157.5;
        event.setDirectional(f, b, l, r);
    }

    @Override
    public void onTick() {
        if (mc.player == null || mc.world == null) return;
        boolean near = false;
        for (LivingEntity e : mc.world.getNonSpectatingEntities(LivingEntity.class, mc.player.getBoundingBox().expand(0.2))) {
            if (e != mc.player) {
                near = true;
                break;
            }
        }
        if (!near) return;
        boolean blocked = BlockPos.stream(mc.player.getBoundingBox().expand(0.3, -0.001, 0.3)).anyMatch(pos ->
            !mc.world.getBlockState(pos).getCollisionShape(mc.world, pos).isEmpty()
        );
        if (blocked) return;
        double speed = settings.holyWorldSpeed.get() / 10.0;
        float yaw = mc.player.getYaw();
        double rad = Math.toRadians(yaw);
        mc.player.addVelocity(-Math.sin(rad) * speed, 0, Math.cos(rad) * speed);
    }

    @Override
    public void onMove(PlayerMoveEvent event) {
    }

    private LivingEntity pickTarget() {
        LivingEntity aura = CombatTargets.current();
        if (aura instanceof PlayerEntity p && Friends.get().shouldAttack(p)) return aura;
        LivingEntity best = null;
        double bestD = 8;
        for (PlayerEntity p : mc.world.getPlayers()) {
            if (p == mc.player || !Friends.get().shouldAttack(p)) continue;
            double d = mc.player.distanceTo(p);
            if (d < bestD) {
                bestD = d;
                best = p;
            }
        }
        return best;
    }
}


