        if (animations == null || !animations.chatEnabled() || visibleMessages.isEmpty()) return;
        ChatHudLine.Visible line = visibleMessages.getFirst();
        animations.chatLineAnims.computeIfAbsent(line, k -> new GuiAnimations.SlideAnim(-getWidth(), 0, animations.chatDuration.get()));
