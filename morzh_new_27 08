package meteordevelopment.meteorclient.gui.morzh;

import java.util.ArrayList;
import java.util.List;

/**
 * Base node of the click GUI component tree.
 *
 * Coordinates are stored relative to the parent and resolved by walking up the
 * chain, so moving a panel moves everything inside it without touching a single
 * child. The important part is {@link #layoutChildren(int)}: a child is always
 * placed directly after the <em>actual</em> height of the one before it
 * ({@link #layoutHeight()}), never after a fixed step, which is what keeps an
 * expanded component from overlapping whatever follows it.
 */
public abstract class MorzhComponent {
    /** Breathing room left under a component that is currently expanded. */
    public static final int EXPAND_PADDING = 5;

    protected final MorzhComponent parent;
    protected final List<MorzhComponent> children = new ArrayList<>();

    private final String name;

    private int x;
    private int y;
    private int width;
    private int height;

    protected MorzhComponent(
        MorzhComponent parent,
        String name,
        int x,
        int y,
        int width,
        int height
    ) {
        this.parent = parent;
        this.name = name;
        this.x = x;
        this.y = y;
        this.width = width;
        this.height = height;
    }

    // ------------------------------------------------------------ geometry

    public final int absoluteX() {
        int result = x;

        for (MorzhComponent node = parent; node != null; node = node.parent) {
            result += node.x;
        }

        return result;
    }

    public final int absoluteY() {
        int result = y;

        for (MorzhComponent node = parent; node != null; node = node.parent) {
            result += node.y;
        }

        return result;
    }

    public final String name() {
        return name;
    }

    public final int x() {
        return x;
    }

    public final int y() {
        return y;
    }

    public final int width() {
        return width;
    }

    public final int height() {
        return height;
    }

    public final void setX(int x) {
        this.x = x;
    }

    public final void setY(int y) {
        this.y = y;
    }

    public final void setWidth(int width) {
        this.width = width;
    }

    public final void setHeight(int height) {
        this.height = height;
    }

    public final List<MorzhComponent> children() {
        return children;
    }

    public boolean isVisible() {
        return true;
    }

    // -------------------------------------------------------------- layout

    /** Own body height plus whatever this component is currently expanded into. */
    public int expandedHeight() {
        return height;
    }

    /** Room this component claims in its parent's vertical flow. */
    public int layoutHeight() {
        return expandedHeight();
    }

    /**
     * Stacks the visible children starting at {@code startY} (relative to this
     * component) and returns the offset just past the last one.
     */
    protected final int layoutChildren(int startY) {
        int runningY = startY;

        for (MorzhComponent child : children) {
            if (!child.isVisible()) continue;

            child.setY(runningY);
            runningY += child.layoutHeight();
        }

        return runningY;
    }

    /** Combined flow height of every visible child. */
    protected final int childrenHeight() {
        int total = 0;

        for (MorzhComponent child : children) {
            if (child.isVisible()) total += child.layoutHeight();
        }

        return total;
    }

    public boolean isHovered(double mouseX, double mouseY) {
        int left = absoluteX();
        int top = absoluteY();

        return mouseX >= left
            && mouseX < left + width
            && mouseY >= top
            && mouseY < top + height;
    }

    // -------------------------------------------------------------- events

    public void tick(float delta) {
        for (MorzhComponent child : children) {
            if (child.isVisible()) child.tick(delta);
        }
    }

    public void render(MorzhGuiContext context) {
        for (MorzhComponent child : children) {
            if (child.isVisible()) child.render(context);
        }
    }

    public boolean mouseClicked(double mouseX, double mouseY, int button) {
        for (int i = children.size() - 1; i >= 0; i--) {
            MorzhComponent child = children.get(i);

            if (child.isVisible()
                && child.mouseClicked(mouseX, mouseY, button)) {
                return true;
            }
        }

        return false;
    }

    public boolean mouseDragged(double mouseX, double mouseY, int button) {
        for (MorzhComponent child : children) {
            if (child.isVisible()
                && child.mouseDragged(mouseX, mouseY, button)) {
                return true;
            }
        }

        return false;
    }

    public void mouseReleased(double mouseX, double mouseY, int button) {
        for (MorzhComponent child : children) {
            if (child.isVisible()) child.mouseReleased(mouseX, mouseY, button);
        }
    }

    public boolean keyPressed(int keyCode, int scanCode, int modifiers) {
        for (MorzhComponent child : children) {
            if (child.isVisible()
                && child.keyPressed(keyCode, scanCode, modifiers)) {
