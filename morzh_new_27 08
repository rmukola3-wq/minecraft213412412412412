        .description("Show your held items on the fake entity.")
        .defaultValue(false)
        .visible(() -> mode.get() == Mode.Entity)
        .build()
    );

    private NativeImageBackedTexture texture;
    private NativeImageBackedTexture morzhTexture;
    private Identifier loadedId;
    private Entity standIn;
    private MorzhEntityModel morzhModel;

    public CustomPlayerModel() {
        super(Categories.Render, "custom-player-model", "Replace Steve with a cuboid walrus, a vanilla mob, or a PNG skin.");
    }

    @Override
    public void onActivate() {
        if (mode.get() == Mode.Skin) {
            ensureFolder();
            loadTexture();
        } else if (mode.get() == Mode.Entity) {
            spawnStandIn();
        } else {
            morzhModel = new MorzhEntityModel();
            ensureMorzhTexture();
        }
    }

    @Override
    public void onDeactivate() {
        despawnStandIn();
        unloadTexture();
        unloadMorzhTexture();
    }

    @EventHandler
    private void onJoin(GameJoinedEvent event) {
        if (mode.get() == Mode.Entity) spawnStandIn();
    }

    @EventHandler
    private void onTick(TickEvent.Post event) {
        if (mode.get() != Mode.Entity || mc.player == null || mc.world == null) return;
        if (standIn == null || standIn.isRemoved() || standIn.getWorld() != mc.world) {
            spawnStandIn();
            return;
        }
        syncStandIn();
    }

    @Override
    public WWidget getWidget(GuiTheme theme) {
        WHorizontalList list = theme.horizontalList();
        list.add(theme.label("Bind"));
        list.add(theme.keybind(keybind)).expandX();
        WButton reload = list.add(theme.button("Reload PNG")).widget();
        reload.action = this::loadTexture;
        WButton folder = list.add(theme.button("Open folder")).widget();
        folder.action = () -> {
            ensureFolder();
            Util.getOperatingSystem().open(FOLDER);
        };
        return list;
    }

    public boolean isSkinMode() {
        return mode.get() == Mode.Skin;
    }

    public boolean shouldRenderMorzh(Entity entity) {
        return isActive() && mode.get() == Mode.Morzh && appliesTo(entity);
    }

    public boolean shouldHidePlayer(Entity entity) {
        if (!isActive() || !appliesTo(entity)) return false;
        if (mode.get() == Mode.Morzh) return true;
        return mode.get() == Mode.Entity && hideSelf.get() && entity == mc.player;
    }

    private boolean appliesTo(Entity entity) {
        if (!(entity instanceof PlayerEntity) || mc.player == null) return false;
        boolean self = entity == mc.player;
        return switch (who.get()) {
            case Self -> self;
            case Others -> !self;
            case Both -> true;
        };
    }

    public void renderMorzh(LivingEntity entity, double x, double y, double z, float tickDelta, MatrixStack matrices, VertexConsumerProvider consumers, int light) {
        ensureMorzhTexture();
        if (morzhModel == null) morzhModel = new MorzhEntityModel();
        matrices.push();
        MorzhEntityModel.applyEntityTransform(entity, tickDelta, x, y, z, matrices);
        morzhModel.render(entity, tickDelta, morzhScale.get().floatValue(), matrices, consumers, light, MORZH_TEXTURE_ID);
        matrices.pop();
    }

    public boolean isStandIn(Entity entity) {
        return standIn != null && entity == standIn;
    }

    public boolean shouldApply(AbstractClientPlayerEntity player) {
        if (!isSkinMode() || player == null || mc.player == null) return false;
        boolean self = player == mc.player;
        return switch (who.get()) {
            case Self -> self;
            case Others -> !self;
            case Both -> true;
        };
    }

    public Identifier getTexture() {
        return loadedId;
    }

    public float getScale() {
        return scale.get().floatValue();
    }

    public SkinTextures apply(SkinTextures original) {
        if (original == null) return null;

        Identifier tex = loadedId != null ? loadedId : original.texture();
        SkinTextures.Model model = switch (armModel.get()) {
            case Keep -> original.model();
            case Slim -> SkinTextures.Model.SLIM;
            case Wide -> SkinTextures.Model.WIDE;
        };

        return new SkinTextures(
            tex,
            original.textureUrl(),
            original.capeTexture(),
            original.elytraTexture(),
            model,
            original.secure()
        );
    }

    public void loadTexture() {
        ensureFolder();
        unloadTexture();

        File file = resolveFile(fileName.get());
        if (file == null || !file.isFile()) {
            if (mode.get() == Mode.Skin) error("Put a skin PNG in %s (now: %s).", FOLDER.getAbsolutePath(), fileName.get());
            return;
        }

        if (mc.getTextureManager() == null) return;

        try (FileInputStream in = new FileInputStream(file)) {
            NativeImage image = NativeImage.read(in);
            texture = new NativeImageBackedTexture(image);
            mc.getTextureManager().registerTexture(TEXTURE_ID, texture);
            loadedId = TEXTURE_ID;
            info("Loaded %s (%sx%s).", file.getName(), image.getWidth(), image.getHeight());
        } catch (IOException e) {
            error("Could not load %s: %s", file.getName(), e.getMessage());
        }
    }

    private void spawnStandIn() {
        despawnStandIn();
        if (mc.world == null || mc.player == null) return;

        standIn = createEntity(entityKind.get());
        if (standIn == null) return;

        standIn.setSilent(true);
        standIn.setInvulnerable(true);
        standIn.noClip = true;
        standIn.setNoGravity(true);
        standIn.setCustomNameVisible(false);
        syncStandIn();
        mc.world.addEntity(standIn);
    }

    private Entity createEntity(EntityKind kind) {
        return switch (kind) {
            case Skeleton -> new SkeletonEntity(EntityType.SKELETON, mc.world);
            case Zombie -> new ZombieEntity(mc.world);
            case Pig -> new PigEntity(EntityType.PIG, mc.world);
            case Allay -> new AllayEntity(EntityType.ALLAY, mc.world);
            case Warden -> new WardenEntity(EntityType.WARDEN, mc.world);
            case Piglin -> new PiglinEntity(EntityType.PIGLIN, mc.world);
            case Phantom -> new PhantomEntity(EntityType.PHANTOM, mc.world);
            case Vex -> new VexEntity(EntityType.VEX, mc.world);
            case Breeze -> new BreezeEntity(EntityType.BREEZE, mc.world);
            case Creeper -> new CreeperEntity(EntityType.CREEPER, mc.world);
            case Panda -> new PandaEntity(EntityType.PANDA, mc.world);
        };
    }

    private void syncStandIn() {
        if (standIn == null || mc.player == null) return;

        standIn.copyPositionAndRotation(mc.player);
        standIn.lastRenderX = mc.player.lastRenderX;
        standIn.lastRenderY = mc.player.lastRenderY;
        standIn.lastRenderZ = mc.player.lastRenderZ;
        standIn.prevX = mc.player.prevX;
        standIn.prevY = mc.player.prevY;
        standIn.prevZ = mc.player.prevZ;
        standIn.setYaw(mc.player.getYaw());
        standIn.setPitch(mc.player.getPitch());
        standIn.setHeadYaw(mc.player.headYaw);
        standIn.setBodyYaw(mc.player.bodyYaw);
        standIn.prevYaw = mc.player.prevYaw;
        standIn.prevPitch = mc.player.prevPitch;
        standIn.setPose(mc.player.getPose());
        standIn.setSneaking(mc.player.isSneaking());
        standIn.setSprinting(mc.player.isSprinting());
        standIn.setSwimming(mc.player.isSwimming());
        standIn.setOnFire(mc.player.isOnFire());

        if (standIn instanceof LivingEntity living) {
            living.headYaw = mc.player.headYaw;
            living.prevHeadYaw = mc.player.prevHeadYaw;
            living.bodyYaw = mc.player.bodyYaw;
            living.prevBodyYaw = mc.player.prevBodyYaw;
            living.handSwingProgress = mc.player.handSwingProgress;
            living.lastHandSwingProgress = mc.player.lastHandSwingProgress;
            living.handSwinging = mc.player.handSwinging;
            living.preferredHand = mc.player.preferredHand;
            living.limbAnimator.setSpeed(mc.player.limbAnimator.getSpeed());
            living.hurtTime = mc.player.hurtTime;
            living.maxHurtTime = mc.player.maxHurtTime;
            living.setPose(mc.player.getPose());

            if (copyHands.get()) {
                living.setStackInHand(Hand.MAIN_HAND, mc.player.getMainHandStack());
                living.setStackInHand(Hand.OFF_HAND, mc.player.getOffHandStack());
            } else {
                living.setStackInHand(Hand.MAIN_HAND, Items.AIR.getDefaultStack());
                living.setStackInHand(Hand.OFF_HAND, Items.AIR.getDefaultStack());
            }
        }
    }

    private void despawnStandIn() {
        if (standIn != null && mc.world != null) {
            mc.world.removeEntity(standIn.getId(), Entity.RemovalReason.DISCARDED);
        }
        standIn = null;
    }

    private void ensureMorzhTexture() {
        if (morzhTexture != null || mc.getTextureManager() == null) return;
        NativeImage image = new NativeImage(MorzhEntityModel.TEX, MorzhEntityModel.TEX, false);
        MorzhEntityModel.paintTexture(image);
        morzhTexture = new NativeImageBackedTexture(image);
        mc.getTextureManager().registerTexture(MORZH_TEXTURE_ID, morzhTexture);
    }

    private void unloadTexture() {
        if (loadedId != null && mc.getTextureManager() != null) {
            mc.getTextureManager().destroyTexture(loadedId);
        }
        if (texture != null) {
            texture.close();
            texture = null;
        }
        loadedId = null;
    }

    private void unloadMorzhTexture() {
        if (morzhTexture != null && mc.getTextureManager() != null) {
            mc.getTextureManager().destroyTexture(MORZH_TEXTURE_ID);
            morzhTexture.close();
            morzhTexture = null;
        }
    }

    private static void ensureFolder() {
        if (!FOLDER.exists()) FOLDER.mkdirs();
    }

    private static File resolveFile(String name) {
        if (name == null || name.isBlank()) return null;
        String safe = new File(name.trim()).getName();
        if (safe.isEmpty() || safe.contains("..")) return null;
        return new File(FOLDER, safe);
    }

    public enum Mode {
        Morzh,
        Entity,
        Skin
    }

    public enum EntityKind {
        Skeleton,
        Zombie,
        Pig,
        Allay,
        Warden,
        Piglin,
        Phantom,
        Vex,
        Breeze,
        Creeper,
        Panda
    }

    public enum Target {
        Self,
        Others,
        Both
    }

    public enum ArmModel {
        Keep,
        Slim,
        Wide
    }
}


