    private boolean isMoving() {
        return mc.player.input.playerInput.forward()
            || mc.player.input.playerInput.backward()
            || mc.player.input.playerInput.left()
            || mc.player.input.playerInput.right();
    }

    private boolean isMovingInInventory() {
        return mc.currentScreen instanceof InventoryScreen
            && (!pendingClicks.isEmpty() || isMoving() || mc.player.input.playerInput.jump());
    }

    private boolean canWalkInScreen() {
        if (mc.currentScreen == null) return false;
        if (profile.get() == Profile.Wild) return true;
        if (syntax() || rockstar() || grim()) {
            return mc.currentScreen instanceof InventoryScreen
                || mc.currentScreen instanceof WidgetScreen
                || mc.currentScreen instanceof CreativeInventoryScreen;
        }
        if (profile.get() == Profile.Rasty) {
            return mc.currentScreen instanceof WidgetScreen
                || mc.currentScreen instanceof InventoryScreen
                || (mc.player != null && mc.player.currentScreenHandler.slots.size() == 46);
        }
        if (mc.currentScreen instanceof GenericContainerScreen
            || mc.currentScreen instanceof ShulkerBoxScreen
            || mc.currentScreen instanceof FurnaceScreen
            || mc.currentScreen instanceof CraftingScreen
            || mc.currentScreen instanceof CreativeInventoryScreen) {
            return false;
        }
        return true;
    }

    private void set(KeyBinding bind, boolean pressed) {
        boolean wasPressed = bind.isPressed();
        bind.setPressed(pressed);

        InputUtil.Key key = ((KeyBindingAccessor) bind).getKey();
        if (wasPressed != pressed && key.getCategory() == InputUtil.Type.KEYSYM) {
            MeteorClient.EVENT_BUS.post(KeyEvent.get(key.getCode(), 0, pressed ? KeyAction.Press : KeyAction.Release));
        }
    }

    private void onSyntaxSend(PacketEvent.Send event) {
        if (mc.player == null || mc.player.networkHandler == null) {
            syntaxCleanup();
            return;
        }

        boolean moving = syntaxMoved || syntaxKeysDown();
        syntaxMoved |= moving && !syntaxDelayed.isEmpty();

        if (event.packet instanceof ClickSlotC2SPacket click
            && mc.currentScreen instanceof InventoryScreen
            && moving
            && mc.player.currentScreenHandler.slots.size() >= 27) {
            syntaxDelayed.add(click);
            event.cancel();
        } else if (event.packet instanceof CloseHandledScreenC2SPacket close
            && ((CloseHandledScreenC2SPacketAccessor) close).getSyncId() == 0
            && moving
            && !syntaxProcessing) {
            if (syntaxDelayed.isEmpty()) {
                event.cancel();
            } else {
                syntaxDelayed.add(close);
                event.cancel();
                syntaxProcessing = true;
                syntaxPhase = 0;
            }
        }

        if (syntaxProcessing && event.packet instanceof PlayerInputC2SPacket) {
            event.cancel();
            sendSilent(new PlayerInputC2SPacket(new PlayerInput(false, false, false, false, false, false, false)));
        }

        if (!syntaxDelayed.isEmpty() && syntaxProcessing) {
            Packet<?> p = event.packet;
            if (p instanceof HandSwingC2SPacket
                || p instanceof PlayerInteractEntityC2SPacket
                || p instanceof PlayerInteractItemC2SPacket
                || p instanceof PlayerInteractBlockC2SPacket) {
                event.cancel();
            }
        }
    }

    private void onSyntaxTick() {
        boolean inMoveGui = mc.currentScreen instanceof InventoryScreen
            || mc.currentScreen instanceof WidgetScreen
            || mc.currentScreen instanceof CreativeInventoryScreen;

        if (!syntaxProcessing && syntaxDelayed.isEmpty() && !inMoveGui) {
            syntaxMoved = false;
        }

        if (inMoveGui) {
            syntaxMoved |= syntaxKeysDown() && !syntaxDelayed.isEmpty();
        }

        if (syntaxPhase < 0) return;

        if (syntaxMode.get() == SyntaxMode.Bypass) {
            switch (syntaxPhase) {
                case 0 -> lockMovementKeys();
                case 1 -> {
                    for (Packet<?> p : syntaxDelayed) sendSilent(p);
                    syntaxDelayed.clear();
                    syntaxProcessing = false;
                    syntaxMoved = false;
                }
                case 2 -> {
                    unlockMovementKeys();
                    syntaxPhase = -1;
                    return;
                }
            }
            syntaxPhase++;
            return;
        }

        switch (syntaxPhase) {
            case 0 -> lockMovementKeys();
            case 1, 2, 4, 6 -> {
            }
            case 3 -> {
                for (Packet<?> p : syntaxDelayed) {
                    if (!(p instanceof CloseHandledScreenC2SPacket)) sendSilent(p);
                }
            }
            case 5 -> {
                for (Packet<?> p : syntaxDelayed) {
                    if (p instanceof CloseHandledScreenC2SPacket) sendSilent(p);
                }
                syntaxDelayed.clear();
            }
            case 7 -> {
                unlockMovementKeys();
                syntaxProcessing = false;
                syntaxMoved = false;
                syntaxPhase = -1;
                return;
            }
        }
        syntaxPhase++;
    }

    private void sendSilent(Packet<?> packet) {
        if (mc.player == null || mc.player.networkHandler == null) return;
        syntaxSilent = true;
        grimSilent = true;
        try {
            mc.player.networkHandler.sendPacket(packet);
        } finally {
            syntaxSilent = false;
            grimSilent = false;
        }
    }

    private boolean syntaxKeysDown() {
        if (mc.getWindow() == null || mc.options == null) return false;
        boolean inventory = mc.currentScreen instanceof InventoryScreen || mc.currentScreen instanceof CreativeInventoryScreen;
        for (KeyBinding binding : new KeyBinding[]{
            mc.options.forwardKey, mc.options.backKey, mc.options.rightKey, mc.options.leftKey,
            mc.options.jumpKey, mc.options.sneakKey, mc.options.sprintKey
        }) {
            if (inventory && (binding == mc.options.sneakKey
                || (binding == mc.options.sprintKey && mc.options.sprintKey != mc.options.forwardKey))) {
                continue;
            }
            InputUtil.Key key = ((KeyBindingAccessor) binding).getKey();
            if (key.getCategory() == InputUtil.Type.KEYSYM
                && InputUtil.isKeyPressed(mc.getWindow().getHandle(), key.getCode())) {
                return true;
            }
        }
        return false;
    }

    private void lockMovementKeys() {
        set(mc.options.forwardKey, false);
        set(mc.options.backKey, false);
        set(mc.options.leftKey, false);
        set(mc.options.rightKey, false);
        set(mc.options.jumpKey, false);
        set(mc.options.sneakKey, false);
        set(mc.options.sprintKey, false);
        if (mc.player != null && mc.player.input != null) {
            var in = mc.player.input.playerInput;
            mc.player.input.playerInput = new PlayerInput(false, false, false, false, false, in.sneak(), false);
        }
    }

    private void unlockMovementKeys() {
        set(mc.options.forwardKey, Input.isPressed(mc.options.forwardKey));
        set(mc.options.backKey, Input.isPressed(mc.options.backKey));
        set(mc.options.leftKey, Input.isPressed(mc.options.leftKey));
        set(mc.options.rightKey, Input.isPressed(mc.options.rightKey));
        if (jump.get()) set(mc.options.jumpKey, Input.isPressed(mc.options.jumpKey));
        if (sneak.get()) set(mc.options.sneakKey, Input.isPressed(mc.options.sneakKey));
        if (sprint.get()) set(mc.options.sprintKey, Input.isPressed(mc.options.sprintKey));
    }

    private void syntaxCleanup() {
        syntaxDelayed.clear();
        syntaxProcessing = false;
        syntaxSilent = false;
        syntaxMoved = false;
        syntaxPhase = -1;
    }

    private void onRockstarSend(PacketEvent.Send event) {
        if (mc.player == null || skip()) return;
        if (mc.currentScreen instanceof GenericContainerScreen container
            && container.getTitle().getString().toLowerCase().contains("выбор")) {
            return;
        }
        if (!(event.packet instanceof ClickSlotC2SPacket packet)) return;
        if (!canWalkInScreen() && !(mc.currentScreen instanceof InventoryScreen)) return;

        SlotActionType type = packet.getActionType();
        if (type == SlotActionType.PICKUP
            || type == SlotActionType.PICKUP_ALL
            || type == SlotActionType.CLONE
            || type == SlotActionType.QUICK_CRAFT) {
            rockstarPickup.add(packet);
            event.cancel();
            return;
        }

        if (rockstarBypass.get() == RockstarBypass.Slow) {
            rockstarPackets.add(packet);
            event.cancel();
            rockstarStay = true;
            rockstarStayAt = System.currentTimeMillis();
        } else {
            rockstarPackets.add(packet);
            event.cancel();
            if (mc.currentScreen instanceof GenericContainerScreen || type == SlotActionType.THROW) {
                rockstarStay = true;
                rockstarStayAt = System.currentTimeMillis();
            }
        }
    }

    private void onRockstarTick() {
        if (mc.player.currentScreenHandler != null) {
            rockstarScreenId = mc.player.currentScreenHandler.syncId;
        } else {
            rockstarScreenId = 0;
        }

        if (rockstarBypass.get() == RockstarBypass.SlowClose && mc.currentScreen == null && !rockstarPackets.isEmpty()) {
            rockstarStay = true;
        }

        if (rockstarStay && System.currentTimeMillis() - rockstarStayAt >= rockstarDelay.get()) {
            sendRockstarPackets();
            rockstarStay = false;
        }

        if (mc.player.currentScreenHandler != null
            && mc.player.currentScreenHandler.getCursorStack().isEmpty()
            && !rockstarPickup.isEmpty()
            && !rockstarSending
            && System.currentTimeMillis() - rockstarStayAt >= rockstarDelay.get()) {
            rockstarStay = true;
            sendRockstarPickup();
        }

        if (isMoving() || (mc.player.input != null && mc.player.input.playerInput.jump())) {
            rockstarStayAt = System.currentTimeMillis();
        }
    }

    private void sendRockstarPackets() {
        if (rockstarPackets.isEmpty() || mc.player == null || mc.player.networkHandler == null) return;
        rockstarSending = true;
        for (Packet<?> packet : rockstarPackets) {
            mc.player.networkHandler.sendPacket(packet);
        }
        rockstarPackets.clear();
        mc.player.networkHandler.sendPacket(new CloseHandledScreenC2SPacket(rockstarScreenId));
        rockstarSending = false;
    }

    private void sendRockstarPickup() {
        if (rockstarPickup.isEmpty() || mc.player == null || mc.player.networkHandler == null) return;
        rockstarSending = true;
        for (ClickSlotC2SPacket packet : rockstarPickup) {
            mc.player.networkHandler.sendPacket(packet);
        }
        rockstarPickup.clear();
        rockstarSending = false;
    }

    private void rockstarCleanup() {
        rockstarPackets.clear();
        rockstarPickup.clear();
        rockstarStay = false;
        rockstarSending = false;
    }

    public boolean skip() {
        if (mc.currentScreen instanceof meteordevelopment.meteorclient.gui.morzh.dropdown.DropDownScreen && !syntax() && !rockstar() && !grim()) return true;
        return mc.currentScreen == null
            || (mc.currentScreen instanceof CreativeInventoryScreen && CreativeInventoryScreenAccessor.getSelectedTab() == ItemGroups.getSearchGroup())
            || mc.currentScreen instanceof ChatScreen
            || mc.currentScreen instanceof SignEditScreen
            || mc.currentScreen instanceof AnvilScreen
            || mc.currentScreen instanceof AbstractCommandBlockScreen
            || mc.currentScreen instanceof StructureBlockScreen;
    }
}


