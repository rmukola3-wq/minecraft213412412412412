            tickCounter = 0;
        }
    }

    @EventHandler
    private void onPacket(PacketEvent.Receive event) {
        if (mc.player == null) return;

        if (screenReady) {
            if (event.packet instanceof InventoryS2CPacket inventoryPacket) {
                if (inventoryPacket.getContents().size() == 90 && tickCounter >= 40) {
                    int anarchy = (int) (Math.random() * 100.0 <= 50.0
                        ? 205 + (int) (Math.random() * (231 - 205 + 1))
                        : 305 + (int) (Math.random() * (325 - 305 + 1)));
                    mc.player.networkHandler.sendChatCommand("an" + anarchy);
                    ChatUtils.infoPrefix("AutoBuy", "Обнаружили замедление аукциона, переходим на " + anarchy + " анархию");
                    tickCounter = 0;
                    ahPending = true;
                }
            }
        }

        if (event.packet instanceof GameMessageS2CPacket messagePacket) {
            onBuyChat(messagePacket.content().getString());
        }
        if (event.packet instanceof OverlayMessageS2CPacket overlayPacket) {
            onBuyChat(overlayPacket.text().getString());
        }

        if (event.packet instanceof OpenScreenS2CPacket openScreenPacket) {
            if (!(mc.currentScreen instanceof GenericContainerScreen)) tickCounter = 0;
            refreshCooldown = Math.max(refreshCooldown, 4);
            refreshSync = -1;
            lastOpenSync = openScreenPacket.getSyncId();
            ignoreSlot = -1;
            needRefresh = false;
        }

        if (event.packet instanceof PlaySoundS2CPacket soundPacket) {
            if (soundPacket.getSound().value().id().getPath().equals("block.note_block.basedrum")) {
                event.cancel();
                if (refreshCooldown > 0) return;
                refreshSync = mc.player.currentScreenHandler.syncId;
            }
        }
    }

    private AutoBuyEntry matchOffer(ItemStack stack) {
        if (stack == null || stack.isEmpty()) return null;
        if (stack.contains(DataComponentTypes.CONTAINER) && !stack.get(DataComponentTypes.CONTAINER).stream().allMatch(ItemStack::isEmpty)) {
            return null;
        }
        for (AutoBuyEntry item : AutoBuyEntry.values()) {
            if (!item.l()) continue;
            if (!item.a(stack)) continue;
            int unit = FunTimeAh.unitPrice(stack);
            if (unit <= 0 || unit > item.k()) continue;
            long balance = FunTimeAh.balance();
            long total = (long) unit * Math.max(stack.getCount(), 1);
            if (balance > 0 && total > balance) continue;
            return item;
        }
        return null;
    }

    private boolean confirmLooksSafe(ScreenHandler handler) {
        if (pendingLimit > 0 && pendingUnit > pendingLimit) return false;
        for (int i = 0; i < Math.min(handler.slots.size(), 27); i++) {
            ItemStack stack = handler.getSlot(i).getStack();
            if (stack.isEmpty()) continue;
            if (matchOffer(stack) != null) return true;
            int unit = FunTimeAh.unitPrice(stack);
            if (unit > 0 && pendingLimit > 0 && unit <= pendingLimit) return true;
        }
        return pendingUnit > 0 && pendingLimit > 0 && pendingUnit <= pendingLimit;
    }

    private void click(ScreenHandler handler, int slot, SlotActionType action, boolean resetSlowdown) {
        if (mc.interactionManager != null) {
            mc.interactionManager.clickSlot(handler.syncId, slot, 0, action, mc.player);
        } else {
            mc.player.networkHandler.sendPacket(new ClickSlotC2SPacket(
                handler.syncId, handler.getRevision(), slot, 0, action, handler.getCursorStack().copy(), Int2ObjectMaps.emptyMap()
            ));
        }
        if (resetSlowdown) tickCounter = 0;
    }

    private boolean shouldReopenAh() {
        if (mc.currentScreen instanceof GenericContainerScreen) return false;
        if (mc.currentScreen instanceof WidgetScreen) return false;
        if (mc.currentScreen instanceof ChatScreen) return false;
        if (mc.currentScreen instanceof InventoryScreen) return false;
        return ahPending || mc.currentScreen == null;
    }

    private boolean isConfirmScreen() {
        if (!(mc.currentScreen instanceof GenericContainerScreen screen)) return false;
        String t = screen.getTitle().getString().replaceAll("§.", "").toLowerCase(Locale.ROOT);
        return t.contains("подтверждение покупки");
    }

    private void bounceToAh() {
        if (!screenReady) return;
        closeAhTicks = 0;
        clickedConfirm = false;
        ahPending = true;
        reopenWait = 5;
        bounceQueued = true;
        if (mc.isOnThread()) closeAhNow();
    }

    private void closeAhNow() {
        bounceQueued = false;
        if (mc.player != null && mc.currentScreen != null) {
            mc.player.closeHandledScreen();
        }
    }

    private void skipPending() {
        pendingBuys.pollFirst();
        pendingItem = null;
        pendingUnit = 0;
        pendingLimit = 0;
    }

    private void queuePending(ItemStack stack, int unit, long paid) {
        pendingBuys.addLast(new PendingBuy(stack.copy(), unit, Math.max(paid, 1)));
        while (pendingBuys.size() > 16) pendingBuys.removeFirst();
    }

    private void onBuyChat(String message) {
        if (buyFailed(message)) {
            skipPending();
            needRefresh = false;
            buyLockTicks = 0;
            bounceToAh();
            return;
        }
        if (!boughtSuccessfully(message)) return;

        long chatPaid = parsePrice(message);
        PendingBuy pending = pendingBuys.pollFirst();
        String name;
        int count;
        long paid;
        if (pending != null) {
            name = pending.stack.getName().getString();
            count = Math.max(pending.stack.getCount(), 1);
            paid = chatPaid > 0 ? chatPaid : pending.paid;
            bought.addFirst(pending.stack);
            pendingItem = null;
            pendingUnit = 0;
        } else if (pendingItem != null) {
            name = pendingItem.getName().getString();
            count = Math.max(pendingItem.getCount(), 1);
            paid = chatPaid > 0 ? chatPaid : (long) Math.max(pendingUnit, 1) * count;
            bought.addFirst(pendingItem.copy());
            pendingItem = null;
            pendingUnit = 0;
        } else {
            name = "Лот";
            count = 1;
            paid = chatPaid;
        }

        long now = System.currentTimeMillis();
        if (paid <= 0) return;
        if (paid == lastDealPaid && now - lastDealAt < 250L) return;
        lastDealPaid = paid;
        lastDealAt = now;

        int fee = ahFee.get();
        long sell = fee <= 0 ? paid : (long) Math.ceil(paid / (1.0 - fee / 100.0));
        int unit = (int) Math.max(1, paid / count);
        deals.addFirst(new Deal(name, count, unit, paid, sell));
        while (deals.size() > 64) deals.removeLast();
        ChatUtils.infoPrefix("AutoBuy", "В таблицу: " + Formatting.RED + name + Formatting.GRAY + " за "
            + Formatting.RED + formatMoney(paid) + Formatting.GRAY + " → окуп " + formatMoney(sell));
        ignoreSlot = -1;
        buyLockTicks = 0;
        bounceToAh();
    }

    private static long parsePrice(String message) {
        Matcher matcher = PRICE_IN_CHAT.matcher(message.replace('\u00A0', ' '));
        long best = 0;
        while (matcher.find()) {
            String digits = matcher.group(1).replaceAll("[^0-9]", "");
            if (digits.isEmpty() || digits.length() > 15) continue;
            try {
                long n = Long.parseLong(digits);
                if (n > best) best = n;
            } catch (NumberFormatException ignored) {
            }
        }
        return best;
    }

    private static boolean buyFailed(String message) {
        String t = message.toLowerCase(Locale.ROOT);
        return t.contains("недостаточно") || t.contains("не хватает") || t.contains("нехватает")
            || t.contains("нет денег") || t.contains("не можете купить") || t.contains("нельзя купить")
            || t.contains("лот уже") || t.contains("товар не актуален") || t.contains("уже купили")
            || t.contains("товар уже") || (t.contains("ошибка") && t.contains("купил"))
            || t.contains("нет места") || t.contains("инвентарь заполнен") || t.contains("нет свободн")
            || t.contains("кто-то опередил") || t.contains("предложение истекло");
    }

    private static boolean boughtSuccessfully(String message) {
        String t = message.toLowerCase(Locale.ROOT);
        return t.contains("успешно купили") || t.contains("успешно приобрели") || t.contains("вы купили")
            || t.contains("успешная покупка") || t.contains("вы приобрели");
    }

    private void recordDeal(ItemStack stack, int unit) {
        if (unit <= 0) return;
        int count = Math.max(stack.getCount(), 1);
        long paid = (long) unit * count;
        int fee = ahFee.get();
        long sell = fee <= 0 ? paid : (long) Math.ceil(paid / (1.0 - fee / 100.0));
        deals.addFirst(new Deal(stack.getName().getString(), count, unit, paid, sell));
        while (deals.size() > 64) deals.removeLast();
    }

    private boolean isMoving() {
        var in = mc.player.input.playerInput;
        return in.forward() || in.backward() || in.left() || in.right();
    }

    @Override
    public String getInfoString() {
        int n = 0;
        for (AutoBuyEntry e : AutoBuyEntry.values()) if (e.l()) n++;
        return n + (screenReady ? " ON" : " OFF");
    }

    public record Deal(String name, int count, int unitPaid, long paid, long sellToBreakEven) {
    }

    private record PendingBuy(ItemStack stack, int unit, long paid) {
    }
}


