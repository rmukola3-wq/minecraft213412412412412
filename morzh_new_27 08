        camPos = mc.gameRenderer.getCamera().getPos();
        Profile look = profile.get();

        mesh.depthTest = look == Profile.ThunderHack;
        mesh.additive = look != Profile.ThunderHack;
        mesh.begin();

        if (players.get()) {
            for (PlayerEntity player : mc.world.getPlayers()) {
