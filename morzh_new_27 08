    public CustomMultiplayerScreen(Screen parent) {
        super(Text.literal("Multiplayer"));
        this.parentScreen = parent;
        px = new float[PARTICLE_COUNT]; py = new float[PARTICLE_COUNT];
        pvx = new float[PARTICLE_COUNT]; pvy = new float[PARTICLE_COUNT];
        pbright = new float[PARTICLE_COUNT];
        for (int i = 0; i < BTN_COUNT; i++) { btnHover[i] = 0f; btnScale[i] = 1f; }
        Random rng = new Random();
        for (int i = 0; i < PARTICLE_COUNT; i++) {
            px[i] = rng.nextFloat() * 1920; py[i] = rng.nextFloat() * 1080;
            float angle = rng.nextFloat() * (float)(Math.PI * 2);
            float spd = (0.3f + rng.nextFloat() * 0.7f) * PARTICLE_SPEED;
            pvx[i] = (float) Math.cos(angle) * spd;
            pvy[i] = (float) Math.sin(angle) * spd;
            pbright[i] = 0.2f + rng.nextFloat() * 0.5f;
        }
    }

