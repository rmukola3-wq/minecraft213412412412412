import net.minecraft.entity.Entity;
import net.minecraft.util.Identifier;
import net.minecraft.util.math.MathHelper;
import net.minecraft.util.math.Vec3d;

import java.util.Iterator;
import java.util.concurrent.CopyOnWriteArrayList;

import static org.lwjgl.opengl.GL11.GL_ONE;
import static org.lwjgl.opengl.GL11.GL_ONE_MINUS_SRC_ALPHA;
import static org.lwjgl.opengl.GL11.GL_SRC_ALPHA;

public class HitBubble extends Module {
    private static final Identifier TEX = MeteorClient.identifier("textures/particles/bubble.png");

    private final SettingGroup sg = settings.getDefaultGroup();

    private final Setting<Double> size = sg.add(new DoubleSetting.Builder()
        .name("size")
        .defaultValue(0.55)
        .min(0.1)
        .sliderMax(2)
        .build()
    );

    private final Setting<Integer> lifetime = sg.add(new IntSetting.Builder()
        .name("lifetime")
        .description("How long a bubble lives, in milliseconds.")
        .defaultValue(650)
        .range(150, 2000)
        .sliderRange(150, 1500)
        .build()
    );

    private final Setting<SettingColor> color = sg.add(new ColorSetting.Builder()
        .name("color")
        .defaultValue(new SettingColor(180, 210, 255, 200))
        .build()
    );

    private final CopyOnWriteArrayList<Bubble> bubbles = new CopyOnWriteArrayList<>();
    private final TexturedMesh mesh = new TexturedMesh();

    public HitBubble() {
        super(Categories.Render, "hit-bubble", "Animated bubble at the hit point.");
    }

    @Override
    public void onDeactivate() {
        bubbles.clear();
    }

    @EventHandler
    private void onAttack(AttackEntityEvent event) {
        Entity target = event.entity;
        if (target == null || mc.player == null) return;
        Vec3d pos = target.getBoundingBox().getCenter();
        bubbles.add(new Bubble(pos.x, pos.y, pos.z, System.currentTimeMillis(), mc.player.getYaw()));
    }

    @EventHandler
    private void onRender(Render3DEvent event) {
        if (bubbles.isEmpty()) return;
        long now = System.currentTimeMillis();
        int life = lifetime.get();

        mesh.texture = TEX;
        mesh.additive = true;
        mesh.depthTest = false;
        mesh.begin();

        Iterator<Bubble> it = bubbles.iterator();
        while (it.hasNext()) {
            Bubble b = it.next();
            float t = (now - b.at) / (float) life;
            if (t >= 1) {
                bubbles.remove(b);
                continue;
            }
            float scale = size.get().floatValue() * (0.25f + t * 1.35f);
            int a = MathHelper.clamp((int) (color.get().a * (1 - t) * 0.9f), 0, 255);
            Color c = new Color(color.get().r, color.get().g, color.get().b, a);
            addBillboard(b.x, b.y, b.z, scale, c, b.yaw + t * 90);
        }

        mesh.render(event.matrices);
    }

    private void addBillboard(double x, double y, double z, double spriteSize, Color spriteColor, float extraYaw) {
