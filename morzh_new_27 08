package meteordevelopment.meteorclient.systems.hud.screens;

import meteordevelopment.meteorclient.gui.GuiTheme;
import meteordevelopment.meteorclient.gui.WidgetScreen;
import meteordevelopment.meteorclient.gui.morzh.MorzhSmoothRenderer;
import meteordevelopment.meteorclient.gui.morzh.dropdown.DropDownColors;
import meteordevelopment.meteorclient.systems.hud.Hud;
import meteordevelopment.meteorclient.systems.hud.HudElementInfo;
import meteordevelopment.meteorclient.utils.Utils;
import net.minecraft.client.gui.DrawContext;
import org.lwjgl.glfw.GLFW;

import java.util.ArrayList;
import java.util.Comparator;
import java.util.List;
import java.util.Locale;

import static meteordevelopment.meteorclient.MeteorClient.mc;

/** ThunderHack-style HUD element picker. */
public class AddHudElementScreen extends WidgetScreen {
    private static final float PANEL_W = 210f;
    private static final float ROW_H = 22f;
    private static final float HEADER_H = 28f;
    private static final float SEARCH_H = 22f;

    private final int placeX, placeY;
    private String query = "";
    private int hoverIndex = -1;
    private float panelX, panelY, panelH;
    private final List<HudElementInfo<?>> items = new ArrayList<>();

    public AddHudElementScreen(GuiTheme theme, int x, int y) {
        super(theme, "Add HUD Element");
        this.placeX = x;
        this.placeY = y;
        refresh();
    }

    @Override
    public void initWidgets() {}

    private void refresh() {
        items.clear();
        String q = query.toLowerCase(Locale.ROOT);
        for (HudElementInfo<?> info : Hud.get().infos.values()) {
            if (q.isEmpty() || info.title.toLowerCase(Locale.ROOT).contains(q) || info.name.contains(q)) {
                items.add(info);
            }
        }
        items.sort(Comparator.comparing(info -> info.title.toLowerCase(Locale.ROOT)));
    }

    @Override
    public void render(DrawContext context, int mouseX, int mouseY, float delta) {
        double s = mc.getWindow().getScaleFactor();
        int mx = (int) (mouseX * s);
        int my = (int) (mouseY * s);

        Utils.unscaledProjection();
        HudEditorScreen.renderElements(context);

        panelH = Math.min(HEADER_H + SEARCH_H + 12 + items.size() * (ROW_H + 3) + 14, Utils.getWindowHeight() - 40);
        panelX = (float) (Utils.getWindowWidth() / 2.0 - PANEL_W / 2.0);
        panelY = (float) (Utils.getWindowHeight() / 2.0 - panelH / 2.0);

        MorzhSmoothRenderer.roundedRect(context, panelX, panelY, PANEL_W, panelH, 8, DropDownColors.PANEL, DropDownColors.OUTLINE_LIGHT, 1f);
        MorzhSmoothRenderer.gradientRect(context, panelX + 1, panelY + 1, PANEL_W - 2, HEADER_H, DropDownColors.HEADER_GRAD_LEFT, DropDownColors.HEADER_GRAD_RIGHT);
        MorzhSmoothRenderer.text(context, "Add HUD Element", panelX + 12, panelY + 8, DropDownColors.WHITE, false);

        float searchX = panelX + 10;
        float searchY = panelY + HEADER_H + 6;
        float searchW = PANEL_W - 20;
        MorzhSmoothRenderer.roundedRect(context, searchX, searchY, searchW, SEARCH_H, 4, DropDownColors.rgba(0, 0, 0, 140), DropDownColors.OUTLINE_LIGHT, 0.6f);
        String searchText = query.isEmpty() ? "Search..." : query + (System.currentTimeMillis() / 400 % 2 == 0 ? "|" : "");
        int searchColor = query.isEmpty() ? DropDownColors.TEXT : DropDownColors.WHITE;
        MorzhSmoothRenderer.text(context, searchText, searchX + 7, searchY + 6, searchColor, false);

        hoverIndex = -1;
        float listY = searchY + SEARCH_H + 8;
        float listH = panelH - (listY - panelY) - 10;
        int index = 0;
        for (HudElementInfo<?> info : items) {
            float rowY = listY + index * (ROW_H + 3);
            if (rowY + ROW_H > listY + listH) break;

            boolean hovered = mx >= panelX + 10 && mx <= panelX + PANEL_W - 10 && my >= rowY && my <= rowY + ROW_H;
            if (hovered) hoverIndex = index;

            int fill = hovered ? DropDownColors.interpolate(DropDownColors.MODULE_INNER, DropDownColors.TOGGLE_ON, 0.35f) : DropDownColors.MODULE_FILL;
            MorzhSmoothRenderer.roundedRect(context, panelX + 10, rowY, PANEL_W - 20, ROW_H, 5, fill, DropDownColors.MODULE_BORDER_TL, 0.6f);
            MorzhSmoothRenderer.text(context, info.title, panelX + 18, rowY + 6, DropDownColors.WHITE, false);

            float plusX = panelX + PANEL_W - 34;
            MorzhSmoothRenderer.roundedRect(context, plusX, rowY + 3, 16, 16, 3, DropDownColors.rgba(20, 40, 28, 220));
            MorzhSmoothRenderer.text(context, "+", plusX + 4, rowY + 5, DropDownColors.rgb(80, 220, 120), false);

            index++;
        }

        Utils.scaledProjection();
    }

    @Override
    public boolean mouseClicked(double mouseX, double mouseY, int button) {
        double s = mc.getWindow().getScaleFactor();
        int mx = (int) (mouseX * s);
        int my = (int) (mouseY * s);

        if (button == GLFW.GLFW_MOUSE_BUTTON_LEFT && hoverIndex >= 0 && hoverIndex < items.size()) {
            Hud.get().add(items.get(hoverIndex), placeX, placeY);
            close();
            return true;
        }

        if (button == GLFW.GLFW_MOUSE_BUTTON_LEFT) {
            boolean inside = mx >= panelX && mx <= panelX + PANEL_W && my >= panelY && my <= panelY + panelH;
            if (!inside) {
                close();
                return true;
            }
        }

        return true;
    }

    @Override
    public boolean keyPressed(int keyCode, int scanCode, int modifiers) {
        if (keyCode == GLFW.GLFW_KEY_ESCAPE) {
            close();
            return true;
        }
        if (keyCode == GLFW.GLFW_KEY_BACKSPACE && !query.isEmpty()) {
            query = query.substring(0, query.length() - 1);
            refresh();
            return true;
        }
        if (keyCode == GLFW.GLFW_KEY_ENTER && !items.isEmpty()) {
            Hud.get().add(items.get(0), placeX, placeY);
            close();
            return true;
        }
        return super.keyPressed(keyCode, scanCode, modifiers);
    }

    @Override
    public boolean charTyped(char chr, int modifiers) {
        if (chr >= 32 && chr != 127) {
            query += chr;
            refresh();
            return true;
        }
        return super.charTyped(chr, modifiers);
    }

    @Override
    public void close() {
        mc.setScreen(parent);
    }

    @Override
    public boolean shouldPause() {
        return false;
    }
}


