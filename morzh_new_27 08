    private void renderFaceTexture(DrawContext context, float absX, float absY, float fw, float fh, float faceRadius) {
        LivingEntity entity = currentTarget;
        if (entity == null) return;

        int drawX = Math.round(absX);
        int drawY = Math.round(absY);
        int drawSize = Math.max(1, Math.round(Math.min(fw, fh)));

        context.getMatrices().push();
        context.getMatrices().translate(0, 0, 401);

        if (entity instanceof AbstractClientPlayerEntity player) {
            PlayerSkinDrawer.draw(context, player.getSkinTextures(), drawX, drawY, drawSize);
        }
        else {
            Identifier texture = getFaceTexture(entity);
            if (texture != null) {
                float hurt = entity.hurtTime > 0 ? entity.hurtTime / 10f : 0f;
                int tint = 0xFF000000 | ((int) (255 * (1f - hurt)) << 16) | ((int) (255 * (1f - hurt)) << 8) | 255;

                context.drawTexture(RenderLayer::getGuiTextured, texture, drawX, drawY, drawSize, drawSize,
                    8, 8, 8, 8, 64, 64, tint);

                float hatSize = drawSize * 1.1f;
                float hatOff = (hatSize - drawSize) / 2f;
                context.drawTexture(RenderLayer::getGuiTextured, texture,
                    Math.round(absX - hatOff), Math.round(absY - hatOff), Math.round(hatSize), Math.round(hatSize),
                    40, 8, 8, 8, 64, 64, tint);
            }
        }

        context.getMatrices().pop();

        if (hitFlash.get() && hitFlashAmount > 0) {
            Color flash = hitFlashColor.get().copy();
            flash.a(Math.round(flash.a * hitFlashAmount));
            MorzhSmoothRenderer.roundedRect(context, absX, absY, fw, fh, faceRadius, flash.getPacked());
        }
    }

