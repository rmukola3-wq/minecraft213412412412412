import meteordevelopment.meteorclient.systems.modules.Modules;
import net.minecraft.client.gui.screen.Screen;
import net.minecraft.client.gui.screen.ingame.HandledScreen;

/**
 * Removes vanilla dark overlay / blur behind ClickGUI, inventory, chests.
 * Settings apply even if this module is off — default is on.
 */
public class NoGuiDim extends Module {
    private final SettingGroup sg = settings.getDefaultGroup();

    private final Setting<Boolean> remove = sg.add(new BoolSetting.Builder()
        .name("убрать-затемнение")
        .description("ClickGUI, инвентарь, сундуки, пауза — без тёмной плёнки и ванильного blur.")
        .defaultValue(true)
        .build()
    );

    public NoGuiDim() {
        super(Categories.Render, "no-gui-dim", "Убирает затемнение позади GUI (ClickGUI, инвентарь, сундуки).");
        runInMainMenu = true;
    }

    public static boolean skip() {
        Modules modules = Modules.get();
        if (modules == null) return true;
        NoGuiDim module = modules.get(NoGuiDim.class);
        return module == null || module.remove.get();
    }

    public static boolean skip(Screen screen) {
        if (!skip()) return false;
        return screen != null;
    }

    public static boolean skipInventory(Screen screen) {
        return skip() && screen instanceof HandledScreen<?>;
    }
}


