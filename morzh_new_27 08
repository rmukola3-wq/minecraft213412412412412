package meteordevelopment.meteorclient.gui.morzh;

import meteordevelopment.meteorclient.gui.themes.morzh.MorzhGuiColors;
import meteordevelopment.meteorclient.settings.EnumSetting;
import meteordevelopment.meteorclient.settings.Setting;
import meteordevelopment.meteorclient.utils.sound.MorzhSoundManager;

/** Left click steps forward through the values, right click steps back. */
public class MorzhEnumSettingComponent extends MorzhSettingComponent {
    public MorzhEnumSettingComponent(
        MorzhComponent parent,
        EnumSetting<?> setting,
        int x,
        int y,
        int width
    ) {
        super(parent, setting, x, y, width, ROW_HEIGHT);
    }

    @Override
    public void render(MorzhGuiContext context) {
        float top = absoluteY();

        String value = MorzhSmoothRenderer.fitText(
            String.valueOf(setting.get()),
            width() / 2f
        );

        double valueWidth = MorzhSmoothRenderer.textWidth(value);

        drawLabel(context, top, valueWidth + 4);

        boolean hovered = isHovered(context.mouseX, context.mouseY)
            && MorzhScissor.contains(context.mouseX, context.mouseY);

        MorzhSmoothRenderer.text(
            context.draw,
            value,
            absoluteX() + width() - PADDING - valueWidth,
            textY(top, ROW_HEIGHT),
            context.fade(
                MorzhGuiColors.packed(
                    hovered ? MorzhGuiColors.TEXT_ENABLED : MorzhGuiColors.TEXT
                )
            ),
            false
        );

        offerTooltip(context);
    }

    @Override
    public boolean mouseClicked(double mouseX, double mouseY, int button) {
        if (!isHovered(mouseX, mouseY)) return false;
        if (button != 0 && button != 1) return false;

        cycle(button == 1);
        MorzhSoundManager.playBoolean();

        return true;
    }

    @SuppressWarnings({"rawtypes", "unchecked"})
    private void cycle(boolean backwards) {
        Enum current = (Enum) setting.get();

        if (current == null) return;

        Object[] values = current.getDeclaringClass().getEnumConstants();

        if (values == null || values.length == 0) return;

        int index = current.ordinal() + (backwards ? -1 : 1);

        if (index < 0) index = values.length - 1;
        if (index >= values.length) index = 0;

        ((Setting) setting).set(values[index]);
    }
}


