import net.minecraft.item.Items;

import java.util.ArrayList;
import java.util.List;
import java.util.Locale;
import java.util.Set;

import static meteordevelopment.meteorclient.utils.Utils.getWindowHeight;
import static meteordevelopment.meteorclient.utils.Utils.getWindowWidth;

public class ModulesScreen extends TabScreen {
    private WCategoryController controller;

    private WVerticalList morzhModuleList;
    private WTextBox morzhSearch;
    private Category morzhSelectedCategory;

    public ModulesScreen(GuiTheme theme) {
        super(theme, Tabs.get().getFirst());
    }

    @Override
    public void initWidgets() {
        if (theme instanceof MorzhGuiTheme) {
            initMorzhDashboard();
            return;
        }

        controller = add(new WCategoryController()).widget();

        WVerticalList help = add(theme.verticalList()).pad(4).bottom().widget();
        help.add(theme.label("Left click - Toggle module"));
        help.add(theme.label("Right click - Open module settings"));
    }

    @Override
    protected void init() {
        super.init();

        if (controller != null) {
            controller.refresh();
        }
    }

    // Morzh dashboard

    private void initMorzhDashboard() {
        WWindow dashboard = theme.window("MORZH CLIENT");
        dashboard.id = "morzh-dashboard";
        dashboard.padding = 6;
        dashboard.spacing = 5;

        add(dashboard).center();

        dashboard.view.scrollOnlyWhenMouseOver = true;
        dashboard.view.hasScrollBar = true;
        dashboard.view.maxHeight = Math.max(
            theme.scale(120),
            getWindowHeight() - theme.scale(50)
        );

        dashboard.add(theme.label("MORZH CLIENT  |  Combat & Utility Dashboard", true))
            .expandX();

        dashboard.add(theme.horizontalSeparator("Module Manager"))
            .expandX();

        WHorizontalList searchRow = dashboard.add(theme.horizontalList())
            .expandX()
            .widget();

        searchRow.add(theme.label("Search:"));

        morzhSearch = searchRow.add(theme.textBox(""))
            .minWidth(220)
            .expandCellX()
            .expandX()
            .widget();

        WButton clearSearch = searchRow.add(theme.button("Clear")).widget();

        WHorizontalList body = dashboard.add(theme.horizontalList())
            .expandX()
            .widget();

        WVerticalList sidebar = body.add(theme.verticalList())
            .minWidth(105)
            .widget();

        morzhModuleList = body.add(theme.verticalList())
            .minWidth(270)
            .expandCellX()
            .expandX()
            .widget();

        sidebar.add(theme.horizontalSeparator("Categories")).expandX();

        WButton allButton = sidebar.add(theme.button("All Modules"))
            .expandX()
            .widget();

        allButton.action = () -> {
            morzhSelectedCategory = null;
            morzhSearch.set("");
            showMorzhAllModules();
        };

        WButton favoritesButton = sidebar.add(theme.button("Favorites"))
            .expandX()
            .widget();

        favoritesButton.action = () -> {
            morzhSelectedCategory = null;
            morzhSearch.set("");
            showMorzhFavorites();
        };

        Category firstCategory = null;

        for (Category category : Modules.loopCategories()) {
            if (!hasVisibleModules(category)) continue;

            if (firstCategory == null) {
                firstCategory = category;
            }

            WButton categoryButton = sidebar.add(theme.button(category.name))
                .expandX()
                .widget();

            categoryButton.tooltip = "Show " + category.name + " modules";
            categoryButton.action = () -> {
                morzhSelectedCategory = category;
                morzhSearch.set("");
                showMorzhCategory(category);
            };
        }

        morzhSearch.action = () -> {
            String query = morzhSearch.get().trim();

            if (query.isEmpty()) {
                if (morzhSelectedCategory != null) {
                    showMorzhCategory(morzhSelectedCategory);
                } else {
                    showMorzhAllModules();
                }
            } else {
                showMorzhSearch(query);
            }
        };

        clearSearch.action = () -> {
            morzhSearch.set("");

            if (morzhSelectedCategory != null) {
                showMorzhCategory(morzhSelectedCategory);
            } else {
                showMorzhAllModules();
            }
        };

        dashboard.add(theme.horizontalSeparator("Controls")).expandX();

        WHorizontalList help = dashboard.add(theme.horizontalList())
            .expandX()
            .widget();

        help.add(theme.label("Left click: toggle"));
        help.add(theme.label("Right click: settings"));

        if (firstCategory != null) {
            morzhSelectedCategory = firstCategory;
            showMorzhCategory(firstCategory);
        } else {
            showMorzhAllModules();
        }
    }

    private boolean hasVisibleModules(Category category) {
        for (Module module : Modules.get().getGroup(category)) {
            if (!Config.get().hiddenModules.get().contains(module)) {
                return true;
            }
        }

        return false;
    }

    private void showMorzhCategory(Category category) {
        morzhModuleList.clear();

        morzhModuleList.add(theme.horizontalSeparator(category.name))
            .expandX();

        int count = 0;

        for (Module module : Modules.get().getGroup(category)) {
            if (Config.get().hiddenModules.get().contains(module)) continue;

            morzhModuleList.add(theme.module(module)).expandX();
            count++;
        }

        if (count == 0) {
            morzhModuleList.add(theme.label("No modules in this category."));
        }
    }

    private void showMorzhAllModules() {
        morzhModuleList.clear();

        morzhModuleList.add(theme.horizontalSeparator("All Modules"))
            .expandX();

        int count = 0;

        for (Category category : Modules.loopCategories()) {
            for (Module module : Modules.get().getGroup(category)) {
                if (Config.get().hiddenModules.get().contains(module)) continue;

                morzhModuleList.add(theme.module(module)).expandX();
                count++;
            }
        }

        if (count == 0) {
            morzhModuleList.add(theme.label("No modules found."));
        }
    }

    private void showMorzhFavorites() {
        morzhModuleList.clear();

        morzhModuleList.add(theme.horizontalSeparator("Favorites"))
            .expandX();

        List<Module> favorites = new ArrayList<>();

        for (Module module : Modules.get().getAll()) {
            if (module.favorite
                && !Config.get().hiddenModules.get().contains(module)) {
                favorites.add(module);
            }
        }

        favorites.sort((a, b) ->
            String.CASE_INSENSITIVE_ORDER.compare(a.name, b.name)
        );

        for (Module module : favorites) {
            morzhModuleList.add(theme.module(module)).expandX();
        }

        if (favorites.isEmpty()) {
            morzhModuleList.add(theme.label(
                "No favorites. Open module settings to add one."
            ));
        }
    }

    private void showMorzhSearch(String text) {
        morzhModuleList.clear();

        String query = text.toLowerCase(Locale.ROOT);

        morzhModuleList.add(theme.horizontalSeparator(
            "Search: " + text
        )).expandX();

        List<Module> found = new ArrayList<>();

        for (Module module : Modules.get().getAll()) {
            if (Config.get().hiddenModules.get().contains(module)) continue;

            boolean matchesName =
                module.name.toLowerCase(Locale.ROOT).contains(query);

            boolean matchesTitle =
                module.title.toLowerCase(Locale.ROOT).contains(query);

            boolean matchesDescription =
                module.description != null
                    && module.description.toLowerCase(Locale.ROOT)
                    .contains(query);

            boolean matchesSetting = false;

            for (SettingGroupView group : getSettingGroups(module)) {
                for (String settingName : group.names) {
                    if (settingName.toLowerCase(Locale.ROOT).contains(query)) {
                        matchesSetting = true;
                        break;
                    }
                }

                if (matchesSetting) break;
            }

            if (matchesName
                || matchesTitle
                || matchesDescription
                || matchesSetting) {
                found.add(module);
            }
        }

        found.sort((a, b) ->
            String.CASE_INSENSITIVE_ORDER.compare(a.name, b.name)
        );

        int limit = Config.get().moduleSearchCount.get();
        int displayed = 0;

        for (Module module : found) {
            if (displayed >= limit) break;

            morzhModuleList.add(theme.module(module)).expandX();
            displayed++;
        }

        if (found.isEmpty()) {
            morzhModuleList.add(theme.label("Nothing found."));
        } else if (found.size() > displayed) {
            morzhModuleList.add(theme.label(
                "Showing " + displayed + " of " + found.size()
            ));
        }
    }

    private List<SettingGroupView> getSettingGroups(Module module) {
        List<SettingGroupView> result = new ArrayList<>();

        module.settings.forEach(group -> {
            SettingGroupView view = new SettingGroupView();

            for (Setting<?> setting : group) {
                view.names.add(setting.name);
            }

            result.add(view);
        });

        return result;
    }

    private static class SettingGroupView {
        private final List<String> names = new ArrayList<>();
    }

    // Standard Meteor category windows

    protected WWindow createCategory(
        WContainer container,
        Category category,
        List<Module> moduleList
    ) {
        WWindow window = theme.window(category.name);
        window.id = category.name;
        window.padding = 0;
        window.spacing = 0;

        if (theme.categoryIcons()) {
            window.beforeHeaderInit = c ->
                c.add(theme.item(category.icon)).pad(2);
        }

        container.add(window);

        window.view.scrollOnlyWhenMouseOver = true;
        window.view.hasScrollBar = false;
        window.view.spacing = 0;

        for (Module module : moduleList) {
            window.add(theme.module(module)).expandX();
        }

        return window;
    }

    // Standard Meteor search

    protected void createSearchW(WContainer container, String text) {
        if (text.isEmpty()) return;

        Set<Module> modules = Modules.get().searchTitles(text);

        if (!modules.isEmpty()) {
            WSection section = container.add(theme.section("Modules"))
                .expandX()
                .widget();

            section.spacing = 0;

            int count = 0;

            for (Module module : modules) {
                if (count >= Config.get().moduleSearchCount.get()
                    || count >= modules.size()) {
                    break;
                }

                section.add(theme.module(module)).expandX();
                count++;
            }
        }

        modules = Modules.get().searchSettingTitles(text);

        if (!modules.isEmpty()) {
            WSection section = container.add(theme.section("Settings"))
                .expandX()
                .widget();

            section.spacing = 0;

            int count = 0;

            for (Module module : modules) {
                if (count >= Config.get().moduleSearchCount.get()
                    || count >= modules.size()) {
                    break;
                }

                section.add(theme.module(module)).expandX();
                count++;
            }
        }
    }

    protected WWindow createSearch(WContainer container) {
        WWindow window = theme.window("Search");
        window.id = "search";

        if (theme.categoryIcons()) {
            window.beforeHeaderInit = c ->
                c.add(theme.item(Items.COMPASS.getDefaultStack())).pad(2);
        }

        container.add(window);

        window.view.scrollOnlyWhenMouseOver = true;
        window.view.hasScrollBar = false;
        window.view.maxHeight -= 20;

        WVerticalList list = theme.verticalList();

        WTextBox textBox = window.add(theme.textBox(""))
            .minWidth(140)
            .expandX()
            .widget();

        textBox.setFocused(true);

        textBox.action = () -> {
            list.clear();
            createSearchW(list, textBox.get());
        };

        window.add(list).expandX();
        createSearchW(list, textBox.get());

        return window;
    }

    // Standard Meteor favorites

    protected Cell<WWindow> createFavorites(WContainer container) {
        boolean hasFavorites = Modules.get().getAll().stream()
            .anyMatch(module -> module.favorite);

        if (!hasFavorites) return null;

        WWindow window = theme.window("Favorites");
        window.id = "favorites";
        window.padding = 0;
        window.spacing = 0;

        if (theme.categoryIcons()) {
            window.beforeHeaderInit = c ->
                c.add(theme.item(Items.NETHER_STAR.getDefaultStack())).pad(2);
        }

        Cell<WWindow> cell = container.add(window);

        window.view.scrollOnlyWhenMouseOver = true;
        window.view.hasScrollBar = false;
        window.view.spacing = 0;

        createFavoritesW(window);

        return cell;
    }

    protected boolean createFavoritesW(WWindow window) {
        List<Module> modules = new ArrayList<>();

        for (Module module : Modules.get().getAll()) {
            if (module.favorite) {
                modules.add(module);
            }
        }

        modules.sort((a, b) ->
            String.CASE_INSENSITIVE_ORDER.compare(a.name, b.name)
        );

        for (Module module : modules) {
            window.add(theme.module(module)).expandX();
        }

        return !modules.isEmpty();
    }

    @Override
    public boolean toClipboard() {
        return NbtUtils.toClipboard(Modules.get());
    }

    @Override
    public boolean fromClipboard() {
        return NbtUtils.fromClipboard(Modules.get());
    }

    @Override
    public void reload() {
    }

    // Standard Meteor controller

    protected class WCategoryController extends WContainer {
        public final List<WWindow> windows = new ArrayList<>();
        private Cell<WWindow> favorites;

        @Override
        public void init() {
            List<Module> moduleList = new ArrayList<>();

            for (Category category : Modules.loopCategories()) {
                for (Module module : Modules.get().getGroup(category)) {
                    if (!Config.get().hiddenModules.get().contains(module)) {
                        moduleList.add(module);
                    }
                }

                if (!moduleList.isEmpty()) {
                    windows.add(createCategory(
                        this,
                        category,
                        moduleList
                    ));

                    moduleList.clear();
                }
            }

            windows.add(createSearch(this));
            refresh();
        }

        protected void refresh() {
            if (favorites == null) {
                favorites = createFavorites(this);

                if (favorites != null) {
                    windows.add(favorites.widget());
                }
            } else {
                favorites.widget().clear();

                if (!createFavoritesW(favorites.widget())) {
                    remove(favorites);
                    windows.remove(favorites.widget());
                    favorites = null;
                }
            }
        }

        @Override
        protected void onCalculateWidgetPositions() {
            double pad = theme.scale(4);
            double rowHeight = theme.scale(40);

            double x = this.x + pad;
            double y = this.y;

            for (Cell<?> cell : cells) {
                double windowWidth = getWindowWidth();
                double windowHeight = getWindowHeight();

                if (x + cell.width > windowWidth) {
                    x += pad;
                    y += rowHeight;
                }

                if (x > windowWidth) {
                    x = windowWidth / 2.0 - cell.width / 2.0;
                    if (x < 0) x = 0;
                }

                if (y > windowHeight) {
                    y = windowHeight / 2.0 - cell.height / 2.0;
                    if (y < 0) y = 0;
                }

                cell.x = x;
                cell.y = y;
                cell.width = cell.widget().width;
                cell.height = cell.widget().height;

                cell.alignWidget();

                x += cell.width + pad;
            }
        }
    }
}


