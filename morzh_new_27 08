import static org.lwjgl.opengl.GL11.GL_ONE_MINUS_SRC_ALPHA;
import static org.lwjgl.opengl.GL11.GL_SRC_ALPHA;

public class HitParticles extends Module {
    private static final Identifier TEX_STAR = MeteorClient.identifier("textures/particles/star.png");
    private static final Identifier TEX_HEART = MeteorClient.identifier("textures/particles/heart.png");
    private static final Identifier TEX_FIREFLY = MeteorClient.identifier("textures/particles/firefly.png");
    private static final Identifier TEX_BUBBLE = MeteorClient.identifier("textures/particles/bubble.png");

    private final SettingGroup sg = settings.getDefaultGroup();

    private final Setting<Boolean> onHit = sg.add(new BoolSetting.Builder()
        .name("on-hit")
        .defaultValue(true)
        .build()
    );

    private final Setting<Boolean> onCrit = sg.add(new BoolSetting.Builder()
        .name("on-crit")
        .defaultValue(true)
        .build()
    );

    private final Setting<Boolean> onTotem = sg.add(new BoolSetting.Builder()
        .name("on-totem")
        .defaultValue(true)
        .build()
    );

    private final Setting<Sprite> sprite = sg.add(new EnumSetting.Builder<Sprite>()
        .name("sprite")
        .defaultValue(Sprite.Star)
        .build()
    );

    private final Setting<Integer> count = sg.add(new IntSetting.Builder()
        .name("count")
        .defaultValue(10)
        .range(2, 40)
        .sliderRange(2, 24)
        .build()
    );

    private final Setting<Double> size = sg.add(new DoubleSetting.Builder()
        .name("size")
        .defaultValue(0.28)
        .min(0.05)
        .sliderMax(1)
        .build()
    );

    private final Setting<SettingColor> color = sg.add(new ColorSetting.Builder()
        .name("color")
        .defaultValue(new SettingColor(255, 90, 180, 220))
        .build()
    );

    private final List<Spark> sparks = new ArrayList<>();
    private final TexturedMesh mesh = new TexturedMesh();

    public HitParticles() {
        super(Categories.Render, "hit-particles", "Sprites on hit, crit and totem pop — not world dust.");
    }

    @Override
    public void onDeactivate() {
        sparks.clear();
    }

    @EventHandler
    private void onAttack(AttackEntityEvent event) {
        if (mc.player == null || event.entity == null) return;
        boolean crit = mc.player.fallDistance > 0 && !mc.player.isOnGround() && !mc.player.isClimbing() && !mc.player.isTouchingWater();
        if (onHit.get()) spawn(event.entity, count.get(), 0.18);
        if (onCrit.get() && crit) spawn(event.entity, count.get() + 6, 0.32);
    }

    @EventHandler
    private void onPacket(PacketEvent.Receive event) {
        if (!onTotem.get() || mc.world == null) return;
        if (!(event.packet instanceof EntityStatusS2CPacket packet) || packet.getStatus() != 35) return;
        Entity entity = packet.getEntity(mc.world);
        if (entity != null) spawn(entity, count.get() * 3, 0.45);
    }

    @EventHandler
    private void onTick(TickEvent.Post event) {
        sparks.removeIf(Spark::tick);
    }

    @EventHandler
    private void onRender(Render3DEvent event) {
        if (sparks.isEmpty()) return;
        mesh.texture = sprite.get().texture();
        mesh.additive = true;
        mesh.depthTest = true;
        mesh.begin();
        for (Spark spark : sparks) spark.render(event.tickDelta);
        mesh.render(event.matrices);
    }

    private void spawn(Entity entity, int n, double speed) {
        Vec3d base = entity.getBoundingBox().getCenter();
        ThreadLocalRandom rng = ThreadLocalRandom.current();
        for (int i = 0; i < n; i++) {
            sparks.add(new Spark(
                base.x + rng.nextDouble(-0.3, 0.3),
                base.y + rng.nextDouble(-0.2, 0.4),
                base.z + rng.nextDouble(-0.3, 0.3),
                rng.nextDouble(-speed, speed),
                rng.nextDouble(0.02, speed),
                rng.nextDouble(-speed, speed)
            ));
        }
    }

    private void addBillboard(double x, double y, double z, double spriteSize, Color spriteColor) {
        if (spriteColor.a <= 0) return;
        float yaw = (float) Math.toRadians(mc.gameRenderer.getCamera().getYaw());
        float pitch = (float) Math.toRadians(mc.gameRenderer.getCamera().getPitch());
        double sinYaw = Math.sin(yaw);
        double cosYaw = Math.cos(yaw);
        double sinPitch = Math.sin(pitch);
        double cosPitch = Math.cos(pitch);
        Vec3d right = new Vec3d(cosYaw, 0, sinYaw);
        Vec3d up = new Vec3d(-sinYaw * sinPitch, cosPitch, cosYaw * sinPitch);
        Vec3d h = right.multiply(spriteSize);
        Vec3d v = up.multiply(spriteSize);
        Vec3d c = new Vec3d(x, y, z);
        int i1 = mesh.vec3(c.subtract(h).add(v).x, c.subtract(h).add(v).y, c.subtract(h).add(v).z).vec2(0, 0).color(spriteColor).next();
        int i2 = mesh.vec3(c.subtract(h).subtract(v).x, c.subtract(h).subtract(v).y, c.subtract(h).subtract(v).z).vec2(0, 1).color(spriteColor).next();
        int i3 = mesh.vec3(c.add(h).subtract(v).x, c.add(h).subtract(v).y, c.add(h).subtract(v).z).vec2(1, 1).color(spriteColor).next();
        int i4 = mesh.vec3(c.add(h).add(v).x, c.add(h).add(v).y, c.add(h).add(v).z).vec2(1, 0).color(spriteColor).next();
        mesh.quad(i1, i2, i3, i4);
    }

    private class Spark {
        double px, py, pz, x, y, z, mx, my, mz;
        int age, maxAge;

        Spark(double x, double y, double z, double mx, double my, double mz) {
            this.x = this.px = x;
            this.y = this.py = y;
            this.z = this.pz = z;
            this.mx = mx;
            this.my = my;
            this.mz = mz;
            maxAge = age = ThreadLocalRandom.current().nextInt(12, 22);
        }

        boolean tick() {
            age--;
            if (age < 0) return true;
            px = x;
            py = y;
            pz = z;
            x += mx;
            y += my;
            z += mz;
            mx *= 0.88;
            my *= 0.92;
            mz *= 0.88;
            my -= 0.01;
            return false;
        }

        void render(float tickDelta) {
            double ix = MathHelper.lerp(tickDelta, px, x);
            double iy = MathHelper.lerp(tickDelta, py, y);
            double iz = MathHelper.lerp(tickDelta, pz, z);
            int a = MathHelper.clamp((int) (color.get().a * (age / (float) maxAge)), 0, 255);
            addBillboard(ix, iy, iz, size.get() * (0.6 + age / (float) maxAge), new Color(color.get().r, color.get().g, color.get().b, a));
        }
    }

    public enum Sprite {
        Star,
        Heart,
        Bloom,
        Bubble;

        Identifier texture() {
            return switch (this) {
                case Heart -> TEX_HEART;
                case Bloom -> TEX_FIREFLY;
                case Bubble -> TEX_BUBBLE;
                case Star -> TEX_STAR;
            };
        }
    }

    private static class TexturedMesh extends ShaderMesh {
        Identifier texture;
        boolean additive;

        private TexturedMesh() {
            super(Shaders.POS_TEX_COLOR, DrawMode.Triangles, Mesh.Attrib.Vec3, Mesh.Attrib.Vec2, Mesh.Attrib.Color);
        }

        @Override
        protected void beforeRender() {
            super.beforeRender();
            GL.bindTexture(texture);
            if (additive) GlStateManager._blendFunc(GL_SRC_ALPHA, GL_ONE);
            else GlStateManager._blendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
        }
    }
}


