/** Expensive {@code HitBoxesModule}: XZ/Y expand via box, not only targeting margin. */
public class Hitboxes extends Module {
    private final SettingGroup sgGeneral = settings.getDefaultGroup();

    private final Setting<Double> xzExpand = sgGeneral.add(new DoubleSetting.Builder()
        .name("xz-expand")
        .defaultValue(0.2)
        .min(0)
        .sliderMax(3)
        .build()
    );

    private final Setting<Double> yExpand = sgGeneral.add(new DoubleSetting.Builder()
        .name("y-expand")
        .defaultValue(0.0)
        .min(0)
        .sliderMax(3)
        .build()
    );

    private final Setting<Boolean> players = sgGeneral.add(new BoolSetting.Builder()
        .name("игроки")
        .defaultValue(true)
        .build()
    );

    private final Setting<Boolean> mobs = sgGeneral.add(new BoolSetting.Builder()
        .name("мобы")
        .defaultValue(false)
        .build()
    );

    private final Setting<Boolean> animals = sgGeneral.add(new BoolSetting.Builder()
        .name("животные")
        .defaultValue(false)
        .build()
    );

    private final Setting<Boolean> ignoreFriends = sgGeneral.add(new BoolSetting.Builder()
        .name("ignore-friends")
        .defaultValue(true)
        .build()
    );

    private final Setting<Boolean> onlyOnWeapon = sgGeneral.add(new BoolSetting.Builder()
        .name("only-on-weapon")
        .defaultValue(false)
        .build()
    );

    public Hitboxes() {
        super(Categories.Combat, "hitboxes", "Expands an entity's hitboxes for aiming only, not physics/camera.");
    }

    public double getEntityValue(Entity entity) {
        if (!shouldExpand(entity)) return 0;
        return xzExpand.get() / 2.0;
    }

    public Box modifyBox(Entity entity, Box box) {
        if (!shouldExpand(entity)) return box;
        float xz = xzExpand.get().floatValue() / 2.0f;
        float y = yExpand.get().floatValue() / 2.0f;
        if (xz == 0 && y == 0) return box;
        return new Box(
            box.minX - xz, box.minY - y, box.minZ - xz,
            box.maxX + xz, box.maxY + y, box.maxZ + xz
        );
    }

    private boolean shouldExpand(Entity entity) {
        if (!isActive() || !testWeapon() || entity == null || entity == mc.player) return false;
        if (ignoreFriends.get() && entity instanceof PlayerEntity player && Friends.get().isFriend(player)) return false;
        if (players.get() && entity instanceof PlayerEntity) return true;
        if (mobs.get() && entity instanceof HostileEntity) return true;
        return animals.get() && entity instanceof AnimalEntity;
    }

    private boolean testWeapon() {
        if (!onlyOnWeapon.get()) return true;
        return InvUtils.testInHands(itemStack -> itemStack.getItem() instanceof SwordItem || itemStack.getItem() instanceof AxeItem);
    }
}


