package meteordevelopment.meteorclient.gui.rasty.compat;

import net.minecraft.util.Util;

public final class Clicks {
    private static long lastTime;
    private static double lastX;
    private static double lastY;

    private Clicks() {}

    public static Click of(double x, double y, int button) {
        long now = Util.getMeasuringTimeMs();
        boolean doubled = button == 0
            && now - lastTime < 250
            && Math.abs(x - lastX) < 5
            && Math.abs(y - lastY) < 5;
