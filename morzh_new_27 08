package meteordevelopment.meteorclient.systems.modules.combat;

import meteordevelopment.meteorclient.events.packets.PacketEvent;
import meteordevelopment.meteorclient.events.world.TickEvent;
import meteordevelopment.meteorclient.settings.*;
import meteordevelopment.meteorclient.systems.modules.Categories;
import meteordevelopment.meteorclient.systems.modules.Module;
import meteordevelopment.meteorclient.utils.player.InvUtils;
import meteordevelopment.meteorclient.utils.player.SlotUtils;
import meteordevelopment.orbit.EventHandler;
import meteordevelopment.orbit.EventPriority;
import net.minecraft.entity.Entity;
import net.minecraft.entity.EquipmentSlot;
import net.minecraft.entity.decoration.EndCrystalEntity;
import net.minecraft.entity.vehicle.TntMinecartEntity;
import net.minecraft.item.ItemStack;
import net.minecraft.item.Items;
import net.minecraft.network.packet.s2c.play.EntityStatusS2CPacket;
import net.minecraft.screen.PlayerScreenHandler;
import net.minecraft.screen.slot.SlotActionType;

/**
 * Fast: SWAP with offhand, instant swap-back (UZBEk slot, not item search).
 * Legit: health-only, small delay, hysteresis (Delta).
 * Delta: 400ms moves, hysteresis, optional smart-eat.
 */
public class AutoTotem extends Module {
    private final SettingGroup sgGeneral = settings.getDefaultGroup();
    private final SettingGroup sgSafety = settings.createGroup("Safety");

    private final Setting<Profile> profile = sgGeneral.add(new EnumSetting.Builder<Profile>()
        .name("профиль")
        .description("Fast — мгновенный возврат. Legit — только HP и задержка. Delta — 400мс и гистерезис.")
        .defaultValue(Profile.Fast)
        .build()
    );

    private final Setting<Priority> priority = sgGeneral.add(new EnumSetting.Builder<Priority>()
        .name("приоритет")
        .description("Какие тотемы брать в первую очередь.")
        .defaultValue(Priority.Unenchanted)
        .build()
    );

    private final Setting<Double> health = sgGeneral.add(new DoubleSetting.Builder()
        .name("здоровье")
        .description("Берёт тотем, если HP + абсорбция ниже этого значения.")
        .defaultValue(6)
        .min(1)
        .sliderMax(20)
        .build()
    );

    private final Setting<Double> elytraHealth = sgGeneral.add(new DoubleSetting.Builder()
        .name("здоровье-с-элитрой")
        .description("Порог здоровья, пока надета элитра.")
        .defaultValue(10)
        .min(1)
        .sliderMax(20)
        .build()
    );

    private final Setting<Boolean> swapBack = sgGeneral.add(new BoolSetting.Builder()
        .name("возвращать-предмет")
        .description("Возвращает предыдущий предмет в левую руку тем же слотом (SWAP).")
        .defaultValue(true)
        .build()
    );

    private final Setting<Boolean> pauseOnEat = sgGeneral.add(new BoolSetting.Builder()
        .name("не-менять-если-ешь")
        .description("Не трогает оффхенд, пока ешь, если тотем ещё не нужен.")
        .defaultValue(false)
        .build()
    );

    private final Setting<Integer> popCooldown = sgGeneral.add(new IntSetting.Builder()
        .name("задержка-после-сноса")
        .description("Задержка только на взятие нового тотема после попа. Возврат предмета не ждёт.")
        .defaultValue(0)
        .min(0)
        .sliderMax(5000)
        .build()
    );

    private final Setting<Boolean> onCrystal = sgSafety.add(new BoolSetting.Builder()
        .name("кристаллы")
        .description("Берёт тотем рядом с эндер-кристаллом.")
        .defaultValue(true)
        .visible(() -> profile.get() != Profile.Legit)
        .build()
    );

    private final Setting<Double> crystalRange = sgSafety.add(new DoubleSetting.Builder()
        .name("дистанция-кристалла")
        .defaultValue(6)
        .min(1)
        .sliderMax(16)
        .visible(() -> profile.get() != Profile.Legit && onCrystal.get())
        .build()
    );

    private final Setting<Boolean> onMinecart = sgSafety.add(new BoolSetting.Builder()
        .name("вагонетка-тнт")
        .defaultValue(true)
        .visible(() -> profile.get() != Profile.Legit)
        .build()
    );

    private final Setting<Double> minecartRange = sgSafety.add(new DoubleSetting.Builder()
        .name("дистанция-вагонетки")
        .defaultValue(6)
        .min(1)
        .sliderMax(16)
        .visible(() -> profile.get() != Profile.Legit && onMinecart.get())
        .build()
    );

    private final Setting<Boolean> onFall = sgSafety.add(new BoolSetting.Builder()
        .name("падение")
        .defaultValue(true)
        .build()
    );

    private final Setting<Double> fallDistance = sgSafety.add(new DoubleSetting.Builder()
        .name("высота-падения")
        .defaultValue(6)
        .min(3)
        .sliderMax(40)
        .visible(onFall::get)
        .build()
    );

    private final Setting<Boolean> onMace = sgSafety.add(new BoolSetting.Builder()
        .name("булава")
        .description("Тотем если рядом игрок с булавой выше тебя.")
        .defaultValue(true)
        .visible(() -> profile.get() != Profile.Legit)
        .build()
    );

    private final Setting<Boolean> onTrident = sgSafety.add(new BoolSetting.Builder()
        .name("трезубец")
        .defaultValue(true)
        .visible(() -> profile.get() != Profile.Legit)
        .build()
    );

    public boolean locked;

    private int totems;
    private int previousSlot = -1;
    private long lastPopAt;
    private long lastSwapAt;
    private Boolean holdSticky;

    public AutoTotem() {
        super(Categories.Combat, "auto-totem", "Ставит тотем в левую руку по здоровью и угрозам.");
    }

    @Override
    public void onActivate() {
        locked = false;
        previousSlot = -1;
        lastPopAt = 0;
        lastSwapAt = 0;
        holdSticky = null;
    }

    @EventHandler(priority = EventPriority.HIGHEST)
    private void onTick(TickEvent.Pre event) {
        if (mc.player == null || mc.world == null || mc.interactionManager == null) return;
        if (!(mc.player.currentScreenHandler instanceof PlayerScreenHandler)) return;

        totems = countTotems();

        boolean shouldHold = shouldHoldTotem();
        if (pauseOnEat.get() && mc.player.isUsingItem() && !shouldHold) return;

        locked = shouldHold && totems > 0;

        ItemStack offhand = mc.player.getOffHandStack();
        boolean offhandTotem = offhand.isOf(Items.TOTEM_OF_UNDYING);

        if (shouldHold) {
            if (offhandTotem) return;
            if (System.currentTimeMillis() - lastPopAt < popCooldown.get()) return;
            if (!canSwapNow()) return;

            int slot = findTotemSlot();
            if (slot == -1) return;

            if (swapBack.get() && previousSlot == -1 && !offhand.isEmpty() && !offhandTotem) {
                previousSlot = slot;
            }

            swapWithOffhand(slot);
            return;
        }

        if (swapBack.get() && previousSlot != -1 && (offhand.isEmpty() || offhandTotem)) {
            if (!canSwapNow() && profile.get() != Profile.Fast) return;
            swapWithOffhand(previousSlot);
            previousSlot = -1;
        }

        locked = false;
    }

    @EventHandler(priority = EventPriority.HIGH)
    private void onReceivePacket(PacketEvent.Receive event) {
        if (!(event.packet instanceof EntityStatusS2CPacket packet)) return;
        if (packet.getStatus() != 35) return;

        Entity entity = packet.getEntity(mc.world);
        if (entity == null || entity != mc.player) return;

        lastPopAt = System.currentTimeMillis();
        locked = true;
    }

    public boolean isLocked() {
        return isActive() && locked;
    }

    @Override
    public String getInfoString() {
        return String.valueOf(totems);
    }

    private boolean canSwapNow() {
        long delay = switch (profile.get()) {
            case Fast -> 0L;
            case Legit -> 150L;
            case Delta -> 400L;
        };
        return System.currentTimeMillis() - lastSwapAt >= delay;
    }

    private boolean shouldHoldTotem() {
        float hp = mc.player.getHealth() + mc.player.getAbsorptionAmount();
        boolean elytra = mc.player.getEquippedStack(EquipmentSlot.CHEST).getItem() == Items.ELYTRA;
        double required = elytra ? elytraHealth.get() : health.get();
        double release = required + releaseMargin();

        boolean danger = hp <= required || checkCrystal() || checkMinecart() || checkFall() || checkMace() || checkTrident();
        boolean safe = hp >= release && !checkCrystal() && !checkMinecart() && !checkFall() && !checkMace() && !checkTrident();

        if (profile.get() == Profile.Delta || profile.get() == Profile.Legit) {
            if (holdSticky == null) holdSticky = danger;
            else if (danger) holdSticky = true;
            else if (safe) holdSticky = false;
            return holdSticky;
        }

        return danger;
    }

    private double releaseMargin() {
        return switch (profile.get()) {
            case Fast -> 0.5;
            case Legit -> 2.0;
            case Delta -> 0.5;
        };
    }

    private boolean checkCrystal() {
        if (profile.get() == Profile.Legit || !onCrystal.get()) return false;

        double range = crystalRange.get();
        for (Entity entity : mc.world.getEntities()) {
            if (entity instanceof EndCrystalEntity && mc.player.distanceTo(entity) <= range) {
                return true;
            }
        }

        return false;
    }

    private boolean checkMinecart() {
        if (profile.get() == Profile.Legit || !onMinecart.get()) return false;

        double range = minecartRange.get();
        for (Entity entity : mc.world.getEntities()) {
            if (entity instanceof TntMinecartEntity && mc.player.distanceTo(entity) <= range) {
                return true;
            }
        }

        return false;
    }

    private boolean checkFall() {
        if (!onFall.get()) return false;
        if (mc.player.isGliding()) return false;
        return mc.player.fallDistance >= fallDistance.get();
    }

    private boolean checkMace() {
        if (profile.get() == Profile.Legit || !onMace.get()) return false;
        for (Entity entity : mc.world.getEntities()) {
            if (!(entity instanceof net.minecraft.entity.player.PlayerEntity player) || player == mc.player) continue;
            if (!(player.getMainHandStack().getItem() instanceof net.minecraft.item.MaceItem)) continue;
            if (player.getY() > mc.player.getY() + 1.0 && mc.player.distanceTo(player) <= 8) return true;
        }
        return false;
    }

    private boolean checkTrident() {
        if (profile.get() == Profile.Legit || !onTrident.get()) return false;
        for (Entity entity : mc.world.getEntities()) {
            if (!(entity instanceof net.minecraft.entity.player.PlayerEntity player) || player == mc.player) continue;
            if (player.getMainHandStack().isOf(Items.TRIDENT) && mc.player.distanceTo(player) <= 8) return true;
        }
        return false;
    }

    private int findTotemSlot() {
        int preferred = -1;
        int fallback = -1;

        for (int i = 0; i < 36; i++) {
            ItemStack stack = mc.player.getInventory().getStack(i);
            if (stack.getItem() != Items.TOTEM_OF_UNDYING) continue;

            boolean enchanted = stack.hasEnchantments();

            switch (priority.get()) {
                case Any -> {
                    return i;
                }
                case Unenchanted -> {
                    if (!enchanted && preferred == -1) preferred = i;
                    else if (enchanted && fallback == -1) fallback = i;
                }
                case Enchanted -> {
                    if (enchanted && preferred == -1) preferred = i;
                    else if (!enchanted && fallback == -1) fallback = i;
                }
            }
        }

        return preferred != -1 ? preferred : fallback;
    }

    private int countTotems() {
        int count = 0;

        if (mc.player.getOffHandStack().getItem() == Items.TOTEM_OF_UNDYING) count++;

        for (int i = 0; i < 36; i++) {
            if (mc.player.getInventory().getStack(i).getItem() == Items.TOTEM_OF_UNDYING) count++;
        }

        return count;
    }

    private void swapWithOffhand(int invIndex) {
        int id = SlotUtils.indexToId(invIndex);
        if (id == -1) return;
        mc.interactionManager.clickSlot(
            mc.player.currentScreenHandler.syncId,
            id,
            40,
            SlotActionType.SWAP,
            mc.player
        );
        lastSwapAt = System.currentTimeMillis();
    }

    public enum Profile {
        Fast("Fast"),
        Legit("Legit"),
        Delta("Delta");

        private final String title;

        Profile(String title) {
            this.title = title;
        }

        @Override
        public String toString() {
            return title;
        }
    }

    public enum Priority {
        Any("Любые"),
        Unenchanted("Не зачарованные"),
        Enchanted("Зачарованные");

        private final String title;

        Priority(String title) {
            this.title = title;
        }

        @Override
        public String toString() {
            return title;
        }
    }
}


