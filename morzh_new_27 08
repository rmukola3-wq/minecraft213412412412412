    private void drawScaledText(DrawContext context, String text, float x, float y, float scale, int color, boolean shadow, boolean centered, boolean rightAlign) {
        double fs = 0.62 * Math.max(0.75f, scale);
        double drawX = x;
        if (centered) drawX = x - MorzhSmoothRenderer.textWidth(text, fs) / 2.0;
        else if (rightAlign) drawX = x - MorzhSmoothRenderer.textWidth(text, fs);
        MorzhSmoothRenderer.text(context, text, drawX, y, fa(color), shadow, fs);
