import java.util.List;

public class DropDownStringListComponent extends DropDownComponent implements DropDownBindTracker {
    private final StringListSetting setting;
    private boolean typing;
    private String buffer = "";

    public DropDownStringListComponent(StringListSetting setting) {
        this.setting = setting;
        setHeight(22);
    }

    @Override
    public boolean isBinding() {
        return typing;
    }

    @Override
    public void measure(float width) {
        super.measure(width);
        setHeight(22 + chipWrapHeight(width));
    }

    private float chipWrapHeight(float width) {
        List<String> chips = new ArrayList<>(setting.get());
        chips.add("+");
        float offset = 0;
        float heightOff = 0;
        for (String text : chips) {
            float off = DropDownDraw.textWidth(text, 5.5f) + 2;
            if (offset + off >= width - 10) {
                offset = 0;
                heightOff += 8;
            }
            offset += off;
        }
        return heightOff;
    }

    @Override
    public void render(DrawContext context, float mouseX, float mouseY) {
        DropDownDraw.text(context, setting.title, getX() + 5, getY() + 2, DropDownColors.MODE_LABEL, 5.5f);

        List<String> chips = new ArrayList<>(setting.get());
        if (typing) chips.add(buffer.isEmpty() ? "_" : buffer + (System.currentTimeMillis() % 1000 > 500 ? "_" : ""));
        else chips.add("+");

        float offset = 0;
        float heightOff = 0;
        boolean wrapped = false;

        for (String text : chips) {
            float off = DropDownDraw.textWidth(text, 5.5f) + 2;
            if (offset + off >= getWidth() - 10) {
                offset = 0;
                heightOff += 8;
                wrapped = true;
            }
            offset += off;
        }

        float boxW = wrapped ? getWidth() - 15 : offset;
        float boxH = 10 + heightOff;
        DropDownDraw.rounded(context, getX() + 5, getY() + 9, boxW + 5, boxH, 2, DropDownColors.CHIP_BG);

        offset = 0;
        heightOff = 0;
        boolean anyHovered = false;
        int i = 0;
        for (String text : chips) {
            float tw = DropDownDraw.textWidth(text, 5.5f);
            float off = tw + 2;
            if (offset + off >= getWidth() - 10) {
                offset = 0;
                heightOff += 8;
            }
            float tx = getX() + 8 + offset;
            float ty = getY() + 11.5f + heightOff;
            boolean last = i == chips.size() - 1;
            int color = last ? DropDownColors.MODE_IDLE : DropDownColors.MODE_SELECTED;
            DropDownDraw.text(context, text, tx, ty, color, 5.5f);
            if (DropDownDraw.hovered(mouseX, mouseY, tx, ty, tw, DropDownDraw.textHeight(5.5f) + 1)) anyHovered = true;
            offset += off;
            i++;
        }

        if (isHovered(mouseX, mouseY) && anyHovered) {
            if (typing) DropDownDraw.cursorIbeam();
            else DropDownDraw.cursorHand();
        }
    }

    @Override
    public void mouseClick(float mouseX, float mouseY, int button) {
        List<String> values = setting.get();
        float offset = 0;
        float heightOff = 0;

        for (int i = 0; i < values.size(); i++) {
            String text = values.get(i);
            float tw = DropDownDraw.textWidth(text, 5.5f);
            float off = tw + 2;
            if (offset + off >= getWidth() - 10) {
                offset = 0;
                heightOff += 8;
            }
            if (DropDownDraw.hovered(mouseX, mouseY, getX() + 8 + offset, getY() + 11.5f + heightOff, tw, DropDownDraw.textHeight(5.5f) + 1)) {
                values.remove(i);
                setting.set(values);
                setting.onChanged();
                typing = false;
                return;
            }
            offset += off;
        }

        if (isHovered(mouseX, mouseY)) {
            typing = true;
            buffer = "";
        } else {
            commit();
        }
    }

    @Override
    public void charTyped(char codePoint, int modifiers) {
        if (!typing || codePoint < 32) return;
        if (setting.filter != null && !setting.filter.filter(buffer, codePoint)) return;
        buffer += codePoint;
    }

    @Override
    public void keyPressed(int key, int scanCode, int modifiers) {
        if (!typing) return;
        if (key == GLFW.GLFW_KEY_BACKSPACE && !buffer.isEmpty()) {
            buffer = buffer.substring(0, buffer.length() - 1);
            return;
        }
        if (key == GLFW.GLFW_KEY_ENTER) {
            commit();
            typing = true;
            return;
        }
        if (key == GLFW.GLFW_KEY_ESCAPE) {
            typing = false;
            buffer = "";
        }
        if (Screen.isPaste(key)) {
            String clip = net.minecraft.client.MinecraftClient.getInstance().keyboard.getClipboard();
            if (clip != null) buffer += clip;
        }
    }

    private void commit() {
        if (typing && !buffer.isBlank()) {
            List<String> values = new ArrayList<>(setting.get());
            values.add(buffer);
            setting.set(values);
            setting.onChanged();
        }
        buffer = "";
        typing = false;
    }

    @Override
    public boolean isVisible() {
        return setting.isVisible();
    }
}


