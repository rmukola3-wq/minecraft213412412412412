    public static int sampleBlockLight(BlockPos pos) {
        Modules modules = Modules.get();
        if (modules == null) return 0;
        WorldLighting lighting = modules.get(WorldLighting.class);
        return lighting == null ? 0 : lighting.extraBlockLight(pos);
    }

    public static int sampleEntityLight(BlockPos pos) {
        return sampleBlockLight(pos);
    }

    public int extraBlockLight(BlockPos pos) {
        if (!isActive() || pos == null) return 0;
        int extra = 0;
        if (dynamicLight.get() && mc.player != null) {
            extra = Math.max(extra, falloff(mc.player.getBlockPos(), pos, playerRadius.get(), playerIntensity.get()));
        }
        if (targetGlow.get()) {
            LivingEntity target = targetEntity();
            if (target != null) {
                extra = Math.max(extra, falloff(target.getBlockPos(), pos, targetRadius.get(), targetIntensity.get()));
            }
        }
        return extra;
    }

    private static int falloff(BlockPos from, BlockPos to, int range, int peak) {
        double dx = from.getX() + 0.5 - (to.getX() + 0.5);
        double dy = from.getY() + 0.5 - (to.getY() + 0.5);
        double dz = from.getZ() + 0.5 - (to.getZ() + 0.5);
        double dist = Math.sqrt(dx * dx + dy * dy + dz * dz);
        if (dist >= range) return 0;
        float t = 1f - (float) (dist / range);
        return Math.max(0, Math.round(peak * t * t));
    }

    private LivingEntity targetEntity() {
        TargetESP esp = Modules.get().get(TargetESP.class);
        return esp == null ? null : esp.lightTarget();
    }

    @Override
    public void onActivate() {
        relight();
    }

    @Override
    public void onDeactivate() {
        dirtyAround(lastPlayerLight, Math.max(playerRadius.get(), lastPlayerRange));
        dirtyAround(lastTargetLight, Math.max(targetRadius.get(), lastTargetRange));
        lastPlayerLight = null;
        lastTargetLight = null;
        lastPlayerPeak = -1;
        lastTargetPeak = -1;
        lastPlayerRange = -1;
        lastTargetRange = -1;
        faces.clear();
    }

    @EventHandler
    private void onTick(TickEvent.Pre event) {
        faces.clear();
        if (mc.world == null || mc.player == null) return;

        BlockPos playerPos = mc.player.getBlockPos();
        LivingEntity target = targetGlow.get() ? targetEntity() : null;
        BlockPos targetPos = target == null ? null : target.getBlockPos();

        if (dynamicLight.get()) {
            int peak = playerIntensity.get();
            int range = playerRadius.get();
            if (!playerPos.equals(lastPlayerLight) || peak != lastPlayerPeak || range != lastPlayerRange) {
                dirtyAround(lastPlayerLight, Math.max(range, lastPlayerRange));
                dirtyAround(playerPos, range);
                lastPlayerLight = playerPos.toImmutable();
                lastPlayerPeak = peak;
                lastPlayerRange = range;
            }
        } else if (lastPlayerLight != null) {
            dirtyAround(lastPlayerLight, Math.max(playerRadius.get(), lastPlayerRange));
            lastPlayerLight = null;
            lastPlayerPeak = -1;
            lastPlayerRange = -1;
        }

        int tPeak = targetIntensity.get();
        int tRange = targetRadius.get();
        if (!Objects.equals(targetPos, lastTargetLight) || (targetPos != null && (tPeak != lastTargetPeak || tRange != lastTargetRange))) {
            dirtyAround(lastTargetLight, Math.max(tRange, lastTargetRange));
            dirtyAround(targetPos, tRange);
            lastTargetLight = targetPos == null ? null : targetPos.toImmutable();
            lastTargetPeak = targetPos == null ? -1 : tPeak;
            lastTargetRange = targetPos == null ? -1 : tRange;
        }

        if (!gloss.get()) return;

        BlockIterator.register(GLOSS_RANGE, GLOSS_RANGE, (pos, state) -> {
            if (state.isAir()) return;
            VoxelShape shape = state.getCollisionShape(mc.world, pos);
            if (shape.isEmpty()) return;
            BlockPos above = pos.up();
            BlockState next = mc.world.getBlockState(above);
            if (!next.isAir() && !next.getCollisionShape(mc.world, above).isEmpty()) return;

            Box box = shape.getBoundingBox().offset(pos.getX(), pos.getY(), pos.getZ());
            double pad = 0.012;
            faces.add(new Face(
                box.minX + pad, box.maxY + 0.012, box.minZ + pad,
                box.minX + pad, box.maxY + 0.012, box.maxZ - pad,
                box.maxX - pad, box.maxY + 0.012, box.maxZ - pad,
                box.maxX - pad, box.maxY + 0.012, box.minZ + pad
            ));
        });
    }

    @EventHandler
    private void onRender3D(Render3DEvent event) {
        if (!gloss.get() || faces.isEmpty() || shaderFailed) return;
        float level = glossLevel.get().floatValue();
        if (level <= 0.01f) return;

        int width = mc.getWindow().getFramebufferWidth();
        int height = mc.getWindow().getFramebufferHeight();
        if (width <= 0 || height <= 0) return;
        if (!ensureShaders(width, height)) return;

        int scene = mc.getFramebuffer().getColorAttachment();
        if (scene <= 0) return;

        PostProcessRenderer.beginRender();
        sceneFb.beginWrite(true);
        copyShader.bind();
        GL.bindTexture(scene, 0);
        copyShader.set("uTexture", 0);
        PostProcessRenderer.render();
        PostProcessRenderer.endRender();

        mc.getFramebuffer().beginWrite(true);
        GL.viewport(0, 0, width, height);

        Vec3d cam = mc.gameRenderer.getCamera().getPos();
        tmp.set(255, 255, 255, 255);

        mesh.depthTest = true;
        mesh.begin();
        for (Face face : faces) {
            Vec3d toCam = cam.subtract(face.cx, face.cy, face.cz);
            if (toCam.lengthSquared() < 1e-6) continue;
            float ndotv = (float) MathHelper.clamp(toCam.normalize().y, 0, 1);
            float amount = (float) Math.pow(ndotv, 1.15) * level;
            int a = MathHelper.clamp((int) (amount * 210), 0, 210);
            if (a < 12) continue;
            tmp.a = a;
            face.emit(mesh, tmp);
        }
        mesh.render(event.matrices);
        GlStateManager._blendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
        GlStateManager._depthMask(true);
    }

    private boolean ensureShaders(int width, int height) {
        try {
            if (glossShader == null) {
                glossShader = new Shader("pos_color.vert", "post-process/gloss_world.frag");
                copyShader = new Shader("passthrough.vert", "passthrough.frag");
                sceneFb = new SimpleFramebuffer(width, height, true);
                mesh = new GlassMesh();
                lastWidth = width;
                lastHeight = height;
                return true;
            }
            if (width != lastWidth || height != lastHeight) {
                sceneFb.resize(width, height);
                lastWidth = width;
                lastHeight = height;
            }
            return true;
        } catch (RuntimeException e) {
            shaderFailed = true;
            MeteorClient.LOG.error("WorldLighting gloss shader failed", e);
            return false;
        }
    }

    private void relight() {
        if (mc.player == null || mc.worldRenderer == null) return;
        dirtyAround(mc.player.getBlockPos(), playerRadius.get());
        LivingEntity target = targetEntity();
        if (target != null) dirtyAround(target.getBlockPos(), targetRadius.get());
    }

    private void dirtyAround(BlockPos center, int r) {
        if (center == null || mc.worldRenderer == null || r < 0) return;
        mc.worldRenderer.scheduleBlockRenders(
            center.getX() - r,
            center.getY() - r,
            center.getZ() - r,
            center.getX() + r,
            center.getY() + r,
            center.getZ() + r
        );
    }

    private static final class Face {
        final double x1, y1, z1, x2, y2, z2, x3, y3, z3, x4, y4, z4;
        final double cx, cy, cz;

        private Face(double x1, double y1, double z1, double x2, double y2, double z2, double x3, double y3, double z3, double x4, double y4, double z4) {
            this.x1 = x1; this.y1 = y1; this.z1 = z1;
            this.x2 = x2; this.y2 = y2; this.z2 = z2;
            this.x3 = x3; this.y3 = y3; this.z3 = z3;
            this.x4 = x4; this.y4 = y4; this.z4 = z4;
            this.cx = (x1 + x2 + x3 + x4) * 0.25;
            this.cy = (y1 + y2 + y3 + y4) * 0.25;
            this.cz = (z1 + z2 + z3 + z4) * 0.25;
        }

        void emit(Mesh mesh, Color color) {
            int i1 = mesh.vec3(x1, y1, z1).color(color).next();
            int i2 = mesh.vec3(x2, y2, z2).color(color).next();
            int i3 = mesh.vec3(x3, y3, z3).color(color).next();
            int i4 = mesh.vec3(x4, y4, z4).color(color).next();
            mesh.quad(i1, i2, i3, i4);
        }
    }

    private class GlassMesh extends ShaderMesh {
        private GlassMesh() {
            super(glossShader, DrawMode.Triangles, Mesh.Attrib.Vec3, Mesh.Attrib.Color);
        }

        @Override
        protected void beforeRender() {
            super.beforeRender();
            int width = mc.getWindow().getFramebufferWidth();
            int height = mc.getWindow().getFramebufferHeight();
            GL.bindTexture(sceneFb.getColorAttachment(), 0);
            glossShader.set("u_Texture", 0);
            glossShader.set("u_Size", width, height);
            glossShader.set("u_Noise", wetNoise.get() * 0.01);
            glossShader.set("u_Reflect", wetReflect.get());
            glossShader.set("u_Blur", wetBlur.get() * 5.0);
            glossShader.set("u_Time", glfwGetTime());
            GlStateManager._enableBlend();
            GlStateManager._blendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
            GlStateManager._depthMask(false);
            GlStateManager._disableCull();
        }
    }
}


