    private FallingPlayer(
        ClientPlayerEntity player,
        double motionX,
        double motionY,
        double motionZ
    ) {
        this.player = player;
        this.motionX = motionX;
        this.motionY = motionY;
        this.motionZ = motionZ;
    }

    public static FallingPlayer fromPlayer(ClientPlayerEntity player) {
        Vec3d velocity = player.getVelocity();
        return new FallingPlayer(
            player,
            velocity.x,
            velocity.y,
            velocity.z
        );
    }

    public boolean findFall(float fallDist) {
        Vec3d rotationVec = player.getRotationVector();
        double tempMotionY = motionY;

        double gravity = 0.08;
        float drag = MathHelper.cos(player.getPitch() * 0.017453292f);
        drag = drag * drag * (float) Math.min(rotationVec.length() / 0.4, 1.0);

        Vec3d vec3d = new Vec3d(motionX, tempMotionY, motionZ)
            .add(0.0, gravity * (-1.0 + drag * 0.75), 0.0);
        tempMotionY = vec3d.y * 0.9800000190734863;

        return tempMotionY < fallDist;
    }

    public boolean findFall(float fallDist, int ticks) {
        Vec3d rotationVec = player.getRotationVector();
        double tempMotionY = motionY;

        double gravity = 0.08;
        float drag = MathHelper.cos(player.getPitch() * 0.017453292f);
        drag = drag * drag * (float) Math.min(rotationVec.length() / 0.4, 1.0);

        for (int i = 0; i < ticks; i++) {
            Vec3d vec3d = new Vec3d(motionX, tempMotionY, motionZ)
                .add(0.0, gravity * (-1.0 + drag * 0.75), 0.0);
            tempMotionY = vec3d.y * 0.9800000190734863;

            if (tempMotionY >= fallDist) {
                return false;
            }
        }

        return true;
    }
}


