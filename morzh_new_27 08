        Vector3d off = rotOff.get();

        prevMainX = (float) main.x;
        prevMainY = (float) main.y;
        prevMainZ = (float) main.z;
        prevOffX = (float) off.x;
        prevOffY = (float) off.y;
        prevOffZ = (float) off.z;

        float mainSpeed = speedAnimateMain.get().floatValue();
        if (animateMainX.get()) main.x = rotate((float) main.x, mainSpeed);
        if (animateMainY.get()) main.y = rotate((float) main.y, mainSpeed);
        if (animateMainZ.get()) main.z = rotate((float) main.z, mainSpeed);

        float offSpeed = speedAnimateOff.get().floatValue();
        if (animateOffX.get()) off.x = rotate((float) off.x, offSpeed);
        if (animateOffY.get()) off.y = rotate((float) off.y, offSpeed);
        if (animateOffZ.get()) off.z = rotate((float) off.z, offSpeed);
    }

    @EventHandler
    private void onHeldItemRender(HeldItemRendererEvent event) {
        if (Rotations.rotating && followRotations.get()) {
            applyServerRotations(event.matrix);
        }

        float delta = mc.getRenderTickCounter().getTickDelta(false);

        if (event.hand == Hand.MAIN_HAND) {
            Vector3d rot = rotMain.get();
            rotate(event.matrix,
                MathHelper.lerp(delta, prevMainX, (float) rot.x),
                MathHelper.lerp(delta, prevMainY, (float) rot.y),
                MathHelper.lerp(delta, prevMainZ, (float) rot.z)
            );
            scale(event.matrix, scaleMain.get());
            translate(event.matrix, posMain.get());
        }
        else {
            Vector3d rot = rotOff.get();
            rotate(event.matrix,
                MathHelper.lerp(delta, prevOffX, (float) rot.x),
                MathHelper.lerp(delta, prevOffY, (float) rot.y),
                MathHelper.lerp(delta, prevOffZ, (float) rot.z)
            );
            scale(event.matrix, scaleOff.get());
            translate(event.matrix, posOff.get());
        }
    }

