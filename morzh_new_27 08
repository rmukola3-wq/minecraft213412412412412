    private void updateHoveredCard(float mx, float my, int sw, int sh, float prog) {
        hoveredCard = -1;
        if (prog < 0.5f || dcPopupOpen || addPopupOpen || serverList == null || serverList.size() == 0) {
            return;
        }
        float slideX = (1f - prog) * 40f;
        float listX = getSrvPanelX(sw) + slideX + LIST_X_OFF;
        float listY = getPanelStartY(sh) + LIST_Y_OFF;
        float listW = SRV_PANEL_W - LIST_X_OFF * 2;
        float listH = SRV_PANEL_H - LIST_Y_OFF - 10;
        if (!isOver(mx, my, listX, listY, listW, listH)) {
            return;
        }
        float row = CARD_H + CARD_GAP;
        int first = Math.max(0, (int) (scrollOffset / row) - 1);
        int last = Math.min(serverList.size() - 1, first + 7);
        for (int i = first; i <= last; i++) {
            float cardY = listY + i * row - scrollOffset;
            if (isOver(mx, my, listX, cardY, listW, CARD_H)) {
                hoveredCard = i;
                break;
            }
        }
    }

