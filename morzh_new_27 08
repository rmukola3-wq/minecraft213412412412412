    public EntityFilter add(EntityCategory category) {
        categories.add(category);
        return this;
    }

    public boolean matches(Entity entity) {
        boolean friend = entity instanceof PlayerEntity player && Friends.get().isFriend(player);
        if (friend) return categories.contains(EntityCategory.FRIEND);

