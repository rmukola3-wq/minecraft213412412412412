        scheduler.cancel(module);
    }

    public void scheduleRotation(RotationVector vector, LivingEntity entity, RotationConfig config, int priority, Module module, int ticksUntilReset) {
        scheduleRotation(config.createRotationStrategy(vector.rotation(), vector.vec(), entity, ticksUntilReset), priority, module);
    }

    public void scheduleRotation(ScheduledRotation strategy, int priority, Module module) {
        scheduler.addTask(new ScheduledTask<>(1, priority, module, strategy));
    }

    public void updateRotation() {
        ClientPlayerEntity player = mc.player;
        ScheduledRotation currentStrategy = getCurrentStrategy();
        if (player == null || currentStrategy == null) return;

        Rotation client = new Rotation(player.getYaw(), player.getPitch());
        Rotation next = currentStrategy.towards(currentRotationOriginal != null ? currentRotationOriginal : client, scheduler.getValue() == null).normalize();
        float angleTo = next.angleTo(client);
        int ticks = scheduler.tickCounter;
        int untilReset = currentStrategy.ticksUntilReset();
        if (lastStrategy == null || scheduler.getValue() != null || untilReset > ticks || (angleTo >= 2.0f && !currentStrategy.clientRotation())) {
            setRotation(next);
            lastStrategy = currentStrategy;
            if (currentStrategy.clientRotation()) {
                player.setYaw(next.getYaw());
                player.setPitch(next.getPitch());
            }
            bindSilent(new Angle(next.getYaw(), next.getPitch()), currentStrategy.moveCorrection(), currentStrategy.moveCorrection() && !currentStrategy.focusedCorrection());
            scheduler.tick(1);
            return;
        }
        if (currentRotationOriginal != null) {
            float fixed = client.withFixedYaw(currentRotationOriginal);
            player.setYaw(fixed);
        }
        clear();
        lastStrategy = null;
        currentRotationOriginal = null;
        bindSilent(null, false, false);
    }

    public void setRotation(Rotation rotation) {
        if (rotation == null) {
            ClientPlayerEntity player = mc.player;
            previousRotation = currentRotationOriginal != null ? currentRotationOriginal : new Rotation(player.getYaw(), player.getPitch());
        } else {
            previousRotation = currentRotationOriginal;
        }
        currentRotationOriginal = rotation;
    }

    public ScheduledRotation getCurrentStrategy() {
        return scheduler.getValue() != null ? scheduler.getValue() : lastStrategy;
    }

    public static float computeAngleDifference(float a, float b) {
        return MathHelper.wrapDegrees(a - b);
    }

    private void bindSilent(Angle angle, boolean moveCorrection, boolean freeCorrection) {
        AngleConnection.INSTANCE.setRotation(angle);
        AngleConnection.INSTANCE.lastRotationPlan = angle == null ? null : new AngleConstructor(
            angle,
            angle.toVector(),
            null,
            new LinearConstructor(),
            2,
            2.0f,
            moveCorrection,
            freeCorrection
        );
    }
}


