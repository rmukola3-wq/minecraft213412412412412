        if (animations != null && animations.chatEnabled()) {
            int idx = pulseChatIndex + scrolledLines;
            if (idx >= 0 && idx < visibleMessages.size()) {
                GuiAnimations.SlideAnim anim = animations.chatLineAnims.get(visibleMessages.get(idx));
                if (anim != null) ox += (int) anim.value();
