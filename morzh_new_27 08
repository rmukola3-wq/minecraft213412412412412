    private void openAddPopup(boolean edit, long now) {
        editMode=edit; addPopupOpen=true; addPopupTime=now; addNameFocused=true;
        if (edit && selectedIndex>=0 && selectedIndex<serverList.size()) {
            ServerInfo info = serverList.get(selectedIndex);
            addName    = info.name    != null ? info.name    : "";
            addAddress = info.address != null ? info.address : "";
        } else { addName=""; addAddress=""; }
    }

    private void commitAddEdit() {
        if (addName.isEmpty()||addAddress.isEmpty()) return;
        ServerInfo target;
        if (editMode && selectedIndex>=0 && selectedIndex<serverList.size()) {
            target = serverList.get(selectedIndex);
            target.name=addName; target.address=addAddress; serverList.saveFile();
        } else {
            target = new ServerInfo(addName, addAddress, ServerInfo.ServerType.OTHER);
            serverList.add(target, false);
            serverList.saveFile();
        }
        addPopupOpen=false;
        pingOne(target, true);
    }

    private void pingOne(ServerInfo info) {
        pingOne(info, false);
    }

    private void pingOne(ServerInfo info, boolean force) {
        if (info == null || info.address == null || info.address.isBlank()) return;
        if (!force && pinged.contains(info.address)) return;
        pinged.add(info.address);
        PING_POOL.execute(() -> {
            try {
                pinger.add(info, () -> {}, () -> {});
            } catch (Throwable ignored) {}
        });
    }

    private final java.util.HashSet<String> pinged = new java.util.HashSet<>();
    private final java.util.HashMap<String, CachedLine> lineCache = new java.util.HashMap<>();

    private static final class CachedLine {
        long pingMs;
        Object label;
        Object playersLabel;
        String name, motd, players, pingText;
        float pingW;
        int pingCol;
    }

    private CachedLine cardLine(ServerInfo info, float maxText) {
        String key = info.address != null ? info.address : "";
        CachedLine cached = lineCache.get(key);
        if (cached != null
                && cached.pingMs == info.ping
                && cached.label == info.label
                && cached.playersLabel == info.playerCountLabel) {
            return cached;
        }

        String motdSrc = info.label != null ? info.label.getString() : (info.address != null ? info.address : "");
        if (motdSrc.length() > 64) motdSrc = motdSrc.substring(0, 64);

        CachedLine line = new CachedLine();
        line.pingMs = info.ping;
        line.label = info.label;
        line.playersLabel = info.playerCountLabel;
        line.name = MenuText.ellipsize(info.name != null ? info.name : "Unknown", 7.5f, maxText);
        line.motd = MenuText.ellipsize(motdSrc.replace('\n', ' '), 5.5f, maxText);
        line.players = info.playerCountLabel != null ? info.playerCountLabel.getString() : "";
        if (line.players.length() > 24) line.players = line.players.substring(0, 24);
        line.pingText = info.ping < 0 ? "…" : info.ping + "ms";
        line.pingW = Fonts.INTER.getWidth(line.pingText, 5.5f);
        line.pingCol = info.ping < 0 ? COL_TEXT_SUB : (info.ping < 80 ? COL_GREEN : (info.ping < 180 ? COL_GOLD : COL_DANGER));
        lineCache.put(key, line);
        return line;
    }

