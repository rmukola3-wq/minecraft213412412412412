package meteordevelopment.meteorclient.gui.morzh.dropdown;

/**
 * Hogoshi-style animation used by Expensive 3.1 ClickGUI.
 * {@code animate()} starts a tween from the current value; {@code update()}
 * advances it. Duration is in seconds, matching {@code ru.hogoshi.Animation}.
 */
public final class DropDownAnim {
    public enum Ease {
        LINEAR,
        EXPO_OUT,
        EXPO_IN,
        CIRC_OUT,
        CUBIC_OUT,
        CUBIC_IN,
        QUART_OUT,
        BACK_OUT
    }

    private double value;
    private double from;
    private double to;
    private long startNanos;
    private float duration = 0.25f;
    private Ease ease = Ease.EXPO_OUT;
    private boolean running;

    public DropDownAnim() {
        this(0);
    }

    public DropDownAnim(double initial) {
        this.value = initial;
        this.from = initial;
        this.to = initial;
    }

    public DropDownAnim animate(double target, float durationSeconds) {
        return animate(target, durationSeconds, Ease.EXPO_OUT);
    }

    public DropDownAnim animate(double target, float durationSeconds, Ease ease) {
        this.from = value;
        this.to = target;
        this.duration = Math.max(0.01f, durationSeconds);
        this.ease = ease;
        this.startNanos = System.nanoTime();
        this.running = true;
        return this;
    }

    public void update() {
        if (!running) return;

        float elapsed = (System.nanoTime() - startNanos) / 1_000_000_000f;
        float t = elapsed / duration;

        if (t >= 1f) {
            value = to;
            running = false;
            return;
        }

        if (t < 0f) t = 0f;
        value = from + (to - from) * apply(t);
    }

    public double getValue() {
        return value;
    }

    public float getValueF() {
        return (float) value;
    }

    public boolean finished() {
        return !running;
    }

    public void snap(double target) {
        value = target;
        from = target;
        to = target;
        running = false;
    }

    private float apply(float t) {
        return switch (ease) {
            case LINEAR -> t;
            case EXPO_OUT -> t >= 1f ? 1f : 1f - (float) Math.pow(2, -10 * t);
            case EXPO_IN -> t <= 0f ? 0f : (float) Math.pow(2, 10 * t - 10);
            case CIRC_OUT -> (float) Math.sqrt(1 - (t - 1) * (t - 1));
            case CUBIC_OUT -> 1f - (1f - t) * (1f - t) * (1f - t);
            case CUBIC_IN -> t * t * t;
            case QUART_OUT -> 1f - (1f - t) * (1f - t) * (1f - t) * (1f - t);
            case BACK_OUT -> {
                float c1 = 1.70158f;
                float c3 = c1 + 1f;
                float u = t - 1f;
                yield 1f + c3 * u * u * u + c1 * u * u;
            }
        };
    }
}


