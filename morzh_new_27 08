package meteordevelopment.meteorclient.gui.morzh;

import meteordevelopment.meteorclient.gui.themes.morzh.MorzhGuiColors;
import meteordevelopment.meteorclient.settings.BoolSetting;
import meteordevelopment.meteorclient.settings.DoubleSetting;
import meteordevelopment.meteorclient.settings.EnumSetting;
import meteordevelopment.meteorclient.settings.IntSetting;
import meteordevelopment.meteorclient.settings.Setting;

/**
 * One row inside an expanded module. Subclasses only decide how the value is
 * drawn and edited; the row height they report is what the module uses to place
 * the next one.
 */
public abstract class MorzhSettingComponent extends MorzhComponent {
    public static final int ROW_HEIGHT = 14;
    public static final int SLIDER_ROW_HEIGHT = 20;

    protected static final int PADDING = 5;

    protected final Setting<?> setting;

    protected MorzhSettingComponent(
        MorzhComponent parent,
        Setting<?> setting,
        int x,
        int y,
        int width,
        int height
    ) {
        super(parent, setting.title, x, y, width, height);

        this.setting = setting;
    }

    public Setting<?> setting() {
        return setting;
    }

    /**
     * Settings hide themselves based on the value of other settings, and a
     * hidden one must not take up any room, which the layout pass gets for free
     * by skipping invisible children.
     */
    @Override
    public boolean isVisible() {
        return setting.isVisible();
    }

    public static MorzhSettingComponent create(
        MorzhComponent parent,
        Setting<?> setting,
        int x,
        int y,
        int width
    ) {
        if (setting instanceof BoolSetting bool) {
            return new MorzhBoolSettingComponent(parent, bool, x, y, width);
        }

        if (setting instanceof IntSetting || setting instanceof DoubleSetting) {
            return new MorzhNumberSettingComponent(parent, setting, x, y, width);
        }

        if (setting instanceof EnumSetting<?> enumSetting) {
            return new MorzhEnumSettingComponent(parent, enumSetting, x, y, width);
        }

        return new MorzhLabelSettingComponent(parent, setting, x, y, width);
    }

    // ------------------------------------------------------------- drawing

    protected float textY(float top, float rowHeight) {
        return top + (rowHeight - (float) MorzhSmoothRenderer.textHeight()) / 2f;
    }

    protected int labelColor(MorzhGuiContext context) {
        return context.fade(MorzhGuiColors.packed(MorzhGuiColors.TEXT_MUTED));
    }

    protected int valueColor(MorzhGuiContext context) {
        return context.fade(MorzhGuiColors.packed(MorzhGuiColors.TEXT));
    }

    /** @param reservedRight room the value or control on the right needs */
    protected void drawLabel(
        MorzhGuiContext context,
        float top,
        double reservedRight
    ) {
        String label = MorzhSmoothRenderer.fitText(
            setting.title,
            width() - PADDING * 2 - reservedRight
        );

        MorzhSmoothRenderer.text(
            context.draw,
            label,
            absoluteX() + PADDING,
            textY(top, ROW_HEIGHT),
            labelColor(context),
            false
        );
    }

    protected void drawValue(MorzhGuiContext context, String value, float top) {
        double valueWidth = MorzhSmoothRenderer.textWidth(value);

        MorzhSmoothRenderer.text(
            context.draw,
            value,
            absoluteX() + width() - PADDING - valueWidth,
            textY(top, ROW_HEIGHT),
            valueColor(context),
            false
        );
    }

    /** Shows the setting's description while the cursor rests on the row. */
    protected void offerTooltip(MorzhGuiContext context) {
        if (setting.description == null || setting.description.isEmpty()) return;
        if (!isHovered(context.mouseX, context.mouseY)) return;
        if (!MorzhScissor.contains(context.mouseX, context.mouseY)) return;

        context.tooltip = setting.description;
    }
}


