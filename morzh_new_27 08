package meteordevelopment.meteorclient.systems.modules.combat.aura.rasty.rotations;

import meteordevelopment.meteorclient.systems.modules.combat.aura.rasty.Angle;
import meteordevelopment.meteorclient.systems.modules.combat.aura.rasty.impl.RotateConstructor;
import net.minecraft.entity.Entity;
import net.minecraft.entity.LivingEntity;
import net.minecraft.util.math.MathHelper;
import net.minecraft.util.math.Vec3d;

import java.util.concurrent.ThreadLocalRandom;

import static meteordevelopment.meteorclient.MeteorClient.mc;

/**
 * Punch SpookyTime V2: multipoint + gcd mouse + perlin jitter. Profile name: Spooky P.
 */
public class SpookyPAngle extends RotateConstructor {
    private enum HitPoint {
        HEAD, NECK, CHEST, LEFT_SHOULDER, RIGHT_SHOULDER
    }

    private float flickYaw;
    private float flickPitch;
    private int flickTimer;
    private float postAura;
    private float floatYawVel;
    private float floatPitchVel;
    private boolean wasTargeting;
    private float noiseTime;
    private HitPoint point = HitPoint.CHEST;
    private float lastYaw;
    private float lastPitch;
    private boolean inited;

    public SpookyPAngle() {
        super("Spooky P");
    }

    @Override
    public Angle limitAngleChange(Angle currentAngle, Angle targetAngle, Vec3d vec3d, Entity entity) {
        if (mc.player == null) return currentAngle;
        if (currentAngle == null) currentAngle = new Angle(mc.player.getYaw(), mc.player.getPitch());
        if (!inited) {
            lastYaw = currentAngle.getYaw();
            lastPitch = currentAngle.getPitch();
            inited = true;
        }

        float currentYaw = currentAngle.getYaw();
        float currentPitch = currentAngle.getPitch();
        LivingEntity living = entity instanceof LivingEntity le && le.isAlive() ? le : null;

        if (living == null) {
            if (wasTargeting) {
                ThreadLocalRandom rng = ThreadLocalRandom.current();
                floatYawVel = (float) rng.nextDouble(-2.5, 2.5);
                floatPitchVel = (float) rng.nextDouble(-1.0, 1.0);
                postAura = 0.0f;
                wasTargeting = false;
            }
            if (postAura < 1.0f) {
                postAura += 0.03f;
                float damp = 1.0f - postAura;
                float yaw = currentYaw + (float) Math.sin(postAura * Math.PI * 2) * floatYawVel * damp;
                float pitch = MathHelper.clamp(currentPitch + (float) Math.cos(postAura * Math.PI * 2) * floatPitchVel * damp, -90f, 90f);
                return gcd(yaw, pitch, currentYaw, currentPitch);
            }
            return gcd(currentYaw, currentPitch, currentYaw, currentPitch);
        }

        wasTargeting = true;
        postAura = 1.0f;
        noiseTime += 0.03f;

        if (flickTimer <= 0 && ThreadLocalRandom.current().nextFloat() < 0.04f) {
            onHit();
        }

        Vec3d aim = multipoint(living, point);
        float waveZ = (float) Math.sin(System.currentTimeMillis() / 600.0) * 0.04f;
        float waveX = (float) Math.cos(System.currentTimeMillis() / 500.0) * 0.04f;
        Vec3d dir = aim.add(waveX, 0, waveZ).subtract(mc.player.getEyePos()).normalize();

        float baseYaw = (float) Math.toDegrees(Math.atan2(-dir.x, dir.z));
        float basePitch = (float) MathHelper.clamp(
            -Math.toDegrees(Math.atan2(dir.y, Math.hypot(dir.x, dir.z))),
            -89.0, 90.0
        );

        float waveA = (float) Math.cos(System.currentTimeMillis() / 200.0);
        float waveB = (float) Math.sin(System.currentTimeMillis() / 150.0);
        float yawJitter = perlin(noiseTime) * 0.12f * waveB + waveA * 0.04f;
        float pitchJitter = perlin(noiseTime + 100f) * 0.08f * waveA + waveB * 0.03f;

        float curFlickYaw = 0;
        float curFlickPitch = 0;
        if (flickTimer > 0) {
            curFlickYaw = flickYaw * (flickTimer / 3.0f);
            curFlickPitch = flickPitch * (flickTimer / 3.0f);
            flickTimer--;
        }

        float wantYaw = baseYaw + yawJitter + curFlickYaw;
        float wantPitch = MathHelper.clamp(basePitch + pitchJitter + curFlickPitch, -90f, 90f);
        float stepYaw = MathHelper.wrapDegrees(wantYaw - currentYaw) * 0.45f;
        float stepPitch = (wantPitch - currentPitch) * 0.45f;
        return gcd(currentYaw + stepYaw, MathHelper.clamp(currentPitch + stepPitch, -90f, 90f), currentYaw, currentPitch);
    }

    @Override
    public Vec3d randomValue() {
        return Vec3d.ZERO;
    }

    private void onHit() {
        ThreadLocalRandom rng = ThreadLocalRandom.current();
        flickYaw = (float) rng.nextDouble(-2.0, 2.0);
        flickPitch = (float) rng.nextDouble(-1.0, 1.0);
        flickTimer = 3;
        if (rng.nextFloat() < 0.2f) {
            HitPoint[] all = HitPoint.values();
            point = all[rng.nextInt(all.length)];
        }
    }

    private static Vec3d multipoint(LivingEntity entity, HitPoint preferred) {
        Vec3d base = entity.getPos();
        float height = entity.getHeight();
        float yawRad = (float) Math.toRadians(entity.getYaw());
        double sideX = -Math.cos(yawRad) * 0.32;
        double sideZ = -Math.sin(yawRad) * 0.32;
        return switch (preferred) {
            case HEAD -> base.add(0, height * 0.88, 0);
            case NECK -> base.add(0, height * 0.75, 0);
            case CHEST -> base.add(0, height * 0.60, 0);
            case LEFT_SHOULDER -> base.add(sideX, height * 0.68, sideZ);
            case RIGHT_SHOULDER -> base.add(-sideX, height * 0.68, -sideZ);
        };
    }

    private Angle gcd(float targetYaw, float targetPitch, float currentYaw, float currentPitch) {
        double sensitivity = mc.options.getMouseSensitivity().getValue();
        double f = sensitivity * 0.6 + 0.2;
        double gcd = f * f * f * 1.2;
        if (gcd < 1e-4) gcd = 1e-4;

        float dy = (float) (Math.round(MathHelper.wrapDegrees(targetYaw - currentYaw) / gcd) * gcd);
        float dp = (float) (Math.round((targetPitch - currentPitch) / gcd) * gcd);
        lastYaw = currentYaw + dy;
        lastPitch = MathHelper.clamp(currentPitch + dp, -90f, 90f);
        return new Angle(lastYaw, lastPitch);
    }

    private static float perlin(float x) {
        int xi = (int) Math.floor(x) & 255;
        float xf = x - (float) Math.floor(x);
        float u = xf * xf * (3.0f - 2.0f * xf);
        float g0 = (xi % 2 == 0) ? 1.0f : -1.0f;
        float g1 = ((xi + 1) % 2 == 0) ? 1.0f : -1.0f;
        return g0 * xf + u * (g1 * (xf - 1.0f) - g0 * xf);
    }
}


