package meteordevelopment.meteorclient.gui.rasty.util.render;

import meteordevelopment.meteorclient.gui.rasty.util.render.font.Fonts;

/** Shared cheap text helpers for menu lists. */
public final class MenuText {
    private MenuText() {}

    public static String ellipsize(String text, float size, float maxW) {
        if (text == null || text.isEmpty()) return "";
        if (Fonts.INTER.getWidth(text, size) <= maxW) return text;
        int lo = 0;
        int hi = text.length();
        while (lo < hi) {
            int mid = (lo + hi + 1) >>> 1;
            if (Fonts.INTER.getWidth(text.substring(0, mid) + "..", size) <= maxW) lo = mid;
            else hi = mid - 1;
        }
        return lo <= 0 ? ".." : text.substring(0, lo) + "..";
    }
}


