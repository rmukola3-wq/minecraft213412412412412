    public boolean mouseClicked(meteordevelopment.meteorclient.gui.rasty.compat.Click click, boolean doubled) {
        if (leave.active()) return true;
        float mx = toFixed(click.x()), my = toFixed(click.y());
        int   sw = getFixedW(), sh = getFixedH();
        long  now = Util.getMeasuringTimeMs();

        if (dcPopupOpen) {
            float pw=220f, ph=80f, px0=sw/2f-pw/2f, py0=sh/2f-ph/2f;
            float btnX=px0+pw/2f-35f, btnY=py0+ph-24f;
            if (isOver(mx,my,px0+10,py0+30,pw-20,16f)) { dcFocused=true; MorzhSoundManager.playBoolean(); return true; }
            if (isOver(mx,my,btnX,btnY,70f,16f)) { MorzhSoundManager.playBoolean(); connectDirect(); return true; }
            if (!isOver(mx,my,px0,py0,pw,ph)) { MorzhSoundManager.playBoolean(); dcPopupOpen=false; }
            return true;
        }

        if (addPopupOpen) {
            float pw=230f, ph=100f, px0=sw/2f-pw/2f, py0=sh/2f-ph/2f;
            float btnX=px0+pw/2f-35f, btnY=py0+ph-21f;
            if (isOver(mx,my,px0+10,py0+34,pw-20,16f)) { addNameFocused=true; MorzhSoundManager.playBoolean(); return true; }
            if (isOver(mx,my,px0+10,py0+63,pw-20,16f)) { addNameFocused=false; MorzhSoundManager.playBoolean(); return true; }
            if (isOver(mx,my,btnX,btnY,70f,16f)) { MorzhSoundManager.playBoolean(); commitAddEdit(); return true; }
            if (!isOver(mx,my,px0,py0,pw,ph)) { MorzhSoundManager.playBoolean(); addPopupOpen=false; }
            return true;
        }

        if (vfpErrorPopupOpen) {
            MorzhSoundManager.playBoolean();
            vfpErrorPopupOpen = false;
            return true;
        }

        float prog   = getAppearProgress(now);
        float slideX = (1f - prog) * 40f;
        float listX  = getSrvPanelX(sw) + slideX + LIST_X_OFF;
        float listY  = getPanelStartY(sh) + LIST_Y_OFF;
        float listW  = SRV_PANEL_W - LIST_X_OFF * 2;
        float listH  = SRV_PANEL_H - LIST_Y_OFF - 10;

        if (isOver(mx, my, listX, listY, listW, listH)) {
            for (int i = 0; i < serverList.size(); i++) {
                float cardY = listY + i*(CARD_H+CARD_GAP) - scrollOffset;
                if (isOver(mx, my, listX, cardY, listW, CARD_H)) {
                    MorzhSoundManager.playBoolean();
                    if (selectedIndex==i && doubled) connectSelected();
                    else {
                        selectedIndex = i;
                        pingOne(serverList.get(i), true);
                    }
                    return true;
                }
            }
        }

        if (hoveredBtn >= 0) { MorzhSoundManager.playBoolean(); handleButtonClick(hoveredBtn, now); return true; }
        return super.mouseClicked(click.x(), click.y(), click.button());
    }

