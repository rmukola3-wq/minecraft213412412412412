        if (alpha < 0.05f) return;
        float cell = Math.max(36f, sw / 10f);
        int lineA = MathHelper.clamp((int) (10 * alpha), 0, 28);
        int line = MenuPalette.withAlpha(0xFFFFFF, lineA);
        for (float x = 0; x <= sw; x += cell) {
            Render2D.rect(x, 0, 0.5f, sh, line, 0f);
