        public void show(long ms) {
            duration = Math.max(1, ms);
            start = value;
            target = 1;
            startMs = System.currentTimeMillis();
            shown = true;
            renderable = true;
        }

        public void hide(long ms) {
            duration = Math.max(1, ms);
            start = value;
            target = 0;
            startMs = System.currentTimeMillis();
            shown = false;
            renderable = true;
        }

        public void tick() {
            if (startMs == 0) return;
            long elapsed = System.currentTimeMillis() - startMs;
            if (elapsed >= duration) {
                value = target;
                startMs = 0;
                if (!shown) renderable = false;
                return;
            }
            value = lerp(start, target, easeOut(elapsed / (double) duration));
        }

        public float value() {
