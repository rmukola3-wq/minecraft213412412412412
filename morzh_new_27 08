        float slideY = (1f - prog) * -20f;
        Fonts.BOLD.draw("MORZH", 14f, 14f + slideY, 16f, withAlpha(COL_TEXT, (int)(prog * 255)));
        Fonts.INTER.draw("client", 14f + Fonts.BOLD.getWidth("MORZH", 16f) + 5f, 14f + slideY + 6f, 7f, withAlpha(COL_ACCENT, (int)(prog * 180)));

