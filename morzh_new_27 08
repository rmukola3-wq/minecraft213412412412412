import java.util.concurrent.ThreadLocalRandom;

/**
 * Dummy/System-style assist: target on tick, rotation every frame with delta time + linear lerp.
 */
public class AimAssist extends Module {
    private static final double[][] AIM_POINTS = {
        {0.50, 0.62, 0.50},
        {0.50, 0.74, 0.50},
        {0.50, 0.50, 0.50},
        {0.50, 0.38, 0.50},
        {0.34, 0.64, 0.50},
        {0.66, 0.64, 0.50},
        {0.50, 0.64, 0.34},
        {0.50, 0.64, 0.66},
        {0.38, 0.72, 0.50},
        {0.62, 0.72, 0.50},
        {0.50, 0.72, 0.38},
        {0.50, 0.72, 0.62},
        {0.32, 0.52, 0.50},
        {0.68, 0.52, 0.50},
        {0.50, 0.52, 0.32},
        {0.50, 0.52, 0.68},
        {0.42, 0.80, 0.50},
        {0.58, 0.80, 0.50},
        {0.40, 0.44, 0.40},
        {0.60, 0.44, 0.60},
        {0.36, 0.58, 0.36},
        {0.64, 0.58, 0.64},
        {0.45, 0.68, 0.55},
        {0.55, 0.68, 0.45}
    };

    private final SettingGroup sgTargets = settings.getDefaultGroup();
    private final SettingGroup sgAim = settings.createGroup("Наведение");

    private final Setting<Boolean> targetPlayers = sgTargets.add(new BoolSetting.Builder()
        .name("игроки")
        .defaultValue(true)
        .build()
    );

    private final Setting<Boolean> targetAnimals = sgTargets.add(new BoolSetting.Builder()
        .name("животные")
        .defaultValue(false)
        .build()
    );

    private final Setting<Boolean> targetMobs = sgTargets.add(new BoolSetting.Builder()
        .name("мобы")
        .defaultValue(false)
        .build()
    );

    private final Setting<Boolean> targetFriends = sgTargets.add(new BoolSetting.Builder()
        .name("друзья")
        .defaultValue(false)
        .build()
    );

    private final Setting<Boolean> throughWalls = sgTargets.add(new BoolSetting.Builder()
        .name("за-стенами")
        .defaultValue(false)
        .build()
    );

    private final Setting<Boolean> weaponOnly = sgTargets.add(new BoolSetting.Builder()
        .name("только-с-оружием")
        .defaultValue(false)
        .build()
    );

    private final Setting<Boolean> lockTarget = sgTargets.add(new BoolSetting.Builder()
        .name("удерживать-цель")
        .defaultValue(true)
        .build()
    );

    private final Setting<Double> range = sgAim.add(new DoubleSetting.Builder()
        .name("дистанция")
        .defaultValue(4.5)
        .min(1.0)
        .max(6.0)
        .sliderRange(1.0, 6.0)
        .build()
    );

    private final Setting<Double> fov = sgAim.add(new DoubleSetting.Builder()
        .name("fov")
        .defaultValue(90.0)
        .min(15.0)
        .max(180.0)
        .sliderRange(15.0, 180.0)
        .build()
    );

    private final Setting<Double> strength = sgAim.add(new DoubleSetting.Builder()
        .name("сила")
        .description("Скорость линейной доводки за секунду. Крутит каждый кадр, не раз в тик.")
        .defaultValue(7.5)
        .min(1.0)
        .max(10.0)
        .sliderRange(1.0, 10.0)
        .build()
    );

    private final Setting<Boolean> verticalAssist = sgAim.add(new BoolSetting.Builder()
        .name("вертикальная-доводка")
        .defaultValue(true)
        .build()
    );

    private final Setting<Boolean> onlyAttackKey = sgAim.add(new BoolSetting.Builder()
        .name("только-при-атаке")
        .defaultValue(false)
        .build()
    );

    private LivingEntity target;
    private Vec3d selectedNorm;
    private Vec3d smoothedPoint;
    private int pointTicks;

    public AimAssist() {
        super(Categories.Combat, "aim-assist", "Плавно доводит каждый кадр (delta time), цель и точки — раз в тик.");
    }

    @Override
    public void onActivate() {
        resetAll();
    }

    @Override
    public void onDeactivate() {
        resetAll();
    }

    @Override
    public String getInfoString() {
        return target != null ? target.getName().getString() : null;
    }

    @EventHandler
    private void onTick(TickEvent.Post event) {
        if (!canOperate()) {
            resetAll();
            return;
        }

        LivingEntity trigger = triggerTarget();
        if (trigger != null) {
            setTarget(trigger);
        } else if (!(lockTarget.get()
            && isValidTarget(target)
            && angleToEntity(target) <= fov.get() * 1.2
            && (throughWalls.get() || canSee(target)))) {
            setTarget(findTarget());
        }

        if (target == null || !isValidTarget(target)) {
            selectedNorm = null;
            smoothedPoint = null;
            return;
        }

        resolvePoint(target, ThreadLocalRandom.current());
    }

    @EventHandler
    private void onRender(Render3DEvent event) {
        if (!canOperate() || target == null || !isValidTarget(target)) return;
        if (onlyAttackKey.get() && !mc.options.attackKey.isPressed()) return;
        if (selectedNorm == null) return;

        float dt = (float) event.frameTime;
        if (dt <= 0.0F || dt > 0.1F) dt = 1.0F / 60.0F;

        Vec3d point = pointOnBox(target.getBoundingBox(), selectedNorm);
        if (smoothedPoint == null || smoothedPoint.squaredDistanceTo(point) > 9.0) {
            smoothedPoint = point;
        } else {
            float pointT = MathHelper.clamp(11.0F * dt, 0.0F, 1.0F);
            smoothedPoint = new Vec3d(
                MathHelper.lerp(pointT, smoothedPoint.x, point.x),
                MathHelper.lerp(pointT, smoothedPoint.y, point.y),
                MathHelper.lerp(pointT, smoothedPoint.z, point.z)
            );
        }

        Vec3d delta = smoothedPoint.subtract(mc.player.getEyePos());
        float wantedYaw = (float) MathHelper.wrapDegrees(Math.toDegrees(Math.atan2(delta.z, delta.x)) - 90.0);
        float wantedPitch = MathHelper.clamp(
            (float) -Math.toDegrees(Math.atan2(delta.y, Math.hypot(delta.x, delta.z))),
            -89.9F,
            89.9F
        );

        float yaw = mc.player.getYaw();
        float pitch = mc.player.getPitch();
        float yawError = MathHelper.wrapDegrees(wantedYaw - yaw);
        float pitchError = wantedPitch - pitch;

        if (lookingAt(target) && Math.hypot(yawError, pitchError) < 1.15F) return;

        float lerpSpeed = 5.0F + strength.get().floatValue() * 1.15F;
        float t = MathHelper.clamp(lerpSpeed * dt, 0.0F, 1.0F);

        float yawStep = preventOvershoot(yawError * t, yawError);
        float pitchStep = preventOvershoot(pitchError * t * 0.82F, pitchError);
        if (!verticalAssist.get()) pitchStep = 0.0F;

        if (Math.abs(yawStep) < 1.0E-5F && Math.abs(pitchStep) < 1.0E-5F) return;

        mc.player.setYaw(yaw + yawStep);
        mc.player.setPitch(MathHelper.clamp(pitch + pitchStep, -89.9F, 89.9F));
    }

    private Vec3d resolvePoint(LivingEntity entity, ThreadLocalRandom random) {
        Box box = entity.getBoundingBox();
        if (selectedNorm != null && --pointTicks > 0) {
            Vec3d current = pointOnBox(box, selectedNorm);
            if (throughWalls.get() || isVisible(mc.player.getEyePos(), current)) return current;
        }

        List<Vec3d> visible = new ArrayList<>();
        Vec3d eyes = mc.player.getEyePos();
        float yaw = mc.player.getYaw();
        float pitch = mc.player.getPitch();

        Vec3d best = null;
        double bestCost = Double.MAX_VALUE;

        for (double[] candidate : AIM_POINTS) {
            Vec3d norm = new Vec3d(candidate[0], candidate[1], candidate[2]);
            Vec3d point = pointOnBox(box, norm);
            if (eyes.squaredDistanceTo(point) > range.get() * range.get()) continue;
            if (!throughWalls.get() && !isVisible(eyes, point)) continue;

            visible.add(norm);
            double cost = lookCost(eyes, point, yaw, pitch);
            if (cost < bestCost) {
                bestCost = cost;
                best = norm;
            }
        }

        if (visible.isEmpty()) {
            selectedNorm = new Vec3d(0.50, 0.62, 0.50);
        } else if (random.nextFloat() < 0.34F) {
            selectedNorm = visible.get(random.nextInt(visible.size()));
        } else {
            selectedNorm = best != null ? best : visible.get(0);
        }

        pointTicks = random.nextInt(2, 7);
        return pointOnBox(box, selectedNorm);
    }

    private static double lookCost(Vec3d eyes, Vec3d point, float yaw, float pitch) {
        Vec3d delta = point.subtract(eyes);
        float wantedYaw = (float) MathHelper.wrapDegrees(Math.toDegrees(Math.atan2(delta.z, delta.x)) - 90.0);
        float wantedPitch = (float) -Math.toDegrees(Math.atan2(delta.y, Math.hypot(delta.x, delta.z)));
        return Math.hypot(MathHelper.wrapDegrees(wantedYaw - yaw), (wantedPitch - pitch) * 0.72F);
    }

    private static Vec3d pointOnBox(Box box, Vec3d norm) {
        double mx = Math.min(0.04, box.getLengthX() * 0.10);
        double my = Math.min(0.06, box.getLengthY() * 0.06);
        double mz = Math.min(0.04, box.getLengthZ() * 0.10);
        return new Vec3d(
            MathHelper.lerp(norm.x, box.minX + mx, box.maxX - mx),
            MathHelper.lerp(norm.y, box.minY + my, box.maxY - my),
            MathHelper.lerp(norm.z, box.minZ + mz, box.maxZ - mz)
        );
    }

    private boolean lookingAt(LivingEntity entity) {
        Vec3d origin = mc.player.getEyePos();
        Vec3d end = origin.add(Vec3d.fromPolar(mc.player.getPitch(), mc.player.getYaw()).multiply(
            Math.max(range.get(), mc.player.distanceTo(entity) + 0.5)
        ));
        Box box = entity.getBoundingBox();
        return (box.contains(origin) ? origin : box.raycast(origin, end).orElse(null)) != null;
    }

    private static float preventOvershoot(float step, float error) {
        if (Math.abs(error) <= 1.0E-4F) return 0.0F;
        if (Math.signum(step) != Math.signum(error)) return 0.0F;
        return Math.copySign(Math.min(Math.abs(step), Math.abs(error)), error);
    }

    private boolean canOperate() {
        if (!PlayerUtils.isAlive() || mc.world == null || mc.player == null) return false;
        if (mc.currentScreen != null) return false;
        if (weaponOnly.get() && !hasWeapon()) return false;
        return !isAuraRotating();
    }

    private LivingEntity triggerTarget() {
        TriggerBot trigger = Modules.get().get(TriggerBot.class);
        if (trigger == null || !trigger.isActive()) return null;
        LivingEntity locked = trigger.getTarget();
        if (locked != null && isValidTarget(locked)) return locked;
        if (!(mc.crosshairTarget instanceof EntityHitResult result) || result.getType() != HitResult.Type.ENTITY) {
            return null;
        }
        return result.getEntity() instanceof LivingEntity living && isValidTarget(living) ? living : null;
    }

    private LivingEntity findTarget() {
        LivingEntity[] best = {null};
        double[] bestScore = {Double.MAX_VALUE};
        for (Entity entity : mc.world.getEntities()) {
            considerTarget(entity, best, bestScore);
        }
        FakePlayerManager.forEach(fp -> considerTarget(fp, best, bestScore));
        return best[0];
    }

    private void considerTarget(Entity entity, LivingEntity[] best, double[] bestScore) {
        if (!(entity instanceof LivingEntity living) || !isValidTarget(living)) return;
        double angle = angleToEntity(living);
        if (angle > fov.get()) return;
        if (!throughWalls.get() && !canSee(living)) return;
        double score = angle + mc.player.distanceTo(living) * 0.18;
        if (score < bestScore[0]) {
            bestScore[0] = score;
            best[0] = living;
        }
    }

    private void setTarget(LivingEntity value) {
        if (value == target) return;
        target = value;
        selectedNorm = null;
        smoothedPoint = null;
        pointTicks = 0;
    }

    private boolean isValidTarget(LivingEntity entity) {
        if (entity == null || entity == mc.player || !entity.isAlive() || entity.isRemoved()) return false;
        if (closestDistanceSquared(entity) > range.get() * range.get()) return false;
        return isAllowedTarget(entity);
    }

    private boolean isAllowedTarget(LivingEntity entity) {
        if (entity instanceof PlayerEntity player) {
            if (!targetPlayers.get()) return false;
            AntiBot antiBot = Modules.get().get(AntiBot.class);
            if (antiBot != null && antiBot.isBot(player)) return false;
            return targetFriends.get() || !Friends.get().isFriend(player);
        }
        if (entity instanceof MobEntity) return targetMobs.get();
        return entity instanceof AnimalEntity && targetAnimals.get();
    }

    private boolean hasWeapon() {
        Item item = mc.player.getMainHandStack().getItem();
        if (item instanceof SwordItem || item instanceof AxeItem || item instanceof MaceItem) return true;
        String key = item.getTranslationKey().toLowerCase();
        return key.contains("sword")
            || key.contains("mace")
            || key.contains("trident")
            || (key.contains("axe") && !key.contains("pickaxe"));
    }

    private boolean canSee(LivingEntity entity) {
        return hasVisiblePoint(entity) || PlayerUtils.canSeeEntity(entity);
    }

    private double angleToEntity(LivingEntity entity) {
        Vec3d direction = entity.getBoundingBox().getCenter().subtract(mc.player.getEyePos());
        float wantedYaw = (float) MathHelper.wrapDegrees(Math.toDegrees(Math.atan2(direction.z, direction.x)) - 90.0);
        float wantedPitch = (float) -Math.toDegrees(Math.atan2(direction.y, Math.hypot(direction.x, direction.z)));
        return Math.max(
            Math.abs(MathHelper.wrapDegrees(wantedYaw - mc.player.getYaw())),
            Math.abs(wantedPitch - mc.player.getPitch()) * 0.65F
        );
    }

    private boolean hasVisiblePoint(LivingEntity entity) {
        Box box = entity.getBoundingBox();
        Vec3d eyes = mc.player.getEyePos();
        double max = range.get() * range.get();
        for (double[] candidate : AIM_POINTS) {
            Vec3d point = pointOnBox(box, new Vec3d(candidate[0], candidate[1], candidate[2]));
            if (eyes.squaredDistanceTo(point) <= max && isVisible(eyes, point)) return true;
        }
        return PlayerUtils.canSeeEntity(entity);
    }

    private boolean isVisible(Vec3d from, Vec3d to) {
        return mc.world.raycast(new RaycastContext(
            from, to, RaycastContext.ShapeType.COLLIDER, RaycastContext.FluidHandling.NONE, mc.player
        )).getType() == HitResult.Type.MISS;
    }

    private double closestDistanceSquared(Entity entity) {
        Vec3d eyes = mc.player.getEyePos();
        Box box = entity.getBoundingBox();
        return eyes.squaredDistanceTo(new Vec3d(
            MathHelper.clamp(eyes.x, box.minX, box.maxX),
            MathHelper.clamp(eyes.y, box.minY, box.maxY),
            MathHelper.clamp(eyes.z, box.minZ, box.maxZ)
        ));
    }

    private void resetAll() {
        target = null;
        selectedNorm = null;
        smoothedPoint = null;
        pointTicks = 0;
    }

    private boolean isAuraRotating() {
        KillAura killAura = Modules.get().get(KillAura.class);
        if (killAura != null && killAura.isDrivingPlayerRotation()) return true;
        ExpensiveAura expensiveAura = Modules.get().get(ExpensiveAura.class);
        return expensiveAura != null && expensiveAura.isActive() && expensiveAura.target() != null;
    }
}


