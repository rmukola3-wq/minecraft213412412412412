private int findSelectedCategoryY(int startY) {
        int categoryY = startY;

        for (Category category : Modules.loopCategories()) {
            if (!hasVisibleModules(category)) continue;
            if (category == selectedCategory) return categoryY;
            categoryY += 18;
        }

        return -1;
    }

    private void renderModuleList(
        DrawContext context,
        int mouseX,
        int mouseY,
        int x,
        int y,
        int listWidth,
        int listHeight
    ) {
        List<Module> modules = getDisplayedModules();

        drawText(
            context,
            search.isEmpty() && selectedCategory != null
                ? selectedCategory.name.toUpperCase(Locale.ROOT)
                : "SEARCH RESULTS",
            x + 8,
            y + 8,
            secondaryTextColor(),
            false
        );

        int listTop = y + 22;
        int listBottom = y + listHeight - 6;
        int totalHeight = modules.size() * 32;
        int visibleHeight = listBottom - listTop;

        float minimumScroll = Math.min(
            0,
            visibleHeight - totalHeight
        );

        moduleTargetScroll = MathHelper.clamp(
            moduleTargetScroll,
            minimumScroll,
            0.0f
        );

        moduleScroll = MathHelper.clamp(
            moduleScroll,
            minimumScroll,
            0.0f
        );

        moduleScroll = MorzhAnimUtil.approach(
            moduleScroll,
            moduleTargetScroll,
            SCROLL_SPEED,
            frameDelta
        );

        if (Math.abs(moduleScroll - moduleTargetScroll) < 0.1f) {
            moduleScroll = moduleTargetScroll;
        }

        float progress = MorzhAnimUtil.easeOutCubic(
            moduleListAnimation
        );

        int contentOffset = Math.round(
            (1.0f - progress) * 10.0f
        );

        context.enableScissor(
            x + 3,
            listTop,
            x + listWidth - 3,
            listBottom
        );

        float moduleY = listTop + moduleScroll;

        for (Module module : modules) {
            int renderY = Math.round(moduleY);
            int renderX = x + 6 + contentOffset;
            int renderWidth = listWidth - 12 - contentOffset;

            boolean visible =
                renderY + 29 >= listTop
                    && renderY <= listBottom;

            boolean hovered =
                visible
                    && layoutTransition >= 1.0f
                    && inside(
                    mouseX,
                    mouseY,
                    renderX,
                    renderY,
                    renderWidth,
                    28
                );

            if (hovered) hoveredModule = module;

            if (visible) {
                renderModuleCard(
                    context,
                    module,
                    hovered,
                    module == selectedModule,
                    renderX,
                    renderY,
                    renderWidth,
                    28
                );
            }

            moduleY += 32.0f;
        }

        context.disableScissor();

        if (modules.isEmpty()) {
            drawText(
                context,
                "Nothing found",
                x + 12 + contentOffset,
                listTop + 8,
                secondaryTextColor(),
                false
            );
        }
    }

    private void renderModuleInfo(
        DrawContext context,
        int x,
        int y,
        int infoWidth,
        int infoHeight
    ) {
        drawText(
            context,
            "MODULE INFO",
            x + 8,
            y + 8,
            secondaryTextColor(),
            false
        );

        if (selectedModule == null) {
            drawText(
                context,
                "Select module",
                x + 10,
                y + 31,
                primaryTextColor(),
                false
            );

            drawText(
                context,
                "Left: toggle",
                x + 10,
                y + 48,
                secondaryTextColor(),
                false
            );

            drawText(
                context,
                "Right: settings",
                x + 10,
                y + 61,
                secondaryTextColor(),
                false
            );

            return;
        }

        drawSurface(
            context,
            x + 7,
            y + 24,
            infoWidth - 14,
            38,
            6.0f,
            Surface.Card,
            true
        );

        drawText(
            context,
            shorten(selectedModule.title, 18),
            x + 13,
            y + 31,
            primaryTextColor(),
            true
        );

        drawText(
            context,
            selectedModule.isActive()
                ? "ENABLED"
                : "DISABLED",
            x + 13,
            y + 47,
            selectedModule.isActive() ? GREEN : RED,
            false
        );

        drawText(
            context,
            "Description",
            x + 9,
            y + 76,
            ACCENT,
            false
        );

        List<String> lines = wrap(
            selectedModule.description,
            Math.max(15, (infoWidth - 18) / 6)
        );

        int lineY = y + 90;

        for (String line : lines) {
            if (lineY > y + infoHeight - 43) break;

            drawText(
                context,
                line,
                x + 9,
                lineY,
                secondaryTextColor(),
                false
            );

            lineY += 11;
        }

        drawSurface(
            context,
            x + 8,
            y + infoHeight - 30,
            infoWidth - 16,
            20,
            6.0f,
            Surface.Selected,
            true
        );

        drawText(
            context,
            "Open settings",
            x + 15,
            y + infoHeight - 23,
            primaryTextColor(),
            false
        );
    }

    private void renderClassic(
        DrawContext context,
        int mouseX,
        int mouseY
    ) {
        int areaX = panelX + 6;
        int areaY = panelY + 40;
        int areaWidth = panelWidth - 12;
        int areaHeight = panelHeight - 47;

        drawSurface(
            context,
            areaX,
            areaY,
            areaWidth,
            areaHeight,
            8.0f,
            Surface.Content,
            true
        );

        int totalWidth = Math.max(
            0,
            getVisibleCategoryCount() * 110 - 6
        );

        int visibleWidth = areaWidth - 10;
        float minimumScroll = Math.min(
            0,
            visibleWidth - totalWidth
        );

        classicTargetScroll = MathHelper.clamp(
            classicTargetScroll,
            minimumScroll,
            0.0f
        );

        classicScroll = MathHelper.clamp(
            classicScroll,
            minimumScroll,
            0.0f
        );

        classicScroll = MorzhAnimUtil.approach(
            classicScroll,
            classicTargetScroll,
            SCROLL_SPEED,
            frameDelta
        );

        if (Math.abs(classicScroll - classicTargetScroll) < 0.1f) {
            classicScroll = classicTargetScroll;
        }

        context.enableScissor(
            areaX,
            areaY,
            areaX + areaWidth,
            areaY + areaHeight
        );

        int columnWidth = 104;
        int columnX = areaX + 5 + Math.round(classicScroll);

        for (Category category : Modules.loopCategories()) {
            if (!hasVisibleModules(category)) continue;

            renderClassicCategory(
                context,
                category,
                columnX,
                areaY + 5,
                columnWidth,
                areaHeight - 10,
                mouseX,
                mouseY
            );

            columnX += columnWidth + 6;
        }

        context.disableScissor();

        drawText(
            context,
            "Mouse wheel: scroll categories",
            areaX + 8,
            panelY + panelHeight - 13,
            secondaryTextColor(),
            false
        );
    }

    private void renderClassicCategory(
        DrawContext context,
        Category category,
        int x,
        int y,
        int categoryWidth,
        int maxHeight,
        int mouseX,
        int mouseY
    ) {
        drawSurface(
            context,
            x,
            y,
            categoryWidth,
            maxHeight,
            7.0f,
            Surface.Panel,
            true
        );

        drawSurface(
            context,
            x,
            y,
            categoryWidth,
            20,
            7.0f,
            Surface.Selected,
            true
        );

        drawText(
            context,
            shorten(category.name, 14),
            x + 7,
            y + 7,
            primaryTextColor(),
            true
        );

        int moduleY = y + 24;

        for (Module module : Modules.get().getGroup(category)) {
            if (Config.get().hiddenModules.get().contains(module)) {
                continue;
            }

            if (moduleY + 19 > y + maxHeight - 4) break;

            boolean hovered =
                layoutTransition >= 1.0f
                    && inside(
                    mouseX,
                    mouseY,
                    x + 4,
                    moduleY,
                    categoryWidth - 8,
                    18
                );

            if (hovered) hoveredModule = module;

            renderModuleCard(
                context,
                module,
                hovered,
                module == selectedModule,
                x + 4,
                moduleY,
                categoryWidth - 8,
                18
            );

            moduleY += 20;
        }
    }

    private void renderModuleCard(
        DrawContext context,
        Module module,
        boolean hovered,
        boolean selected,
        int x,
        int y,
        int cardWidth,
        int cardHeight
    ) {
        float hover = hoverAnimations.getOrDefault(
            module,
            0.0f
        );

        hover = MorzhAnimUtil.approach(
            hover,
            hovered ? 1.0f : 0.0f,
            HOVER_SPEED,
            frameDelta
        );

        hoverAnimations.put(module, hover);

        float active = toggleAnimations.getOrDefault(
            module,
            module.isActive() ? 1.0f : 0.0f
        );

        active = MorzhAnimUtil.approach(
            active,
            module.isActive() ? 1.0f : 0.0f,
            TOGGLE_SPEED,
            frameDelta
        );

        toggleAnimations.put(module, active);

        drawSurface(
            context,
            x,
            y,
            cardWidth,
            cardHeight,
            6.0f,
            hover > 0.2f
                ? Surface.CardHover
                : Surface.Card,
            selected || hovered
        );

        if (selected) {
            MorzhSmoothRenderer.roundedRect(
                context,
                x,
                y + 3,
                2,
                cardHeight - 6,
                1.0f,
                ACCENT
            );
        }

        if (active > 0.01f) {
            MorzhSmoothRenderer.roundedRect(
                context,
                x + 2,
                y + cardHeight - 2,
                Math.max(
                    1,
                    Math.round((cardWidth - 4) * active)
                ),
                2,
                1.0f,
                ACCENT
            );
        }

        drawText(
            context,
            shorten(
                module.title,
                cardHeight <= 18 ? 13 : 18
            ),
            x + 6,
            y + (cardHeight <= 18 ? 5 : 6),
            module.isActive()
                ? primaryTextColor()
                : secondaryTextColor(),
            false
        );

        if (cardHeight > 20) {
            drawText(
                context,
                module.isActive() ? "ON" : "OFF",
                x + cardWidth - 24,
                y + 16,
                module.isActive() ? GREEN : RED,
                false
            );
        }
    }

    @Override
    public boolean mouseClicked(
        double mouseX,
        double mouseY,
        int button
    ) {
        int mx = (int) mouseX;
        int my = (int) mouseY;

        if (button == GLFW.GLFW_MOUSE_BUTTON_LEFT
            && inside(
            mx,
            my,
            panelX + 95,
            panelY + 10,
            48,
            18
        )) {
            switchLayout(Layout.Thunder);
            return true;
        }

        if (button == GLFW.GLFW_MOUSE_BUTTON_LEFT
            && inside(
            mx,
            my,
            panelX + 147,
            panelY + 10,
            45,
            18
        )) {
            switchLayout(Layout.Classic);
            return true;
        }

        if (button == GLFW.GLFW_MOUSE_BUTTON_LEFT
            && inside(
            mx,
            my,
            panelX + 196,
            panelY + 10,
            43,
            18
        )) {
            visualStyle = switch (visualStyle) {
                case Solid -> VisualStyle.Amethyst;
                case Amethyst -> VisualStyle.LiquidGlass;
                case LiquidGlass -> VisualStyle.Solid;
            };

            savedVisualStyle = visualStyle;
            MorzhSoundManager.playBoolean();
            return true;
        }

        if (layout == Layout.Thunder) {
            int searchWidth = Math.min(
                137,
                panelWidth / 3
            );

            int searchX =
                panelX + panelWidth - searchWidth - 12;

            if (inside(
                mx,
                my,
                searchX,
                panelY + 11,
                searchWidth,
                17
            )) {
                searching = true;
                MorzhSoundManager.playKeyPress();
                return true;
            }
        }

        if (inside(
            mx,
            my,
            panelX + 5,
            panelY + 5,
            panelWidth - 10,
            30
        )) {
            dragging = true;
            dragOffsetX = mx - panelX;
            dragOffsetY = my - panelY;
            return true;
        }

        if (layoutTransition < 0.95f) return true;

        if (layout == Layout.Thunder) {
            return clickThunder(mx, my, button);
        }

        return clickClassic(mx, my, button);
    }

    private void switchLayout(Layout target) {
        if (layout == target) return;

        previousLayout = layout;
        layout = target;
        layoutTransition = 0.0f;
        searching = false;

        MorzhSoundManager.playBoolean();
    }

    private boolean clickThunder(
        int mouseX,
        int mouseY,
        int button
    ) {
        int contentY = panelY + 40;
        int categoryY = contentY + 23;

        for (Category category : Modules.loopCategories()) {
            if (!hasVisibleModules(category)) continue;

            if (inside(
                mouseX,
                mouseY,
                panelX + 10,
                categoryY,
                82,
                16
            )) {
                selectedCategory = category;
                selectedModule = null;
                moduleScroll = 0.0f;
                moduleTargetScroll = 0.0f;
                moduleListAnimation = 0.0f;
                search = "";
                searching = false;

                MorzhSoundManager.playBoolean();
                return true;
            }

            categoryY += 18;
        }

        int modulesX = panelX + 102;
        int listTop = contentY + 22;
        int listBottom = panelY + panelHeight - 12;

        float moduleY = listTop + moduleScroll;

        for (Module module : getDisplayedModules()) {
            if (moduleY + 29 >= listTop
                && moduleY <= listBottom
                && inside(
                mouseX,
                mouseY,
                modulesX + 6,
                moduleY,
                133,
                28
            )) {
                activateModule(module, button);
                return true;
            }

            moduleY += 32;
        }

        int infoX = panelX + 252;
        int infoWidth = panelWidth - 257;
        int contentHeight = panelHeight - 46;

        if (selectedModule != null
            && inside(
            mouseX,
            mouseY,
            infoX + 8,
            contentY + contentHeight - 30,
            infoWidth - 16,
            20
        )) {
            openSettings(selectedModule);
            return true;
        }

        searching = false;
        return false;
    }

    private boolean clickClassic(
        int mouseX,
        int mouseY,
        int button
    ) {
        int areaX = panelX + 6;
        int areaY = panelY + 40;
        int areaHeight = panelHeight - 47;

        int columnWidth = 104;
        int columnX =
            areaX + 5 + Math.round(classicScroll);

        for (Category category : Modules.loopCategories()) {
            if (!hasVisibleModules(category)) continue;

            int moduleY = areaY + 29;

            for (Module module :
                Modules.get().getGroup(category)) {
                if (Config.get()
                    .hiddenModules
                    .get()
                    .contains(module)) {
                    continue;
                }

                if (moduleY + 19
                    > areaY + areaHeight - 4) {
                    break;
                }

                if (inside(
                    mouseX,
                    mouseY,
                    columnX + 4,
                    moduleY,
                    columnWidth - 8,
                    18
                )) {
                    activateModule(module, button);
                    return true;
                }

                moduleY += 20;
            }

            columnX += columnWidth + 6;
        }

        return false;
    }

    private void activateModule(
        Module module,
        int button
    ) {
        selectedModule = module;

        if (button == GLFW.GLFW_MOUSE_BUTTON_LEFT) {
            module.toggle();

            MorzhSoundManager.playModuleState(
                module.isActive()
            );
        } else if (
            button == GLFW.GLFW_MOUSE_BUTTON_RIGHT
        ) {
            openSettings(module);
        }
    }

    private void openSettings(Module module) {
        MorzhSoundManager.playKeyPress();

        if (client != null) {
            client.setScreen(
                GuiThemes.get().moduleScreen(module)
            );
        }
    }

    @Override
    public boolean mouseReleased(
        double mouseX,
        double mouseY,
        int button
    ) {
        dragging = false;

        return super.mouseReleased(
            mouseX,
            mouseY,
            button
        );
    }

    @Override
    public boolean mouseScrolled(
        double mouseX,
        double mouseY,
        double horizontalAmount,
        double verticalAmount
    ) {
        if (layout == Layout.Classic) {
            int totalWidth = Math.max(
                0,
                getVisibleCategoryCount() * 110 - 6
            );

            int visibleWidth = panelWidth - 22;
            float minimumScroll = Math.min(
                0,
                visibleWidth - totalWidth
            );

            classicTargetScroll +=
                (float) verticalAmount * 35.0f;

            classicTargetScroll = MathHelper.clamp(
                classicTargetScroll,
                minimumScroll,
                0.0f
            );

            MorzhSoundManager.playScroll();
            return true;
        }

        if (inside(
            mouseX,
            mouseY,
            panelX + 102,
            panelY + 40,
            145,
            panelHeight - 46
        )) {
            List<Module> modules = getDisplayedModules();

            int visibleHeight = panelHeight - 74;
            int totalHeight = modules.size() * 32;

            float minimumScroll = Math.min(
                0,
                visibleHeight - totalHeight
            );

            moduleTargetScroll +=
                (float) verticalAmount * 18.0f;

            moduleTargetScroll = MathHelper.clamp(
                moduleTargetScroll,
                minimumScroll,
                0.0f
            );

            MorzhSoundManager.playScroll();
            return true;
        }

        return super.mouseScrolled(
            mouseX,
            mouseY,
            horizontalAmount,
            verticalAmount
        );
    }

    @Override
    public boolean keyPressed(
        int keyCode,
        int scanCode,
        int modifiers
    ) {
        if (keyCode == GLFW.GLFW_KEY_ESCAPE) {
            if (searching) {
                searching = false;
                MorzhSoundManager.playKeyRelease();
                return true;
            }

            if (!closing) {
                closing = true;
                dragging = false;
                MorzhSoundManager.playClose();
            }

            return true;
        }

        if (searching) {
            if (keyCode == GLFW.GLFW_KEY_ENTER
                || keyCode == GLFW.GLFW_KEY_KP_ENTER) {
                searching = false;
                MorzhSoundManager.playKeyRelease();
                return true;
            }

            if (keyCode == GLFW.GLFW_KEY_BACKSPACE) {
                if (!search.isEmpty()) {
                    search = search.substring(
                        0,
                        search.length() - 1
                    );

                    resetModuleScroll();
                    MorzhSoundManager.playKeyRelease();
                }

                return true;
            }
        }

        return super.keyPressed(
            keyCode,
            scanCode,
            modifiers
        );
    }

    @Override
    public boolean charTyped(
        char chr,
        int modifiers
    ) {
        if (searching
            && !Character.isISOControl(chr)
            && search.length() < 40) {
            search += chr;
            resetModuleScroll();
            MorzhSoundManager.playKeyPress();
            return true;
        }

        return super.charTyped(chr, modifiers);
    }

    private void resetModuleScroll() {
        moduleScroll = 0.0f;
        moduleTargetScroll = 0.0f;
        moduleListAnimation = 0.0f;
    }

    private List<Module> getDisplayedModules() {
        List<Module> modules = new ArrayList<>();

        String query =
            search.trim().toLowerCase(Locale.ROOT);

        for (Module module : Modules.get().getAll()) {
            if (Config.get()
                .hiddenModules
                .get()
                .contains(module)) {
                continue;
            }

            if (!query.isEmpty()) {
                boolean matches =
                    module.name
                        .toLowerCase(Locale.ROOT)
                        .contains(query)
                    || module.title
                        .toLowerCase(Locale.ROOT)
                        .contains(query)
                    || module.description != null
                    && module.description
                        .toLowerCase(Locale.ROOT)
                        .contains(query);

                if (matches) modules.add(module);
            } else if (
                selectedCategory != null
                    && Modules.get()
                    .getGroup(selectedCategory)
                    .contains(module)
            ) {
                modules.add(module);
            }
        }

        modules.sort(
            (first, second) ->
                String.CASE_INSENSITIVE_ORDER.compare(
                    first.title,
                    second.title
                )
        );

        return modules;
    }

    private boolean hasVisibleModules(
        Category category
    ) {
        for (Module module :
            Modules.get().getGroup(category)) {
            if (!Config.get()
                .hiddenModules
                .get()
                .contains(module)) {
                return true;
            }
        }

        return false;
    }

    private int getVisibleCategoryCount() {
        int count = 0;

        for (Category category : Modules.loopCategories()) {
            if (hasVisibleModules(category)) count++;
        }

        return count;
    }

    private int primaryTextColor() {
        return switch (visualStyle) {
            case Solid -> TEXT;
            case Amethyst, LiquidGlass -> 0xFFFFFFFF;
        };
    }

    private int secondaryTextColor() {
        return switch (visualStyle) {
            case Solid -> TEXT_SECONDARY;
            case Amethyst -> 0xFFE4D9EC;
            case LiquidGlass -> 0xFFDCE8F1;
        };
    }

    private int surfaceColor(Surface surface) {
        return switch (visualStyle) {
            case Solid -> switch (surface) {
                case Background -> BACKGROUND;
                case Panel -> PANEL;
                case Content -> CONTENT;
                case Card -> CARD;
                case CardHover -> CARD_HOVER;
                case Selected -> ACCENT_DARK;
            };

            case Amethyst -> switch (surface) {
                case Background -> AMETHYST_BACKGROUND;
                case Panel -> AMETHYST_PANEL;
                case Content -> AMETHYST_CONTENT;
                case Card -> AMETHYST_CARD;
                case CardHover -> AMETHYST_CARD_HOVER;
                case Selected -> AMETHYST_SELECTED;
            };

            case LiquidGlass -> switch (surface) {
                case Background -> LIQUID_BACKGROUND;
                case Panel -> LIQUID_PANEL;
                case Content -> LIQUID_CONTENT;
                case Card -> LIQUID_CARD;
                case CardHover -> LIQUID_CARD_HOVER;
                case Selected -> LIQUID_SELECTED;
            };
        };
    }

    private void drawSurface(
        DrawContext context,
        int x,
        int y,
        int surfaceWidth,
        int surfaceHeight,
        float radius,
        Surface surface,
        boolean accented
    ) {
        int baseColor = surfaceColor(surface);

        if (visualStyle == VisualStyle.Solid) {
            MorzhSmoothRenderer.roundedRect(
                context,
                x,
                y,
                surfaceWidth,
                surfaceHeight,
                radius,
                baseColor
            );

            return;
        }

        MorzhSmoothRenderer.roundedRect(
            context,
            x + 1,
            y + 2,
            surfaceWidth,
            surfaceHeight,
            radius,
            withAlpha(
                GLASS_SHADOW,
                visualStyle == VisualStyle.LiquidGlass
                    ? 42
                    : 70
            )
        );

        MorzhSmoothRenderer.roundedRect(
            context,
            x,
            y,
            surfaceWidth,
            surfaceHeight,
            radius,
            withAlpha(
                accented
                    ? GLASS_ACCENT_EDGE
                    : GLASS_EDGE,
                visualStyle == VisualStyle.LiquidGlass
                    ? accented ? 125 : 88
                    : accented ? 110 : 76
            )
        );

        if (surfaceWidth > 2 && surfaceHeight > 2) {
            MorzhSmoothRenderer.roundedRect(
                context,
                x + 1,
                y + 1,
                surfaceWidth - 2,
                surfaceHeight - 2,
                Math.max(0.0f, radius - 1.0f),
                baseColor
            );
        }

        int inset = Math.max(
            3,
            Math.round(radius)
        );

        if (surfaceWidth > inset * 2) {
            MorzhSmoothRenderer.roundedRect(
                context,
                x + inset,
                y + 1,
                surfaceWidth - inset * 2,
                1.25f,
                0.6f,
                withAlpha(
                    GLASS_HIGHLIGHT,
                    visualStyle == VisualStyle.LiquidGlass
                        ? 105
                        : 70
                )
            );
        }
    }

    private void drawText(
        DrawContext context,
        String value,
        int x,
        int y,
        int color,
        boolean shadow
    ) {
        MorzhFontRenderer.draw(
            context,
            value,
            x,
            y,
            color,
            shadow
        );
    }

    private static boolean inside(
        double mouseX,
        double mouseY,
        double x,
        double y,
        double targetWidth,
        double targetHeight
    ) {
        return mouseX >= x
            && mouseX <= x + targetWidth
            && mouseY >= y
            && mouseY <= y + targetHeight;
    }

    private static int withAlpha(
        int color,
        int alpha
    ) {
        return color & 0x00FFFFFF
            | MathHelper.clamp(alpha, 0, 255) << 24;
    }

    private static String shorten(
        String value,
        int maxLength
    ) {
        if (value == null) return "";
        if (value.length() <= maxLength) return value;

        return value.substring(
            0,
            Math.max(0, maxLength - 3)
        ) + "...";
    }

    private static List<String> wrap(
        String value,
        int maxLength
    ) {
        List<String> lines = new ArrayList<>();

        if (value == null || value.isBlank()) {
            lines.add("No description.");
            return lines;
        }

        StringBuilder line = new StringBuilder();

        for (String word : value.split("\\s+")) {
            if (line.length() > 0
                && line.length()
                + word.length()
                + 1
                > maxLength) {
                lines.add(line.toString());
                line.setLength(0);
            }

            if (line.length() > 0) line.append(' ');
            line.append(word);
        }

        if (!line.isEmpty()) lines.add(line.toString());

        return lines;
    }

    private enum Layout {
        Thunder,
        Classic
    }

    private enum VisualStyle {
        Solid,
        Amethyst,
        LiquidGlass
    }

    private enum Surface {
        Background,
        Panel,
        Content,
        Card,
        CardHover,
        Selected
    }
}


