Вставь блок целиком:

powershell

$zip="$env:temp\meteor-1.21.4.zip"
$dir="$env:temp\meteor-1.21.4-restore"

ri $dir -recurse -force -ea silentlycontinue
ri $zip -force -ea silentlycontinue

iwr "https://github.com/meteordevelopment/meteor-client/archive/2a853b2b6baa5da002f53a8925124850f37d3e73.zip" -outfile $zip
expand-archive $zip $dir -force

$upstream=(gci $dir -directory | select -first 1).fullname
$project=(resolve-path .).path
$zero=gci .\src -recurse -file | ? length -eq 0

foreach($file in $zero) {
    $relative=$file.fullname.substring($project.length + 1)
    $source=join-path $upstream $relative

    if (test-path $source) {
        cp $source $file.fullname -force
    }
}

$left=gci .\src -recurse -file | ? length -eq 0
"empty files remaining: $($left.count)"
$left | select fullname


