src/main/java/meteordevelopment/meteorclient/gui/morzh/MorzhThunderScreen.java

java

/*
 * Morzh Client GUI.
 *
 * ThunderHack-inspired Dashboard and Classic layouts.
 * Interaction ideas inspired by Rockstar Client.
 *
 * Amethyst and Liquid Glass visuals independently implemented.
 */

package meteordevelopment.meteorclient.gui.screens.morzh;

import meteordevelopment.meteorclient.gui.GuiThemes;
import meteordevelopment.meteorclient.gui.morzh.MorzhAnimUtil;
import meteordevelopment.meteorclient.gui.morzh.MorzhFontRenderer;
import meteordevelopment.meteorclient.gui.morzh.MorzhGlassRenderer;
import meteordevelopment.meteorclient.gui.morzh.MorzhSmoothRenderer;
import meteordevelopment.meteorclient.systems.config.Config;
import meteordevelopment.meteorclient.systems.modules.Category;
import meteordevelopment.meteorclient.systems.modules.Module;
import meteordevelopment.meteorclient.systems.modules.Modules;
import meteordevelopment.meteorclient.utils.sound.MorzhSoundManager;
import net.minecraft.client.gui.DrawContext;
import net.minecraft.client.gui.screen.Screen;
import net.minecraft.text.Text;
import net.minecraft.util.math.MathHelper;
import org.lwjgl.glfw.GLFW;

import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Locale;
import java.util.Map;

public class MorzhThunderScreen extends Screen {
    private static final int BACKGROUND = 0xFF18141E;
    private static final int PANEL = 0xFF211B29;
    private static final int CONTENT = 0xFF251D2D;
    private static final int CARD = 0xFF302638;
    private static final int CARD_HOVER = 0xFF40314A;

    private static final int AMETHYST_BACKGROUND = 0xB0181322;
    private static final int AMETHYST_PANEL = 0x982A2135;
    private static final int AMETHYST_CONTENT = 0x8C211A2C;
    private static final int AMETHYST_CARD = 0x783A2E46;
    private static final int AMETHYST_CARD_HOVER = 0xB0544264;
    private static final int AMETHYST_SELECTED = 0xB05F3F84;

    private static final int LIQUID_BACKGROUND = 0x1C101820;
    private static final int LIQUID_PANEL = 0x2617222D;
    private static final int LIQUID_CONTENT = 0x2015222E;
    private static final int LIQUID_CARD = 0x28243240;
    private static final int LIQUID_CARD_HOVER = 0x48394D60;
    private static final int LIQUID_SELECTED = 0x584A3872;

    private static final int ACCENT = 0xFF9A5CE0;
    private static final int ACCENT_DARK = 0xFF684093;

    private static final int TEXT = 0xFFF3ECFA;
    private static final int TEXT_SECONDARY = 0xFFA89CAE;
    private static final int GREEN = 0xFF72D69B;
    private static final int RED = 0xFFE06C75;

    private static final int GLASS_EDGE = 0x68FFFFFF;
    private static final int GLASS_ACCENT_EDGE = 0x889A5CE0;
    private static final int GLASS_HIGHLIGHT = 0x62FFFFFF;
    private static final int GLASS_SHADOW = 0x66000000;

    private static final float OPEN_SPEED = 14.0f;
    private static final float CLOSE_SPEED = 18.0f;
    private static final float HOVER_SPEED = 14.0f;
    private static final float TOGGLE_SPEED = 11.0f;
    private static final float SCROLL_SPEED = 14.0f;
    private static final float LAYOUT_SPEED = 12.0f;
    private static final float CATEGORY_SPEED = 16.0f;

    private static VisualStyle savedVisualStyle =
        VisualStyle.Solid;

    private final Map<Module, Float> hoverAnimations =
        new HashMap<>();

    private final Map<Module, Float> toggleAnimations =
        new HashMap<>();

    private Layout layout = Layout.Thunder;
    private Layout previousLayout = Layout.Thunder;

    private VisualStyle visualStyle =
        savedVisualStyle;

    private Category selectedCategory;
    private Module selectedModule;
    private Module hoveredModule;

    private int panelX;
    private int panelY;
    private int panelWidth;
    private int panelHeight;

    private int dragOffsetX;
    private int dragOffsetY;

    private boolean positioned;
    private boolean dragging;
    private boolean searching;
    private boolean closing;

    private float frameDelta = 1.0f / 60.0f;
    private float animation;
    private float layoutTransition = 1.0f;
    private float moduleListAnimation = 1.0f;

    private float moduleScroll;
    private float moduleTargetScroll;

    private float classicScroll;
    private float classicTargetScroll;

    private float categoryIndicatorY =
        Float.NaN;

    private String search = "";

    public MorzhThunderScreen() {
        super(Text.literal("Morzh Client"));
    }

    @Override
    protected void init() {
        panelWidth = Math.min(
            440,
            width - 12
        );

        panelHeight = Math.min(
            245,
            height - 12
        );

        if (!positioned) {
            panelX = (width - panelWidth) / 2;
            panelY = (height - panelHeight) / 2;
            positioned = true;
        } else {
            clampPanelPosition();
        }

        if (selectedCategory == null) {
            for (Category category :
                Modules.loopCategories()) {
                if (hasVisibleModules(category)) {
                    selectedCategory = category;
                    break;
                }
            }
        }

        animation = 0.0f;
        closing = false;
        dragging = false;

        previousLayout = layout;
        layoutTransition = 1.0f;

        MorzhSoundManager.playOpen();
    }

    @Override
    public boolean shouldPause() {
        return false;
    }

    @Override
    public void render(
        DrawContext context,
        int mouseX,
        int mouseY,
        float delta
    ) {
        frameDelta =
            MorzhAnimUtil.beginFrame();

        updateDragging(mouseX, mouseY);
        updateAnimations();

        if (closing && animation <= 0.008f) {
            if (client != null) {
                client.setScreen(null);
            }

            return;
        }

        float easedOpen =
            MorzhAnimUtil.easeOutQuart(animation);

        int maximumDim = switch (visualStyle) {
            case Solid -> 176;
            case Amethyst -> 110;
            case LiquidGlass -> 26;
        };

        int dimAlpha = Math.round(
            maximumDim * easedOpen
        );

        context.fill(
            0,
            0,
            width,
            height,
            dimAlpha << 24
        );

        int originalPanelY = panelY;

        int slideOffset = Math.round(
            (1.0f - easedOpen) * 12.0f
        );

        panelY =
            originalPanelY + slideOffset;

        int revealHeight = Math.max(
            1,
            Math.round(
                panelHeight * easedOpen
            )
        );

        int revealTop =
            panelY
                + (panelHeight - revealHeight) / 2;

        context.enableScissor(
            panelX - 2,
            revealTop - 2,
            panelX + panelWidth + 2,
            revealTop + revealHeight + 2
        );

        renderGui(
            context,
            mouseX,
            mouseY
        );

        context.disableScissor();

        panelY = originalPanelY;

        super.render(
            context,
            mouseX,
            mouseY,
            delta
        );
    }

    private void updateAnimations() {
        animation = MorzhAnimUtil.approach(
            animation,
            closing ? 0.0f : 1.0f,
            closing ? CLOSE_SPEED : OPEN_SPEED,
            frameDelta
        );

        if (!closing && animation >= 0.999f) {
            animation = 1.0f;
        }

        if (closing && animation <= 0.008f) {
            animation = 0.0f;
        }

        layoutTransition = MorzhAnimUtil.approach(
            layoutTransition,
            1.0f,
            LAYOUT_SPEED,
            frameDelta
        );

        if (layoutTransition >= 0.998f) {
            layoutTransition = 1.0f;
            previousLayout = layout;
        }

        moduleListAnimation =
            MorzhAnimUtil.approach(
                moduleListAnimation,
                1.0f,
                LAYOUT_SPEED,
                frameDelta
            );

        if (moduleListAnimation >= 0.998f) {
            moduleListAnimation = 1.0f;
        }
    }

    private void updateDragging(
        int mouseX,
        int mouseY
    ) {
        if (!dragging) return;

        panelX = mouseX - dragOffsetX;
        panelY = mouseY - dragOffsetY;

        clampPanelPosition();
    }

    private void clampPanelPosition() {
        panelX = MathHelper.clamp(
            panelX,
            -panelWidth + 60,
            width - 60
        );

        panelY = MathHelper.clamp(
            panelY,
            0,
            Math.max(0, height - 25)
        );

        int snapDistance = 8;

        if (Math.abs(panelX) <= snapDistance) {
            panelX = 0;
        }

        if (Math.abs(panelY) <= snapDistance) {
            panelY = 0;
        }

        if (Math.abs(
            panelX + panelWidth - width
        ) <= snapDistance) {
            panelX = width - panelWidth;
        }

        if (Math.abs(
            panelY + panelHeight - height
        ) <= snapDistance) {
            panelY = height - panelHeight;
        }
    }

    private void renderGui(
        DrawContext context,
        int mouseX,
        int mouseY
    ) {
        hoveredModule = null;

        if (visualStyle
            == VisualStyle.LiquidGlass) {
            MorzhGlassRenderer.draw(
                context,
                panelX,
                panelY,
                panelWidth,
                panelHeight,
                10.0f
            );
        }

        drawSurface(
            context,
            panelX,
            panelY,
            panelWidth,
            panelHeight,
            10.0f,
            Surface.Background,
            true
        );

        renderHeader(
            context,
            mouseX,
            mouseY
        );

        renderLayoutContent(
            context,
            mouseX,
            mouseY
        );

        if (hoveredModule != null
            && hoveredModule.description != null
            && !hoveredModule.description.isBlank()) {
            drawText(
                context,
                shorten(
                    hoveredModule.description,
                    58
                ),
                panelX + 10,
                panelY + panelHeight - 12,
                secondaryTextColor(),
                false
            );
        }
    }

    private void renderHeader(
        DrawContext context,
        int mouseX,
        int mouseY
    ) {
        drawSurface(
            context,
            panelX + 5,
            panelY + 5,
            panelWidth - 10,
            30,
            7.0f,
            Surface.Panel,
            true
        );

        context.fill(
            panelX + 12,
            panelY + 33,
            panelX + panelWidth - 12,
            panelY + 34,
            visualStyle
                == VisualStyle.LiquidGlass
                ? 0x789A5CE0
                : ACCENT_DARK
        );

        drawText(
            context,
            "MORZH",
            panelX + 13,
            panelY + 12,
            primaryTextColor(),
            true
        );

        drawText(
            context,
            "CLIENT",
            panelX + 51,
            panelY + 12,
            ACCENT,
            true
        );

        renderHeaderButton(
            context,
            "Thunder",
            panelX + 95,
            panelY + 10,
            48,
            layout == Layout.Thunder,
            inside(
                mouseX,
                mouseY,
                panelX + 95,
                panelY + 10,
                48,
                18
            )
        );

        renderHeaderButton(
            context,
            "Classic",
            panelX + 147,
            panelY + 10,
            45,
            layout == Layout.Classic,
            inside(
                mouseX,
                mouseY,
                panelX + 147,
                panelY + 10,
                45,
                18
            )
        );

        String styleLabel =
            switch (visualStyle) {
                case Solid -> "Solid";
                case Amethyst -> "Amy";
                case LiquidGlass -> "Glass";
            };

        renderHeaderButton(
            context,
            styleLabel,
            panelX + 196,
            panelY + 10,
            43,
            visualStyle != VisualStyle.Solid,
            inside(
                mouseX,
                mouseY,
                panelX + 196,
                panelY + 10,
                43,
                18
            )
        );

        if (layout == Layout.Thunder) {
            renderSearch(
                context,
                mouseX,
                mouseY
            );
        }
    }

    private void renderHeaderButton(
        DrawContext context,
        String label,
        int x,
        int y,
        int buttonWidth,
        boolean selected,
        boolean hovered
    ) {
        drawSurface(
            context,
            x,
            y,
            buttonWidth,
            18,
            5.0f,
            selected
                ? Surface.Selected
                : hovered
                    ? Surface.CardHover
                    : Surface.Card,
            selected
        );

        if (selected) {
            MorzhSmoothRenderer.roundedRect(
                context,
                x + 4,
                y + 16,
                buttonWidth - 8,
                2,
                1.0f,
                ACCENT
            );
        }

        drawText(
            context,
            label,
            x + 5,
            y + 5,
            selected
                ? primaryTextColor()
                : secondaryTextColor(),
            false
        );
    }

    private void renderSearch(
        DrawContext context,
        int mouseX,
        int mouseY
    ) {
        int searchWidth = Math.min(
            137,
            panelWidth / 3
        );

        int searchX =
            panelX
                + panelWidth
                - searchWidth
                - 12;

        int searchY = panelY + 11;

        boolean hovered = inside(
            mouseX,
            mouseY,
            searchX,
            searchY,
            searchWidth,
            17
        );

        drawSurface(
            context,
            searchX,
            searchY,
            searchWidth,
            17,
            5.0f,
            searching || hovered
                ? Surface.CardHover
                : Surface.Card,
            searching
        );

        String shown;

        if (search.isEmpty()) {
            shown = searching
                ? "Type to search..."
                : "Search modules";
        } else {
            shown = search;
        }

        if (searching
            && (System.currentTimeMillis() / 450L)
            % 2L == 0L) {
            shown += "_";
        }

        drawText(
            context,
            shorten(shown, 19),
            searchX + 6,
            searchY + 5,
            search.isEmpty()
                ? secondaryTextColor()
                : primaryTextColor(),
            false
        );
    }

    private void renderLayoutContent(
        DrawContext context,
        int mouseX,
        int mouseY
    ) {
        if (layoutTransition >= 1.0f) {
            renderLayout(
                context,
                layout,
                mouseX,
                mouseY,
                0
            );

            return;
        }

        float eased =
            MorzhAnimUtil.easeInOutCubic(
                layoutTransition
            );

        int direction =
            layout == Layout.Classic ? 1 : -1;

        int outgoingOffset = Math.round(
            -direction
                * eased
                * panelWidth
        );

        int incomingOffset = Math.round(
            direction
                * (1.0f - eased)
                * panelWidth
        );

        context.enableScissor(
            panelX + 5,
            panelY + 39,
            panelX + panelWidth - 5,
            panelY + panelHeight - 5
        );

        renderLayout(
            context,
            previousLayout,
            Integer.MIN_VALUE / 4,
            Integer.MIN_VALUE / 4,
            outgoingOffset
        );

        renderLayout(
            context,
            layout,
            Integer.MIN_VALUE / 4,
            Integer.MIN_VALUE / 4,
            incomingOffset
        );

        context.disableScissor();
    }

    private void renderLayout(
        DrawContext context,
        Layout target,
        int mouseX,
        int mouseY,
        int offsetX
    ) {
        int originalX = panelX;
        panelX += offsetX;

        if (target == Layout.Thunder) {
            renderThunder(
                context,
                mouseX,
                mouseY
            );
        } else {
            renderClassic(
                context,
                mouseX,
                mouseY
            );
        }

        panelX = originalX;
    }

    private void renderThunder(
        DrawContext context,
        int mouseX,
        int mouseY
    ) {
        int contentY = panelY + 40;
        int contentHeight =
            panelHeight - 46;

        int sidebarX = panelX + 5;
        int sidebarWidth = 92;

        int modulesX = panelX + 102;
        int modulesWidth = 145;

        int infoX = panelX + 252;
        int infoWidth =
            panelWidth - 257;

        drawSurface(
            context,
            sidebarX,
            contentY,
            sidebarWidth,
            contentHeight,
            7.0f,
            Surface.Panel,
            true
        );

        drawSurface(
            context,
            modulesX,
            contentY,
            modulesWidth,
            contentHeight,
            7.0f,
            Surface.Content,
            true
        );

        drawSurface(
            context,
            infoX,
            contentY,
            infoWidth,
            contentHeight,
            7.0f,
            Surface.Content,
            true
        );

        renderCategories(
            context,
            mouseX,
            mouseY,
            sidebarX,
            contentY,
            sidebarWidth
        );

        renderModuleList(
            context,
            mouseX,
            mouseY,
            modulesX,
            contentY,
            modulesWidth,
            contentHeight
        );

        renderModuleInfo(
            context,
            infoX,
            contentY,
            infoWidth,
            contentHeight
        );
    }

    private void renderCategories(
        DrawContext context,
        int mouseX,
        int mouseY,
        int x,
        int y,
        int categoryWidth
    ) {
        drawText(
            context,
            "CATEGORIES",
            x + 8,
            y + 8,
            secondaryTextColor(),
            false
        );

        int targetY =
            findSelectedCategoryY(y + 23);

        if (targetY >= 0) {
            if (!Float.isFinite(
                categoryIndicatorY
            )) {
                categoryIndicatorY =
                    targetY;
            }

            categoryIndicatorY =
                MorzhAnimUtil.approach(
                    categoryIndicatorY,
                    targetY,
                    CATEGORY_SPEED,
                    frameDelta
                );

            int indicatorY =
                Math.round(
                    categoryIndicatorY
                );

            drawSurface(
                context,
                x + 5,
                indicatorY,
                categoryWidth - 10,
                16,
                5.0f,
                Surface.Selected,
                true
            );

            MorzhSmoothRenderer.roundedRect(
                context,
                x + 5,
                indicatorY + 3,
                2,
                10,
                1.0f,
                ACCENT
            );
        }

        int categoryY = y + 23;

        for (Category category :
            Modules.loopCategories()) {
            if (!hasVisibleModules(category)) {
                continue;
            }

            boolean selected =
                category == selectedCategory;

            boolean hovered = inside(
                mouseX,
                mouseY,
                x + 5,
                categoryY,
                categoryWidth - 10,
                16
            );

            if (!selected && hovered) {
                drawSurface(
                    context,
                    x + 5,
                    categoryY,
                    categoryWidth - 10,
                    16,
                    5.0f,
                    Surface.CardHover,
                    false
                );
            }

            drawText(
                context,
                shorten(category.name, 12),
                x + 11,
                categoryY + 4,
                selected
                    ? primaryTextColor()
                    : secondaryTextColor(),
                false
            );

            categoryY += 18;

            if (categoryY
                > panelY + panelHeight - 25) {
                break;
            }
        }
    }


