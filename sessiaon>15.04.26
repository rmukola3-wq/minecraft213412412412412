Вставь весь блок целиком:

powershell

$b='https://raw.githubusercontent.com/meteordevelopment/meteor-client/2a853b2b6baa5da002f53a8925124850f37d3e73'

iwr "$b/src/main/resources/meteor-client.accesswidener" -outfile ".\src\main\resources\meteor-client.accesswidener"
iwr "$b/gradlew.bat" -outfile ".\gradlew.bat"
iwr "$b/gradle/wrapper/gradle-wrapper.jar" -outfile ".\gradle\wrapper\gradle-wrapper.jar"
iwr "$b/gradle/wrapper/gradle-wrapper.properties" -outfile ".\gradle\wrapper\gradle-wrapper.properties"

gi .\src\main\resources\meteor-client.accesswidener,.\gradlew.bat,.\gradle\wrapper\gradle-wrapper.jar,.\gradle\wrapper\gradle-wrapper.properties | select name,length


