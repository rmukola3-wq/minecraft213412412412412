            x + inset,
            y + 1,
            x + surfaceWidth - inset,
            y + 2,
            withAlpha(
                GLASS_HIGHLIGHT,
                highlightAlpha
            )
        );
    }

    int sideAlpha = Math.round(
        38.0f * glass
    );

    if (surfaceHeight > inset * 2) {
        context.fill(
            x + 1,
            y + inset,
            x + 2,
            y + surfaceHeight - inset,
            withAlpha(
                GLASS_HIGHLIGHT,
                sideAlpha
            )
        );
    }

    int lowerShadeAlpha = Math.round(
        45.0f * glass
    );

    if (surfaceWidth > inset * 2) {
        context.fill(
            x + inset,
            y + surfaceHeight - 2,
            x + surfaceWidth - inset,
            y + surfaceHeight - 1,
            lowerShadeAlpha << 24
        );
    }
}

private static boolean inside(
    double mouseX,
    double mouseY,
    double x,
    double y,
    double targetWidth,
    double targetHeight
) {
    return mouseX >= x
        && mouseX <= x + targetWidth
        && mouseY >= y
        && mouseY <= y + targetHeight;
}

private static void roundedRect(
    DrawContext context,
    int x,
    int y,
    int rectWidth,
    int rectHeight,
    int radius,
    int color
) {
    if (rectWidth <= 0 || rectHeight <= 0) {
        return;
    }

    radius = Math.min(
        radius,
        Math.min(rectWidth / 2, rectHeight / 2)
    );

    context.fill(
        x + radius,
        y,
        x + rectWidth - radius,
        y + rectHeight,
        color
    );

    context.fill(
        x,
        y + radius,
        x + rectWidth,
        y + rectHeight - radius,
        color
    );

    for (int i = 0; i < radius; i++) {
        int inset = radius - i;

        context.fill(
            x + inset,
            y + i,
            x + rectWidth - inset,
            y + i + 1,
            color
        );

        context.fill(
            x + inset,
            y + rectHeight - i - 1,
            x + rectWidth - inset,
            y + rectHeight - i,
            color
        );
    }
}

private static int withAlpha(
    int color,
    int alpha
) {
    return color & 0x00FFFFFF
        | MathHelper.clamp(alpha, 0, 255) << 24;
}

private static int blend(
    int first,
    int second,
    float progress
) {
    progress = MorzhAnimUtil.clamp01(progress);

    int a1 = first >>> 24;
    int r1 = first >> 16 & 255;
    int g1 = first >> 8 & 255;
    int b1 = first & 255;

    int a2 = second >>> 24;
    int r2 = second >> 16 & 255;
    int g2 = second >> 8 & 255;
    int b2 = second & 255;

    int a = Math.round(
        a1 + (a2 - a1) * progress
    );

    int r = Math.round(
        r1 + (r2 - r1) * progress
    );

    int g = Math.round(
        g1 + (g2 - g1) * progress
    );

    int b = Math.round(
        b1 + (b2 - b1) * progress
    );

    return a << 24 | r << 16 | g << 8 | b;
}

private static String shorten(
    String value,
    int maxLength
) {
    if (value == null) return "";
    if (value.length() <= maxLength) return value;

    return value.substring(
        0,
        Math.max(0, maxLength - 3)
    ) + "...";
}

private static List<String> wrap(
    String value,
    int maxLength
) {
    List<String> lines = new ArrayList<>();

    if (value == null || value.isBlank()) {
        lines.add("No description.");
        return lines;
    }

    StringBuilder line = new StringBuilder();

    for (String word : value.split("\\s+")) {
        if (line.length() > 0
            && line.length()
            + word.length()
            + 1
            > maxLength) {
            lines.add(line.toString());
            line.setLength(0);
        }

        if (line.length() > 0) {
            line.append(' ');
        }

        line.append(word);
    }

    if (!line.isEmpty()) {
        lines.add(line.toString());
    }

    return lines;
}

private enum Layout {
    Thunder,
    Classic
}

private enum VisualStyle {
    Solid,
    Glass
}


