Файл: src/main/java/meteordevelopment/meteorclient/gui/morzh/MorzhSmoothRenderer.java

java

package meteordevelopment.meteorclient.gui.morzh;

import com.mojang.blaze3d.systems.RenderSystem;
import net.minecraft.client.gui.DrawContext;
import net.minecraft.client.render.BufferBuilder;
import net.minecraft.client.render.BufferRenderer;
import net.minecraft.client.render.GameRenderer;
import net.minecraft.client.render.Tessellator;
import net.minecraft.client.render.VertexFormat;
import net.minecraft.client.render.VertexFormats;
import org.joml.Matrix4f;

public final class MorzhSmoothRenderer {
    private static final int CORNER_SEGMENTS = 12;
    private static final float FEATHER = 0.85f;

    private MorzhSmoothRenderer() {
    }

    public static void roundedRect(
        DrawContext context,
        float x,
        float y,
        float width,
        float height,
        float radius,
        int color
    ) {
        if (width <= 0.0f || height <= 0.0f) return;

        radius = Math.max(
            0.0f,
            Math.min(
                radius,
                Math.min(width, height) * 0.5f
            )
        );

        Matrix4f matrix =
            context.getMatrices()
                .peek()
                .getPositionMatrix();

        float red = (color >> 16 & 255) / 255.0f;
        float green = (color >> 8 & 255) / 255.0f;
        float blue = (color & 255) / 255.0f;
        float alpha = (color >>> 24) / 255.0f;

        RenderSystem.enableBlend();
        RenderSystem.defaultBlendFunc();
        RenderSystem.setShaderColor(1, 1, 1, 1);
        RenderSystem.setShader(
            GameRenderer::getPositionColorProgram
        );

        BufferBuilder fill =
            Tessellator.getInstance().begin(
                VertexFormat.DrawMode.TRIANGLE_FAN,
                VertexFormats.POSITION_COLOR
            );

        fill.vertex(
            matrix,
            x + width * 0.5f,
            y + height * 0.5f,
            0.0f
        ).color(red, green, blue, alpha);

        emitPerimeter(
            fill,
            matrix,
            x,
            y,
            width,
            height,
            radius,
            red,
            green,
            blue,
            alpha
        );

        BufferRenderer.drawWithGlobalProgram(fill.end());

        if (alpha > 0.0f && radius > 0.0f) {
            BufferBuilder feather =
                Tessellator.getInstance().begin(
                    VertexFormat.DrawMode.TRIANGLE_STRIP,
                    VertexFormats.POSITION_COLOR
                );

            emitFeather(
                feather,
                matrix,
                x,
                y,
                width,
                height,
                radius,
                red,
                green,
                blue,
                alpha
            );

            BufferRenderer.drawWithGlobalProgram(
                feather.end()
            );
        }

        RenderSystem.defaultBlendFunc();
        RenderSystem.disableBlend();
        RenderSystem.setShaderColor(1, 1, 1, 1);
    }

    private static void emitPerimeter(
        BufferBuilder buffer,
        Matrix4f matrix,
        float x,
        float y,
        float width,
        float height,
        float radius,
        float red,
        float green,
        float blue,
        float alpha
    ) {
        for (int corner = 0; corner < 4; corner++) {
            for (int step = 0;
                 step <= CORNER_SEGMENTS;
                 step++) {
                float angle = angle(corner, step);
                float centerX = centerX(
                    corner,
                    x,
                    width,
                    radius
                );

                float centerY = centerY(
                    corner,
                    y,
                    height,
                    radius
                );

                float px = centerX
                    + (float) Math.cos(angle) * radius;

                float py = centerY
                    + (float) Math.sin(angle) * radius;

                buffer.vertex(matrix, px, py, 0.0f)
                    .color(red, green, blue, alpha);
            }
        }

        float angle = angle(0, 0);

        buffer.vertex(
            matrix,
            centerX(0, x, width, radius)
                + (float) Math.cos(angle) * radius,
            centerY(0, y, height, radius)
                + (float) Math.sin(angle) * radius,
            0.0f
        ).color(red, green, blue, alpha);
    }

    private static void emitFeather(
        BufferBuilder buffer,
        Matrix4f matrix,
        float x,
        float y,
        float width,
        float height,
        float radius,
        float red,
        float green,
        float blue,
        float alpha
    ) {
        for (int corner = 0; corner < 4; corner++) {
            for (int step = 0;
                 step <= CORNER_SEGMENTS;
                 step++) {
                emitFeatherPoint(
                    buffer,
                    matrix,
                    corner,
                    step,
                    x,
                    y,
                    width,
                    height,
                    radius,
                    red,
                    green,
                    blue,
                    alpha
                );
            }
        }

        emitFeatherPoint(
            buffer,
            matrix,
            0,
            0,
            x,
            y,
            width,
            height,
            radius,
            red,
            green,
            blue,
            alpha
        );
    }

    private static void emitFeatherPoint(
        BufferBuilder buffer,
        Matrix4f matrix,
        int corner,
        int step,
        float x,
        float y,
        float width,
        float height,
        float radius,
        float red,
        float green,
        float blue,
        float alpha
    ) {
        float angle = angle(corner, step);
        float cos = (float) Math.cos(angle);
        float sin = (float) Math.sin(angle);

        float cx = centerX(
            corner,
            x,
            width,
            radius
        );

        float cy = centerY(
            corner,
            y,
            height,
            radius
        );

        buffer.vertex(
            matrix,
            cx + cos * radius,
            cy + sin * radius,
            0.0f
        ).color(red, green, blue, alpha);

        buffer.vertex(
            matrix,
            cx + cos * (radius + FEATHER),
            cy + sin * (radius + FEATHER),
            0.0f
        ).color(red, green, blue, 0.0f);
    }

    private static float angle(
        int corner,
        int step
    ) {
        float start = switch (corner) {
            case 0 -> 180.0f;
            case 1 -> 270.0f;
            case 2 -> 0.0f;
            default -> 90.0f;
        };

        float degrees =
            start + 90.0f
                * step / CORNER_SEGMENTS;

        return (float) Math.toRadians(degrees);
    }

    private static float centerX(
        int corner,
        float x,
        float width,
        float radius
    ) {
        return switch (corner) {
            case 0, 3 -> x + radius;
            default -> x + width - radius;
        };
    }

    private static float centerY(
        int corner,
        float y,
        float height,
        float radius
    ) {
        return switch (corner) {
            case 0, 1 -> y + radius;
            default -> y + height - radius;
        };
    }
}


Файл: src/main/java/meteordevelopment/meteorclient/gui/morzh/MorzhFontRenderer.java

java

package meteordevelopment.meteorclient.gui.morzh;

import meteordevelopment.meteorclient.renderer.Fonts;
import meteordevelopment.meteorclient.renderer.text.TextRenderer;
import meteordevelopment.meteorclient.utils.render.color.Color;
import net.minecraft.client.gui.DrawContext;

public final class MorzhFontRenderer {
    private static final double SCALE = 0.5;

    private MorzhFontRenderer() {
    }

    public static void draw(
        DrawContext context,
        String text,
        double x,
        double y,
        int packedColor,
        boolean shadow
    ) {
        if (text == null || text.isEmpty()) return;

        TextRenderer renderer = Fonts.RENDERER;

        if (renderer == null) return;

        Color color = new Color(
            packedColor >> 16 & 255,
            packedColor >> 8 & 255,
            packedColor & 255,
            packedColor >>> 24
        );

        renderer.begin(SCALE);

        renderer.render(
            text,
            x,
            y,
            color,
            shadow
        );

        renderer.end(context.getMatrices());
    }

    public static double width(String text) {
        if (text == null || text.isEmpty()) return 0;

        TextRenderer renderer = Fonts.RENDERER;
        if (renderer == null) return 0;

        renderer.begin(SCALE);
        double width = renderer.getWidth(text);
        renderer.end();

        return width;
    }
}


Файл: src/main/java/meteordevelopment/meteorclient/gui/morzh/MorzhGlassRenderer.java

java

package meteordevelopment.meteorclient.gui.morzh;

import com.mojang.blaze3d.systems.RenderSystem;
import net.minecraft.client.MinecraftClient;
import net.minecraft.client.gl.Framebuffer;
import net.minecraft.client.gl.SimpleFramebuffer;
import net.minecraft.client.gui.DrawContext;
import net.minecraft.client.render.BufferBuilder;
import net.minecraft.client.render.BufferRenderer;
import net.minecraft.client.render.GameRenderer;
import net.minecraft.client.render.Tessellator;
import net.minecraft.client.render.VertexFormat;
import net.minecraft.client.render.VertexFormats;
import org.joml.Matrix4f;
import org.lwjgl.opengl.GL11;
import org.lwjgl.opengl.GL30;

public final class MorzhGlassRenderer {
    private static final int CORNER_SEGMENTS = 16;

    private static SimpleFramebuffer halfPass;
    private static SimpleFramebuffer quarterPass;

    private MorzhGlassRenderer() {
    }

    public static void draw(
        DrawContext context,
        float x,
        float y,
        float width,
        float height,
        float radius
    ) {
        MinecraftClient client =
            MinecraftClient.getInstance();

        if (client == null
            || client.getFramebuffer() == null
            || width <= 0
            || height <= 0) {
            return;
        }

        RenderSystem.assertOnRenderThread();

        Framebuffer main = client.getFramebuffer();

        int framebufferWidth = main.textureWidth;
        int framebufferHeight = main.textureHeight;

        int halfWidth = Math.max(
            1,
            framebufferWidth / 2
        );

        int halfHeight = Math.max(
            1,
            framebufferHeight / 2
        );

        int quarterWidth = Math.max(
            1,
            framebufferWidth / 4
        );

        int quarterHeight = Math.max(
            1,
            framebufferHeight / 4
        );

        ensureFramebuffers(
            halfWidth,
            halfHeight,
            quarterWidth,
            quarterHeight
        );

        blit(
            main,
            halfPass,
            framebufferWidth,
            framebufferHeight,
            halfWidth,
            halfHeight
        );

        blit(
            halfPass,
            quarterPass,
            halfWidth,
            halfHeight,
            quarterWidth,
            quarterHeight
        );

        /*
         * Обратный проход в halfPass делает размытие мягче,
         * но сохраняет детализацию — больше нет пикселей 1/8.
         */
        blit(
            quarterPass,
            halfPass,
            quarterWidth,
            quarterHeight,
            halfWidth,
            halfHeight
        );

        main.beginWrite(true);

        drawRoundedTexture(
            context,
            halfPass,
            x,
            y,
            width,
            height,
            radius,
            client.getWindow().getScaledWidth(),
            client.getWindow().getScaledHeight()
        );

        main.beginWrite(true);
    }

    private static void drawRoundedTexture(
        DrawContext context,
        Framebuffer framebuffer,
        float x,
        float y,
        float width,
        float height,
        float radius,
        int scaledWidth,
        int scaledHeight
    ) {
        radius = Math.max(
            0,
            Math.min(
                radius,
                Math.min(width, height) * 0.5f
            )
        );

        Matrix4f matrix =
            context.getMatrices()
                .peek()
                .getPositionMatrix();

        framebuffer.beginRead();

        RenderSystem.enableBlend();
        RenderSystem.defaultBlendFunc();
        RenderSystem.disableDepthTest();
        RenderSystem.setShaderColor(1, 1, 1, 1);
        RenderSystem.setShaderTexture(
            0,
            framebuffer.getColorAttachment()
        );

        RenderSystem.setShader(
            GameRenderer::getPositionTexProgram
        );

        BufferBuilder buffer =
            Tessellator.getInstance().begin(
                VertexFormat.DrawMode.TRIANGLE_FAN,
                VertexFormats.POSITION_TEXTURE
            );

        emitVertex(
            buffer,
            matrix,
            x + width * 0.5f,
            y + height * 0.5f,
            scaledWidth,
            scaledHeight
        );

        for (int corner = 0;
             corner < 4;
             corner++) {
            for (int step = 0;
                 step <= CORNER_SEGMENTS;
                 step++) {
                float angle =
                    cornerAngle(corner, step);

                float centerX =
                    corner == 0 || corner == 3
                        ? x + radius
                        : x + width - radius;

                float centerY =
                    corner == 0 || corner == 1
                        ? y + radius
                        : y + height - radius;

                float px = centerX
                    + (float) Math.cos(angle)
                    * radius;

                float py = centerY
                    + (float) Math.sin(angle)
                    * radius;

                emitVertex(
                    buffer,
                    matrix,
                    px,
                    py,
                    scaledWidth,
                    scaledHeight
                );
            }
        }

        emitVertex(
            buffer,
            matrix,
            x,
            y + radius,
            scaledWidth,
            scaledHeight
        );

        BufferRenderer.drawWithGlobalProgram(
            buffer.end()
        );

        framebuffer.endRead();

        RenderSystem.setShaderColor(1, 1, 1, 1);
        RenderSystem.enableDepthTest();
        RenderSystem.defaultBlendFunc();
        RenderSystem.disableBlend();
    }

    private static void emitVertex(
        BufferBuilder buffer,
        Matrix4f matrix,
        float x,
        float y,
        int scaledWidth,
        int scaledHeight
    ) {
        float u = x / Math.max(1.0f, scaledWidth);
        float v = 1.0f
            - y / Math.max(1.0f, scaledHeight);

        buffer.vertex(matrix, x, y, 0.0f)
            .texture(u, v);
    }

    private static float cornerAngle(
        int corner,
        int step
    ) {
        float start = switch (corner) {
            case 0 -> 180.0f;
            case 1 -> 270.0f;
            case 2 -> 0.0f;
            default -> 90.0f;
        };

        return (float) Math.toRadians(
            start
                + 90.0f
                * step
                / CORNER_SEGMENTS
        );
    }

    private static void ensureFramebuffers(
        int halfWidth,
        int halfHeight,
        int quarterWidth,
        int quarterHeight
    ) {
        if (halfPass == null) {
            halfPass = create(
                halfWidth,
                halfHeight
            );
        } else if (
            halfPass.textureWidth != halfWidth
                || halfPass.textureHeight != halfHeight
        ) {
            halfPass.resize(
                halfWidth,
                halfHeight,
                MinecraftClient.IS_SYSTEM_MAC
            );

            setLinearFiltering(halfPass);
        }

        if (quarterPass == null) {
            quarterPass = create(
                quarterWidth,
                quarterHeight
            );
        } else if (
            quarterPass.textureWidth != quarterWidth
                || quarterPass.textureHeight != quarterHeight
        ) {
            quarterPass.resize(
                quarterWidth,
                quarterHeight,
                MinecraftClient.IS_SYSTEM_MAC
            );

            setLinearFiltering(quarterPass);
        }
    }

    private static SimpleFramebuffer create(
        int width,
        int height
    ) {
        SimpleFramebuffer framebuffer =
            new SimpleFramebuffer(
                width,
                height,
                false,
                MinecraftClient.IS_SYSTEM_MAC
            );

        setLinearFiltering(framebuffer);

        return framebuffer;
    }

    private static void setLinearFiltering(
        Framebuffer framebuffer
    ) {
        framebuffer.beginRead();

        GL11.glTexParameteri(
            GL11.GL_TEXTURE_2D,
            GL11.GL_TEXTURE_MIN_FILTER,
            GL11.GL_LINEAR
        );

        GL11.glTexParameteri(
            GL11.GL_TEXTURE_2D,
            GL11.GL_TEXTURE_MAG_FILTER,
            GL11.GL_LINEAR
        );

        framebuffer.endRead();
    }

    private static void blit(
        Framebuffer source,
        Framebuffer destination,
        int sourceWidth,
        int sourceHeight,
        int destinationWidth,
        int destinationHeight
    ) {
        GL30.glBindFramebuffer(
            GL30.GL_READ_FRAMEBUFFER,
            source.fbo
        );

        GL30.glBindFramebuffer(
            GL30.GL_DRAW_FRAMEBUFFER,
            destination.fbo
        );

        GL30.glBlitFramebuffer(
            0,
            0,
            sourceWidth,
            sourceHeight,
            0,
            0,
            destinationWidth,
            destinationHeight,
            GL30.GL_COLOR_BUFFER_BIT,
            GL30.GL_LINEAR
        );
    }

    public static void close() {
        if (halfPass != null) {
            halfPass.delete();
            halfPass = null;
        }

        if (quarterPass != null) {
            quarterPass.delete();
            quarterPass = null;
        }
    }
}


