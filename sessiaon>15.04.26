Полностью замени файл:

launch/src/main/java/meteordevelopment/meteorclient/Main.java

java

/*
 * This file is part of the Meteor Client distribution.
 * Copyright (c) Meteor Development.
 */

package meteordevelopment.meteorclient;

import javax.swing.JOptionPane;
import javax.swing.UIManager;
import java.awt.Desktop;
import java.io.File;
import java.net.URI;
import java.util.Locale;

public final class Main {
    private Main() {
    }

    public static void main(String[] args) {
        try {
            UIManager.setLookAndFeel(
                UIManager.getSystemLookAndFeelClassName()
            );
        } catch (Exception ignored) {
        }

        String[] options = {
            "Open Wiki",
            "Open Mods Folder"
        };

        int selected = JOptionPane.showOptionDialog(
            null,
            "Place Morzh Client in your mods folder and run Fabric for Minecraft.",
            "Morzh Client",
            JOptionPane.YES_NO_OPTION,
            JOptionPane.INFORMATION_MESSAGE,
            null,
            options,
            options[0]
        );

        if (selected == 0) {
            openUri(
                URI.create(
                    "https://meteorclient.com/faq/installation"
                )
            );
        } else if (selected == 1) {
            File modsFolder = getModsFolder();

            if (!modsFolder.exists()) {
                modsFolder.mkdirs();
            }

            openFile(modsFolder);
        }
    }

    private static File getModsFolder() {
        String home = System.getProperty("user.home");
        String os = System.getProperty("os.name")
            .toLowerCase(Locale.ROOT);

        if (os.contains("win")) {
            String appData = System.getenv("AppData");

            if (appData != null) {
                return new File(
                    appData,
                    ".minecraft/mods"
                );
            }
        }

        if (os.contains("mac")) {
            return new File(
                home,
                "Library/Application Support/minecraft/mods"
            );
        }

        return new File(
            home,
            ".minecraft/mods"
        );
    }

    private static void openUri(URI uri) {
        try {
            if (Desktop.isDesktopSupported()) {
                Desktop.getDesktop().browse(uri);
            }
        } catch (Exception ignored) {
        }
    }

    private static void openFile(File file) {
        try {
            if (Desktop.isDesktopSupported()) {
                Desktop.getDesktop().open(file);
            }
        } catch (Exception ignored) {
        }
    }
}


