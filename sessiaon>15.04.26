Добавляем отдельный режим Glass, сохраняя Solid. Кнопка Glass появится рядом с Thunder/Classic. Стекло реализовано без blur-шейдера: прозрачные поверхности, глянцевые блики, светлый контур и контрастный текст.

Полностью замени файл:

src\main\java\meteordevelopment\meteorclient\gui\morzh\MorzhThunderScreen.java

java

/*
 * Morzh Client GUI.
 *
 * ThunderHack-inspired Dashboard and Classic layouts.
 * Interaction ideas inspired by Rockstar Client.
 *
 * Glass visual behavior independently implemented after studying
 * Rasty Client's MIT-declared glass UI.
 */

package meteordevelopment.meteorclient.gui.screens.morzh;

import meteordevelopment.meteorclient.gui.GuiThemes;
import meteordevelopment.meteorclient.gui.morzh.MorzhAnimUtil;
import meteordevelopment.meteorclient.systems.config.Config;
import meteordevelopment.meteorclient.systems.modules.Category;
import meteordevelopment.meteorclient.systems.modules.Module;
import meteordevelopment.meteorclient.systems.modules.Modules;
import meteordevelopment.meteorclient.utils.sound.MorzhSoundManager;
import net.minecraft.client.gui.DrawContext;
import net.minecraft.client.gui.screen.Screen;
import net.minecraft.text.Text;
import net.minecraft.util.math.MathHelper;
import org.lwjgl.glfw.GLFW;

import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Locale;
import java.util.Map;

public class MorzhThunderScreen extends Screen {
    private static final int BACKGROUND = 0xFF18141E;
    private static final int PANEL = 0xFF211B29;
    private static final int CONTENT = 0xFF251D2D;
    private static final int CARD = 0xFF302638;
    private static final int CARD_HOVER = 0xFF40314A;

    private static final int ACCENT = 0xFF9A5CE0;
    private static final int ACCENT_DARK = 0xFF684093;

    private static final int TEXT = 0xFFF3ECFA;
    private static final int TEXT_SECONDARY = 0xFFA89CAE;
    private static final int GREEN = 0xFF72D69B;
    private static final int RED = 0xFFE06C75;

    /*
     * Shader-free liquid-glass palette.
     * Text is rendered after every glass surface.
     */
    private static final int GLASS_BACKGROUND = 0xB0181322;
    private static final int GLASS_PANEL = 0x982A2135;
    private static final int GLASS_CONTENT = 0x8C211A2C;
    private static final int GLASS_CARD = 0x783A2E46;
    private static final int GLASS_CARD_HOVER = 0xB0544264;
    private static final int GLASS_SELECTED = 0xB05F3F84;

    private static final int GLASS_EDGE = 0x70FFFFFF;
    private static final int GLASS_EDGE_PURPLE = 0x909A5CE0;
    private static final int GLASS_HIGHLIGHT = 0x55FFFFFF;
    private static final int GLASS_SHADOW = 0x70000000;

    private static final int GLASS_TEXT = 0xFFFFFFFF;
    private static final int GLASS_TEXT_SECONDARY = 0xFFE4D9EC;

    private static final float OPEN_SPEED = 14.0f;
    private static final float CLOSE_SPEED = 18.0f;
    private static final float HOVER_SPEED = 14.0f;
    private static final float TOGGLE_SPEED = 11.0f;
    private static final float SCROLL_SPEED = 14.0f;
    private static final float LAYOUT_SPEED = 12.0f;
    private static final float CATEGORY_SPEED = 16.0f;
    private static final float GLASS_SPEED = 10.0f;

    private static VisualStyle savedVisualStyle =
        VisualStyle.Solid;

    private final Map<Module, Float> hoverAnimations =
        new HashMap<>();

    private final Map<Module, Float> toggleAnimations =
        new HashMap<>();

    private Layout layout = Layout.Thunder;
    private Layout previousLayout = Layout.Thunder;

    private VisualStyle visualStyle = savedVisualStyle;

    private Category selectedCategory;
    private Module selectedModule;
    private Module hoveredModule;

    private int panelX;
    private int panelY;
    private int panelWidth;
    private int panelHeight;

    private int dragOffsetX;
    private int dragOffsetY;

    private boolean positioned;
    private boolean dragging;
    private boolean searching;
    private boolean closing;

    private float frameDelta = 1.0f / 60.0f;
    private float animation;
    private float layoutTransition = 1.0f;
    private float moduleListAnimation = 1.0f;
    private float glassTransition;

    private float moduleScroll;
    private float moduleTargetScroll;

    private float classicScroll;
    private float classicTargetScroll;

    private float categoryIndicatorY = Float.NaN;

    private float thunderTabHover;
    private float classicTabHover;
    private float glassButtonHover;
    private float searchHover;

    private String search = "";

    public MorzhThunderScreen() {
        super(Text.literal("Morzh Client"));
    }

    @Override
    protected void init() {
        panelWidth = Math.min(440, width - 12);
        panelHeight = Math.min(245, height - 12);

        if (!positioned) {
            panelX = (width - panelWidth) / 2;
            panelY = (height - panelHeight) / 2;
            positioned = true;
        } else {
            clampPanelPosition();
        }

        if (selectedCategory == null) {
            for (Category category : Modules.loopCategories()) {
                if (hasVisibleModules(category)) {
                    selectedCategory = category;
                    break;
                }
            }
        }

        animation = 0.0f;
        closing = false;
        dragging = false;

        previousLayout = layout;
        layoutTransition = 1.0f;

        glassTransition =
            visualStyle == VisualStyle.Glass
                ? 1.0f
                : 0.0f;

        MorzhSoundManager.playOpen();
    }

    @Override
    public boolean shouldPause() {
        return false;
    }

    @Override
    public void render(
        DrawContext context,
        int mouseX,
        int mouseY,
        float delta
    ) {
        frameDelta = MorzhAnimUtil.beginFrame();

        updateDragging(mouseX, mouseY);
        updateAnimations();

        if (closing && animation <= 0.008f) {
            if (client != null) {
                client.setScreen(null);
            }

            return;
        }

        float easedOpen =
            MorzhAnimUtil.easeOutQuart(animation);

        int maximumDim =
            visualStyle == VisualStyle.Glass
                ? 120
                : 176;

        int dimAlpha = Math.round(
            maximumDim * easedOpen
        );

        context.fill(
            0,
            0,
            width,
            height,
            dimAlpha << 24
        );

        int originalPanelY = panelY;

        int slideOffset = Math.round(
            (1.0f - easedOpen) * 12.0f
        );

        panelY = originalPanelY + slideOffset;

        int revealHeight = Math.max(
            1,
            Math.round(panelHeight * easedOpen)
        );

        int revealTop =
            panelY + (panelHeight - revealHeight) / 2;

        context.enableScissor(
            panelX,
            revealTop,
            panelX + panelWidth,
            revealTop + revealHeight
        );

        renderGui(context, mouseX, mouseY);

        context.disableScissor();

        panelY = originalPanelY;

        super.render(context, mouseX, mouseY, delta);
    }

    private void updateAnimations() {
        float openTarget = closing ? 0.0f : 1.0f;

        animation = MorzhAnimUtil.approach(
            animation,
            openTarget,
            closing ? CLOSE_SPEED : OPEN_SPEED,
            frameDelta
        );

        if (!closing && animation >= 0.999f) {
            animation = 1.0f;
        }

        if (closing && animation <= 0.008f) {
            animation = 0.0f;
        }

        layoutTransition = MorzhAnimUtil.approach(
            layoutTransition,
            1.0f,
            LAYOUT_SPEED,
            frameDelta
        );

        if (layoutTransition >= 0.998f) {
            layoutTransition = 1.0f;
            previousLayout = layout;
        }

        moduleListAnimation = MorzhAnimUtil.approach(
            moduleListAnimation,
            1.0f,
            LAYOUT_SPEED,
            frameDelta
        );

        if (moduleListAnimation >= 0.998f) {
            moduleListAnimation = 1.0f;
        }

        glassTransition = MorzhAnimUtil.approach(
            glassTransition,
            visualStyle == VisualStyle.Glass
                ? 1.0f
                : 0.0f,
            GLASS_SPEED,
            frameDelta
        );

        if (glassTransition >= 0.998f) {
            glassTransition = 1.0f;
        }

        if (glassTransition <= 0.002f) {
            glassTransition = 0.0f;
        }
    }

    private void updateDragging(int mouseX, int mouseY) {
        if (!dragging) return;

        panelX = mouseX - dragOffsetX;
        panelY = mouseY - dragOffsetY;

        clampPanelPosition();
    }

    private void clampPanelPosition() {
        panelX = MathHelper.clamp(
            panelX,
            -panelWidth + 60,
            width - 60
        );

        panelY = MathHelper.clamp(
            panelY,
            0,
            Math.max(0, height - 25)
        );

        int snapDistance = 8;

        if (Math.abs(panelX) <= snapDistance) {
            panelX = 0;
        }

        if (Math.abs(panelY) <= snapDistance) {
            panelY = 0;
        }

        if (Math.abs(
            panelX + panelWidth - width
        ) <= snapDistance) {
            panelX = width - panelWidth;
        }

        if (Math.abs(
            panelY + panelHeight - height
        ) <= snapDistance) {
            panelY = height - panelHeight;
        }
    }

    private void renderGui(
        DrawContext context,
        int mouseX,
        int mouseY
    ) {
        hoveredModule = null;

        drawSurface(
            context,
            panelX,
            panelY,
            panelWidth,
            panelHeight,
            8,
            BACKGROUND,
            GLASS_BACKGROUND,
            true
        );

        renderHeader(context, mouseX, mouseY);
        renderLayoutContent(context, mouseX, mouseY);

        if (hoveredModule != null
            && hoveredModule.description != null
            && !hoveredModule.description.isBlank()) {
            drawText(
                context,
                shorten(hoveredModule.description, 58),
                panelX + 10,
                panelY + panelHeight - 12,
                secondaryTextColor(),
                false
            );
        }
    }

    private void renderLayoutContent(
        DrawContext context,
        int mouseX,
        int mouseY
    ) {
        if (layoutTransition >= 1.0f) {
            renderLayout(
                context,
                layout,
                mouseX,
                mouseY,
                0
            );

            return;
        }

        float eased = MorzhAnimUtil.easeInOutCubic(
            layoutTransition
        );

        int direction =
            layout == Layout.Classic ? 1 : -1;

        int outgoingOffset = Math.round(
            -direction * eased * panelWidth
        );

        int incomingOffset = Math.round(
            direction
                * (1.0f - eased)
                * panelWidth
        );

        context.enableScissor(
            panelX + 5,
            panelY + 39,
            panelX + panelWidth - 5,
            panelY + panelHeight - 5
        );

        renderLayout(
            context,
            previousLayout,
            Integer.MIN_VALUE / 4,
            Integer.MIN_VALUE / 4,
            outgoingOffset
        );

        renderLayout(
            context,
            layout,
            Integer.MIN_VALUE / 4,
            Integer.MIN_VALUE / 4,
            incomingOffset
        );

        context.disableScissor();
    }

    private void renderLayout(
        DrawContext context,
        Layout targetLayout,
        int mouseX,
        int mouseY,
        int offsetX
    ) {
        int originalPanelX = panelX;
        panelX += offsetX;

        if (targetLayout == Layout.Thunder) {
            renderThunder(context, mouseX, mouseY);
        } else {
            renderClassic(context, mouseX, mouseY);
        }

        panelX = originalPanelX;
    }

    private void renderHeader(
        DrawContext context,
        int mouseX,
        int mouseY
    ) {
        drawSurface(
            context,
            panelX + 5,
            panelY + 5,
            panelWidth - 10,
            30,
            6,
            PANEL,
            GLASS_PANEL,
            true
        );

        context.fill(
            panelX + 7,
            panelY + 33,
            panelX + panelWidth - 7,
            panelY + 34,
            blend(
                ACCENT_DARK,
                GLASS_EDGE_PURPLE,
                glassTransition
            )
        );

        drawText(
            context,
            "MORZH",
            panelX + 13,
            panelY + 12,
            primaryTextColor(),
            true
        );

        drawText(
            context,
            "CLIENT",
            panelX + 51,
            panelY + 12,
            ACCENT,
            true
        );

        boolean thunderHovered = inside(
            mouseX,
            mouseY,
            panelX + 95,
            panelY + 10,
            48,
            18
        );

        boolean classicHovered = inside(
            mouseX,
            mouseY,
            panelX + 147,
            panelY + 10,
            45,
            18
        );

        boolean glassHovered = inside(
            mouseX,
            mouseY,
            panelX + 196,
            panelY + 10,
            43,
            18
        );

        thunderTabHover = MorzhAnimUtil.approach(
            thunderTabHover,
            thunderHovered ? 1.0f : 0.0f,
            HOVER_SPEED,
            frameDelta
        );

        classicTabHover = MorzhAnimUtil.approach(
            classicTabHover,
            classicHovered ? 1.0f : 0.0f,
            HOVER_SPEED,
            frameDelta
        );

        glassButtonHover = MorzhAnimUtil.approach(
            glassButtonHover,
            glassHovered ? 1.0f : 0.0f,
            HOVER_SPEED,
            frameDelta
        );

        renderLayoutButton(
            context,
            "Thunder",
            panelX + 95,
            panelY + 10,
            48,
            layout == Layout.Thunder,
            thunderTabHover
        );

        renderLayoutButton(
            context,
            "Classic",
            panelX + 147,
            panelY + 10,
            45,
            layout == Layout.Classic,
            classicTabHover
        );

        renderGlassButton(
            context,
            panelX + 196,
            panelY + 10,
            43,
            glassButtonHover
        );

        if (layout == Layout.Thunder) {
            renderSearch(context, mouseX, mouseY);
        }
    }

    private void renderLayoutButton(
        DrawContext context,
        String label,
        int x,
        int y,
        int buttonWidth,
        boolean selected,
        float hover
    ) {
        int solidColor = selected
            ? ACCENT_DARK
            : blend(CARD, CARD_HOVER, hover);

        int glassColor = selected
            ? GLASS_SELECTED
            : blend(
                GLASS_CARD,
                GLASS_CARD_HOVER,
                hover
            );

        drawSurface(
            context,
            x,
            y,
            buttonWidth,
            18,
            4,
            solidColor,
            glassColor,
            false
        );

        if (selected) {
            int indicatorWidth = Math.max(
                2,
                Math.round(
                    buttonWidth
                        * MorzhAnimUtil.easeOutCubic(
                            layoutTransition
                        )
                )
            );

            context.fill(
                x + 2,
                y + 16,
                x + Math.max(2, indicatorWidth - 2),
                y + 18,
                ACCENT
            );
        }

        drawText(
            context,
            label,
            x + 5,
            y + 5,
            selected
                ? primaryTextColor()
                : secondaryTextColor(),
            false
        );
    }

    private void renderGlassButton(
        DrawContext context,
        int x,
        int y,
        int buttonWidth,
        float hover
    ) {
        boolean enabled =
            visualStyle == VisualStyle.Glass;

        int solidColor = enabled
            ? ACCENT_DARK
            : blend(CARD, CARD_HOVER, hover);

        int glassColor = enabled
            ? GLASS_SELECTED
            : blend(
                GLASS_CARD,
                GLASS_CARD_HOVER,
                hover
            );

        drawSurface(
            context,
            x,
            y,
            buttonWidth,
            18,
            4,
            solidColor,
            glassColor,
            enabled
        );

        if (enabled) {
            context.fill(
                x + 3,
                y + 2,
                x + buttonWidth - 3,
                y + 3,
                withAlpha(
                    GLASS_HIGHLIGHT,
                    145
                )
            );
        }

        drawText(
            context,
            "Glass",
            x + 5,
            y + 5,
            enabled
                ? primaryTextColor()
                : secondaryTextColor(),
            false
        );
    }

    private void renderSearch(
        DrawContext context,
        int mouseX,
        int mouseY
    ) {
        int searchWidth = Math.min(
            137,
            panelWidth / 3
        );

        int searchX =
            panelX + panelWidth - searchWidth - 12;

        int searchY = panelY + 11;

        boolean hovered = inside(
            mouseX,
            mouseY,
            searchX,
            searchY,
            searchWidth,
            17
        );

        searchHover = MorzhAnimUtil.approach(
            searchHover,
            searching || hovered ? 1.0f : 0.0f,
            HOVER_SPEED,
            frameDelta
        );

        drawSurface(
            context,
            searchX,
            searchY,
            searchWidth,
            17,
            4,
            blend(CARD, CARD_HOVER, searchHover),
            blend(
                GLASS_CARD,
                GLASS_CARD_HOVER,
                searchHover
            ),
            searching
        );

        if (searching) {
            int underlineWidth = Math.max(
                1,
                Math.round(searchWidth * searchHover)
            );

            context.fill(
                searchX + 2,
                searchY + 15,
                searchX + Math.max(
                    2,
                    underlineWidth - 2
                ),
                searchY + 17,
                ACCENT
            );
        }

        String shown;

        if (search.isEmpty()) {
            shown = searching
                ? "Type to search..."
                : "Search modules";
        } else {
            shown = search;
        }

        if (searching
            && (System.currentTimeMillis() / 450L)
                % 2L == 0L) {
            shown += "_";
        }

        drawText(
            context,
            shorten(shown, 19),
            searchX + 6,
            searchY + 5,
            search.isEmpty()
                ? secondaryTextColor()
                : primaryTextColor(),
            false
        );
    }

    private void renderThunder(
        DrawContext context,
        int mouseX,
        int mouseY
    ) {
        int contentY = panelY + 40;
        int contentHeight = panelHeight - 46;

        int sidebarX = panelX + 5;
        int sidebarWidth = 92;

        int modulesX = panelX + 102;
        int modulesWidth = 145;

        int infoX = panelX + 252;
        int infoWidth = panelWidth - 257;

        drawSurface(
            context,
            sidebarX,
            contentY,
            sidebarWidth,
            contentHeight,
            6,
            PANEL,
            GLASS_PANEL,
            true
        );

        drawSurface(
            context,
            modulesX,
            contentY,
            modulesWidth,
            contentHeight,
            6,
            CONTENT,
            GLASS_CONTENT,
            true
        );

        drawSurface(
            context,
            infoX,
            contentY,
            infoWidth,
            contentHeight,
            6,
            CONTENT,
            GLASS_CONTENT,
            true
        );

        renderCategories(
            context,
            mouseX,
            mouseY,
            sidebarX,
            contentY,
            sidebarWidth
        );

        renderModuleList(
            context,
            mouseX,
            mouseY,
            modulesX,
            contentY,
            modulesWidth,
            contentHeight
        );

        renderModuleInfo(
            context,
            infoX,
            contentY,
            infoWidth,
            contentHeight
        );
    }

    private void renderCategories(
        DrawContext context,
        int mouseX,
        int mouseY,
        int x,
        int y,
        int categoryWidth
    ) {
        drawText(
            context,
            "CATEGORIES",
            x + 8,
            y + 8,
            secondaryTextColor(),
            false
        );

        int targetY = findSelectedCategoryY(y + 23);

        if (targetY >= 0) {
            if (!Float.isFinite(categoryIndicatorY)) {
                categoryIndicatorY = targetY;
            }

            categoryIndicatorY = MorzhAnimUtil.approach(
                categoryIndicatorY,
                targetY,
                CATEGORY_SPEED,
                frameDelta
            );

            int indicatorY = Math.round(
                categoryIndicatorY
            );

            drawSurface(
                context,
                x + 5,
                indicatorY,
                categoryWidth - 10,
                16,
                3,
                ACCENT_DARK,
                GLASS_SELECTED,
                true
            );

            context.fill(
                x + 5,
                indicatorY + 3,
                x + 7,
                indicatorY + 13,
                ACCENT
            );
        }

        int categoryY = y + 23;

        for (Category category : Modules.loopCategories()) {
            if (!hasVisibleModules(category)) continue;

            boolean selected =
                category == selectedCategory;

            boolean hovered = inside(
                mouseX,
                mouseY,
                x + 5,
                categoryY,
                categoryWidth - 10,
                16
            );

            if (!selected && hovered) {
                drawSurface(
                    context,
                    x + 5,
                    categoryY,
                    categoryWidth - 10,
                    16,
                    3,
                    CARD_HOVER,
                    GLASS_CARD_HOVER,
                    false
                );
            }

            drawText(
                context,
                shorten(category.name, 12),
                x + 11,
                categoryY + 4,
                selected
                    ? primaryTextColor()
                    : secondaryTextColor(),
                false
            );

            categoryY += 18;

            if (categoryY
                > panelY + panelHeight - 25) {
                break;
            }
        }
    }

    private int findSelectedCategoryY(int startY) {
        int categoryY = startY;

        for (Category category : Modules.loopCategories()) {
            if (!hasVisibleModules(category)) continue;

            if (category == selectedCategory) {
                return categoryY;
            }

            categoryY += 18;
        }

        return -1;
    }

    private void renderModuleList(
        DrawContext context,
        int mouseX,
        int mouseY,
        int x,
        int y,
        int listWidth,
        int listHeight
    ) {
        List<Module> modules = getDisplayedModules();

        drawText(
            context,
            search.isEmpty()
                && selectedCategory != null
                ? selectedCategory.name.toUpperCase(
                    Locale.ROOT
                )
                : "SEARCH RESULTS",
            x + 8,
            y + 8,
            secondaryTextColor(),
            false
        );

        int listTop = y + 22;
        int listBottom = y + listHeight - 6;

        int totalHeight = modules.size() * 32;
        int visibleHeight = listBottom - listTop;

        float minimumScroll = Math.min(
            0,
            visibleHeight - totalHeight
        );

        moduleTargetScroll = MathHelper.clamp(
            moduleTargetScroll,
            minimumScroll,
            0.0f
        );

        moduleScroll = MathHelper.clamp(
            moduleScroll,
            minimumScroll,
            0.0f
        );

        moduleScroll = MorzhAnimUtil.approach(
            moduleScroll,
            moduleTargetScroll,
            SCROLL_SPEED,
            frameDelta
        );

        if (Math.abs(
            moduleScroll - moduleTargetScroll
        ) < 0.1f) {
            moduleScroll = moduleTargetScroll;
        }

        float contentProgress =
            MorzhAnimUtil.easeOutCubic(
                moduleListAnimation
            );

        int contentOffset = Math.round(
            (1.0f - contentProgress) * 10.0f
        );

        context.enableScissor(
            x + 3,
            listTop,
            x + listWidth - 3,
            listBottom
        );

        float moduleY = listTop + moduleScroll;

        for (Module module : modules) {
            int renderY = Math.round(moduleY);
            int renderX = x + 6 + contentOffset;
            int renderWidth =
                listWidth - 12 - contentOffset;

            boolean visible =
                renderY + 29 >= listTop
                    && renderY <= listBottom;

            boolean hovered =
                visible
                    && layoutTransition >= 1.0f
                    && inside(
                        mouseX,
                        mouseY,
                        renderX,
                        renderY,
                        renderWidth,
                        28
                    );

            if (hovered) {
                hoveredModule = module;
            }

            if (visible) {
                renderModuleCard(
                    context,
                    module,
                    hovered,
                    module == selectedModule,
                    renderX,
                    renderY,
                    renderWidth,
                    28
                );
            }

            moduleY += 32.0f;
        }

        context.disableScissor();

        if (modules.isEmpty()) {
            drawText(
                context,
                "Nothing found",
                x + 12 + contentOffset,
                listTop + 8,
                secondaryTextColor(),
                false
            );
        }
    }

    private void renderModuleInfo(
        DrawContext context,
        int x,
        int y,
        int infoWidth,
        int infoHeight
    ) {
        drawText(
            context,
            "MODULE INFO",
            x + 8,
            y + 8,
            secondaryTextColor(),
            false
        );

        if (selectedModule == null) {
            drawText(
                context,
                "Select module",
                x + 10,
                y + 31,
                primaryTextColor(),
                false
            );

            drawText(
                context,
                "Left: toggle",
                x + 10,
                y + 48,
                secondaryTextColor(),
                false
            );

            drawText(
                context,
                "Right: settings",
                x + 10,
                y + 61,
                secondaryTextColor(),
                false
            );

            return;
        }

        drawSurface(
            context,
            x + 7,
            y + 24,
            infoWidth - 14,
            38,
            4,
            CARD,
            GLASS_CARD,
            true
        );

        drawText(
            context,
            shorten(selectedModule.title, 18),
            x + 13,
            y + 31,
            primaryTextColor(),
            true
        );

        drawText(
            context,
            selectedModule.isActive()
                ? "ENABLED"
                : "DISABLED",
            x + 13,
            y + 47,
            selectedModule.isActive()
                ? GREEN
                : RED,
            false
        );

        drawText(
            context,
            "Description",
            x + 9,
            y + 76,
            ACCENT,
            false
        );

        List<String> lines = wrap(
            selectedModule.description,
            Math.max(15, (infoWidth - 18) / 6)
        );

        int lineY = y + 90;

        for (String line : lines) {
            if (lineY > y + infoHeight - 43) break;

            drawText(
                context,
                line,
                x + 9,
                lineY,
                secondaryTextColor(),
                false
            );

            lineY += 11;
        }

        drawSurface(
            context,
            x + 8,
            y + infoHeight - 30,
            infoWidth - 16,
            20,
            4,
            ACCENT_DARK,
            GLASS_SELECTED,
            true
        );

        drawText(
            context,
            "Open settings",
            x + 15,
            y + infoHeight - 23,
            primaryTextColor(),
            false
        );
    }

    private void renderClassic(
        DrawContext context,
        int mouseX,
        int mouseY
    ) {
        int areaX = panelX + 6;
        int areaY = panelY + 40;
        int areaWidth = panelWidth - 12;
        int areaHeight = panelHeight - 47;

        drawSurface(
            context,
            areaX,
            areaY,
            areaWidth,
            areaHeight,
            6,
            CONTENT,
            GLASS_CONTENT,
            true
        );

        int categoryCount = getVisibleCategoryCount();

        int totalWidth = Math.max(
            0,
            categoryCount * 110 - 6
        );

        int visibleWidth = areaWidth - 10;

        float minimumScroll = Math.min(
            0,
            visibleWidth - totalWidth
        );

        classicTargetScroll = MathHelper.clamp(
            classicTargetScroll,
            minimumScroll,
            0.0f
        );

        classicScroll = MathHelper.clamp(
            classicScroll,
            minimumScroll,
            0.0f
        );

        classicScroll = MorzhAnimUtil.approach(
            classicScroll,
            classicTargetScroll,
            SCROLL_SPEED,
            frameDelta
        );

        if (Math.abs(
            classicScroll - classicTargetScroll
        ) < 0.1f) {
            classicScroll = classicTargetScroll;
        }

        context.enableScissor(
            areaX,
            areaY,
            areaX + areaWidth,
            areaY + areaHeight
        );

        int columnWidth = 104;

        int columnX =
            areaX + 5 + Math.round(classicScroll);

        for (Category category : Modules.loopCategories()) {
            if (!hasVisibleModules(category)) continue;

            renderClassicCategory(
                context,
                category,
                columnX,
                areaY + 5,
                columnWidth,
                areaHeight - 10,
                mouseX,
                mouseY
            );

            columnX += columnWidth + 6;
        }

        context.disableScissor();

        drawText(
            context,
            "Mouse wheel: scroll categories",
            areaX + 8,
            panelY + panelHeight - 13,
            secondaryTextColor(),
            false
        );
    }

    private void renderClassicCategory(
        DrawContext context,
        Category category,
        int x,
        int y,
        int categoryWidth,
        int maxHeight,
        int mouseX,
        int mouseY
    ) {
        drawSurface(
            context,
            x,
            y,
            categoryWidth,
            maxHeight,
            5,
            PANEL,
            GLASS_PANEL,
            true
        );

        drawSurface(
            context,
            x,
            y,
            categoryWidth,
            20,
            5,
            ACCENT_DARK,
            GLASS_SELECTED,
            true
        );

        drawText(
            context,
            shorten(category.name, 14),
            x + 7,
            y + 7,
            primaryTextColor(),
            true
        );

        int moduleY = y + 24;

        for (Module module :
            Modules.get().getGroup(category)) {
            if (Config.get()
                .hiddenModules
                .get()
                .contains(module)) {
                continue;
            }

            if (moduleY + 19
                > y + maxHeight - 4) {
                break;
            }

            boolean hovered =
                layoutTransition >= 1.0f
                    && inside(
                        mouseX,
                        mouseY,
                        x + 4,
                        moduleY,
                        categoryWidth - 8,
                        18
                    );

            if (hovered) {
                hoveredModule = module;
            }

            renderModuleCard(
                context,
                module,
                hovered,
                module == selectedModule,
                x + 4,
                moduleY,
                categoryWidth - 8,
                18
            );

            moduleY += 20;
        }
    }

    private void renderModuleCard(
        DrawContext context,
        Module module,
        boolean hovered,
        boolean selected,
        int x,
        int y,
        int cardWidth,
        int cardHeight
    ) {
        float hover = hoverAnimations.getOrDefault(
            module,
            0.0f
        );

        hover = MorzhAnimUtil.approach(
            hover,
            hovered ? 1.0f : 0.0f,
            HOVER_SPEED,
            frameDelta
        );

        hoverAnimations.put(module, hover);

        float active = toggleAnimations.getOrDefault(
            module,
            module.isActive() ? 1.0f : 0.0f
        );

        active = MorzhAnimUtil.approach(
            active,
            module.isActive() ? 1.0f : 0.0f,
            TOGGLE_SPEED,
            frameDelta
        );

        toggleAnimations.put(module, active);

        int solidCard = blend(
            CARD,
            CARD_HOVER,
            MorzhAnimUtil.easeOutCubic(hover)
        );

        int glassCard = blend(
            GLASS_CARD,
            GLASS_CARD_HOVER,
            MorzhAnimUtil.easeOutCubic(hover)
        );

        drawSurface(
            context,
            x,
            y,
            cardWidth,
            cardHeight,
            4,
            solidCard,
            glassCard,
            selected || hovered
        );

        if (selected) {
            context.fill(
                x,
                y + 3,
                x + 2,
                y + cardHeight - 3,
                ACCENT
            );
        }

        if (active > 0.005f) {
            int activeWidth = Math.round(
                cardWidth
                    * MorzhAnimUtil.easeOutCubic(active)
            );

            context.fill(
                x,
                y + cardHeight - 2,
                x + activeWidth,
                y + cardHeight,
                ACCENT
            );
        }

        drawText(
            context,
            shorten(
                module.title,
                cardHeight <= 18 ? 13 : 18
            ),
            x + 6,
            y + (cardHeight <= 18 ? 5 : 6),
            module.isActive()
                ? primaryTextColor()
                : blend(
                    secondaryTextColor(),
                    primaryTextColor(),
                    hover
                ),
            false
        );

        if (cardHeight > 20) {
            drawText(
                context,
                module.isActive() ? "ON" : "OFF",
                x + cardWidth - 24,
                y + 16,
                module.isActive() ? GREEN : RED,
                false
            );
        }
    }

    @Override
    public boolean mouseClicked(
        double mouseX,
        double mouseY,
        int button
    ) {
        if (closing || animation < 0.9f) {
            return true;
        }

        int mx = (int) mouseX;
        int my = (int) mouseY;

        if (button == GLFW.GLFW_MOUSE_BUTTON_LEFT
            && inside(
                mx,
                my,
                panelX + 95,
                panelY + 10,
                48,
                18
            )) {
            switchLayout(Layout.Thunder);
            return true;
        }

        if (button == GLFW.GLFW_MOUSE_BUTTON_LEFT
            && inside(
                mx,
                my,
                panelX + 147,
                panelY + 10,
                45,
                18
            )) {
            switchLayout(Layout.Classic);
            return true;
        }

        if (button == GLFW.GLFW_MOUSE_BUTTON_LEFT
            && inside(
                mx,
                my,
                panelX + 196,
                panelY + 10,
                43,
                18
            )) {
            toggleGlass();
            return true;
        }

        if (layoutTransition < 0.98f) {
            return true;
        }

        if (layout == Layout.Thunder) {
            int searchWidth = Math.min(
                137,
                panelWidth / 3
            );

            int searchX =
                panelX + panelWidth
                    - searchWidth
                    - 12;

            if (inside(
                mx,
                my,
                searchX,
                panelY + 11,
                searchWidth,
                17
            )) {
                searching = true;
                MorzhSoundManager.playKeyPress();
                return true;
            }
        }

        if (inside(
            mx,
            my,
            panelX + 5,
            panelY + 5,
            panelWidth - 10,
            30
        )) {
            dragging = true;
            dragOffsetX = mx - panelX;
            dragOffsetY = my - panelY;
            return true;
        }

        if (layout == Layout.Thunder) {
            return clickThunder(mx, my, button);
        }

        return clickClassic(mx, my, button);
    }

    private void switchLayout(Layout newLayout) {
        if (newLayout == layout) return;
        if (layoutTransition < 0.98f) return;

        previousLayout = layout;
        layout = newLayout;
        layoutTransition = 0.0f;

        searching = false;
        hoveredModule = null;

        MorzhSoundManager.playKeyPress();
    }

    private void toggleGlass() {
        visualStyle =
            visualStyle == VisualStyle.Glass
                ? VisualStyle.Solid
                : VisualStyle.Glass;

        savedVisualStyle = visualStyle;
        MorzhSoundManager.playBoolean();
    }

    private boolean clickThunder(
        int mouseX,
        int mouseY,
        int button
    ) {
        int contentY = panelY + 40;
        int categoryY = contentY + 23;

        for (Category category : Modules.loopCategories()) {
            if (!hasVisibleModules(category)) continue;

            if (inside(
                mouseX,
                mouseY,
                panelX + 10,
                categoryY,
                82,
                16
            )) {
                if (selectedCategory != category) {
                    selectedCategory = category;
                    selectedModule = null;

                    moduleScroll = 0.0f;
                    moduleTargetScroll = 0.0f;
                    moduleListAnimation = 0.0f;

                    search = "";
                    searching = false;

                    MorzhSoundManager.playKeyPress();
                }

                return true;
            }

            categoryY += 18;
        }

        if (moduleListAnimation < 0.85f) {
            return true;
        }

        int modulesX = panelX + 102;
        int listTop = contentY + 22;
        int listBottom = panelY + panelHeight - 12;

        float moduleY = listTop + moduleScroll;

        for (Module module : getDisplayedModules()) {
            int renderY = Math.round(moduleY);

            if (renderY + 29 >= listTop
                && renderY <= listBottom
                && inside(
                    mouseX,
                    mouseY,
                    modulesX + 6,
                    renderY,
                    133,
                    28
                )) {
                activateModule(module, button);
                return true;
            }

            moduleY += 32.0f;
        }

        int infoX = panelX + 252;
        int infoWidth = panelWidth - 257;
        int contentHeight = panelHeight - 46;

        if (selectedModule != null
            && inside(
                mouseX,
                mouseY,
                infoX + 8,
                contentY + contentHeight - 30,
                infoWidth - 16,
                20
            )) {
            openSettings(selectedModule);
            return true;
        }

        searching = false;
        return false;
    }

    private boolean clickClassic(
        int mouseX,
        int mouseY,
        int button
    ) {
        int areaX = panelX + 6;
        int areaY = panelY + 40;
        int areaHeight = panelHeight - 47;

        int columnWidth = 104;

        int columnX =
            areaX + 5 + Math.round(classicScroll);

        for (Category category : Modules.loopCategories()) {
            if (!hasVisibleModules(category)) continue;

            int moduleY = areaY + 29;

            for (Module module :
                Modules.get().getGroup(category)) {
                if (Config.get()
                    .hiddenModules
                    .get()
                    .contains(module)) {
                    continue;
                }

                if (moduleY + 19
                    > areaY + areaHeight - 4) {
                    break;
                }

                if (inside(
                    mouseX,
                    mouseY,
                    columnX + 4,
                    moduleY,
                    columnWidth - 8,
                    18
                )) {
                    activateModule(module, button);
                    return true;
                }

                moduleY += 20;
            }

            columnX += columnWidth + 6;
        }

        return false;
    }

    private void activateModule(
        Module module,
        int button
    ) {
        selectedModule = module;

        if (button == GLFW.GLFW_MOUSE_BUTTON_LEFT) {
            module.toggle();

            MorzhSoundManager.playModuleState(
                module.isActive()
            );
        } else if (
            button == GLFW.GLFW_MOUSE_BUTTON_RIGHT
        ) {
            openSettings(module);
        }
    }

    private void openSettings(Module module) {
        MorzhSoundManager.playBoolean();

        if (client != null) {
            client.setScreen(
                GuiThemes.get().moduleScreen(module)
            );
        }
    }

    @Override
    public boolean mouseReleased(
        double mouseX,
        double mouseY,
        int button
    ) {
        dragging = false;

        return super.mouseReleased(
            mouseX,
            mouseY,
            button
        );
    }

    @Override
    public boolean mouseScrolled(
        double mouseX,
        double mouseY,
        double horizontalAmount,
        double verticalAmount
    ) {
        if (closing || layoutTransition < 0.98f) {
            return true;
        }

        if (layout == Layout.Classic) {
            classicTargetScroll +=
                (float) verticalAmount * 35.0f;

            MorzhSoundManager.playScroll();
            return true;
        }

        if (inside(
            mouseX,
            mouseY,
            panelX + 102,
            panelY + 40,
            145,
            panelHeight - 46
        )) {
            moduleTargetScroll +=
                (float) verticalAmount * 28.0f;

            MorzhSoundManager.playScroll();
            return true;
        }

        return super.mouseScrolled(
            mouseX,
            mouseY,
            horizontalAmount,
            verticalAmount
        );
    }

    @Override
    public boolean keyPressed(
        int keyCode,
        int scanCode,
        int modifiers
    ) {
        if (keyCode == GLFW.GLFW_KEY_ESCAPE) {
            if (searching) {
                searching = false;
                MorzhSoundManager.playKeyRelease();
                return true;
            }

            if (!closing) {
                closing = true;
                dragging = false;
                MorzhSoundManager.playClose();
            }

            return true;
        }

        if (closing) return true;

        if (searching) {
            if (keyCode == GLFW.GLFW_KEY_ENTER
                || keyCode == GLFW.GLFW_KEY_KP_ENTER) {
                searching = false;
                MorzhSoundManager.playKeyRelease();
                return true;
            }

            if (keyCode == GLFW.GLFW_KEY_BACKSPACE) {
                if (!search.isEmpty()) {
                    search = search.substring(
                        0,
                        search.length() - 1
                    );

                    moduleTargetScroll = 0.0f;
                    MorzhSoundManager.playKeyRelease();
                }

                return true;
            }
        }

        return super.keyPressed(
            keyCode,
            scanCode,
            modifiers
        );
    }

    @Override
    public boolean charTyped(
        char chr,
        int modifiers
    ) {
        if (searching
            && !Character.isISOControl(chr)
            && search.length() < 40) {
            search += chr;
            moduleTargetScroll = 0.0f;

            MorzhSoundManager.playKeyPress();
            return true;
        }

        return super.charTyped(chr, modifiers);
    }

    private List<Module> getDisplayedModules() {
        List<Module> modules = new ArrayList<>();

        String query = search
            .trim()
            .toLowerCase(Locale.ROOT);

        for (Module module : Modules.get().getAll()) {
            if (Config.get()
                .hiddenModules
                .get()
                .contains(module)) {
                continue;
            }

            if (!query.isEmpty()) {
                boolean matches =
                    module.name
                        .toLowerCase(Locale.ROOT)
                        .contains(query)
                    || module.title
                        .toLowerCase(Locale.ROOT)
                        .contains(query)
                    || module.description != null
                        && module.description
                        .toLowerCase(Locale.ROOT)
                        .contains(query);

                if (matches) {
                    modules.add(module);
                }
            } else if (
                selectedCategory != null
                    && Modules.get()
                    .getGroup(selectedCategory)
                    .contains(module)
            ) {
                modules.add(module);
            }
        }

        modules.sort(
            (first, second) ->
                String.CASE_INSENSITIVE_ORDER.compare(
                    first.title,
                    second.title
                )
        );

        return modules;
    }

    private int getVisibleCategoryCount() {
        int count = 0;

        for (Category category : Modules.loopCategories()) {
            if (hasVisibleModules(category)) {
                count++;
            }
        }

        return count;
    }

    private boolean hasVisibleModules(
        Category category
    ) {
        for (Module module :
            Modules.get().getGroup(category)) {
            if (!Config.get()
                .hiddenModules
                .get()
                .contains(module)) {
                return true;
            }
        }

        return false;
    }

    private int primaryTextColor() {
        return blend(
            TEXT,
            GLASS_TEXT,
            glassTransition
        );
    }

    private int secondaryTextColor() {
        return blend(
            TEXT_SECONDARY,
            GLASS_TEXT_SECONDARY,
            glassTransition
        );
    }

    private void drawText(
        DrawContext context,
        String value,
        int x,
        int y,
        int color,
        boolean shadow
    ) {
        boolean readableShadow =
            shadow || glassTransition > 0.05f;

        if (readableShadow) {
            context.drawTextWithShadow(
                textRenderer,
                value,
                x,
                y,
                color
            );
        } else {
            context.drawText(
                textRenderer,
                value,
                x,
                y,
                color,
                false
            );
        }
    }

    private void drawSurface(
        DrawContext context,
        int x,
        int y,
        int surfaceWidth,
        int surfaceHeight,
        int radius,
        int solidColor,
        int glassColor,
        boolean accented
    ) {
        if (surfaceWidth <= 0 || surfaceHeight <= 0) {
            return;
        }

        float glass = MorzhAnimUtil.easeOutCubic(
            glassTransition
        );

        int baseColor = blend(
            solidColor,
            glassColor,
            glass
        );

        if (glass <= 0.01f) {
            roundedRect(
                context,
                x,
                y,
                surfaceWidth,
                surfaceHeight,
                radius,
                baseColor
            );

            return;
        }

        int shadowAlpha = Math.round(72.0f * glass);

        roundedRect(
            context,
            x + 1,
            y + 2,
            surfaceWidth,
            surfaceHeight,
            radius,
            withAlpha(
                GLASS_SHADOW,
                shadowAlpha
            )
        );

        int edgeBase = accented
            ? GLASS_EDGE_PURPLE
            : GLASS_EDGE;

        int edgeAlpha = Math.round(
            (accented ? 115.0f : 80.0f) * glass
        );

        roundedRect(
            context,
            x,
            y,
            surfaceWidth,
            surfaceHeight,
            radius,
            withAlpha(edgeBase, edgeAlpha)
        );

        if (surfaceWidth > 2 && surfaceHeight > 2) {
            roundedRect(
                context,
                x + 1,
                y + 1,
                surfaceWidth - 2,
                surfaceHeight - 2,
                Math.max(0, radius - 1),
                baseColor
            );
        }

        int highlightAlpha = Math.round(
            (accented ? 95.0f : 65.0f) * glass
        );

        int inset = Math.max(2, radius);

        if (surfaceWidth > inset * 2) {
            context.fill(
                x + inset,
                y + 1,
                x + surfaceWidth - inset,
                y + 2,
                withAlpha(
                    GLASS_HIGHLIGHT,
                    highlightAlpha
                )
            );
        }

        int sideAlpha = Math.round(
            38.0f * glass
        );

        if (surfaceHeight > inset * 2) {
            context.fill(
                x + 1,
                y + inset,
                x + 2,
                y + surfaceHeight - inset,
                withAlpha(
                    GLASS_HIGHLIGHT,
                    sideAlpha
                )
            );
        }

        int lowerShadeAlpha = Math.round(
            45.0f * glass
        );

        if (surfaceWidth > inset * 2) {
            context.fill(
                x + inset,
                y + surfaceHeight - 2,
                x + surfaceWidth - inset,
                y + surfaceHeight - 1,
                lowerShadeAlpha << 24
            );
        }
    }

    private static boolean inside(
        double mouseX,
        double mouseY,
        double x,
        double y,
        double targetWidth,
        double targetHeight
    ) {
        return mouseX >= x
            && mouseX <= x + targetWidth
            && mouseY >= y
            && mouseY <= y + targetHeight;
    }

    private static void roundedRect(
        DrawContext context,
        int x,
        int y,
        int rectWidth,
        int rectHeight,
        int radius,
        int color
    ) {
        if (rectWidth <= 0 || rectHeight <= 0) {
            return;
        }

        radius = Math.min(
            radius,
            Math.min(rectWidth / 2, rectHeight / 2)
        );

        context.fill(
            x + radius,
            y,
            x + rectWidth - radius,
            y + rectHeight,
            color
        );

        context.fill(
            x,
            y + radius,
            x + rectWidth,
            y + rectHeight - radius,
            color
        );

        for (int i = 0; i < radius; i++) {
            int inset = radius - i;

            context.fill(
                x + inset,
                y + i,
                x + rectWidth - inset,
                y + i + 1,
                color
            );

            context.fill(
                x + inset,
                y + rectHeight - i - 1,
                x + rectWidth - inset,
                y + rectHeight - i,
                color
            );
        }
    }

    private static int withAlpha(
        int color,
        int alpha
    ) {
        return color & 0x00FFFFFF
            | MathHelper.clamp(alpha, 0, 255) << 24;
    }

    private static int blend(
        int first,
        int second,
        float progress
    ) {
        progress = MorzhAnimUtil.clamp01(progress);

        int a1 = first >>> 24;
        int r1 = first >> 16 & 255;
        int g1 = first >> 8 & 255;
        int b1 = first & 255;

        int a2 = second >>> 24;
        int r2 = second >> 16 & 255;
        int g2 = second >> 8 & 255;
        int b2 = second & 255;

        int a = Math.round(
            a1 + (a2 - a1) * progress
        );

        int r = Math.round(
            r1 + (r2 - r1) * progress
        );

        int g = Math.round(
            g1 + (g2 - g1) * progress
        );

        int b = Math.round(
            b1 + (b2 - b1) * progress
        );

        return a << 24 | r << 16 | g << 8 | b;
    }

    private static String shorten(
        String value,
        int maxLength
    ) {
        if (value == null) return "";
        if (value.length() <= maxLength) return value;

        return value.substring(
            0,
            Math.max(0, maxLength - 3)
        ) + "...";
    }

    private static List<String> wrap(
        String value,
        int maxLength
    ) {
        List<String> lines = new ArrayList<>();

        if (value == null || value.isBlank()) {
            lines.add("No description.");
            return lines;
        }

        StringBuilder line = new StringBuilder();

        for (String word : value.split("\\s+")) {
            if (line.length() > 0
                && line.length()
                    + word.length()
                    + 1
                    > maxLength) {
                lines.add(line.toString());
                line.setLength(0);
            }

            if (line.length() > 0) {
                line.append(' ');
            }

            line.append(word);
        }

        if (!line.isEmpty()) {
            lines.add(line.toString());
        }

        return lines;
    }

    private enum Layout {
        Thunder,
        Classic
    }

    private enum VisualStyle {
        Solid,
        Glass
    }
}


