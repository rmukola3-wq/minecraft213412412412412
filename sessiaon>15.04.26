Проверяю версию Minecraft и доступные рендер-API.Ищу встроенный blur Minecraft 1.21.4 и сигнатуры экрана.Читаю рабочий вызов blur и порядок отрисовки ThunderHack.Нахожу последнюю полную версию экрана для точного патча.Проверяю названия текущего переключателя темы и цветов.

Да, этот build.gradle.kts подходит. Для Minecraft 1.21.4 уже доступен настоящий vanilla blur через защищённый метод Screen.applyBlur(delta). Дополнительные зависимости не нужны.

Текущую псевдостеклянную тему сохраняем как Amethyst, добавляем третью Liquid Glass:

java

private Theme theme = Theme.Solid;

private enum Theme {
    Solid,
    Amethyst,
    LiquidGlass
}


В начале render(...), до отрисовки панелей:

java

if (theme == Theme.LiquidGlass && client.world != null) {
    applyBlur(delta);
}

int dimColor = switch (theme) {
    case Solid -> 0xB0000000;
    case Amethyst -> 0x7808060B;
    case LiquidGlass -> 0x1804080C;
};

context.fill(0, 0, width, height, dimColor);


Цвета для тем:

java

private int backgroundColor() {
    return switch (theme) {
        case Solid -> 0xFF18141E;
        case Amethyst -> 0xB0181422;
        case LiquidGlass -> 0x5210161F;
    };
}

private int panelColor() {
    return switch (theme) {
        case Solid -> 0xFF211B29;
        case Amethyst -> 0x982A1E35;
        case LiquidGlass -> 0x4819232E;
    };
}

private int contentColor() {
    return switch (theme) {
        case Solid -> 0xFF251D2D;
        case Amethyst -> 0x8C30213D;
        case LiquidGlass -> 0x3D1A2632;
    };
}

private int cardColor() {
    return switch (theme) {
        case Solid -> 0xFF302638;
        case Amethyst -> 0xA03D2950;
        case LiquidGlass -> 0x54263643;
    };
}

private int cardHoverColor() {
    return switch (theme) {
        case Solid -> 0xFF40314A;
        case Amethyst -> 0xBC57356E;
        case LiquidGlass -> 0x78394C5D;
    };
}

private int primaryTextColor() {
    return theme == Theme.LiquidGlass
        ? 0xFFFFFFFF
        : 0xFFF3ECFA;
}

private int secondaryTextColor() {
    return theme == Theme.LiquidGlass
        ? 0xFFD2DEE8
        : 0xFFA89CAE;
}


Но полный актуальный MorzhThunderScreen.java отсутствует среди загруженных исходников: там находятся дампы Rockstar/ThunderHack/Rasty и старая неполная версия экрана. Если сейчас соберу «полный файл» из фрагментов, потеряются твои последние обработчики, анимации и настройки.

Залей именно этот файл:

src/main/java/meteordevelopment/meteorclient/gui/morzh/MorzhThunderScreen.java

После этого верну его целиком с тремя темами и настоящим размытием, без фрагментов.

на 3 части тогда розбиью вот первая не тарт ьвермя напиш 1 слово принял  * Morzh Client GUI.
*

    ThunderHack-inspired Dashboard and Classic layouts.
    Interaction ideas inspired by Rockstar Client.
    Glass visual behavior independently implemented after studying
    Rasty Client's MIT-declared glass UI. */


package meteordevelopment.meteorclient.gui.screens.morzh;

import meteordevelopment.meteorclient.gui.GuiThemes;
import meteordevelopment.meteorclient.gui.morzh.MorzhAnimUtil;
import meteordevelopment.meteorclient.systems.config.Config;
import meteordevelopment.meteorclient.systems.modules.Category;
import meteordevelopment.meteorclient.systems.modules.Module;
import meteordevelopment.meteorclient.systems.modules.Modules;
import meteordevelopment.meteorclient.utils.sound.MorzhSoundManager;
import net.minecraft.client.gui.DrawContext;
import net.minecraft.client.gui.screen.Screen;
import net.minecraft.text.Text;
import net.minecraft.util.math.MathHelper;
import org.lwjgl.glfw.GLFW;

import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Locale;
import java.util.Map;

public class MorzhThunderScreen extends Screen {
private static final int BACKGROUND = 0xFF18141E;
private static final int PANEL = 0xFF211B29;
private static final int CONTENT = 0xFF251D2D;
private static final int CARD = 0xFF302638;
private static final int CARD_HOVER = 0xFF40314A;

private static final int ACCENT = 0xFF9A5CE0;
private static final int ACCENT_DARK = 0xFF684093;

private static final int TEXT = 0xFFF3ECFA;
private static final int TEXT_SECONDARY = 0xFFA89CAE;
private static final int GREEN = 0xFF72D69B;
private static final int RED = 0xFFE06C75;

/*
 * Shader-free liquid-glass palette.
 * Text is rendered after every glass surface.
 */
private static final int GLASS_BACKGROUND = 0xB0181322;
private static final int GLASS_PANEL = 0x982A2135;
private static final int GLASS_CONTENT = 0x8C211A2C;
private static final int GLASS_CARD = 0x783A2E46;
private static final int GLASS_CARD_HOVER = 0xB0544264;
private static final int GLASS_SELECTED = 0xB05F3F84;

private static final int GLASS_EDGE = 0x70FFFFFF;
private static final int GLASS_EDGE_PURPLE = 0x909A5CE0;
private static final int GLASS_HIGHLIGHT = 0x55FFFFFF;
private static final int GLASS_SHADOW = 0x70000000;

private static final int GLASS_TEXT = 0xFFFFFFFF;
private static final int GLASS_TEXT_SECONDARY = 0xFFE4D9EC;

private static final float OPEN_SPEED = 14.0f;
private static final float CLOSE_SPEED = 18.0f;
private static final float HOVER_SPEED = 14.0f;
private static final float TOGGLE_SPEED = 11.0f;
private static final float SCROLL_SPEED = 14.0f;
private static final float LAYOUT_SPEED = 12.0f;
private static final float CATEGORY_SPEED = 16.0f;
private static final float GLASS_SPEED = 10.0f;

private static VisualStyle savedVisualStyle =
    VisualStyle.Solid;

private final Map<Module, Float> hoverAnimations =
    new HashMap<>();

private final Map<Module, Float> toggleAnimations =
    new HashMap<>();

private Layout layout = Layout.Thunder;
private Layout previousLayout = Layout.Thunder;

private VisualStyle visualStyle = savedVisualStyle;

private Category selectedCategory;
private Module selectedModule;
private Module hoveredModule;

private int panelX;
private int panelY;
private int panelWidth;
private int panelHeight;

private int dragOffsetX;
private int dragOffsetY;

private boolean positioned;
private boolean dragging;
private boolean searching;
private boolean closing;

private float frameDelta = 1.0f / 60.0f;
private float animation;
private float layoutTransition = 1.0f;
private float moduleListAnimation = 1.0f;
private float glassTransition;

private float moduleScroll;
private float moduleTargetScroll;

private float classicScroll;
private float classicTargetScroll;

private float categoryIndicatorY = Float.NaN;

private float thunderTabHover;
private float classicTabHover;
private float glassButtonHover;
private float searchHover;

private String search = "";

public MorzhThunderScreen() {
    super(Text.literal("Morzh Client"));
}

@Override
protected void init() {
    panelWidth = Math.min(440, width - 12);
    panelHeight = Math.min(245, height - 12);

    if (!positioned) {
        panelX = (width - panelWidth) / 2;
        panelY = (height - panelHeight) / 2;
        positioned = true;
    } else {
        clampPanelPosition();
    }

    if (selectedCategory == null) {
        for (Category category : Modules.loopCategories()) {
            if (hasVisibleModules(category)) {
                selectedCategory = category;
                break;
            }
        }
    }

    animation = 0.0f;
    closing = false;
    dragging = false;

    previousLayout = layout;
    layoutTransition = 1.0f;

    glassTransition =
        visualStyle == VisualStyle.Glass
            ? 1.0f
            : 0.0f;

    MorzhSoundManager.playOpen();
}

@Override
public boolean shouldPause() {
    return false;
}

@Override
public void render(
    DrawContext context,
    int mouseX,
    int mouseY,
    float delta
) {
    frameDelta = MorzhAnimUtil.beginFrame();

    updateDragging(mouseX, mouseY);
    updateAnimations();

    if (closing && animation <= 0.008f) {
        if (client != null) {
            client.setScreen(null);
        }

        return;
    }

    float easedOpen =
        MorzhAnimUtil.easeOutQuart(animation);

    int maximumDim =
        visualStyle == VisualStyle.Glass
            ? 120
            : 176;

    int dimAlpha = Math.round(
        maximumDim * easedOpen
    );

    context.fill(
        0,
        0,
        width,
        height,
        dimAlpha << 24
    );

    int originalPanelY = panelY;

    int slideOffset = Math.round(
        (1.0f - easedOpen) * 12.0f
    );

    panelY = originalPanelY + slideOffset;

    int revealHeight = Math.max(
        1,
        Math.round(panelHeight * easedOpen)
    );

    int revealTop =
        panelY + (panelHeight - revealHeight) / 2;

    context.enableScissor(
        panelX,
        revealTop,
        panelX + panelWidth,
        revealTop + revealHeight
    );

    renderGui(context, mouseX, mouseY);

    context.disableScissor();

    panelY = originalPanelY;

    super.render(context, mouseX, mouseY, delta);
}

private void updateAnimations() {
    float openTarget = closing ? 0.0f : 1.0f;

    animation = MorzhAnimUtil.approach(
        animation,
        openTarget,
        closing ? CLOSE_SPEED : OPEN_SPEED,
        frameDelta
    );

    if (!closing && animation >= 0.999f) {
        animation = 1.0f;
    }

    if (closing && animation <= 0.008f) {
        animation = 0.0f;
    }

    layoutTransition = MorzhAnimUtil.approach(
        layoutTransition,
        1.0f,
        LAYOUT_SPEED,
        frameDelta
    );

    if (layoutTransition >= 0.998f) {
        layoutTransition = 1.0f;
        previousLayout = layout;
    }

    moduleListAnimation = MorzhAnimUtil.approach(
        moduleListAnimation,
        1.0f,
        LAYOUT_SPEED,
        frameDelta
    );

    if (moduleListAnimation >= 0.998f) {
        moduleListAnimation = 1.0f;
    }

    glassTransition = MorzhAnimUtil.approach(
        glassTransition,
        visualStyle == VisualStyle.Glass
            ? 1.0f
            : 0.0f,
        GLASS_SPEED,
        frameDelta
    );

    if (glassTransition >= 0.998f) {
        glassTransition = 1.0f;
    }

    if (glassTransition <= 0.002f) {
        glassTransition = 0.0f;
    }
}

private void updateDragging(int mouseX, int mouseY) {
    if (!dragging) return;

    panelX = mouseX - dragOffsetX;
    panelY = mouseY - dragOffsetY;

    clampPanelPosition();
}

private void clampPanelPosition() {
    panelX = MathHelper.clamp(
        panelX,
        -panelWidth + 60,
        width - 60
    );

    panelY = MathHelper.clamp(
        panelY,
        0,
        Math.max(0, height - 25)
    );

    int snapDistance = 8;

    if (Math.abs(panelX) <= snapDistance) {
        panelX = 0;
    }

    if (Math.abs(panelY) <= snapDistance) {
        panelY = 0;
    }

    if (Math.abs(
        panelX + panelWidth - width
    ) <= snapDistance) {
        panelX = width - panelWidth;
    }

    if (Math.abs(
        panelY + panelHeight - height
    ) <= snapDistance) {
        panelY = height - panelHeight;
    }
}

private void renderGui(
    DrawContext context,
    int mouseX,
    int mouseY
) {
    hoveredModule = null;

    drawSurface(
        context,
        panelX,
        panelY,
        panelWidth,
        panelHeight,
        8,
        BACKGROUND,
        GLASS_BACKGROUND,
        true
    );

    renderHeader(context, mouseX, mouseY);
    renderLayoutContent(context, mouseX, mouseY);

    if (hoveredModule != null
        && hoveredModule.description != null
        && !hoveredModule.description.isBlank()) {
        drawText(
            context,
            shorten(hoveredModule.description, 58),
            panelX + 10,
            panelY + panelHeight - 12,
            secondaryTextColor(),
            false
        );
    }
}

private void renderLayoutContent(
    DrawContext context,
    int mouseX,
    int mouseY
) {
    if (layoutTransition >= 1.0f) {
        renderLayout(
            context,
            layout,
            mouseX,
            mouseY,
            0
        );

        return;
    }

    float eased = MorzhAnimUtil.easeInOutCubic(
        layoutTransition
    );

    int direction =
        layout == Layout.Classic ? 1 : -1;

    int outgoingOffset = Math.round(
        -direction * eased * panelWidth
    );

    int incomingOffset = Math.round(
        direction
            * (1.0f - eased)
            * panelWidth
    );

    context.enableScissor(
        panelX + 5,
        panelY + 39,
        panelX + panelWidth - 5,
        panelY + panelHeight - 5
    );

    renderLayout(
        context,
        previousLayout,
        Integer.MIN_VALUE / 4,
        Integer.MIN_VALUE / 4,
        outgoingOffset
    );

    renderLayout(
        context,
        layout,
        Integer.MIN_VALUE / 4,
        Integer.MIN_VALUE / 4,
        incomingOffset
    );

    context.disableScissor();
}

private void renderLayout(
    DrawContext context,
    Layout targetLayout,
    int mouseX,
    int mouseY,
    int offsetX
) {
    int originalPanelX = panelX;
    panelX += offsetX;

    if (targetLayout == Layout.Thunder) {
        renderThunder(context, mouseX, mouseY);
    } else {
        renderClassic(context, mouseX, mouseY);
    }

    panelX = originalPanelX;
}

private void renderHeader(
    DrawContext context,
    int mouseX,
    int mouseY
) {
    drawSurface(
        context,
        panelX + 5,
        panelY + 5,
        panelWidth - 10,
        30,
        6,
        PANEL,
        GLASS_PANEL,
        true
    );

    context.fill(
        panelX + 7,
        panelY + 33,
        panelX + panelWidth - 7,
        panelY + 34,
        blend(
            ACCENT_DARK,
            GLASS_EDGE_PURPLE,
            glassTransition
        )
    );

    drawText(
        context,
        "MORZH",
        panelX + 13,
        panelY + 12,
        primaryTextColor(),
        true
    );

    drawText(
        context,
        "CLIENT",
        panelX + 51,
        panelY + 12,
        ACCENT,
        true
    );

    boolean thunderHovered = inside(
        mouseX,
        mouseY,
        panelX + 95,
        panelY + 10,
        48,
        18
    );

    boolean classicHovered = inside(
        mouseX,
        mouseY,
        panelX + 147,
        panelY + 10,
        45,
        18
    );

    boolean glassHovered = inside(
        mouseX,
        mouseY,
        panelX + 196,
        panelY + 10,
        43,
        18
    );

    thunderTabHover = MorzhAnimUtil.approach(
        thunderTabHover,
        thunderHovered ? 1.0f : 0.0f,
        HOVER_SPEED,
        frameDelta
    );

    classicTabHover = MorzhAnimUtil.approach(
        classicTabHover,
        classicHovered ? 1.0f : 0.0f,
        HOVER_SPEED,
        frameDelta
    );

    glassButtonHover = MorzhAnimUtil.approach(
        glassButtonHover,
        glassHovered ? 1.0f : 0.0f,
        HOVER_SPEED,
        frameDelta
    );

    renderLayoutButton(
        context,
        "Thunder",
        panelX + 95,
        panelY + 10,
        48,
        layout == Layout.Thunder,
        thunderTabHover
    );

    renderLayoutButton(
        context,
        "Classic",
        panelX + 147,
        panelY + 10,
        45,
        layout == Layout.Classic,
        classicTabHover
    );

    renderGlassButton(
        context,
        panelX + 196,
        panelY + 10,
        43,
        glassButtonHover
    );

    if (layout == Layout.Thunder) {
        renderSearch(context, mouseX, mouseY);
    }
}

private void renderLayoutButton(
    DrawContext context,
    String label,
    int x,
    int y,
    int buttonWidth,
    boolean selected,
    float hover
) {
    int solidColor = selected
        ? ACCENT_DARK
        : blend(CARD, CARD_HOVER, hover);

    int glassColor = selected
        ? GLASS_SELECTED
        : blend(
        GLASS_CARD,
        GLASS_CARD_HOVER,
        hover
    );

    drawSurface(
        context,
        x,
        y,
        buttonWidth,
        18,
        4,
        solidColor,
        glassColor,
        false
    );

    if (selected) {
        int indicatorWidth = Math.max(
            2,
            Math.round(
                buttonWidth
                    * MorzhAnimUtil.easeOutCubic(
                    layoutTransition
                )
            )
        );

        context.fill(
            x + 2,
            y + 16,
            x + Math.max(2, indicatorWidth - 2),
            y + 18,
            ACCENT
        );
    }

    drawText(
        context,
        label,
        x + 5,
        y + 5,
        selected
            ? primaryTextColor()
            : secondaryTextColor(),
        false
    );
}

private void renderGlassButton(
    DrawContext context,
    int x,
    int y,
    int buttonWidth,
    float hover
) {
    boolean enabled =
        visualStyle == VisualStyle.Glass;

    int solidColor = enabled
        ? ACCENT_DARK
        : blend(CARD, CARD_HOVER, hover);

    int glassColor = enabled
        ? GLASS_SELECTED
        : blend(
        GLASS_CARD,
        GLASS_CARD_HOVER,
        hover
    );

    drawSurface(
        context,
        x,
        y,
        buttonWidth,
        18,
        4,
        solidColor,
        glassColor,
        enabled
    );

    if (enabled) {
        context.fill(
            x + 3,
            y + 2,
            x + buttonWidth - 3,
            y + 3,
            withAlpha(
                GLASS_HIGHLIGHT,
                145
            )
        );
    }

    drawText(
        context,
        "Glass",
        x + 5,
        y + 5,
        enabled
            ? primaryTextColor()
            : secondaryTextColor(),
        false
    );
}

private void renderSearch(
    DrawContext context,
    int mouseX,
    int mouseY
) {
    int searchWidth = Math.min(
        137,
        panelWidth / 3
    );

    int searchX =
        panelX + panelWidth - searchWidth - 12;

    int searchY = panelY + 11;

    boolean hovered = inside(
        mouseX,
        mouseY,
        searchX,
        searchY,
        searchWidth,
        17
    );

    searchHover = MorzhAnimUtil.approach(
        searchHover,
        searching || hovered ? 1.0f : 0.0f,
        HOVER_SPEED,
        frameDelta
    );

    drawSurface(
        context,
        searchX,
        searchY,
        searchWidth,
        17,
        4,
        blend(CARD, CARD_HOVER, searchHover),
        blend(
            GLASS_CARD,
            GLASS_CARD_HOVER,
            searchHover
        ),
        searching
    );

    if (searching) {
        int underlineWidth = Math.max(
            1,
            Math.round(searchWidth * searchHover)
        );

        context.fill(
            searchX + 2,
            searchY + 15,
            searchX + Math.max(
                2,
                underlineWidth - 2
            ),
            searchY + 17,
            ACCENT
        );
    }

    String shown;

    if (search.isEmpty()) {
        shown = searching
            ? "Type to search..."
            : "Search modules";
    } else {
        shown = search;
    }

    if (searching
        && (System.currentTimeMillis() / 450L)
        % 2L == 0L) {
        shown += "_";
    }

    drawText(
        context,
        shorten(shown, 19),
        searchX + 6,
        searchY + 5,
        search.isEmpty()
            ? secondaryTextColor()
            : primaryTextColor(),
        false
    );
}

private void renderThunder(
    DrawContext context,
    int mouseX,
    int mouseY
) {
    int contentY = panelY + 40;
    int contentHeight = panelHeight - 46;

    int sidebarX = panelX + 5;
    int sidebarWidth = 92;

    int modulesX = panelX + 102;
    int modulesWidth = 145;

    int infoX = panelX + 252;
    int infoWidth = panelWidth - 257;

    drawSurface(
        context,
        sidebarX,
        contentY,
        sidebarWidth,
        contentHeight,
        6,
        PANEL,
        GLASS_PANEL,
        true
    );

    drawSurface(
        context,

Принял.

int x,
    int y,
    int categoryWidth
) {
    drawText(
        context,
        "CATEGORIES",
        x + 8,
        y + 8,
        secondaryTextColor(),
        false
    );

    int targetY = findSelectedCategoryY(y + 23);

    if (targetY >= 0) {
        if (!Float.isFinite(categoryIndicatorY)) {
            categoryIndicatorY = targetY;
        }

        categoryIndicatorY = MorzhAnimUtil.approach(
            categoryIndicatorY,
            targetY,
            CATEGORY_SPEED,
            frameDelta
        );

        int indicatorY = Math.round(
            categoryIndicatorY
        );

        drawSurface(
            context,
            x + 5,
            indicatorY,
            categoryWidth - 10,
            16,
            3,
            ACCENT_DARK,
            GLASS_SELECTED,
            true
        );

        context.fill(
            x + 5,
            indicatorY + 3,
            x + 7,
            indicatorY + 13,
            ACCENT
        );
    }

    int categoryY = y + 23;

    for (Category category : Modules.loopCategories()) {
        if (!hasVisibleModules(category)) continue;

        boolean selected =
            category == selectedCategory;

        boolean hovered = inside(
            mouseX,
            mouseY,
            x + 5,
            categoryY,
            categoryWidth - 10,
            16
        );

        if (!selected && hovered) {
            drawSurface(
                context,
                x + 5,
                categoryY,
                categoryWidth - 10,
                16,
                3,
                CARD_HOVER,
                GLASS_CARD_HOVER,
                false
            );
        }

        drawText(
            context,
            shorten(category.name, 12),
            x + 11,
            categoryY + 4,
            selected
                ? primaryTextColor()
                : secondaryTextColor(),
            false
        );

        categoryY += 18;

        if (categoryY
            > panelY + panelHeight - 25) {
            break;
        }
    }
}

private int findSelectedCategoryY(int startY) {
    int categoryY = startY;

    for (Category category : Modules.loopCategories()) {
        if (!hasVisibleModules(category)) continue;

        if (category == selectedCategory) {
            return categoryY;
        }

        categoryY += 18;
    }

    return -1;
}

private void renderModuleList(
    DrawContext context,
    int mouseX,
    int mouseY,
    int x,
    int y,
    int listWidth,
    int listHeight
) {
    List<Module> modules = getDisplayedModules();

    drawText(
        context,
        search.isEmpty()
            && selectedCategory != null
            ? selectedCategory.name.toUpperCase(
            Locale.ROOT
        )
            : "SEARCH RESULTS",
        x + 8,
        y + 8,
        secondaryTextColor(),
        false
    );

    int listTop = y + 22;
    int listBottom = y + listHeight - 6;

    int totalHeight = modules.size() * 32;
    int visibleHeight = listBottom - listTop;

    float minimumScroll = Math.min(
        0,
        visibleHeight - totalHeight
    );

    moduleTargetScroll = MathHelper.clamp(
        moduleTargetScroll,
        minimumScroll,
        0.0f
    );

    moduleScroll = MathHelper.clamp(
        moduleScroll,
        minimumScroll,
        0.0f
    );

    moduleScroll = MorzhAnimUtil.approach(
        moduleScroll,
        moduleTargetScroll,
        SCROLL_SPEED,
        frameDelta
    );

    if (Math.abs(
        moduleScroll - moduleTargetScroll
    ) < 0.1f) {
        moduleScroll = moduleTargetScroll;
    }

    float contentProgress =
        MorzhAnimUtil.easeOutCubic(
            moduleListAnimation
        );

    int contentOffset = Math.round(
        (1.0f - contentProgress) * 10.0f
    );

    context.enableScissor(
        x + 3,
        listTop,
        x + listWidth - 3,
        listBottom
    );

    float moduleY = listTop + moduleScroll;

    for (Module module : modules) {
        int renderY = Math.round(moduleY);
        int renderX = x + 6 + contentOffset;
        int renderWidth =
            listWidth - 12 - contentOffset;

        boolean visible =
            renderY + 29 >= listTop
                && renderY <= listBottom;

        boolean hovered =
            visible
                && layoutTransition >= 1.0f
                && inside(
                mouseX,
                mouseY,
                renderX,
                renderY,
                renderWidth,
                28
            );

        if (hovered) {
            hoveredModule = module;
        }

        if (visible) {
            renderModuleCard(
                context,
                module,
                hovered,
                module == selectedModule,
                renderX,
                renderY,
                renderWidth,
                28
            );
        }

        moduleY += 32.0f;
    }

    context.disableScissor();

    if (modules.isEmpty()) {
        drawText(
            context,
            "Nothing found",
            x + 12 + contentOffset,
            listTop + 8,
            secondaryTextColor(),
            false
        );
    }
}

private void renderModuleInfo(
    DrawContext context,
    int x,
    int y,
    int infoWidth,
    int infoHeight
) {
    drawText(
        context,
        "MODULE INFO",
