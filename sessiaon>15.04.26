Скопируй целиком:

powershell

$p=gc ".\gradle\wrapper\gradle-wrapper.properties" -raw; $v=[regex]::match($p,'gradle-([0-9.]+)-').groups[1].value; $g=gci "$env:userprofile\.gradle\wrapper\dists" -recurse -filter gradle.bat | ? fullname -match "gradle-$([regex]::escape($v))-" | select -first 1; $t='run'+[char]67+'lient'; & $g.fullname $t


