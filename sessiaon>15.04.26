src/main/java/meteordevelopment/meteorclient/gui/morzh/MorzhAnimUtil.java

java

/*
 * Morzh Client
 *
 * Animation behavior independently implemented after studying:
 * - Meteor Client (GPLv3)
 * - ThunderHack Recode (GPLv3)
 * - Rasty Client metadata declares MIT
 * - Rockstar Client visual behavior
 */

package meteordevelopment.meteorclient.gui.morzh;

public final class MorzhAnimUtil {
    private static final float DEFAULT_DELTA = 1.0f / 60.0f;
    private static final float MAX_DELTA = 0.05f;

    private static long lastFrameNanos;
    private static float frameDelta = DEFAULT_DELTA;

    private MorzhAnimUtil() {
    }

    public static float beginFrame() {
        long now = System.nanoTime();

        if (lastFrameNanos == 0L) {
            lastFrameNanos = now;
            frameDelta = DEFAULT_DELTA;
            return frameDelta;
        }

        frameDelta = (now - lastFrameNanos) / 1_000_000_000.0f;
        lastFrameNanos = now;

        if (!Float.isFinite(frameDelta) || frameDelta <= 0.0f) {
            frameDelta = DEFAULT_DELTA;
        }

        frameDelta = Math.min(frameDelta, MAX_DELTA);
        return frameDelta;
    }

    public static float frameDelta() {
        return frameDelta;
    }

    public static float approach(
        float current,
        float target,
        float responsiveness,
        float deltaSeconds
    ) {
        if (!Float.isFinite(current)) return target;
        if (!Float.isFinite(target)) return current;

        float difference = target - current;

        if (Math.abs(difference) <= 0.0005f) {
            return target;
        }

        float safeResponsiveness = Math.max(0.0f, responsiveness);
        float safeDelta = Math.max(0.0f, Math.min(deltaSeconds, MAX_DELTA));

        float factor = 1.0f - (float) Math.exp(
            -safeResponsiveness * safeDelta
        );

        return current + difference * clamp01(factor);
    }

    public static double approach(
        double current,
        double target,
        double responsiveness,
        double deltaSeconds
    ) {
        if (!Double.isFinite(current)) return target;
        if (!Double.isFinite(target)) return current;

        double difference = target - current;

        if (Math.abs(difference) <= 0.0005) {
            return target;
        }

        double safeResponsiveness = Math.max(0.0, responsiveness);
        double safeDelta = Math.max(0.0, Math.min(deltaSeconds, MAX_DELTA));

        double factor = 1.0 - Math.exp(
            -safeResponsiveness * safeDelta
        );

        return current + difference * clamp01(factor);
    }

    /*
     * Compatibility method for existing Morzh code.
     * Smaller divisor remains faster, matching the previous API.
     */
    public static float fast(
        float current,
        float target,
        float speed
    ) {
        float divisor = Math.max(1.0f, speed);
        float responsiveness = 60.0f / divisor;

        return approach(
            current,
            target,
            responsiveness,
            frameDelta
        );
    }

    public static double fast(
        double current,
        double target,
        double speed
    ) {
        double divisor = Math.max(1.0, speed);
        double responsiveness = 60.0 / divisor;

        return approach(
            current,
            target,
            responsiveness,
            frameDelta
        );
    }

    public static float lerp(float from, float to, float progress) {
        return from + (to - from) * clamp01(progress);
    }

    public static double lerp(
        double from,
        double to,
        double progress
    ) {
        return from + (to - from) * clamp01(progress);
    }

    public static float easeOutQuad(float value) {
        float t = clamp01(value);
        return 1.0f - (1.0f - t) * (1.0f - t);
    }

    public static float easeOutCubic(float value) {
        float t = clamp01(value);
        float inverse = 1.0f - t;

        return 1.0f - inverse * inverse * inverse;
    }

    public static float easeInOutCubic(float value) {
        float t = clamp01(value);

        if (t < 0.5f) {
            return 4.0f * t * t * t;
        }

        float inverse = -2.0f * t + 2.0f;
        return 1.0f - inverse * inverse * inverse / 2.0f;
    }

    public static float easeOutQuart(float value) {
        float t = clamp01(value);
        float inverse = 1.0f - t;

        return 1.0f - inverse * inverse * inverse * inverse;
    }

    public static float easeOutBack(float value) {
        float t = clamp01(value);
        float c1 = 1.70158f;
        float c3 = c1 + 1.0f;
        float shifted = t - 1.0f;

        return 1.0f
            + c3 * shifted * shifted * shifted
            + c1 * shifted * shifted;
    }

    public static float clamp01(float value) {
        return Math.max(0.0f, Math.min(1.0f, value));
    }

    public static double clamp01(double value) {
        return Math.max(0.0, Math.min(1.0, value));
    }
}


src/main/java/meteordevelopment/meteorclient/gui/screens/morzh/MorzhThunderScreen.java

java

/*
 * Morzh Client GUI.
 *
 * ThunderHack-inspired Dashboard and Classic layouts.
 * Interaction ideas inspired by Rockstar Client.
 *
 * Animation behavior independently implemented after studying
 * Meteor Client, ThunderHack Recode and Rasty Client.
 */

package meteordevelopment.meteorclient.gui.screens.morzh;

import meteordevelopment.meteorclient.gui.GuiThemes;
import meteordevelopment.meteorclient.gui.morzh.MorzhAnimUtil;
import meteordevelopment.meteorclient.systems.config.Config;
import meteordevelopment.meteorclient.systems.modules.Category;
import meteordevelopment.meteorclient.systems.modules.Module;
import meteordevelopment.meteorclient.systems.modules.Modules;
import meteordevelopment.meteorclient.utils.sound.MorzhSoundManager;
import net.minecraft.client.gui.DrawContext;
import net.minecraft.client.gui.screen.Screen;
import net.minecraft.text.Text;
import net.minecraft.util.math.MathHelper;
import org.lwjgl.glfw.GLFW;

import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Locale;
import java.util.Map;

public class MorzhThunderScreen extends Screen {
    private static final int BACKGROUND = 0xFF18141E;
    private static final int PANEL = 0xFF211B29;
    private static final int CONTENT = 0xFF251D2D;
    private static final int CARD = 0xFF302638;
    private static final int CARD_HOVER = 0xFF40314A;

    private static final int ACCENT = 0xFF9A5CE0;
    private static final int ACCENT_DARK = 0xFF684093;

    private static final int TEXT = 0xFFF3ECFA;
    private static final int TEXT_SECONDARY = 0xFFA89CAE;
    private static final int GREEN = 0xFF72D69B;
    private static final int RED = 0xFFE06C75;

    private static final float OPEN_SPEED = 14.0f;
    private static final float CLOSE_SPEED = 18.0f;
    private static final float HOVER_SPEED = 14.0f;
    private static final float TOGGLE_SPEED = 11.0f;
    private static final float SCROLL_SPEED = 14.0f;
    private static final float LAYOUT_SPEED = 12.0f;
    private static final float CATEGORY_SPEED = 16.0f;

    private final Map<Module, Float> hoverAnimations =
        new HashMap<>();

    private final Map<Module, Float> toggleAnimations =
        new HashMap<>();

    private Layout layout = Layout.Thunder;
    private Layout previousLayout = Layout.Thunder;

    private Category selectedCategory;
    private Module selectedModule;
    private Module hoveredModule;

    private int panelX;
    private int panelY;
    private int panelWidth;
    private int panelHeight;

    private int dragOffsetX;
    private int dragOffsetY;

    private boolean positioned;
    private boolean dragging;
    private boolean searching;
    private boolean closing;

    private float frameDelta = 1.0f / 60.0f;
    private float animation;
    private float layoutTransition = 1.0f;
    private float moduleListAnimation = 1.0f;

    private float moduleScroll;
    private float moduleTargetScroll;

    private float classicScroll;
    private float classicTargetScroll;

    private float categoryIndicatorY = Float.NaN;

    private float thunderTabHover;
    private float classicTabHover;
    private float searchHover;

    private String search = "";

    public MorzhThunderScreen() {
        super(Text.literal("Morzh Client"));
    }

    @Override
    protected void init() {
        panelWidth = Math.min(440, width - 12);
        panelHeight = Math.min(245, height - 12);

        if (!positioned) {
            panelX = (width - panelWidth) / 2;
            panelY = (height - panelHeight) / 2;
            positioned = true;
        } else {
            clampPanelPosition();
        }

        if (selectedCategory == null) {
            for (Category category : Modules.loopCategories()) {
                if (hasVisibleModules(category)) {
                    selectedCategory = category;
                    break;
                }
            }
        }

        animation = 0.0f;
        closing = false;
        dragging = false;

        layoutTransition = 1.0f;
        previousLayout = layout;

        MorzhSoundManager.playOpen();
    }

    @Override
    public boolean shouldPause() {
        return false;
    }

    @Override
    public void render(
        DrawContext context,
        int mouseX,
        int mouseY,
        float delta
    ) {
        frameDelta = MorzhAnimUtil.beginFrame();

        updateDragging(mouseX, mouseY);
        updateAnimations();

        if (closing && animation <= 0.008f) {
            if (client != null) {
                client.setScreen(null);
            }

            return;
        }

        float easedOpen =
            MorzhAnimUtil.easeOutQuart(animation);

        int dimAlpha = Math.round(176.0f * easedOpen);
        int dimColor = dimAlpha << 24;

        context.fill(0, 0, width, height, dimColor);

        int originalPanelY = panelY;

        int slideOffset = Math.round(
            (1.0f - easedOpen) * 12.0f
        );

        panelY = originalPanelY + slideOffset;

        int revealHeight = Math.max(
            1,
            Math.round(panelHeight * easedOpen)
        );

        int revealTop =
            panelY + (panelHeight - revealHeight) / 2;

        context.enableScissor(
            panelX,
            revealTop,
            panelX + panelWidth,
            revealTop + revealHeight
        );

        renderGui(context, mouseX, mouseY);

        context.disableScissor();

        panelY = originalPanelY;

        super.render(context, mouseX, mouseY, delta);
    }

    private void updateAnimations() {
        float openTarget = closing ? 0.0f : 1.0f;

        animation = MorzhAnimUtil.approach(
            animation,
            openTarget,
            closing ? CLOSE_SPEED : OPEN_SPEED,
            frameDelta
        );

        if (!closing && animation >= 0.999f) {
            animation = 1.0f;
        }

        if (closing && animation <= 0.008f) {
            animation = 0.0f;
        }

        layoutTransition = MorzhAnimUtil.approach(
            layoutTransition,
            1.0f,
            LAYOUT_SPEED,
            frameDelta
        );

        if (layoutTransition >= 0.998f) {
            layoutTransition = 1.0f;
            previousLayout = layout;
        }

        moduleListAnimation = MorzhAnimUtil.approach(
            moduleListAnimation,
            1.0f,
            LAYOUT_SPEED,
            frameDelta
        );

        if (moduleListAnimation >= 0.998f) {
            moduleListAnimation = 1.0f;
        }
    }

    private void updateDragging(int mouseX, int mouseY) {
        if (!dragging) return;

        panelX = mouseX - dragOffsetX;
        panelY = mouseY - dragOffsetY;

        clampPanelPosition();
    }

    private void clampPanelPosition() {
        panelX = MathHelper.clamp(
            panelX,
            -panelWidth + 60,
            width - 60
        );

        panelY = MathHelper.clamp(
            panelY,
            0,
            Math.max(0, height - 25)
        );

        int snapDistance = 8;

        if (Math.abs(panelX) <= snapDistance) {
            panelX = 0;
        }

        if (Math.abs(panelY) <= snapDistance) {
            panelY = 0;
        }

        if (Math.abs(
            panelX + panelWidth - width
        ) <= snapDistance) {
            panelX = width - panelWidth;
        }

        if (Math.abs(
            panelY + panelHeight - height
        ) <= snapDistance) {
            panelY = height - panelHeight;
        }
    }

    private void renderGui(
        DrawContext context,
        int mouseX,
        int mouseY
    ) {
        hoveredModule = null;

        roundedRect(
            context,
            panelX,
            panelY,
            panelWidth,
            panelHeight,
            8,
            BACKGROUND
        );

        renderHeader(context, mouseX, mouseY);
        renderLayoutContent(context, mouseX, mouseY);

        if (hoveredModule != null
            && hoveredModule.description != null
            && !hoveredModule.description.isBlank()) {
            context.drawText(
                textRenderer,
                shorten(hoveredModule.description, 58),
                panelX + 10,
                panelY + panelHeight - 12,
                TEXT_SECONDARY,
                false
            );
        }
    }

    private void renderLayoutContent(
        DrawContext context,
        int mouseX,
        int mouseY
    ) {
        if (layoutTransition >= 1.0f) {
            renderLayout(
                context,
                layout,
                mouseX,
                mouseY,
                0
            );

            return;
        }

        float eased = MorzhAnimUtil.easeInOutCubic(
            layoutTransition
        );

        int direction =
            layout == Layout.Classic ? 1 : -1;

        int outgoingOffset = Math.round(
            -direction * eased * panelWidth
        );

        int incomingOffset = Math.round(
            direction * (1.0f - eased) * panelWidth
        );

        context.enableScissor(
            panelX + 5,
            panelY + 39,
            panelX + panelWidth - 5,
            panelY + panelHeight - 5
        );

        renderLayout(
            context,
            previousLayout,
            Integer.MIN_VALUE / 4,
            Integer.MIN_VALUE / 4,
            outgoingOffset
        );

        renderLayout(
            context,
            layout,
            Integer.MIN_VALUE / 4,
            Integer.MIN_VALUE / 4,
            incomingOffset
        );

        context.disableScissor();
    }

    private void renderLayout(
        DrawContext context,
        Layout targetLayout,
        int mouseX,
        int mouseY,
        int offsetX
    ) {
        int originalPanelX = panelX;
        panelX += offsetX;

        if (targetLayout == Layout.Thunder) {
            renderThunder(context, mouseX, mouseY);
        } else {
            renderClassic(context, mouseX, mouseY);
        }

        panelX = originalPanelX;
    }

    private void renderHeader(
        DrawContext context,
        int mouseX,
        int mouseY
    ) {
        roundedRect(
            context,
            panelX + 5,
            panelY + 5,
            panelWidth - 10,
            30,
            6,
            PANEL
        );

        context.fill(
            panelX + 7,
            panelY + 33,
            panelX + panelWidth - 7,
            panelY + 34,
            ACCENT_DARK
        );

        context.drawText(
            textRenderer,
            "MORZH",
            panelX + 13,
            panelY + 12,
            TEXT,
            true
        );

        context.drawText(
            textRenderer,
            "CLIENT",
            panelX + 51,
            panelY + 12,
            ACCENT,
            true
        );

        boolean thunderHovered = inside(
            mouseX,
            mouseY,
            panelX + 95,
            panelY + 10,
            48,
            18
        );

        boolean classicHovered = inside(
            mouseX,
            mouseY,
            panelX + 147,
            panelY + 10,
            45,
            18
        );

        thunderTabHover = MorzhAnimUtil.approach(
            thunderTabHover,
            thunderHovered ? 1.0f : 0.0f,
            HOVER_SPEED,
            frameDelta
        );

        classicTabHover = MorzhAnimUtil.approach(
            classicTabHover,
            classicHovered ? 1.0f : 0.0f,
            HOVER_SPEED,
            frameDelta
        );

        renderLayoutButton(
            context,
            "Thunder",
            panelX + 95,
            panelY + 10,
            48,
            layout == Layout.Thunder,
            thunderTabHover
        );

        renderLayoutButton(
            context,
            "Classic",
            panelX + 147,
            panelY + 10,
            45,
            layout == Layout.Classic,
            classicTabHover
        );

        if (layout == Layout.Thunder) {
            renderSearch(context, mouseX, mouseY);
        }
    }

    private void renderLayoutButton(
        DrawContext context,
        String text,
        int x,
        int y,
        int buttonWidth,
        boolean selected,
        float hover
    ) {
        int color = selected
            ? blend(
                CARD_HOVER,
                ACCENT_DARK,
                MorzhAnimUtil.easeOutCubic(
                    layoutTransition
                )
            )
            : blend(CARD, CARD_HOVER, hover);

        roundedRect(
            context,
            x,
            y,
            buttonWidth,
            18,
            4,
            color
        );

        if (selected) {
            int indicatorWidth = Math.max(
                2,
                Math.round(
                    buttonWidth
                        * MorzhAnimUtil.easeOutCubic(
                            layoutTransition
                        )
                )
            );

            context.fill(
                x,
                y + 16,
                x + indicatorWidth,
                y + 18,
                ACCENT
            );
        }

        context.drawText(
            textRenderer,
            text,
            x + 5,
            y + 5,
            selected ? TEXT : TEXT_SECONDARY,
            false
        );
    }

    private void renderSearch(
        DrawContext context,
        int mouseX,
        int mouseY
    ) {
        int searchWidth = Math.min(
            137,
            panelWidth / 3
        );

        int searchX =
            panelX + panelWidth - searchWidth - 12;

        int searchY = panelY + 11;

        boolean hovered = inside(
            mouseX,
            mouseY,
            searchX,
            searchY,
            searchWidth,
            17
        );

        searchHover = MorzhAnimUtil.approach(
            searchHover,
            searching || hovered ? 1.0f : 0.0f,
            HOVER_SPEED,
            frameDelta
        );

        roundedRect(
            context,
            searchX,
            searchY,
            searchWidth,
            17,
            4,
            blend(CARD, CARD_HOVER, searchHover)
        );

        if (searching) {
            int underlineWidth = Math.max(
                1,
                Math.round(searchWidth * searchHover)
            );

            context.fill(
                searchX,
                searchY + 15,
                searchX + underlineWidth,
                searchY + 17,
                ACCENT
            );
        }

        String shown;

        if (search.isEmpty()) {
            shown = searching
                ? "Type to search..."
                : "Search modules";
        } else {
            shown = search;
        }

        if (searching
            && (System.currentTimeMillis() / 450L) % 2L == 0L) {
            shown += "_";
        }

        context.drawText(
            textRenderer,
            shorten(shown, 19),
            searchX + 6,
            searchY + 5,
            search.isEmpty()
                ? TEXT_SECONDARY
                : TEXT,
            false
        );
    }

    private void renderThunder(
        DrawContext context,
        int mouseX,
        int mouseY
    ) {
        int contentY = panelY + 40;
        int contentHeight = panelHeight - 46;

        int sidebarX = panelX + 5;
        int sidebarWidth = 92;

        int modulesX = panelX + 102;
        int modulesWidth = 145;

        int infoX = panelX + 252;
        int infoWidth = panelWidth - 257;

        roundedRect(
            context,
            sidebarX,
            contentY,
            sidebarWidth,
            contentHeight,
            6,
            PANEL
        );

        roundedRect(
            context,
            modulesX,
            contentY,
            modulesWidth,
            contentHeight,
            6,
            CONTENT
        );

        roundedRect(
            context,
            infoX,
            contentY,
            infoWidth,
            contentHeight,
            6,
            CONTENT
        );

        renderCategories(
            context,
            mouseX,
            mouseY,
            sidebarX,
            contentY,
            sidebarWidth
        );

        renderModuleList(
            context,
            mouseX,
            mouseY,
            modulesX,
            contentY,
            modulesWidth,
            contentHeight
        );

        renderModuleInfo(
            context,
            infoX,
            contentY,
            infoWidth,
            contentHeight
        );
    }

    private void renderCategories(
        DrawContext context,
        int mouseX,
        int mouseY,
        int x,
        int y,
        int categoryWidth
    ) {
        context.drawText(
            textRenderer,
            "CATEGORIES",
            x + 8,
            y + 8,
            TEXT_SECONDARY,
            false
        );

        int targetY = findSelectedCategoryY(y + 23);

        if (targetY >= 0) {
            if (!Float.isFinite(categoryIndicatorY)) {
                categoryIndicatorY = targetY;
            }

            categoryIndicatorY = MorzhAnimUtil.approach(
                categoryIndicatorY,
                targetY,
                CATEGORY_SPEED,
                frameDelta
            );

            int indicatorY = Math.round(
                categoryIndicatorY
            );

            roundedRect(
                context,
                x + 5,
                indicatorY,
                categoryWidth - 10,
                16,
                3,
                ACCENT_DARK
            );

            context.fill(
                x + 5,
                indicatorY + 3,
                x + 7,
                indicatorY + 13,
                ACCENT
            );
        }

        int categoryY = y + 23;

        for (Category category : Modules.loopCategories()) {
            if (!hasVisibleModules(category)) continue;

            boolean selected =
                category == selectedCategory;

            boolean hovered = inside(
                mouseX,
                mouseY,
                x + 5,
                categoryY,
                categoryWidth - 10,
                16
            );

            if (!selected && hovered) {
                roundedRect(
                    context,
                    x + 5,
                    categoryY,
                    categoryWidth - 10,
                    16,
                    3,
                    CARD_HOVER
                );
            }

            context.drawText(
                textRenderer,
                shorten(category.name, 12),
                x + 11,
                categoryY + 4,
                selected ? TEXT : TEXT_SECONDARY,
                false
            );

            categoryY += 18;

            if (categoryY
                > panelY + panelHeight - 25) {
                break;
            }
        }
    }

    private int findSelectedCategoryY(int startY) {
        int categoryY = startY;

        for (Category category : Modules.loopCategories()) {
            if (!hasVisibleModules(category)) continue;

            if (category == selectedCategory) {
                return categoryY;
            }

            categoryY += 18;
        }

        return -1;
    }

    private void renderModuleList(
        DrawContext context,
        int mouseX,
        int mouseY,
        int x,
        int y,
        int listWidth,
        int listHeight
    ) {
        List<Module> modules = getDisplayedModules();

        context.drawText(
            textRenderer,
            search.isEmpty()
                && selectedCategory != null
                ? selectedCategory.name.toUpperCase(
                    Locale.ROOT
                )
                : "SEARCH RESULTS",
            x + 8,
            y + 8,
            TEXT_SECONDARY,
            false
        );

        int listTop = y + 22;
        int listBottom = y + listHeight - 6;

        int totalHeight = modules.size() * 32;
        int visibleHeight = listBottom - listTop;

        float minimumScroll = Math.min(
            0,
            visibleHeight - totalHeight
        );

        moduleTargetScroll = MathHelper.clamp(
            moduleTargetScroll,
            minimumScroll,
            0.0f
        );

        moduleScroll = MathHelper.clamp(
            moduleScroll,
            minimumScroll,
            0.0f
        );

        moduleScroll = MorzhAnimUtil.approach(
            moduleScroll,
            moduleTargetScroll,
            SCROLL_SPEED,
            frameDelta
        );

        if (Math.abs(
            moduleScroll - moduleTargetScroll
        ) < 0.1f) {
            moduleScroll = moduleTargetScroll;
        }

        float contentProgress =
            MorzhAnimUtil.easeOutCubic(
                moduleListAnimation
            );

        int contentOffset = Math.round(
            (1.0f - contentProgress) * 10.0f
        );

        context.enableScissor(
            x + 3,
            listTop,
            x + listWidth - 3,
            listBottom
        );

        float moduleY = listTop + moduleScroll;

        for (Module module : modules) {
            int renderY = Math.round(moduleY);
            int renderX = x + 6 + contentOffset;
            int renderWidth =
                listWidth - 12 - contentOffset;

            boolean visible =
                renderY + 29 >= listTop
                    && renderY <= listBottom;

            boolean hovered =
                visible
                    && layoutTransition >= 1.0f
                    && inside(
                        mouseX,
                        mouseY,
                        renderX,
                        renderY,
                        renderWidth,
                        28
                    );

            if (hovered) {
                hoveredModule = module;
            }

            if (visible) {
                renderModuleCard(
                    context,
                    module,
                    hovered,
                    module == selectedModule,
                    renderX,
                    renderY,
                    renderWidth,
                    28
                );
            }

            moduleY += 32.0f;
        }

        context.disableScissor();

        if (modules.isEmpty()) {
            context.drawText(
                textRenderer,
                "Nothing found",
                x + 12 + contentOffset,
                listTop + 8,
                TEXT_SECONDARY,
                false
            );
        }
    }

    private void renderModuleInfo(
        DrawContext context,
        int x,
        int y,
        int infoWidth,
        int infoHeight
    ) {
        context.drawText(
            textRenderer,
            "MODULE INFO",
            x + 8,
            y + 8,
            TEXT_SECONDARY,
            false
        );

        if (selectedModule == null) {
            context.drawText(
                textRenderer,
                "Select module",
                x + 10,
                y + 31,
                TEXT,
                false
            );

            context.drawText(
                textRenderer,
                "Left: toggle",
                x + 10,
                y + 48,
                TEXT_SECONDARY,
                false
            );

            context.drawText(
                textRenderer,
                "Right: settings",
                x + 10,
                y + 61,
                TEXT_SECONDARY,
                false
            );

            return;
        }

        roundedRect(
            context,
            x + 7,
            y + 24,
            infoWidth - 14,
            38,
            4,
            CARD
        );

        context.drawText(
            textRenderer,
            shorten(selectedModule.title, 18),
            x + 13,
            y + 31,
            TEXT,
            true
        );

        context.drawText(
            textRenderer,
            selectedModule.isActive()
                ? "ENABLED"
                : "DISABLED",
            x + 13,
            y + 47,
            selectedModule.isActive()
                ? GREEN
                : RED,
            false
        );

        context.drawText(
            textRenderer,
            "Description",
            x + 9,
            y + 76,
            ACCENT,
            false
        );

        List<String> lines = wrap(
            selectedModule.description,
            Math.max(15, (infoWidth - 18) / 6)
        );

        int lineY = y + 90;

        for (String line : lines) {
            if (lineY > y + infoHeight - 43) break;

            context.drawText(
                textRenderer,
                line,
                x + 9,
                lineY,
                TEXT_SECONDARY,
                false
            );

            lineY += 11;
        }

        roundedRect(
            context,
            x + 8,
            y + infoHeight - 30,
            infoWidth - 16,
            20,
            4,
            ACCENT_DARK
        );

        context.drawText(
            textRenderer,
            "Open settings",
            x + 15,
            y + infoHeight - 23,
            TEXT,
            false
        );
    }

    private void renderClassic(
        DrawContext context,
        int mouseX,
        int mouseY
    ) {
        int areaX = panelX + 6;
        int areaY = panelY + 40;
        int areaWidth = panelWidth - 12;
        int areaHeight = panelHeight - 47;

        roundedRect(
            context,
            areaX,
            areaY,
            areaWidth,
            areaHeight,
            6,
            CONTENT
        );

        int categoryCount = getVisibleCategoryCount();
        int totalWidth = Math.max(
            0,
            categoryCount * 110 - 6
        );

        int visibleWidth = areaWidth - 10;

        float minimumScroll = Math.min(
            0,
            visibleWidth - totalWidth
        );

        classicTargetScroll = MathHelper.clamp(
            classicTargetScroll,
            minimumScroll,
            0.0f
        );

        classicScroll = MathHelper.clamp(
            classicScroll,
            minimumScroll,
            0.0f
        );

        classicScroll = MorzhAnimUtil.approach(
            classicScroll,
            classicTargetScroll,
            SCROLL_SPEED,
            frameDelta
        );

        if (Math.abs(
            classicScroll - classicTargetScroll
        ) < 0.1f) {
            classicScroll = classicTargetScroll;
        }

        context.enableScissor(
            areaX,
            areaY,
            areaX + areaWidth,
            areaY + areaHeight
        );

        int columnWidth = 104;
        int columnX =
            areaX + 5 + Math.round(classicScroll);

        for (Category category : Modules.loopCategories()) {
            if (!hasVisibleModules(category)) continue;

            renderClassicCategory(
                context,
                category,
                columnX,
                areaY + 5,
                columnWidth,
                areaHeight - 10,
                mouseX,
                mouseY
            );

            columnX += columnWidth + 6;
        }

        context.disableScissor();

        context.drawText(
            textRenderer,
            "Mouse wheel: scroll categories",
            areaX + 8,
            panelY + panelHeight - 13,
            TEXT_SECONDARY,
            false
        );
    }

    private void renderClassicCategory(
        DrawContext context,
        Category category,
        int x,
        int y,
        int categoryWidth,
        int maxHeight,
        int mouseX,
        int mouseY
    ) {
        roundedRect(
            context,
            x,
            y,
            categoryWidth,
            maxHeight,
            5,
            PANEL
        );

        roundedRect(
            context,
            x,
            y,
            categoryWidth,
            20,
            5,
            ACCENT_DARK
        );

        context.drawText(
            textRenderer,
            shorten(category.name, 14),
            x + 7,
            y + 7,
            TEXT,
            true
        );

        int moduleY = y + 24;

        for (Module module :
            Modules.get().getGroup(category)) {
            if (Config.get()
                .hiddenModules
                .get()
                .contains(module)) {
                continue;
            }

            if (moduleY + 19
                > y + maxHeight - 4) {
                break;
            }

            boolean hovered =
                layoutTransition >= 1.0f
                    && inside(
                        mouseX,
                        mouseY,
                        x + 4,
                        moduleY,
                        categoryWidth - 8,
                        18
                    );

            if (hovered) {
                hoveredModule = module;
            }

            renderModuleCard(
                context,
                module,
                hovered,
                module == selectedModule,
                x + 4,
                moduleY,
                categoryWidth - 8,
                18
            );

            moduleY += 20;
        }
    }

    private void renderModuleCard(
        DrawContext context,
        Module module,
        boolean hovered,
        boolean selected,
        int x,
        int y,
        int cardWidth,
        int cardHeight
    ) {
        float hover = hoverAnimations.getOrDefault(
            module,
            0.0f
        );

        hover = MorzhAnimUtil.approach(
            hover,
            hovered ? 1.0f : 0.0f,
            HOVER_SPEED,
            frameDelta
        );

        hoverAnimations.put(module, hover);

        float active = toggleAnimations.getOrDefault(
            module,
            module.isActive() ? 1.0f : 0.0f
        );

        active = MorzhAnimUtil.approach(
            active,
            module.isActive() ? 1.0f : 0.0f,
            TOGGLE_SPEED,
            frameDelta
        );

        toggleAnimations.put(module, active);

        roundedRect(
            context,
            x,
            y,
            cardWidth,
            cardHeight,
            4,
            blend(
                CARD,
                CARD_HOVER,
                MorzhAnimUtil.easeOutCubic(hover)
            )
        );

        if (selected) {
            context.fill(
                x,
                y + 3,
                x + 2,
                y + cardHeight - 3,
                ACCENT
            );
        }

        if (active > 0.005f) {
            int activeWidth = Math.round(
                cardWidth
                    * MorzhAnimUtil.easeOutCubic(active)
            );

            context.fill(
                x,
                y + cardHeight - 2,
                x + activeWidth,
                y + cardHeight,
                ACCENT
            );
        }

        context.drawText(
            textRenderer,
            shorten(
                module.title,
                cardHeight <= 18 ? 13 : 18
            ),
            x + 6,
            y + (cardHeight <= 18 ? 5 : 6),
            module.isActive()
                ? TEXT
                : blend(
                    TEXT_SECONDARY,
                    TEXT,
                    hover
                ),
            false
        );

        if (cardHeight > 20) {
            context.drawText(
                textRenderer,
                module.isActive() ? "ON" : "OFF",
                x + cardWidth - 24,
                y + 16,
                module.isActive() ? GREEN : RED,
                false
            );
        }
    }

    @Override
    public boolean mouseClicked(
        double mouseX,
        double mouseY,
        int button
    ) {
        if (closing || animation < 0.9f) {
            return true;
        }

        int mx = (int) mouseX;
        int my = (int) mouseY;

        if (button == GLFW.GLFW_MOUSE_BUTTON_LEFT
            && inside(
                mx,
                my,
                panelX + 95,
                panelY + 10,
                48,
                18
            )) {
            switchLayout(Layout.Thunder);
            return true;
        }

        if (button == GLFW.GLFW_MOUSE_BUTTON_LEFT
            && inside(
                mx,
                my,
                panelX + 147,
                panelY + 10,
                45,
                18
            )) {
            switchLayout(Layout.Classic);
            return true;
        }

        if (layoutTransition < 0.98f) {
            return true;
        }

        if (layout == Layout.Thunder) {
            int searchWidth = Math.min(
                137,
                panelWidth / 3
            );

            int searchX =
                panelX + panelWidth
                    - searchWidth
                    - 12;

            if (inside(
                mx,
                my,
                searchX,
                panelY + 11,
                searchWidth,
                17
            )) {
                searching = true;
                MorzhSoundManager.playKeyPress();
                return true;
            }
        }

        if (inside(
            mx,
            my,
            panelX + 5,
            panelY + 5,
            panelWidth - 10,
            30
        )) {
            dragging = true;
            dragOffsetX = mx - panelX;
            dragOffsetY = my - panelY;
            return true;
        }

        if (layout == Layout.Thunder) {
            return clickThunder(mx, my, button);
        }

        return clickClassic(mx, my, button);
    }

    private void switchLayout(Layout newLayout) {
        if (newLayout == layout) return;
        if (layoutTransition < 0.98f) return;

        previousLayout = layout;
        layout = newLayout;
        layoutTransition = 0.0f;

        searching = false;
        hoveredModule = null;

        MorzhSoundManager.playKeyPress();
    }

    private boolean clickThunder(
        int mouseX,
        int mouseY,
        int button
    ) {
        int contentY = panelY + 40;
        int categoryY = contentY + 23;

        for (Category category : Modules.loopCategories()) {
            if (!hasVisibleModules(category)) continue;

            if (inside(
                mouseX,
                mouseY,
                panelX + 10,
                categoryY,
                82,
                16
            )) {
                if (selectedCategory != category) {
                    selectedCategory = category;
                    selectedModule = null;

                    moduleScroll = 0.0f;
                    moduleTargetScroll = 0.0f;
                    moduleListAnimation = 0.0f;

                    search = "";
                    searching = false;

                    MorzhSoundManager.playKeyPress();
                }

                return true;
            }

            categoryY += 18;
        }

        if (moduleListAnimation < 0.85f) {
            return true;
        }

        int modulesX = panelX + 102;
        int listTop = contentY + 22;
        int listBottom = panelY + panelHeight - 12;

        float moduleY = listTop + moduleScroll;

        for (Module module : getDisplayedModules()) {
            int renderY = Math.round(moduleY);

            if (renderY + 29 >= listTop
                && renderY <= listBottom
                && inside(
                    mouseX,
                    mouseY,
                    modulesX + 6,
                    renderY,
                    133,
                    28
                )) {
                activateModule(module, button);
                return true;
            }

            moduleY += 32.0f;
        }

        int infoX = panelX + 252;
        int infoWidth = panelWidth - 257;
        int contentHeight = panelHeight - 46;

        if (selectedModule != null
            && inside(
                mouseX,
                mouseY,
                infoX + 8,
                contentY + contentHeight - 30,
                infoWidth - 16,
                20
            )) {
            openSettings(selectedModule);
            return true;
        }

        searching = false;
        return false;
    }

    private boolean clickClassic(
        int mouseX,
        int mouseY,
        int button
    ) {
        int areaX = panelX + 6;
        int areaY = panelY + 40;
        int areaHeight = panelHeight - 47;

        int columnWidth = 104;
        int columnX =
            areaX + 5 + Math.round(classicScroll);

        for (Category category : Modules.loopCategories()) {
            if (!hasVisibleModules(category)) continue;

            int moduleY = areaY + 29;

            for (Module module :
                Modules.get().getGroup(category)) {
                if (Config.get()
                    .hiddenModules
                    .get()
                    .contains(module)) {
                    continue;
                }

                if (moduleY + 19
                    > areaY + areaHeight - 4) {
                    break;
                }

                if (inside(
                    mouseX,
                    mouseY,
                    columnX + 4,
                    moduleY,
                    columnWidth - 8,
                    18
                )) {
                    activateModule(module, button);
                    return true;
                }

                moduleY += 20;
            }

            columnX += columnWidth + 6;
        }

        return false;
    }

    private void activateModule(
        Module module,
        int button
    ) {
        selectedModule = module;

        if (button == GLFW.GLFW_MOUSE_BUTTON_LEFT) {
            module.toggle();

            MorzhSoundManager.playModuleState(
                module.isActive()
            );
        } else if (
            button == GLFW.GLFW_MOUSE_BUTTON_RIGHT
        ) {
            openSettings(module);
        }
    }

    private void openSettings(Module module) {
        MorzhSoundManager.playBoolean();

        if (client != null) {
            client.setScreen(
                GuiThemes.get().moduleScreen(module)
            );
        }
    }

    @Override
    public boolean mouseReleased(
        double mouseX,
        double mouseY,
        int button
    ) {
        dragging = false;

        return super.mouseReleased(
            mouseX,
            mouseY,
            button
        );
    }

    @Override
    public boolean mouseScrolled(
        double mouseX,
        double mouseY,
        double horizontalAmount,
        double verticalAmount
    ) {
        if (closing || layoutTransition < 0.98f) {
            return true;
        }

        if (layout == Layout.Classic) {
            classicTargetScroll +=
                (float) verticalAmount * 35.0f;

            MorzhSoundManager.playScroll();
            return true;
        }

        if (inside(
            mouseX,
            mouseY,
            panelX + 102,
            panelY + 40,
            145,
            panelHeight - 46
        )) {
            moduleTargetScroll +=
                (float) verticalAmount * 28.0f;

            MorzhSoundManager.playScroll();
            return true;
        }

        return super.mouseScrolled(
            mouseX,
            mouseY,
            horizontalAmount,
            verticalAmount
        );
    }

    @Override
    public boolean keyPressed(
        int keyCode,
        int scanCode,
        int modifiers
    ) {
        if (keyCode == GLFW.GLFW_KEY_ESCAPE) {
            if (searching) {
                searching = false;
                MorzhSoundManager.playKeyRelease();
                return true;
            }

            if (!closing) {
                closing = true;
                dragging = false;
                MorzhSoundManager.playClose();
            }

            return true;
        }

        if (closing) return true;

        if (searching) {
            if (keyCode == GLFW.GLFW_KEY_ENTER
                || keyCode == GLFW.GLFW_KEY_KP_ENTER) {
                searching = false;
                MorzhSoundManager.playKeyRelease();
                return true;
            }

            if (keyCode == GLFW.GLFW_KEY_BACKSPACE) {
                if (!search.isEmpty()) {
                    search = search.substring(
                        0,
                        search.length() - 1
                    );

                    moduleTargetScroll = 0.0f;
                    MorzhSoundManager.playKeyRelease();
                }

                return true;
            }
        }

        return super.keyPressed(
            keyCode,
            scanCode,
            modifiers
        );
    }

    @Override
    public boolean charTyped(
        char chr,
        int modifiers
    ) {
        if (searching
            && !Character.isISOControl(chr)
            && search.length() < 40) {
            search += chr;
            moduleTargetScroll = 0.0f;

            MorzhSoundManager.playKeyPress();
            return true;
        }

        return super.charTyped(chr, modifiers);
    }

    private List<Module> getDisplayedModules() {
        List<Module> modules = new ArrayList<>();

        String query = search
            .trim()
            .toLowerCase(Locale.ROOT);

        for (Module module : Modules.get().getAll()) {
            if (Config.get()
                .hiddenModules
                .get()
                .contains(module)) {
                continue;
            }

            if (!query.isEmpty()) {
                boolean matches =
                    module.name
                        .toLowerCase(Locale.ROOT)
                        .contains(query)
                    || module.title
                        .toLowerCase(Locale.ROOT)
                        .contains(query)
                    || module.description != null
                        && module.description
                        .toLowerCase(Locale.ROOT)
                        .contains(query);

                if (matches) {
                    modules.add(module);
                }
            } else if (
                selectedCategory != null
                    && Modules.get()
                    .getGroup(selectedCategory)
                    .contains(module)
            ) {
                modules.add(module);
            }
        }

        modules.sort(
            (first, second) ->
                String.CASE_INSENSITIVE_ORDER.compare(
                    first.title,
                    second.title
                )
        );

        return modules;
    }

    private int getVisibleCategoryCount() {
        int count = 0;

        for (Category category : Modules.loopCategories()) {
            if (hasVisibleModules(category)) {
                count++;
            }
        }

        return count;
    }

    private boolean hasVisibleModules(
        Category category
    ) {
        for (Module module :
            Modules.get().getGroup(category)) {
            if (!Config.get()
                .hiddenModules
                .get()
                .contains(module)) {
                return true;
            }
        }

        return false;
    }

    private static boolean inside(
        double mouseX,
        double mouseY,
        double x,
        double y,
        double targetWidth,
        double targetHeight
    ) {
        return mouseX >= x
            && mouseX <= x + targetWidth
            && mouseY >= y
            && mouseY <= y + targetHeight;
    }

    private static void roundedRect(
        DrawContext context,
        int x,
        int y,
        int rectWidth,
        int rectHeight,
        int radius,
        int color
    ) {
        if (rectWidth <= 0 || rectHeight <= 0) {
            return;
        }

        radius = Math.min(
            radius,
            Math.min(rectWidth / 2, rectHeight / 2)
        );

        context.fill(
            x + radius,
            y,
            x + rectWidth - radius,
            y + rectHeight,
            color
        );

        context.fill(
            x,
            y + radius,
            x + rectWidth,
            y + rectHeight - radius,
            color
        );

        for (int i = 0; i < radius; i++) {
            int inset = radius - i;

            context.fill(
                x + inset,
                y + i,
                x + rectWidth - inset,
                y + i + 1,
                color
            );

            context.fill(
                x + inset,
                y + rectHeight - i - 1,
                x + rectWidth - inset,
                y + rectHeight - i,
                color
            );
        }
    }

    private static int blend(
        int first,
        int second,
        float progress
    ) {
        progress = MorzhAnimUtil.clamp01(progress);

        int a1 = first >>> 24;
        int r1 = first >> 16 & 255;
        int g1 = first >> 8 & 255;
        int b1 = first & 255;

        int a2 = second >>> 24;
        int r2 = second >> 16 & 255;
        int g2 = second >> 8 & 255;
        int b2 = second & 255;

        int a = Math.round(
            a1 + (a2 - a1) * progress
        );

        int r = Math.round(
            r1 + (r2 - r1) * progress
        );

        int g = Math.round(
            g1 + (g2 - g1) * progress
        );

        int b = Math.round(
            b1 + (b2 - b1) * progress
        );

        return a << 24 | r << 16 | g << 8 | b;
    }

    private static String shorten(
        String text,
        int maxLength
    ) {
        if (text == null) return "";
        if (text.length() <= maxLength) return text;

        return text.substring(
            0,
            Math.max(0, maxLength - 3)
        ) + "...";
    }

    private static List<String> wrap(
        String text,
        int maxLength
    ) {
        List<String> lines = new ArrayList<>();

        if (text == null || text.isBlank()) {
            lines.add("No description.");
            return lines;
        }

        StringBuilder line = new StringBuilder();

        for (String word : text.split("\\s+")) {
            if (line.length() > 0
                && line.length()
                    + word.length()
                    + 1
                    > maxLength) {
                lines.add(line.toString());
                line.setLength(0);
            }

            if (line.length() > 0) {
                line.append(' ');
            }

            line.append(word);
        }

        if (!line.isEmpty()) {
            lines.add(line.toString());
        }

        return lines;
    }

    private enum Layout {
        Thunder,
        Classic
    }
}


src/main/java/meteordevelopment/meteorclient/utils/sound/MorzhSoundManager.java

java

/*
 * Morzh Client sound manager.
 *
 * Sound asset attribution must remain in THIRD_PARTY_NOTICES.md.
 */

package meteordevelopment.meteorclient.utils.sound;

import net.minecraft.client.MinecraftClient;
import net.minecraft.client.sound.PositionedSoundInstance;
import net.minecraft.sound.SoundEvent;
import net.minecraft.util.Identifier;

public final class MorzhSoundManager {
    private static final String NAMESPACE = "morzh-client";

    private static final SoundEvent GUI_OPEN =
        event("gui.open");

    private static final SoundEvent GUI_CLOSE =
        event("gui.close");

    private static final SoundEvent GUI_BOOLEAN =
        event("gui.boolean");

    private static final SoundEvent GUI_SCROLL =
        event("gui.scroll");

    private static final SoundEvent GUI_KEYPRESS =
        event("gui.keypress");

    private static final SoundEvent GUI_KEYRELEASE =
        event("gui.keyrelease");

    private static final SoundEvent MODULE_ENABLE =
        event("module.enable");

    private static final SoundEvent MODULE_DISABLE =
        event("module.disable");

    private static final SoundEvent COMBAT_METALLIC =
        event("combat.metallic");

    private static final SoundEvent COMBAT_SKEET =
        event("combat.skeet");

    private static final SoundEvent COMBAT_CRIT =
        event("combat.crit");

    private static final SoundEvent COMBAT_BONK =
        event("combat.bonk");

    private static long lastScrollSoundNanos;

    private MorzhSoundManager() {
    }

    private static SoundEvent event(String path) {
        return SoundEvent.of(
            Identifier.of(NAMESPACE, path)
        );
    }

    private static void play(
        SoundEvent event,
        float pitch
    ) {
        MinecraftClient client =
            MinecraftClient.getInstance();

        if (client == null
            || client.getSoundManager() == null) {
            return;
        }

        client.getSoundManager().play(
            PositionedSoundInstance.master(
                event,
                pitch
            )
        );
    }

    public static void playOpen() {
        play(GUI_OPEN, 1.0f);
    }

    public static void playClose() {
        play(GUI_CLOSE, 1.0f);
    }

    public static void playBoolean() {
        play(GUI_BOOLEAN, 1.0f);
    }

    public static void playScroll() {
        long now = System.nanoTime();
        long debounceNanos = 50_000_000L;

        if (now - lastScrollSoundNanos
            < debounceNanos) {
            return;
        }

        lastScrollSoundNanos = now;
        play(GUI_SCROLL, 1.0f);
    }

    public static void playKeyPress() {
        play(GUI_KEYPRESS, 1.0f);
    }

    public static void playKeyRelease() {
        play(GUI_KEYRELEASE, 1.0f);
    }

    public static void playModuleEnable() {
        play(MODULE_ENABLE, 1.0f);
    }

    public static void playModuleDisable() {
        play(MODULE_DISABLE, 1.0f);
    }

    public static void playModuleState(
        boolean enabled
    ) {
        if (enabled) {
            playModuleEnable();
        } else {
            playModuleDisable();
        }
    }

    public static void playMetallic() {
        play(COMBAT_METALLIC, 1.0f);
    }

    public static void playSkeet() {
        play(COMBAT_SKEET, 1.0f);
    }

    public static void playCrit() {
        play(COMBAT_CRIT, 1.0f);
    }

    public static void playBonk() {
        play(COMBAT_BONK, 1.0f);
    }
}


