Получил. Вижу несколько важных моментов:

    MorzhAnimUtil.fast() зависит от FPS и может дёргаться при смене направления — заменим на delta-time анимацию.
    MorzhClassicScreen и MorzhDashboardScreen пока заглушки.
    Их renderBackground() снова включает Minecraft blur — позже уберём.
    Если OGG лежат в assets/morzh-client/sounds/gui, в sounds.json путь должен быть morzh-client:gui/swipein, без sounds/.


Теперь пришли полностью MorzhThunderScreen.java и MorzhGuiColors.java. Основные анимации будем внедрять именно в экран.

/*

    Morzh Client GUI.
    ThunderHack-inspired Dashboard and Classic layouts.
    Interaction and animation ideas inspired by Rockstar Client.
    Atmospheric background inspired by Celestial. */


package meteordevelopment.meteorclient.gui.screens.morzh;

import meteordevelopment.meteorclient.gui.GuiThemes;
import meteordevelopment.meteorclient.systems.config.Config;
import meteordevelopment.meteorclient.systems.modules.Category;
import meteordevelopment.meteorclient.systems.modules.Module;
import meteordevelopment.meteorclient.systems.modules.Modules;
import net.minecraft.client.gui.DrawContext;
import net.minecraft.client.gui.screen.Screen;
import meteordevelopment.meteorclient.utils.sound.MorzhSoundManager;

import net.minecraft.text.Text;
import net.minecraft.util.math.MathHelper;
import org.lwjgl.glfw.GLFW;

import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Locale;
import java.util.Map;

public class MorzhThunderScreen extends Screen {
private static final int BACKGROUND = 0xFF18141E;
private static final int PANEL = 0xFF211B29;
private static final int CONTENT = 0xFF251D2D;
private static final int CARD = 0xFF302638;
private static final int CARD_HOVER = 0xFF40314A;

private static final int ACCENT = 0xFF9A5CE0;
private static final int ACCENT_DARK = 0xFF684093;

private static final int TEXT = 0xFFF3ECFA;
private static final int TEXT_SECONDARY = 0xFFA89CAE;
private static final int GREEN = 0xFF72D69B;
private static final int RED = 0xFFE06C75;

private final Map<Module, Float> hoverAnimations = new HashMap<>();
private final Map<Module, Float> toggleAnimations = new HashMap<>();

private Layout layout = Layout.Thunder;

private Category selectedCategory;
private Module selectedModule;
private Module hoveredModule;

private int panelX;
private int panelY;
private int panelWidth;
private int panelHeight;

private int dragOffsetX;
private int dragOffsetY;

private boolean positioned;
private boolean dragging;
private boolean searching;
private boolean closing;

private float animation;
private float moduleScroll;
private float classicScroll;

private String search = "";

public MorzhThunderScreen() {
    super(Text.literal("Morzh Client"));
}

@Override
protected void init() {
    panelWidth = Math.min(440, width - 12);
    panelHeight = Math.min(245, height - 12);

    if (!positioned) {
        panelX = (width - panelWidth) / 2;
        panelY = (height - panelHeight) / 2;
        positioned = true;
    }

    if (selectedCategory == null) {
        for (Category category : Modules.loopCategories()) {
            if (hasVisibleModules(category)) {
                selectedCategory = category;
                break;
            }
        }
    }

    animation = 0;
    closing = false;
    MorzhSoundManager.playOpen();
}

@Override
public boolean shouldPause() {
    return false;
}

@Override
public void render(
    DrawContext context,
    int mouseX,
    int mouseY,
    float delta
) {
    context.fill(0, 0, width, height, 0xB0000000);
    if (dragging) {
        panelX = mouseX - dragOffsetX;
        panelY = mouseY - dragOffsetY;

        panelX = MathHelper.clamp(
            panelX,
            -panelWidth + 60,
            width - 60
        );

        panelY = MathHelper.clamp(
            panelY,
            0,
            height - 25
        );
    }

    if (closing) {
        animation += (0 - animation) * 0.28f;

        if (animation <= 0.025f) {
            client.setScreen(null);
            return;
        }
    } else {
        animation += (1 - animation) * 0.22f;

        // Р вЂ™Р В°Р В¶Р Р…Р С•: Р С—Р С•Р В»Р Р…Р С•РЎРѓРЎвЂљРЎРЉРЎР‹ Р С—РЎР‚Р ВµР С”РЎР‚Р В°РЎвЂ°Р В°Р ВµРЎвЂљ Р Т‘РЎР‚Р С•Р В±Р Р…Р С•Р Вµ Р СР В°РЎРѓРЎв‚¬РЎвЂљР В°Р В±Р С‘РЎР‚Р С•Р Р†Р В°Р Р…Р С‘Р Вµ.
        if (animation >= 0.985f) {
            animation = 1;
        }
    }

    animation = MathHelper.clamp(animation, 0, 1);

    if (animation < 1) {
        float eased = easeOutBack(animation);
        float scale = 0.78f + eased * 0.22f;

        float centerX = panelX + panelWidth / 2.0f;
        float centerY = panelY + panelHeight / 2.0f;



        renderGui(context, mouseX, mouseY);

    } else {
        // Р СџРЎР‚Р С‘ animation == 1 scale Р Р†Р С•Р С•Р В±РЎвЂ°Р Вµ Р Р…Р Вµ Р С—РЎР‚Р С‘Р СР ВµР Р…РЎРЏР ВµРЎвЂљРЎРѓРЎРЏ.
        // Р СџР С•РЎРЊРЎвЂљР С•Р СРЎС“ РЎвЂљР ВµР С”РЎРѓРЎвЂљ Р В±Р С•Р В»РЎРЉРЎв‚¬Р Вµ Р Р…Р Вµ РЎР‚Р В°Р В·Р СРЎвЂ№Р Р†Р В°Р ВµРЎвЂљРЎРѓРЎРЏ.
        renderGui(context, mouseX, mouseY);
    }

    super.render(context, mouseX, mouseY, delta);
}

private void renderAtmosphere(DrawContext context) {
    context.fill(0, 0, width, height, 0x7808060B);

    long time = System.currentTimeMillis();

    for (int i = 0; i < 22; i++) {
        double phase = time * 0.00015 + i * 2.17;

        int x = (int) (
            width / 2.0
                + Math.sin(phase) * (width * 0.48)
                + Math.sin(phase * 0.37) * 20
        );

        int y = (int) (
            height / 2.0
                + Math.cos(phase * 0.73) * (height * 0.48)
        );

        int size = 1 + i % 2;
        int alpha = 25 + i % 4 * 8;
        int color = alpha << 24 | 0x009A5CE0;

        context.fill(x, y, x + size, y + size, color);
    }
}

private void renderGui(
    DrawContext context,
    int mouseX,
    int mouseY
) {
    hoveredModule = null;

    roundedRect(
        context,
        panelX,
        panelY,
        panelWidth,
        panelHeight,
        8,
        BACKGROUND
    );

    renderHeader(context, mouseX, mouseY);

    if (layout == Layout.Thunder) {
        renderThunder(context, mouseX, mouseY);
    } else {
        renderClassic(context, mouseX, mouseY);
    }

    if (hoveredModule != null
        && hoveredModule.description != null
        && !hoveredModule.description.isBlank()) {
        context.drawText(
            textRenderer,
            shorten(hoveredModule.description, 58),
            panelX + 10,
            panelY + panelHeight - 12,
            TEXT_SECONDARY,
            false
        );
    }
}

private void renderHeader(
    DrawContext context,
    int mouseX,
    int mouseY
) {
    roundedRect(
        context,
        panelX + 5,
        panelY + 5,
        panelWidth - 10,
        30,
        6,
        PANEL
    );

    context.fill(
        panelX + 7,
        panelY + 33,
        panelX + panelWidth - 7,
        panelY + 34,
        ACCENT_DARK
    );

    context.drawText(
        textRenderer,
        "MORZH",
        panelX + 13,
        panelY + 12,
        TEXT,
        true
    );

    context.drawText(
        textRenderer,
        "CLIENT",
        panelX + 51,
        panelY + 12,
        ACCENT,
        true
    );

    renderLayoutButton(
        context,
        "Thunder",
        panelX + 95,
        panelY + 10,
        48,
        layout == Layout.Thunder,
        mouseX,
        mouseY
    );

    renderLayoutButton(
        context,
        "Classic",
        panelX + 147,
        panelY + 10,
        45,
        layout == Layout.Classic,
        mouseX,
        mouseY
    );

    if (layout == Layout.Thunder) {
        renderSearch(context, mouseX, mouseY);
    }
}

private void renderLayoutButton(
    DrawContext context,
    String text,
    int x,
    int y,
    int width,
    boolean selected,
    int mouseX,
    int mouseY
) {
    boolean hovered = inside(mouseX, mouseY, x, y, width, 18);

    roundedRect(
        context,
        x,
        y,
        width,
        18,
        4,
        selected
            ? ACCENT_DARK
            : hovered ? CARD_HOVER : CARD
    );

    context.drawText(
        textRenderer,
        text,
        x + 5,
        y + 5,
        selected ? TEXT : TEXT_SECONDARY,
        false
    );
}

private void renderSearch(
    DrawContext context,
    int mouseX,
    int mouseY
) {
    int searchWidth = Math.min(137, panelWidth / 3);
    int searchX = panelX + panelWidth - searchWidth - 12;
    int searchY = panelY + 11;

    boolean hovered = inside(
        mouseX,
        mouseY,
        searchX,
        searchY,
        searchWidth,
        17
    );

    roundedRect(
        context,
        searchX,
        searchY,
        searchWidth,
        17,
        4,
        searching || hovered ? CARD_HOVER : CARD
    );

    String shown;

    if (search.isEmpty()) {
        shown = searching ? "Type to search..." : "Search modules";
    } else {
        shown = search;
    }

    if (searching
        && (System.currentTimeMillis() / 450L) % 2L == 0L) {
        shown += "_";
    }

    context.drawText(
        textRenderer,
        shorten(shown, 19),
        searchX + 6,
        searchY + 5,
        search.isEmpty() ? TEXT_SECONDARY : TEXT,
        false
    );
}

// Thunder dashboard

private void renderThunder(
    DrawContext context,
    int mouseX,
    int mouseY
) {
    int contentY = panelY + 40;
    int contentHeight = panelHeight - 46;

    int sidebarX = panelX + 5;
    int sidebarWidth = 92;

    int modulesX = panelX + 102;
    int modulesWidth = 145;

    int infoX = panelX + 252;
    int infoWidth = panelWidth - 257;

    roundedRect(
        context,
        sidebarX,
        contentY,
        sidebarWidth,
        contentHeight,
        6,
        PANEL
    );

    roundedRect(
        context,
        modulesX,
        contentY,
        modulesWidth,
        contentHeight,
        6,
        CONTENT
    );

    roundedRect(
        context,
        infoX,
        contentY,
        infoWidth,
        contentHeight,
        6,
        CONTENT
    );

    renderCategories(
        context,
        mouseX,
        mouseY,
        sidebarX,
        contentY,
        sidebarWidth
    );

    renderModuleList(
        context,
        mouseX,
        mouseY,
        modulesX,
        contentY,
        modulesWidth,
        contentHeight
    );

    renderModuleInfo(
        context,
        infoX,
        contentY,
        infoWidth,
        contentHeight
    );
}

private void renderCategories(
    DrawContext context,
    int mouseX,
    int mouseY,
    int x,
    int y,
    int width
) {
    context.drawText(
        textRenderer,
        "CATEGORIES",
        x + 8,
        y + 8,
        TEXT_SECONDARY,
        false
    );

    int categoryY = y + 23;

    for (Category category : Modules.loopCategories()) {
        if (!hasVisibleModules(category)) continue;

        boolean selected = category == selectedCategory;
        boolean hovered = inside(
            mouseX,
            mouseY,
            x + 5,
            categoryY,
            width - 10,
            16
        );

        if (selected) {
            roundedRect(
                context,
                x + 5,
                categoryY,
                width - 10,
                16,
                3,
                ACCENT_DARK
            );

            context.fill(
                x + 5,
                categoryY + 3,
                x + 7,
                categoryY + 13,
                ACCENT
            );
        } else if (hovered) {
            roundedRect(
                context,
                x + 5,
                categoryY,
                width - 10,
                16,
                3,
                CARD
            );
        }

        context.drawText(
            textRenderer,
            shorten(category.name, 12),
            x + 11,
            categoryY + 4,
            selected ? TEXT : TEXT_SECONDARY,
            false
        );

        categoryY += 18;

        if (categoryY > panelY + panelHeight - 25) break;
    }
}

private void renderModuleList(
    DrawContext context,
    int mouseX,
    int mouseY,
    int x,
    int y,
    int width,
    int height
) {
    List<Module> modules = getDisplayedModules();

    context.drawText(
        textRenderer,
        search.isEmpty() && selectedCategory != null
            ? selectedCategory.name.toUpperCase(Locale.ROOT)
            : "SEARCH RESULTS",
        x + 8,
        y + 8,
        TEXT_SECONDARY,
        false
    );

    int listTop = y + 22;
    int listBottom = y + height - 6;

    int totalHeight = modules.size() * 32;
    int visibleHeight = listBottom - listTop;
    float minimumScroll = Math.min(0, visibleHeight - totalHeight);

    moduleScroll = MathHelper.clamp(
        moduleScroll,
        minimumScroll,
        0
    );

    context.enableScissor(
        x + 3,
        listTop,
        x + width - 3,
        listBottom
    );

    float moduleY = listTop + moduleScroll;

    for (Module module : modules) {
        boolean visible =
            moduleY + 29 >= listTop && moduleY <= listBottom;

        boolean hovered = visible && inside(
            mouseX,
            mouseY,
            x + 6,
            moduleY,
            width - 12,
            28
        );

        if (hovered) hoveredModule = module;

        if (visible) {
            renderModuleCard(
                context,
                module,
                hovered,
                module == selectedModule,
                x + 6,
                (int) moduleY,
                width - 12,
                28
            );
        }

        moduleY += 32;
    }

    context.disableScissor();

    if (modules.isEmpty()) {
        context.drawText(
            textRenderer,
            "Nothing found",
            x + 12,
            listTop + 8,
            TEXT_SECONDARY,
            false
        );
    }
}

private void renderModuleInfo(
    DrawContext context,
    int x,
    int y,
    int width,
    int height
) {
    context.drawText(
        textRenderer,
        "MODULE INFO",
        x + 8,
        y + 8,
        TEXT_SECONDARY,
        false
    );

    if (selectedModule == null) {
        context.drawText(
            textRenderer,
            "Select module",
            x + 10,
            y + 31,
            TEXT,
            false
        );

        context.drawText(
            textRenderer,
            "Left: toggle",
            x + 10,
            y + 48,
            TEXT_SECONDARY,
            false
        );

        context.drawText(
            textRenderer,
            "Right: settings",
            x + 10,
            y + 61,
            TEXT_SECONDARY,
            false
        );

        return;
    }

    roundedRect(
        context,
        x + 7,
        y + 24,
        width - 14,
        38,
        4,
        CARD
    );

    context.drawText(
        textRenderer,
        shorten(selectedModule.title, 18),
        x + 13,
        y + 31,
        TEXT,
        true
    );

    context.drawText(
        textRenderer,
        selectedModule.isActive() ? "ENABLED" : "DISABLED",
        x + 13,
        y + 47,
        selectedModule.isActive() ? GREEN : RED,
        false
    );

    context.drawText(
        textRenderer,
        "Description",
        x + 9,
        y + 76,
        ACCENT,
        false
    );

    List<String> lines = wrap(
        selectedModule.description,
        Math.max(15, (width - 18) / 6)
    );

    int lineY = y + 90;

    for (String line : lines) {
        if (lineY > y + height - 43) break;

        context.drawText(
            textRenderer,
            line,
            x + 9,
            lineY,
            TEXT_SECONDARY,
            false
        );

        lineY += 11;
    }

    roundedRect(
        context,
        x + 8,
        y + height - 30,
        width - 16,
        20,
        4,
        ACCENT_DARK
    );

    context.drawText(
        textRenderer,
        "Open settings",
        x + 15,
        y + height - 23,
        TEXT,
        false
    );
}

// ThunderHack Classic style

