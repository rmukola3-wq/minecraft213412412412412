        );

        return;
    }

    drawSurface(
        context,
        x + 7,
        y + 24,
        infoWidth - 14,
        38,
        4,
        CARD,
        GLASS_CARD,
        true
    );

    drawText(
        context,
        shorten(selectedModule.title, 18),
        x + 13,
        y + 31,
        primaryTextColor(),
        true
    );

    drawText(
        context,
        selectedModule.isActive()
            ? "ENABLED"
            : "DISABLED",
        x + 13,
        y + 47,
        selectedModule.isActive()
            ? GREEN
            : RED,
        false
    );

    drawText(
        context,
        "Description",
        x + 9,
        y + 76,
        ACCENT,
        false
    );

    List<String> lines = wrap(
        selectedModule.description,
        Math.max(15, (infoWidth - 18) / 6)
    );

    int lineY = y + 90;

    for (String line : lines) {
        if (lineY > y + infoHeight - 43) break;

        drawText(
            context,
            line,
            x + 9,
            lineY,
            secondaryTextColor(),
            false
        );

        lineY += 11;
    }

    drawSurface(
        context,
        x + 8,
        y + infoHeight - 30,
        infoWidth - 16,
        20,
        4,
        ACCENT_DARK,
        GLASS_SELECTED,
        true
    );

    drawText(
        context,
        "Open settings",
        x + 15,
        y + infoHeight - 23,
        primaryTextColor(),
        false
    );
}

