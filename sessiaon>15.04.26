powershell

function hs($h) {
    [byte[]]$b=for($i=0;$i-lt $h.length;$i+=2) {
        [convert]::tobyte($h.substring($i,2),16)
    }
    [text.encoding]::utf8.getstring($b)
}

$p='.\src\main\java\meteordevelopment\meteorclient\meteorclient.java'
$s=gc $p -raw
if($s -notmatch 'dev_build') {
    $x=hs '0a202020207075626c6963207374617469632066696e616c20537472696e67204445565f4255494c44203d2022223b0a'
    $s=$s -replace '(public\s+(?:final\s+)?class\s+meteorclient[^{]*\{)',('$1'+$x)
    [io.file]::writealltext($p,$s,[text.utf8encoding]::new($false))
}

$p='.\src\main\java\meteordevelopment\meteorclient\utils\misc\mblockpos.java'
$s=gc $p -raw
if($s -notmatch 'coerceblocklevel') {
    $x=hs ''
    $i=$s.lastindexof('}')
    $s=$s.insert($i,$x)
