    private void renderClassic(
        DrawContext context,
        int mouseX,
        int mouseY
    ) {
        int areaX = panelX + 6;
        int areaY = panelY + 40;
        int areaWidth = panelWidth - 12;
        int areaHeight = panelHeight - 47;

        drawSurface(
            context,
            areaX,
            areaY,
            areaWidth,
            areaHeight,
            6,
            Surface.Content,
            true
        );

        int totalWidth =
            Math.max(0, getVisibleCategoryCount() * 110 - 6);

        int visibleWidth = areaWidth - 10;
        float minimumScroll =
            Math.min(0, visibleWidth - totalWidth);

        classicTargetScroll = MathHelper.clamp(
            classicTargetScroll,
            minimumScroll,
            0.0f
        );

        classicScroll = MathHelper.clamp(
            classicScroll,
            minimumScroll,
            0.0f
        );

        classicScroll = MorzhAnimUtil.approach(
            classicScroll,
            classicTargetScroll,
            SCROLL_SPEED,
            frameDelta
        );

        if (Math.abs(classicScroll - classicTargetScroll) < 0.1f) {
            classicScroll = classicTargetScroll;
        }

        context.enableScissor(
            areaX,
            areaY,
            areaX + areaWidth,
            areaY + areaHeight
        );

        int columnWidth = 104;
        int columnX =
            areaX + 5 + Math.round(classicScroll);

        for (Category category : Modules.loopCategories()) {
            if (!hasVisibleModules(category)) continue;

            renderClassicCategory(
                context,
                category,
                columnX,
                areaY + 5,
                columnWidth,
                areaHeight - 10,
                mouseX,
                mouseY
            );

            columnX += columnWidth + 6;
        }

        context.disableScissor();

        drawText(
            context,
            "Mouse wheel: scroll categories",
            areaX + 8,
            panelY + panelHeight - 13,
            secondaryTextColor(),
            false
        );
    }

    private void renderClassicCategory(
        DrawContext context,
        Category category,
        int x,
        int y,
        int categoryWidth,
        int maxHeight,
        int mouseX,
        int mouseY
    ) {
        drawSurface(
            context,
            x,
            y,
            categoryWidth,
            maxHeight,
            5,
            Surface.Panel,
            true
        );

        drawSurface(
            context,
            x,
            y,
            categoryWidth,
            20,
            5,
            Surface.Selected,
            true
        );

        drawText(
            context,
            shorten(category.name, 14),
            x + 7,
