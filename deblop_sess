    private void renderSearch(
        DrawContext context,
        int mouseX,
        int mouseY
    ) {
        int searchWidth = Math.min(137, panelWidth / 3);
        int searchX = panelX + panelWidth - searchWidth - 12;
        int searchY = panelY + 11;

        boolean hovered = inside(
            mouseX,
            mouseY,
            searchX,
            searchY,
            searchWidth,
            17
        );

        drawSurface(
            context,
            searchX,
            searchY,
            searchWidth,
            17,
            4,
            searching || hovered
                ? Surface.CardHover
                : Surface.Card,
            searching
        );

        String shown;

        if (search.isEmpty()) {
            shown = searching
                ? "Type to search..."
                : "Search modules";
        } else {
            shown = search;
        }

        if (searching
            && (System.currentTimeMillis() / 450L) % 2L == 0L) {
            shown += "_";
        }

        drawText(
            context,
            shorten(shown, 19),
            searchX + 6,
            searchY + 5,
            search.isEmpty()
                ? secondaryTextColor()
                : primaryTextColor(),
            false
        );
    }

    private void renderLayoutContent(
        DrawContext context,
        int mouseX,
        int mouseY
    ) {
        if (layoutTransition >= 1.0f) {
            renderLayout(context, layout, mouseX, mouseY, 0);
            return;
        }

        float eased =
            MorzhAnimUtil.easeInOutCubic(layoutTransition);

        int direction = layout == Layout.Classic ? 1 : -1;
        int outgoingOffset =
            Math.round(-direction * eased * panelWidth);

        int incomingOffset = Math.round(
            direction * (1.0f - eased) * panelWidth
        );

        context.enableScissor(
            panelX + 5,
            panelY + 39,
            panelX + panelWidth - 5,
            panelY + panelHeight - 5
        );

        renderLayout(
            context,
            previousLayout,
            Integer.MIN_VALUE / 4,
            Integer.MIN_VALUE / 4,
            outgoingOffset
        );

        renderLayout(
            context,
            layout,
            Integer.MIN_VALUE / 4,
            Integer.MIN_VALUE / 4,
            incomingOffset
        );

        context.disableScissor();
    }

    private void renderLayout(
        DrawContext context,
        Layout target,
        int mouseX,
        int mouseY,
        int offsetX
    ) {
        int originalX = panelX;
        panelX += offsetX;

        if (target == Layout.Thunder) {
            renderThunder(context, mouseX, mouseY);
        } else {
            renderClassic(context, mouseX, mouseY);
        }

        panelX = originalX;
    }

