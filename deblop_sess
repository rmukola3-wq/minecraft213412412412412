package meteordevelopment.meteorclient.gui.morzh;

public final class MorzhAnimUtil {
private MorzhAnimUtil() {}

public static float fast(float current, float target, float speed) {
    float diff = target - current;
    if (Math.abs(diff) < 0.001f) return target;
    return current + diff / speed;
}

public static double fast(double current, double target, double speed) {
    double diff = target - current;
    if (Math.abs(diff) < 0.001) return target;
    return current + diff / speed;
}

public static float easeOutBack(float t) {
    float c1 = 1.70158f;
    float c3 = c1 + 1;
    return 1 + c3 * (float) Math.pow(t - 1, 3) + c1 * (float) Math.pow(t - 1, 2);
}


