    private void renderClassicCategory(
        DrawContext context,
        Category category,
        int x,
        int y,
        int categoryWidth,
        int maxHeight,
        int mouseX,
        int mouseY
    ) {
        drawSurface(
            context,
            x,
            y,
            categoryWidth,
            maxHeight,
            5,
            PANEL,
            GLASS_PANEL,
            true
        );

        drawSurface(
            context,
            x,
            y,
            categoryWidth,
            20,
            5,
            ACCENT_DARK,
            GLASS_SELECTED,
            true
        );

        drawText(
            context,
            shorten(category.name, 14),
            x + 7,
            y + 7,
            primaryTextColor(),
            true
        );

        int moduleY = y + 24;

        for (Module module :
            Modules.get().getGroup(category)) {
            if (Config.get()
                .hiddenModules
                .get()
                .contains(module)) {
                continue;
            }

            if (moduleY + 19
                > y + maxHeight - 4) {
                break;
            }

            boolean hovered =
                layoutTransition >= 1.0f
                    && inside(
                        mouseX,
                        mouseY,
                        x + 4,
                        moduleY,
                        categoryWidth - 8,
                        18
                    );

            if (hovered) {
                hoveredModule = module;
            }

            renderModuleCard(
                context,
                module,
                hovered,
                module == selectedModule,
                x + 4,
                moduleY,
                categoryWidth - 8,
                18
            );

            moduleY += 20;
        }
