package meteordevelopment.meteorclient.gui.morzh;

import meteordevelopment.meteorclient.gui.themes.morzh.MorzhGuiColors;
import meteordevelopment.meteorclient.utils.render.color.Color;
import net.minecraft.client.gui.DrawContext;
import net.minecraft.client.util.math.MatrixStack;

public final class MorzhRenderUtil {
private MorzhRenderUtil() {}

public static boolean hovered(double mouseX, double mouseY, double x, double y, double w, double h) {
    return mouseX >= x && mouseX <= x + w && mouseY >= y && mouseY <= y + h;
}

public static void fill(DrawContext context, double x, double y, double w, double h, Color color) {
    context.fill((int) x, (int) y, (int) (x + w), (int) (y + h), color.getPacked());
}

public static void panel(DrawContext context, double x, double y, double w, double h) {
    fill(context, x, y, w, h, MorzhGuiColors.PANEL);
    border(context, x, y, w, h, MorzhGuiColors.OUTLINE);
}

public static void border(DrawContext context, double x, double y, double w, double h, Color color) {
    fill(context, x, y, w, 1, color);
    fill(context, x, y + h - 1, w, 1, color);
    fill(context, x, y, 1, h, color);
    fill(context, x + w - 1, y, 1, h, color);
}

public static void gradientBar(DrawContext context, double x, double y, double w, double h, float progress) {
    double fillW = w * Math.max(0, Math.min(1, progress));
    fill(context, x, y, w, h, MorzhGuiColors.SLIDER_TRACK);
    if (fillW > 0) fill(context, x, y, fillW, h, MorzhGuiColors.SLIDER_FILL);
    border(context, x, y, w, h, MorzhGuiColors.OUTLINE);
}

public static void text(DrawContext context, String text, double x, double y, Color color, boolean shadow) {
    MatrixStack matrices = context.getMatrices();
    if (shadow) {
        context.drawTextWithShadow(net.minecraft.client.MinecraftClient.getInstance().textRenderer, text, (int) x, (int) y, color.getPacked());
    } else {
        context.drawText(net.minecraft.client.MinecraftClient.getInstance().textRenderer, text, (int) x, (int) y, color.getPacked(), false);
    }
}

public static void centeredText(DrawContext context, String text, double x, double y, double w, Color color) {
    var tr = net.minecraft.client.MinecraftClient.getInstance().textRenderer;
    int tw = tr.getWidth(text);
    context.drawTextWithShadow(tr, text, (int) (x + (w - tw) / 2), (int) y, color.getPacked());
}

public static int textWidth(String text) {
    return net.minecraft.client.MinecraftClient.getInstance().textRenderer.getWidth(text);
}


}
