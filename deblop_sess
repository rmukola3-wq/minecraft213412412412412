    private void renderClassic(
        DrawContext context,
        int mouseX,
        int mouseY
    ) {
        int areaX = panelX + 6;
        int areaY = panelY + 40;
        int areaWidth = panelWidth - 12;
        int areaHeight = panelHeight - 47;

        drawSurface(
            context,
            areaX,
            areaY,
            areaWidth,
            areaHeight,
            6,
            CONTENT,
            GLASS_CONTENT,
            true
        );

        int categoryCount = getVisibleCategoryCount();

        int totalWidth = Math.max(
            0,
            categoryCount * 110 - 6
        );

        int visibleWidth = areaWidth - 10;

        float minimumScroll = Math.min(
            0,
            visibleWidth - totalWidth
        );

        classicTargetScroll = MathHelper.clamp(
            classicTargetScroll,
            minimumScroll,
            0.0f
        );

        classicScroll = MathHelper.clamp(
            classicScroll,
            minimumScroll,
            0.0f
        );

        classicScroll = MorzhAnimUtil.approach(
            classicScroll,
            classicTargetScroll,
            SCROLL_SPEED,
            frameDelta
        );

        if (Math.abs(
            classicScroll - classicTargetScroll
        ) < 0.1f) {
            classicScroll = classicTargetScroll;
        }

        context.enableScissor(
            areaX,
            areaY,
            areaX + areaWidth,
            areaY + areaHeight
        );

        int columnWidth = 104;

        int columnX =
            areaX + 5 + Math.round(classicScroll);

