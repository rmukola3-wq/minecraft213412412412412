                        * MorzhAnimUtil.easeOutCubic(
                            layoutTransition
                        )
                )
            );

            context.fill(
                x + 2,
                y + 16,
                x + Math.max(2, indicatorWidth - 2),
                y + 18,
                ACCENT
            );
        }

        drawText(
            context,
            label,
            x + 5,
