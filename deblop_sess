    private void renderModuleCard(
        DrawContext context,
        Module module,
        boolean hovered,
        boolean selected,
        int x,
        int y,
        int cardWidth,
        int cardHeight
    ) {
        float hover = hoverAnimations.getOrDefault(
            module,
            0.0f
        );

        hover = MorzhAnimUtil.approach(
            hover,
            hovered ? 1.0f : 0.0f,
            HOVER_SPEED,
            frameDelta
        );

        hoverAnimations.put(module, hover);

        float active = toggleAnimations.getOrDefault(
            module,
            module.isActive() ? 1.0f : 0.0f
        );

        active = MorzhAnimUtil.approach(
            active,
            module.isActive() ? 1.0f : 0.0f,
            TOGGLE_SPEED,
            frameDelta
        );

        toggleAnimations.put(module, active);

        roundedRect(
            context,
            x,
            y,
            cardWidth,
            cardHeight,
            4,
            blend(
                CARD,
                CARD_HOVER,
                MorzhAnimUtil.easeOutCubic(hover)
            )
        );

        if (selected) {
            context.fill(
                x,
                y + 3,
                x + 2,
                y + cardHeight - 3,
                ACCENT
            );
        }

        if (active > 0.005f) {
            int activeWidth = Math.round(
                cardWidth
                    * MorzhAnimUtil.easeOutCubic(active)
            );

            context.fill(
                x,
                y + cardHeight - 2,
                x + activeWidth,
                y + cardHeight,
                ACCENT
            );
        }

        context.drawText(
            textRenderer,
            shorten(
                module.title,
                cardHeight <= 18 ? 13 : 18
            ),
            x + 6,
            y + (cardHeight <= 18 ? 5 : 6),
            module.isActive()
                ? TEXT
                : blend(
                    TEXT_SECONDARY,
                    TEXT,
                    hover
                ),
            false
        );

        if (cardHeight > 20) {
            context.drawText(
                textRenderer,
                module.isActive() ? "ON" : "OFF",
                x + cardWidth - 24,
                y + 16,
                module.isActive() ? GREEN : RED,
                false
            );
        }
    }

    @Override
    public boolean mouseClicked(
        double mouseX,
        double mouseY,
        int button
    ) {
        if (closing || animation < 0.9f) {
            return true;
        }

        int mx = (int) mouseX;
        int my = (int) mouseY;

        if (button == GLFW.GLFW_MOUSE_BUTTON_LEFT
            && inside(
                mx,
                my,
                panelX + 95,
                panelY + 10,
                48,
                18
            )) {
            switchLayout(Layout.Thunder);
            return true;
        }

        if (button == GLFW.GLFW_MOUSE_BUTTON_LEFT
            && inside(
                mx,
                my,
                panelX + 147,
                panelY + 10,
                45,
                18
            )) {
            switchLayout(Layout.Classic);
            return true;
        }

        if (layoutTransition < 0.98f) {
            return true;
        }

        if (layout == Layout.Thunder) {
            int searchWidth = Math.min(
                137,
                panelWidth / 3
            );

            int searchX =
                panelX + panelWidth
                    - searchWidth
                    - 12;

            if (inside(
                mx,
                my,
                searchX,
                panelY + 11,
                searchWidth,
                17
            )) {
                searching = true;
                MorzhSoundManager.playKeyPress();
                return true;
            }
        }

        if (inside(
            mx,
            my,
            panelX + 5,
            panelY + 5,
            panelWidth - 10,
            30
        )) {
            dragging = true;
            dragOffsetX = mx - panelX;
            dragOffsetY = my - panelY;
            return true;
        }

        if (layout == Layout.Thunder) {
            return clickThunder(mx, my, button);
        }

        return clickClassic(mx, my, button);
    }

    private void switchLayout(Layout newLayout) {
        if (newLayout == layout) return;
        if (layoutTransition < 0.98f) return;

        previousLayout = layout;
        layout = newLayout;
        layoutTransition = 0.0f;

        searching = false;
        hoveredModule = null;

        MorzhSoundManager.playKeyPress();
    }

    private boolean clickThunder(
        int mouseX,
        int mouseY,
        int button
    ) {
        int contentY = panelY + 40;
        int categoryY = contentY + 23;

        for (Category category : Modules.loopCategories()) {
            if (!hasVisibleModules(category)) continue;

            if (inside(
                mouseX,
                mouseY,
                panelX + 10,
                categoryY,
                82,
                16
            )) {
                if (selectedCategory != category) {
                    selectedCategory = category;
                    selectedModule = null;

                    moduleScroll = 0.0f;
                    moduleTargetScroll = 0.0f;
                    moduleListAnimation = 0.0f;

                    search = "";
                    searching = false;

                    MorzhSoundManager.playKeyPress();
                }

                return true;
            }

            categoryY += 18;
        }

        if (moduleListAnimation < 0.85f) {
            return true;
        }

        int modulesX = panelX + 102;
        int listTop = contentY + 22;
        int listBottom = panelY + panelHeight - 12;

        float moduleY = listTop + moduleScroll;

        for (Module module : getDisplayedModules()) {
            int renderY = Math.round(moduleY);

            if (renderY + 29 >= listTop
                && renderY <= listBottom
                && inside(
                    mouseX,
                    mouseY,
                    modulesX + 6,
                    renderY,
                    133,
                    28
                )) {
                activateModule(module, button);
                return true;
            }

            moduleY += 32.0f;
        }

        int infoX = panelX + 252;
        int infoWidth = panelWidth - 257;
        int contentHeight = panelHeight - 46;

        if (selectedModule != null
            && inside(
                mouseX,
                mouseY,
                infoX + 8,
                contentY + contentHeight - 30,
                infoWidth - 16,
                20
            )) {
            openSettings(selectedModule);
            return true;
        }

        searching = false;
        return false;
    }

    private boolean clickClassic(
        int mouseX,
        int mouseY,
        int button
    ) {
        int areaX = panelX + 6;
        int areaY = panelY + 40;
        int areaHeight = panelHeight - 47;

        int columnWidth = 104;
        int columnX =
            areaX + 5 + Math.round(classicScroll);

        for (Category category : Modules.loopCategories()) {
            if (!hasVisibleModules(category)) continue;

            int moduleY = areaY + 29;

            for (Module module :
                Modules.get().getGroup(category)) {
                if (Config.get()
                    .hiddenModules
                    .get()
                    .contains(module)) {
                    continue;
                }

                if (moduleY + 19
                    > areaY + areaHeight - 4) {
                    break;
                }

                if (inside(
                    mouseX,
                    mouseY,
                    columnX + 4,
                    moduleY,
                    columnWidth - 8,
                    18
                )) {
                    activateModule(module, button);
                    return true;
                }

                moduleY += 20;
            }

            columnX += columnWidth + 6;
        }

        return false;
    }

    private void activateModule(
        Module module,
        int button
    ) {
        selectedModule = module;

        if (button == GLFW.GLFW_MOUSE_BUTTON_LEFT) {
            module.toggle();

            MorzhSoundManager.playModuleState(
                module.isActive()
            );
        } else if (
            button == GLFW.GLFW_MOUSE_BUTTON_RIGHT
        ) {
            openSettings(module);
        }
    }

    private void openSettings(Module module) {
        MorzhSoundManager.playBoolean();

        if (client != null) {
            client.setScreen(
                GuiThemes.get().moduleScreen(module)
            );
        }
    }

    @Override
    public boolean mouseReleased(
        double mouseX,
        double mouseY,
        int button
    ) {
        dragging = false;

        return super.mouseReleased(
            mouseX,
            mouseY,
            button
        );
    }

    @Override
    public boolean mouseScrolled(
        double mouseX,
        double mouseY,
        double horizontalAmount,
        double verticalAmount
    ) {
        if (closing || layoutTransition < 0.98f) {
            return true;
        }

        if (layout == Layout.Classic) {
            classicTargetScroll +=
                (float) verticalAmount * 35.0f;

            MorzhSoundManager.playScroll();
            return true;
        }

        if (inside(
            mouseX,
            mouseY,
            panelX + 102,
            panelY + 40,
            145,
            panelHeight - 46
        )) {
            moduleTargetScroll +=
                (float) verticalAmount * 28.0f;

            MorzhSoundManager.playScroll();
            return true;
        }

        return super.mouseScrolled(
            mouseX,
            mouseY,
            horizontalAmount,
            verticalAmount
        );
    }

    @Override
    public boolean keyPressed(
        int keyCode,
        int scanCode,
        int modifiers
    ) {
        if (keyCode == GLFW.GLFW_KEY_ESCAPE) {
            if (searching) {
                searching = false;
                MorzhSoundManager.playKeyRelease();
                return true;
            }

            if (!closing) {
                closing = true;
                dragging = false;
                MorzhSoundManager.playClose();
            }

            return true;
        }

        if (closing) return true;

        if (searching) {
            if (keyCode == GLFW.GLFW_KEY_ENTER
                || keyCode == GLFW.GLFW_KEY_KP_ENTER) {
                searching = false;
                MorzhSoundManager.playKeyRelease();
                return true;
            }

            if (keyCode == GLFW.GLFW_KEY_BACKSPACE) {
                if (!search.isEmpty()) {
                    search = search.substring(
                        0,
                        search.length() - 1
                    );

                    moduleTargetScroll = 0.0f;
                    MorzhSoundManager.playKeyRelease();
                }

                return true;
            }
        }

        return super.keyPressed(
            keyCode,
            scanCode,
            modifiers
        );
    }

    @Override
    public boolean charTyped(
        char chr,
        int modifiers
    ) {
        if (searching
            && !Character.isISOControl(chr)
            && search.length() < 40) {
            search += chr;
            moduleTargetScroll = 0.0f;

            MorzhSoundManager.playKeyPress();
            return true;
        }

        return super.charTyped(chr, modifiers);
    }

    private List<Module> getDisplayedModules() {
        List<Module> modules = new ArrayList<>();

        String query = search
            .trim()
            .toLowerCase(Locale.ROOT);

        for (Module module : Modules.get().getAll()) {
            if (Config.get()
                .hiddenModules
                .get()
                .contains(module)) {
                continue;
            }

            if (!query.isEmpty()) {
                boolean matches =
                    module.name
                        .toLowerCase(Locale.ROOT)
                        .contains(query)
                    || module.title
                        .toLowerCase(Locale.ROOT)
                        .contains(query)
                    || module.description != null
                        && module.description
                        .toLowerCase(Locale.ROOT)
                        .contains(query);

                if (matches) {
                    modules.add(module);
                }
            } else if (
                selectedCategory != null
                    && Modules.get()
                    .getGroup(selectedCategory)
                    .contains(module)
            ) {
                modules.add(module);
            }
        }

        modules.sort(
            (first, second) ->
                String.CASE_INSENSITIVE_ORDER.compare(
                    first.title,
                    second.title
                )
        );

        return modules;
    }

    private int getVisibleCategoryCount() {
        int count = 0;

        for (Category category : Modules.loopCategories()) {
            if (hasVisibleModules(category)) {
                count++;
            }
        }

        return count;
    }

    private boolean hasVisibleModules(
        Category category
    ) {
        for (Module module :
            Modules.get().getGroup(category)) {
            if (!Config.get()
                .hiddenModules
                .get()
                .contains(module)) {
                return true;
            }
        }

        return false;
    }

    private static boolean inside(
        double mouseX,
        double mouseY,
        double x,
        double y,
        double targetWidth,
        double targetHeight
    ) {
        return mouseX >= x
            && mouseX <= x + targetWidth
            && mouseY >= y
            && mouseY <= y + targetHeight;
    }

    private static void roundedRect(
        DrawContext context,
        int x,
        int y,
        int rectWidth,
        int rectHeight,
        int radius,
        int color
    ) {
        if (rectWidth <= 0 || rectHeight <= 0) {
            return;
        }

        radius = Math.min(
            radius,
            Math.min(rectWidth / 2, rectHeight / 2)
        );

        context.fill(
            x + radius,
            y,
            x + rectWidth - radius,
            y + rectHeight,
            color
        );

        context.fill(
            x,
            y + radius,
            x + rectWidth,
            y + rectHeight - radius,
            color
        );

        for (int i = 0; i < radius; i++) {
            int inset = radius - i;

            context.fill(
                x + inset,
                y + i,
                x + rectWidth - inset,
                y + i + 1,
                color
            );

            context.fill(
                x + inset,
                y + rectHeight - i - 1,
                x + rectWidth - inset,
                y + rectHeight - i,
                color
            );
        }
    }

    private static int blend(
        int first,
        int second,
        float progress
    ) {
        progress = MorzhAnimUtil.clamp01(progress);

        int a1 = first >>> 24;
        int r1 = first >> 16 & 255;
        int g1 = first >> 8 & 255;
        int b1 = first & 255;

        int a2 = second >>> 24;
        int r2 = second >> 16 & 255;
        int g2 = second >> 8 & 255;
        int b2 = second & 255;

        int a = Math.round(
            a1 + (a2 - a1) * progress
        );

        int r = Math.round(
            r1 + (r2 - r1) * progress
        );

        int g = Math.round(
            g1 + (g2 - g1) * progress
        );

        int b = Math.round(
            b1 + (b2 - b1) * progress
        );

        return a << 24 | r << 16 | g << 8 | b;
    }

    private static String shorten(
        String text,
        int maxLength
    ) {
        if (text == null) return "";
        if (text.length() <= maxLength) return text;

        return text.substring(
            0,
            Math.max(0, maxLength - 3)
        ) + "...";
    }

    private static List<String> wrap(
        String text,
        int maxLength
    ) {
        List<String> lines = new ArrayList<>();

        if (text == null || text.isBlank()) {
            lines.add("No description.");
            return lines;
        }

        StringBuilder line = new StringBuilder();

        for (String word : text.split("\\s+")) {
            if (line.length() > 0
                && line.length()
                    + word.length()
                    + 1
                    > maxLength) {
                lines.add(line.toString());
                line.setLength(0);
            }

            if (line.length() > 0) {
                line.append(' ');
            }

            line.append(word);
        }

        if (!line.isEmpty()) {
            lines.add(line.toString());
        }

        return lines;
    }

    private enum Layout {
        Thunder,
        Classic
    }
}


