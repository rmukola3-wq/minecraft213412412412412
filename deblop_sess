private void renderLayoutContent(
    DrawContext context,
    int mouseX,
    int mouseY
) {
    if (layoutTransition >= 1.0f) {
        renderLayout(
            context,
            layout,
            mouseX,
            mouseY,
            0
        );

        return;
    }

    float eased = MorzhAnimUtil.easeInOutCubic(
        layoutTransition
    );

    int direction =
        layout == Layout.Classic ? 1 : -1;

    int outgoingOffset = Math.round(
        -direction * eased * panelWidth
    );

    int incomingOffset = Math.round(
        direction
            * (1.0f - eased)
            * panelWidth
    );

    context.enableScissor(
        panelX + 5,
        panelY + 39,
        panelX + panelWidth - 5,
        panelY + panelHeight - 5
    );

    renderLayout(
        context,
        previousLayout,
        Integer.MIN_VALUE / 4,
        Integer.MIN_VALUE / 4,
        outgoingOffset
    );

    renderLayout(
        context,
        layout,
        Integer.MIN_VALUE / 4,
        Integer.MIN_VALUE / 4,
        incomingOffset
    );

    context.disableScissor();
}

private void renderLayout(
    DrawContext context,
    Layout targetLayout,
