/*
 * Morzh Client
 *
 * Animation behavior independently implemented after studying:
 * - Meteor Client (GPLv3)
 * - ThunderHack Recode (GPLv3)
 * - Rasty Client metadata declares MIT
 * - Rockstar Client visual behavior
 */

package meteordevelopment.meteorclient.gui.morzh;

public final class MorzhAnimUtil {
    private static final float DEFAULT_DELTA = 1.0f / 60.0f;
    private static final float MAX_DELTA = 0.05f;

    private static long lastFrameNanos;
    private static float frameDelta = DEFAULT_DELTA;

    private MorzhAnimUtil() {
    }

    public static float beginFrame() {
        long now = System.nanoTime();

        if (lastFrameNanos == 0L) {
            lastFrameNanos = now;
            frameDelta = DEFAULT_DELTA;
            return frameDelta;
        }

        frameDelta = (now - lastFrameNanos) / 1_000_000_000.0f;
        lastFrameNanos = now;

        if (!Float.isFinite(frameDelta) || frameDelta <= 0.0f) {
            frameDelta = DEFAULT_DELTA;
        }

        frameDelta = Math.min(frameDelta, MAX_DELTA);
        return frameDelta;
    }

    public static float frameDelta() {
        return frameDelta;
    }

    public static float approach(
        float current,
        float target,
        float responsiveness,
        float deltaSeconds
    ) {
        if (!Float.isFinite(current)) return target;
        if (!Float.isFinite(target)) return current;

        float difference = target - current;

        if (Math.abs(difference) <= 0.0005f) {
            return target;
        }

        float safeResponsiveness = Math.max(0.0f, responsiveness);
        float safeDelta = Math.max(0.0f, Math.min(deltaSeconds, MAX_DELTA));

        float factor = 1.0f - (float) Math.exp(
            -safeResponsiveness * safeDelta
        );

        return current + difference * clamp01(factor);
    }

    public static double approach(
        double current,
        double target,
        double responsiveness,
        double deltaSeconds
    ) {
        if (!Double.isFinite(current)) return target;
        if (!Double.isFinite(target)) return current;

        double difference = target - current;

        if (Math.abs(difference) <= 0.0005) {
            return target;
        }

        double safeResponsiveness = Math.max(0.0, responsiveness);
        double safeDelta = Math.max(0.0, Math.min(deltaSeconds, MAX_DELTA));

        double factor = 1.0 - Math.exp(
            -safeResponsiveness * safeDelta
        );

        return current + difference * clamp01(factor);
    }

    /*
     * Compatibility method for existing Morzh code.
     * Smaller divisor remains faster, matching the previous API.
     */
    public static float fast(
        float current,
        float target,
        float speed
    ) {
        float divisor = Math.max(1.0f, speed);
        float responsiveness = 60.0f / divisor;

        return approach(
            current,
            target,
            responsiveness,
            frameDelta
        );
    }

    public static double fast(
        double current,
        double target,
        double speed
    ) {
        double divisor = Math.max(1.0, speed);
        double responsiveness = 60.0 / divisor;

        return approach(
            current,
            target,
            responsiveness,
            frameDelta
        );
    }

    public static float lerp(float from, float to, float progress) {
        return from + (to - from) * clamp01(progress);
    }

    public static double lerp(
        double from,
        double to,
        double progress
    ) {
        return from + (to - from) * clamp01(progress);
    }

    public static float easeOutQuad(float value) {
        float t = clamp01(value);
        return 1.0f - (1.0f - t) * (1.0f - t);
    }

    public static float easeOutCubic(float value) {
        float t = clamp01(value);
        float inverse = 1.0f - t;

        return 1.0f - inverse * inverse * inverse;
    }

    public static float easeInOutCubic(float value) {
        float t = clamp01(value);

        if (t < 0.5f) {
            return 4.0f * t * t * t;
        }

        float inverse = -2.0f * t + 2.0f;
        return 1.0f - inverse * inverse * inverse / 2.0f;
    }

    public static float easeOutQuart(float value) {
        float t = clamp01(value);
        float inverse = 1.0f - t;

        return 1.0f - inverse * inverse * inverse * inverse;
    }

    public static float easeOutBack(float value) {
        float t = clamp01(value);
        float c1 = 1.70158f;
        float c3 = c1 + 1.0f;
        float shifted = t - 1.0f;

        return 1.0f
            + c3 * shifted * shifted * shifted
            + c1 * shifted * shifted;
    }

    public static float clamp01(float value) {
        return Math.max(0.0f, Math.min(1.0f, value));
    }

    public static double clamp01(double value) {
        return Math.max(0.0, Math.min(1.0, value));
    }
}


