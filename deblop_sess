        );

        classicTabHover = MorzhAnimUtil.approach(
            classicTabHover,
            classicHovered ? 1.0f : 0.0f,
            HOVER_SPEED,
            frameDelta
        );

        glassButtonHover = MorzhAnimUtil.approach(
            glassButtonHover,
            glassHovered ? 1.0f : 0.0f,
            HOVER_SPEED,
            frameDelta
        );

        renderLayoutButton(
            context,
            "Thunder",
            panelX + 95,
            panelY + 10,
            48,
