    private void renderGlassButton(
        DrawContext context,
        int x,
        int y,
        int buttonWidth,
        float hover
    ) {
        boolean enabled =
            visualStyle == VisualStyle.Glass;

        int solidColor = enabled
            ? ACCENT_DARK
            : blend(CARD, CARD_HOVER, hover);

        int glassColor = enabled
            ? GLASS_SELECTED
            : blend(
                GLASS_CARD,
                GLASS_CARD_HOVER,
                hover
            );

        drawSurface(
            context,
            x,
            y,
            buttonWidth,
            18,
            4,
            solidColor,
            glassColor,
            enabled
        );

        if (enabled) {
            context.fill(
                x + 3,
                y + 2,
                x + buttonWidth - 3,
                y + 3,
                withAlpha(
                    GLASS_HIGHLIGHT,
                    145
                )
            );
        }

        drawText(
            context,
            "Glass",
            x + 5,
            y + 5,
            enabled
                ? primaryTextColor()
                : secondaryTextColor(),
            false
        );
    }

    private void renderSearch(
        DrawContext context,
        int mouseX,
        int mouseY
    ) {
        int searchWidth = Math.min(
            137,
            panelWidth / 3
        );

        int searchX =
            panelX + panelWidth - searchWidth - 12;

        int searchY = panelY + 11;

        boolean hovered = inside(
            mouseX,
            mouseY,
            searchX,
            searchY,
            searchWidth,
            17
        );

        searchHover = MorzhAnimUtil.approach(
            searchHover,
            searching || hovered ? 1.0f : 0.0f,
            HOVER_SPEED,
            frameDelta
        );

        drawSurface(
            context,
            searchX,
            searchY,
            searchWidth,
            17,
            4,
            blend(CARD, CARD_HOVER, searchHover),
            blend(
                GLASS_CARD,
                GLASS_CARD_HOVER,
                searchHover
            ),
            searching
        );

        if (searching) {
            int underlineWidth = Math.max(
                1,
                Math.round(searchWidth * searchHover)
            );

            context.fill(
                searchX + 2,
                searchY + 15,
                searchX + Math.max(
                    2,
                    underlineWidth - 2
                ),
                searchY + 17,
                ACCENT
            );
        }

        String shown;

        if (search.isEmpty()) {
            shown = searching
                ? "Type to search..."
                : "Search modules";
        } else {
            shown = search;
        }

        if (searching
            && (System.currentTimeMillis() / 450L)
                % 2L == 0L) {
            shown += "_";
        }

        drawText(
            context,
            shorten(shown, 19),
            searchX + 6,
            searchY + 5,
            search.isEmpty()
                ? secondaryTextColor()
                : primaryTextColor(),
            false
        );
    }

