    private void renderModuleCard(
        DrawContext context,
        Module module,
        boolean hovered,
        boolean selected,
        int x,
        int y,
        int cardWidth,
        int cardHeight
    ) {
        float hover = hoverAnimations.getOrDefault(
            module,
            0.0f
        );

        hover = MorzhAnimUtil.approach(
            hover,
            hovered ? 1.0f : 0.0f,
            HOVER_SPEED,
            frameDelta
        );

        hoverAnimations.put(module, hover);

        float active = toggleAnimations.getOrDefault(
            module,
            module.isActive() ? 1.0f : 0.0f
        );

        active = MorzhAnimUtil.approach(
            active,
            module.isActive() ? 1.0f : 0.0f,
            TOGGLE_SPEED,
            frameDelta
        );

        toggleAnimations.put(module, active);

        int solidCard = blend(
            CARD,
            CARD_HOVER,
            MorzhAnimUtil.easeOutCubic(hover)
        );

        int glassCard = blend(
            GLASS_CARD,
            GLASS_CARD_HOVER,
            MorzhAnimUtil.easeOutCubic(hover)
        );

        drawSurface(
            context,
            x,
            y,
            cardWidth,
            cardHeight,
            4,
            solidCard,
            glassCard,
            selected || hovered
        );

        if (selected) {
            context.fill(
                x,
                y + 3,
                x + 2,
                y + cardHeight - 3,
                ACCENT
            );
        }

        if (active > 0.005f) {
            int activeWidth = Math.round(
                cardWidth
                    * MorzhAnimUtil.easeOutCubic(active)
            );

            context.fill(
                x,
                y + cardHeight - 2,
                x + activeWidth,
                y + cardHeight,
                ACCENT
            );
        }

        drawText(
            context,
            shorten(
                module.title,
                cardHeight <= 18 ? 13 : 18
            ),
            x + 6,
            y + (cardHeight <= 18 ? 5 : 6),
            module.isActive()
                ? primaryTextColor()
                : blend(
                    secondaryTextColor(),
                    primaryTextColor(),
                    hover
                ),
            false
        );

        if (cardHeight > 20) {
            drawText(
                context,
                module.isActive() ? "ON" : "OFF",
                x + cardWidth - 24,
                y + 16,
                module.isActive() ? GREEN : RED,
                false
            );
        }
    }

    @Override
    public boolean mouseClicked(
        double mouseX,
        double mouseY,
        int button
    ) {
        if (closing || animation < 0.9f) {
            return true;
        }

        int mx = (int) mouseX;
        int my = (int) mouseY;

        if (button == GLFW.GLFW_MOUSE_BUTTON_LEFT
            && inside(
                mx,
                my,
                panelX + 95,
                panelY + 10,
                48,
                18
            )) {
            switchLayout(Layout.Thunder);
            return true;
        }

        if (button == GLFW.GLFW_MOUSE_BUTTON_LEFT
            && inside(
                mx,
                my,
                panelX + 147,
                panelY + 10,
                45,
                18
            )) {
            switchLayout(Layout.Classic);
            return true;
        }

        if (button == GLFW.GLFW_MOUSE_BUTTON_LEFT
            && inside(
                mx,
                my,
                panelX + 196,
                panelY + 10,
                43,
                18
            )) {
            toggleGlass();
            return true;
        }

        if (layoutTransition < 0.98f) {
            return true;
        }

        if (layout == Layout.Thunder) {
            int searchWidth = Math.min(
                137,
                panelWidth / 3
            );

            int searchX =
                panelX + panelWidth
                    - searchWidth
                    - 12;

            if (inside(
                mx,
                my,
                searchX,
                panelY + 11,
                searchWidth,
                17
            )) {
                searching = true;
                MorzhSoundManager.playKeyPress();
                return true;
            }
        }

        if (inside(
            mx,
            my,
            panelX + 5,
            panelY + 5,
            panelWidth - 10,
            30
        )) {
            dragging = true;
            dragOffsetX = mx - panelX;
            dragOffsetY = my - panelY;
            return true;
        }

        if (layout == Layout.Thunder) {
            return clickThunder(mx, my, button);
        }

        return clickClassic(mx, my, button);
    }

    private void switchLayout(Layout newLayout) {
        if (newLayout == layout) return;
        if (layoutTransition < 0.98f) return;

        previousLayout = layout;
        layout = newLayout;
        layoutTransition = 0.0f;

        searching = false;
        hoveredModule = null;

        MorzhSoundManager.playKeyPress();
    }

    private void toggleGlass() {
        visualStyle =
            visualStyle == VisualStyle.Glass
                ? VisualStyle.Solid
                : VisualStyle.Glass;

        savedVisualStyle = visualStyle;
        MorzhSoundManager.playBoolean();
    }

    private boolean clickThunder(
        int mouseX,
        int mouseY,
        int button
    ) {
        int contentY = panelY + 40;
        int categoryY = contentY + 23;

        for (Category category : Modules.loopCategories()) {
            if (!hasVisibleModules(category)) continue;

            if (inside(
                mouseX,
                mouseY,
                panelX + 10,
                categoryY,
                82,
                16
            )) {
                if (selectedCategory != category) {
                    selectedCategory = category;
                    selectedModule = null;

                    moduleScroll = 0.0f;
                    moduleTargetScroll = 0.0f;
                    moduleListAnimation = 0.0f;

                    search = "";
                    searching = false;

                    MorzhSoundManager.playKeyPress();
                }

                return true;
            }

            categoryY += 18;
        }

        if (moduleListAnimation < 0.85f) {
            return true;
        }

        int modulesX = panelX + 102;
        int listTop = contentY + 22;
        int listBottom = panelY + panelHeight - 12;

        float moduleY = listTop + moduleScroll;

        for (Module module : getDisplayedModules()) {
            int renderY = Math.round(moduleY);

            if (renderY + 29 >= listTop
                && renderY <= listBottom
                && inside(
                    mouseX,
                    mouseY,
                    modulesX + 6,
                    renderY,
                    133,
                    28
                )) {
                activateModule(module, button);
                return true;
            }

            moduleY += 32.0f;
        }

        int infoX = panelX + 252;
        int infoWidth = panelWidth - 257;
        int contentHeight = panelHeight - 46;

        if (selectedModule != null
            && inside(
                mouseX,
                mouseY,
                infoX + 8,
                contentY + contentHeight - 30,
                infoWidth - 16,
                20
            )) {
            openSettings(selectedModule);
            return true;
        }

        searching = false;
        return false;
    }

    private boolean clickClassic(
        int mouseX,
        int mouseY,
        int button
    ) {
        int areaX = panelX + 6;
        int areaY = panelY + 40;
        int areaHeight = panelHeight - 47;

        int columnWidth = 104;

        int columnX =
            areaX + 5 + Math.round(classicScroll);

        for (Category category : Modules.loopCategories()) {
            if (!hasVisibleModules(category)) continue;

            int moduleY = areaY + 29;

            for (Module module :
                Modules.get().getGroup(category)) {
                if (Config.get()
                    .hiddenModules
                    .get()
                    .contains(module)) {
                    continue;
                }

                if (moduleY + 19
                    > areaY + areaHeight - 4) {
                    break;
                }

                if (inside(
                    mouseX,
                    mouseY,
                    columnX + 4,
                    moduleY,
                    columnWidth - 8,
                    18
                )) {
                    activateModule(module, button);
                    return true;
                }

                moduleY += 20;
            }

            columnX += columnWidth + 6;
        }

        return false;
    }

    private void activateModule(
        Module module,
        int button
    ) {
        selectedModule = module;

        if (button == GLFW.GLFW_MOUSE_BUTTON_LEFT) {
            module.toggle();

            MorzhSoundManager.playModuleState(
                module.isActive()
            );
        } else if (
            button == GLFW.GLFW_MOUSE_BUTTON_RIGHT
        ) {
            openSettings(module);
        }
    }

    private void openSettings(Module module) {
        MorzhSoundManager.playBoolean();

        if (client != null) {
            client.setScreen(
                GuiThemes.get().moduleScreen(module)
            );
        }
    }

