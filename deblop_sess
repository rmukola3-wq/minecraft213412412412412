        };
    }

    private int surfaceColor(Surface surface) {
        return switch (visualStyle) {
            case Solid -> switch (surface) {
                case Background -> BACKGROUND;
                case Panel -> PANEL;
                case Content -> CONTENT;
                case Card -> CARD;
                case CardHover -> CARD_HOVER;
                case Selected -> ACCENT_DARK;
            };

            case Amethyst -> switch (surface) {
                case Background -> AMETHYST_BACKGROUND;
                case Panel -> AMETHYST_PANEL;
                case Content -> AMETHYST_CONTENT;
                case Card -> AMETHYST_CARD;
                case CardHover -> AMETHYST_CARD_HOVER;
                case Selected -> AMETHYST_SELECTED;
            };

            case LiquidGlass -> switch (surface) {
                case Background -> LIQUID_BACKGROUND;
                case Panel -> LIQUID_PANEL;
                case Content -> LIQUID_CONTENT;
                case Card -> LIQUID_CARD;
                case CardHover -> LIQUID_CARD_HOVER;
                case Selected -> LIQUID_SELECTED;
            };
        };
    }

    private void drawSurface(
        DrawContext context,
        int x,
        int y,
        int surfaceWidth,
        int surfaceHeight,
        float radius,
        Surface surface,
        boolean accented
    ) {
        int baseColor = surfaceColor(surface);

        if (visualStyle == VisualStyle.Solid) {
            MorzhSmoothRenderer.roundedRect(
                context,
                x,
                y,
                surfaceWidth,
                surfaceHeight,
                radius,
                baseColor
            );

            return;
        }

        MorzhSmoothRenderer.roundedRect(
            context,
            x + 1,
            y + 2,
            surfaceWidth,
            surfaceHeight,
            radius,
            withAlpha(
                GLASS_SHADOW,
                visualStyle == VisualStyle.LiquidGlass
                    ? 42
                    : 70
            )
        );

        MorzhSmoothRenderer.roundedRect(
            context,
            x,
            y,
            surfaceWidth,
            surfaceHeight,
            radius,
            withAlpha(
                accented
                    ? GLASS_ACCENT_EDGE
                    : GLASS_EDGE,
                visualStyle == VisualStyle.LiquidGlass
                    ? accented ? 125 : 88
                    : accented ? 110 : 76
            )
        );

        if (surfaceWidth > 2 && surfaceHeight > 2) {
            MorzhSmoothRenderer.roundedRect(
                context,
                x + 1,
                y + 1,
                surfaceWidth - 2,
                surfaceHeight - 2,
                Math.max(0.0f, radius - 1.0f),
                baseColor
            );
        }

        int inset = Math.max(
            3,
            Math.round(radius)
        );

        if (surfaceWidth > inset * 2) {
            MorzhSmoothRenderer.roundedRect(
                context,
                x + inset,
                y + 1,
                surfaceWidth - inset * 2,
                1.25f,
                0.6f,
                withAlpha(
                    GLASS_HIGHLIGHT,
                    visualStyle == VisualStyle.LiquidGlass
                        ? 105
                        : 70
                )
            );
        }
    }

