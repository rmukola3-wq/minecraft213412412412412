    private void renderModuleCard(
        DrawContext context,
        Module module,
        boolean hovered,
        boolean selected,
        int x,
        int y,
        int cardWidth,
        int cardHeight
    ) {
        float hover = hoverAnimations.getOrDefault(
            module,
            0.0f
        );

        hover = MorzhAnimUtil.approach(
            hover,
            hovered ? 1.0f : 0.0f,
            HOVER_SPEED,
            frameDelta
        );

        hoverAnimations.put(module, hover);

        float active = toggleAnimations.getOrDefault(
            module,
            module.isActive() ? 1.0f : 0.0f
        );

        active = MorzhAnimUtil.approach(
            active,
            module.isActive() ? 1.0f : 0.0f,
            TOGGLE_SPEED,
            frameDelta
        );

        toggleAnimations.put(module, active);

        drawSurface(
            context,
            x,
            y,
            cardWidth,
            cardHeight,
            6.0f,
            hover > 0.2f
                ? Surface.CardHover
                : Surface.Card,
            selected || hovered
        );

        if (selected) {
            MorzhSmoothRenderer.roundedRect(
                context,
                x,
                y + 3,
                2,
                cardHeight - 6,
                1.0f,
                ACCENT
            );
        }

        if (active > 0.01f) {
            MorzhSmoothRenderer.roundedRect(
                context,
                x + 2,
                y + cardHeight - 2,
                Math.max(
                    1,
                    Math.round((cardWidth - 4) * active)
                ),
                2,
                1.0f,
                ACCENT
            );
        }

        drawText(
            context,
            shorten(
                module.title,
                cardHeight <= 18 ? 13 : 18
            ),
            x + 6,
            y + (cardHeight <= 18 ? 5 : 6),
            module.isActive()
                ? primaryTextColor()
                : secondaryTextColor(),
            false
        );

        if (cardHeight > 20) {
            drawText(
                context,
                module.isActive() ? "ON" : "OFF",
                x + cardWidth - 24,
                y + 16,
                module.isActive() ? GREEN : RED,
                false
            );
        }
    }

