        );

        context.fill(
            panelX + 7,
            panelY + 33,
            panelX + panelWidth - 7,
            panelY + 34,
            blend(
                ACCENT_DARK,
                GLASS_EDGE_PURPLE,
                glassTransition
            )
        );

        drawText(
            context,
            "MORZH",
            panelX + 13,
            panelY + 12,
            primaryTextColor(),
            true
        );

        drawText(
            context,
            "CLIENT",
            panelX + 51,
            panelY + 12,
            ACCENT,
            true
        );

        boolean thunderHovered = inside(
            mouseX,
            mouseY,
            panelX + 95,
            panelY + 10,
            48,
            18
        );

        boolean classicHovered = inside(
            mouseX,
            mouseY,
            panelX + 147,
            panelY + 10,
            45,
            18
        );

        boolean glassHovered = inside(
            mouseX,
            mouseY,
            panelX + 196,
            panelY + 10,
            43,
            18
        );

        thunderTabHover = MorzhAnimUtil.approach(
            thunderTabHover,
            thunderHovered ? 1.0f : 0.0f,
            HOVER_SPEED,
