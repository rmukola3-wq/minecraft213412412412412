package meteordevelopment.meteorclient.gui.morzh;

import com.mojang.blaze3d.systems.RenderSystem;
import net.minecraft.client.MinecraftClient;
import net.minecraft.client.gl.Framebuffer;
import net.minecraft.client.gl.SimpleFramebuffer;
import org.lwjgl.opengl.GL11;
import org.lwjgl.opengl.GL30;

public final class MorzhFramebufferBlur {
    private static final int FIRST_DOWNSAMPLE = 4;
    private static final int SECOND_DOWNSAMPLE = 8;

    private static SimpleFramebuffer firstPass;
    private static SimpleFramebuffer secondPass;

    private MorzhFramebufferBlur() {
    }

    public static void draw(
        int x,
        int y,
        int width,
        int height,
        int radius
    ) {
        RenderSystem.assertOnRenderThread();

        MinecraftClient client =
            MinecraftClient.getInstance();

        if (client == null
            || client.getFramebuffer() == null
            || client.getWindow() == null) {
            return;
        }

        Framebuffer main = client.getFramebuffer();

        int framebufferWidth = main.textureWidth;
        int framebufferHeight = main.textureHeight;

        if (framebufferWidth <= 0
            || framebufferHeight <= 0
            || width <= 0
            || height <= 0) {
            return;
        }

        int firstWidth = Math.max(
            1,
            framebufferWidth / FIRST_DOWNSAMPLE
        );

        int firstHeight = Math.max(
            1,
            framebufferHeight / FIRST_DOWNSAMPLE
        );

        int secondWidth = Math.max(
            1,
            framebufferWidth / SECOND_DOWNSAMPLE
        );

        int secondHeight = Math.max(
            1,
            framebufferHeight / SECOND_DOWNSAMPLE
        );

        ensureFramebuffers(
            firstWidth,
            firstHeight,
            secondWidth,
            secondHeight
        );

        /*
         * Первый Kawase-подобный проход:
         * полноразмерный кадр уменьшается в четыре раза.
         */
        blit(
            main,
            firstPass,
            framebufferWidth,
            framebufferHeight,
            firstWidth,
            firstHeight
        );

        /*
         * Второй проход:
         * уменьшенная копия ещё раз уменьшается.
         * Линейная фильтрация смешивает соседние пиксели.
         */
        blit(
            firstPass,
            secondPass,
            firstWidth,
            firstHeight,
            secondWidth,
            secondHeight
        );

        main.beginWrite(true);

        double scale =
            client.getWindow().getScaleFactor();

        int scissorX = (int) Math.floor(x * scale);
        int scissorY = (int) Math.floor(
            framebufferHeight
                - (y + height) * scale
        );

        int scissorWidth = Math.max(
            1,
            (int) Math.ceil(width * scale)
        );

        int scissorHeight = Math.max(
            1,
            (int) Math.ceil(height * scale)
        );

        scissorX = clamp(
            scissorX,
            0,
            framebufferWidth
        );

        scissorY = clamp(
            scissorY,
            0,
            framebufferHeight
        );

        scissorWidth = Math.min(
            scissorWidth,
            framebufferWidth - scissorX
        );

        scissorHeight = Math.min(
            scissorHeight,
            framebufferHeight - scissorY
        );

        if (scissorWidth <= 0 || scissorHeight <= 0) {
            return;
        }

        /*
         * Рисуется только участок панели.
         * Весь остальной Minecraft-мир остаётся резким.
         */
        RenderSystem.enableScissor(
            scissorX,
            scissorY,
            scissorWidth,
            scissorHeight
        );

        secondPass.draw(
            framebufferWidth,
            framebufferHeight,
            true
        );

        RenderSystem.disableScissor();
        main.beginWrite(true);
    }

    private static void ensureFramebuffers(
        int firstWidth,
        int firstHeight,
        int secondWidth,
        int secondHeight
    ) {
        if (firstPass == null) {
            firstPass = new SimpleFramebuffer(
                firstWidth,
                firstHeight,
                false,
                MinecraftClient.IS_SYSTEM_MAC
            );

            setLinearFiltering(firstPass);
        } else if (
            firstPass.textureWidth != firstWidth
                || firstPass.textureHeight != firstHeight
        ) {
            firstPass.resize(
                firstWidth,
                firstHeight,
                MinecraftClient.IS_SYSTEM_MAC
            );

            setLinearFiltering(firstPass);
        }

        if (secondPass == null) {
            secondPass = new SimpleFramebuffer(
                secondWidth,
                secondHeight,
                false,
                MinecraftClient.IS_SYSTEM_MAC
            );

            setLinearFiltering(secondPass);
        } else if (
            secondPass.textureWidth != secondWidth
                || secondPass.textureHeight != secondHeight
        ) {
            secondPass.resize(
                secondWidth,
                secondHeight,
                MinecraftClient.IS_SYSTEM_MAC
            );

            setLinearFiltering(secondPass);
        }
    }

    private static void blit(
        Framebuffer source,
        Framebuffer destination,
        int sourceWidth,
        int sourceHeight,
        int destinationWidth,
        int destinationHeight
    ) {
        GL30.glBindFramebuffer(
            GL30.GL_READ_FRAMEBUFFER,
            source.fbo
        );

        GL30.glBindFramebuffer(
            GL30.GL_DRAW_FRAMEBUFFER,
            destination.fbo
        );

        GL30.glBlitFramebuffer(
            0,
            0,
            sourceWidth,
            sourceHeight,
            0,
            0,
            destinationWidth,
            destinationHeight,
            GL30.GL_COLOR_BUFFER_BIT,
            GL30.GL_LINEAR
        );
    }

    private static void setLinearFiltering(
        Framebuffer framebuffer
    ) {
        framebuffer.beginRead();

        GL11.glTexParameteri(
            GL11.GL_TEXTURE_2D,
            GL11.GL_TEXTURE_MIN_FILTER,
            GL11.GL_LINEAR
        );

        GL11.glTexParameteri(
            GL11.GL_TEXTURE_2D,
            GL11.GL_TEXTURE_MAG_FILTER,
            GL11.GL_LINEAR
        );

        framebuffer.endRead();
    }

    private static int clamp(
        int value,
        int minimum,
        int maximum
    ) {
        return Math.max(
            minimum,
            Math.min(maximum, value)
        );
    }

    public static void close() {
        if (firstPass != null) {
            firstPass.delete();
            firstPass = null;
        }

        if (secondPass != null) {
            secondPass.delete();
            secondPass = null;
        }
    }
