    private List<Module> getDisplayedModules() {
        List<Module> modules = new ArrayList<>();

        String query =
            search.trim().toLowerCase(Locale.ROOT);

        for (Module module : Modules.get().getAll()) {
            if (Config.get()
                .hiddenModules
                .get()
                .contains(module)) {
                continue;
            }

            if (!query.isEmpty()) {
                boolean matches =
                    module.name
                        .toLowerCase(Locale.ROOT)
                        .contains(query)
                    || module.title
                        .toLowerCase(Locale.ROOT)
                        .contains(query)
                    || module.description != null
                    && module.description
                        .toLowerCase(Locale.ROOT)
                        .contains(query);

                if (matches) modules.add(module);
            } else if (
                selectedCategory != null
                    && Modules.get()
                    .getGroup(selectedCategory)
                    .contains(module)
            ) {
                modules.add(module);
            }
        }

        modules.sort(
            (first, second) ->
                String.CASE_INSENSITIVE_ORDER.compare(
                    first.title,
                    second.title
                )
        );

        return modules;
    }

    private boolean hasVisibleModules(
        Category category
    ) {
        for (Module module :
            Modules.get().getGroup(category)) {
            if (!Config.get()
                .hiddenModules
                .get()
                .contains(module)) {
                return true;
            }
        }

        return false;
    }

