    @Override
    public boolean mouseScrolled(
        double mouseX,
        double mouseY,
        double horizontalAmount,
        double verticalAmount
    ) {
        if (closing || layoutTransition < 0.98f) {
            return true;
        }

        if (layout == Layout.Classic) {
            classicTargetScroll +=
                (float) verticalAmount * 35.0f;

            MorzhSoundManager.playScroll();
            return true;
        }

        if (inside(
            mouseX,
            mouseY,
            panelX + 102,
            panelY + 40,
            145,
            panelHeight - 46
        )) {
            moduleTargetScroll +=
                (float) verticalAmount * 28.0f;

            MorzhSoundManager.playScroll();
            return true;
        }

        return super.mouseScrolled(
            mouseX,
            mouseY,
            horizontalAmount,
            verticalAmount
        );
    }

    @Override
    public boolean keyPressed(
        int keyCode,
        int scanCode,
        int modifiers
    ) {
        if (keyCode == GLFW.GLFW_KEY_ESCAPE) {
            if (searching) {
                searching = false;
                MorzhSoundManager.playKeyRelease();
                return true;
            }

            if (!closing) {
                closing = true;
                dragging = false;
                MorzhSoundManager.playClose();
            }

            return true;
        }

        if (closing) return true;

        if (searching) {
            if (keyCode == GLFW.GLFW_KEY_ENTER
                || keyCode == GLFW.GLFW_KEY_KP_ENTER) {
                searching = false;
                MorzhSoundManager.playKeyRelease();
                return true;
            }

            if (keyCode == GLFW.GLFW_KEY_BACKSPACE) {
                if (!search.isEmpty()) {
                    search = search.substring(
                        0,
                        search.length() - 1
                    );

                    moduleTargetScroll = 0.0f;
                    MorzhSoundManager.playKeyRelease();
                }

                return true;
            }
        }

        return super.keyPressed(
            keyCode,
            scanCode,
            modifiers
        );
    }

    @Override
    public boolean charTyped(
        char chr,
        int modifiers
    ) {
        if (searching
            && !Character.isISOControl(chr)
            && search.length() < 40) {
            search += chr;
            moduleTargetScroll = 0.0f;

            MorzhSoundManager.playKeyPress();
            return true;
        }

        return super.charTyped(chr, modifiers);
    }

    private List<Module> getDisplayedModules() {
        List<Module> modules = new ArrayList<>();

        String query = search
            .trim()
            .toLowerCase(Locale.ROOT);

        for (Module module : Modules.get().getAll()) {
            if (Config.get()
                .hiddenModules
                .get()
                .contains(module)) {
                continue;
            }

            if (!query.isEmpty()) {
                boolean matches =
                    module.name
                        .toLowerCase(Locale.ROOT)
                        .contains(query)
                    || module.title
                        .toLowerCase(Locale.ROOT)
                        .contains(query)
                    || module.description != null
                        && module.description
                        .toLowerCase(Locale.ROOT)
                        .contains(query);

                if (matches) {
                    modules.add(module);
                }
            } else if (
                selectedCategory != null
                    && Modules.get()
                    .getGroup(selectedCategory)
                    .contains(module)
            ) {
                modules.add(module);
            }
        }

        modules.sort(
            (first, second) ->
                String.CASE_INSENSITIVE_ORDER.compare(
                    first.title,
                    second.title
                )
        );

        return modules;
    }

    private int getVisibleCategoryCount() {
        int count = 0;

        for (Category category : Modules.loopCategories()) {
            if (hasVisibleModules(category)) {
                count++;
            }
        }

        return count;
    }

    private boolean hasVisibleModules(
        Category category
    ) {
        for (Module module :
            Modules.get().getGroup(category)) {
            if (!Config.get()
                .hiddenModules
                .get()
                .contains(module)) {
                return true;
            }
        }

        return false;
    }

    private int primaryTextColor() {
        return blend(
            TEXT,
            GLASS_TEXT,
            glassTransition
        );
    }

    private int secondaryTextColor() {
        return blend(
            TEXT_SECONDARY,
            GLASS_TEXT_SECONDARY,
            glassTransition
        );
    }

    private void drawText(
        DrawContext context,
        String value,
        int x,
        int y,
        int color,
        boolean shadow
    ) {
        boolean readableShadow =
            shadow || glassTransition > 0.05f;

        if (readableShadow) {
            context.drawTextWithShadow(
                textRenderer,
                value,
                x,
                y,
                color
            );
        } else {
            context.drawText(
                textRenderer,
                value,
                x,
                y,
                color,
                false
            );
        }
    }

    private void drawSurface(
        DrawContext context,
        int x,
        int y,
        int surfaceWidth,
        int surfaceHeight,
        int radius,
        int solidColor,
        int glassColor,
        boolean accented
    ) {
        if (surfaceWidth <= 0 || surfaceHeight <= 0) {
            return;
        }

        float glass = MorzhAnimUtil.easeOutCubic(
            glassTransition
        );

        int baseColor = blend(
            solidColor,
            glassColor,
            glass
        );

        if (glass <= 0.01f) {
            roundedRect(
                context,
                x,
                y,
                surfaceWidth,
                surfaceHeight,
                radius,
                baseColor
            );

            return;
        }

        int shadowAlpha = Math.round(72.0f * glass);

        roundedRect(
            context,
            x + 1,
            y + 2,
            surfaceWidth,
            surfaceHeight,
            radius,
            withAlpha(
                GLASS_SHADOW,
                shadowAlpha
            )
        );

        int edgeBase = accented
            ? GLASS_EDGE_PURPLE
            : GLASS_EDGE;

        int edgeAlpha = Math.round(
            (accented ? 115.0f : 80.0f) * glass
        );

        roundedRect(
            context,
            x,
            y,
            surfaceWidth,
            surfaceHeight,
            radius,
            withAlpha(edgeBase, edgeAlpha)
        );

        if (surfaceWidth > 2 && surfaceHeight > 2) {
            roundedRect(
                context,
                x + 1,
                y + 1,
                surfaceWidth - 2,
                surfaceHeight - 2,
                Math.max(0, radius - 1),
                baseColor
            );
        }

        int highlightAlpha = Math.round(
            (accented ? 95.0f : 65.0f) * glass
        );

        int inset = Math.max(2, radius);

        if (surfaceWidth > inset * 2) {
            context.fill(
                x + inset,
                y + 1,
                x + surfaceWidth - inset,
                y + 2,
                withAlpha(
                    GLASS_HIGHLIGHT,
                    highlightAlpha
                )
            );
        }

        int sideAlpha = Math.round(
            38.0f * glass
        );

        if (surfaceHeight > inset * 2) {
            context.fill(
                x + 1,
                y + inset,
                x + 2,
                y + surfaceHeight - inset,
                withAlpha(
                    GLASS_HIGHLIGHT,
                    sideAlpha
                )
            );
        }

        int lowerShadeAlpha = Math.round(
            45.0f * glass
        );

        if (surfaceWidth > inset * 2) {
            context.fill(
                x + inset,
                y + surfaceHeight - 2,
                x + surfaceWidth - inset,
                y + surfaceHeight - 1,
                lowerShadeAlpha << 24
            );
        }
    }

    private static boolean inside(
        double mouseX,
        double mouseY,
        double x,
        double y,
        double targetWidth,
        double targetHeight
    ) {
        return mouseX >= x
            && mouseX <= x + targetWidth
            && mouseY >= y
            && mouseY <= y + targetHeight;
    }

    private static void roundedRect(
        DrawContext context,
        int x,
        int y,
        int rectWidth,
        int rectHeight,
        int radius,
        int color
    ) {
        if (rectWidth <= 0 || rectHeight <= 0) {
            return;
        }

        radius = Math.min(
            radius,
            Math.min(rectWidth / 2, rectHeight / 2)
        );

        context.fill(
            x + radius,
            y,
            x + rectWidth - radius,
            y + rectHeight,
            color
        );

        context.fill(
            x,
            y + radius,
            x + rectWidth,
            y + rectHeight - radius,
            color
        );

        for (int i = 0; i < radius; i++) {
            int inset = radius - i;

            context.fill(
                x + inset,
                y + i,
                x + rectWidth - inset,
                y + i + 1,
                color
            );

            context.fill(
                x + inset,
                y + rectHeight - i - 1,
                x + rectWidth - inset,
                y + rectHeight - i,
                color
            );
        }
    }

    private static int withAlpha(
        int color,
        int alpha
    ) {
        return color & 0x00FFFFFF
            | MathHelper.clamp(alpha, 0, 255) << 24;
    }

    private static int blend(
        int first,
        int second,
        float progress
    ) {
        progress = MorzhAnimUtil.clamp01(progress);

        int a1 = first >>> 24;
        int r1 = first >> 16 & 255;
        int g1 = first >> 8 & 255;
        int b1 = first & 255;

        int a2 = second >>> 24;
        int r2 = second >> 16 & 255;
        int g2 = second >> 8 & 255;
        int b2 = second & 255;

        int a = Math.round(
            a1 + (a2 - a1) * progress
        );

        int r = Math.round(
            r1 + (r2 - r1) * progress
        );

        int g = Math.round(
            g1 + (g2 - g1) * progress
        );

        int b = Math.round(
            b1 + (b2 - b1) * progress
        );

        return a << 24 | r << 16 | g << 8 | b;
    }

    private static String shorten(
        String value,
        int maxLength
    ) {
        if (value == null) return "";
        if (value.length() <= maxLength) return value;

        return value.substring(
            0,
            Math.max(0, maxLength - 3)
        ) + "...";
    }

    private static List<String> wrap(
        String value,
        int maxLength
    ) {
        List<String> lines = new ArrayList<>();

        if (value == null || value.isBlank()) {
            lines.add("No description.");
            return lines;
        }

        StringBuilder line = new StringBuilder();

        for (String word : value.split("\\s+")) {
            if (line.length() > 0
                && line.length()
                    + word.length()
                    + 1
                    > maxLength) {
                lines.add(line.toString());
                line.setLength(0);
            }

            if (line.length() > 0) {
                line.append(' ');
            }

            line.append(word);
        }

        if (!line.isEmpty()) {
            lines.add(line.toString());
        }

        return lines;
    }

    private enum Layout {
        Thunder,
        Classic
    }

    private enum VisualStyle {
        Solid,
        Glass
    }
}


