      viewer,
      viewerId,
      sessionId,
      MonitorChatStyle.SUMMARY,
      runtimeConfig,
    )
  }

  private fun frame(prob: String, progress: Float) =
    MonitorFrame(
      targetId = UUID.randomUUID(),
      targetName = "T$prob",
      headline = prob,
      placeholders = mapOf("prob" to prob),
      progress = progress,
      severity = MonitorSeverity.CALM,
      dataPresent = true,
