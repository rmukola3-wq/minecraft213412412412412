    public LivingEntity findTarget(ClientPlayerEntity player, boolean keepCurrent) {
        float range = attackRange(player);
        Vec3d look = RotationMath.INSTANCE.rotationToVector(Rotation.playerRotation()).normalize();
        double cos = Math.cos(Math.toRadians(fov.get() / 2.0d));
        if (keepCurrent && isValidTarget(target, player, range)) {
            double dot = look.dotProduct(target.getPos().subtract(player.getPos()).normalize());
            if (!hitPointResolver.hasValidPoint(target, range, ignoreWalls.get()) || dot <= cos) return null;
            return target;
        }
        EntityFilter filter = new EntityFilter();
        if (targetPlayers.get()) filter.add(EntityCategory.PLAYER);
        if (targetFriends.get()) filter.add(EntityCategory.FRIEND);
        if (targetMobs.get()) filter.add(EntityCategory.MOB);
        if (targetAnimals.get()) filter.add(EntityCategory.ANIMAL);
        ArrayList<LivingEntity> found = new ArrayList<>();
        for (Entity entity : mc.world.getEntities()) {
            if (entity instanceof LivingEntity living && filter.matches(living) && isValidTarget(living, player, range)
                && look.dotProduct(living.getPos().subtract(player.getPos()).normalize()) > cos) {
                found.add(living);
            }
        }
        EnumSet<TargetSortMode> set = EnumSet.noneOf(TargetSortMode.class);
        if (sortByFov.get()) set.add(TargetSortMode.BY_FOV);
        if (sortByHealth.get()) set.add(TargetSortMode.BY_HEALTH);
        if (sortByDistance.get()) set.add(TargetSortMode.BY_DISTANCE);
        List<LivingEntity> sorted = TargetSorters.of(set).sort(found, player);
        target = sorted.isEmpty() ? null : sorted.getFirst();
        return target;
    }

    public boolean isValidTarget(LivingEntity entity, ClientPlayerEntity player, float range) {
        if (entity == null || entity == player || !entity.isAlive() || entity.getHealth() <= 0.0f) return false;
        if (entity instanceof PlayerEntity other) {
            AntiBot antiBot = Modules.get().get(AntiBot.class);
            if (antiBot != null && antiBot.isBot(other)) return false;
        }
        if (ignoreNaked.get() && entity instanceof PlayerEntity) {
            boolean allEmpty = true;
            for (var stack : entity.getArmorItems()) {
                if (!stack.isEmpty()) {
                    allEmpty = false;
                    break;
                }
            }
            if (allEmpty) return false;
        }
        return hitPointResolver.hasValidPoint(entity, range, ignoreWalls.get());
    }

    public boolean canAttack(ClientPlayerEntity player, int lookahead) {
        if (target == null || !target.isAlive() || mc.currentScreen instanceof GenericContainerScreen) return false;
        UseAction useAction = player.getActiveItem().getUseAction();
        boolean blockingUse = useAction == UseAction.EAT || useAction == UseAction.DRINK || useAction == UseAction.CROSSBOW || useAction == UseAction.SPEAR || useAction == UseAction.BOW;
        if (player.isUsingItem() && blockingUse) {
            if (player.getActiveHand() == Hand.MAIN_HAND) return false;
            if (player.getActiveHand() == Hand.OFF_HAND && noHitWhileEatingOffhand.get()) return false;
        }
        float range = attackRange(player);
        if (!hitPointResolver.hasValidPoint(target, range, ignoreWalls.get())) return false;
        return IntStream.rangeClosed(0, lookahead).anyMatch(tick -> canCrit(player, tick));
    }

    public boolean canCrit(ClientPlayerEntity player, int ticks) {
        if (!(player.getAttackCooldownProgress(ticks + 0.5f) > 0.9f && attackCooldown - ticks <= 0)) return false;
        if (!onlyCriticalHit.get()) return true;
        SimulatedPlayer simulated = SimulatedPlayer.simulateLocalPlayer(ticks);
        boolean jumping = simulated.input.playerInput.jump();
        AutoJump autoJump = Modules.get().get(AutoJump.class);
        if (autoJump != null && autoJump.isActive()) jumping = true;
        if (critsWithSpace.get() && simulated.onGround && !jumping) return true;
        return shouldCrit(player, ticks);
    }

    public boolean shouldCrit(ClientPlayerEntity player, int ticks) {
        SimulatedPlayer simulated = SimulatedPlayer.simulateLocalPlayer(ticks);
        if (simulated.hasStatusEffect(StatusEffects.LEVITATION) || simulated.hasStatusEffect(StatusEffects.BLINDNESS) || simulated.hasStatusEffect(StatusEffects.SLOW_FALLING)) {
            return true;
        }
        if (BlockUtil.checkBlockIntersection(simulated.boundingBox, block -> block instanceof CobwebBlock)
            || simulated.isSubmergedInWater() || simulated.isInLava() || simulated.isClimbing() || player.getAbilities().flying) {
            return true;
        }
        if (player.getMainHandStack().getItem() instanceof MaceItem) {
            return MaceItem.shouldDealAdditionalDamage(player);
        }
        boolean nextGround = SimulatedPlayer.simulateLocalPlayer(ticks + 1).onGround;
        boolean afterGround = SimulatedPlayer.simulateLocalPlayer(ticks + 2).onGround;
        boolean fallingLand = simulated.fallDistance > 1.0f && nextGround;
        boolean snapshots = verticalCollisionSnapshot(4) || verticalCollisionSnapshot(5) || verticalCollisionSnapshot(6) || verticalCollisionSnapshot(7);
        boolean deepFallIntoGround = simulated.velocity.y < -0.3d && afterGround && snapshots;
        boolean fallEqualsVel = simulated.fallDistance == (float) simulated.velocity.y && nextGround;
        return !(simulated.onGround || simulated.fallDistance <= 0.0f || deepFallIntoGround || fallEqualsVel || fallingLand);
    }

    public boolean verticalCollisionSnapshot(int ticksAgo) {
        if (ticksAgo < 0 || ticksAgo >= verticalCollisionHistory.length) return mc.player.verticalCollision;
        return verticalCollisionHistory[ticksAgo];
    }

