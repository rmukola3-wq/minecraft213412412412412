public final class IdealHitUtility {
    private IdealHitUtility() {
    }

    public static float getNewFallDistance(KillAura aura, LivingEntity target) {
        if (aura.critsBypassEnabled()) return RockstarMath.random(0f, 0.3f);
        return 0f;
    }

    public static boolean canAiFall(KillAura aura) {
        return (block(0, 3, 0) == Blocks.AIR
            && block(0, 2, 0) == Blocks.AIR
            && block(0, 1, 0) == Blocks.AIR)
            || mc.player.fallDistance < (block(0, 2, 0) != Blocks.AIR ? 0.08f : 0.6f)
            || mc.player.fallDistance > 1.2f;
    }

    /**
     * Rockstar {@code Aura#canCritical()}.
     *
     * @param predict adds the {@code FallingPlayer} lookahead used by Rockstar's
     *                {@code predictHit}, letting the hit land one tick earlier.
     */
    public static boolean canCritical(KillAura aura, LivingEntity target, boolean predict) {
        if (mc.player == null) return false;
        if (!aura.onlyCritsEnabled()) return true;

        double yDiff = (int) mc.player.getY() - mc.player.getY();
        boolean microFallA = yDiff == -0.01250004768371582;
        boolean microFallB = yDiff == -0.1875;

        if (!mc.player.isOnGround() && canAiFall(aura)) {
            float required = getNewFallDistance(aura, target);

            // 1.21.4 leaves Entity#fallDistance at 0 for the local player unless
            // a mixin restores it. trackedFall is the same downward-Y accumulator
            // vanilla used to write into that field on 1.16 (what Rockstar reads).
            if (aura.getFallDistance() > required) return true;
            if (predict && FallingPlayer.fromPlayer(mc.player).findFall(required)) return true;
        }

        if ((microFallB || microFallA) && !mc.player.isSneaking()) return true;
        if (mc.player.hasStatusEffect(StatusEffects.BLINDNESS)) return true;
        if (mc.player.hasStatusEffect(StatusEffects.LEVITATION)) return true;
        if (mc.player.hasStatusEffect(StatusEffects.SLOW_FALLING)) return true;
        if (mc.player.isInLava() || mc.player.isTouchingWater()) return true;
        if (mc.player.isClimbing() || mc.player.hasVehicle()) return true;
        if (block(0, 0, 0) == Blocks.COBWEB) return true;
        if (mc.player.getAbilities().flying) return true;
        if (Modules.get().isActive(Criticals.class)) return true;

        return aura.smartCritsEnabled()
            && mc.player.isOnGround()
            && !mc.options.jumpKey.isPressed();
    }

    private static Block block(double x, double y, double z) {
        return mc.world.getBlockState(
            BlockPos.ofFloored(
                mc.player.getX() + x,
                mc.player.getY() + y,
                mc.player.getZ() + z
            )
        ).getBlock();
    }
}


