package meteordevelopment.meteorclient.systems.modules.combat.aura.javelin;

import meteordevelopment.meteorclient.utils.world.TickRate;
import net.minecraft.entity.Entity;
import net.minecraft.util.math.Box;
import net.minecraft.util.math.MathHelper;
import net.minecraft.util.math.Vec3d;

import java.util.Random;

import static meteordevelopment.meteorclient.MeteorClient.mc;

/**
 * SpookyTime-style step from Javelin/forum ST paste: distance speed, yaw-diff smooth,
 * slower pitch, 280° AimModulo cap, mouse GCD, tiny-delta freeze.
 * Multipoints + 150ms post-hit damp from the same threads. No 98° flicks / golden-ratio slop.
 */
public final class JavelinStEngine {
    private final Random random = new Random();
    private float lastYaw;
    private float lastPitch;
    private boolean inited;
    private Vec3d bodyNorm = new Vec3d(0.5, 0.68, 0.5);
    private long bodyUntil;
    private long freezeUntil;
    private boolean wasAttacking;
    private int lastEntityId = -1;
    private Vec3d lastBias = Vec3d.ZERO;

    public void reset() {
        inited = false;
        lastEntityId = -1;
        freezeUntil = 0;
        wasAttacking = false;
        bodyUntil = 0;
        lastBias = Vec3d.ZERO;
    }

    public Vec3d randomBias() {
        return lastBias;
    }

    /**
     * @param hitNow   cooldown+crit this tick — must land on the box
     * @param hitSoon  crit window in the next few ticks — start locking before the jump apex
     * @param postHit  real swing already went out — damp after the hit, not before
     */
    public float[] tick(float currentYaw, float currentPitch, Entity entity, boolean hitNow, boolean hitSoon, boolean postHit) {
        if (mc.player == null) return new float[]{currentYaw, currentPitch};

        lastYaw = currentYaw;
        lastPitch = currentPitch;
        inited = true;

        if (entity == null) {
            wasAttacking = false;
            freezeUntil = 0;
            lastEntityId = -1;
            return new float[]{currentYaw, currentPitch};
        }

        if (entity.getId() != lastEntityId) {
            lastEntityId = entity.getId();
            bodyUntil = 0;
        }

        long now = System.currentTimeMillis();
        boolean lockOn = hitNow || hitSoon;
        if (postHit && !lockOn) {
            freezeUntil = Math.max(freezeUntil, now + 120L);
        }
        wasAttacking = hitNow;

        Vec3d point = aimPoint(entity, now, lockOn);
        Vec3d eyes = mc.player.getEyePos();

        float neuroRand1 = random.nextFloat();
        float neuroRand2 = random.nextFloat();
        float neuroRand3 = random.nextFloat();
        float neuroRand4 = random.nextFloat();

        float distToTarget = (float) eyes.distanceTo(point);

        float distanceFactor;
        if (distToTarget < 2.0f) {
            distanceFactor = 0.8f + neuroRand1 * 0.4f;
        } else if (distToTarget < 4.0f) {
            distanceFactor = 1.2f + neuroRand2 * 0.6f;
        } else {
            distanceFactor = 0.9f + neuroRand3 * 0.5f;
        }

        float tpsMultiplier = tpsFactor();
        float baseSpeed = MathHelper.clamp(distToTarget * 0.25f, 0.8f, 3.0f) * distanceFactor * tpsMultiplier;

        Vec3d delta = point.subtract(eyes);
        float targetYaw = (float) MathHelper.wrapDegrees(Math.toDegrees(Math.atan2(delta.z, delta.x)) - 90.0);
        float targetPitch = MathHelper.clamp(
            (float) (-Math.toDegrees(Math.atan2(delta.y, Math.hypot(delta.x, delta.z)))),
            -90.0F, 90.0F
        );

        float yawDiff = MathHelper.wrapDegrees(targetYaw - lastYaw);
        float pitchDiff = targetPitch - lastPitch;

        boolean moving = mc.player.getVelocity().horizontalLengthSquared() > 0.003
            || (mc.player.input != null && (mc.player.input.movementForward != 0.0f || mc.player.input.movementSideways != 0.0f));

        float smoothYaw;
        float smoothPitch;
        if (hitNow) {
            float factor = 0.38f + neuroRand1 * 0.12f;
            float yawCap = moving ? 12.0f : 28.0f;
            float pitchCap = moving ? 8.0f : 16.0f;
            smoothYaw = MathHelper.clamp(yawDiff * factor, -yawCap, yawCap);
            smoothPitch = MathHelper.clamp(pitchDiff * (factor * 0.7f), -pitchCap, pitchCap);
        } else if (hitSoon) {
            float factor = 0.26f + neuroRand2 * 0.10f;
            float yawCap = moving ? 10.0f : 22.0f;
            float pitchCap = moving ? 7.0f : 14.0f;
            smoothYaw = MathHelper.clamp(yawDiff * factor, -yawCap, yawCap);
            smoothPitch = MathHelper.clamp(pitchDiff * (factor * 0.65f), -pitchCap, pitchCap);
        } else {
            float smoothFactorBase;
            if (distToTarget < 3.0f && Math.abs(yawDiff) < 10.0f) {
                smoothFactorBase = 0.08f + neuroRand2 * 0.06f;
            } else if (distToTarget > 5.0f || Math.abs(yawDiff) > 30.0f) {
                smoothFactorBase = 0.18f + neuroRand3 * 0.12f;
            } else {
                smoothFactorBase = 0.12f + neuroRand1 * 0.08f;
            }

            float tpsAdapt = tpsMultiplier > 1.2f ? 0.9f : (tpsMultiplier < 0.8f ? 1.2f : 1.0f);
            smoothFactorBase *= tpsAdapt;
            if (now < freezeUntil) {
                smoothFactorBase *= 0.45f;
            }

            smoothYaw = yawDiff * smoothFactorBase * (baseSpeed * 0.7f);
            smoothPitch = pitchDiff * smoothFactorBase * (baseSpeed * 0.5f);
            if (moving) {
                smoothYaw *= 0.62f;
                smoothPitch *= 0.62f;
            }

            if (neuroRand4 < 0.02f) {
                smoothYaw += (random.nextFloat() - 0.5f) * 1.2f;
                smoothPitch += (random.nextFloat() - 0.5f) * 0.8f;
            }

            smoothYaw += (float) Math.sin(now / 300.0) * 0.03f;
            smoothPitch += (float) Math.cos(now / 500.0) * 0.02f;

            if (random.nextFloat() < 0.05f && Math.abs(yawDiff) > 5.0f) {
                smoothYaw *= 1.1f + random.nextFloat() * 0.3f;
            }
        }

        float newYaw = lastYaw + smoothYaw;
        float newPitch = MathHelper.clamp(lastPitch + smoothPitch, -90.0F, 90.0F);

        if (!lockOn) {
            float gcd = gcdStep();
            if (gcd > 1e-5f) {
                newYaw = newYaw - (newYaw - lastYaw) % gcd;
                newPitch = newPitch - (newPitch - lastPitch) % gcd;
            }
            newPitch = MathHelper.clamp(newPitch, -90.0F, 90.0F);
            if (Math.abs(newYaw - lastYaw) < 0.01f && Math.abs(newPitch - lastPitch) < 0.01f) {
                newYaw = lastYaw;
                newPitch = lastPitch;
            }
        }

        lastYaw = newYaw;
        lastPitch = newPitch;
        return new float[]{newYaw, newPitch};
    }

    private Vec3d aimPoint(Entity entity, long now, boolean lockOn) {
        if (now >= bodyUntil) {
            bodyNorm = switch (random.nextInt(6)) {
                case 0 -> jitterNorm(0.5, 0.90, 0.5, 0.035, 0.035, 0.03);
                case 1 -> jitterNorm(0.5, 0.72, 0.5, 0.06, 0.05, 0.045);
                case 2 -> jitterNorm(0.5, 0.56, 0.5, 0.055, 0.05, 0.04);
                case 3 -> jitterNorm(0.33, 0.68, 0.47, 0.04, 0.05, 0.03);
                case 4 -> jitterNorm(0.67, 0.68, 0.53, 0.04, 0.05, 0.03);
                default -> jitterNorm(0.5, 0.42, 0.5, 0.05, 0.045, 0.035);
            };
            bodyUntil = now + 120L + random.nextInt(150);
            lastBias = new Vec3d(
                (bodyNorm.x - 0.5) * 0.18,
                (bodyNorm.y - 0.5) * 0.24,
                (bodyNorm.z - 0.5) * 0.18
            );
        }

        Box box = entity.getBoundingBox();
        Vec3d norm = lockOn ? new Vec3d(0.5, 0.62, 0.5) : bodyNorm;
        double x = MathHelper.lerp(norm.x, box.minX + box.getLengthX() * 0.14, box.maxX - box.getLengthX() * 0.14);
        double y = MathHelper.lerp(norm.y, box.minY + box.getLengthY() * 0.08, box.maxY - box.getLengthY() * 0.04);
        double z = MathHelper.lerp(norm.z, box.minZ + box.getLengthZ() * 0.14, box.maxZ - box.getLengthZ() * 0.14);
        Vec3d point = new Vec3d(x, y, z);
        if (!lockOn) point = point.add(entity.getVelocity().multiply(0.4));
        return point;
    }

    private Vec3d jitterNorm(double x, double y, double z, double xs, double ys, double zs) {
        return new Vec3d(
            MathHelper.clamp(x + random.nextGaussian() * xs, 0.18, 0.82),
            MathHelper.clamp(y + random.nextGaussian() * ys, 0.10, 0.96),
            MathHelper.clamp(z + random.nextGaussian() * zs, 0.18, 0.82)
        );
    }

    private static float tpsFactor() {
        float tps = TickRate.INSTANCE.getTickRate();
        if (tps < 1.0f || Float.isNaN(tps)) tps = 20.0f;
        return tps / 20.0f;
    }

    private static float gcdStep() {
        if (mc.options == null) return 0.15f;
        double sensitivity = mc.options.getMouseSensitivity().getValue() * 0.6 + 0.2;
        return (float) (sensitivity * sensitivity * sensitivity * 8.0 * 0.15);
    }
}


