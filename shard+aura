        ExpensiveAura expensiveAura = Modules.get().get(ExpensiveAura.class);
        if (expensiveAura != null && expensiveAura.isActive()) {
            MeteorClient.EVENT_BUS.post(RotationUpdateEvent.get(RotationUpdateEvent.Type.PRE));
