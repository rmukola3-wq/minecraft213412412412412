public class SmoothRotationMode extends RotationMode {
    public SmoothRotationMode() {
        super("Funtime");
    }

    @Override
    public Rotation process(Rotation current, Rotation target, Vec3d vec, Entity entity) {
        Rotation diff = RotationMath.INSTANCE.calculateRotationDifference(target, current);
        float yaw = diff.getYaw();
        float pitch = diff.getPitch();
        float hypot = (float) Math.hypot(Math.abs(yaw), Math.abs(pitch));
        float maxYaw = Math.abs(yaw / hypot) * 60.0f;
        float maxPitch = Math.abs(pitch / hypot) * 40.0f;
        float clampYaw = MathHelper.clamp(yaw, -maxYaw, maxYaw) + (shouldCrit() ? 0.0f : (float) Math.ceil(randomLerp(2.0f, 5.0f) * Math.sin(System.currentTimeMillis() / 40.0d)));
        float clampPitch = MathHelper.clamp(pitch, -maxPitch, maxPitch);
        Rotation next = new Rotation(current.getYaw(), current.getPitch());
        next.setYaw((float) MathHelper.lerp(0.6000000238418579d + (ThreadLocalRandom.current().nextFloat(0.0f, 1.0f) * 0.6000000238418579d), current.getYaw(), current.getYaw() + clampYaw));
        next.setPitch((float) MathHelper.lerp(0.5d + (ThreadLocalRandom.current().nextFloat(0.0f, 1.0f) * 0.5d), current.getPitch(), current.getPitch() + clampPitch));
        return new Rotation(next.getYaw(), next.getPitch());
    }

