import meteordevelopment.meteorclient.utils.player.FindItemResult;
import meteordevelopment.meteorclient.utils.player.InvUtils;
import net.minecraft.client.network.ClientPlayerEntity;
import net.minecraft.entity.LivingEntity;
import net.minecraft.entity.player.PlayerEntity;
import net.minecraft.item.AxeItem;
import net.minecraft.item.ShieldItem;
import net.minecraft.network.packet.c2s.play.HandSwingC2SPacket;
import net.minecraft.network.packet.c2s.play.PlayerMoveC2SPacket;
import net.minecraft.network.packet.c2s.play.UpdateSelectedSlotC2SPacket;
import net.minecraft.util.Hand;

import static meteordevelopment.meteorclient.MeteorClient.mc;

/**
 * Atomic attack execution with Thunder-style packet rotation and shield break.
 */
public final class AuraAttackPipeline {
    private AuraAttackPipeline() {
    }

    public static boolean shouldShieldBreak(LivingEntity target) {
        if (!(target instanceof PlayerEntity player)) return false;
        if (!player.isBlocking()) return false;

        return player.getActiveItem().getItem() instanceof ShieldItem;
    }

    public static boolean executeShieldBreak(
        LivingEntity target,
        float attackYaw,
        float attackPitch,
        boolean packetRotation,
        AuraSprintSession sprint
    ) {
        if (mc.player == null || mc.interactionManager == null || target == null) {
            return false;
        }

        FindItemResult axe = InvUtils.findInHotbar(stack -> stack.getItem() instanceof AxeItem);

        if (!axe.found()) return false;

        ClientPlayerEntity player = mc.player;
        int previousSlot = player.getInventory().selectedSlot;
        float clientYaw = player.getYaw();
        float clientPitch = player.getPitch();
        boolean sprintKey = mc.options.sprintKey.isPressed();

        sprint.begin(player);
        sprint.stopSprint(player, true);

        try {
            if (packetRotation && player.networkHandler != null) {
                player.networkHandler.sendPacket(
                    new PlayerMoveC2SPacket.Full(
                        player.getX(),
                        player.getY(),
                        player.getZ(),
                        attackYaw,
                        attackPitch,
                        player.isOnGround(),
                        player.horizontalCollision
                    )
                );
            }

            if (axe.slot() != previousSlot && player.networkHandler != null) {
                player.networkHandler.sendPacket(
                    new UpdateSelectedSlotC2SPacket(axe.slot())
                );
                player.getInventory().selectedSlot = axe.slot();
            }

            mc.interactionManager.attackEntity(player, target);
            player.swingHand(Hand.MAIN_HAND);

            if (axe.slot() != previousSlot && player.networkHandler != null) {
                player.networkHandler.sendPacket(
                    new UpdateSelectedSlotC2SPacket(previousSlot)
                );
                player.getInventory().selectedSlot = previousSlot;
            }

            if (packetRotation && player.networkHandler != null) {
                player.networkHandler.sendPacket(
                    new PlayerMoveC2SPacket.Full(
                        player.getX(),
                        player.getY(),
                        player.getZ(),
                        clientYaw,
                        clientPitch,
                        player.isOnGround(),
                        player.horizontalCollision
                    )
                );
            }

            return true;
        } finally {
            sprint.restore(player, true);
            mc.options.sprintKey.setPressed(sprintKey);
        }
    }

    public static void executeAttack(
        LivingEntity target,
        float attackYaw,
        float attackPitch,
        boolean packetRotation,
        AuraSprintSession sprint
    ) {
        if (mc.player == null || mc.interactionManager == null || target == null) {
            return;
        }

        ClientPlayerEntity player = mc.player;
        float clientYaw = player.getYaw();
        float clientPitch = player.getPitch();

        sprint.begin(player);
        sprint.stopSprint(player, true);

        try {
            if (packetRotation && player.networkHandler != null) {
                player.networkHandler.sendPacket(
                    new PlayerMoveC2SPacket.Full(
                        player.getX(),
                        player.getY(),
                        player.getZ(),
                        attackYaw,
                        attackPitch,
                        player.isOnGround(),
                        player.horizontalCollision
                    )
                );
            }

            mc.interactionManager.attackEntity(player, target);
            player.swingHand(Hand.MAIN_HAND);
        } finally {
            if (packetRotation && player.networkHandler != null) {
                player.networkHandler.sendPacket(
                    new PlayerMoveC2SPacket.Full(
                        player.getX(),
                        player.getY(),
                        player.getZ(),
                        clientYaw,
                        clientPitch,
                        player.isOnGround(),
                        player.horizontalCollision
                    )
                );
            }

            sprint.restore(player, true);
        }
    }
}


