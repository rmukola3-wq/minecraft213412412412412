package meteordevelopment.meteorclient.systems.modules.combat.aura.sloth;

import meteordevelopment.meteorclient.systems.modules.combat.aura.expensive.Rotation;
import meteordevelopment.meteorclient.systems.modules.combat.aura.expensive.RotationMath;
import net.minecraft.entity.Entity;
import net.minecraft.util.math.Box;
import net.minecraft.util.math.MathHelper;
import net.minecraft.util.math.Vec3d;

import java.util.concurrent.ThreadLocalRandom;

import static meteordevelopment.meteorclient.MeteorClient.mc;

/**
 * Forum Sloth/Shard notes:
 * speed barely matters — aim fast;
 * many multipoints, never land 9 hits on one spot;
 * glance off the box for 10–200ms often (most important).
 */
public final class SlothRotationEngine {
    private static final float[] XS = {0.12F, 0.20F, 0.28F, 0.36F, 0.44F, 0.50F, 0.56F, 0.64F, 0.72F, 0.80F, 0.88F};
    private static final float[] YS = {
        0.96F, 0.90F, 0.84F, 0.78F, 0.72F, 0.66F, 0.60F, 0.54F,
        0.48F, 0.42F, 0.36F, 0.30F, 0.24F, 0.18F, 0.12F, 0.06F
    };
    private static final float[] ZS = {0.12F, 0.22F, 0.32F, 0.42F, 0.50F, 0.58F, 0.68F, 0.78F, 0.88F};

    private int lastId = -1;
    private int ix, iy, iz;
    private int dwell;
    private int glanceTicks;
    private float glanceYaw;
    private float glancePitch;
    private final int[] recentHits = new int[9];
    private int recentAt;
    private Vec3d lastBias = new Vec3d(0.01, 0.07, 0.02);

    public void reset() {
        lastId = -1;
        dwell = 0;
        recentAt = 0;
        for (int i = 0; i < recentHits.length; i++) recentHits[i] = -1;
        lastBias = new Vec3d(0.01, 0.07, 0.02);
        ThreadLocalRandom r = ThreadLocalRandom.current();
        pickPoint(r, -1);
        startGlance(r);
    }

    public void onAttack() {
        int hit = pack(ix, iy, iz);
        recentHits[recentAt++ % recentHits.length] = hit;
        ThreadLocalRandom r = ThreadLocalRandom.current();
        pickPoint(r, hit);
        startGlance(r);
    }

    public Vec3d randomBias() {
        return lastBias;
    }

    public float[] tick(float currentYaw, float currentPitch, Entity entity, boolean hitNow, boolean hitSoon) {
        if (mc.player == null || entity == null) return new float[]{currentYaw, currentPitch};
        ThreadLocalRandom r = ThreadLocalRandom.current();

        if (entity.getId() != lastId) {
            reset();
            lastId = entity.getId();
        }

        boolean needHit = hitNow || hitSoon;
        if (needHit) glanceTicks = 0;

        if (!needHit && --dwell <= 0) pickPoint(r, -1);

        if (!needHit && glanceTicks <= 0 && r.nextFloat() < 0.22F) {
            startGlance(r);
        }

        Vec3d point = pointOnBox(entity.getBoundingBox());
        Rotation want = RotationMath.INSTANCE.fromVec3d(point.subtract(mc.player.getEyePos()));
        float wantYaw = want.getYaw();
        float wantPitch = want.getPitch();

        if (glanceTicks > 0) {
            glanceTicks--;
            wantYaw += glanceYaw;
            wantPitch = MathHelper.clamp(wantPitch + glancePitch, -89.0F, 89.0F);
        }

        float dy = MathHelper.wrapDegrees(wantYaw - currentYaw);
        float dp = wantPitch - currentPitch;
        float speed = needHit ? r.nextFloat(0.62F, 0.95F) : r.nextFloat(0.48F, 0.88F);
        dy *= speed;
        dp *= speed;
        dy += r.nextFloat(-1.8F, 1.8F);
        dp += r.nextFloat(-1.1F, 1.1F);

        float capYaw = needHit ? r.nextFloat(38.0F, 72.0F) : r.nextFloat(28.0F, 64.0F);
        float capPitch = needHit ? r.nextFloat(22.0F, 42.0F) : r.nextFloat(16.0F, 36.0F);
        dy = MathHelper.clamp(dy, -capYaw, capYaw);
        dp = MathHelper.clamp(dp, -capPitch, capPitch);
        return new float[]{currentYaw + dy, MathHelper.clamp(currentPitch + dp, -89.9F, 89.9F)};
    }

    private void startGlance(ThreadLocalRandom r) {
        glanceTicks = 1 + r.nextInt(4);
        float yawSign = r.nextBoolean() ? 1.0F : -1.0F;
        float pitchSign = r.nextBoolean() ? 1.0F : -1.0F;
        glanceYaw = yawSign * r.nextFloat(14.0F, 48.0F);
        glancePitch = pitchSign * r.nextFloat(8.0F, 28.0F);
    }

    private void pickPoint(ThreadLocalRandom r, int avoidHit) {
        int nx, ny, nz, packed;
        int guard = 0;
        do {
            nx = r.nextInt(XS.length);
            ny = r.nextInt(YS.length);
            nz = r.nextInt(ZS.length);
            packed = pack(nx, ny, nz);
            guard++;
        } while (guard < 24 && (packed == avoidHit || usedRecently(packed)));
        ix = nx;
        iy = ny;
        iz = nz;
        dwell = 2 + r.nextInt(4);
        lastBias = new Vec3d((XS[ix] - 0.5) * 0.06, 0.05 + (YS[iy] - 0.5) * 0.06, (ZS[iz] - 0.5) * 0.06);
    }

    private boolean usedRecently(int packed) {
        for (int recent : recentHits) {
            if (recent == packed) return true;
        }
        return false;
    }

    private Vec3d pointOnBox(Box box) {
        ThreadLocalRandom r = ThreadLocalRandom.current();
        float j = 0.03F;
        return new Vec3d(
            MathHelper.lerp(MathHelper.clamp(XS[ix] + (r.nextFloat() - 0.5F) * j, 0.08, 0.92), box.minX, box.maxX),
            MathHelper.lerp(MathHelper.clamp(YS[iy] + (r.nextFloat() - 0.5F) * j, 0.04, 0.97), box.minY, box.maxY),
            MathHelper.lerp(MathHelper.clamp(ZS[iz] + (r.nextFloat() - 0.5F) * j, 0.08, 0.92), box.minZ, box.maxZ)
        );
    }

    private static int pack(int x, int y, int z) {
        return (x << 16) | (y << 8) | z;
    }
}


