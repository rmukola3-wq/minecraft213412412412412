data class MonitorOutputsConfig(
  val actionBar: ActionBarConfig,
  val bossBar: BossBarConfig,
  val sidebar: SidebarConfig,
  val chat: ChatConfig,
  val tabList: TabListConfig,
) {
  fun isEnabled(kind: MonitorOutputKind): Boolean =
    when (kind) {
