        int i = hitCounter;
        return switch (rotationMode.get()) {
            case SMOOTH -> smoothAttackDelays[i % smoothAttackDelays.length];
            case FUNTIME -> funtimeAttackDelays[i % funtimeAttackDelays.length];
            case SLOTH, JAVELIN, GRIM -> 0;
            default -> 10;
        };
    }

