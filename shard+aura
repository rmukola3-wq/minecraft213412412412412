/**
 * Rockstar {@code ClassicRotation} — «Классическая».
 */
public final class ClassicRotation extends RockstarRotationMode {
    private final RockstarInterp interp = new RockstarInterp();

    @Override
    public void update(KillAura aura, LivingEntity target) {
        if (mc.player == null) return;

        boolean snapIdle = aura.classicSnap()
            && (!aura.canCritical() || !aura.attackTimerPassed(300));

        if (target == null || snapIdle) {
            float[] next = interp.animate(
                mc.player.getYaw(),
                mc.player.getPitch(),
                220,
                220
            );
            yaw = next[0];
            pitch = next[1];
            return;
        }

        Vec3d point = aura.getCurrentAimPoint() != null
            ? aura.getCurrentAimPoint()
            : (aura.useMultipoint()
                ? RockstarMath.closestPoint(target)
                : target.getEyePos());

        float[] rot = RockstarMath.anglesToEyes(point);

        if (aura.classicSpeed() == KillAura.ClassicSpeed.Instant) {
            yaw = rot[0];
            pitch = rot[1];
            interp.reset(yaw, pitch);
            return;
        }

        float shortest = RockstarMath.wrapDelta(interp.getYaw(), rot[0]);
        float targetYaw = interp.getYaw() + shortest;
        int yawSpeed = (int) yawSpeed(aura, Math.abs(interp.getYaw() - targetYaw));
        int pitchSpeed = (int) (100 - aura.classicSpeedY());

        float[] next = interp.animate(targetYaw, rot[1], yawSpeed, Math.max(1, pitchSpeed));
        yaw = next[0];
        pitch = next[1];
    }

    @Override
    public void reset(int reason) {
        super.reset(reason);
        if (mc.player == null) return;

        if (reason > 0) {
            float shortest = RockstarMath.wrapDelta(yaw, mc.player.getYaw());
            mc.player.setYaw(yaw + shortest);
        }

        interp.reset(mc.player.getYaw(), mc.player.getPitch());
        yaw = mc.player.getYaw();
        pitch = mc.player.getPitch();
    }

    private float yawSpeed(KillAura aura, float diff) {
        if (aura.classicSpeed() == KillAura.ClassicSpeed.Static) {
            return 100 - aura.classicSpeedX();
        }

        return MathHelper.clamp(
            diff,
            RockstarMath.randomInt(1, 50),
            RockstarMath.randomInt(150, 200)
        );
    }
}


