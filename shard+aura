      .trimIndent() + "\n"

  @Test
  fun `readVersion returns 0 when key is absent`(@TempDir tempDir: Path) {
    val file = tempDir.resolve("config.yml").toFile()
    file.writeText("""locale: "en"""" + "\n")
    assertEquals(0, ConfigMigrations.readVersion(file))
