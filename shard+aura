import meteordevelopment.meteorclient.systems.modules.combat.KillAura;
import net.minecraft.block.Blocks;
import net.minecraft.entity.LivingEntity;
import net.minecraft.util.math.BlockPos;
import net.minecraft.util.math.Box;
import net.minecraft.util.math.MathHelper;
import net.minecraft.util.math.Vec3d;

import static meteordevelopment.meteorclient.MeteorClient.mc;

/**
 * Rockstar {@code SpookyRotation} — «Альтернативная».
 */
public final class AlternativeRotation extends RockstarRotationMode {
    @Override
    public void update(KillAura aura, LivingEntity target) {
        if (mc.player == null) return;

        if (target == null) {
            yaw = mc.player.getYaw();
            pitch = mc.player.getPitch();
            return;
        }

        Vec3d vec = RockstarMath.closestPoint(target).subtract(mc.player.getEyePos());

        float headYaw = mc.player.getYaw();
        float headPitch = mc.player.getPitch();

        float shortest = (float) ((((((Math.toDegrees(Math.atan2(vec.z, vec.x)) - 90)
            - yaw) % 360) + 540) % 360) - 180);
        float yawToTarget = headYaw + shortest;
        float pitchToTarget = (float) -Math.toDegrees(
            Math.atan2(vec.y, Math.hypot(vec.z, vec.x))
        );

        float yawDelta = MathHelper.wrapDegrees(yawToTarget - headYaw);
        float pitchDelta = MathHelper.wrapDegrees(pitchToTarget - headPitch);

        float speed = RockstarMath.getSens(RockstarMath.random(0.6, 0.8));
        float testCountSpeed = RockstarMath.getSens(RockstarMath.random(130, 155));
        float rayCaster = RockstarMath.rayTrace(
            aura.attackRange(),
            headYaw,
            headPitch,
            target
        ) ? 0.4f : 1.0f;

        float clampYaw = Math.min(Math.abs(yawDelta), testCountSpeed) * speed;
        yawDelta = yawDelta > 0 ? clampYaw : -clampYaw;

        if (collidingAndCornered(target)) yawDelta /= 30.0f;

        float clampPitch = (float) (
            Math.min(Math.abs(pitchDelta), RockstarMath.random(23.133, 26.477))
                * speed / testCountSpeed * 90 * rayCaster
        );
        pitchDelta = pitchDelta > 0 ? clampPitch : -clampPitch;

        if (pitchDelta > 0) pitchDelta += RockstarMath.random(-0.826, 0.459);

        float[] fixed = RockstarMath.fixDeltaNonVanillaMouse(yawDelta, pitchDelta);
        yawDelta = fixed[0];
        pitchDelta = fixed[1];

        yaw = RockstarMath.correctRotation(headYaw + yawDelta);
        pitch = MathHelper.clamp(
            RockstarMath.correctRotation(headPitch + pitchDelta),
            -90.0f,
            90.0f
        );

        float[] snapped = RockstarMath.correctRotation(yaw, pitch);
        yaw = snapped[0];
        pitch = snapped[1];
    }

    private boolean collidingAndCornered(LivingEntity target) {
        if (!mc.player.getBoundingBox().intersects(target.getBoundingBox().expand(0.05))) {
            return false;
        }

        return stalin(target) || enclosed();
    }

    private boolean enclosed() {
        return block(0, 2, 0) != Blocks.AIR
            && block(0, -1, 0) != Blocks.AIR
            && block(0, 2, 0) != Blocks.WATER
            && block(0, -1, 0) != Blocks.WATER;
    }

    private boolean stalin(LivingEntity target) {
        Vec3d pos = target.getPos();
        Box hitbox = target.getBoundingBox();
        float off = 0.05f;

        return !isAir(hitbox.minX - off, pos.y, hitbox.minZ - off)
            || !isAir(hitbox.maxX + off, pos.y, hitbox.minZ - off)
            || !isAir(hitbox.minX - off, pos.y, hitbox.maxZ + off)
            || !isAir(hitbox.maxX + off, pos.y, hitbox.maxZ + off);
    }

    private boolean isAir(double x, double y, double z) {
        return mc.world.getBlockState(BlockPos.ofFloored(x, y, z)).isOf(Blocks.AIR);
    }

    private net.minecraft.block.Block block(double x, double y, double z) {
        return mc.world.getBlockState(
            BlockPos.ofFloored(
                mc.player.getX() + x,
                mc.player.getY() + y,
                mc.player.getZ() + z
            )
        ).getBlock();
    }
}


