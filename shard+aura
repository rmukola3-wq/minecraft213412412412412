    when (uri.scheme?.lowercase()) {
      "https" -> true
      "http" -> uri.host?.lowercase()?.removeSurrounding("[", "]") in LOOPBACK_HOSTS
      else -> false
    }
  } catch (_: IllegalArgumentException) {
    false
