package meteordevelopment.meteorclient.systems.modules.combat.aura.expensive;

import meteordevelopment.meteorclient.systems.friends.Friends;
import net.minecraft.entity.Entity;
import net.minecraft.entity.player.PlayerEntity;

import java.util.HashSet;
import java.util.Set;

public final class EntityFilter {
    public final Set<EntityCategory> categories = new HashSet<>();

    public EntityFilter add(EntityCategory category) {
        categories.add(category);
        return this;
    }

    public boolean matches(Entity entity) {
        boolean friend = entity instanceof PlayerEntity player && Friends.get().isFriend(player);
        if (friend) return categories.contains(EntityCategory.FRIEND);

        for (EntityCategory category : categories) {
            if (category == EntityCategory.FRIEND) continue;
            if (category.matches(entity)) return true;
        }
        return false;
    }
}


