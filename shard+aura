            pitch += MathHelper.clamp(
                pitchDelta,
                -9,
                9
            );
        }

        float[] corrected =
            RockstarMath.correctRotation(
                yaw,
                pitch
            );

        yaw = corrected[0];

        pitch = MathHelper.clamp(
            corrected[1],
