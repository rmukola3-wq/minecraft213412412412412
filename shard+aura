import kotlin.test.assertTrue
import org.junit.jupiter.api.Test
import org.junit.jupiter.params.ParameterizedTest
import org.junit.jupiter.params.provider.ValueSource
import org.spongepowered.configurate.yaml.YamlConfigurationLoader

class PunishmentActionRuleTest {

  @ParameterizedTest
  @ValueSource(
    strings =
      [
        "[alert]",
        "[log]",
        "[reset]",
        "[wait] 10s",
        "[wait] 40t",
        "[broadcast] <red>caught</red>",
        "kick <player> please stop",
        "ban <player> Shard found your behaviour unusual",
        "tempban <player> 20h Shard found your behaviour unusual",
        "tempban <uuid> 3d nope",
      ]
  )
  fun `the forms the file already uses stay allowed`(action: String) {
    assertIs<Verdict.Allowed>(PunishmentActionRule.check(action))
  }

  @ParameterizedTest
  @ValueSource(
    strings =
      [
        "kick Notch please stop",
        "ban @a everyone",
        "tempban <player> forever nope",
        "tempban <player>",
        "[wait] soon",
        "[broadcast]",
      ]
  )
  fun `a known form used wrongly is refused rather than waved through`(action: String) {
    assertIs<Verdict.Refused>(PunishmentActionRule.check(action))
  }

  @ParameterizedTest
  @ValueSource(
    strings =
      [
        "op <player>",
        "give <player> minecraft:diamond 64",
        "say hello",
        "stop",
        "execute as @a run kill @s",
        "/op <player>",
        "[nonsense]",
        "lp user <player> parent set jailed",
      ]
  )
  fun `a command of the owner's own is allowed but never without confirmation`(action: String) {
    assertIs<Verdict.Allowed>(PunishmentActionRule.check(action))
    assertTrue(
      PunishmentActionRule.needsConfirming(action),
      "an arbitrary console command must never land without someone reading it first",
    )
  }

  @ParameterizedTest
  @ValueSource(
    strings =
      [
        "[alert]",
        "[log]",
        "[reset]",
        "[wait] 10s",
        "[broadcast] <red>caught</red>",
        "kick <player> please stop",
        "ban <player> nope",
        "tempban <player> 20h nope",
      ]
  )
  fun `the forms Shard knows need no confirmation`(action: String) {
    assertTrue(!PunishmentActionRule.needsConfirming(action))
  }

  @ParameterizedTest
  @ValueSource(
    strings =
      [
        "[broadcast]op <player>",
        "[wait]10s",
        "[broadcast] <newline>fake second line",
        "[broadcast] <rainbow>look at me",
        "[broadcast] <selector:@a>",
        "[broadcast] <nbt:entity:'@s':'Health'>",
        "[broadcast] <score:x:y>",
        "[broadcast] <font:minecraft:alt>tiny",
        "[broadcast] <lang:%1\$s>",
        "[broadcast] <key:key.jump>",
        "[wait] 1d",
        "[wait] 5h",
      ]
  )
  fun `the gaps the red team found are closed`(action: String) {
    assertIs<Verdict.Refused>(PunishmentActionRule.check(action))
  }

  @ParameterizedTest
  @ValueSource(
    strings =
      [
        "[broadcast] <red><bold>caught</bold></red>",
        "[broadcast] <#39FF14>green",
        "[broadcast] <gradient:#39FF14:#ADFF2F>Shard</gradient>",
        "[broadcast] <player> was banned",
        "[wait] 40t",
        "[wait] 500ms",
        "[wait] 10s",
        "[wait] 20",
      ]
  )
  fun `the formatting a real punishment file uses still passes`(action: String) {
    assertIs<Verdict.Allowed>(PunishmentActionRule.check(action))
  }

  @Test
  fun `a broadcast may not carry a clickable tag`() {
    assertIs<Verdict.Refused>(
      PunishmentActionRule.check("[broadcast] <click:run_command:'/op x'>hi")
    )
    assertIs<Verdict.Refused>(PunishmentActionRule.check("[broadcast] <hover:show_text:'x'>hi"))
    assertIs<Verdict.Refused>(PunishmentActionRule.check("[broadcast] <INSERTION:x>hi"))
  }

  @Test
  fun `a newline may not be smuggled into an action`() {
    assertIs<Verdict.Refused>(PunishmentActionRule.check("[alert]\nop <player>"))
    assertIs<Verdict.Refused>(PunishmentActionRule.check("kick <player> bye op x"))
  }

  @Test
  fun `every action shipped in punishments yml passes`() {
    val shipped =
      File(
        this::class.java.classLoader.getResource("punishments.yml")?.toURI()
          ?: error("bundled punishments.yml is missing from test classpath")
      )
    val root = YamlConfigurationLoader.builder().path(shipped.toPath()).build().load()
    val actions =
      root.node("Punishments").childrenMap().values.flatMap { group ->
        group.node("actions").childrenMap().values.flatMap {
          it.getList(String::class.java).orEmpty()
        }
      }

    assertTrue(actions.isNotEmpty(), "the fixture should carry actions to check")
    actions.forEach { action ->
      assertIs<Verdict.Allowed>(PunishmentActionRule.check(action), "shipped action: $action")
    }
  }
}


