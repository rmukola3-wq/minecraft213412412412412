package meteordevelopment.meteorclient.systems.modules.combat.aura;

import net.minecraft.entity.Entity;
import net.minecraft.util.math.Box;
import net.minecraft.util.math.MathHelper;
import net.minecraft.util.math.Vec3d;

import java.util.concurrent.ThreadLocalRandom;

public final class AuraLegitController {
    private static final float MINIMUM_DRIFT_XZ = 0.003f;
    private static final float MAXIMUM_DRIFT_XZ = 0.030f;
    private static final float MINIMUM_DRIFT_Y = 0.001f;
    private static final float MAXIMUM_DRIFT_Y = 0.030f;

    private int trackedTargetId = -1;

    private Vec3d aimOffset = Vec3d.ZERO;
    private Vec3d aimDrift = Vec3d.ZERO;

    private long visibleSince = -1;
    private int attackTimer;
    private boolean missQueued;

    public void reset() {
        trackedTargetId = -1;

        aimOffset = Vec3d.ZERO;
        aimDrift = Vec3d.ZERO;

        visibleSince = -1;
        attackTimer = 0;
        missQueued = false;
    }

    public void tick() {
        if (attackTimer > 0) attackTimer--;
    }

    /**
     * Angle between the current look direction and the target, used to keep the aura from
     * reacting to entities a real player could not have noticed yet.
     */
    public static double angleTo(
        Vec3d eyes,
        float yaw,
        float pitch,
        Vec3d point
    ) {
        float[] wanted = AuraRotationSolver.anglesTo(eyes, point);

        double yawDifference = MathHelper.wrapDegrees(wanted[0] - yaw);
        double pitchDifference = wanted[1] - pitch;

        return Math.sqrt(
            yawDifference * yawDifference
                + pitchDifference * pitchDifference
        );
    }

    public boolean isInFov(
        Vec3d eyes,
        float yaw,
        float pitch,
        Vec3d point,
        double fov
    ) {
        return fov >= 180.0
            || angleTo(eyes, yaw, pitch, point) <= fov;
    }

    /**
     * Aim point that slowly wanders inside the hitbox and bounces off its faces, so
     * consecutive rotations never repeat and never land exactly on the hitbox centre.
     */
    public Vec3d aimPoint(Entity target, Box box, double jitter) {
        if (target == null || box == null) return null;

        if (target.getId() != trackedTargetId) {
            trackedTargetId = target.getId();
            aimOffset = Vec3d.ZERO;
            aimDrift = Vec3d.ZERO;
        }

        double lengthX = box.getLengthX();
        double lengthY = box.getLengthY();
        double lengthZ = box.getLengthZ();

        if (aimDrift.equals(Vec3d.ZERO)) {
            aimDrift = new Vec3d(
                random(-0.05f, 0.05f),
                random(-0.05f, 0.05f),
                random(-0.05f, 0.05f)
            );

            aimOffset = new Vec3d(0, lengthY * 0.5, 0);
        }

        aimOffset = aimOffset.add(aimDrift);

        double limitX = Math.max(0.02, (lengthX - 0.05) / 2.0);
        double limitZ = Math.max(0.02, (lengthZ - 0.05) / 2.0);

        if (aimOffset.x >= limitX) {
            aimDrift = new Vec3d(-random(MINIMUM_DRIFT_XZ, MAXIMUM_DRIFT_XZ), aimDrift.y, aimDrift.z);
        } else if (aimOffset.x <= -limitX) {
            aimDrift = new Vec3d(random(MINIMUM_DRIFT_XZ, MAXIMUM_DRIFT_XZ), aimDrift.y, aimDrift.z);
        }

        if (aimOffset.z >= limitZ) {
            aimDrift = new Vec3d(aimDrift.x, aimDrift.y, -random(MINIMUM_DRIFT_XZ, MAXIMUM_DRIFT_XZ));
        } else if (aimOffset.z <= -limitZ) {
            aimDrift = new Vec3d(aimDrift.x, aimDrift.y, random(MINIMUM_DRIFT_XZ, MAXIMUM_DRIFT_XZ));
        }

        if (aimOffset.y >= lengthY - 0.10) {
            aimDrift = new Vec3d(aimDrift.x, -random(MINIMUM_DRIFT_Y, MAXIMUM_DRIFT_Y), aimDrift.z);
        } else if (aimOffset.y <= 0.10) {
            aimDrift = new Vec3d(aimDrift.x, random(MINIMUM_DRIFT_Y, MAXIMUM_DRIFT_Y), aimDrift.z);
        }

        aimOffset = new Vec3d(
            MathHelper.clamp(aimOffset.x, -limitX, limitX),
            MathHelper.clamp(aimOffset.y, 0.05, Math.max(0.05, lengthY - 0.05)),
            MathHelper.clamp(aimOffset.z, -limitZ, limitZ)
        );

        double safeJitter = Math.max(0, jitter);

        Vec3d point = new Vec3d(
            box.getCenter().x + aimOffset.x,
            box.minY + aimOffset.y,
            box.getCenter().z + aimOffset.z
        );

        if (safeJitter > 0) {
            point = point.add(
                random((float) -safeJitter, (float) safeJitter),
                random((float) -safeJitter, (float) safeJitter) * 0.5,
                random((float) -safeJitter, (float) safeJitter)
            );
        }

        return new Vec3d(
            MathHelper.clamp(point.x, box.minX + 0.02, box.maxX - 0.02),
            MathHelper.clamp(point.y, box.minY + 0.02, box.maxY - 0.02),
            MathHelper.clamp(point.z, box.minZ + 0.02, box.maxZ - 0.02)
        );
    }

    /** Simulates the delay before a player reacts to a target becoming visible. */
    public boolean reactionElapsed(boolean visible, int reactionMilliseconds) {
        if (reactionMilliseconds <= 0) return true;

        if (!visible) {
            visibleSince = -1;
            return false;
        }

        long now = System.currentTimeMillis();

        if (visibleSince < 0) {
            visibleSince = now;
            return false;
        }

        return now - visibleSince >= reactionMilliseconds;
    }

    public void clearReaction() {
        visibleSince = -1;
    }

    public boolean timingReady() {
        return attackTimer <= 0;
    }

    /** Randomizes the next click interval within the configured clicks per second range. */
    public void onAttack(int minimumCps, int maximumCps, double missChance) {
        int low = Math.max(1, Math.min(minimumCps, maximumCps));
        int high = Math.max(low, maximumCps);

        float cps = AuraRotationSolver.randomBetween(low, high + 0.999f);

        attackTimer = Math.max(1, Math.round(20.0f / cps));

        missQueued = missChance > 0
            && ThreadLocalRandom.current().nextDouble() < missChance;
    }

    /** Whether the next attack should be skipped so the click pattern is not perfect. */
    public boolean consumeMiss() {
        if (!missQueued) return false;

        missQueued = false;
        return true;
    }

    private static float random(float minimum, float maximum) {
        return AuraRotationSolver.randomBetween(minimum, maximum);
    }
}


