package meteordevelopment.meteorclient.systems.modules.combat.aura.expensive;

import meteordevelopment.meteorclient.MeteorClient;
import meteordevelopment.meteorclient.events.entity.player.AttackEntityEvent;
import meteordevelopment.meteorclient.events.game.GameLeftEvent;
import meteordevelopment.meteorclient.systems.modules.Modules;
import meteordevelopment.meteorclient.systems.modules.combat.ExpensiveAura;
import meteordevelopment.meteorclient.systems.modules.combat.KillAura;
import meteordevelopment.orbit.EventHandler;
import meteordevelopment.orbit.EventPriority;
import net.minecraft.entity.LivingEntity;

import static meteordevelopment.meteorclient.MeteorClient.mc;

/**
 * Shared combat target for Target HUD / Target ESP / helpers.
 * Follows KillAura, Expensive Aura, or the last living entity you actually hit.
 */
public final class CombatTargets {
    public static final CombatTargets INSTANCE = new CombatTargets();
    private static final long HOLD_MS = 10_000L;
    private static final float MAX_DISTANCE = 64.0f;

    private boolean subscribed;
    private LivingEntity lastAttacked;
    private long lastAttackMs;

    private CombatTargets() {}

    public void ensureSubscribed() {
        if (subscribed) return;
        MeteorClient.EVENT_BUS.subscribe(this);
        subscribed = true;
    }

    @EventHandler(priority = EventPriority.LOWEST)
    private void onAttack(AttackEntityEvent event) {
        if (event.isCancelled()) return;
        if (event.entity instanceof LivingEntity living && living != mc.player && living.isAlive()) {
            lastAttacked = living;
            lastAttackMs = System.currentTimeMillis();
        }
    }

    @EventHandler
    private void onLeave(GameLeftEvent event) {
        lastAttacked = null;
        lastAttackMs = 0L;
    }

    public static LivingEntity current() {
        INSTANCE.ensureSubscribed();
        return INSTANCE.resolve();
    }

    private LivingEntity resolve() {
        LivingEntity hit = heldAttack();
        if (hit != null) return hit;

        KillAura killAura = Modules.get() != null ? Modules.get().get(KillAura.class) : null;
        if (killAura != null && killAura.isActive()) {
            LivingEntity target = killAura.getTargetEntity();
            if (alive(target)) return target;
            if (alive(KillAura.TARGET)) return KillAura.TARGET;
        }

        ExpensiveAura expensive = Modules.get() != null ? Modules.get().get(ExpensiveAura.class) : null;
        if (expensive != null && expensive.isActive()) {
            if (alive(expensive.target())) return expensive.target();
            if (alive(expensive.lastTarget())) return expensive.lastTarget();
        }

        return null;
    }

    private LivingEntity heldAttack() {
        if (!alive(lastAttacked)) return null;
        if (System.currentTimeMillis() - lastAttackMs > HOLD_MS) return null;
        if (mc.player != null && mc.player.distanceTo(lastAttacked) > MAX_DISTANCE) return null;
        return lastAttacked;
    }

    public static boolean hasHitRecently() {
        INSTANCE.ensureSubscribed();
        return INSTANCE.heldAttack() != null;
    }

    private static boolean alive(LivingEntity entity) {
        if (entity == null || !entity.isAlive() || entity.isRemoved()) return false;
        if (mc.world == null || mc.player == null) return false;
        return entity.getWorld() == mc.world;
    }
}


