package meteordevelopment.meteorclient.systems.modules.combat.aura.rockstar;

import meteordevelopment.meteorclient.systems.modules.combat.KillAura;
import net.minecraft.entity.LivingEntity;
import net.minecraft.util.math.MathHelper;
import net.minecraft.util.math.Vec3d;

import static meteordevelopment.meteorclient.MeteorClient.mc;

/**
 * Rockstar {@code FunTimeRotation} — «FunTime Snap».
 */
public final class FunTimeRotation extends RockstarRotationMode {
    private final RockstarInterp pitchAnim = new RockstarInterp();
    private long cycleStart = System.currentTimeMillis();

    @Override
    public void update(KillAura aura, LivingEntity target) {
        if (mc.player == null) return;

        Vec3d point = Vec3d.ZERO;
        if (target != null) {
            point = aura.useMultipoint()
                ? RockstarMath.closestPoint(target)
                : target.getPos().add(0, target.getHeight() / 2.0, 0);
        }

        float[] relative = target == null
            ? new float[]{0, mc.player.getPitch()}
            : relativeToPlayer(point);

        if (target != null) {
            boolean idle = !aura.isSnapTick()
                && (!aura.willFallCrit(target) && !aura.canCritical()
                || !aura.attackTimerPassed(300));

            if (idle) {
                relative[0] = pingPong(700) * 40 - 20;
                relative[1] += pingPong(500) * 15 - 7;
            } else if (aura.isSnapTick()) {
                relative[1] += RockstarMath.random(5, 30);
                relative[0] += RockstarMath.random(5, 10);
            }
        }

        yaw = mc.player.getYaw() + RockstarMath.step(
            yaw - mc.player.getYaw(),
            relative[0],
            RockstarMath.random(80, 85)
        );

        float[] pitched = pitchAnim.animate(
            relative[1],
            relative[1],
            1,
            RockstarMath.randomInt(100, 150)
        );
        pitch = pitched[1];

        float[] snapped = RockstarMath.correctRotation(yaw, pitch);
        yaw = snapped[0];
        pitch = snapped[1];
    }

    @Override
    public void reset(int reason) {
        super.reset(reason);
        if (mc.player != null) pitchAnim.reset(mc.player.getYaw(), mc.player.getPitch());
        cycleStart = System.currentTimeMillis();
    }

    private float[] relativeToPlayer(Vec3d target) {
        double posX = target.x - mc.player.getX();
        double posY = target.y - mc.player.getEyeY();
        double posZ = target.z - mc.player.getZ();
        double horizontal = MathHelper.sqrt((float) (posX * posX + posZ * posZ));

        float yaw = (float) (Math.atan2(posZ, posX) * 180.0 / Math.PI) - 90.0f;
        float pitch = (float) (-(Math.atan2(posY, horizontal) * 180.0 / Math.PI));
        yaw = RockstarMath.wrapDelta(mc.player.getYaw(), yaw);

        return new float[]{yaw, pitch};
    }

    private float pingPong(int periodMs) {
        long span = Math.max(1, periodMs);
        long t = (System.currentTimeMillis() - cycleStart) % (span * 2L);
        if (t < span) return t / (float) span;
        return 1.0f - (t - span) / (float) span;
    }
}


