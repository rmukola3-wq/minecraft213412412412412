        super("SnapRotation");
    }

    @Override
    public Rotation process(Rotation current, Rotation target, Vec3d vec, Entity entity) {
        ExpensiveAura aura = ExpensiveAura.get();
        Stopwatch attackTimer = aura.attackTimer();
        Rotation diff = RotationMath.INSTANCE.calculateRotationDifference(target, current);
        float yaw = diff.getYaw();
        float pitch = diff.getPitch();
        float hypot = (float) Math.hypot(Math.abs(yaw), Math.abs(pitch));
        boolean canHit = entity != null && aura.canAttack(mc.player, 1);
        float maxYaw = Math.abs(yaw / hypot) * 180.0f;
        float maxPitch = Math.abs(pitch / hypot) * 180.0f;
        float factorYaw = canHit ? 1.0f : (attackTimer.hasElapsed(50L) ? FastMathUtils.getRandom(0.4f, 0.7f) : -0.2f);
        float factorPitch = canHit ? 1.0f : (attackTimer.hasElapsed(50L) ? FastMathUtils.getRandom(0.4f, 0.7f) : -0.2f);
        return new Rotation(
            MathHelper.lerp(factorYaw, current.getYaw(), current.getYaw() + MathHelper.clamp(yaw, -maxYaw, maxYaw)),
            MathHelper.lerp(factorPitch, current.getPitch(), current.getPitch() + MathHelper.clamp(pitch, -maxPitch, maxPitch))
        );
    }

    @Override
    public Vec3d randomValue() {
        return Vec3d.ZERO;
