package meteordevelopment.meteorclient.systems.modules.combat.aura.expensive;

import meteordevelopment.meteorclient.systems.modules.combat.ExpensiveAura;
import net.minecraft.entity.Entity;
import net.minecraft.util.math.MathHelper;
import net.minecraft.util.math.Vec3d;

import java.security.SecureRandom;

import static meteordevelopment.meteorclient.MeteorClient.mc;

public class FuntimeRotationMode extends RotationMode {
    public FuntimeRotationMode() {
        super("FunTime");
    }

    @Override
    public Rotation process(Rotation current, Rotation target, Vec3d vec, Entity entity) {
        ExpensiveAura aura = ExpensiveAura.get();
        Stopwatch attackTimer = aura.attackTimer();
        int hitCounter = aura.hitCounter();
        float speed = new SecureRandom().nextBoolean() ? 0.4f : 0.2f;
        Rotation diff = RotationMath.INSTANCE.calculateRotationDifference(target, current);
        float yaw = diff.getYaw();
        float pitch = diff.getPitch();
        float hypot = (float) Math.hypot(Math.abs(yaw), Math.abs(pitch));
        float maxYaw = Math.abs(yaw / hypot) * 180.0f;
        float maxPitch = Math.abs(pitch / hypot) * 180.0f;
        float clampYaw = MathHelper.clamp(yaw, -maxYaw, maxYaw);
        float clampPitch = MathHelper.clamp(pitch, -maxPitch, maxPitch);
        if (aura.target() != null && aura.canCrit(mc.player, 0)) {
            return current.add(new Rotation(clampYaw, clampPitch));
        }
        float factor = !attackTimer.hasElapsed(500L) ? -0.2f : speed;
        float t1 = (System.currentTimeMillis() % 2000) / 75.0f;
        float t2 = (System.currentTimeMillis() % 1000) / 75.0f;
        Rotation offset = switch (hitCounter % 4) {
            case 0 -> new Rotation((float) Math.cos(t1), (float) Math.sin(t2));
            case 1 -> new Rotation((float) Math.sin(t1), (float) Math.cos(t2));
            case 2 -> new Rotation((float) Math.sin(t1), (float) (-Math.cos(t2)));
            default -> new Rotation((float) (-Math.cos(t1)), (float) Math.sin(t2));
        };
        return new Rotation(
            MathHelper.lerp(Math.clamp(randomLerp(factor, factor + 0.2f), 0.0f, 1.0f), current.getYaw(), current.getYaw() + clampYaw)
                + (!attackTimer.hasElapsed(1000L) ? randomLerp(6.0f, 12.0f) * offset.getYaw() : 0.0f),
            MathHelper.lerp(Math.clamp(randomLerp(factor, factor + 0.2f), 0.0f, 1.0f), current.getPitch(), current.getPitch() + clampPitch)
                + (!attackTimer.hasElapsed(1000L) ? randomLerp(2.0f, 4.0f) * offset.getPitch() : 0.0f)
        );
    }

    @Override
    public Vec3d randomValue() {
        return Vec3d.ZERO;
    }

    public float randomLerp(float min, float max) {
        return MathHelper.lerp(new SecureRandom().nextFloat(), min, max);
    }
}


