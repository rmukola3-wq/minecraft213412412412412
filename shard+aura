    val viewerId = UUID.randomUUID()
    arrange(viewerId to sessionFor(viewerId, MonitorOutputKind.CHAT, MonitorChatStyle.SUMMARY))

    listener.onPrediction(event())

    verify(exactly = 0) { chatOutput.deliverLive(any(), any()) }
  }

