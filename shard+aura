package meteordevelopment.meteorclient.systems.modules.combat.aura.expensive;

import meteordevelopment.meteorclient.systems.modules.Module;

import java.util.PriorityQueue;

public class TickScheduler<T> {
    public int tickCounter = 0;
    public final PriorityQueue<ScheduledTask<T>> activeTasks = new PriorityQueue<>((a, b) -> Integer.compare(b.priority, a.priority));

    public void tick(int amount) {
        tickCounter += amount;
    }

    public void addTask(ScheduledTask<T> task) {
        activeTasks.removeIf(existing -> existing.provider.equals(task.provider));
        task.expiresIn += tickCounter;
        activeTasks.add(task);
    }

    public T getValue() {
        while (!activeTasks.isEmpty() && activeTasks.peek() != null
            && (activeTasks.peek().expiresIn <= tickCounter || !activeTasks.peek().provider.isActive())) {
            activeTasks.poll();
        }
        if (activeTasks.isEmpty() || activeTasks.peek() == null) return null;
        return activeTasks.peek().value;
    }

    public void cancel(Module module) {
        activeTasks.removeIf(task -> task.provider == module);
    }
}


