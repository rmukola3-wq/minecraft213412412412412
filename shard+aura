package meteordevelopment.meteorclient.systems.modules.combat.aura;

import net.minecraft.client.network.ClientPlayerEntity;
import net.minecraft.network.packet.c2s.play.ClientCommandC2SPacket;

import static meteordevelopment.meteorclient.MeteorClient.mc;

/**
 * Tracks sprint state for a single attack cycle and restores it exactly once.
 * ThunderHack-style packet order: STOP before attack, START after if needed.
 */
public final class AuraSprintSession {
    private boolean active;
    private boolean wasSprinting;
    private boolean sprintKeyPressed;
    private boolean stopSent;

    /**
     * Captures the sprint state to restore later. Calling it again while a session is
     * open keeps the original state, so a stop issued earlier in the tick is not lost.
     */
    public void begin(ClientPlayerEntity player) {
        if (player == null) {
            reset();
            return;
        }

        if (active) return;

        active = true;
        wasSprinting = player.isSprinting();
        sprintKeyPressed = mc.options.sprintKey.isPressed();
        stopSent = false;
    }

    public boolean wasSprinting() {
        return wasSprinting;
    }

    public boolean isActive() {
        return active;
    }

    public void stopSprint(ClientPlayerEntity player, boolean packet) {
        if (player == null || !active) return;

        if (packet && player.isSprinting() && !stopSent && player.networkHandler != null) {
            player.networkHandler.sendPacket(
                new ClientCommandC2SPacket(
                    player,
                    ClientCommandC2SPacket.Mode.STOP_SPRINTING
                )
            );
            stopSent = true;
        }

        if (player.isSprinting()) {
            player.setSprinting(false);
        }
    }

    public void restore(ClientPlayerEntity player, boolean packet) {
        if (!active || player == null) {
            reset();
            return;
        }

        if (wasSprinting) {
            if (packet && stopSent && player.networkHandler != null) {
                player.setSprinting(true);
                player.networkHandler.sendPacket(
                    new ClientCommandC2SPacket(
                        player,
                        ClientCommandC2SPacket.Mode.START_SPRINTING
                    )
                );
            } else if (!packet) {
                player.setSprinting(true);
            }

            mc.options.sprintKey.setPressed(sprintKeyPressed);
        }

        reset();
    }

    public void cancel(ClientPlayerEntity player, boolean packet) {
        restore(player, packet);
    }

    public void reset() {
        active = false;
        wasSprinting = false;
        sprintKeyPressed = false;
        stopSent = false;
    }
}


