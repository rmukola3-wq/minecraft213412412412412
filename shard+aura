package meteordevelopment.meteorclient.systems.modules.combat.aura.rockstar;

import meteordevelopment.meteorclient.systems.modules.combat.KillAura;
import net.minecraft.entity.LivingEntity;
import net.minecraft.util.math.MathHelper;

import static meteordevelopment.meteorclient.MeteorClient.mc;

public final class ThunderGrimRotation extends RockstarRotationMode {
    @Override
    public void update(KillAura aura, LivingEntity target) {
        if (mc.player == null) return;

        if (target == null) {
            yaw = mc.player.getYaw();
            pitch = mc.player.getPitch();
            return;
        }

        float[] desired = RockstarMath.anglesToEyes(
            aimPoint(aura, target)
        );

        boolean attackReady =
            aura.canCritical()
                && aura.attackTimerPassed(300);

        float yawDelta = MathHelper.wrapDegrees(
            desired[0] - yaw
        );

        float pitchDelta =
            desired[1] - pitch;

        float yawStep =
            attackReady ? 180 : 70;

        float pitchStep =
            attackReady ? 90 : 35;

        yawDelta = MathHelper.clamp(
            yawDelta,
            -yawStep,
            yawStep
        );

        pitchDelta = MathHelper.clamp(
            pitchDelta,
            -pitchStep,
            pitchStep
        );

        float gcd = RockstarMath.gcd();

        if (gcd > 0) {
            yawDelta -= yawDelta % gcd;
            pitchDelta -= pitchDelta % gcd;
        }

        yaw += yawDelta;

        pitch = MathHelper.clamp(
            pitch + pitchDelta,
            -90,
            90
        );
    }
}


