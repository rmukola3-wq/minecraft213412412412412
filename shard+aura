package meteordevelopment.meteorclient.systems.modules.combat.aura.expensive;

import meteordevelopment.meteorclient.systems.modules.combat.ExpensiveAura;
import net.minecraft.entity.Entity;
import net.minecraft.entity.LivingEntity;
import net.minecraft.item.Items;
import net.minecraft.util.math.MathHelper;
import net.minecraft.util.math.Vec3d;

import java.util.Arrays;

import static meteordevelopment.meteorclient.MeteorClient.mc;

/** Delta Client {@code Aura.applyFantimeSmoothing} / {@code applyLegitSmoothing}. */
public final class DeltaRotationEngine {
    public enum Style {
        FUNTIME,
        FUNTIME_FOV,
        LEGIT
    }

    private final float[] pitchHistory = new float[30];
    private float timers3;
    private float timers5;
    private float timers8;
    private LivingEntity lastTarget;
    public int attackCooldownTicks;

    public final RotationMode funtime = new Adapter(Style.FUNTIME, "FunTime D");
    public final RotationMode funtimeFov = new Adapter(Style.FUNTIME_FOV, "FunTime FOV");
    public final RotationMode legit = new Adapter(Style.LEGIT, "Легит D");

    public void reset() {
        Arrays.fill(pitchHistory, mc.player != null ? mc.player.getPitch() : 0.0f);
        timers3 = 0.0f;
        timers5 = -1.0f;
        timers8 = 2.0f;
        attackCooldownTicks = 0;
        lastTarget = null;
    }

    public void onHit() {
        attackCooldownTicks = 0;
        timers5 = 8.0f + (float) (Math.random() * 2.0);
        timers3 = 0.0f;
    }

    public void tick() {
        attackCooldownTicks++;
    }

    public Rotation process(Style style, Rotation current, Rotation target, Entity entity) {
        if (mc.player == null || target == null) {
            return current != null ? current : target;
        }

        LivingEntity living = entity instanceof LivingEntity l ? l : ExpensiveAura.get() != null ? ExpensiveAura.get().target() : null;
        if (living != lastTarget) {
            Arrays.fill(pitchHistory, mc.player.getPitch());
            lastTarget = living;
            timers8 = 2.0f;
        }

        System.arraycopy(pitchHistory, 0, pitchHistory, 1, 29);
        pitchHistory[0] = target.getPitch();

        ExpensiveAura aura = ExpensiveAura.get();
        boolean canHit = aura != null && aura.canAttack(mc.player, 0);
        if (timers3 <= 0.0f && canHit) timers3 = 1.0f;

        float range = aura != null ? aura.attackRange(mc.player) : 3.0f;
        int hitCount = aura != null ? aura.hitCounter() : 0;

        Rotation out = style == Style.LEGIT
            ? applyLegit(target, living, range, hitCount, canHit)
            : applyFuntime(style == Style.FUNTIME_FOV, target, living, range, hitCount);
        if (timers3 > -64.0f) timers3--;
        if (timers5 >= 0.0f) timers5--;
        if (timers8 > 0.0f) timers8--;
        return out;
    }

    private Rotation applyFuntime(boolean fov, Rotation targetRot, LivingEntity living, float range, int hitCount) {
        float time = mc.player.age + mc.getRenderTickCounter().getTickDelta(false);
        float smoothW = (float) ((Math.sin(time * 0.4000000008323731d) * 3.0d)
            + (Math.sin((time * 0.9500002390239708d) + 1.4000004888461306d) * 2.0d));
        float smoothH = (float) ((Math.cos((time * 0.5d) + 0.7000001555309916d) * 0.5d)
            + (Math.cos((time * 0.7800000620494261d) + 3.10000031689524d) * 1.5d));

        float yawToTarget = targetRot.getYaw();
        float pitchToTarget = targetRot.getPitch();
        float cameraYaw = mc.player.getYaw();
        float cameraPitch = mc.player.getPitch();
        float finalPitch = wrapLerp(cameraPitch, pitchHistory[MathHelper.clamp(10 - attackCooldownTicks, 0, 29)] + (smoothH * 1.5f), random(0.1f, 0.5f));
        float finalYaw = wrapLerp(cameraYaw, yawToTarget + smoothW, random(0.1f, 0.4f));

        if (timers3 >= 0.0f && living != null) {
            if (!canSee(living, cameraYaw, cameraPitch, range) && timers8 <= 0.0f) {
                finalYaw = yawToTarget;
            }
            if (!canSee(living, yawToTarget, finalPitch, range) && timers8 <= 0.0f) {
                finalPitch = pitchToTarget;
            }
            if (!canSee(living, cameraYaw + smoothW, cameraYaw + smoothH, range)
                && canSee(living, cameraYaw, cameraPitch, range)) {
                smoothW = MathHelper.clamp(smoothW, -0.05f, 0.05f);
                smoothH = MathHelper.clamp(smoothH, -0.05f, 0.05f);
            }
        }
        if (attackCooldownTicks <= 4 && hitCount % 2 == 0) {
            finalYaw = cameraYaw;
        }

        float outPitch = (fov ? cameraPitch : finalPitch) + smoothH;
        return new Rotation(finalYaw + smoothW, MathHelper.clamp(outPitch, -90.0f, 90.0f));
    }

    private Rotation applyLegit(Rotation targetRot, LivingEntity living, float range, int hitCount, boolean canHit) {
        float t = mc.player.age + mc.getRenderTickCounter().getTickDelta(false);
        float fSin = ((float) (((Math.sin(t * 0.31f) * 0.5d) + (Math.sin((t * 1.7f) + 2.6f) * 0.2000000098386085d)) * 8.0d)) / 4.0f;
        float smoothW = fSin;
        float smoothH = fSin;
        float yawToTarget = targetRot.getYaw();
        float pitchToTarget = targetRot.getPitch();
        float cameraYaw = mc.player.getYaw();
        float cameraPitch = mc.player.getPitch();
        float finalYaw = wrapLerp(cameraYaw, yawToTarget, random(0.2f, 0.35f));
        float finalPitch = wrapLerp(cameraPitch, pitchToTarget, random(0.15f, 0.25f));

        if (timers3 >= 0.0f) {
            finalPitch = wrapLerp(cameraPitch, pitchToTarget, 0.35f);
            smoothH /= 3.0f;
            smoothW /= 3.0f;
            if (living != null && !canSee(living, cameraYaw, cameraPitch, range)) {
                finalYaw = wrapLerp(cameraYaw, yawToTarget, random(0.7f, 1.0f));
            }
        }
        if (living != null
            && !canSee(living, finalYaw + smoothW, finalPitch + smoothH, range)
            && canSee(living, yawToTarget, pitchToTarget, range)) {
            smoothW = MathHelper.clamp(smoothW, -0.15f, 0.15f);
            smoothH = MathHelper.clamp(smoothH, -0.15f, 0.15f);
        }
        if (timers5 >= 0.0f) {
            smoothW *= 8.0f;
            if (attackCooldownTicks >= 1 && hitCount % 5 == 0) {
                finalPitch = wrapLerp(cameraPitch, -pitchToTarget, 0.05f);
            }
        }

        if (!canHit && mc.player.getMainHandStack().isOf(Items.MACE) && living != null) {
            float time = mc.player.age + mc.getRenderTickCounter().getTickDelta(false);
            float maceW = ((float) ((((Math.sin(time * 0.31f) * 0.5d)
                + (Math.sin((time * 0.73f) + 1.1f) * 0.3000000314327426d))
                + (Math.sin((time * 1.7f) + 2.6f) * 0.2000000098386085d)) * 8.0d)) / 8.0f;
            finalYaw = wrapLerp(cameraYaw, yawToTarget, 0.8f);
            finalPitch = wrapLerp(cameraPitch, pitchToTarget, 0.8f);
            return new Rotation(finalYaw + maceW, MathHelper.clamp(finalPitch + maceW, -90.0f, 90.0f));
        }

        return new Rotation(finalYaw + smoothW, MathHelper.clamp(finalPitch + smoothH, -90.0f, 90.0f));
    }

    private static boolean canSee(LivingEntity living, float yaw, float pitch, float range) {
        return WorldRaycastUtils.deltaAimHits(yaw, pitch, range, living, true);
    }

    private static float wrapLerp(float start, float end, float amount) {
        float amountClamped = MathHelper.clamp(amount, 0.0f, 1.0f);
        float delta = MathHelper.wrapDegrees(end - start);
        if (Math.abs(delta) < 0.5f) return end;
        float stepped = MathHelper.wrapDegrees(start + (delta * amountClamped));
        float patched = FastMathUtils.snapGcd(start, stepped);
        float remaining = MathHelper.wrapDegrees(end - patched);
        return Math.abs(remaining) < 0.5f ? end : patched;
    }

    private static float random(float min, float max) {
        return (float) (min + (Math.random() * (max - min)));
    }

    private final class Adapter extends RotationMode {
        private final Style style;

        private Adapter(Style style, String name) {
            super(name);
            this.style = style;
        }

        @Override
        public Rotation process(Rotation current, Rotation target, Vec3d vec, Entity entity) {
            return DeltaRotationEngine.this.process(style, current, target, entity);
        }

        @Override
        public Vec3d randomValue() {
            return Vec3d.ZERO;
        }
    }
}


