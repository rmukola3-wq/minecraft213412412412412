    val local = SuspiciousSnapshot("lite2", uuid, "season", 9.4, 43, Long.MAX_VALUE)

    val result = dedupeByPlayer(listOf(remote, local))

    assertEquals(1, result.size)
    assertEquals("lite2", result.single().server)
  }

  @Test
