package meteordevelopment.meteorclient.systems.modules.combat.aura.expensive;

public class CountLoopStrategy extends LoopStrategy {
    public int maxLoops;
    public int currentLoops = 0;

    public CountLoopStrategy(int maxLoops) {
        this.maxLoops = maxLoops;
    }

    @Override
    public boolean isFinished() {
        return true;
    }

    @Override
    public void onLoop() {
        currentLoops++;
    }

    @Override
    public boolean shouldLoop(int currentStepIndex, int totalSteps) {
        return currentStepIndex >= totalSteps && currentLoops < maxLoops - 1;
    }
