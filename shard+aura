package meteordevelopment.meteorclient.systems.modules.combat.aura.expensive;

import net.minecraft.entity.LivingEntity;
import net.minecraft.entity.player.PlayerEntity;
import net.minecraft.util.PlayerInput;
import net.minecraft.util.math.MathHelper;
import net.minecraft.util.math.Vec2f;
import net.minecraft.util.math.Vec3d;

import static meteordevelopment.meteorclient.MeteorClient.mc;

public final class MovementInputHelper {
    public static DirectionalInput getDirectionalInputForDegrees(DirectionalInput current, double degrees) {
        return getDirectionalInputForDegrees(current, degrees, 20.0f);
    }

    public static DirectionalInput getDirectionalInputForDegrees(DirectionalInput current, double degrees, float deadzone) {
        boolean forward = current.forward();
        boolean backward = current.backward();
        boolean left = current.left();
        boolean right = current.right();
        if (degrees >= -90.0f + deadzone && degrees <= 90.0f - deadzone) forward = true;
        else if (degrees < -90.0f - deadzone || degrees > 90.0f + deadzone) backward = true;
        if (degrees >= 0.0f + deadzone && degrees <= 180.0f - deadzone) right = true;
        else if (degrees >= -180.0f + deadzone && degrees <= 0.0f - deadzone) left = true;
        return new DirectionalInput(forward, backward, left, right);
    }

    public static double getDegreesRelativeToView(Vec3d delta, float yaw) {
        return MathHelper.wrapDegrees((float) (Math.toDegrees(Math.atan2(-delta.x, delta.z)) - yaw));
    }

    /**
     * Zenith {@code VectorUtility.method00280}: wanted keys from last-tick analog
     * {@code player.input.getMovementInput()} (y=forward, x=strafe), predicted against silent yaw.
     */
    public static PlayerInput remapWasd(PlayerInput thisTick, float silentYaw, float referenceYaw) {
        float forward = 0.0f;
        float strafe = 0.0f;
        if (mc.player != null && mc.player.input != null) {
            Vec2f analog = mc.player.input.getMovementInput();
            forward = analog.y;
            strafe = analog.x;
        }
        if (forward == 0.0f && strafe == 0.0f) {
            forward = axis(thisTick.forward(), thisTick.backward());
            strafe = axis(thisTick.left(), thisTick.right());
        }
        if (forward == 0.0f && strafe == 0.0f) return thisTick;

        float wantedYaw = mc.player != null && mc.player.isGliding() ? silentYaw : referenceYaw;
        double wanted = MathHelper.wrapDegrees(Math.toDegrees(moveYawRadians(wantedYaw, forward, strafe)));
        float bestForward = 0.0f;
        float bestStrafe = 0.0f;
        float bestDiff = Float.MAX_VALUE;

        for (float predictedForward = -1.0f; predictedForward <= 1.0f; predictedForward += 1.0f) {
            for (float predictedStrafe = -1.0f; predictedStrafe <= 1.0f; predictedStrafe += 1.0f) {
                if (predictedForward == 0.0f && predictedStrafe == 0.0f) continue;
                double predicted = MathHelper.wrapDegrees(Math.toDegrees(moveYawRadians(silentYaw, predictedForward, predictedStrafe)));
                float diff = (float) Math.abs(wanted - predicted);
                if (diff < bestDiff) {
                    bestDiff = diff;
                    bestForward = predictedForward;
                    bestStrafe = predictedStrafe;
                }
            }
        }

        return new PlayerInput(
            bestForward > 0.0f,
            bestForward < 0.0f,
            bestStrafe > 0.0f,
            bestStrafe < 0.0f,
            thisTick.jump(),
            thisTick.sneak(),
            thisTick.sprint()
        );
    }

    /** Zenith Focus: {@code VectorUtilityDefault.method00739(box.center - PlayerServiceCore.method01201(1))}. */
    public static float zenithFocusYaw(LivingEntity target) {
        SimulatedPlayer self = SimulatedPlayer.simulateLocalPlayer(1);
        net.minecraft.util.math.Box box = target instanceof PlayerEntity player
            ? SimulatedPlayer.simulateOtherPlayer(player, 2).boundingBox
            : target.getBoundingBox();
        Vec3d delta = box.getCenter().subtract(self.sim.pos);
        return (float) MathHelper.wrapDegrees(Math.toDegrees(Math.atan2(delta.z, delta.x)) - 90.0);
    }

    /** Expensive {@code KeyboardInputMixin.transformDirection} 1:1. */
    public static PlayerInput expensiveFreeRemap(PlayerInput input, float playerYaw, float silentYaw) {
        float forward = axis(input.forward(), input.backward());
        float sideways = axis(input.left(), input.right());
        float radians = (float) Math.toRadians(playerYaw - silentYaw);
        DirectionalInput mapped = DirectionalInput.fromMovementForwardAndSideways(
            Math.round((forward * MathHelper.cos(radians)) + (sideways * MathHelper.sin(radians))),
            Math.round((sideways * MathHelper.cos(radians)) - (forward * MathHelper.sin(radians)))
        );
        return new PlayerInput(
            mapped.forward(),
            mapped.backward(),
            mapped.left(),
            mapped.right(),
            input.jump(),
            input.sneak(),
            input.sprint()
        );
    }

    private static float axis(boolean positive, boolean negative) {
        if (positive == negative) return 0.0f;
        return positive ? 1.0f : -1.0f;
    }

    private static double moveYawRadians(float rotationYaw, float moveForward, float moveStrafing) {
        if (moveForward < 0.0f) rotationYaw += 180.0f;
        float forwardFactor = 1.0f;
        if (moveForward < 0.0f) forwardFactor = -0.5f;
        else if (moveForward > 0.0f) forwardFactor = 0.5f;
        if (moveStrafing > 0.0f) rotationYaw -= 90.0f * forwardFactor;
        if (moveStrafing < 0.0f) rotationYaw += 90.0f * forwardFactor;
        return Math.toRadians(rotationYaw);
    }

    private MovementInputHelper() {}
}


