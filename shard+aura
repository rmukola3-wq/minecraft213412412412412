        StrikeManager attackHandler = RastyAttackPerpetrator.get().getAttackHandler();
        KillAura aura = KillAura.get();
        boolean canHit = entity != null && aura != null && attackHandler.canAttack(aura.getConfig(), 0);

        return switch (kind) {
            case SNAP -> canHit ? targetAngle : currentAngle;
            case HVH -> lerpToward(currentAngle, targetAngle, canHit ? 1.0f : randomLerp(0.75f, 0.95f), 180.0f, 180.0f);
            case HOLYWORLD -> lerpToward(MathAngle.cameraAngle(), targetAngle, 1.0f / 3.0f, 180.0f, 180.0f);
            case LEGIT -> lerpToward(MathAngle.cameraAngle(), targetAngle, 0.22f, 90.0f, 55.0f);
            case FUNTIME -> funtime(targetAngle, attackHandler, aura, entity, 0.4f, 0.2f, 75.0f, 6.0f, 12.0f, 2.0f, 4.0f);
            case SPOOKY -> funtime(targetAngle, attackHandler, aura, entity, 0.5f, 0.3f, 70.0f, 7.0f, 14.0f, 2.5f, 5.0f);
        };
    }

    private Angle funtime(
        Angle target,
        StrikeManager attackHandler,
        KillAura aura,
        Entity entity,
        float fast,
        float slow,
        float wave,
        float yawMin,
        float yawMax,
        float pitchMin,
        float pitchMax
    ) {
        Angle from = MathAngle.cameraAngle();
        Angle diff = MathAngle.calculateDelta(from, target);
        float yaw = diff.getYaw();
        float pitch = diff.getPitch();
        float hypot = (float) Math.hypot(Math.abs(yaw), Math.abs(pitch));
        if (hypot < 1.0e-4f) return target;

        float clampYaw = MathHelper.clamp(yaw, -Math.abs(yaw / hypot) * 180.0f, Math.abs(yaw / hypot) * 180.0f);
        float clampPitch = MathHelper.clamp(pitch, -Math.abs(pitch / hypot) * 180.0f, Math.abs(pitch / hypot) * 180.0f);

        if (entity != null && aura != null && attackHandler.canCrit(aura.getConfig(), 0) && mc.player != null) {
            return new Angle(from.getYaw() + clampYaw, from.getPitch() + clampPitch);
        }

        StopWatch attackTimer = attackHandler.getAttackTimer();
        int hitCounter = (int) ((System.currentTimeMillis() / 250L) % 4L);
        float speed = new SecureRandom().nextBoolean() ? fast : slow;
        float factor = attackTimer != null && !attackTimer.finished(500) ? -0.2f : speed;
        float t1 = (System.currentTimeMillis() % 2000) / wave;
        float t2 = (System.currentTimeMillis() % 1000) / wave;
        Angle offset = switch (hitCounter) {
            case 0 -> new Angle((float) Math.cos(t1), (float) Math.sin(t2));
            case 1 -> new Angle((float) Math.sin(t1), (float) Math.cos(t2));
            case 2 -> new Angle((float) Math.sin(t1), (float) (-Math.cos(t2)));
            default -> new Angle((float) (-Math.cos(t1)), (float) Math.sin(t2));
        };
        float jitter = attackTimer != null && !attackTimer.finished(1000) ? 1.0f : 0.0f;
        float t = MathHelper.clamp(randomLerp(factor, factor + 0.2f), 0.0f, 1.0f);
        return new Angle(
            MathHelper.lerp(t, from.getYaw(), from.getYaw() + clampYaw) + jitter * randomLerp(yawMin, yawMax) * offset.getYaw(),
            MathHelper.lerp(t, from.getPitch(), from.getPitch() + clampPitch) + jitter * randomLerp(pitchMin, pitchMax) * offset.getPitch()
        );
    }

    private static Angle lerpToward(Angle from, Angle target, float factor, float maxYaw, float maxPitch) {
        Angle diff = MathAngle.calculateDelta(from, target);
        float yaw = diff.getYaw();
        float pitch = diff.getPitch();
        float hypot = (float) Math.hypot(Math.abs(yaw), Math.abs(pitch));
        if (hypot < 1.0e-4f) return target;
        float t = MathHelper.clamp(factor, 0.0f, 1.0f);
        return new Angle(
            MathHelper.lerp(t, from.getYaw(), from.getYaw() + MathHelper.clamp(yaw, -maxYaw, maxYaw)),
            MathHelper.lerp(t, from.getPitch(), from.getPitch() + MathHelper.clamp(pitch, -maxPitch, maxPitch))
        );
    }

    @Override
    public Vec3d randomValue() {
        return Vec3d.ZERO;
    }

    private static float randomLerp(float min, float max) {
        return MathHelper.lerp(new SecureRandom().nextFloat(), min, max);
    }
}


