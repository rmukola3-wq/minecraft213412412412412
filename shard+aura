    public int hitCounter() {
        return hitCounter;
    }

    public LivingEntity target() {
        return target;
    }

    public LivingEntity lastTarget() {
        return lastTarget;
    }

    public boolean isManagingCriticals() {
        return isActive() && onlyCriticalHit.get() && target != null && target.isAlive();
    }
