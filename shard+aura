import net.minecraft.item.Items;
import net.minecraft.item.consume.UseAction;
import net.minecraft.network.packet.Packet;
import net.minecraft.network.packet.c2s.play.HandSwingC2SPacket;
import net.minecraft.network.packet.c2s.play.UpdateSelectedSlotC2SPacket;
import net.minecraft.util.Hand;
import net.minecraft.util.math.BlockPos;
import net.minecraft.util.math.Box;
import net.minecraft.util.math.Vec3d;
import meteordevelopment.meteorclient.systems.modules.combat.aura.rasty.RastyEventType;
import meteordevelopment.meteorclient.events.packets.PacketEvent;
import meteordevelopment.meteorclient.events.entity.player.RastyUsingItemEvent;
import meteordevelopment.meteorclient.systems.modules.combat.KillAura;
import meteordevelopment.meteorclient.systems.modules.combat.aura.expensive.SlotSprintSync;
import meteordevelopment.meteorclient.systems.modules.combat.aura.rasty.RastyTriggerBot;
import meteordevelopment.meteorclient.systems.modules.combat.aura.rasty.AngleConnection;
import meteordevelopment.meteorclient.systems.modules.combat.aura.rasty.rotations.JavelinStAngle;
import meteordevelopment.meteorclient.systems.modules.combat.aura.rasty.target.RaycastAngle;
import meteordevelopment.meteorclient.systems.modules.movement.ElytraTarget;
import meteordevelopment.meteorclient.systems.modules.combat.aura.rasty.util.player.PlayerSimulation;
import meteordevelopment.meteorclient.systems.modules.combat.aura.rasty.util.player.PlayerInteractionHelper;
import meteordevelopment.meteorclient.systems.modules.combat.aura.rasty.util.timer.StopWatch;
import meteordevelopment.meteorclient.systems.modules.combat.aura.rasty.util.tps.TPSCalculate;

import static meteordevelopment.meteorclient.MeteorClient.mc;

public class StrikeManager {
    private final Pressing clickScheduler = new Pressing();
    private final StopWatch attackTimer = new StopWatch();
    private final StopWatch shieldWatch = new StopWatch();

    private final StopWatch syncTpsTimer = new StopWatch();
    private long syncTpsExtraDelay = 0L;

    private int count = 0;
    private int ticksOnBlock = 0;

    private boolean jumpSyncWaitingForLanding = false;

    void tick() {
        if (mc.player != null && mc.player.isOnGround()) {
            ticksOnBlock++;
        } else {
            ticksOnBlock = 0;
        }
        tickJumpSync();
        SlotSprintSync.tick();
    }

    private void tickJumpSync() {
        if (mc.player == null) return;
        KillAura aura = KillAura.get();
        if (!aura.isActive()) return;
        if (!aura.getCheckCrit().isValue()) return;
        if (!aura.getJumpSync().isValue()) return;
        if (KillAura.TARGET == null || !KillAura.TARGET.isAlive()) return;

        if (isInWater() || hasLowCeiling() || hasMovementRestrictions()) return;

        if (!mc.player.isOnGround()) {
            jumpSyncWaitingForLanding = true;
            return;
        }
        jumpSyncWaitingForLanding = false;

        if (clickScheduler.isCooldownComplete(0)) return;

        if (KillAura.get().getSmoothMode() instanceof JavelinStAngle) {
            if (!isLookingAtTarget(KillAura.get().getConfig())) return;
        }

        int cooldownTick = estimateCooldownReadyTick();
        if (cooldownTick <= 0) return;

        int critTick = simulateCritTickIfJumpNow();
        if (critTick < 0) return;

        if (Math.abs(critTick - cooldownTick) <= 1) {
            mc.player.jump();
        }
    }

    private int estimateCooldownReadyTick() {
        float current = mc.player.getAttackCooldownProgress(0.5f);
        if (current >= 0.9f) return 0;

        double attackSpeed = mc.player.getAttributeValue(
                net.minecraft.entity.attribute.EntityAttributes.ATTACK_SPEED);
        double ticksPerCooldown = 20.0 / attackSpeed;
        double ticksElapsed = current * ticksPerCooldown;
        double ticksNeeded = (0.9 * ticksPerCooldown) - ticksElapsed;

        return (int) Math.ceil(ticksNeeded);
    }

    private int simulateCritTickIfJumpNow() {
        if (mc.player == null || hasLowCeiling()) return -1;

        net.minecraft.util.PlayerInput cur = mc.player.input.playerInput;
        net.minecraft.util.PlayerInput jumpInput = new net.minecraft.util.PlayerInput(
                cur.forward(), cur.backward(), cur.left(), cur.right(),
                true, cur.sneak(), cur.sprint()
        );

        meteordevelopment.meteorclient.systems.modules.combat.aura.rasty.util.player.PlayerSimulation sim = meteordevelopment.meteorclient.systems.modules.combat.aura.rasty.util.player.PlayerSimulation.fromClientPlayer(
                meteordevelopment.meteorclient.systems.modules.combat.aura.rasty.util.player.PlayerSimulation.SimulatedPlayerInput.fromClientPlayer(jumpInput)
        );

        for (int i = 1; i <= 25; i++) {
            sim.tick();
            if (!sim.onGround
                    && sim.fallDistance > 0.0F
                    && sim.velocity.y <= 0.0
                    && !sim.isClimbing()
                    && !sim.player.isTouchingWater()
                    && !sim.player.hasVehicle()
                    && !sim.player.getAbilities().flying) {
                return i;
            }
            if (sim.onGround && i > 3) return -1;
        }
        return -1;
    }

    void onUsingItem(RastyUsingItemEvent e) {
        if (e.type == RastyEventType.START && !shieldWatch.finished(50)) {
            e.cancel();
        }
    }

    void onPacket(PacketEvent.Send e) {
        Packet<?> packet = e.packet;
        if (packet instanceof HandSwingC2SPacket || packet instanceof UpdateSelectedSlotC2SPacket) {
            clickScheduler.recalculate();
        }
    }

    public void resetPendingState() {
    }


    private boolean isSyncTpsReady() {
        KillAura aura = KillAura.get();
        if (aura == null || !aura.getSyncTps().isValue()) return true;
        if (syncTpsExtraDelay <= 0) return true;
        return syncTpsTimer.finished(syncTpsExtraDelay);
    }


    private void applySyncTpsDelay() {
        KillAura aura = KillAura.get();
        if (aura == null || !aura.getSyncTps().isValue()) {
            syncTpsExtraDelay = 0;
            syncTpsTimer.reset();
            return;
        }
        if (mc.player == null) {
            syncTpsExtraDelay = 0;
            return;
        }
        TPSCalculate tpsCalc = TPSCalculate.getInstance();
        if (tpsCalc == null) {
            syncTpsExtraDelay = 0;
            return;
        }

        float tps = net.minecraft.util.math.MathHelper.clamp(tpsCalc.getTPS(), 1.0f, 20.0f);

        if (tps >= 19.5f) {
            syncTpsExtraDelay = 0;
            syncTpsTimer.reset();
            return;
        }

        double serverTickMs = 1000.0 / tps;

        double attackSpeed = mc.player.getAttributeValue(
                net.minecraft.entity.attribute.EntityAttributes.ATTACK_SPEED);
        double cooldownTicks = 20.0 / attackSpeed;

        long serverCooldownMs = (long)(cooldownTicks * serverTickMs);
        long bufferMs = (long)(serverTickMs * 0.5) + 40L;

        syncTpsExtraDelay = Math.min(serverCooldownMs + bufferMs, 3000L);
        syncTpsTimer.reset();
    }

    private boolean hasAnyMovementInput() {
        if (mc.player == null) return false;
        return mc.player.input.playerInput.forward() ||
                mc.player.input.playerInput.backward() ||
                mc.player.input.playerInput.left() ||
                mc.player.input.playerInput.right();
    }

    private boolean isHoldingMace() {
        return clickScheduler.isHoldingMace();
    }

    private boolean isPlayerEating() {
        if (mc.player == null) return false;
        if (!mc.player.isUsingItem()) return false;
        var activeItem = mc.player.getActiveItem();
        if (activeItem.isEmpty()) return false;
        var useAction = activeItem.getUseAction();
        return useAction == UseAction.EAT || useAction == UseAction.DRINK;
    }

    private boolean shouldWaitForEating() {
        KillAura aura = KillAura.get();
        return aura != null && aura.blocksWhileEating() && isPlayerEating();
    }

    private boolean isInWater() {
        return mc.player != null
                && (mc.player.isTouchingWater() || mc.player.isSubmergedInWater() || mc.player.isSwimming());
    }

    private boolean hasLowCeiling() {
        if (mc.player == null || mc.world == null) return false;

        BlockPos playerPos = mc.player.getBlockPos();
        BlockPos above1 = playerPos.up(2);
        BlockPos above2 = playerPos.up(3);

        BlockState state1 = mc.world.getBlockState(above1);
        BlockState state2 = mc.world.getBlockState(above2);

        boolean blocked1 = !state1.isAir() && !state1.getCollisionShape(mc.world, above1).isEmpty();
        boolean blocked2 = !state2.isAir() && !state2.getCollisionShape(mc.world, above2).isEmpty();

        return blocked1 || blocked2;
    }

    private boolean isPerfectCrit() {
        if (mc.player == null) return false;

        return mc.player.fallDistance > 0.0F
                && !mc.player.isOnGround()
                && !mc.player.isClimbing()
                && !mc.player.isTouchingWater()
                && !mc.player.hasStatusEffect(StatusEffects.BLINDNESS)
                && !mc.player.hasVehicle()
                && !mc.player.getAbilities().flying;
    }

    private boolean isAscending() {
        if (mc.player == null) return false;
        return !mc.player.isOnGround() && mc.player.getVelocity().y > 0.0;
    }

    private boolean isDescending() {
        if (mc.player == null) return false;
        return !mc.player.isOnGround() && mc.player.getVelocity().y <= 0.0;
    }


    private boolean isLowCeilFallingPhase() {
        if (mc.player == null) return false;
        return !mc.player.isOnGround()
                && mc.player.getVelocity().y <= 0.0
                && mc.player.fallDistance > 0.0F;
    }

    private boolean willBeCritInTicks(int ticks) {
        if (ticks == 0) return isPerfectCrit();

        PlayerSimulation sim = PlayerSimulation.simulateLocalPlayer(ticks);

        return sim.fallDistance > 0.0F
                && !sim.onGround
                && sim.velocity.y <= 0.0
                && !sim.isClimbing()
                && !sim.player.isTouchingWater()
                && !sim.hasStatusEffect(StatusEffects.BLINDNESS)
                && !sim.player.hasVehicle()
                && !sim.player.getAbilities().flying;
    }

    private boolean hasMovementRestrictions() {
        if (mc.player == null) return true;

        if (isInWater()) return false;
        if (hasLowCeiling()) return true;
        if (mc.player.hasStatusEffect(StatusEffects.BLINDNESS)) return true;
        if (mc.player.hasStatusEffect(StatusEffects.LEVITATION)) return true;
        if (PlayerInteractionHelper.isBoxInBlock(mc.player.getBoundingBox().expand(-1e-3), Blocks.COBWEB)) return true;
        if (mc.player.isInLava()) return true;
        if (mc.player.isClimbing()) return true;
        if (!PlayerInteractionHelper.canChangeIntoPose(EntityPose.STANDING, mc.player.getPos())) return true;
        if (mc.player.getAbilities().flying) return true;

        return false;
    }

    private boolean shouldResetSprintForCrit() {
        if (mc.player == null) return false;
        if (isInWater()) return false;
        if (mc.player.isGliding()) return false;
        return mc.player.isSprinting();
    }

    private boolean canCritNow() {
        KillAura aura = KillAura.get();
        boolean checkCritEnabled  = aura.getCheckCrit().isValue();
        boolean smartCritsEnabled = aura.getSmartCrits().isValue();
        boolean jumpSyncEnabled   = aura.getJumpSync().isValue();
        boolean lowCeilEnabled    = aura.getLowCeilCrit().isValue();

        if (isInWater()) return true;

        if (hasLowCeiling()) {
            if (!checkCritEnabled || !lowCeilEnabled) return true;
            return isLowCeilFallingPhase();
        }

        if (hasMovementRestrictions()) return true;
        if (!checkCritEnabled) return true;

        if (jumpSyncEnabled) return isPerfectCrit();
        if (isAscending()) return false;

        if (smartCritsEnabled) {
            if (mc.player.isOnGround()) return true;
            return isDescending() && mc.player.fallDistance > 0.0F;
        }

        return isPerfectCrit();
    }

    void handleAttack(StrikerConstructor.AttackPerpetratorConfigurable config) {
        if (config.getTarget() == null || !config.getTarget().isAlive()) return;
        if (shouldWaitForEating()) return;

        if (isHoldingMace()) {
            handleMaceAttack(config);
            return;
        }

        boolean elytraMode = checkElytraMode(config);
        if (elytraMode && !checkElytraRaycast(config)) return;
        if (!RaycastAngle.rayTrace(config)) return;
        if (!isLookingAtTarget(config)) return;
        if (!clickScheduler.isCooldownComplete(0)) return;

        if (!isSyncTpsReady()) return;

        if (!canCritNow()) return;

        preAttackEntity(config);
        if (blockUntilSprintClear()) return;
        executeAttack(config);
    }

    private void preAttackEntity(StrikerConstructor.AttackPerpetratorConfigurable config) {
        if (config.isShouldUnPressShield() &&
                mc.player.isUsingItem() &&
                mc.player.getActiveItem().getItem().equals(Items.SHIELD)) {
            mc.interactionManager.stopUsingItem(mc.player);
            shieldWatch.reset();
        }
    }

    private void handleMaceAttack(StrikerConstructor.AttackPerpetratorConfigurable config) {
        if (shouldWaitForEating()) return;
        if (mc.player.distanceTo(config.getTarget()) > KillAura.get().getAttackrange().getValue()) return;
        if (!RaycastAngle.rayTrace(config)) return;
        if (!isLookingAtTarget(config)) return;
        if (!clickScheduler.isMaceFastAttack()) return;
        if (!attackTimer.finished(25)) return;

        preAttackEntity(config);
        if (blockUntilSprintClear()) return;
        executeAttack(config);
    }

    private boolean checkElytraMode(StrikerConstructor.AttackPerpetratorConfigurable config) {
        return KillAura.TARGET != null &&
                KillAura.TARGET.isGliding() &&
                mc.player.isGliding() &&
                ElytraTarget.getInstance() != null &&
                ElytraTarget.getInstance().isState();
    }

    private boolean checkElytraRaycast(StrikerConstructor.AttackPerpetratorConfigurable config) {
        Vec3d targetVelocity = config.getTarget().getVelocity();
        float leadTicks = 0;
        if (ElytraTarget.shouldElytraTarget && ElytraTarget.getInstance() != null) {
            leadTicks = ElytraTarget.getInstance().getElytraForward();
        }
        Vec3d predictedPos = config.getTarget().getPos().add(targetVelocity.multiply(leadTicks));
        Box predictedBox = new Box(
                predictedPos.x - config.getTarget().getWidth() / 2,
                predictedPos.y,
                predictedPos.z - config.getTarget().getWidth() / 2,
                predictedPos.x + config.getTarget().getWidth() / 2,
                predictedPos.y + config.getTarget().getHeight(),
                predictedPos.z + config.getTarget().getWidth() / 2);
        Vec3d eyePos = mc.player.getEyePos();
        Vec3d lookVec = AngleConnection.INSTANCE.getRotation().toVector();

        if (predictedBox.contains(eyePos)) return true;
        return predictedBox.raycast(eyePos, eyePos.add(lookVec.multiply(config.getMaximumRange()))).isPresent();
    }

    private void executeAttack(StrikerConstructor.AttackPerpetratorConfigurable config) {
        mc.interactionManager.attackEntity(mc.player, config.getTarget());
        mc.player.swingHand(Hand.MAIN_HAND);
        attackTimer.reset();
        count++;

        applySyncTpsDelay();
    }

    void handleTriggerAttack(StrikerConstructor.AttackPerpetratorConfigurable config, RastyTriggerBot triggerBot) {
        if (shouldWaitForEating()) return;
        if (!RaycastAngle.rayTrace(config)) return;
        if (!isLookingAtTarget(config)) return;
        if (!clickScheduler.isCooldownComplete(0)) return;
        if (!isSyncTpsReady()) return;
        if (!canAttackTrigger(config, triggerBot)) return;

        preAttackEntity(config);
        if (blockUntilSprintClear()) return;
        executeAttack(config);
    }

    private boolean blockUntilSprintClear() {
        SlotSprintSync.ensureSubscribed();
        if (!shouldResetSprintForCrit() && !SlotSprintSync.lastSprinting) {
            return false;
        }
        return SlotSprintSync.delayHitUntilUnsprinted();
    }

    private boolean canAttackTrigger(StrikerConstructor.AttackPerpetratorConfigurable config, RastyTriggerBot triggerBot) {
        if (shouldWaitForEating()) return false;
        if (!clickScheduler.isCooldownComplete(0)) return false;

        boolean checkCritEnabled = triggerBot.isOnlyCrits();
        boolean smartCritsEnabled = triggerBot.getSmartCrits().isValue();

        if (isInWater() || hasLowCeiling() || hasMovementRestrictions()) return true;
        if (!checkCritEnabled) return true;
        if (isAscending()) return false;

        if (smartCritsEnabled) {
            if (mc.player.isOnGround()) return true;
            return isDescending() && mc.player.fallDistance > 0.0F;
        }

        return isPerfectCrit();
    }

    public boolean shouldResetSprinting(StrikerConstructor.AttackPerpetratorConfigurable config) {
        if (KillAura.TARGET == null) return false;
        if (shouldWaitForEating()) return false;
        if (isHoldingMace()) return true;
        return shouldResetSprintForCrit();
    }

    public boolean shouldResetSprintingForTrigger(StrikerConstructor.AttackPerpetratorConfigurable config,
                                                  RastyTriggerBot triggerBot) {
        if (triggerBot.target == null) return false;
        if (shouldWaitForEating()) return false;
        return shouldResetSprintForCrit();
    }

    public boolean canAttack(StrikerConstructor.AttackPerpetratorConfigurable config, int ticks) {
        if (shouldWaitForEating()) return false;
        if (isHoldingMace()) {
            return attackTimer.finished(25) && clickScheduler.isMaceFastAttack();
        }
        if (!clickScheduler.isCooldownComplete(0)) return false;
        if (!isSyncTpsReady()) return false;

        if (ticks > 0) {
            KillAura aura = KillAura.get();
            boolean checkCritEnabled  = aura.getCheckCrit().isValue();
            boolean smartCritsEnabled = aura.getSmartCrits().isValue();
            boolean lowCeilEnabled    = aura.getLowCeilCrit().isValue();

            if (!checkCritEnabled) return true;
            if (isInWater()) return true;


            if (hasLowCeiling()) {
                if (!lowCeilEnabled) return true;
                return isLowCeilFallingPhase();
            }

            if (hasMovementRestrictions()) return true;

            for (int i = 0; i <= ticks; i++) {
                if (willBeCritInTicks(i)) return true;
                if (smartCritsEnabled) {
                    PlayerSimulation sim = PlayerSimulation.simulateLocalPlayer(i);
                    if (sim.onGround) return true;
                }
            }
            return false;
        }

        return clickScheduler.isCooldownComplete(0) && canCritNow();
    }

    public boolean canCrit(StrikerConstructor.AttackPerpetratorConfigurable config, int ticks) {
        if (isHoldingMace()) return true;

        if (mc.player.isUsingItem()
                && !mc.player.getActiveItem().getItem().equals(Items.SHIELD)
                && config.isEatAndAttack()) {
            return false;
        }

        if (isInWater()) return true;

        KillAura aura = KillAura.get();
        boolean checkCritEnabled  = aura.getCheckCrit().isValue();
        boolean smartCritsEnabled = aura.getSmartCrits().isValue();
        boolean lowCeilEnabled    = aura.getLowCeilCrit().isValue();

        if (hasLowCeiling()) {
            if (!checkCritEnabled || !lowCeilEnabled) return true;
            return isLowCeilFallingPhase();
        }

        if (hasMovementRestrictions()) return true;
        if (!checkCritEnabled) return true;

        if (ticks > 0) {
            for (int i = 0; i <= ticks; i++) {
                if (willBeCritInTicks(i)) return true;
                if (smartCritsEnabled) {
                    PlayerSimulation sim = PlayerSimulation.simulateLocalPlayer(i);
                    if (sim.onGround) return true;
                }
            }
            return false;
        }

        return canCritNow();
    }

    public StopWatch getAttackTimer() {
        return attackTimer;
    }

    private boolean isLookingAtTarget(StrikerConstructor.AttackPerpetratorConfigurable config) {
        Vec3d eyePos = mc.player.getEyePos();

        if (config.getBox().contains(eyePos)) return true;

        Vec3d lookVec = AngleConnection.INSTANCE.getRotation().toVector();
        Vec3d endVec = eyePos.add(lookVec.multiply(config.getMaximumRange()));
        return config.getBox().raycast(eyePos, endVec).isPresent();
    }
}




