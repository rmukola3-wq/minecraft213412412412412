private void applyPreparedRotation(
        AuraRotationController.Result result
    ) {
        if (result == null || mc.player == null) return;

        if (result.clientSide()) {
            mc.player.setYaw(result.yaw());
            mc.player.setPitch(result.pitch());
            return;
        }

        Rotations.rotate(
            result.yaw(),
            result.pitch(),
            ROTATION_PRIORITY
        );
    }

    private boolean canAttackNow(
        Entity target,
        AuraRotationController.Result rotation,
        AuraCriticalController.Decision decision
    ) {
        if (
            !isActive()
                || mc.player == null
                || mc.world == null
                || mc.interactionManager == null
                || target == null
                || target != preparedTarget
                || !entityCheck(target)
                || !normalItemInHand()
                || !isCooldownReady(getCooldownProgress())
                || rotation == null
                || !rotation.attackAllowed()
        ) {
            return false;
        }

        if (
            decision == AuraCriticalController.Decision.CriticalAttack
                && mc.player.isOnGround()
        ) {
            return false;
        }

        if (!strictRaycast.get()) return true;

        return reachController.isLookingAt(
            mc.player,
            target,
            rotation.yaw(),
            rotation.pitch(),
            range.get() + 0.05
        );
    }

    private void performNormalAttack(Entity target) {
        if (
            target == null
                || !target.isAlive()
                || mc.player == null
                || mc.interactionManager == null
        ) {
            return;
        }

        mc.interactionManager.attackEntity(
            mc.player,
            target
        );

        mc.player.swingHand(Hand.MAIN_HAND);

        finishAttack();
    }

    private void performInstantShieldBreak(Entity target) {
        FindItemResult axe = InvUtils.findInHotbar(
            stack -> stack.getItem() instanceof AxeItem
        );

        if (!axe.found() || axe.slot() < 0) {
            performNormalAttack(target);
            return;
        }

        int oldSlot =
            mc.player.getInventory().selectedSlot;

        boolean changed = oldSlot != axe.slot();

        if (changed) {
            InvUtils.swap(axe.slot(), false);
        }

        /*
         * Rasty/Thunder order:
         * sword -> axe -> attack -> sword.
         * The axe is never held while waiting for cooldown.
         */
        mc.interactionManager.attackEntity(
            mc.player,
            target
        );

        mc.player.swingHand(Hand.MAIN_HAND);

        if (changed) {
            InvUtils.swap(oldSlot, false);
        }

        shieldBreakCooldown = 10;

        finishAttack();
    }

    private void finishAttack() {
        criticalController.afterAttack(mc.player);

        rollNextCooldown();

        combatPrepared = false;
        attacking = false;
    }

    private boolean basicCheck() {
        if (
            mc.player == null
                || mc.world == null
                || mc.interactionManager == null
                || !mc.player.isAlive()
        ) {
            return false;
        }

        if (
            onlyOnClick.get()
                && !mc.options.attackKey.isPressed()
        ) {
            return false;
        }

        return !pauseOnUse.get()
            || !mc.player.isUsingItem();
    }

    private void updateTargets() {
        targets.clear();

        if (
            targetLock.get()
                && lockedTarget != null
                && entityCheck(lockedTarget)
        ) {
            targets.add(lockedTarget);
            return;
        }

        lockedTarget = null;

        aimPointResolver.reset();
        reachController.clearSelectedBox();

        TargetUtils.getList(
            targets,
            this::entityCheck,
            priority.get(),
            1
        );

        if (targetLock.get() && !targets.isEmpty()) {
            lockedTarget = targets.getFirst();
        }
    }

    private void invalidateTarget(Entity target) {
        if (lockedTarget == target) {
            lockedTarget = null;
        }

        targets.clear();

        preparedTarget = null;
        currentAimPoint = null;
        preparedRotation = null;

        combatPrepared = false;
        attacking = false;

        aimPointResolver.reset();
        rotationController.reset();
        reachController.clearSelectedBox();
        criticalController.reset(mc.player);

        stopAttacking();
    }

    private void pausePathing() {
        if (
            pauseBaritone.get()
                && PathManagers.get().isPathing()
                && !wasPathing
        ) {
            PathManagers.get().pause();
            wasPathing = true;
        }
    }

    private boolean prepareNormalWeapon() {
        if (!autoSwitch.get()) return true;
        if (weapon.get() == Weapon.Any) return true;

        FindItemResult result = findWeapon();

        if (!result.found() || result.slot() < 0) {
            return false;
        }

        int selectedSlot =
            mc.player.getInventory().selectedSlot;

        if (!swapped && selectedSlot != result.slot()) {
            previousSlot = selectedSlot;
            swapped = true;
        }

        if (selectedSlot != result.slot()) {
            InvUtils.swap(result.slot(), false);
        }

        return true;
    }

    private FindItemResult findWeapon() {
        return switch (weapon.get()) {
            case Sword -> InvUtils.findInHotbar(
                stack -> stack.getItem() instanceof SwordItem
            );

            case Axe -> InvUtils.findInHotbar(
                stack -> stack.getItem() instanceof AxeItem
            );

            case Mace -> InvUtils.findInHotbar(
                stack -> stack.getItem() instanceof MaceItem
            );

            case Trident -> InvUtils.findInHotbar(
                stack -> stack.getItem() instanceof TridentItem
            );

            case All -> findPreferredWeapon();

            case Any -> InvUtils.findInHotbar(
                stack -> true
            );
        };
    }

    private FindItemResult findPreferredWeapon() {
        FindItemResult result = InvUtils.findInHotbar(
            stack -> stack.getItem() instanceof SwordItem
        );

        if (result.found()) return result;

        result = InvUtils.findInHotbar(
            stack -> stack.getItem() instanceof MaceItem
        );

        if (result.found()) return result;

        result = InvUtils.findInHotbar(
            stack -> stack.getItem() instanceof TridentItem
        );

        if (result.found()) return result;

        return InvUtils.findInHotbar(
            stack -> stack.getItem() instanceof AxeItem
        );
    }

    private boolean normalItemInHand() {
        if (mc.player == null) return false;

        Item item =
            mc.player.getMainHandStack().getItem();

        return switch (weapon.get()) {
            case Sword -> item instanceof SwordItem;
            case Axe -> item instanceof AxeItem;
            case Mace -> item instanceof MaceItem;
            case Trident -> item instanceof TridentItem;

            case All ->
                item instanceof SwordItem
                    || item instanceof AxeItem
                    || item instanceof MaceItem
                    || item instanceof TridentItem;

            case Any -> true;
        };
    }

    private boolean isTargetBlockingShield(Entity entity) {
        if (!(entity instanceof PlayerEntity player)) {
            return false;
        }

        boolean hasShield =
            player.getMainHandStack().isOf(Items.SHIELD)
                || player.getOffHandStack().isOf(Items.SHIELD);

        return hasShield
            && (
            player.isBlocking()
                || player.isUsingItem()
        );
    }

    private float getCooldownProgress() {
        if (mc.player == null) return 0;

        return mc.player.getAttackCooldownProgress(0.5f);
    }

    private boolean isCooldownReady(float progress) {
        if (switchTimer > 0) return false;

        return progress >= nextCooldownThreshold;
    }

    private void rollNextCooldown() {
        TimingMode timing = getTimingMode();

        nextCooldownThreshold = switch (timing) {
            case Legit -> random(0.94, 0.99);
            case Smart -> random(0.89, 0.93);
            case Rockstar -> random(0.90, 0.96);
            case Liquid -> 0.90;
            case Grim -> random(0.95, 0.98);
            case Custom -> customCooldown.get();
        };
    }

    private int getSwitchDelay() {
        return switch (getTimingMode()) {
            case Grim -> 2;
            case Liquid -> 1;
            case Legit, Smart, Rockstar, Custom -> 0;
        };
    }

    private double getJumpProgress() {
        return switch (getTimingMode()) {
            case Legit -> 0.55;
            case Smart -> 0.35;
            case Rockstar -> 0.45;
            case Liquid -> 0.35;
            case Grim -> 0.30;
            case Custom -> 0.35;
        };
    }

    private TimingMode getTimingMode() {
        return switch (profile.get()) {
            case Legit -> TimingMode.Legit;

            case RastyMatrix,
                 RastySnap -> TimingMode.Smart;

            case Rockstar -> TimingMode.Rockstar;

            case LiquidSnap,
                 LiquidOnTick -> TimingMode.Liquid;

            case Grim -> TimingMode.Grim;

            case Custom -> customTiming.get();
        };
    }

    private AuraRotationController.Style getRotationStyle() {
        return switch (profile.get()) {
            case Legit ->
                AuraRotationController.Style.Legit;

            case RastyMatrix ->
                AuraRotationController.Style.RastyMatrix;

            case RastySnap ->
                AuraRotationController.Style.RastySnap;

            case Rockstar ->
                AuraRotationController.Style.Rockstar;

            case LiquidSnap ->
                AuraRotationController.Style.LiquidSnap;

            case LiquidOnTick ->
                AuraRotationController.Style.LiquidOnTick;

            case Grim ->
                AuraRotationController.Style.Grim;

            case Custom -> customRotation.get();
        };
    }

    private AuraCriticalController.Mode
    getEffectiveCriticalMode() {
        AuraCriticalController.Mode mode =
            criticalMode.get();

        if (mode == AuraCriticalController.Mode.Off) {
            return mode;
        }

        /*
         * Smart falls back to normal attacks when jumping
         * is impossible. OnlyCriticals continues waiting.
         */
        if (
            mode == AuraCriticalController.Mode.Smart
                && !hasJumpSpace()
        ) {
            return AuraCriticalController.Mode.Off;
        }

        return mode;
    }

    private boolean hasJumpSpace() {
        if (mc.player == null || mc.world == null) {
            return false;
        }

        BlockPos base = mc.player.getBlockPos();

        for (int offset = 2; offset <= 3; offset++) {
            BlockPos position = base.up(offset);

            BlockState state =
                mc.world.getBlockState(position);

            if (
                !state.isAir()
                    && !state.getCollisionShape(
                    mc.world,
                    position
                ).isEmpty()
            ) {
                return false;
            }
        }

        return true;
    }

    private boolean entityCheck(Entity entity) {
        if (
            entity == null
                || entity == mc.player
                || entity == mc.cameraEntity
                || !entity.isAlive()
        ) {
            return false;
        }

        if (
            entity instanceof LivingEntity living
                && living.isDead()
        ) {
            return false;
        }

        Box box = entity.getBoundingBox();

        double closestX = MathHelper.clamp(
            mc.player.getX(),
            box.minX,
            box.maxX
        );

        double closestY = MathHelper.clamp(
            mc.player.getEyeY(),
            box.minY,
            box.maxY
        );

        double closestZ = MathHelper.clamp(
            mc.player.getZ(),
            box.minZ,
            box.maxZ
        );

        if (
            !PlayerUtils.isWithin(
                closestX,
                closestY,
                closestZ,
                range.get()
            )
        ) {
            return false;
        }

        if (!entities.get().contains(entity.getType())) {
            return false;
        }

        if (ignoreNamed.get() && entity.hasCustomName()) {
            return false;
        }

        if (
            !PlayerUtils.canSeeEntity(entity)
                && !PlayerUtils.isWithin(
                entity,
                Math.min(
                    wallsRange.get(),
                    range.get()
                )
            )
        ) {
            return false;
        }

        if (
            ignoreTamed.get()
                && entity instanceof Tameable tameable
                && tameable.getOwnerUuid() != null
                && tameable.getOwnerUuid().equals(
                    mc.player.getUuid()
                )
        ) {
            return false;
        }

        if (ignorePassive.get()) {
            if (
                entity instanceof EndermanEntity enderman
                    && !enderman.isAngry()
            ) {
                return false;
            }

            if (
                entity instanceof ZombifiedPiglinEntity piglin
                    && !piglin.isAttacking()
            ) {
                return false;
            }

            if (
                entity instanceof WolfEntity wolf
                    && !wolf.isAttacking()
            ) {
                return false;
            }
        }

        if (entity instanceof PlayerEntity player) {
            if (player.isCreative()) return false;

            if (!Friends.get().shouldAttack(player)) {
                return false;
            }

            if (
                shieldMode.get() == ShieldMode.Ignore
                    && isTargetBlockingShield(player)
            ) {
                return false;
            }
        }

        return true;
    }

    private void stopAttacking() {
        combatPrepared = false;
        attacking = false;

        preparedTarget = null;
        preparedRotation = null;

        if (wasPathing) {
            PathManagers.get().resume();
            wasPathing = false;
        }

        if (swapped) {
            if (
                swapBack.get()
                    && previousSlot >= 0
                    && previousSlot <= 8
            ) {
                InvUtils.swap(previousSlot, false);
            }

            swapped = false;
            previousSlot = -1;
        }
    }

    private void clearCombat() {
        targets.clear();

        lockedTarget = null;
        preparedTarget = null;

        currentAimPoint = null;
        preparedRotation = null;

        combatPrepared = false;
        attacking = false;

        aimPointResolver.reset();
        rotationController.reset();
        reachController.clearSelectedBox();
        criticalController.reset(mc.player);

        stopAttacking();
    }

