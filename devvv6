    @EventHandler(priority = EventPriority.HIGH)
    private void onTickPre(TickEvent.Pre event) {
        criticalController.tick(mc.player);
        reachController.tick();

        if (switchTimer > 0) switchTimer--;
        if (shieldBreakCooldown > 0) shieldBreakCooldown--;

        combatPrepared = false;
        attacking = false;

        preparedTarget = null;
        preparedRotation = null;

        if (!basicCheck()) {
            stopAttacking();
            return;
        }

        updateTargets();

        Entity target = getTarget();

        if (target == null) {
            currentAimPoint = null;
            rotationController.reset();
            criticalController.reset(mc.player);

            stopAttacking();
            return;
        }

        currentAimPoint = aimPointResolver.resolve(
            mc,
            target,
            range.get(),
            Math.min(range.get(), wallsRange.get())
        );

        if (currentAimPoint == null) {
            invalidateTarget(target);
            return;
        }

        if (!prepareNormalWeapon()) {
            stopAttacking();
            return;
        }

        boolean cooldownReady =
            isCooldownReady(getCooldownProgress());

        preparedRotation = rotationController.update(
            mc,
            mc.player,
            target,
            currentAimPoint,
            getRotationStyle(),
            cooldownReady
        );

        if (preparedRotation == null) {
            stopAttacking();
            return;
        }

        applyPreparedRotation(preparedRotation);

        preparedTarget = target;
        combatPrepared = true;
        attacking = true;

        pausePathing();
    }

    @EventHandler(priority = EventPriority.HIGH)
    private void onTickPost(TickEvent.Post event) {
        if (
            !combatPrepared
                || preparedTarget == null
                || preparedRotation == null
                || mc.player == null
                || mc.world == null
                || mc.interactionManager == null
        ) {
            return;
        }

        Entity target = preparedTarget;

        if (!entityCheck(target)) {
            invalidateTarget(target);
            return;
        }

        currentAimPoint = aimPointResolver.resolve(
            mc,
            target,
            range.get(),
            Math.min(range.get(), wallsRange.get())
        );

        if (currentAimPoint == null) {
            invalidateTarget(target);
            return;
        }

        float cooldownProgress = getCooldownProgress();
        boolean cooldownReady =
            isCooldownReady(cooldownProgress);

        AuraCriticalController.Mode effectiveCriticalMode =
            getEffectiveCriticalMode();

        AuraCriticalController.Decision decision =
            criticalController.update(
                mc.player,
                effectiveCriticalMode,
                cooldownReady,
                cooldownProgress,
                autoCriticalJump.get(),
                getJumpProgress(),
                0.0
            );

        if (decision == AuraCriticalController.Decision.Wait) {
            return;
        }

        AuraRotationController.Result attackRotation =
            rotationController.update(
                mc,
                mc.player,
                target,
                currentAimPoint,
                getRotationStyle(),
