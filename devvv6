                performNormalAttack(target);
            }
        };

        if (attackRotation.clientSide()) {
            mc.player.setYaw(attackRotation.yaw());
            mc.player.setPitch(attackRotation.pitch());

            attackAction.run();
        } else {
            Rotations.rotate(
                attackRotation.yaw(),
                attackRotation.pitch(),
                ROTATION_PRIORITY,
                false,
                attackAction
            );
