package meteordevelopment.meteorclient.systems.modules.combat.aura;

import meteordevelopment.meteorclient.utils.player.Rotations;
import net.minecraft.client.MinecraftClient;
import net.minecraft.client.network.ClientPlayerEntity;
import net.minecraft.entity.Entity;
import net.minecraft.util.math.MathHelper;
import net.minecraft.util.math.Vec3d;

import java.util.concurrent.ThreadLocalRandom;

public final class AuraRotationController {
    private float yaw;
    private float pitch;

    private float noiseYaw;
    private float noisePitch;
    private float targetNoiseYaw;
    private float targetNoisePitch;

    private int targetId = -1;
    private long nextNoiseUpdate;
    private boolean initialized;

    public void reset() {
        yaw = 0;
        pitch = 0;

        noiseYaw = 0;
        noisePitch = 0;
        targetNoiseYaw = 0;
        targetNoisePitch = 0;

        targetId = -1;
        nextNoiseUpdate = 0;
        initialized = false;
    }

    public Result update(
        MinecraftClient mc,
        ClientPlayerEntity player,
        Entity target,
        Vec3d point,
        Style style,
        boolean attackReady
    ) {
        if (mc == null || player == null || target == null || point == null) {
            reset();
            return null;
        }

        if (!initialized) {
            yaw = Rotations.serverYaw;
            pitch = Rotations.serverPitch;
            initialized = true;
        }

        if (targetId != target.getId()) {
            targetId = target.getId();

            yaw = Rotations.serverYaw;
            pitch = Rotations.serverPitch;

            noiseYaw = 0;
            noisePitch = 0;
            targetNoiseYaw = 0;
            targetNoisePitch = 0;
            nextNoiseUpdate = 0;
        }

        Angle targetAngle = angleTo(player.getEyePos(), point);

        updateNoise(style, attackReady);

        switch (style) {
            case Legit -> updateLegit(targetAngle);
            case RastyMatrix -> updateRastyMatrix(targetAngle, attackReady);
            case RastySnap -> updateRastySnap(targetAngle, attackReady);
            case Rockstar -> updateRockstar(targetAngle, attackReady);
            case LiquidSnap -> updateLiquidSnap(targetAngle, attackReady);
            case LiquidOnTick -> updateLiquidOnTick(targetAngle, attackReady);
            case Grim -> updateGrim(targetAngle, attackReady);
            case Instant -> {
                yaw = targetAngle.yaw;
                pitch = targetAngle.pitch;
            }
        }

        yaw = applySensitivity(mc, yaw, Rotations.serverYaw);
        pitch = applySensitivity(mc, pitch, Rotations.serverPitch);
        pitch = MathHelper.clamp(pitch, -90, 90);

        float error = rotationDifference(
            yaw,
            pitch,
            targetAngle.yaw,
            targetAngle.pitch
        );

        return new Result(
            yaw,
            pitch,
            style == Style.Legit,
            canAttack(style, attackReady, error),
            error
        );
    }

    private void updateLegit(Angle target) {
        float yawDifference = MathHelper.wrapDegrees(target.yaw - yaw);
        float pitchDifference = target.pitch - pitch;

        float distance = (float) Math.hypot(
            yawDifference,
            pitchDifference
        );

        float yawStep = MathHelper.clamp(
            5.5f + distance * 0.10f,
            5.5f,
            13.5f
        );

        float pitchStep = MathHelper.clamp(
            3.5f + distance * 0.06f,
            3.5f,
            8.0f
        );

        yaw += MathHelper.clamp(
            yawDifference,
            -yawStep,
            yawStep
        );

        pitch += MathHelper.clamp(
            pitchDifference,
            -pitchStep,
            pitchStep
        );

        yaw += noiseYaw * 0.18f;
        pitch += noisePitch * 0.10f;
    }

    private void updateRastyMatrix(
        Angle target,
        boolean attackReady
    ) {
        float yawDifference = MathHelper.wrapDegrees(target.yaw - yaw);
        float pitchDifference = target.pitch - pitch;

        float difference = rotationDifference(
            yaw,
            pitch,
            target.yaw,
            target.pitch
        );

        float speed;

        if (attackReady) {
            speed = random(0.76f, 0.92f);
        } else if (difference <= 4.0f) {
            speed = random(0.04f, 0.08f);
        } else {
            speed = random(0.15f, 0.45f);
        }

        yaw = MathHelper.lerp(
            speed,
            yaw,
            yaw + yawDifference
        );

        pitch = MathHelper.lerp(
            Math.min(1.0f, speed * 0.85f),
            pitch,
            pitch + pitchDifference
        );

        if (!attackReady) {
            yaw += noiseYaw;
            pitch += noisePitch;
        }
    }

    private void updateRastySnap(
        Angle target,
        boolean attackReady
    ) {
        if (attackReady) {
            yaw = target.yaw;
            pitch = target.pitch;
            return;
        }

        float yawDifference = MathHelper.wrapDegrees(target.yaw - yaw);
        float pitchDifference = target.pitch - pitch;

        yaw += MathHelper.clamp(
            yawDifference,
            -18.0f,
            18.0f
        );

        pitch += MathHelper.clamp(
            pitchDifference,
            -9.0f,
            9.0f
        );
    }

    private void updateRockstar(
        Angle target,
        boolean attackReady
    ) {
        float yawDifference = MathHelper.wrapDegrees(target.yaw - yaw);
        float pitchDifference = target.pitch - pitch;

        float yawSpeed = attackReady
            ? random(45.0f, 70.0f)
            : random(28.0f, 48.0f);

        float pitchSpeed = attackReady
            ? random(18.0f, 32.0f)
            : random(8.0f, 18.0f);

        yaw += MathHelper.clamp(
            yawDifference,
            -yawSpeed,
            yawSpeed
        );

        pitch += MathHelper.clamp(
            pitchDifference,
            -pitchSpeed,
            pitchSpeed
        );

        if (!attackReady) {
            yaw += noiseYaw * 0.35f;
            pitch += noisePitch * 0.20f;
        }
    }

    private void updateLiquidSnap(
        Angle target,
        boolean attackReady
    ) {
        if (!attackReady) return;

        yaw = target.yaw;
        pitch = target.pitch;
    }

    private void updateLiquidOnTick(
        Angle target,
        boolean attackReady
    ) {
        if (attackReady) {
            yaw = target.yaw;
            pitch = target.pitch;
            return;
        }

        float yawDifference = MathHelper.wrapDegrees(target.yaw - yaw);
        float pitchDifference = target.pitch - pitch;

        yaw += MathHelper.clamp(
            yawDifference,
            -35.0f,
            35.0f
        );

        pitch += MathHelper.clamp(
            pitchDifference,
            -20.0f,
            20.0f
        );
    }

    private void updateGrim(
        Angle target,
        boolean attackReady
    ) {
        float yawDifference = MathHelper.wrapDegrees(target.yaw - yaw);
        float pitchDifference = target.pitch - pitch;

        float yawStep = attackReady ? 180.0f : 70.0f;
        float pitchStep = attackReady ? 90.0f : 35.0f;

        yaw += MathHelper.clamp(
            yawDifference,
            -yawStep,
            yawStep
        );

        pitch += MathHelper.clamp(
            pitchDifference,
            -pitchStep,
            pitchStep
        );
    }

    private boolean canAttack(
        Style style,
        boolean attackReady,
        float error
    ) {
        if (!attackReady) return false;

        return switch (style) {
            case Legit -> error <= 5.0f;
            case RastyMatrix -> error <= 4.0f;
            case Rockstar -> error <= 5.5f;

            case RastySnap,
                 LiquidSnap,
                 LiquidOnTick,
                 Grim,
                 Instant -> error <= 1.5f;
        };
    }

    private void updateNoise(
        Style style,
        boolean attackReady
    ) {
        if (
            style == Style.LiquidSnap
                || style == Style.LiquidOnTick
                || style == Style.Grim
                || style == Style.Instant
        ) {
            noiseYaw = 0;
            noisePitch = 0;
            return;
        }

        long now = System.currentTimeMillis();

        if (now >= nextNoiseUpdate) {
            float yawAmount = style == Style.Legit
                ? 0.35f
                : 0.75f;

            float pitchAmount = style == Style.Legit
                ? 0.18f
                : 0.35f;

            if (attackReady) {
                yawAmount *= 0.25f;
                pitchAmount *= 0.25f;
            }

            targetNoiseYaw = random(
                -yawAmount,
                yawAmount
            );

            targetNoisePitch = random(
                -pitchAmount,
                pitchAmount
            );

            nextNoiseUpdate = now
                + ThreadLocalRandom.current().nextLong(55, 125);
        }

        noiseYaw = MathHelper.lerp(
            0.25f,
            noiseYaw,
            targetNoiseYaw
        );

        noisePitch = MathHelper.lerp(
            0.25f,
            noisePitch,
            targetNoisePitch
        );
    }

    private Angle angleTo(
        Vec3d origin,
        Vec3d point
    ) {
        double differenceX = point.x - origin.x;
        double differenceY = point.y - origin.y;
        double differenceZ = point.z - origin.z;

        double horizontal = Math.sqrt(
            differenceX * differenceX
                + differenceZ * differenceZ
        );

        float targetYaw = (float) (
            Math.toDegrees(
                Math.atan2(differenceZ, differenceX)
            ) - 90
        );

        float targetPitch = MathHelper.clamp(
            (float) -Math.toDegrees(
                Math.atan2(differenceY, horizontal)
            ),
            -90,
            90
        );

        return new Angle(targetYaw, targetPitch);
    }

    private float applySensitivity(
        MinecraftClient mc,
        float value,
        float previous
    ) {
        double sensitivity =
            mc.options.getMouseSensitivity().getValue();

        double gcd = Math.pow(
            sensitivity * 0.6 + 0.2,
            3
        ) * 1.2;

        float difference = value - previous;

        return previous
            + Math.round(difference / gcd) * (float) gcd;
    }

    private float rotationDifference(
        float firstYaw,
        float firstPitch,
        float secondYaw,
        float secondPitch
    ) {
        float yawDifference = MathHelper.wrapDegrees(
            secondYaw - firstYaw
        );

        float pitchDifference =
            secondPitch - firstPitch;

        return (float) Math.hypot(
            yawDifference,
            pitchDifference
        );
    }

    private float random(float minimum, float maximum) {
        return ThreadLocalRandom.current().nextFloat(
            minimum,
            maximum
        );
    }

    private record Angle(
        float yaw,
        float pitch
    ) {
    }

    public record Result(
        float yaw,
        float pitch,
        boolean clientSide,
        boolean attackAllowed,
        float error
    ) {
    }

    public enum Style {
        Legit,
        RastyMatrix,
        RastySnap,
        Rockstar,
        LiquidSnap,
        LiquidOnTick,
        Grim,
        Instant
    }
}


