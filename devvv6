            movementAssist.get() == MovementAssistMode.None
                || movementAssist.get() == MovementAssistMode.Free
                || event.type != MovementType.SELF
                || mc.player == null
                || !(getTarget() instanceof LivingEntity target)
                || Modules.get().isActive(TargetStrafe.class)
        ) {
            return;
        }

        double currentX = event.movement.x;
        double currentZ = event.movement.z;

        double speed = Math.hypot(currentX, currentZ);

        if (speed < 0.001) return;

        Vec3d targetPosition =
            target.getBoundingBox().getCenter();

        double differenceX =
            targetPosition.x - mc.player.getX();

        double differenceZ =
            targetPosition.z - mc.player.getZ();

        double distance = Math.hypot(
            differenceX,
            differenceZ
        );

        if (distance < 0.001) return;

        double forwardX = differenceX / distance;
        double forwardZ = differenceZ / distance;

        double strength = assistStrength.get();

        double desiredX =
            currentX * (1.0 - strength)
                + forwardX * speed * strength;

        double desiredZ =
            currentZ * (1.0 - strength)
                + forwardZ * speed * strength;

        double desiredLength = Math.hypot(
            desiredX,
            desiredZ
        );

        if (desiredLength < 0.001) return;

        desiredX = desiredX / desiredLength * speed;
        desiredZ = desiredZ / desiredLength * speed;

        ((IVec3d) event.movement).meteor$setXZ(
            desiredX,
            desiredZ
        );
    }


